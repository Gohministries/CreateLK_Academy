<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#155eef">
<title>CreateLK Referral Admin</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}

body{
font-family:Arial,Helvetica,sans-serif;
background:#f5f7fb;
color:#172033
}

header{
background:#fff;
border-bottom:1px solid #e5e7eb;
padding:13px 15px;
position:sticky;
top:0;
z-index:10
}

.head{
max-width:900px;
margin:auto;
display:flex;
align-items:center;
justify-content:space-between
}

.logo{
font-size:17px;
font-weight:900;
color:#155eef
}

.logout{
border:0;
background:#f1f5f9;
color:#344054;
padding:8px 12px;
border-radius:8px;
font-size:10px;
font-weight:800;
cursor:pointer
}

main{
max-width:900px;
margin:auto;
padding:14px
}

.login{
max-width:380px;
margin:70px auto;
background:#fff;
padding:22px;
border-radius:16px;
border:1px solid #e5e7eb;
box-shadow:0 8px 25px #0000000a
}

.login h2{
font-size:20px;
margin-bottom:6px
}

.login p{
font-size:11px;
color:#667085;
line-height:1.5
}

input{
width:100%;
height:42px;
border:1px solid #d0d5dd;
border-radius:8px;
padding:0 11px;
font-size:12px;
outline:0;
margin-top:10px
}

input:focus{
border-color:#155eef;
box-shadow:0 0 0 3px #155eef15
}

.btn{
border:0;
border-radius:8px;
padding:10px 13px;
font-size:10px;
font-weight:800;
cursor:pointer
}

.primary{
width:100%;
margin-top:10px;
background:#155eef;
color:#fff
}

.primary:disabled{
opacity:.6
}

.error{
margin-top:10px;
padding:9px;
border-radius:8px;
background:#fff1f2;
border:1px solid #fecdd3;
color:#be123c;
font-size:10px
}

#loginMessage:empty{
display:none
}

#admin{
display:none
}

.stats{
display:grid;
grid-template-columns:repeat(4,1fr);
gap:9px;
margin-bottom:12px
}

.stat{
background:#fff;
border:1px solid #e5e7eb;
border-radius:12px;
padding:13px
}

.stat small{
display:block;
font-size:9px;
font-weight:800;
color:#667085;
text-transform:uppercase
}

.stat strong{
display:block;
font-size:21px;
margin-top:5px
}

.card{
background:#fff;
border:1px solid #e5e7eb;
border-radius:14px;
padding:14px;
margin-bottom:12px
}

.card h2{
font-size:14px;
margin-bottom:10px
}

.payout{
border:1px solid #e5e7eb;
border-radius:12px;
padding:13px;
margin-bottom:9px;
background:#fff
}

.payout:last-child{
margin-bottom:0
}

.payout-top{
display:flex;
justify-content:space-between;
align-items:flex-start;
gap:10px
}

.code{
font-size:11px;
font-weight:900;
color:#155eef;
word-break:break-all
}

.student{
font-size:10px;
color:#667085;
margin-top:3px
}

.amount{
font-size:18px;
font-weight:900;
margin-top:9px
}

.badge{
display:inline-block;
padding:5px 8px;
border-radius:7px;
font-size:9px;
font-weight:900
}

.pending{
background:#fff7ed;
color:#c2410c
}

.paid{
background:#dcfce7;
color:#166534
}

.rejected{
background:#fee2e2;
color:#b91c1c
}

.bank{
margin-top:11px;
padding:11px;
background:#f8fafc;
border-radius:10px
}

.bank-title{
font-size:10px;
font-weight:900;
margin-bottom:7px
}

.bank-row{
display:flex;
justify-content:space-between;
gap:10px;
padding:5px 0;
border-bottom:1px solid #e5e7eb;
font-size:10px
}

.bank-row:last-child{
border-bottom:0
}

.bank-label{
color:#667085
}

.bank-value{
font-weight:800;
text-align:right;
word-break:break-word
}

.copy-btn{
margin-top:8px;
width:100%;
background:#eef4ff;
color:#155eef
}

.actions{
display:flex;
gap:7px;
margin-top:11px
}

.approve{
background:#dcfce7;
color:#166534;
flex:1
}

.reject{
background:#fee2e2;
color:#b91c1c;
flex:1
}

.date{
font-size:9px;
color:#667085;
margin-top:9px
}

.empty{
padding:18px;
text-align:center;
font-size:10px;
color:#667085;
background:#f8fafc;
border-radius:9px
}

.referrals{
display:none
}

.loading{
font-size:10px;
color:#667085;
padding:10px 0
}

@media(max-width:600px){

.stats{
grid-template-columns:1fr 1fr
}

.payout-top{
flex-direction:column
}

.actions{
flex-direction:column
}

.approve,
.reject{
width:100%
}
}
</style>
</head>

<body>

<header>
<div class="head">

<div class="logo">
📚 CreateLK Referral Admin
</div>

<button class="logout" onclick="logout()">
Logout
</button>

</div>
</header>


<div id="loginBox" class="login">

<h2>Admin Login</h2>

<p>
Enter your private admin secret.
</p>

<input
id="secret"
type="password"
autocomplete="current-password"
placeholder="Admin secret">

<button
id="loginBtn"
class="btn primary"
onclick="login()">
Login
</button>

<div id="loginMessage" class="error"></div>

</div>


<main id="admin">

<div class="stats">

<div class="stat">
<small>Students</small>
<strong id="students">0</strong>
</div>

<div class="stat">
<small>Premium</small>
<strong id="premium">0</strong>
</div>

<div class="stat">
<small>Referrals</small>
<strong id="referrals">0</strong>
</div>

<div class="stat">
<small>Pending Withdrawals</small>
<strong id="withdrawals">LKR 0</strong>
</div>

</div>


<section class="card">

<h2>💰 Payout Requests</h2>

<div id="payouts">
<div class="loading">
Loading payout requests...
</div>
</div>

</section>


<!-- Referral details intentionally removed -->

</main>


<script>

const API =
"https://createlk-referral-admin.createlk.workers.dev";

const STORAGE_KEY =
"createlk_admin_secret";

let ADMIN_SECRET =
sessionStorage.getItem(STORAGE_KEY) || "";


/* =========================
   HELPERS
========================= */

function money(value){

return "LKR " +
Number(value || 0).toLocaleString(
"en-LK",
{
maximumFractionDigits:0
}
);

}


function escapeHTML(value){

return String(value ?? "")
.replace(/&/g,"&amp;")
.replace(/</g,"&lt;")
.replace(/>/g,"&gt;")
.replace(/"/g,"&quot;")
.replace(/'/g,"&#039;");

}


/* =========================
   API
========================= */

async function api(path,options={}){

const response =
await fetch(
API + path,
{
...options,

headers:{
"Content-Type":"application/json",
"X-Admin-Secret":ADMIN_SECRET,
...(options.headers || {})
},

cache:"no-store"
}
);

let data;

try{
data = await response.json();
}catch{
throw new Error(
"Invalid server response."
);
}

if(response.status === 401){

throw new Error(
data.message || "Invalid admin secret."
);

}

if(!response.ok){

throw new Error(
data.message ||
"Request failed."
);

}

return data;
}


/* =========================
   LOGIN
========================= */

async function login(){

const input =
document.getElementById("secret");

const btn =
document.getElementById("loginBtn");

const message =
document.getElementById("loginMessage");

const value =
input.value.trim();

message.textContent="";

if(!value){

message.textContent =
"Enter the admin secret.";

return;

}

btn.disabled=true;
btn.textContent="Checking...";

try{

/*
 Verify the secret against
 the Worker before opening
 the dashboard.
*/

const response =
await fetch(
API + "/api/auth",
{
method:"GET",

headers:{
"X-Admin-Secret":value
},

cache:"no-store"
}
);

const data =
await response.json();

if(
!response.ok ||
!data.success
){

throw new Error(
data.message ||
"Invalid admin secret."
);

}

ADMIN_SECRET=value;

sessionStorage.setItem(
STORAGE_KEY,
ADMIN_SECRET
);

showAdmin();

}catch(error){

console.error(error);

message.textContent =
error.message ||
"Invalid admin secret.";

sessionStorage.removeItem(
STORAGE_KEY
);

ADMIN_SECRET="";

}finally{

btn.disabled=false;
btn.textContent="Login";

}

}


/* =========================
   SHOW ADMIN
========================= */

function showAdmin(){

document.getElementById(
"loginBox"
).style.display="none";

document.getElementById(
"admin"
).style.display="block";

loadAll();

}


/* =========================
   SUMMARY
========================= */

async function loadSummary(){

const data =
await api("/api/summary");

if(!data.success){

throw new Error(
data.message ||
"Unable to load summary."
);

}

document.getElementById(
"students"
).textContent =
data.students || 0;

document.getElementById(
"premium"
).textContent =
data.premium || 0;

document.getElementById(
"referrals"
).textContent =
data.referrals || 0;

document.getElementById(
"withdrawals"
).textContent =
money(
data.withdrawals?.pending || 0
);

}


/* =========================
   LOAD PAYOUTS
========================= */

async function loadPayouts(){

const box =
document.getElementById("payouts");

box.innerHTML =
'<div class="loading">Loading payout requests...</div>';

try{

const data =
await api("/api/payouts");

if(!data.success){

throw new Error(
data.message ||
"Unable to load payouts."
);

}

const payouts =
data.payouts || [];

if(!payouts.length){

box.innerHTML =
'<div class="empty">No payout requests found.</div>';

return;

}

box.innerHTML="";

payouts.forEach(function(p){

const status =
String(p.status || "")
.toUpperCase();

const statusClass =
status === "PAID"
? "paid"
: status === "REJECTED"
? "rejected"
: "pending";

const accountName =
p.account_name || "-";

const bankName =
p.bank_name || "-";

const branch =
p.branch || "-";

const accountNumber =
p.account_number || "-";

const div =
document.createElement("div");

div.className="payout";

div.innerHTML=`

<div class="payout-top">

<div>

<div class="code">
${escapeHTML(p.payout_code)}
</div>

<div class="student">
Student ID: ${escapeHTML(p.student_id)}
</div>

<div class="amount">
${money(p.amount)}
</div>

</div>

<div>
<span class="badge ${statusClass}">
${escapeHTML(status)}
</span>
</div>

</div>


<div class="bank">

<div class="bank-title">
🏦 Bank Account
</div>

<div class="bank-row">
<span class="bank-label">
Account Name
</span>

<span class="bank-value">
${escapeHTML(accountName)}
</span>
</div>

<div class="bank-row">
<span class="bank-label">
Bank
</span>

<span class="bank-value">
${escapeHTML(bankName)}
</span>
</div>

<div class="bank-row">
<span class="bank-label">
Branch
</span>

<span class="bank-value">
${escapeHTML(branch)}
</span>
</div>

<div class="bank-row">
<span class="bank-label">
Account Number
</span>

<span class="bank-value">
${escapeHTML(accountNumber)}
</span>
</div>

<button
class="btn copy-btn"
onclick="copyAccount('${escapeJS(accountNumber)}')">

📋 Copy Account Number

</button>

</div>


<div class="date">
Requested: ${escapeHTML(
p.created_at || "-"
)}
</div>

${
status === "PENDING"
? `
<div class="actions">

<button
class="btn approve"
onclick="approvePayout(${Number(p.id)})">
✓ Approve
</button>

<button
class="btn reject"
onclick="rejectPayout(${Number(p.id)})">
✕ Reject
</button>

</div>
`
: ""
}

`;

box.appendChild(div);

});

}catch(error){

console.error(error);

box.innerHTML =
`<div class="error">
${escapeHTML(error.message)}
</div>`;

}

}


/* =========================
   ESCAPE JS
========================= */

function escapeJS(value){

return String(value ?? "")
.replace(/\\/g,"\\\\")
.replace(/'/g,"\\'")
.replace(/\n/g,"\\n")
.replace(/\r/g,"\\r");

}


/* =========================
   COPY ACCOUNT
========================= */

async function copyAccount(number){

if(
!number ||
number === "-"
){

alert("No account number available.");

return;

}

try{

await navigator.clipboard.writeText(
String(number)
);

alert(
"Account number copied."
);

}catch{

prompt(
"Copy account number:",
number
);

}

}


/* =========================
   APPROVE
========================= */

async function approvePayout(id){

if(!confirm(
"Confirm that this payout has been transferred to the bank account?"
)) return;

try{

const data =
await api(
"/api/payout/approve",
{
method:"POST",

body:JSON.stringify({
id:Number(id)
})
}
);

alert(
data.message ||
"Payout approved successfully."
);

await loadAll();

}catch(error){

alert(
error.message ||
"Unable to approve payout."
);

}

}


/* =========================
   REJECT
========================= */

async function rejectPayout(id){

if(!confirm(
"Reject this withdrawal request?"
)) return;

try{

const data =
await api(
"/api/payout/reject",
{
method:"POST",

body:JSON.stringify({
id:Number(id)
})
}
);

alert(
data.message ||
"Payout rejected successfully."
);

await loadAll();

}catch(error){

alert(
error.message ||
"Unable to reject payout."
);

}

}


/* =========================
   LOAD ALL
========================= */

async function loadAll(){

try{

await loadSummary();

}catch(error){

console.error(
"Summary:",
error
);

if(
error.message.toLowerCase()
.includes("secret")
){

logout();
return;

}

}

await loadPayouts();

}


/* =========================
   LOGOUT
========================= */

function logout(){

sessionStorage.removeItem(
STORAGE_KEY
);

ADMIN_SECRET="";

location.reload();

}


/* =========================
   AUTO LOGIN
========================= */

async function autoLogin(){

if(!ADMIN_SECRET){

return;

}

try{

/*
 Verify stored session before
 showing admin.
*/

const response =
await fetch(
API + "/api/auth",
{
headers:{
"X-Admin-Secret":
ADMIN_SECRET
},
cache:"no-store"
}
);

const data =
await response.json();

if(
response.ok &&
data.success
){

showAdmin();

}else{

sessionStorage.removeItem(
STORAGE_KEY
);

ADMIN_SECRET="";

}

}catch(error){

console.error(
"Auto login:",
error
);

sessionStorage.removeItem(
STORAGE_KEY
);

ADMIN_SECRET="";

}

}


autoLogin();

</script>

</body>
</html>

