<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>365 Bible Calendar 2027</title>

<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Sinhala:wght@400;500;700&family=Noto+Sans+Tamil:wght@400;500;700&display=swap" rel="stylesheet">

<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.2.5.1.min.js"></script>

<style>
*{box-sizing:border-box;margin:0;padding:0}

body{
 background:#d7d0c7;
 color:#302c28;
 font-family:Arial,sans-serif;
 padding:18px
}

.controls{
 width:min(1100px,100%);
 margin:0 auto 18px;
 background:#fffdf9;
 border:1px solid #bdb1a2;
 border-radius:12px;
 padding:16px;
 box-shadow:0 5px 20px #0002
}

.controls h2{
 font:700 18px Georgia,serif;
 margin-bottom:12px;
 color:#4b394f
}

.grid{
 display:grid;
 grid-template-columns:repeat(2,1fr);
 gap:10px
}

.options{
 display:grid;
 grid-template-columns:repeat(3,1fr);
 gap:10px;
 margin-top:10px
}

label{
 display:block;
 font-size:10px;
 font-weight:bold;
 color:#554d47;
 margin:5px 0
}

input,textarea,select{
 width:100%;
 border:1px solid #c9bdae;
 border-radius:7px;
 background:#fff;
 padding:8px;
 font:inherit;
 color:#302c28
}

textarea{
 height:58px;
 resize:vertical
}

input[type=range]{
 padding:0;
 accent-color:#70557b
}

.bar{
 display:grid;
 grid-template-columns:1fr 42px;
 gap:7px;
 align-items:center
}

.value{
 font-size:10px;
 text-align:center;
 font-weight:bold;
 color:#70557b
}

.buttons{
 display:flex;
 gap:8px;
 flex-wrap:wrap;
 margin-top:13px
}

button{
 border:1px solid #5d4967;
 border-radius:7px;
 padding:9px 14px;
 background:#70557b;
 color:#fff;
 font-weight:bold;
 cursor:pointer
}

button:hover{background:#5c4667}

.calendar{
 width:min(1100px,100%);
 aspect-ratio:16/10;
 margin:auto;
 position:relative;
 overflow:hidden;
 background:#f5eee3;
 border:1px solid #9d9183;
 outline:1px solid #776b60;
 outline-offset:-6px;
 box-shadow:0 8px 25px #0003;
 -webkit-print-color-adjust:exact;
 print-color-adjust:exact
}

.photo{
 position:absolute;
 left:4.5%;
 top:8%;
 bottom:8%;
 width:29%;
 overflow:hidden;
 border-radius:3px;
 background:#b8b8ae;
 box-shadow:0 2px 7px #0002,inset 0 0 0 1px #ffffff55
}

#art,#art svg{
 width:100%;
 height:100%;
 display:block
}

.content{
 position:absolute;
 left:37%;
 right:5%;
 top:5%;
 bottom:5%;
 display:flex;
 flex-direction:column;
 min-width:0;
 min-height:0
}

/* MORE SPACE FOR VERSES */
.dateRow{
 height:14%;
 min-height:55px;
 display:flex;
 align-items:center;
 position:relative;
 border-bottom:1px solid #d8cec1;
 flex-shrink:0
}

.dateText{
 font-family:Georgia,"Times New Roman",serif;
 font-size:clamp(36px,5.5vw,68px);
 font-weight:700;
 line-height:1;
 color:#51465b;
 letter-spacing:-1px
}

.icon{
 position:absolute;
 right:1px;
 top:2px;
 font-family:Georgia,serif;
 font-size:18px;
 color:#69546f
}

.verses{
 flex:1;
 min-height:0;
 position:relative;
 overflow:hidden;
 margin-top:6px;
 margin-bottom:2px
}

#verseBox{
 position:absolute;
 left:0;
 right:0;
 top:0;
 bottom:0;
 display:flex;
 flex-direction:column;
 min-width:0;
 min-height:0;
 height:100%;
 overflow:hidden
}

/* LARGE THREE-LANGUAGE AREA */
.section{
 width:100%;
 min-width:0;
 min-height:0;
 flex:1 1 0;
 border-top:1px solid #ddd3c8;
 padding:8px 13px;
 margin-top:5px;
 overflow:hidden;
 display:flex;
 align-items:flex-start;
 position:relative
}

.section:first-of-type{
 border-top:0;
 padding-top:5px;
 margin-top:0
}

.verseText{
 display:block;
 width:100%;
 max-width:100%;
 min-width:0;
 max-height:100%;
 padding:2px 0;
 overflow:hidden;
 overflow-wrap:anywhere;
 word-break:break-word;
 white-space:normal;
 hyphens:auto;
 flex:0 0 auto;
 position:relative;
 transform:translateY(0)
}

.enText{
 font-family:Georgia,"Times New Roman",serif;
 color:#49334f;
 line-height:1.28;
 font-weight:500
}

.taText{
 font-family:"Noto Sans Tamil","Latha","Vijaya",sans-serif;
 color:#76502f;
 line-height:1.42;
 font-weight:500
}

.siText{
 font-family:"Noto Sans Sinhala","Iskoola Pota",sans-serif;
 color:#3f604a;
 line-height:1.42;
 font-weight:500
}

.left{text-align:left}
.center{text-align:center}
.right{text-align:right}

.ref{
 min-height:27px;
 flex-shrink:0;
 display:flex;
 align-items:center;
 justify-content:center;
 border-top:1px solid #d8cec1;
 color:#756c65;
 font:700 clamp(9px,1vw,13px) Georgia,serif;
 letter-spacing:.3px;
 margin-top:3px;
 text-align:center;
 overflow:hidden;
 overflow-wrap:anywhere
}

@media(max-width:700px){

 body{padding:7px}

 .controls{padding:10px}

 .grid,.options{
  grid-template-columns:1fr
 }

 .calendar{
  aspect-ratio:16/10
 }

 .photo{
  left:4%;
  width:29%
 }

 .content{
  left:37%;
  right:4%;
  top:4%;
  bottom:4%
 }

 .dateRow{
  height:13%;
  min-height:42px
 }

 .dateText{
  font-size:clamp(22px,6vw,42px)
 }

 .icon{
  font-size:14px
 }

 .verses{
  margin-top:4px
 }

 .section{
  padding:4px 8px;
  margin-top:3px
 }

 .section:first-of-type{
  padding-top:3px
 }

 .ref{
  min-height:20px
 }
}

@media print{

 body{
  padding:0;
  background:#fff
 }

 .controls{
  display:none
 }

 .calendar{
  width:9in;
  height:5.625in;
  margin:0;
  box-shadow:none
 }
}
</style>
</head>

<body>

<div class="controls">

<h2>365 Bible Calendar 2027</h2>

<div class="grid">

<div>
<label>Date</label>
<input id="date" type="date"
 min="2027-01-01"
 max="2027-12-31"
 value="2027-01-01">
</div>

<div>
<label>Bible Reference</label>
<input id="ref" type="text" placeholder="Example: John 3:16">
</div>

</div>

<div class="options">

<div>
<label>English Verse</label>
<textarea id="en" placeholder="Enter English Bible verse"></textarea>

<label>Size</label>
<div class="bar">
<input id="ens" type="range" min="12" max="38" value="25">
<span class="value" id="ensv">25</span>
</div>
</div>

<div>
<label>Tamil Verse</label>
<textarea id="ta" placeholder="தமிழ் வேதாகம வசனம்"></textarea>

<label>Size</label>
<div class="bar">
<input id="tas" type="range" min="10" max="30" value="18">
<span class="value" id="tasv">18</span>
</div>
</div>

<div>
<label>Sinhala Verse</label>
<textarea id="si" placeholder="සිංහල බයිබල් පදය"></textarea>

<label>Size</label>
<div class="bar">
<input id="sis" type="range" min="10" max="30" value="18">
<span class="value" id="sisv">18</span>
</div>
</div>

<div>
<label>English Alignment</label>
<select id="ena">
<option value="left">Left</option>
<option value="center">Center</option>
<option value="right">Right</option>
</select>
</div>

<div>
<label>Tamil Alignment</label>
<select id="taa">
<option value="left">Left</option>
<option value="center">Center</option>
<option value="right">Right</option>
</select>
</div>

<div>
<label>Sinhala Alignment</label>
<select id="sia">
<option value="left">Left</option>
<option value="center">Center</option>
<option value="right">Right</option>
</select>
</div>

<div>
<label>Verse Position</label>
<div class="bar">
<input id="cp" type="range" min="0" max="100" value="0">
<span class="value" id="cpv">Top</span>
</div>
</div>

<div>
<label>Language Space</label>
<div class="bar">
<input id="space" type="range" min="0" max="25" value="5">
<span class="value" id="spacev">5</span>
</div>
</div>

</div>

<div class="buttons">
<button onclick="move(-1)">Previous</button>
<button onclick="move(1)">Next</button>
<button onclick="update()">Generate</button>
<button onclick="downloadPDF()">Download PDF</button>
</div>

</div>

<div class="calendar" id="calendar">

<div class="photo">
<div id="art"></div>
</div>

<div class="content">

<div class="dateRow">
<div class="dateText" id="dateText"></div>
<div class="icon">✝</div>
</div>

<div class="verses" id="verses">

<div id="verseBox">

<div class="section">
<div id="enText" class="verseText enText left"></div>
</div>

<div class="section">
<div id="taText" class="verseText taText left"></div>
</div>

<div class="section">
<div id="siText" class="verseText siText left"></div>
</div>

</div>
</div>

<div class="ref" id="refText"></div>

</div>
</div>

<script>

const $=id=>document.getElementById(id);

function dateStr(d){
 return d.getFullYear()+"-"+
 String(d.getMonth()+1).padStart(2,"0")+"-"+
 String(d.getDate()).padStart(2,"0")
}

function doy(d){
 return Math.floor(
  (d-new Date(d.getFullYear(),0,1))/86400000
 )+1
}

const scenes=[
 "mountain","lake","forest","river",
 "sunrise","sunset","valley","path",
 "water","hill","mist","meadow"
];

function rand(n){
 let x=Math.sin(n*999.91)*43758.5453;
 return x-Math.floor(x)
}

function svgDefs(n){

 let u="d"+n;

 return `
<defs>

<linearGradient id="sky${u}" x1="0" y1="0" x2="0" y2="1">
<stop offset="0" stop-color="#718fa0"/>
<stop offset=".42" stop-color="#b8c1b9"/>
<stop offset="1" stop-color="#e6d4bd"/>
</linearGradient>

<linearGradient id="ground${u}" x1="0" y1="0" x2="0" y2="1">
<stop offset="0" stop-color="#71816d"/>
<stop offset="1" stop-color="#25362c"/>
</linearGradient>

<linearGradient id="water${u}" x1="0" y1="0" x2="0" y2="1">
<stop offset="0" stop-color="#9ab7ba"/>
<stop offset="1" stop-color="#466d76"/>
</linearGradient>

<linearGradient id="mist${u}" x1="0" y1="0" x2="1" y2="0">
<stop offset="0" stop-color="#fff" stop-opacity=".05"/>
<stop offset=".5" stop-color="#fff" stop-opacity=".38"/>
<stop offset="1" stop-color="#fff" stop-opacity=".05"/>
</linearGradient>

<filter id="blur${u}">
<feGaussianBlur stdDeviation="9"/>
</filter>

</defs>

<rect width="500" height="700" fill="url(#sky${u})"/>
`
}

function clouds(n){

 let s="";

 for(let i=0;i<4;i++){

  let x=40+rand(n+i)*400;
  let y=55+rand(n+i*4)*155;
  let w=60+rand(n+i*7)*95;

  s+=`
<g opacity=".22">
<ellipse cx="${x}" cy="${y}" rx="${w}" ry="17" fill="#fff"/>
<ellipse cx="${x-w*.35}" cy="${y+5}" rx="${w*.38}" ry="13" fill="#fff"/>
<ellipse cx="${x+w*.3}" cy="${y+4}" rx="${w*.32}" ry="14" fill="#fff"/>
</g>`;
 }

 return s
}

function mountainLayer(seed,y,color){

 let a=70+rand(seed)*100;
 let b=170+rand(seed+1)*120;
 let c=280+rand(seed+2)*100;
 let d=390+rand(seed+3)*90;

 return `
<path
 d="M0 ${y+120}
 L${a} ${y-20-rand(seed)*50}
 L${b} ${y+55}
 L${c} ${y-60-rand(seed+4)*45}
 L${d} ${y+25}
 L500 ${y-20}
 V700 H0Z"
 fill="${color}"/>
`
}

function tree(x,y,s=1,opacity=1){

 return `
<g opacity="${opacity}">

<path
 d="M${x} ${y+90*s} L${x} ${y+45*s}"
 stroke="#382f28"
 stroke-width="${7*s}"/>

<path
 d="M${x} ${y}
 L${x-28*s} ${y+43*s}
 H${x-12*s}
 L${x-35*s} ${y+72*s}
 H${x+35*s}
 L${x+12*s} ${y+43*s}
 H${x+28*s} Z"
 fill="#294235"/>

</g>
`
}

function trees(seed,count=8){

 let s="";

 for(let i=0;i<count;i++){

  let x=25+i*62+rand(seed+i)*30;
  let y=445+rand(seed+i*3)*45;
  let scale=.65+rand(seed+i*5)*.7;

  s+=tree(x,y,scale,.78)
 }

 return s
}

function sun(seed,color){

 let x=80+rand(seed)*340;
 let y=100+rand(seed+2)*140;

 return `
<circle cx="${x}" cy="${y}" r="55"
 fill="${color}" opacity=".9"/>

<circle cx="${x}" cy="${y}" r="92"
 fill="${color}" opacity=".13"/>
`
}

function water(seed,u,y=360){

 return `
<path
 d="M0 ${y}
 Q250 ${y-40-rand(seed)*25} 500 ${y}
 V700 H0Z"
 fill="url(#water${u})"/>

<g opacity=".28" stroke="#e8eeee" fill="none">

<path d="M30 430 Q250 400 470 430" stroke-width="5"/>
<path d="M70 485 Q250 460 430 485" stroke-width="3"/>
<path d="M110 535 Q250 515 390 535" stroke-width="2"/>

</g>
`
}

function pathScene(seed){

 let end=150+rand(seed)*210;

 return `
<path
 d="M0 430 Q250 370 500 430 V700 H0Z"
 fill="#536953"/>

<path
 d="M245 700 Q${end+80} 570 ${end} 430"
 fill="none"
 stroke="#b99c76"
 stroke-width="78"/>

${trees(seed+4,6)}
`
}

function artSVG(n){

 let type=scenes[(n-1)%scenes.length];
 let u="d"+n;
 let s=svgDefs(n)+clouds(n);

 if(type==="mountain"){
  s+=mountainLayer(n,290,"#89918a");
  s+=mountainLayer(n+10,350,"#66736c");
  s+=`<path d="M0 430 Q250 370 500 430 V700 H0Z" fill="url(#ground${u})"/>`;
  s+=trees(n);
 }

 if(type==="lake"){
  s+=mountainLayer(n,260,"#89928c");
  s+=mountainLayer(n+5,335,"#596861");
  s+=water(n,u,360);
  s+=trees(n+10,6);
 }

 if(type==="forest"){
  s+=`<path d="M0 390 Q250 330 500 390 V700 H0Z" fill="#4a604d"/>`;
  s+=trees(n,12);
  s+=pathScene(n+20);
 }

 if(type==="river"){
  s+=mountainLayer(n,280,"#77837d");

  s+=`
<path
 d="M190 700
 Q${330+rand(n)*60} 570
 ${150+rand(n)*100} 450
 Q250 385 330 340"
 fill="#668d96"
 stroke="#dce8e3"
 stroke-width="3"/>

<path
 d="M230 700 Q350 570 220 450"
 fill="none"
 stroke="#fff"
 stroke-width="5"
 opacity=".2"/>`;

  s+=trees(n+5);
 }

 if(type==="sunrise"){
  s+=sun(n,"#f6d38c");
  s+=mountainLayer(n,300,"#707b75");
  s+=mountainLayer(n+7,390,"#43554d");
  s+=trees(n+2);
 }

 if(type==="sunset"){
  s+=sun(n+5,"#df956b");
  s+=mountainLayer(n,300,"#686f69");
  s+=mountainLayer(n+7,390,"#37483f");
  s+=trees(n+3);
 }

 if(type==="valley"){

  s+=`
<path
 d="M0 410 L140 180 L250 410 L370 160 L500 410 V700 H0Z"
 fill="#66736d"/>

<path
 d="M0 455 Q250 365 500 455 V700 H0Z"
 fill="url(#ground${u})"/>`;

  s+=trees(n+3);
 }

 if(type==="path"){
  s+=mountainLayer(n,280,"#77837d");
  s+=pathScene(n);
 }

 if(type==="water"){
  s+=mountainLayer(n,290,"#7b8780");
  s+=water(n,u,360);
  s+=trees(n+8,6);
 }

 if(type==="hill"){

  s+=`
<path
 d="M0 440
 Q130 ${280+rand(n)*70} 270 430
 Q390 ${270+rand(n+4)*60} 500 440
 V700 H0Z"
 fill="#63745f"/>

<path
 d="M0 505 Q250 415 500 505 V700 H0Z"
 fill="url(#ground${u})"/>`;

  s+=trees(n+3);
 }

 if(type==="mist"){

  s+=mountainLayer(n,280,"#83908a");
  s+=mountainLayer(n+6,350,"#66736d");

  s+=`
<path
 d="M0 405 Q250 360 500 405"
 stroke="#fff"
 stroke-width="35"
 opacity=".25"
 filter="url(#blur${u})"/>

<path
 d="M0 475 Q250 430 500 475"
 stroke="#fff"
 stroke-width="22"
 opacity=".18"
 filter="url(#blur${u})"/>`;

  s+=trees(n+3,7);
 }

 if(type==="meadow"){

  s+=`
<path
 d="M0 400 Q250 330 500 400 V700 H0Z"
 fill="#65765d"/>

<path
 d="M0 500 Q250 420 500 500 V700 H0Z"
 fill="url(#ground${u})"/>`;

  s+=pathScene(n+9);
 }

 s+=`

<rect width="500" height="700"
 fill="#17231e"
 opacity=".055"/>

<rect width="500" height="700"
 fill="url(#mist${u})"
 opacity=".12"/>

<text
 x="250"
 y="640"
 text-anchor="middle"
 font-family="Georgia,serif"
 font-size="19"
 font-weight="700"
 letter-spacing="3"
 fill="#ffffff"
 opacity=".94">
VERSE OF THE DAY
</text>`;

 return `
<svg
 xmlns="http://www.w3.org/2000/svg"
 viewBox="0 0 500 700"
 preserveAspectRatio="xMidYMid slice">
${s}
</svg>`
}

function applySpacing(){

 let v=+$("space").value;

 document.querySelectorAll(".section").forEach((el,i)=>{

  if(i===0){

   el.style.marginTop="0";
   el.style.paddingTop="5px";

  }else{

   el.style.marginTop=v+"px";
   el.style.paddingTop=Math.max(3,v/2)+"px";

  }

 })
}

function fitVerses(){

 [
  ["enText","ens"],
  ["taText","tas"],
  ["siText","sis"]
 ].forEach(([id,sid])=>{

  let text=$(id);
  let section=text.closest(".section");

  if(!text||!section)return;

  let size=+$(sid).value;

  text.style.transform="translateY(0)";
  text.style.fontSize=size+"px";
  text.style.maxHeight="none";

  let guard=0;

  while(
   text.scrollHeight>section.clientHeight &&
   size>8 &&
   guard<100
  ){

   size-=.5;
   text.style.fontSize=size+"px";
   guard++;

  }

  text.style.maxHeight=
   Math.max(1,section.clientHeight-4)+"px";

 })
}

/*
0%  = TOP
50% = CENTER
100% = BOTTOM
*/
function applyPosition(){

 let v=+$("cp").value;

 $("cpv").textContent=
  v===0?"Top":
  v===50?"Center":
  v===100?"Bottom":
  v+"%";

 document.querySelectorAll(".section").forEach(section=>{

  let text=section.querySelector(".verseText");

  if(!text)return;

  let available=
   section.clientHeight-
   text.offsetHeight;

  available=Math.max(0,available);

  let offset=
   (available*(v-50))/100;

  text.style.transform=
   "translateY("+offset+"px";

 })
}

function applyAlignment(){

 $("enText").className=
  "verseText enText "+$("ena").value;

 $("taText").className=
  "verseText taText "+$("taa").value;

 $("siText").className=
  "verseText siText "+$("sia").value;
}

function update(){

 let d=
  new Date($("date").value+"T00:00:00");

 if(isNaN(d))return;

 $("dateText").textContent=
  d.toLocaleDateString(
   "en-US",
   {month:"short",day:"numeric"}
  );

 $("art").innerHTML=
  artSVG(doy(d));

 $("enText").textContent=
  $("en").value.trim();

 $("taText").textContent=
  $("ta").value.trim();

 $("siText").textContent=
  $("si").value.trim();

 $("refText").textContent=
  $("ref").value.trim();

 $("ensv").textContent=$("ens").value;
 $("tasv").textContent=$("tas").value;
 $("sisv").textContent=$("sis").value;
 $("spacev").textContent=$("space").value;

 applyAlignment();
 applySpacing();

 requestAnimationFrame(()=>{
  requestAnimationFrame(()=>{
   fitVerses();
   applyPosition();
  })
 })
}

function move(step){

 let d=
  new Date($("date").value+"T00:00:00");

 d.setDate(d.getDate()+step);

 let min=
  new Date("2027-01-01T00:00:00");

 let max=
  new Date("2027-12-31T00:00:00");

 if(d<min)d=min;
 if(d>max)d=max;

 $("date").value=dateStr(d);

 update();
}

async function downloadPDF(){

 fitVerses();
 applyPosition();

 await new Promise(r=>setTimeout(r,150));

 let canvas=
  await html2canvas(
   $("calendar"),
   {
    scale:3,
    useCORS:true,
    backgroundColor:"#f5eee3",
    logging:false
   }
  );

 let pdf=
  new jspdf.jsPDF({
   orientation:"landscape",
   unit:"in",
   format:[9,5.625]
  });

 pdf.addImage(
  canvas.toDataURL("image/png"),
  "PNG",
  0,
  0,
  9,
  5.625
 );

 pdf.save(
  "365-Bible-Calendar-"+$("date").value+".pdf"
 )
}

$("en").value=
"For God so loved the world that he gave his one and only Son, that whoever believes in him shall not perish but have eternal life.";

$("ta").value=
