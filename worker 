====================================================== */

async function membership(
    request,
    env
){

    const auth =
        await getAuthUser(
            request,
            env
        );


    if(!auth){

        return json({

            success:true,
            loggedIn:false,
            active:false

        });

    }


    const subscription =
        await env.DB.prepare(
            `SELECT
                status,
                started_at,
                expires_at
             FROM subscriptions
             WHERE user_id = ?
             ORDER BY id DESC
             LIMIT 1`
        )
        .bind(auth.userId)
        .first();


    if(!subscription){

        return json({

            success:true,
            loggedIn:true,
            active:false,
            paymentPending:false

        });

    }


    const active =
        subscription.status === "active" &&
        subscription.expires_at &&
        new Date(
            subscription.expires_at
        ).getTime() > Date.now();


    if(active){

        return json({

            success:true,

            loggedIn:true,

            active:true,

            status:"active",

            startedAt:
                subscription.started_at,

            expiresAt:
                subscription.expires_at,

            daysRemaining:
                daysRemaining(
                    subscription.expires_at
                )

        });

    }


    const pending =
        await env.DB.prepare(
            `SELECT id
             FROM payments
             WHERE user_id = ?
             AND status = 'pending'
             ORDER BY id DESC
             LIMIT 1`
        )
        .bind(auth.userId)
        .first();


    return json({

        success:true,

        loggedIn:true,

        active:false,

        paymentPending:
            !!pending

    });

}


