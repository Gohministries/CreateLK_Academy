/* ======================================================
   RECEIPT UPLOAD
====================================================== */

async function uploadReceipt(
    request,
    env
){

    const auth =
        await getAuthUser(
            request,
            env
        );


    if(!auth){

        return error(
            "Please login first.",
            401
        );

    }


    const form =
        await request.formData();


    const paymentId =
        String(
            form.get("paymentId") || ""
        );


    const file =
        form.get("receipt");


    if(!paymentId){

        return error(
            "Payment ID is required."
        );

    }


    if(
        !file ||
        typeof file === "string"
    ){

        return error(
            "Please select a receipt file."
        );

    }


    if(file.size > 10 * 1024 * 1024){

        return error(
            "Receipt must be 10 MB or smaller."
        );

    }


    const allowed = [

        "image/jpeg",
        "image/png",
        "image/webp",
        "application/pdf"

    ];


    if(
        !allowed.includes(
            file.type
        )
    ){

        return error(
            "Only JPG, PNG, WEBP or PDF receipts are allowed."
        );

    }


    const payment =
        await env.DB.prepare(
            `SELECT id
             FROM payments
             WHERE id = ?
             AND user_id = ?`
        )
        .bind(
            paymentId,
            auth.userId
        )
        .first();


    if(!payment){

        return error(
            "Payment not found.",
            404
        );

    }


    const extension =
        file.type === "application/pdf"
            ? "pdf"
            : file.type === "image/png"
                ? "png"
                : file.type === "image/webp"
                    ? "webp"
                    : "jpg";


    const key =
        `receipts/${auth.userId}/${paymentId}-${crypto.randomUUID()}.${extension}`;


    await env.RECEIPTS.put(
        key,
        file.stream(),
        {
            httpMetadata:{
                contentType:file.type
            }
        }
    );


    await env.DB.prepare(
        `UPDATE payments
         SET receipt_key = ?
         WHERE id = ?
         AND user_id = ?`
    )
    .bind(
        key,
        paymentId,
        auth.userId
    )
    .run();


    return json({

        success:true,

        message:
            "Receipt uploaded successfully.",

        paymentId,

        status:"pending"

    });

}


/* ======================================================
   ADMIN APPROVE PAYMENT
====================================================== */

async function approvePayment(
    request,
    env
){

    const adminKey =
        request.headers.get(
            "X-Admin-Key"
        );


    if(
        !adminKey ||
        adminKey !== env.ADMIN_KEY
    ){

        return error(
            "Unauthorized.",
            401
        );

    }


    let body;

    try{

        body =
            await request.json();

    }catch{

        return error(
            "Invalid JSON."
        );

    }


    const paymentId =
        Number(body.paymentId);


    if(!paymentId){

        return error(
            "Payment ID is required."
        );

    }


    const payment =
        await env.DB.prepare(
            `SELECT
                id,
                user_id,
                amount,
                status
             FROM payments
             WHERE id = ?`
        )
        .bind(paymentId)
        .first();


    if(!payment){

        return error(
            "Payment not found.",
            404
        );

    }


    if(
        payment.amount !== 1500
    ){

        return error(
            "Invalid payment amount."
        );

    }


    const now =
        new Date().toISOString();

    const expires =
        addDays(now,30);


    await env.DB.prepare(
        `UPDATE payments
         SET status = 'approved',
             approved_at = ?
         WHERE id = ?`
    )
    .bind(
        now,
        paymentId
    )
    .run();


    await env.DB.prepare(
        `INSERT INTO subscriptions
        (
            user_id,
            status,
            started_at,
            expires_at
        )
        VALUES (?,?,?,?)`
    )
    .bind(
        payment.user_id,
        "active",
        now,
        expires
    )
    .run();


    return json({

        success:true,

        message:
            "Payment approved and Premium activated.",

        userId:
            payment.user_id,

        startedAt:now,

        expiresAt:expires,

        daysRemaining:30

    });

}


/* ======================================================
   AI QUESTION VALIDATION
====================================================== */

function validateQuestion(q){

    if(
        !q ||
        typeof q.question !== "string" ||
        !Array.isArray(q.options) ||
        q.options.length !== 4 ||
        typeof q.answer !== "string" ||
        typeof q.explanation !== "string"
    ){

        return false;

    }


    if(
        q.options.some(
            option =>
                typeof option !== "string"
                || !option.trim()
        )
    ){

        return false;

    }


    if(
        !q.options.includes(
            q.answer
        )
    ){

        return false;

    }


    return true;

}


/* ======================================================
   GENERATE 20 QUESTIONS
====================================================== */

async function generateBatch(
    env,
    startNumber
){

    const schema = {

        type:"object",

        properties:{

            questions:{
                type:"array",

                items:{

                    type:"object",

                    properties:{

                        question:{
                            type:"string"
                        },

                        options:{
                            type:"array",

                            items:{
                                type:"string"
                            },

                            minItems:4,
                            maxItems:4
                        },

                        answer:{
                            type:"string"
                        },

                        explanation:{
                            type:"string"
                        }

                    },

                    required:[
                        "question",
                        "options",
                        "answer",
                        "explanation"
                    ]

                },

                minItems:20,
                maxItems:20

            }

        },

        required:[
            "questions"
        ]

    };


    const response =
        await env.AI.run(
            MODEL,
            {

                messages:[

                    {
                        role:"system",

                        content:
                        `You are an expert English teacher creating General English MCQs.

Create exactly 20 different multiple-choice questions.

Each question must have:
- one clear question
- exactly 4 options
- exactly one correct answer
- a short explanation

The correct answer MUST exactly match one of the four option strings.

Do not add numbering.
Do not add markdown.
Do not add comments.
Return only the requested JSON structure.`
                    },

                    {
                        role:"user",

                        content:
                        `Generate questions ${startNumber} to ${startNumber + 19}.

Topics may include:
grammar,
vocabulary,
articles,
prepositions,
tenses,
subject-verb agreement,
pronouns,
adjectives,
adverbs,
sentence correction,
word meaning,
common English usage.

Do not repeat common patterns from earlier questions.
Make the questions suitable for General English learners.`
                    }

                ],

                response_format:{

                    type:"json_schema",

                    json_schema:schema

                }

            }
        );


    if(
        !response ||
        !response.response
    ){

        throw new Error(
            "Workers AI did not return a valid response."
        );

    }


    const data =
        typeof response.response === "string"
        ? JSON.parse(response.response)
        : response.response;


    if(
        !data.questions ||
        data.questions.length !== 20
    ){

        throw new Error(
            "AI did not return exactly 20 questions."
        );

    }


    for(
        const q of data.questions
    ){

        if(!validateQuestion(q)){

            throw new Error(
                "AI returned an invalid question."
            );

        }

    }


    return data.questions;

}


/* ======================================================
   AI MCQ ENDPOINT
====================================================== */

async function generateMCQs(
    request,
    env
){

    const auth =
        await getAuthUser(
            request,
            env
        );


    if(!auth){

        return error(
            "Please login first.",
            401
        );

    }


    const subscription =
        await env.DB.prepare(
            `SELECT
                status,
                expires_at
             FROM subscriptions
             WHERE user_id = ?
             ORDER BY id DESC
             LIMIT 1`
        )
        .bind(auth.userId)
        .first();


    if(
        !subscription ||
        subscription.status !== "active" ||
        !subscription.expires_at ||
        new Date(
            subscription.expires_at
        ).getTime() <= Date.now()
    ){

        return error(
            "Premium membership is not active.",
            403
        );

    }


    const date =
        today();


    const usage =
        await env.DB.prepare(
            `SELECT
                question_count
             FROM daily_usage
             WHERE user_id = ?
             AND usage_date = ?`
        )
        .bind(
            auth.userId,
            date
        )
        .first();


    const used =
        Number(
            usage?.question_count || 0
        );


    if(used >= 100){

        return error(
            "You have reached today's 100-question limit.",
            429
        );

    }


    /*
    Every generation requested by this
    endpoint is exactly 100 questions.

    We reserve the daily limit before
    running AI to prevent duplicate
    concurrent requests.
    */

    const reserved =
        await env.DB.prepare(
            `INSERT INTO daily_usage
            (
                user_id,
                usage_date,
                question_count
            )
            VALUES (?,?,100)
            ON CONFLICT(user_id,usage_date)
            DO UPDATE SET
                question_count =
                    question_count + 100,
                updated_at =
                    CURRENT_TIMESTAMP
            WHERE question_count = 0`
        )
        .bind(
            auth.userId,
            date
        )
        .run();


    /*
    If an existing row already has
    any usage, don't allow another
    100-question generation.
    */

    if(
        !reserved.success ||
        reserved.meta.changes !== 1
    ){

        return error(
            "You have already used today's AI generation.",
            429
        );

    }


    try{

        const batches = [];

        for(
            let i = 0;
            i < 5;
            i++
        ){

            const batch =
                await generateBatch(
                    env,
                    i * 20 + 1
                );

            batches.push(...batch);

        }


        if(
            batches.length !== 100
        ){

            throw new Error(
                "AI did not generate exactly 100 questions."
            );

        }


        return json({

            success:true,

            subject:"General English",

            count:100,

            dailyLimit:100,

            questions:batches

        });


    }catch(e){

        /*
        AI failed.

        Release the reserved usage
        so the user can try again.
        */

        await env.DB.prepare(
            `UPDATE daily_usage
             SET question_count = 0,
                 updated_at = CURRENT_TIMESTAMP
             WHERE user_id = ?
             AND usage_date = ?`
        )
        .bind(
            auth.userId,
            date
        )
        .run();


        console.error(
            "AI MCQ error:",
            e
        );


        return error(
            "AI could not generate the questions. Please try again.",
            500
        );

    }

}


/* ======================================================
   ROUTER
====================================================== */

export default {

    async fetch(
        request,
        env
    ){

        try{

            if(
                request.method === "OPTIONS"
            ){

                return corsResponse();

            }


            const url =
                new URL(
                    request.url
                );


            const path =
                url.pathname;


            if(
                request.method === "GET" &&
                path === "/api/health"
            ){

                return health(env);

            }


            if(
                request.method === "POST" &&
                path === "/api/register"
            ){

                return register(
                    request,
                    env
                );

            }


            if(
                request.method === "POST" &&
                path === "/api/login"
            ){

                return login(
                    request,
                    env
                );

            }


            if(
                request.method === "GET" &&
                path === "/api/membership"
            ){

                return membership(
                    request,
                    env
                );

            }


            if(
                request.method === "POST" &&
                path === "/api/payment"
            ){

                return createPayment(
                    request,
                    env
                );

            }


            if(
                request.method === "POST" &&
                path === "/api/receipt"
            ){

                return uploadReceipt(
                    request,
                    env
                );

            }


            if(
                request.method === "POST" &&
                path === "/api/admin/approve"
            ){

                return approvePayment(
                    request,
                    env
                );

            }


            if(
                request.method === "POST" &&
                path === "/api/ai-mcq"
            ){

                return generateMCQs(
                    request,
                    env
                );

            }


            return error(
                "Endpoint not found.",
                404
            );


        }catch(e){

            console.error(
                "Worker error:",
                e
            );


            return error(
                "Internal server error.",
                500
            );

        }

    }

}; 