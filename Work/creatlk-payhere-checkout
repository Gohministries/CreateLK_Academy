const MERCHANT_ID = "257692";

const PRICE = "999.00";
const CURRENCY = "LKR";
const PREMIUM_DAYS = 30;

const RETURN_URL =
  "https://creatlk.com/dashboard.html";

const CANCEL_URL =
  "https://creatlk.com/dashboard.html";

const NOTIFY_URL =
  "https://creatlk-payhere-checkout.createlk.workers.dev/api/notify";

const ALLOWED_ORIGINS = [
  "https://creatlk.com",
  "https://www.creatlk.com"
];

function cors(request) {
  const origin = request.headers.get("Origin") || "";

  return {
    "Access-Control-Allow-Origin":
      ALLOWED_ORIGINS.includes(origin)
        ? origin
        : "https://creatlk.com",
    "Access-Control-Allow-Methods":
      "GET, POST, OPTIONS",
    "Access-Control-Allow-Headers":
      "Content-Type, Accept",
    "Access-Control-Max-Age":
      "86400"
  };
}

function json(request, data, status = 200) {
  return new Response(
    JSON.stringify(data),
    {
      status,
      headers: {
        ...cors(request),
        "Content-Type": "application/json"
      }
    }
  );
}

async function md5(text) {

  const data =
    new TextEncoder().encode(text);

  const hash =
    await crypto.subtle.digest(
      "MD5",
      data
    );

  return Array.from(
    new Uint8Array(hash)
  )
    .map(x =>
      x.toString(16).padStart(2, "0")
    )
    .join("");
}

async function generateHash(
  merchantId,
  orderId,
  amount,
  currency,
  secret
) {

  const amountFormatted =
    Number(amount).toFixed(2);

  const secretHash =
    await md5(secret);

  return (
    await md5(
      merchantId +
      orderId +
      amountFormatted +
      currency +
      secretHash
    )
  ).toUpperCase();
}

function makeOrderId(studentId) {

  return (
    "CLA-" +
    studentId +
    "-" +
    Date.now()
  );
}

export default {

  async fetch(request, env) {

    const url =
      new URL(request.url);

    /* CORS */

    if (request.method === "OPTIONS") {

      return new Response(null, {
        status: 204,
        headers: cors(request)
      });

    }

    /* HOME */

    if (
      request.method === "GET" &&
      url.pathname === "/"
    ) {

      return json(request, {
        success: true,
        service:
          "CreateLK Academy PayHere",
        checkout:
          "/api/checkout",
        notify:
          "/api/notify"
      });

    }

    /* CHECKOUT */

    if (
      request.method === "POST" &&
      url.pathname === "/api/checkout"
    ) {

      try {

        const body =
          await request.json();

        const studentId =
          Number(body.student_id);

        if (!studentId) {

          return json(
            request,
            {
              error:
                "Student ID is required."
            },
            400
          );

        }

        if (
          !env.PAYHERE_MERCHANT_SECRET
        ) {

          return json(
            request,
            {
              error:
                "PayHere Merchant Secret is not configured."
            },
            500
          );

        }

        const student =
          await env.DB.prepare(
            `SELECT *
             FROM students_v2
             WHERE id = ?
             LIMIT 1`
          )
          .bind(studentId)
          .first();

        if (!student) {

          return json(
            request,
            {
              error:
                "Student not found."
            },
            404
          );

        }

        const orderId =
          makeOrderId(studentId);

        const hash =
          await generateHash(
            MERCHANT_ID,
            orderId,
            PRICE,
            CURRENCY,
            env.PAYHERE_MERCHANT_SECRET
          );

        /*
         * PayHere requires the payment form
         * to be submitted to this URL.
         */

        const paymentUrl =
          "https://www.payhere.lk/pay/checkout";

        const firstName =
          String(
            student.first_name || "Student"
          );

        const lastName =
          String(
            student.last_name || ""
          );

        const email =
          String(
            student.email || ""
          );

        const phone =
          String(
            student.phone || ""
          );

        const form = `
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>PayHere Payment</title>
</head>

<body>

<form
id="payhereForm"
method="POST"
action="${paymentUrl}">

<input
type="hidden"
name="merchant_id"
value="${escapeHtml(MERCHANT_ID)}">

<input
type="hidden"
name="return_url"
value="${escapeHtml(RETURN_URL)}">

<input
type="hidden"
name="cancel_url"
value="${escapeHtml(CANCEL_URL)}">

<input
type="hidden"
name="notify_url"
value="${escapeHtml(NOTIFY_URL)}">

<input
type="hidden"
name="order_id"
value="${escapeHtml(orderId)}">

<input
type="hidden"
name="items"
value="CreateLK Academy Spoken English Premium">

<input
type="hidden"
name="currency"
value="${CURRENCY}">

<input
type="hidden"
name="amount"
value="${PRICE}">

<input
type="hidden"
name="first_name"
value="${escapeHtml(firstName)}">

<input
type="hidden"
name="last_name"
value="${escapeHtml(lastName)}">

<input
type="hidden"
name="email"
value="${escapeHtml(email)}">

<input
type="hidden"
name="phone"
value="${escapeHtml(phone)}">

<input
type="hidden"
name="country"
value="Sri Lanka">

<input
type="hidden"
name="hash"
value="${hash}">

</form>

<script>
document.getElementById("payhereForm").submit();
</script>

</body>
</html>
`;

        return new Response(
          form,
          {
            status: 200,
            headers: {
              ...cors(request),
              "Content-Type":
                "text/html; charset=UTF-8"
            }
          }
        );

      } catch (error) {

        console.error(
          "CHECKOUT:",
          error
        );

        return json(
          request,
          {
            error:
              error.message ||
              "Checkout failed."
          },
          500
        );

      }

    }


    /* PAYHERE NOTIFY */

    if (
      request.method === "POST" &&
      url.pathname === "/api/notify"
    ) {

      try {

        const form =
          await request.formData();

        const merchantId =
          String(
            form.get("merchant_id") || ""
          );

        const orderId =
          String(
            form.get("order_id") || ""
          );

        const statusCode =
          String(
            form.get("status_code") || ""
          );

        const amount =
          String(
            form.get("payhere_amount") || ""
          );

        const currency =
          String(
            form.get("payhere_currency") || ""
          );

        const studentId =
          Number(
            form.get("custom_1") ||
            0
          );


        if (
          merchantId !== MERCHANT_ID
        ) {

          return new Response(
            "Invalid merchant",
            {
              status: 400,
              headers: cors(request)
            }
          );

        }


        if (!studentId) {

          return new Response(
            "Missing student",
            {
              status: 400,
              headers: cors(request)
            }
          );

        }


        /*
         * Only status 2 is successful.
         */

        if (statusCode !== "2") {

          return new Response(
            "OK",
            {
              status: 200,
              headers: cors(request)
            }
          );

        }


        if (
          currency !== CURRENCY ||
          Number(amount) !== Number(PRICE)
        ) {

          return new Response(
            "Invalid payment",
            {
              status: 400,
              headers: cors(request)
            }
          );

        }


        /*
         * Avoid duplicate payment.
         */

        const existing =
          await env.DB.prepare(
            `SELECT id
             FROM payments
             WHERE order_id = ?
             LIMIT 1`
          )
          .bind(orderId)
          .first();


        if (!existing) {

          await env.DB.prepare(
            `INSERT INTO payments
             (student_id, order_id, amount, currency, status)
             VALUES (?, ?, ?, ?, ?)`
          )
          .bind(
            studentId,
            orderId,
            Number(amount),
            currency,
            "APPROVED"
          )
          .run();

        }


        /*
         * Get existing expiry.
         */

        const student =
          await env.DB.prepare(
            `SELECT membership_expiry
             FROM students_v2
             WHERE id = ?
             LIMIT 1`
          )
          .bind(studentId)
          .first();


        let start =
          new Date();


        if (
          student &&
          student.membership_expiry
        ) {

          const oldExpiry =
            new Date(
              String(
                student.membership_expiry
              ).replace(" ", "T")
            );

          if (
            !Number.isNaN(
              oldExpiry.getTime()
            ) &&
            oldExpiry > start
          ) {

            start = oldExpiry;

          }

        }


        const expiry =
          new Date(start);

        expiry.setDate(
          expiry.getDate() +
          PREMIUM_DAYS
        );


        const expiryText =
          expiry.toISOString()
          .slice(0, 19)
          .replace("T", " ");


        /*
         * Activate Premium.
         */

        await env.DB.prepare(
          `UPDATE students_v2
           SET membership_status = ?,
               membership_expiry = ?
           WHERE id = ?`
        )
        .bind(
          "PREMIUM",
          expiryText,
          studentId
        )
        .run();


        /*
         * Save subscription.
         */

        await env.DB.prepare(
          `INSERT INTO subscriptions
           (student_id, status, start_date, end_date)
           VALUES (?, ?, ?, ?)`
        )
        .bind(
          studentId,
          "ACTIVE",
          start.toISOString(),
          expiryText
        )
        .run();


        return new Response(
          "OK",
          {
            status: 200,
            headers: cors(request)
          }
        );


      } catch (error) {

        console.error(
          "NOTIFY:",
          error
        );

        return new Response(
          "ERROR",
          {
            status: 500,
            headers: cors(request)
          }
        );

      }

    }


    return json(
      request,
      {
        error: "Not found"
      },
      404
    );

  }

};


function escapeHtml(value) {

  return String(value)
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#039;");

}