const APP_URL="https://createlk.com/v3/";
const COOKIE_NAME="english_v3_session";
const SESSION_DAYS=7;
const FREE_LIMIT=300;
const PREMIUM_LIMIT=1000;
const GOOGLE_REDIRECT="https://createlk.com/v3/auth/google/callback";

function json(data,status=200){
  return new Response(JSON.stringify(data),{
    status,
    headers:{
      "Content-Type":"application/json",
      "Access-Control-Allow-Origin":"https://createlk.com",
      "Access-Control-Allow-Credentials":"true",
      "Access-Control-Allow-Headers":"Content-Type,Authorization",
      "Access-Control-Allow-Methods":"GET,POST,OPTIONS",
      "Cache-Control":"no-store"
    }
  });
}

function cookie(req,name){
  const h=req.headers.get("Cookie")||"";
  for(const x of h.split(";")){
    const [k,...v]=x.trim().split("=");
    if(k===name)return decodeURIComponent(v.join("="));
  }
  return null;
}

function setCookie(value,maxAge=SESSION_DAYS*86400){
  return [
    `${COOKIE_NAME}=${encodeURIComponent(value)}`,
    "Path=/",
    "HttpOnly",
    "Secure",
    "SameSite=Lax",
    `Max-Age=${maxAge}`
  ].join("; ");
}

async function setup(env){
  await env.DB.prepare(`
    CREATE TABLE IF NOT EXISTS sessions(
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      token TEXT UNIQUE,
      user_id INTEGER,
      expires_at TEXT
    )
  `).run();

  await env.DB.prepare(`
    CREATE TABLE IF NOT EXISTS oauth_states(
      state TEXT PRIMARY KEY,
      created_at TEXT DEFAULT CURRENT_TIMESTAMP
    )
  `).run();

  await env.DB.prepare(`
    CREATE TABLE IF NOT EXISTS quiz_answers(
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      user_id INTEGER,
      question_id INTEGER,
      lesson_id INTEGER,
      selected_answer TEXT,
      is_correct INTEGER DEFAULT 0,
      xp_awarded INTEGER DEFAULT 0,
      coins_awarded INTEGER DEFAULT 0,
      created_at TEXT DEFAULT CURRENT_TIMESTAMP,
      UNIQUE(user_id,question_id)
    )
  `).run();

  try{
    await env.DB.prepare(`
      ALTER TABLE quiz_answers
      ADD COLUMN coins_awarded INTEGER DEFAULT 0
    `).run();
  }catch(e){}

  await env.DB.prepare(`
    CREATE TABLE IF NOT EXISTS monthly_usage(
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      user_id INTEGER,
      month TEXT,
      questions_answered INTEGER DEFAULT 0,
      UNIQUE(user_id,month)
    )
  `).run();
}

async function getUser(req,env){
  const token=cookie(req,COOKIE_NAME);
  if(!token)return null;
  await setup(env);

  return env.DB.prepare(`
    SELECT u.*
    FROM sessions s
    JOIN users u ON u.id=s.user_id
    WHERE s.token=?
    AND s.expires_at>datetime('now')
    LIMIT 1
  `).bind(token).first();
}

function month(){
  const d=new Date();
  return `${d.getUTCFullYear()}-${String(d.getUTCMonth()+1).padStart(2,"0")}`;
}

function premium(u){
  if(!u)return false;

  const m=String(
    u.membership||u.membership_status||""
  ).toLowerCase();

  if(m==="premium")return true;

  if(u.membership_expiry){
    const d=new Date(u.membership_expiry);
    if(!isNaN(d)&&d>Date.now())return true;
  }

  return false;
}

async function usage(env,u){
  await setup(env);

  const m=month();

  await env.DB.prepare(`
    INSERT INTO monthly_usage(
      user_id,month,questions_answered
    )
    VALUES(?,?,0)
    ON CONFLICT(user_id,month) DO NOTHING
  `).bind(u.id,m).run();

  const r=await env.DB.prepare(`
    SELECT questions_answered
    FROM monthly_usage
    WHERE user_id=? AND month=?
    LIMIT 1
  `).bind(u.id,m).first();

  const limit=premium(u)?PREMIUM_LIMIT:FREE_LIMIT;
  const answered=Number(r?.questions_answered||0);

  return{
    month:m,
    answered,
    limit,
    remaining:Math.max(0,limit-answered),
    premium:premium(u)
  };
}

async function addUsage(env,u){
  const m=month();

  await env.DB.prepare(`
    INSERT INTO monthly_usage(
      user_id,month,questions_answered
    )
    VALUES(?,?,1)
    ON CONFLICT(user_id,month)
    DO UPDATE SET questions_answered=questions_answered+1
  `).bind(u.id,m).run();

  return usage(env,u);
}

async function lessonAccess(env,u,id){
  const lesson=await env.DB.prepare(`
    SELECT *
    FROM lessons
    WHERE id=?
    LIMIT 1
  `).bind(id).first();

  if(!lesson)return{error:"Lesson not found",status:404};

  const free=
    Number(lesson.id)===1||
    Number(lesson.is_free||0)===1;

  if(!free&&!premium(u)){
    return{
      error:"Premium membership required",
      status:403
    };
  }

  return{lesson};
}

async function googleUrl(env){
  await setup(env);

  if(!env.GOOGLE_CLIENT_ID)
    throw new Error("GOOGLE_CLIENT_ID is missing");

  const state=crypto.randomUUID();

  await env.DB.prepare(`
    INSERT INTO oauth_states(state)
    VALUES(?)
  `).bind(state).run();

  return "https://accounts.google.com/o/oauth2/v2/auth?"+
    new URLSearchParams({
      client_id:env.GOOGLE_CLIENT_ID,
      redirect_uri:GOOGLE_REDIRECT,
      response_type:"code",
      scope:"openid email profile",
      state,
      prompt:"select_account"
    });
}

async function googleToken(code,env){
  if(!env.GOOGLE_CLIENT_ID||!env.GOOGLE_CLIENT_SECRET)
    throw new Error("Google OAuth secrets are missing");

  const r=await fetch(
    "https://oauth2.googleapis.com/token",
    {
      method:"POST",
      headers:{
        "Content-Type":"application/x-www-form-urlencoded"
      },
      body:new URLSearchParams({
        client_id:env.GOOGLE_CLIENT_ID,
        client_secret:env.GOOGLE_CLIENT_SECRET,
        code,
        grant_type:"authorization_code",
        redirect_uri:GOOGLE_REDIRECT
      })
    }
  );

  if(!r.ok)throw new Error(await r.text());
  return r.json();
}

async function googleProfile(token){
  const r=await fetch(
    "https://www.googleapis.com/oauth2/v3/userinfo",
    {
      headers:{
        Authorization:`Bearer ${token}`
      }
    }
  );

  if(!r.ok)throw new Error("Google profile failed");
  return r.json();
}

async function saveUser(profile,env){
  const googleId=String(profile.sub||"");
  const email=String(profile.email||"");
  const name=String(
    profile.name||
    email.split("@")[0]||
    "User"
  );
  const avatar=String(profile.picture||"");

  if(!googleId||!email)
    throw new Error("Google account information missing");

  const old=await env.DB.prepare(`
    SELECT *
    FROM users
    WHERE google_id=?
    LIMIT 1
  `).bind(googleId).first();

  if(!old){
    const code=
      "CLK"+
      Math.random()
      .toString(36)
      .substring(2,8)
      .toUpperCase();

    await env.DB.prepare(`
      INSERT INTO users(
        google_id,email,name,avatar_url,
        membership,xp,coins,
        correct_answers,questions_answered,
        lessons_completed,affiliate_code
      )
      VALUES(?,?,?,?,?,?,?,?,?,?,?)
    `).bind(
      googleId,
      email,
      name,
      avatar,
      "free",
      0,
      0,
      0,
      0,
      0,
      code
    ).run();
  }else{
    await env.DB.prepare(`
      UPDATE users
      SET email=?,name=?,avatar_url=?
      WHERE google_id=?
    `).bind(
      email,
      name,
      avatar,
      googleId
    ).run();
  }

  return env.DB.prepare(`
    SELECT *
    FROM users
    WHERE google_id=?
    LIMIT 1
  `).bind(googleId).first();
}

async function createSession(id,env){
  const token=
    crypto.randomUUID()+"-"+crypto.randomUUID();

  const expires=new Date(
    Date.now()+SESSION_DAYS*86400000
  ).toISOString();

  await env.DB.prepare(`
    INSERT INTO sessions(token,user_id,expires_at)
    VALUES(?,?,?)
  `).bind(token,id,expires).run();

  return token;
}

function publicUser(u){
  if(!u)return null;

  return{
    id:u.id,
    email:u.email,
    name:u.name,
    avatar_url:u.avatar_url,
    membership:premium(u)?"premium":"free",
    membership_expiry:u.membership_expiry||null,
    xp:Number(u.xp||0),
    coins:Number(u.coins||0),
    correct_answers:Number(u.correct_answers||0),
    questions_answered:Number(u.questions_answered||0),
    lessons_completed:Number(u.lessons_completed||0),
    affiliate_code:u.affiliate_code||null,
    referred_by:u.referred_by||null
  };
}

export default{
  async fetch(req,env){

    const url=new URL(req.url);

    if(req.method==="OPTIONS"){
      return new Response(null,{
        status:204,
        headers:{
          "Access-Control-Allow-Origin":"https://createlk.com",
          "Access-Control-Allow-Credentials":"true",
          "Access-Control-Allow-Headers":"Content-Type,Authorization",
          "Access-Control-Allow-Methods":"GET,POST,OPTIONS"
        }
      });
    }

    if(url.pathname==="/api/health"){
      return json({
        success:true,
        status:"online"
      });
    }

    if(url.pathname==="/auth/google"){
      try{
        return Response.redirect(
          await googleUrl(env),
          302
        );
      }catch(e){
        return new Response(
          "Google Login Error: "+e.message,
          {status:500}
        );
      }
    }

    if(url.pathname==="/auth/google/callback"){
      try{
        const code=url.searchParams.get("code");
        const state=url.searchParams.get("state");

        if(!code||!state)
          return new Response(
            "Missing OAuth data",
            {status:400}
          );

        await setup(env);

        const saved=await env.DB.prepare(`
          SELECT state
          FROM oauth_states
          WHERE state=?
          LIMIT 1
        `).bind(state).first();

        if(!saved)
          return new Response(
            "Invalid OAuth state",
            {status:400}
          );

        await env.DB.prepare(`
          DELETE FROM oauth_states
          WHERE state=?
        `).bind(state).run();

        const token=await googleToken(code,env);
        const profile=await googleProfile(token.access_token);
        const u=await saveUser(profile,env);
        const session=await createSession(u.id,env);

        return new Response(null,{
          status:302,
          headers:{
            Location:APP_URL,
            "Set-Cookie":setCookie(session)
          }
        });

      }catch(e){
        return new Response(
          "Google Login Failed: "+e.message,
          {status:500}
        );
      }
    }

    if(url.pathname==="/auth/logout"){
      const token=cookie(req,COOKIE_NAME);

      if(token){
        await env.DB.prepare(`
          DELETE FROM sessions
          WHERE token=?
        `).bind(token).run();
      }

      return new Response(null,{
        status:302,
        headers:{
          Location:APP_URL,
          "Set-Cookie":setCookie("",0)
        }
      });
    }

    if(url.pathname==="/api/me"){
      const u=await getUser(req,env);

      if(!u){
        return json({
          success:true,
          logged_in:false,
          user:null,
          monthly:null
        });
      }

      return json({
        success:true,
        logged_in:true,
        user:publicUser(u),
        monthly:await usage(env,u)
      });
    }

    if(url.pathname==="/api/lessons"){
      await setup(env);

      const u=await getUser(req,env);

      const result=await env.DB.prepare(`
        SELECT id,title,description,sort_order,is_free
        FROM lessons
        ORDER BY sort_order,id
      `).all();

      return json({
        success:true,
        logged_in:!!u,
        lessons:(result.results||[]).map(x=>({
          ...x,
          accessible:
            Number(x.id)===1||
            Number(x.is_free||0)===1||
            premium(u)
        }))
      });
    }

    if(url.pathname==="/api/quiz"){
      const u=await getUser(req,env);

      if(!u){
        return json({
          success:false,
          error:"Login required"
        },401);
      }

      const id=Number(
        url.searchParams.get("lesson_id")||
        url.searchParams.get("lesson")
      );

      if(!id){
        return json({
          success:false,
          error:"lesson_id is required"
        },400);
      }

      const access=await lessonAccess(env,u,id);

      if(access.error){
        return json({
          success:false,
          error:access.error
        },access.status);
      }

      const monthly=await usage(env,u);

      if(monthly.remaining<=0){
        return json({
          success:false,
          error:"Monthly question limit reached",
          monthly
        },429);
      }

      const result=await env.DB.prepare(`
        SELECT
          id,lesson_id,question,
          option_a,option_b,option_c,option_d
        FROM questions
        WHERE lesson_id=?
        ORDER BY id
      `).bind(id).all();

      return json({
        success:true,
        lesson:access.lesson,
        questions:result.results||[],
        monthly
      });
    }

    if(
      url.pathname==="/api/quiz/answer"&&
      req.method==="POST"
    ){
      const u=await getUser(req,env);

      if(!u){
        return json({
          success:false,
          error:"Login required"
        },401);
      }

      const body=await req.json().catch(()=>null);

      const qid=Number(body?.question_id);
      const lid=Number(body?.lesson_id);
      const selected=String(
        body?.selected_answer||
        body?.answer||
        ""
      ).trim();

      if(!qid||!lid||!selected){
        return json({
          success:false,
          error:"Missing answer data"
        },400);
      }

      const access=await lessonAccess(env,u,lid);

      if(access.error){
        return json({
          success:false,
          error:access.error
        },access.status);
      }

      const monthly=await usage(env,u);

      if(monthly.remaining<=0){
        return json({
          success:false,
          error:"Monthly question limit reached",
          monthly
        },429);
      }

      const question=await env.DB.prepare(`
        SELECT *
        FROM questions
        WHERE id=? AND lesson_id=?
        LIMIT 1
      `).bind(qid,lid).first();

      if(!question){
        return json({
          success:false,
          error:"Question not found"
        },404);
      }

      const old=await env.DB.prepare(`
        SELECT *
        FROM quiz_answers
        WHERE user_id=? AND question_id=?
        LIMIT 1
      `).bind(u.id,qid).first();

      if(old){
        return json({
          success:true,
          already_answered:true,
          is_correct:Number(old.is_correct)===1,
          selected_answer:old.selected_answer,
          correct_answer:question.correct_answer,
          xp_awarded:Number(old.xp_awarded||0),
          coins_awarded:Number(old.coins_awarded||0),
          user:publicUser(u),
          monthly:await usage(env,u)
        });
      }

      const correct=String(
        question.correct_answer||""
      ).trim();

      const ok=
        selected.toUpperCase()===
        correct.toUpperCase();

      const xp=ok?10:0;
      const coins=ok?5:0;

      await env.DB.prepare(`
        INSERT INTO quiz_answers(
          user_id,question_id,lesson_id,
          selected_answer,is_correct,
          xp_awarded,coins_awarded
        )
        VALUES(?,?,?,?,?,?,?)
      `).bind(
        u.id,
        qid,
        lid,
        selected,
        ok?1:0,
        xp,
        coins
      ).run();

      await env.DB.prepare(`
        UPDATE users
        SET
          xp=MIN(10000,COALESCE(xp,0)+?),
          coins=COALESCE(coins,0)+?,
          correct_answers=COALESCE(correct_answers,0)+?,
          questions_answered=COALESCE(questions_answered,0)+1
        WHERE id=?
      `).bind(
        xp,
        coins,
        ok?1:0,
        u.id
      ).run();

      const updated=await env.DB.prepare(`
        SELECT *
        FROM users
        WHERE id=?
        LIMIT 1
      `).bind(u.id).first();

      return json({
        success:true,
        already_answered:false,
        is_correct:ok,
        selected_answer:selected,
        correct_answer:correct,
        xp_awarded:xp,
        coins_awarded:coins,
        user:publicUser(updated),
        monthly:await addUsage(env,updated)
      });
    }

    return json({
      success:false,
      error:"Not found"
    },404);
  }
};