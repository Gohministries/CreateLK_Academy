const APP_URL="https://createlk.com/v3/",COOKIE_NAME="english_v3_session",SESSION_DAYS=7,XP_PER_CORRECT=10,COINS_PER_CORRECT=5,MAX_XP=10000,FREE_MONTHLY_LIMIT=300,PREMIUM_MONTHLY_LIMIT=1000;

const cors=r=>{const o=r.headers.get("Origin");return{"Access-Control-Allow-Origin":o||"*","Access-Control-Allow-Credentials":"true","Access-Control-Allow-Methods":"GET,POST,OPTIONS","Access-Control-Allow-Headers":"Content-Type, Authorization","Vary":"Origin"}};

const json=(d,s,r)=>new Response(JSON.stringify(d),{status:s||200,headers:{"Content-Type":"application/json; charset=UTF-8","Cache-Control":"no-store",...cors(r)}});

function cookie(r,n){
 const c=r.headers.get("Cookie")||"",e=n.replace(/[.*+?^${}()|[\]\\]/g,"\\$&"),m=c.match(new RegExp("(?:^|;\\s*)"+e+"=([^;]*)"));
 return m?decodeURIComponent(m[1]):null
}

function randomString(n=32){
 const b=new Uint8Array(n);
 crypto.getRandomValues(b);
 return Array.from(b,x=>x.toString(16).padStart(2,"0")).join("")
}

const sessionCookie=(t,a=SESSION_DAYS*86400)=>[
 `${COOKIE_NAME}=${encodeURIComponent(t)}`,
 "Path=/",
 `Max-Age=${a}`,
 "HttpOnly",
 "Secure",
 "SameSite=None"
].join("; ");

async function ensureSessionsTable(e){
 await e.DB.prepare(`
 CREATE TABLE IF NOT EXISTS sessions(
 token TEXT PRIMARY KEY,
 user_id TEXT NOT NULL,
 expires_at TEXT NOT NULL,
 created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
 )`).run()
}

async function currentUser(r,e){
 const t=cookie(r,COOKIE_NAME);
 if(!t)return null;
 await ensureSessionsTable(e);
 return e.DB.prepare(`
 SELECT
 u.id,u.google_id,u.email,u.name,u.avatar_url,
 u.membership,u.xp,u.coins,u.correct_answers,
 u.questions_answered,u.lessons_completed,
 u.affiliate_code,u.referred_by,
 s.expires_at AS session_expires_at
 FROM sessions s
 JOIN users u ON u.id=s.user_id
 WHERE s.token=? AND s.expires_at>?
 LIMIT 1
 `).bind(t,new Date().toISOString()).first()
}

async function createSession(e,id){
 await ensureSessionsTable(e);
 const t=randomString(32);
 const x=new Date(Date.now()+SESSION_DAYS*86400000).toISOString();
 await e.DB.prepare(`
 INSERT INTO sessions(token,user_id,expires_at)
 VALUES(?,?,?)
 `).bind(t,id,x).run();
 return t
}

async function googleUser(t){
 const r=await fetch(
 "https://www.googleapis.com/oauth2/v3/userinfo",
 {headers:{Authorization:`Bearer ${t}`}}
 );
 if(!r.ok)throw Error("Unable to retrieve Google account information");
 return r.json()
}

async function googleToken(e,c,u){
 const b=new URLSearchParams({
  client_id:e.GOOGLE_CLIENT_ID,
  client_secret:e.GOOGLE_CLIENT_SECRET,
  code:c,
  grant_type:"authorization_code",
  redirect_uri:u
 });

 const r=await fetch(
 "https://oauth2.googleapis.com/token",
 {
  method:"POST",
  headers:{"Content-Type":"application/x-www-form-urlencoded"},
  body:b
 }
 );

 if(!r.ok)throw Error(`Google token exchange failed: ${await r.text()}`);
 return r.json()
}

async function quizTable(e){
 await e.DB.prepare(`
 CREATE TABLE IF NOT EXISTS quiz_answers(
 id INTEGER PRIMARY KEY AUTOINCREMENT,
 user_id TEXT NOT NULL,
 question_id INTEGER NOT NULL,
 lesson_id INTEGER NOT NULL,
 selected_answer TEXT NOT NULL,
 is_correct INTEGER NOT NULL DEFAULT 0,
 xp_awarded INTEGER NOT NULL DEFAULT 0,
 coins_awarded INTEGER NOT NULL DEFAULT 0,
 answered_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
 UNIQUE(user_id,question_id)
 )`).run();

 try{
  await e.DB.prepare(`
  ALTER TABLE quiz_answers
  ADD COLUMN coins_awarded INTEGER NOT NULL DEFAULT 0
  `).run()
 }catch(_){}
}

async function monthlyTable(e){
 await e.DB.prepare(`
 CREATE TABLE IF NOT EXISTS monthly_usage(
 user_id TEXT NOT NULL,
 month_key TEXT NOT NULL,
 answered INTEGER NOT NULL DEFAULT 0,
 PRIMARY KEY(user_id,month_key)
 )`).run()
}

const monthKey=()=>{
 const d=new Date();
 return`${d.getUTCFullYear()}-${String(d.getUTCMonth()+1).padStart(2,"0")}`
};

async function getMonthlyUsage(e,u){
 await monthlyTable(e);

 const k=monthKey();

 const r=await e.DB.prepare(`
 SELECT answered
 FROM monthly_usage
 WHERE user_id=? AND month_key=?
 LIMIT 1
 `).bind(u.id,k).first();

 const answered=Number(r?.answered||0);
 const premium=String(u.membership||"").toLowerCase()==="premium";
 const limit=premium?PREMIUM_MONTHLY_LIMIT:FREE_MONTHLY_LIMIT;

 return{
  answered,
  limit,
  remaining:Math.max(0,limit-answered)
 }
}

async function incrementMonthlyUsage(e,u){
 await monthlyTable(e);

 const k=monthKey();

 await e.DB.prepare(`
 INSERT INTO monthly_usage(user_id,month_key,answered)
 VALUES(?,?,1)
 ON CONFLICT(user_id,month_key)
 DO UPDATE SET answered=answered+1
 `).bind(u.id,k).run();

 return getMonthlyUsage(e,u)
}

async function referralTable(e){
 await e.DB.prepare(`
 CREATE TABLE IF NOT EXISTS referrals(
 id INTEGER PRIMARY KEY AUTOINCREMENT,
 affiliate_user_id TEXT NOT NULL,
 referred_user_id TEXT NOT NULL UNIQUE,
 affiliate_code TEXT NOT NULL,
 created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
 )`).run()
}

async function lessonAccess(e,u,id){
 const l=await e.DB.prepare(`
 SELECT id,title,description,sort_order,is_free
 FROM lessons
 WHERE id=?
 LIMIT 1
 `).bind(id).first();

 if(!l)return{error:"Lesson not found",status:404};

 const free=
  Number(l.is_free)===1||
  Number(l.id)===1;

 if(
  !free&&
  String(u?.membership||"").toLowerCase()!=="premium"
 ){
  return{
   error:"Premium membership required",
   status:403
  }
 }

 return{lesson:l}
}

export default{
 async fetch(request,env){

  const url=new URL(request.url);

  if(request.method==="OPTIONS"){
   return new Response(null,{
    status:204,
    headers:cors(request)
   })
  }

  try{

   /* HOME */

   if(url.pathname==="/"){
    return new Response(
     "CreateLK English V3 API is running ✅",
     {
      headers:{
       "Content-Type":"text/plain; charset=UTF-8",
       ...cors(request)
      }
     }
    )
   }

   /* HEALTH */

   if(url.pathname==="/api/health"){
    const r=await env.DB.prepare(
     "SELECT 1 AS ok"
    ).first();

    return json({
     success:true,
     database:r?.ok===1,
     database_name:"createlk-english-v3"
    },200,request)
   }

   /* TABLES */

   if(url.pathname==="/api/tables"){
    const r=await env.DB.prepare(`
     SELECT name
     FROM sqlite_master
     WHERE type='table'
     ORDER BY name
    `).all();

    return json({
     success:true,
     tables:r.results||[]
    },200,request)
   }

   /* GOOGLE LOGIN */

   if(url.pathname==="/auth/google"){

    if(!env.GOOGLE_CLIENT_ID){
     return json({
      success:false,
      error:"GOOGLE_CLIENT_ID secret is missing"
     },500,request)
    }

    const state=randomString(32);
    const redirectUri=
     `${url.origin}/auth/google/callback`;

    const g=new URL(
     "https://accounts.google.com/o/oauth2/v2/auth"
    );

    g.searchParams.set(
     "client_id",
     env.GOOGLE_CLIENT_ID
    );

    g.searchParams.set(
     "redirect_uri",
     redirectUri
    );

    g.searchParams.set(
     "response_type",
     "code"
    );

    g.searchParams.set(
     "scope",
     "openid email profile"
    );

    g.searchParams.set(
     "access_type",
     "online"
    );

    g.searchParams.set(
     "prompt",
     "select_account"
    );

    g.searchParams.set(
     "state",
     state
    );

    return new Response(null,{
     status:302,
     headers:{
      Location:g.toString(),
      "Set-Cookie":[
       `oauth_state=${state}`,
       "Path=/auth/google",
       "Max-Age=600",
       "HttpOnly",
       "Secure",
       "SameSite=Lax"
      ].join("; ")
     }
    })
   }

   /* GOOGLE CALLBACK */

   if(url.pathname==="/auth/google/callback"){

    const code=url.searchParams.get("code");
    const state=url.searchParams.get("state");
    const saved=cookie(request,"oauth_state");

    if(!code){
     return json({
      success:false,
      error:"Google authorization code missing"
     },400,request)
    }

    if(!state||!saved||state!==saved){
     return json({
      success:false,
      error:"Invalid OAuth state"
     },400,request)
    }

    const tokens=await googleToken(
     env,
     code,
     `${url.origin}/auth/google/callback`
    );

    if(!tokens.access_token){
     throw Error(
      "Google did not return an access token"
     )
    }

    const g=await googleUser(
     tokens.access_token
    );

    if(!g.sub||!g.email){
     throw Error(
      "Google account information is incomplete"
     )
    }

    const referralCode=
     cookie(request,"referral_code");

    let user=await env.DB.prepare(`
     SELECT *
     FROM users
     WHERE google_id=?
     LIMIT 1
    `).bind(g.sub).first();

    if(!user){
     user=await env.DB.prepare(`
      SELECT *
      FROM users
      WHERE email=?
      LIMIT 1
     `).bind(g.email).first();
    }

    let userId;

    if(user){

     userId=user.id;

     await env.DB.prepare(`
      UPDATE users
      SET
       google_id=?,
       name=?,
       avatar_url=?,
       updated_at=CURRENT_TIMESTAMP
      WHERE id=?
     `).bind(
      g.sub,
      g.name||g.email.split("@")[0],
      g.picture||null,
      userId
     ).run();

    }else{

     userId=crypto.randomUUID();

     const affiliateCode=
      randomString(6).toUpperCase();

     let referredBy=null;

     if(referralCode){

      const a=await env.DB.prepare(`
       SELECT user_id,affiliate_code
       FROM affiliates
       WHERE affiliate_code=?
       LIMIT 1
      `).bind(
       referralCode.trim().toUpperCase()
      ).first();

      if(a)referredBy=a.affiliate_code
     }

     await env.DB.prepare(`
      INSERT INTO users(
       id,google_id,email,name,avatar_url,
       membership,xp,coins,correct_answers,
       questions_answered,lessons_completed,
       affiliate_code,referred_by
      )
      VALUES(
       ?,?,?,?,?, 
       'free',0,0,0,0,0,?,?
      )
     `).bind(
      userId,
      g.sub,
      g.email,
      g.name||g.email.split("@")[0],
      g.picture||null,
      affiliateCode,
      referredBy
     ).run();

     await env.DB.prepare(`
      INSERT OR IGNORE INTO affiliates(
       user_id,affiliate_code
      )
      VALUES(?,?)
     `).bind(
      userId,
      affiliateCode
     ).run();

     if(referredBy){

      await referralTable(env);

      const a=await env.DB.prepare(`
       SELECT user_id
       FROM affiliates
       WHERE affiliate_code=?
       LIMIT 1
      `).bind(referredBy).first();

      if(a){
       await env.DB.prepare(`
        INSERT OR IGNORE INTO referrals(
         affiliate_user_id,
         referred_user_id,
         affiliate_code
        )
        VALUES(?,?,?)
       `).bind(
        a.user_id,
        userId,
        referredBy
       ).run()
      }
     }
    }

    const session=
     await createSession(env,userId);

    const response=new Response(null,{
     status:302,
     headers:{Location:APP_URL}
    });

    response.headers.append(
     "Set-Cookie",
     sessionCookie(session)
    );

    response.headers.append(
     "Set-Cookie",
     [
      "oauth_state=",
      "Path=/auth/google",
      "Max-Age=0",
      "HttpOnly",
      "Secure",
      "SameSite=Lax"
     ].join("; ")
    );

    response.headers.append(
     "Set-Cookie",
     [
      "referral_code=",
      "Path=/",
      "Max-Age=0",
      "Secure",
      "SameSite=Lax"
     ].join("; ")
    );

    return response
   }

   /* LOGOUT */

   if(url.pathname==="/auth/logout"){

    const token=cookie(
     request,
     COOKIE_NAME
    );

    if(token){
     await ensureSessionsTable(env);

     await env.DB.prepare(`
      DELETE FROM sessions
      WHERE token=?
     `).bind(token).run();
    }

    const response=new Response(null,{
     status:302,
     headers:{Location:APP_URL}
    });

    response.headers.append(
     "Set-Cookie",
     sessionCookie("",0)
    );

    return response
   }

   /* CURRENT USER */

   if(url.pathname==="/api/me"){

    const u=
     await currentUser(request,env);

    if(!u){
     return json({
      success:true,
      logged_in:false,
      user:null
     },200,request)
    }

    const m=
     await getMonthlyUsage(env,u);

    return json({
     success:true,
     logged_in:true,
     user:u,
     monthly_answered:m.answered,
     monthly_limit:m.limit,
     monthly_remaining:m.remaining
    },200,request)
   }

   /* REFERRAL */

   if(url.pathname==="/api/referral"){

    const code=(
     url.searchParams.get("code")||
     url.searchParams.get("ref")||
     ""
    ).trim().toUpperCase();

    if(!code){
     return json({
      success:false,
      error:"Referral code missing"
     },400,request)
    }

    const a=await env.DB.prepare(`
     SELECT user_id,affiliate_code
     FROM affiliates
     WHERE affiliate_code=?
     LIMIT 1
    `).bind(code).first();

    if(!a){
     return json({
      success:false,
      error:"Invalid referral code"
     },404,request)
    }

    return json({
     success:true,
     referral_code:a.affiliate_code,
     valid:true
    },200,request)
   }

   /* LESSONS
      IMPORTANT:
      Login is NOT required here.
   */

   if(url.pathname==="/api/lessons"){

    const u=
     await currentUser(request,env);

    const r=await env.DB.prepare(`
     SELECT
      id,title,description,
      sort_order,is_free
     FROM lessons
     ORDER BY sort_order,id
    `).all();

    const premium=
     String(u?.membership||"").toLowerCase()==="premium";

    return json({
     success:true,
     logged_in:!!u,
     lessons:(r.results||[]).map(l=>({
      ...l,
      accessible:
       Number(l.is_free)===1||
       Number(l.id)===1||
       premium
     }))
    },200,request)
   }

   /* QUIZ */

   if(url.pathname==="/api/quiz"){

    const u=
     await currentUser(request,env);

    if(!u){
     return json({
      success:false,
      error:"Login required"
     },401,request)
    }

    const id=Number(
     url.searchParams.get("lesson_id")||
     url.searchParams.get("lesson")||
     0
    );

    if(!id){
     return json({
      success:false,
      error:"lesson_id is required"
     },400,request)
    }

    const a=
     await lessonAccess(env,u,id);

    if(a.error){
     return json({
      success:false,
      error:a.error
     },a.status,request)
    }

    const r=await env.DB.prepare(`
     SELECT
      id,lesson_id,question,
      option_a,option_b,
      option_c,option_d
     FROM questions
     WHERE lesson_id=?
     ORDER BY id
    `).bind(id).all();

    return json({
     success:true,
     lesson:a.lesson,
     questions:r.results||[]
    },200,request)
   }

   /* QUIZ ANSWER */

   if(
    url.pathname==="/api/quiz/answer"&&
    request.method==="POST"
   ){

    const u=
     await currentUser(request,env);

    if(!u){
     return json({
      success:false,
      error:"Login required"
     },401,request)
    }

    const b=
     await request.json().catch(()=>null);

    if(!b){
     return json({
      success:false,
      error:"Invalid request body"
     },400,request)
    }

    const questionId=
     Number(b.question_id);

    const lessonId=
     Number(b.lesson_id);

    const selected=
     String(
      b.selected_answer??
      b.answer??
      ""
     ).trim();

    if(
     !questionId||
     !lessonId||
     !selected
    ){
     return json({
      success:false,
      error:
       "question_id, lesson_id and selected_answer are required"
     },400,request)
    }

    const a=
     await lessonAccess(
      env,
      u,
      lessonId
     );

    if(a.error){
     return json({
      success:false,
      error:a.error
     },a.status,request)
    }

    const monthly=
     await getMonthlyUsage(env,u);

    if(monthly.remaining<=0){
     return json({
      success:false,
      error:"Monthly question limit reached",
      monthly
     },429,request)
    }

    await quizTable(env);

    const existing=
     await env.DB.prepare(`
      SELECT *
      FROM quiz_answers
      WHERE user_id=?
      AND question_id=?
      LIMIT 1
     `).bind(
      u.id,
      questionId
     ).first();

    if(existing){
     return json({
      success:true,
      already_answered:true,
      is_correct:
       Number(existing.is_correct)===1,
      xp_awarded:
       Number(existing.xp_awarded||0),
      coins_awarded:
       Number(existing.coins_awarded||0)
     },200,request)
    }

    const q=await env.DB.prepare(`
     SELECT *
     FROM questions
     WHERE id=?
     AND lesson_id=?
     LIMIT 1
    `).bind(
     questionId,
     lessonId
    ).first();

    if(!q){
     return json({
      success:false,
      error:"Question not found"
     },404,request)
    }

    const correct=
     String(q.correct_answer??"").trim();

    const isCorrect=
     selected.toLowerCase()===
     correct.toLowerCase();

    const xp=
     isCorrect?XP_PER_CORRECT:0;

    const coins=
     isCorrect?COINS_PER_CORRECT:0;

    const oldXp=
     Number(u.xp||0);

    const newXp=
     Math.min(MAX_XP,oldXp+xp);

    const actualXp=
     newXp-oldXp;

    await env.DB.prepare(`
     INSERT INTO quiz_answers(
      user_id,
      question_id,
      lesson_id,
      selected_answer,
      is_correct,
      xp_awarded,
      coins_awarded
     )
     VALUES(?,?,?,?,?,?,?)
    `).bind(
     u.id,
     questionId,
     lessonId,
     selected,
     isCorrect?1:0,
     actualXp,
     coins
    ).run();

    const usage=
     await incrementMonthlyUsage(env,u);

    await env.DB.prepare(`
     UPDATE users
     SET
      xp=?,
      coins=COALESCE(coins,0)+?,
      correct_answers=
       COALESCE(correct_answers,0)+?,
      questions_answered=
       COALESCE(questions_answered,0)+1
     WHERE id=?
    `).bind(
     newXp,
     coins,
     isCorrect?1:0,
     u.id
    ).run();

    const updated=
     await env.DB.prepare(`
      SELECT
       id,google_id,email,name,avatar_url,
       membership,xp,coins,
       correct_answers,
       questions_answered,
       lessons_completed,
       affiliate_code,
       referred_by
      FROM users
      WHERE id=?
      LIMIT 1
     `).bind(u.id).first();

    return json({
     success:true,
     already_answered:false,
     is_correct:isCorrect,
     selected_answer:selected,
     correct_answer:correct,
     xp_awarded:actualXp,
     coins_awarded:coins,
     user:updated,
     monthly:usage
    },200,request)
   }

   return json({
    success:false,
    error:"Endpoint not found"
   },404,request)

  }catch(e){

   return json({
    success:false,
    error:e?.message||
     "Internal server error"
   },500,request)
  }
 }
};