const MODEL = "@cf/meta/llama-3.1-8b-instruct-fast";

const FREE_LIMIT = 10;
const PREMIUM_LIMIT = 100;
const CERTIFICATE_TARGET = 1000;

const CORS = {
  "Access-Control-Allow-Origin": "*",
  "Access-Control-Allow-Methods": "GET,POST,OPTIONS",
  "Access-Control-Allow-Headers": "Content-Type"
};


/* =========================
   RESPONSE
========================= */

function json(data, status = 200) {
  return new Response(
    JSON.stringify(data),
    {
      status,
      headers: {
        "Content-Type": "application/json",
        ...CORS
      }
    }
  );
}


/* =========================
   DATE
========================= */

function today() {
  return new Date()
    .toISOString()
    .slice(0, 10);
}


/* =========================
   STUDENT
========================= */

async function getStudent(env, id) {

  return env.DB.prepare(`
    SELECT
      id,
      membership_status,
      membership_expiry
    FROM students
    WHERE id = ?
    LIMIT 1
  `)
  .bind(id)
  .first();
}


/* =========================
   PREMIUM
========================= */

function isPremium(student) {

  if (!student) return false;

  const status =
    String(
      student.membership_status || ""
    ).toUpperCase();

  return (
    (status === "ACTIVE" ||
     status === "PREMIUM") &&

    student.membership_expiry &&

    new Date(
      student.membership_expiry
    ) > new Date()
  );
}


/* =========================
   DAILY USAGE
========================= */

async function getUsage(env, studentId) {

  const row =
    await env.DB.prepare(`
      SELECT used
      FROM ai_daily_usage
      WHERE student_id = ?
      AND usage_date = ?
      LIMIT 1
    `)
    .bind(
      studentId,
      today()
    )
    .first();

  return Number(row?.used || 0);
}


async function addUsage(env, studentId) {

  await env.DB.prepare(`
    INSERT INTO ai_daily_usage
    (
      student_id,
      usage_date,
      used
    )
    VALUES (?, ?, 1)

    ON CONFLICT(
      student_id,
      usage_date
    )

    DO UPDATE SET
      used = used + 1
  `)
  .bind(
    studentId,
    today()
  )
  .run();
}


/* =========================
   PROGRESS
========================= */

async function getProgress(
  env,
  studentId
) {

  const row =
    await env.DB.prepare(`
      SELECT
        COUNT(*) AS total,
        COALESCE(
          SUM(correct),
          0
        ) AS correct
      FROM mcq_attempts
      WHERE student_id = ?
    `)
    .bind(studentId)
    .first();

  const total =
    Number(row?.total || 0);

  const correct =
    Number(row?.correct || 0);

  return {

    total,

    correct,

    accuracy:
      total > 0
        ? Math.round(
            correct / total * 100
          )
        : 0

  };
}


/* =========================
   DATABASE TABLES
========================= */

async function setup(env) {

  await env.DB.prepare(`
    CREATE TABLE IF NOT EXISTS mcq_questions (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      question TEXT NOT NULL,
      option_a TEXT NOT NULL,
      option_b TEXT NOT NULL,
      option_c TEXT NOT NULL,
      option_d TEXT NOT NULL,
      correct_answer INTEGER NOT NULL,
      explanation TEXT,
      category TEXT DEFAULT 'English',
      difficulty TEXT DEFAULT 'Easy',
      created_at TEXT DEFAULT CURRENT_TIMESTAMP
    )
  `).run();


  await env.DB.prepare(`
    CREATE TABLE IF NOT EXISTS mcq_attempts (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      student_id INTEGER NOT NULL,
      question_id INTEGER NOT NULL,
      selected_answer INTEGER NOT NULL,
      correct INTEGER NOT NULL,
      created_at TEXT DEFAULT CURRENT_TIMESTAMP
    )
  `).run();


  await env.DB.prepare(`
    CREATE TABLE IF NOT EXISTS ai_daily_usage (
      student_id INTEGER NOT NULL,
      usage_date TEXT NOT NULL,
      used INTEGER DEFAULT 0,
      PRIMARY KEY (
        student_id,
        usage_date
      )
    )
  `).run();

}


/* =========================
   AI GENERATOR
========================= */

async function generateQuestion(env) {

  const prompt = `
Create ONE English multiple-choice question.

Return ONLY valid JSON.

Use exactly this structure:

{
  "question": "Choose the correct sentence.",
  "options": [
    "She go to school.",
    "She goes to school.",
    "She going to school.",
    "She gone to school."
  ],
  "correct_answer": 1,
  "explanation": "Use goes because the subject is she.",
  "category": "Grammar",
  "difficulty": "Easy"
}

Rules:

- Exactly 4 options.
- Only ONE correct answer.
- correct_answer must be 0, 1, 2, or 3.
- No markdown.
- No code fences.
- No extra text.
- Suitable for English learners.
`;

  try {

    const result =
      await env.AI.run(
        MODEL,
        {

          messages: [

            {
              role: "system",

              content:
                "You are an expert English teacher. Return ONLY valid JSON."
            },

            {
              role: "user",

              content:
                prompt
            }

          ],

          max_tokens: 700,

          temperature: 0.3

        }
      );


    console.log(
      "AI RESULT:",
      JSON.stringify(result)
    );


    /*
      Cloudflare response:
      choices[0].text
    */

    let text =
      result?.choices?.[0]?.text ||
      result?.response ||
      "";


    text =
      String(text)
        .replace(
          /```json/gi,
          ""
        )
        .replace(
          /```/g,
          ""
        )
        .trim();


    const start =
      text.indexOf("{");


    const end =
      text.lastIndexOf("}");


    if (
      start === -1 ||
      end === -1
    ) {

      console.error(
        "AI JSON missing:",
        text
      );

      return null;

    }


    text =
      text.substring(
        start,
        end + 1
      );


    const q =
      JSON.parse(text);


    if (
      !q.question ||
      !Array.isArray(q.options) ||
      q.options.length !== 4
    ) {

      console.error(
        "Invalid AI question:",
        q
      );

      return null;

    }


    const answer =
      Number(
        q.correct_answer
      );


    if (
      !Number.isInteger(answer) ||
      answer < 0 ||
      answer > 3
    ) {

      console.error(
        "Invalid answer:",
        q.correct_answer
      );

      return null;

    }


    return {

      question:
        String(q.question),

      options:
        q.options.map(
          option =>
            String(option)
        ),

      correct_answer:
        answer,

      explanation:
        String(
          q.explanation || ""
        ),

      category:
        String(
          q.category || "English"
        ),

      difficulty:
        String(
          q.difficulty || "Easy"
        )

    };


  } catch(error) {

    console.error(
      "AI ERROR:",
      error
    );

    return null;

  }
}


/* =========================
   GET MCQ
========================= */

async function getMCQ(
  request,
  env
) {

  const url =
    new URL(request.url);


  const studentId =
    Number(
      url.searchParams.get(
        "student_id"
      )
    );


  if (!studentId) {

    return json(
      {
        success: false,
        message:
          "Student ID required."
      },
      400
    );

  }


  const student =
    await getStudent(
      env,
      studentId
    );


  if (!student) {

    return json(
      {
        success: false,
        message:
          "Student not found."
      },
      404
    );

  }


  const premium =
    isPremium(student);


  const limit =
    premium
      ? PREMIUM_LIMIT
      : FREE_LIMIT;


  const used =
    await getUsage(
      env,
      studentId
    );


  if (used >= limit) {

    return json(
      {

        success: false,

        limitReached: true,

        premiumRequired:
          !premium,

        plan:
          premium
            ? "PREMIUM"
            : "FREE",

        daily_used:
          used,

        daily_limit:
          limit,

        message:
          premium
            ? "You have reached today's 100-question limit."
            : "You have completed today's 10 free questions. Upgrade to Premium for 100 questions per day."

      },
      403
    );

  }


  const question =
    await generateQuestion(
      env
    );


  if (!question) {

    return json(
      {

        success: false,

        aiError: true,

        message:
          "AI question generation failed. Please try again."

      },
      503
    );

  }


  const saved =
    await env.DB.prepare(`
      INSERT INTO mcq_questions
      (
        question,
        option_a,
        option_b,
        option_c,
        option_d,
        correct_answer,
        explanation,
        category,
        difficulty
      )
      VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
    `)
    .bind(

      question.question,

      question.options[0],

      question.options[1],

      question.options[2],

      question.options[3],

      question.correct_answer,

      question.explanation,

      question.category,

      question.difficulty

    )
    .run();


  const progress =
    await getProgress(
      env,
      studentId
    );


  return json({

    success: true,

    plan:
      premium
        ? "PREMIUM"
        : "FREE",

    daily_used:
      used,

    daily_limit:
      limit,

    remaining:
      limit - used,

    question: {

      id:
        saved.meta.last_row_id,

      question:
        question.question,

      options:
        question.options,

      category:
        question.category,

      difficulty:
        question.difficulty

    },

    correct_answers:
      progress.correct,

    total_questions:
      progress.total,

    accuracy:
      progress.accuracy,

    certificate_progress:
      Math.min(
        progress.correct,
        CERTIFICATE_TARGET
      ),

    certificate_target:
      CERTIFICATE_TARGET

  });

}


/* =========================
   SUBMIT MCQ
========================= */

async function submitMCQ(
  request,
  env
) {

  let body;


  try {

    body =
      await request.json();

  } catch {

    return json(
      {
        success: false,
        message:
          "Invalid request."
      },
      400
    );

  }


  const studentId =
    Number(
      body.student_id
    );


  const questionId =
    Number(
      body.question_id
    );


  const answer =
    Number(
      body.answer
    );


  if (
    !studentId ||
    !questionId ||
    !Number.isInteger(answer) ||
    answer < 0 ||
    answer > 3
  ) {

    return json(
      {
        success: false,
        message:
          "Invalid answer."
      },
      400
    );

  }


  const student =
    await getStudent(
      env,
      studentId
    );


  if (!student) {

    return json(
      {
        success: false,
        message:
          "Student not found."
      },
      404
    );

  }


  const premium =
    isPremium(student);


  const limit =
    premium
      ? PREMIUM_LIMIT
      : FREE_LIMIT;


  const used =
    await getUsage(
      env,
      studentId
    );


  if (used >= limit) {

    return json(
      {
        success: false,
        limitReached: true,
        premiumRequired:
          !premium
      },
      403
    );

  }


  const question =
    await env.DB.prepare(`
      SELECT
        correct_answer,
        explanation
      FROM mcq_questions
      WHERE id = ?
      LIMIT 1
    `)
    .bind(questionId)
    .first();


  if (!question) {

    return json(
      {
        success: false,
        message:
          "Question not found."
      },
      404
    );

  }


  const already =
    await env.DB.prepare(`
      SELECT id
      FROM mcq_attempts
      WHERE student_id = ?
      AND question_id = ?
      LIMIT 1
    `)
    .bind(
      studentId,
      questionId
    )
    .first();


  if (already) {

    return json(
      {
        success: false,
        message:
          "Question already answered."
      },
      409
    );

  }


  const correct =
    answer ===
    Number(
      question.correct_answer
    );


  await env.DB.prepare(`
    INSERT INTO mcq_attempts
    (
      student_id,
      question_id,
      selected_answer,
      correct
    )
    VALUES (?, ?, ?, ?)
  `)
  .bind(
    studentId,
    questionId,
    answer,
    correct ? 1 : 0
  )
  .run();


  await addUsage(
    env,
    studentId
  );


  const progress =
    await getProgress(
      env,
      studentId
    );


  const newUsed =
    used + 1;


  return json({

    success: true,

    correct:

      correct,

    correct_answer:
      Number(
        question.correct_answer
      ),

    explanation:
      question.explanation || "",

    plan:
      premium
        ? "PREMIUM"
        : "FREE",

    daily_used:
      newUsed,

    daily_limit:
      limit,

    remaining:
      Math.max(
        limit - newUsed,
        0
      ),

    correct_answers:
      progress.correct,

    total_questions:
      progress.total,

    accuracy:
      progress.accuracy,

    certificate_progress:
      Math.min(
        progress.correct,
        CERTIFICATE_TARGET
      ),

    certificate_target:
      CERTIFICATE_TARGET,

    certificate_reached:
      premium &&
      progress.correct >=
      CERTIFICATE_TARGET

  });

}


