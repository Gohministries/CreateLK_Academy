/* =========================
   WORKER
========================= */

export default {

  async fetch(
    request,
    env
  ) {

    if (
      request.method ===
      "OPTIONS"
    ) {

      return new Response(
        null,
        {
          status: 204,
          headers: CORS
        }
      );

    }


    try {

      if (!env.AI) {

        return json(
          {
            success: false,
            message:
              "Workers AI binding AI is missing."
          },
          500
        );

      }


      if (!env.DB) {

        return json(
          {
            success: false,
            message:
              "D1 binding DB is missing."
          },
          500
        );

      }


      await setup(env);


      const url =
        new URL(request.url);


      /*
        HEALTH
      */

      if (
        url.pathname === "/" ||
        url.pathname === "/health"
      ) {

        return json({

          success: true,

          service:
            "CreateLK AI MCQ",

          status:
            "working",

          model:
            MODEL,

          ai:
            true,

          database:
            true

        });

      }


      /*
        GET QUESTION
      */

      if (
        url.pathname ===
          "/api/mcq" &&
        request.method === "GET"
      ) {

        return getMCQ(
          request,
          env
        );

      }


      /*
        SUBMIT
      */

      if (
        url.pathname ===
          "/api/mcq" &&
        request.method === "POST"
      ) {

        return submitMCQ(
          request,
          env
        );

      }


      /*
        PROGRESS
      */

      if (
        url.pathname ===
          "/api/progress" &&
        request.method === "GET"
      ) {

        return getProgressAPI(
          request,
          env
        );

      }


      return json(
        {
          success: false,
          message:
            "Endpoint not found."
        },
        404
      );


    } catch(error) {

      console.error(
        "WORKER ERROR:",
        error
      );


      return json(
        {
          success: false,
          message:
            "Server error.",
          error:
            String(
              error?.message ||
              error
            )
        },
        500
      );

    }

  }

};