const MONTHLY_TABLE="leaderboard_monthly_scores";
const COINS=5,XP=10;

export default{
 async fetch(r,e){
  try{
   if(r.method==="OPTIONS")
    return new Response(null,{status:204,headers:corsHeaders()});

   const p=new URL(r.url).pathname;

   if(p==="/api/health")
    return json({
     success:true,
     message:"Monthly Leaderboard API is running",
     version:"LEADERBOARD-MONTHLY-PREMIUM-2026",
     premium_only:true,
     public:true,
     maximum_ranked:100
    });

   if(p==="/api/leaderboard"&&r.method==="GET")
    return leaderboard(e);

   if(p==="/api/reset"&&r.method==="POST"){
    const secret=r.headers.get("Authorization");
    if(secret!==`Bearer ${e.RESET_SECRET}`)
     return json({success:false,error:"Unauthorized"},401);

    return reset(e);
   }

   return json({success:false,error:"Not found"},404);

  }catch(x){
   console.error(x);
   return json({
    success:false,
    error:x?.message||"Server error"
   },500);
  }
 },

 async scheduled(event,e,ctx){
  ctx.waitUntil(
   reset(e).catch(x=>console.error("MONTHLY RESET ERROR",x))
  );
 }
};

function corsHeaders(){
 return{
  "Access-Control-Allow-Origin":"https://createlk.com",
  "Access-Control-Allow-Headers":"Content-Type,Authorization",
  "Access-Control-Allow-Methods":"GET,POST,OPTIONS"
 };
}

function json(x,s=200){
 return new Response(JSON.stringify(x),{
  status:s,
  headers:{
   "Content-Type":"application/json;charset=UTF-8",
   ...corsHeaders()
  }
 });
}

function monthKey(d=new Date()){
 return `${d.getUTCFullYear()}-${String(d.getUTCMonth()+1).padStart(2,"0")}`;
}

function monthPeriod(d=new Date()){
 const y=d.getUTCFullYear();
 const m=d.getUTCMonth();

 return{
  key:monthKey(d),
  start:new Date(Date.UTC(y,m,1)).toISOString(),
  end:new Date(Date.UTC(y,m+1,1)).toISOString()
 };
}

async function ensureTable(e){
 if(!e.DB)
  throw Error("D1 binding DB is missing");

 await e.DB.prepare(`
  CREATE TABLE IF NOT EXISTS ${MONTHLY_TABLE}(
   id INTEGER PRIMARY KEY AUTOINCREMENT,
   month TEXT NOT NULL,
   user_id INTEGER NOT NULL,
   name TEXT,
   picture TEXT,
   score INTEGER DEFAULT 0,
   coins INTEGER DEFAULT 0,
   xp INTEGER DEFAULT 0,
   created_at TEXT,
   updated_at TEXT,
   UNIQUE(month,user_id)
  )
 `).run();

 await e.DB.prepare(`
  CREATE INDEX IF NOT EXISTS idx_monthly_leaderboard
  ON ${MONTHLY_TABLE}(month,coins DESC,xp DESC)
 `).run();
}

async function leaderboard(e){
 await ensureTable(e);

 const p=monthPeriod();
 const now=new Date().toISOString();

 /*
  PUBLIC LEADERBOARD:
  Anyone can call this endpoint.

  RANKING ELIGIBILITY:
  Only users with active Premium membership
  are included in the ranking.

  Maximum:
  100 Premium students.
 */

 const x=await e.DB.prepare(`
  SELECT
   u.id AS user_id,
   u.name,
   u.picture,
   COALESCE(SUM(q.score),0) AS score,
   COALESCE(SUM(q.score*?),0) AS coins,
   COALESCE(SUM(q.score*?),0) AS xp
  FROM users u
  JOIN quiz_results q
   ON q.user_id=u.id
  WHERE q.completed_at>=?
    AND q.completed_at<?
    AND UPPER(COALESCE(u.membership_status,''))='PREMIUM'
    AND u.membership_expiry IS NOT NULL
    AND u.membership_expiry>?
  GROUP BY
   u.id,
   u.name,
   u.picture
  HAVING COALESCE(SUM(q.score),0)>0
  ORDER BY
   coins DESC,
   xp DESC,
   name ASC,
   user_id ASC
  LIMIT 100
 `).bind(
  COINS,
  XP,
  p.start,
  p.end,
  now
 ).all();

 const rows=x.results||[];

 return json({
  success:true,
  public:true,
  premium_only:true,
  maximum_ranked:100,
  month:p.key,
  month_start:p.start,
  month_end:p.end,
  leaderboard:rows.map((v,i)=>({
   rank:i+1,
   user_id:Number(v.user_id),
   name:v.name||"",
   picture:v.picture||"",
   score:Number(v.score||0),
   coins:Number(v.coins||0),
   xp:Number(v.xp||0)
  }))
 });
}

async function reset(e){
 await ensureTable(e);

 const now=new Date();
 const p=monthPeriod(now);

 const previous=new Date(
  Date.UTC(
   now.getUTCFullYear(),
   now.getUTCMonth()-1,
   1
  )
 );

 const previousKey=monthKey(previous);

 /*
  The leaderboard is calculated directly from quiz_results
  for the current month.

  Therefore a new month automatically starts from zero.
  We do not delete historical records.
 */

 return json({
  success:true,
  reset:true,
  month:p.key,
  previous_month:previousKey,
  reset_at:now.toISOString(),
  message:"Monthly Premium leaderboard is automatically using the new month"
 });
}