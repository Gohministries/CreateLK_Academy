
const SITE="https://createlk.com";
const SESSION="english_session",STATE="google_state";
const GA="https://accounts.google.com/o/oauth2/v2/auth";
const GT="https://oauth2.googleapis.com/token";
const GU="https://openidconnect.googleapis.com/v1/userinfo";
const SESSION_DAYS=30;

export default {
 async fetch(r,e){
  try{
   const p=new URL(r.url).pathname;
   if(r.method==="OPTIONS")return cors(new Response(null,{status:204}));
   const routes={
    "/auth/google":googleLogin,
    "/auth/callback":googleCallback,
    "/auth/logout":logout,
    "/api/me":me,
    "/api/titles":titles,
    "/api/questions":questions,
    "/api/quiz/start":startQuiz,
    "/api/quiz/check":checkAnswer,
    "/api/quiz/submit":submitQuiz,
    "/api/progress":getProgress,
    "/api/progress/lesson":getLessonProgress,
    "/api/payment/start":paymentStart
   };
   if(routes[p])return routes[p](r,e);
   if(p==="/api/health")return json({
    success:true,
    message:"English Master Course API running",
    version:"ENGLISH-MASTER-2026-10-19",
    free_lesson_id:1,
    unlimited_attempts:true,
    premium_duration_days:30
   });
   return err("Not found",404);
  }catch(x){
   console.error(x);
   return err("Server error",500);
  }
 }
};

/* AUTHENTICATION */

async function googleLogin(r,e){
 if(!e.GOOGLE_CLIENT_ID||!e.GOOGLE_REDIRECT_URI)
  return err("Google login is not configured",500);

 const st=token(32);
 const state=btoa(JSON.stringify({state:st,expires:Date.now()+600000}));
 const q=new URLSearchParams({
  client_id:e.GOOGLE_CLIENT_ID,
  redirect_uri:e.GOOGLE_REDIRECT_URI,
  response_type:"code",
  scope:"openid email profile",
  access_type:"offline",
  prompt:"select_account",
  state
 });
 return new Response(null,{status:302,headers:{
  Location:`${GA}?${q}`,
  "Set-Cookie":`${STATE}=${st}; Path=/; HttpOnly; Secure; SameSite=None; Max-Age=600`
 }});
}

async function googleCallback(r,e){
 const u=new URL(r.url),code=u.searchParams.get("code"),raw=u.searchParams.get("state");
 if(!code||!raw)return new Response("Invalid Google login.",{status:400});

 let s;
 try{s=JSON.parse(atob(raw))}
 catch{return new Response("Invalid state.",{status:400})}

 if(!s.state||s.expires<Date.now()||cookies(r)[STATE]!==s.state)
  return new Response("Login expired.",{status:400});

 const tr=await fetch(GT,{
  method:"POST",
  headers:{"Content-Type":"application/x-www-form-urlencoded"},
  body:new URLSearchParams({
   client_id:e.GOOGLE_CLIENT_ID,
   client_secret:e.GOOGLE_CLIENT_SECRET,
   code,
   grant_type:"authorization_code",
   redirect_uri:e.GOOGLE_REDIRECT_URI
  })
 });
 const td=await tr.json();
 if(!tr.ok||!td.access_token)
  return new Response("Google authentication failed.",{status:400});

 const gr=await fetch(GU,{headers:{Authorization:`Bearer ${td.access_token}`}});
 const g=await gr.json();
 if(!gr.ok||!g.sub||!g.email||g.email_verified!==true)
  return new Response("Unable to verify Google account.",{status:400});

 const gid=clean(g.sub),email=clean(g.email).toLowerCase();
 const name=clean(g.name)||email.split("@")[0],picture=clean(g.picture);

 let user=await e.DB.prepare(
  "SELECT * FROM users WHERE google_id=? OR email=? LIMIT 1"
 ).bind(gid,email).first();

 if(user){
  await e.DB.prepare(`
   UPDATE users SET google_id=?,name=?,email=?,picture=?,last_active_at=?
   WHERE id=?
  `).bind(gid,name,email,picture,Date.now(),user.id).run();
 }else{
  const x=await e.DB.prepare(`
   INSERT INTO users
   (google_id,name,email,membership_status,membership_expiry,
    auth_provider,picture,last_active_at)
   VALUES(?,?,?,'FREE',NULL,'google',?,?)
  `).bind(gid,name,email,picture,Date.now()).run();

  user=await e.DB.prepare("SELECT * FROM users WHERE id=?")
   .bind(x.meta.last_row_id).first();
 }

 const session=token(48);
 const expires=new Date(Date.now()+SESSION_DAYS*86400000).toISOString();

 await e.DB.prepare(`
  INSERT INTO sessions(user_id,token_hash,expires_at) VALUES(?,?,?)
 `).bind(user.id,await sha256(session),expires).run();

 const h=new Headers({Location:`${SITE}/Eng/`});
 h.append("Set-Cookie",
  `${SESSION}=${session}; Path=/; HttpOnly; Secure; SameSite=None; Max-Age=${SESSION_DAYS*86400}`);
 h.append("Set-Cookie",
  `${STATE}=; Path=/; HttpOnly; Secure; SameSite=None; Max-Age=0`);
 return new Response(null,{status:302,headers:h});
}

async function currentUser(r,e){
 const s=cookies(r)[SESSION];
 if(!s)return null;

 const u=await e.DB.prepare(`
  SELECT u.* FROM sessions s JOIN users u ON u.id=s.user_id
  WHERE s.token_hash=? AND s.expires_at>? LIMIT 1
 `).bind(await sha256(s),new Date().toISOString()).first();

 if(u)await e.DB.prepare(
  "UPDATE users SET last_active_at=? WHERE id=?"
 ).bind(Date.now(),u.id).run();

 return u;
}

async function me(r,e){
 const u=await currentUser(r,e);
 if(!u)return json({
  success:true,logged_in:false,user:null,
  premium:false,membership_expiry:null
 });

 const p=await premium(e,u.id);
 return json({
  success:true,logged_in:true,premium:p.premium,
  membership_expiry:p.expiry,
  user:{
   id:u.id,name:u.name,email:u.email,picture:u.picture||"",
   membership_status:p.premium?"PREMIUM":"FREE",
   membership_expiry:p.expiry,is_premium:p.premium
  }
 });
}

/* PREMIUM ACCESS */

async function premium(e,id){
 try{
  if(!e.PAY||!e.INTERNAL_SECRET)
   return{premium:false,expiry:null};

  const r=await e.PAY.fetch("https://pay/internal/check",{
   method:"POST",
   headers:{
    "Content-Type":"application/json",
    Authorization:`Bearer ${e.INTERNAL_SECRET}`
   },
   body:JSON.stringify({user_id:Number(id)})
  });
  const d=await r.json();
  return{
   premium:r.ok&&d.premium===true,
   expiry:d.membership_expiry||null
  };
 }catch(x){
  console.error("Premium check failed",x);
  return{premium:false,expiry:null};
 }
}

/* LESSON ACCESS */

function free(id){return Number(id)===1;}

async function lesson(e,id){
 return e.DB.prepare(`
  SELECT id,title,access_type FROM lessons
  WHERE id=? AND active=1 LIMIT 1
 `).bind(id).first();
}

async function canAccessLesson(e,u,l){
 if(free(l.id))return true;
 if(!u)return false;
 return (await premium(e,u.id)).premium;
}

async function titles(r,e){
 const x=await e.DB.prepare(`
  SELECT id,title,access_type FROM lessons
  WHERE active=1 ORDER BY id
 `).all();

 const u=await currentUser(r,e);
 const p=u?await premium(e,u.id):{premium:false};

 return json({
  success:true,
  total_lessons:(x.results||[]).length,
  logged_in:!!u,
  premium:p.premium,
  lessons:(x.results||[]).map(l=>({
   ...l,
   access_type:free(l.id)?"FREE":"PREMIUM",
   locked:!free(l.id)&&!p.premium
  }))
 });
}

async function questions(r,e){
 const id=Number(new URL(r.url).searchParams.get("lesson_id"));
 if(!Number.isInteger(id)||id<1)return err("Invalid lesson_id",400);

 const l=await lesson(e,id);
 if(!l)return err("Lesson not found",404);

 const u=await currentUser(r,e);
 if(!(await canAccessLesson(e,u,l)))
  return err(u?"Premium required":"Login required",u?403:401,{premium_required:true});

 const x=await e.DB.prepare(`
  SELECT id,lesson_id,question,option_a,option_b,option_c,option_d
  FROM questions WHERE lesson_id=? AND active=1
  ORDER BY id LIMIT 50
 `).bind(id).all();

 return json({success:true,lesson:l,questions:x.results||[]});
}

/* QUIZ START — UNLIMITED ATTEMPTS */

async function startQuiz(r,e){
 if(r.method!=="POST")return err("POST required",405);

 const u=await currentUser(r,e),b=await body(r);
 if(!u)return err("Login required",401);
 if(!b)return err("Invalid JSON",400);

 const lid=Number(b.lesson_id);
 if(!Number.isInteger(lid)||lid<1)return err("Invalid lesson_id",400);

 const l=await lesson(e,lid);
 if(!l)return err("Lesson not found",404);
 if(!(await canAccessLesson(e,u,l)))
  return err("Premium required",403,{premium_required:true});

 const active=await e.DB.prepare(`
  SELECT id,created_at FROM quiz_attempts
  WHERE user_id=? AND lesson_id=? AND completed_at IS NULL
  ORDER BY created_at DESC LIMIT 1
 `).bind(u.id,lid).first();

 if(active)return json({
  success:true,resumed:true,attempt_id:active.id,
  lesson_id:lid,started_at:active.created_at
 });

 const id=crypto.randomUUID();
 const now=new Date().toISOString();

 await e.DB.prepare(`
  INSERT INTO quiz_attempts(id,user_id,lesson_id,created_at)
  VALUES(?,?,?,?)
 `).bind(id,u.id,lid,now).run();

 return json({success:true,attempt_id:id,lesson_id:lid,started_at:now});
}

/* CHECK ANSWER */

async function checkAnswer(r,e){
 if(r.method!=="POST")return err("POST required",405);

 const u=await currentUser(r,e),b=await body(r);
 if(!u)return err("Login required",401);
 if(!b)return err("Invalid JSON",400);

 const qid=Number(b.question_id),aid=clean(b.attempt_id);
 if(!qid||!aid)return err("Invalid answer",400);

 const a=await e.DB.prepare(`
  SELECT id,lesson_id,completed_at FROM quiz_attempts
  WHERE id=? AND user_id=? LIMIT 1
 `).bind(aid,u.id).first();

 if(!a)return err("Invalid quiz attempt",403);
 if(a.completed_at)return err("Quiz already submitted",400);

 const q=await e.DB.prepare(`
  SELECT id,lesson_id,correct_answer,option_a,option_b,option_c,option_d
  FROM questions WHERE id=? AND active=1 LIMIT 1
 `).bind(qid).first();

 if(!q)return err("Question not found",404);
 if(Number(q.lesson_id)!==Number(a.lesson_id))
  return err("Question does not belong to this quiz",400);

 const l=await lesson(e,q.lesson_id);
 if(!l)return err("Lesson not found",404);
 if(!(await canAccessLesson(e,u,l)))
  return err("Premium required",403,{premium_required:true});

 const ans=normalize(b.answer,q),ca=normalize(q.correct_answer,q);
 if(!ans)return err("Invalid answer",400);

 const correct=ans===ca;
 return json({
  success:true,correct,question_id:qid,
  answer:ans,selected_answer:ans,
  ...(correct?{}:{
   correct_answer:ca,correct_text:q[`option_${ca}`]||""
  })
 });
}

/* SUBMIT QUIZ AND SAVE PROGRESS */

async function submitQuiz(r,e){
 if(r.method!=="POST")return err("POST required",405);

 const u=await currentUser(r,e),b=await body(r);
 if(!u)return err("Login required",401);
 if(!b)return err("Invalid JSON",400);

 const lid=Number(b.lesson_id),aid=clean(b.attempt_id);
 const answers=Array.isArray(b.answers)?b.answers:[];

 if(!Number.isInteger(lid)||lid<1||!aid||answers.length>50)
  return err("Invalid quiz data",400);

 const a=await e.DB.prepare(`
  SELECT id,lesson_id,completed_at FROM quiz_attempts
  WHERE id=? AND user_id=? LIMIT 1
 `).bind(aid,u.id).first();

 if(!a)return err("Quiz attempt not found",404);
 if(Number(a.lesson_id)!==lid)return err("Invalid lesson",400);
 if(a.completed_at)return err("Quiz already submitted",400,{already_submitted:true});

 const l=await lesson(e,lid);
 if(!l)return err("Lesson not found",404);
 if(!(await canAccessLesson(e,u,l)))
  return err("Premium required",403,{premium_required:true});

 const x=await e.DB.prepare(`
  SELECT id,correct_answer,option_a,option_b,option_c,option_d
  FROM questions WHERE lesson_id=? AND active=1
  ORDER BY id LIMIT 50
 `).bind(lid).all();

 const rows=x.results||[];
 if(!rows.length)return err("No questions found",404);

 const answerMap=new Map();
 for(const v of answers){
  const q=rows.find(z=>Number(z.id)===Number(v?.question_id));
  if(q){
   const answer=normalize(v?.answer,q);
   if(answer)answerMap.set(Number(q.id),answer);
  }
 }

 let score=0;
 for(const q of rows){
  if(answerMap.get(Number(q.id))===normalize(q.correct_answer,q))score++;
 }

 const total=rows.length;
 const percentage=Math.round(score/total*100);
 const now=new Date().toISOString();

 const done=await e.DB.prepare(`
  UPDATE quiz_attempts SET completed_at=?
  WHERE id=? AND user_id=? AND lesson_id=? AND completed_at IS NULL
 `).bind(now,aid,u.id,lid).run();

 if(!done.meta.changes)
  return err("Quiz already submitted",400,{already_submitted:true});

 await e.DB.prepare(`
  INSERT INTO quiz_results
   (user_id,lesson_id,score,total,percentage,completed_at)
  VALUES(?,?,?,?,?,?)
 `).bind(u.id,lid,score,total,percentage,now).run();

 await e.DB.prepare(`
  INSERT INTO lesson_progress
   (user_id,lesson_id,best_score,total_questions,percentage,completed_at)
  VALUES(?,?,?,?,?,?)
  ON CONFLICT(user_id,lesson_id) DO UPDATE SET
   best_score=MAX(lesson_progress.best_score,excluded.best_score),
   total_questions=excluded.total_questions,
   percentage=MAX(lesson_progress.percentage,excluded.percentage),
   completed_at=excluded.completed_at
 `).bind(u.id,lid,score,total,percentage,now).run();

 return json({
  success:true,lesson_id:lid,lesson_title:l.title,
  score,total,percentage,completed:true,
  completed_at:now,
  best_score:await bestScore(e,u.id,lid)
 });
}

async function bestScore(e,uid,lid){
 const x=await e.DB.prepare(`
  SELECT best_score FROM lesson_progress
  WHERE user_id=? AND lesson_id=? LIMIT 1
 `).bind(uid,lid).first();
 return Number(x?.best_score||0);
}

/* COURSE PROGRESS */

async function getProgress(r,e){
 const u=await currentUser(r,e);
 if(!u)return err("Login required",401);

 const x=await e.DB.prepare(`
  SELECT l.id AS lesson_id,l.title,
   p.best_score,p.total_questions,p.percentage,p.completed_at
  FROM lessons l
  LEFT JOIN lesson_progress p
   ON p.lesson_id=l.id AND p.user_id=?
  WHERE l.active=1 ORDER BY l.id
 `).bind(u.id).all();

 const lessons=(x.results||[]).map(v=>({
  lesson_id:v.lesson_id,
  title:v.title,
  completed:v.completed_at!==null,
  best_score:v.best_score??null,
  total_questions:v.total_questions??null,
  percentage:v.percentage??null,
  completed_at:v.completed_at??null
 }));

 const total=lessons.length;
 const completed=lessons.filter(v=>v.completed).length;
 const next=lessons.find(v=>!v.completed);

 return json({
  success:true,total_lessons:total,
  completed_lessons:completed,
  remaining_lessons:total-completed,
  progress_percentage:total?Math.round(completed/total*100):0,
  next_lesson_id:next?.lesson_id??null,
  lessons
 });
}

async function getLessonProgress(r,e){
 const u=await currentUser(r,e);
 if(!u)return err("Login required",401);

 const lid=Number(new URL(r.url).searchParams.get("lesson_id"));
 if(!Number.isInteger(lid)||lid<1)return err("Invalid lesson_id",400);

 const l=await lesson(e,lid);
 if(!l)return err("Lesson not found",404);

 const p=await e.DB.prepare(`
  SELECT best_score,total_questions,percentage,completed_at
  FROM lesson_progress WHERE user_id=? AND lesson_id=? LIMIT 1
 `).bind(u.id,lid).first();

 return json({
  success:true,lesson_id:lid,
  completed:!!p,
  best_score:p?.best_score??null,
  total_questions:p?.total_questions??null,
  percentage:p?.percentage??null,
  completed_at:p?.completed_at??null
 });
}

/* PAYMENT */

async function paymentStart(r,e){
 if(r.method!=="POST")return err("POST required",405);

 const u=await currentUser(r,e),b=await body(r);
 if(!u)return err("Login required",401);
 if(!b)return err("Invalid JSON",400);

 const lid=Number(b.lesson_id);
 if(!Number.isInteger(lid)||lid<1)return err("Invalid lesson_id",400);

 const l=await lesson(e,lid);
 if(!l)return err("Lesson not found",404);
 if(free(lid))return err("This lesson is free",400);
 if((await premium(e,u.id)).premium)
  return err("You already have premium access",400);

 try{
  const x=await e.PAY.fetch("https://pay/internal/start",{
   method:"POST",
   headers:{
    "Content-Type":"application/json",
    Authorization:`Bearer ${e.INTERNAL_SECRET}`
   },
   body:JSON.stringify({
    user_id:Number(u.id),email:u.email||"",name:u.name||"",
    lesson_id:lid,source:"english"
   })
  });

  const d=await x.json();
  if(!x.ok||!d.success)return err(d.error||"Payment failed",x.status||500);

  return json({
   success:true,order_id:d.order_id||null,
   amount:d.amount||null,currency:d.currency||"LKR",
   payment_url:d.payment_url||null
  });
 }catch(x){
  console.error("Payment error",x);
  return err("Payment connection failed",502);
 }
}

/* LOGOUT AND HELPERS */

async function logout(r,e){
 const s=cookies(r)[SESSION];
 if(s)await e.DB.prepare("DELETE FROM sessions WHERE token_hash=?")
  .bind(await sha256(s)).run();

 const h=new Headers({Location:`${SITE}/Eng/`});
 h.append("Set-Cookie",
  `${SESSION}=; Path=/; HttpOnly; Secure; SameSite=None; Max-Age=0`);
 h.append("Set-Cookie",
  `${STATE}=; Path=/; HttpOnly; Secure; SameSite=None; Max-Age=0`);
 return new Response(null,{status:302,headers:h});
}

async function body(r){try{return await r.json()}catch{return null}}

function normalize(x,q){
 const v=String(x??"").trim().toLowerCase().replace(/[.)]$/,"");
 const k={
  "1":"a","2":"b","3":"c","4":"d",
  a:"a",b:"b",c:"c",d:"d",
  option_a:"a",option_b:"b",option_c:"c",option_d:"d",
  answer_a:"a",answer_b:"b",answer_c:"c",answer_d:"d"
 }[v];
 if(k)return k;
 if(q)for(const z of["a","b","c","d"])
  if(v===String(q[`option_${z}`]??"").trim().toLowerCase())return z;
 return null;
}

function token(n=32){
 const a=new Uint8Array(n);
 crypto.getRandomValues(a);
 return[...a].map(x=>x.toString(16).padStart(2,"0")).join("");
}

async function sha256(x){
 const h=await crypto.subtle.digest("SHA-256",new TextEncoder().encode(x));
 return[...new Uint8Array(h)].map(x=>x.toString(16).padStart(2,"0")).join("");
}

function cookies(r){
 const o={},h=r.headers.get("Cookie");
 if(!h)return o;
 for(const p of h.split(";")){
  const i=p.indexOf("=");
  if(i>=0)o[p.slice(0,i).trim()]=decodeURIComponent(p.slice(i+1).trim());
 }
 return o;
}

function clean(x){return String(x||"").trim()}

function json(x,status=200){
 return cors(new Response(JSON.stringify(x),{
  status,headers:{"Content-Type":"application/json;charset=UTF-8"}
 }));
}

function err(error,status=400,extra={}){
 return json({success:false,error,...extra},status);
}

function cors(r){
 r.headers.set("Access-Control-Allow-Origin",SITE);
 r.headers.set("Access-Control-Allow-Credentials","true");
 r.headers.set("Access-Control-Allow-Headers","Content-Type");
 r.headers.set("Access-Control-Allow-Methods","GET,POST,OPTIONS");
 return r;
}
