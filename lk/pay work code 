async function stats(r,e){
 try{
  await auth(r,e);
 }catch(x){
  return err(x.message,401);
 }

 const [u,p,a]=await Promise.all([
  e.DB.prepare(`
   SELECT COUNT(*) n
   FROM users
  `).first(),

  e.DB.prepare(`
   SELECT COUNT(*) n
   FROM users
   WHERE membership_status='PREMIUM'
   AND membership_expiry>?
  `).bind(now()).first(),

  e.DB.prepare(`
   SELECT
    COUNT(*) n,
