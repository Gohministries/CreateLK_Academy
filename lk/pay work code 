   FROM payments
   WHERE status='APPROVED'
  `).first()
 ]);

 return json({
  success:true,
  users:+u.n,
  premium:+p.n,
  free:+u.n-+p.n,
  payments:+a.n,
  payment_total:+a.total
 });
}

async function users(r,e){
 try{
  await auth(r,e);
 }catch(x){
  return err(x.message,401);
 }

 const q=new URL(r.url).searchParams.get("q")||"";

 const sql=`
  SELECT
   id user_id,
   email,
   name,
   membership_status status,
   membership_expiry
  FROM users
 `;

 const x=q
  ?await e.DB.prepare(sql+`
    WHERE email LIKE ?
       OR name LIKE ?
       OR CAST(id AS TEXT)=?
    ORDER BY id DESC
    LIMIT 500
   `).bind(
    `%${q}%`,
    `%${q}%`,
    q
   ).all()
  :await e.DB.prepare(sql+`
    ORDER BY id DESC
    LIMIT 500
   `).all();

 return json({
  success:true,
  users:x.results||[]
 });
}

