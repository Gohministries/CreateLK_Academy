async function payment(r,e){
 try{
  await auth(r,e);
 }catch(x){
  return err(x.message,401);
 }

 if(r.method!=="POST")
  return err("POST required",405);

 const b=await body(r);

 const uid=+b?.user_id||0;
 const email=clean(b?.email).toLowerCase();
 const amount=+b?.amount||0;

 if(!uid&&!email)
  return err("User required");

 const x=await e.DB.prepare(`
  INSERT INTO payments(
   user_id,
   email,
   name,
   amount,
   method,
   reference,
   status,
   created_at
  ) VALUES(?,?,?,?,?,?,?,?)
 `).bind(
  uid,
  email,
  clean(b?.name),
  amount,
  clean(b?.method)||"MANUAL",
  clean(b?.reference),
  "PENDING",
  now()
 ).run();

 return json({
  success:true,
  payment_id:x.meta.last_row_id,
  status:"PENDING"
 });
}

async function activate(r,e){
 try{
  const a=await auth(r,e);
  const b=await body(r);

  const pid=+b?.payment_id||0;
  const email=clean(b?.email).toLowerCase();
  const days=Math.max(1,+b?.days||DAYS);
  const inputAmount=+b?.amount||0;

  let p=pid
   ?await e.DB.prepare(`
     SELECT *
     FROM payments
     WHERE id=?
    `).bind(pid).first()
   :null;

  if(pid&&!p)
   return err("Payment not found",404);

  if(p?.status==="APPROVED")
   return err("Payment already approved");

  let uid=+(p?.user_id||b?.user_id||0);

  let u=uid
   ?await e.DB.prepare(`
     SELECT *
     FROM users
     WHERE id=?
    `).bind(uid).first()
   :null;

  if(!u&&email){
   u=await e.DB.prepare(`
    SELECT *
    FROM users
    WHERE lower(email)=?
   `).bind(email).first();

   if(u)uid=+u.id;
  }

  if(!u)
   return err("User not found",404);

  const amount=inputAmount||+(p?.amount||0);
  const t=now();

  const start=
   u.membership_expiry&&
   new Date(u.membership_expiry)>new Date()
   ?new Date(u.membership_expiry)
   :new Date();

  const expiry=new Date(
   start.getTime()+days*86400000
  ).toISOString();

  await e.DB.prepare(`
   UPDATE users
   SET membership_status='PREMIUM',
       membership_expiry=?
   WHERE id=?
  `).bind(
   expiry,
   uid
  ).run();

  await e.DB.prepare(`
   INSERT INTO premium_users(
    user_id,
    email,
    name,
    status,
    membership_expiry,
    updated_at
   ) VALUES(?,?,?,?,?,?)
   ON CONFLICT(user_id) DO UPDATE SET
    email=excluded.email,
    name=excluded.name,
    status='PREMIUM',
    membership_expiry=excluded.membership_expiry,
    updated_at=excluded.updated_at
  `).bind(
   uid,
   u.email,
   u.name,
   "PREMIUM",
   expiry,
   t
  ).run();

  let id=pid;

  if(!id){
   const x=await e.DB.prepare(`
    INSERT INTO payments(
     user_id,
     email,
     name,
     amount,
     method,
     reference,
     status,
     created_at,
     approved_at,
     approved_by
    ) VALUES(?,?,?,?,?,?,?,?,?,?)
   `).bind(
    uid,
    u.email,
    u.name,
    amount,
    clean(b?.method)||"MANUAL",
    clean(b?.reference),
    "APPROVED",
    t,
    t,
    a.email
   ).run();

   id=x.meta.last_row_id;
  }else{
   await e.DB.prepare(`
    UPDATE payments
    SET status='APPROVED',
        approved_at=?,
        approved_by=?,
        amount=?
    WHERE id=?
   `).bind(
    t,
    a.email,
    amount,
    id
   ).run();
  }

  return json({
   success:true,
   payment_id:id,
   user_id:uid,
   email:u.email,
   status:"PREMIUM",
   membership_expiry:expiry
  });

 }catch(x){
  return err(
   x.message||"Activation failed",
   500
  );
 }
}

async function logout(r,e){
 const s=cookies(r)[SES];

 if(s){
  await e.DB.prepare(`
   DELETE FROM admin_sessions
   WHERE token_hash=?
  `).bind(await hash(s)).run();
 }

 return new Response(null,{
  status:302,
  headers:{
   Location:`${SITE}/Eng/admin.html`,
   "Set-Cookie":
    `${SES}=;Path=/;HttpOnly;Secure;SameSite=None;Max-Age=0`
  }
 });
}