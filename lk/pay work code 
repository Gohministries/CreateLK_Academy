}

async function check(r,e){
 if(r.method!=="POST")return err("POST required",405);

 if(r.headers.get("Authorization")!==`Bearer ${e.INTERNAL_SECRET}`)
  return err("Unauthorized",401);

 const b=await body(r);
 const id=Number(b?.user_id);

 if(!id)return err("Invalid user_id");

 const u=await e.DB.prepare(`
  SELECT membership_status,membership_expiry
  FROM users
  WHERE id=?
 `).bind(id).first();

 let status=u?.membership_status||"FREE";
 let expiry=u?.membership_expiry||null;

 if(status!=="PREMIUM"||!expiry){
  const p=await e.DB.prepare(`
   SELECT status,membership_expiry
   FROM premium_users
   WHERE user_id=?
  `).bind(id).first();

  if(p){
   status=p.status||status;
   expiry=p.membership_expiry||expiry;
  }
 }

 const active=
  status==="PREMIUM"&&
  expiry&&
  new Date(expiry)>new Date();

 return json({
  success:true,
  premium:!!active,
  membership_expiry:active?expiry:null
 });
}

async function start(r,e){
 if(r.method!=="POST")return err("POST required",405);

 if(r.headers.get("Authorization")!==`Bearer ${e.INTERNAL_SECRET}`)
  return err("Unauthorized",401);

 const b=await body(r);

 const uid=Number(b?.user_id);
 const email=clean(b?.email).toLowerCase();
 const name=clean(b?.name);
 const lesson_id=Number(b?.lesson_id||0);

 if(!uid||!email)
  return err("Invalid user data");

 if(!lesson_id)
  return err("Invalid lesson_id");

 const u=await e.DB.prepare(`
  SELECT id,email,name,membership_status,membership_expiry
  FROM users
  WHERE id=?
 `).bind(uid).first();

 if(!u)
  return err("User not found",404);

 const active=
  u.membership_status==="PREMIUM"&&
  u.membership_expiry&&
  new Date(u.membership_expiry)>new Date();

 if(active)
  return err("User already has active premium");

 const amount=Number(b?.amount||0);
 const currency=clean(b?.currency)||"LKR";

 const order_id=
  "EN"+Date.now().toString(36).toUpperCase()+
  token(4).toUpperCase();

 const payment_url=
  `${SITE}/Eng/payment.html?order_id=${encodeURIComponent(order_id)}`+
  `&user_id=${encodeURIComponent(uid)}`+
  `&lesson_id=${encodeURIComponent(lesson_id)}`;

 await e.DB.prepare(`
  INSERT INTO payments(
   user_id,
   email,
   name,
   amount,
   method,
   reference,
   status,
   created_at
  ) VALUES(?,?,?,?,?,?,?,?)
 `).bind(
  uid,
  email,
  name,
  amount,
  "ONLINE",
  order_id,
  "PENDING",
  now()
 ).run();

 return json({
  success:true,
  order_id,
  amount,
  currency,
  payment_url
 });
}

async function login(r,e){
 const s=token();

 await e.DB.prepare(`
  INSERT INTO oauth_states(state,expires_at)
  VALUES(?,?)
 `).bind(
  s,
  Date.now()+600000
 ).run();

 const q=new URLSearchParams({
  client_id:e.GOOGLE_CLIENT_ID,
  redirect_uri:"https://paylk.createlk.workers.dev/auth/callback",
  response_type:"code",
  scope:"openid email profile",
  state:s,
  access_type:"offline",
  prompt:"select_account"
 });

 return new Response(null,{
  status:302,
  headers:{
   Location:`${GA}?${q}`,
   "Set-Cookie":
    `${STATE}=${s};Path=/;HttpOnly;Secure;SameSite=None;Max-Age=600`
  }
 });
}

async function callback(r,e){
 const u=new URL(r.url);
 const code=u.searchParams.get("code");
 const state=u.searchParams.get("state");

 if(!code||!state)
  return new Response("Invalid login",{status:400});

 const st=await e.DB.prepare(`
  SELECT state
  FROM oauth_states
  WHERE state=? AND expires_at>?
 `).bind(
  state,
  Date.now()
 ).first();

 if(!st)
  return new Response("Login expired",{status:400});

 await e.DB.prepare(`
  DELETE FROM oauth_states
  WHERE state=?
 `).bind(state).run();

 const t=await fetch(GT,{
  method:"POST",
  headers:{"Content-Type":"application/x-www-form-urlencoded"},
  body:new URLSearchParams({
   client_id:e.GOOGLE_CLIENT_ID,
   client_secret:e.GOOGLE_CLIENT_SECRET,
   code,
   grant_type:"authorization_code",
   redirect_uri:"https://paylk.createlk.workers.dev/auth/callback"
  })
 }).then(x=>x.json());

 if(!t.access_token)
  return new Response(
   "Google authentication failed",
   {status:400}
  );

 const g=await fetch(GU,{
  headers:{
   Authorization:`Bearer ${t.access_token}`
  }
 }).then(x=>x.json());

 const email=clean(g.email).toLowerCase();

 if(email!==ADMIN.toLowerCase())
  return new Response(
   "Admin access denied",
   {status:403}
  );

 const s=token(48);

 await e.DB.prepare(`
  INSERT INTO admin_sessions(
   token_hash,email,expires_at
  ) VALUES(?,?,?)
 `).bind(
  await hash(s),
  email,
  new Date(Date.now()+604800000).toISOString()
 ).run();

 return new Response(null,{
  status:302,
  headers:{
   Location:`${SITE}/Eng/admin.html`,
   "Set-Cookie":
    `${SES}=${s};Path=/;HttpOnly;Secure;SameSite=None;Max-Age=604800`
  }
 });
}

