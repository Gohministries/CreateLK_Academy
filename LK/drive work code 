const ADMIN_PASSWORD = "drive#2026#02#09#";

export default {
  async fetch(request, env) {
    const url = new URL(request.url);

    if (request.method === "OPTIONS") {
      return new Response(null, { headers: cors() });
    }

    try {
      // LOGIN
      if (url.pathname === "/auth" && request.method === "POST") {
        const { password } = await request.json();

        if (password !== ADMIN_PASSWORD) {
          return json({ success: false, error: "Invalid password" }, 401);
        }

        return json({
          success: true,
          token: ADMIN_PASSWORD
        });
      }

      // PUBLIC PHOTO
      if (url.pathname === "/photo") {
        const key = url.searchParams.get("key");

        if (!key) return new Response("Missing key", { status: 400 });

        const object = await env.BUCKET.get(key);

        if (!object) {
          return new Response("Photo not found", { status: 404 });
        }

        const headers = new Headers();
        object.writeHttpMetadata(headers);
        headers.set("Cache-Control", "public, max-age=31536000");

        return new Response(object.body, { headers });
      }

      // ADMIN AUTH
      if (
        request.headers.get("Authorization") !==
        `Bearer ${ADMIN_PASSWORD}`
      ) {
        return json({ success: false, error: "Unauthorized" }, 401);
      }

      // LIST
      if (url.pathname === "/list") {
        const result = await env.BUCKET.list({ limit: 1000 });
        const files = [];

        for (const item of result.objects) {
          const head = await env.BUCKET.head(item.key);

          files.push({
            name: item.key,
            size: item.size,
            uploaded: item.uploaded,
            saved: head?.customMetadata?.saved === "true"
          });
        }

        return json({
          success: true,
          files
        });
      }

      // UPLOAD
      if (
        url.pathname === "/upload" &&
        request.method === "POST"
      ) {
        const form = await request.formData();
        const file = form.get("file");

        if (!file || typeof file === "string") {
          return json({
            success: false,
            error: "Select a photo"
          }, 400);
        }

        let filename =
          form.get("filename") || file.name;

        filename = clean(filename);

        if (!filename) {
          return json({
            success: false,
            error: "Invalid filename"
          }, 400);
        }

        if (!isImage(filename, file.type)) {
          return json({
            success: false,
            error: "Only image files are allowed"
          }, 400);
        }

        await env.BUCKET.put(
          filename,
          file.stream(),
          {
            httpMetadata: {
              contentType:
                file.type || mime(filename)
            },
            customMetadata: {
              saved: "false"
            }
          }
        );

        return json({
          success: true,
          name: filename
        });
      }

      // MARK SAVED
      if (
        url.pathname === "/save" &&
        request.method === "POST"
      ) {
        return setSaved(env, request, true);
      }

      // UNMARK SAVED
      if (
        url.pathname === "/unsave" &&
        request.method === "POST"
      ) {
        return setSaved(env, request, false);
      }

      // RENAME
      if (
        url.pathname === "/rename" &&
        request.method === "POST"
      ) {
        const { oldName, newName: rawName } =
          await request.json();

        const newName = clean(rawName);

        if (!oldName || !newName) {
          return json({
            success: false,
            error: "Filename required"
          }, 400);
        }

        const object = await env.BUCKET.get(oldName);

        if (!object) {
          return json({
            success: false,
            error: "Photo not found"
          }, 404);
        }

        if (await env.BUCKET.head(newName)) {
          return json({
            success: false,
            error: "Filename already exists"
          }, 409);
        }

        await env.BUCKET.put(
          newName,
          object.body,
          {
            httpMetadata: object.httpMetadata,
            customMetadata: object.customMetadata
          }
        );

        await env.BUCKET.delete(oldName);

        return json({ success: true });
      }

      // DELETE
      if (
        url.pathname === "/delete" &&
        request.method === "POST"
      ) {
        const { name } = await request.json();

        await env.BUCKET.delete(name);

        return json({ success: true });
      }

      return json({
        success: false,
        error: "Not found"
      }, 404);

    } catch (error) {
      return json({
        success: false,
        error: error.message
      }, 500);
    }
  }
};


async function setSaved(env, request, saved) {

  const { name } = await request.json();

  const object = await env.BUCKET.get(name);

  if (!object) {
    return json({
      success: false,
      error: "Photo not found"
    }, 404);
  }

  const metadata = object.customMetadata || {};
  metadata.saved = String(saved);

  await env.BUCKET.put(
    name,
    object.body,
    {
      httpMetadata: object.httpMetadata,
      customMetadata: metadata
    }
  );

  return json({ success: true });
}


function clean(name) {
  return String(name)
    .trim()
    .replace(/\s+/g, "_")
    .replace(/[^a-zA-Z0-9._\-\/]/g, "_");
}


function isImage(name, type) {
  const ext = name.toLowerCase().split(".").pop();

  return [
    "jpg",
    "jpeg",
    "png",
    "gif",
    "webp",
    "bmp",
    "avif"
  ].includes(ext) ||
  String(type || "").startsWith("image/");
}


function mime(name) {
  const ext = name.toLowerCase().split(".").pop();

  return {
    jpg: "image/jpeg",
    jpeg: "image/jpeg",
    png: "image/png",
    gif: "image/gif",
    webp: "image/webp",
    bmp: "image/bmp",
    avif: "image/avif"
  }[ext] || "application/octet-stream";
}


function cors() {
  return {
    "Access-Control-Allow-Origin": "*",
    "Access-Control-Allow-Methods": "GET,POST,OPTIONS",
    "Access-Control-Allow-Headers": "Content-Type,Authorization"
  };
}


function json(data, status = 200) {
  return new Response(JSON.stringify(data), {
    status,
    headers: {
      "Content-Type": "application/json",
      ...cors()
    }
  });
}