const ALLOWED_ORIGINS = [
  "https://createlk.com",
  "https://www.createlk.com"
];

const SESSION_TTL = 7 * 86400;

export default {
  async fetch(request, env) {
    const url = new URL(request.url);
    const origin = request.headers.get("Origin") || "";
    const cors = getCors(origin);

    if (request.method === "OPTIONS")
      return new Response(null, { status: 204, headers: cors });

    try {
      // LOGIN
      if (url.pathname === "/auth" && request.method === "POST") {
        const body = await request.json().catch(() => null);

        if (!body || body.password !== env.ADMIN_PASSWORD) {
          return json({ success: false, error: "Invalid password" }, 401, cors);
        }

        if (!env.SESSION_SECRET) {
          return json({
            success: false,
            error: "SESSION_SECRET is not configured"
          }, 500, cors);
        }

        return json({
          success: true,
          token: await createToken(env.SESSION_SECRET),
          expiresIn: SESSION_TTL
        }, 200, cors);
      }

      // AUTH
      if (!await verifyToken(request, env.SESSION_SECRET)) {
        return json({ success: false, error: "Unauthorized" }, 401, cors);
      }

      // LIST
      if (url.pathname === "/list" && request.method === "GET") {
        const prefix = cleanPrefix(url.searchParams.get("prefix"));
        const result = await env.BUCKET.list({
          prefix,
          delimiter: "/",
          limit: 1000
        });

        const folders = (result.delimitedPrefixes || []).map(key => ({
          key,
          name: key.slice(prefix.length).replace(/\/$/, "")
        }));

        const files = (result.objects || [])
          .filter(o => !o.key.endsWith("/"))
          .map(o => ({
            key: o.key,
            name: o.key.slice(prefix.length),
            size: o.size,
            uploaded: o.uploaded,
            saved: o.customMetadata?.saved === "true",
            type: o.httpMetadata?.contentType || mime(o.key)
          }));

        return json({
          success: true,
          prefix,
          folders,
          files
        }, 200, cors);
      }

      // CREATE FOLDER
      if (url.pathname === "/create-folder" && request.method === "POST") {
        const body = await request.json();
        const name = clean(body.name);
        const prefix = cleanPrefix(body.prefix);

        if (!name)
          return json({ success: false, error: "Folder name required" }, 400, cors);

        const key = prefix + name + "/";

        await env.BUCKET.put(key, new Uint8Array(0), {
          customMetadata: { folder: "true" }
        });

        return json({ success: true, key }, 200, cors);
      }

      // UPLOAD
      if (url.pathname === "/upload" && request.method === "POST") {
        const form = await request.formData();
        const file = form.get("file");
        const prefix = cleanPrefix(form.get("prefix"));

        if (!file || typeof file === "string")
          return json({ success: false, error: "No file selected" }, 400, cors);

        const filename = clean(file.name || "file");

        if (!filename)
          return json({ success: false, error: "Invalid filename" }, 400, cors);

        const key = prefix + filename;

        await env.BUCKET.put(key, file.stream(), {
          httpMetadata: {
            contentType: file.type || mime(filename)
          },
          customMetadata: {
            originalName: filename,
            uploadedAt: new Date().toISOString(),
            saved: "false"
          }
        });

        return json({
          success: true,
          key,
          name: filename
        }, 200, cors);
      }

      // VIEW / DOWNLOAD
      if (url.pathname === "/photo" && request.method === "GET") {
        const key = url.searchParams.get("key");

        if (!key)
          return json({ success: false, error: "Key required" }, 400, cors);

        const object = await env.BUCKET.get(key);

        if (!object)
          return json({ success: false, error: "File not found" }, 404, cors);

        const headers = new Headers(cors);

        object.writeHttpMetadata(headers);

        headers.set(
          "Content-Type",
          object.httpMetadata?.contentType || mime(key)
        );

        if (object.httpEtag)
          headers.set("ETag", object.httpEtag);

        headers.set("Cache-Control", "private, max-age=3600");

        return new Response(object.body, {
          status: 200,
          headers
        });
      }

      // SAVE / UNSAVE
      if (
        (url.pathname === "/save" || url.pathname === "/unsave") &&
        request.method === "POST"
      ) {
        const body = await request.json();
        const key = body.key;

        if (!key)
          return json({ success: false, error: "Key required" }, 400, cors);

        const object = await env.BUCKET.get(key);

        if (!object)
          return json({ success: false, error: "File not found" }, 404, cors);

        const metadata = {
          ...(object.customMetadata || {})
        };

        if (url.pathname === "/save") {
          metadata.saved = "true";
          metadata.savedAt = new Date().toISOString();
        } else {
          metadata.saved = "false";
          delete metadata.savedAt;
        }

        await env.BUCKET.put(key, object.body, {
          httpMetadata: object.httpMetadata,
          customMetadata: metadata
        });

        return json({ success: true }, 200, cors);
      }

      // RENAME FILE
      if (url.pathname === "/rename" && request.method === "POST") {
        const body = await request.json();
        const oldKey = body.oldKey;
        const newName = clean(body.newName);

        if (!oldKey || !newName)
          return json({ success: false, error: "Invalid filename" }, 400, cors);

        const object = await env.BUCKET.get(oldKey);

        if (!object)
          return json({ success: false, error: "File not found" }, 404, cors);

        const slash = oldKey.lastIndexOf("/");
        const folder = slash >= 0 ? oldKey.slice(0, slash + 1) : "";
        const newKey = folder + newName;

        if (await env.BUCKET.head(newKey))
          return json({
            success: false,
            error: "A file with that name already exists"
          }, 409, cors);

        await env.BUCKET.put(newKey, object.body, {
          httpMetadata: object.httpMetadata,
          customMetadata: object.customMetadata
        });

        await env.BUCKET.delete(oldKey);

        return json({
          success: true,
          oldKey,
          newKey
        }, 200, cors);
      }

      // DELETE FILE
      if (url.pathname === "/delete" && request.method === "POST") {
        const body = await request.json();

        if (!body.key)
          return json({ success: false, error: "Key required" }, 400, cors);

        await env.BUCKET.delete(body.key);

        return json({ success: true }, 200, cors);
      }

      // DELETE FOLDER
      if (url.pathname === "/delete-folder" && request.method === "POST") {
        const body = await request.json();
        const prefix = cleanPrefix(body.prefix);

        if (!prefix)
          return json({ success: false, error: "Prefix required" }, 400, cors);

        let cursor;

        do {
          const result = await env.BUCKET.list({
            prefix,
            cursor,
            limit: 1000
          });

          const keys = result.objects.map(o => o.key);

          if (keys.length)
            await env.BUCKET.delete(keys);

          cursor = result.truncated ? result.cursor : undefined;
        } while (cursor);

        return json({ success: true }, 200, cors);
      }

      // RENAME FOLDER
      if (url.pathname === "/rename-folder" && request.method === "POST") {
        const body = await request.json();

        const oldPrefix = cleanPrefix(body.oldPrefix);
        const newName = clean(body.newName);

        if (!oldPrefix || !newName)
          return json({ success: false, error: "Invalid folder" }, 400, cors);

        const slash = oldPrefix.lastIndexOf("/", oldPrefix.length - 2);
        const parent = slash >= 0
          ? oldPrefix.slice(0, slash + 1)
          : "";

        const newPrefix = parent + newName + "/";

        if (oldPrefix === newPrefix)
          return json({
            success: false,
            error: "Folder name is unchanged"
          }, 400, cors);

        let cursor;

        do {
          const result = await env.BUCKET.list({
            prefix: oldPrefix,
            cursor,
            limit: 1000
          });

          for (const item of result.objects) {
            const object = await env.BUCKET.get(item.key);

            if (!object) continue;

            const newKey =
              newPrefix +
              item.key.slice(oldPrefix.length);

            await env.BUCKET.put(newKey, object.body, {
              httpMetadata: object.httpMetadata,
              customMetadata: object.customMetadata
            });

            await env.BUCKET.delete(item.key);
          }

          cursor = result.truncated ? result.cursor : undefined;
        } while (cursor);

        return json({
          success: true,
          oldPrefix,
          newPrefix
        }, 200, cors);
      }

      return json({
        success: false,
        error: "Not found"
      }, 404, cors);

    } catch (error) {
      return json({
        success: false,
        error: error?.message || "Server error"
      }, 500, cors);
    }
  }
};


// ==============================
// CORS
// ==============================

function getCors(origin) {
  return {
    "Access-Control-Allow-Origin":
      ALLOWED_ORIGINS.includes(origin)
        ? origin
        : ALLOWED_ORIGINS[0],

    "Access-Control-Allow-Methods":
      "GET, POST, OPTIONS",

    "Access-Control-Allow-Headers":
      "Content-Type, Authorization",

    "Access-Control-Expose-Headers":
      "Content-Type, Content-Length, ETag",

    "Vary": "Origin"
  };
}


// ==============================
// TOKEN
// ==============================

async function verifyToken(request, secret) {
  try {
    if (!secret) return false;

    const header =
      request.headers.get("Authorization") || "";

    if (!header.startsWith("Bearer "))
      return false;

    const token = header.slice(7);
    const parts = token.split(".");

    if (parts.length !== 2)
      return false;

    const data = decodeBase64Url(parts[0]);
    const values = data.split(".");

    if (values.length !== 2)
      return false;

    const expiry = Number(values[0]);

    if (
      !Number.isFinite(expiry) ||
      expiry < Math.floor(Date.now() / 1000)
    ) {
      return false;
    }

    const signature = await sign(data, secret);

    return safeEqual(parts[1], signature);

  } catch {
    return false;
  }
}


async function createToken(secret) {
  const data =
    (
      Math.floor(Date.now() / 1000) +
      SESSION_TTL
    ) +
    "." +
    crypto.randomUUID();

  return (
    encodeBase64Url(data) +
    "." +
    await sign(data, secret)
  );
}


async function sign(data, secret) {
  const key = await crypto.subtle.importKey(
    "raw",
    new TextEncoder().encode(secret),
    {
      name: "HMAC",
      hash: "SHA-256"
    },
    false,
    ["sign"]
  );

  const signature = await crypto.subtle.sign(
    "HMAC",
    key,
    new TextEncoder().encode(data)
  );

  return encodeBase64Url(
    new Uint8Array(signature)
  );
}


function encodeBase64Url(value) {
  let binary = "";

  if (typeof value === "string") {
    return btoa(value)
      .replace(/\+/g, "-")
      .replace(/\//g, "_")
      .replace(/=+$/, "");
  }

  for (const byte of value)
    binary += String.fromCharCode(byte);

  return btoa(binary)
    .replace(/\+/g, "-")
    .replace(/\//g, "_")
    .replace(/=+$/, "");
}


function decodeBase64Url(value) {
  let text = value
    .replace(/-/g, "+")
    .replace(/_/g, "/");

  text += "=".repeat(
    (4 - text.length % 4) % 4
  );

  return atob(text);
}


function safeEqual(a, b) {
  if (a.length !== b.length)
    return false;

  let result = 0;

  for (let i = 0; i < a.length; i++)
    result |=
      a.charCodeAt(i) ^
      b.charCodeAt(i);

  return result === 0;
}


// ==============================
// CLEAN
// ==============================

function clean(value) {
  return String(value || "")
    .replace(/[\\/:*?"<>|]/g, "_")
    .replace(/\.\./g, "_")
    .trim()
    .slice(0, 200);
}


function cleanPrefix(value) {
  let prefix = String(value || "")
    .replace(/\\/g, "/")
    .replace(/^\/+/, "");

  prefix = prefix
    .split("/")
    .filter(
      part =>
        part &&
        part !== "." &&
        part !== ".."
    )
    .join("/");

  return prefix ? prefix + "/" : "";
}


// ==============================
// MIME
// ==============================

function mime(name) {
  const ext =
    name
      .split(".")
      .pop()
      .toLowerCase();

  const types = {
    jpg: "image/jpeg",
    jpeg: "image/jpeg",
    png: "image/png",
    gif: "image/gif",
    webp: "image/webp",
    svg: "image/svg+xml",

    pdf: "application/pdf",
    txt: "text/plain",
    csv: "text/csv",
    json: "application/json",

    mp3: "audio/mpeg",
    wav: "audio/wav",

    mp4: "video/mp4",
    webm: "video/webm",

    zip: "application/zip",
    rar: "application/vnd.rar",
    "7z": "application/x-7z-compressed",

    doc: "application/msword",
    docx: "application/vnd.openxmlformats-officedocument.wordprocessingml.document",

    xls: "application/vnd.ms-excel",
    xlsx: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",

    ppt: "application/vnd.ms-powerpoint",
    pptx: "application/vnd.openxmlformats-officedocument.presentationml.presentation",

    apk: "application/vnd.android.package-archive"
  };

  return types[ext] ||
    "application/octet-stream";
}


// ==============================
// JSON
// ==============================

function json(data, status, cors) {
  return new Response(
    JSON.stringify(data),
    {
      status,
      headers: {
        ...cors,
        "Content-Type":
          "application/json; charset=UTF-8"
      }
    }
  );
}