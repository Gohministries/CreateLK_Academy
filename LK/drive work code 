const ORIGIN = "https://createlk.com";
const SESSION_TTL = 7 * 86400;

export default {
  async fetch(req, env) {
    const url = new URL(req.url);

    if (req.method === "OPTIONS")
      return new Response(null, { headers: cors() });

    try {
      // LOGIN
      if (url.pathname === "/auth" && req.method === "POST") {
        const { password } = await req.json();

        if (!env.ADMIN_PASSWORD || password !== env.ADMIN_PASSWORD)
          return json({ success: false, error: "Invalid password" }, 401);

        if (!env.SESSION_SECRET)
          return json({ success: false, error: "SESSION_SECRET not configured" }, 500);

        return json({
          success: true,
          token: await token(env.SESSION_SECRET),
          expiresIn: SESSION_TTL
        });
      }

      // AUTH
      if (!await auth(req, env.SESSION_SECRET))
        return json({ success: false, error: "Unauthorized" }, 401);

      // LIST
      if (url.pathname === "/list") {
        const prefix = cleanPrefix(url.searchParams.get("prefix"));
        const r = await env.BUCKET.list({
          prefix,
          delimiter: "/",
          limit: 1000
        });

        const folders = (r.delimitedPrefixes || []).map(key => ({
          key,
          name: key.slice(prefix.length).replace(/\/$/, "")
        }));

        const files = (r.objects || [])
          .filter(o => !o.key.endsWith("/"))
          .map(o => ({
            key: o.key,
            name: o.key.slice(prefix.length),
            size: o.size,
            uploaded: o.uploaded,
            saved: o.customMetadata?.saved === "true",
            type: o.httpMetadata?.contentType || mime(o.key)
          }));

        return json({ success: true, prefix, folders, files });
      }

      // CREATE FOLDER
      if (url.pathname === "/create-folder" && req.method === "POST") {
        const { name, prefix } = await req.json();
        const folder = clean(name);
        if (!folder) return json({ success: false, error: "Folder name required" }, 400);

        const key = cleanPrefix(prefix) + folder + "/";
        await env.BUCKET.put(key, "");

        return json({ success: true, key });
      }

      // UPLOAD
      if (url.pathname === "/upload" && req.method === "POST") {
        const form = await req.formData();
        const file = form.get("file");
        const prefix = cleanPrefix(form.get("prefix"));

        if (!file || typeof file === "string")
          return json({ success: false, error: "No file selected" }, 400);

        const name = clean(file.name || "file");
        const key = prefix + name;

        await env.BUCKET.put(key, file.stream(), {
          httpMetadata: {
            contentType: file.type || mime(name)
          },
          customMetadata: {
            originalName: name,
            uploadedAt: new Date().toISOString()
          }
        });

        return json({ success: true, key, name });
      }

      // OPEN FILE
      if (url.pathname === "/photo") {
        const key = url.searchParams.get("key");
        if (!key) return json({ success: false, error: "Key required" }, 400);

        const obj = await env.BUCKET.get(key);
        if (!obj) return json({ success: false, error: "File not found" }, 404);

        const h = new Headers(cors());
        obj.writeHttpMetadata(h);
        h.set("Cache-Control", "private, max-age=3600");
        h.set("ETag", obj.httpEtag);

        return new Response(obj.body, { headers: h });
      }

      // SAVE / UNSAVE
      if (
        (url.pathname === "/save" || url.pathname === "/unsave") &&
        req.method === "POST"
      ) {
        const { key } = await req.json();
        const obj = await env.BUCKET.get(key);

        if (!obj)
          return json({ success: false, error: "File not found" }, 404);

        const meta = { ...(obj.customMetadata || {}) };

        if (url.pathname === "/save") {
          meta.saved = "true";
          meta.savedAt = new Date().toISOString();
        } else {
          delete meta.saved;
          delete meta.savedAt;
        }

        await env.BUCKET.put(key, obj.body, {
          httpMetadata: obj.httpMetadata,
          customMetadata: meta
        });

        return json({ success: true });
      }

      // RENAME FILE
      if (url.pathname === "/rename" && req.method === "POST") {
        const { oldKey, newName } = await req.json();
        const name = clean(newName);

        if (!oldKey || !name)
          return json({ success: false, error: "Invalid filename" }, 400);

        const obj = await env.BUCKET.get(oldKey);
        if (!obj)
          return json({ success: false, error: "File not found" }, 404);

        const folder =
          oldKey.includes("/")
            ? oldKey.slice(0, oldKey.lastIndexOf("/") + 1)
            : "";

        const newKey = folder + name;

        if (await env.BUCKET.head(newKey))
          return json({ success: false, error: "File already exists" }, 409);

        await env.BUCKET.put(newKey, obj.body, {
          httpMetadata: obj.httpMetadata,
          customMetadata: obj.customMetadata
        });

        await env.BUCKET.delete(oldKey);

        return json({ success: true, oldKey, newKey });
      }

      // DELETE FILE
      if (url.pathname === "/delete" && req.method === "POST") {
        const { key } = await req.json();

        if (!key)
          return json({ success: false, error: "Key required" }, 400);

        await env.BUCKET.delete(key);

        return json({ success: true });
      }

      // DELETE FOLDER
      if (url.pathname === "/delete-folder" && req.method === "POST") {
        const { prefix } = await req.json();
        const p = cleanPrefix(prefix);

        if (!p)
          return json({ success: false, error: "Prefix required" }, 400);

        let cursor;

        do {
          const r = await env.BUCKET.list({
            prefix: p,
            cursor,
            limit: 1000
          });

          const keys = r.objects.map(o => o.key);
          if (keys.length) await env.BUCKET.delete(keys);

          cursor = r.truncated ? r.cursor : undefined;
        } while (cursor);

        return json({ success: true });
      }

      // RENAME FOLDER
      if (url.pathname === "/rename-folder" && req.method === "POST") {
        const { oldPrefix, newName } = await req.json();

        const oldP = cleanPrefix(oldPrefix);
        const name = clean(newName);

        if (!oldP || !name)
          return json({ success: false, error: "Invalid folder" }, 400);

        const parent =
          oldP.includes("/")
            ? oldP.slice(0, oldP.lastIndexOf("/", oldP.length - 2) + 1)
            : "";

        const newP = parent + name + "/";

        if (oldP === newP)
          return json({ success: false, error: "Same folder name" }, 400);

        let cursor;

        do {
          const r = await env.BUCKET.list({
            prefix: oldP,
            cursor,
            limit: 1000
          });

          for (const item of r.objects) {
            const obj = await env.BUCKET.get(item.key);
            if (!obj) continue;

            const newKey =
              newP + item.key.slice(oldP.length);

            await env.BUCKET.put(newKey, obj.body, {
              httpMetadata: obj.httpMetadata,
              customMetadata: obj.customMetadata
            });

            await env.BUCKET.delete(item.key);
          }

          cursor = r.truncated ? r.cursor : undefined;
        } while (cursor);

        return json({
          success: true,
          oldPrefix: oldP,
          newPrefix: newP
        });
      }

      return json({ success: false, error: "Not found" }, 404);

    } catch (e) {
      return json({
        success: false,
        error: e.message || "Server error"
      }, 500);
    }
  }
};


// AUTH
async function auth(req, secret) {
  if (!secret) return false;

  const h = req.headers.get("Authorization") || "";
  if (!h.startsWith("Bearer ")) return false;

  return verify(h.slice(7), secret);
}


// CREATE TOKEN
async function token(secret) {
  const data =
    `${Math.floor(Date.now() / 1000) + SESSION_TTL}.${crypto.randomUUID()}`;

  return b64(data) + "." + await sign(data, secret);
}


// VERIFY TOKEN
async function verify(t, secret) {
  try {
    const p = t.split(".");
    if (p.length !== 2) return false;

    const data = fromB64(p[0]);
    const parts = data.split(".");

    if (
      parts.length !== 2 ||
      Number(parts[0]) < Math.floor(Date.now() / 1000)
    ) return false;

    return safeEqual(
      p[1],
      await sign(data, secret)
    );
  } catch {
    return false;
  }
}


// SIGN
async function sign(data, secret) {
  const key = await crypto.subtle.importKey(
    "raw",
    new TextEncoder().encode(secret),
    { name: "HMAC", hash: "SHA-256" },
    false,
    ["sign"]
  );

  const sig = await crypto.subtle.sign(
    "HMAC",
    key,
    new TextEncoder().encode(data)
  );

  return b64(new Uint8Array(sig));
}


// BASE64 URL
function b64(value) {
  let s = "";

  if (typeof value === "string") {
    return btoa(value)
      .replace(/\+/g, "-")
      .replace(/\//g, "_")
      .replace(/=+$/, "");
  }

  for (const x of value)
    s += String.fromCharCode(x);

  return btoa(s)
    .replace(/\+/g, "-")
    .replace(/\//g, "_")
    .replace(/=+$/, "");
}


function fromB64(value) {
  const s = value
    .replace(/-/g, "+")
    .replace(/_/g, "/");

  return atob(
    s + "=".repeat((4 - s.length % 4) % 4)
  );
}


// SAFE COMPARE
function safeEqual(a, b) {
  if (a.length !== b.length) return false;

  let result = 0;

  for (let i = 0; i < a.length; i++)
    result |= a.charCodeAt(i) ^ b.charCodeAt(i);

  return result === 0;
}


// CLEAN NAME
function clean(value) {
  return String(value || "")
    .replace(/[\\/:*?"<>|]/g, "_")
    .replace(/\.\./g, "_")
    .trim()
    .slice(0, 200);
}


// CLEAN PREFIX
function cleanPrefix(value) {
  let p = String(value || "")
    .replace(/\\/g, "/")
    .replace(/^\/+/, "");

  p = p
    .split("/")
    .filter(x => x && x !== "." && x !== "..")
    .join("/");

  return p ? p + "/" : "";
}


// MIME
function mime(name) {
  const e =
    name.split(".").pop().toLowerCase();

  return {
    apk: "application/vnd.android.package-archive",
    pdf: "application/pdf",
    doc: "application/msword",
    docx: "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
    xls: "application/vnd.ms-excel",
    xlsx: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
    ppt: "application/vnd.ms-powerpoint",
    pptx: "application/vnd.openxmlformats-officedocument.presentationml.presentation",
    zip: "application/zip",
    rar: "application/vnd.rar",
    "7z": "application/x-7z-compressed",
    jpg: "image/jpeg",
    jpeg: "image/jpeg",
    png: "image/png",
    gif: "image/gif",
    webp: "image/webp",
    svg: "image/svg+xml",
    mp3: "audio/mpeg",
    mp4: "video/mp4",
    wav: "audio/wav",
    txt: "text/plain",
    csv: "text/csv",
    json: "application/json"
  }[e] || "application/octet-stream";
}


// CORS
function cors() {
  return {
    "Access-Control-Allow-Origin": ORIGIN,
    "Access-Control-Allow-Methods": "GET,POST,OPTIONS",
    "Access-Control-Allow-Headers": "Content-Type,Authorization"
  };
}


// JSON
function json(data, status = 200) {
  return new Response(
    JSON.stringify(data),
    {
      status,
      headers: {
        ...cors(),
        "Content-Type": "application/json"
      }
    }
  );
}