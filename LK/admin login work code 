/* =========================
   SECURITY
========================= */

function escapeHtml(value) {

  return String(value)
    .replaceAll("&","&amp;")
    .replaceAll("<","&lt;")
    .replaceAll(">","&gt;")
    .replaceAll('"',"&quot;")
    .replaceAll("'","&#039;");
}


function randomToken(bytesLength = 32) {

  const bytes =
    crypto.getRandomValues(
      new Uint8Array(bytesLength)
    );

  return Array.from(bytes)
    .map(
      b =>
        b.toString(16)
          .padStart(2,"0")
    )
    .join("");
}


function getCookie(request,name) {

  const cookie =
    request.headers.get("Cookie") || "";

  for(
    const part of cookie.split(";")
  ){

    const index =
      part.indexOf("=");

    if(index === -1) continue;

    const key =
      part.slice(0,index).trim();

    const value =
      part.slice(index + 1).trim();

    if(key === name){

      return decodeURIComponent(
        value
      );

    }
  }

  return null;
}


function createStateCookie(state) {

  return [
    `${STATE_COOKIE}=${encodeURIComponent(state)}`,
    "Path=/",
    "HttpOnly",
    "Secure",
    "SameSite=Lax",
    "Max-Age=600"
  ].join("; ");
}


function clearStateCookie() {

  return [
    `${STATE_COOKIE}=`,
    "Path=/",
    "HttpOnly",
    "Secure",
    "SameSite=Lax",
    "Max-Age=0"
  ].join("; ");
}


/* =========================
   START GOOGLE LOGIN
========================= */

function startGoogleLogin() {

  const state =
    randomToken(32);

  const googleUrl =
    new URL(
      GOOGLE_AUTH_URL
    );

  googleUrl.searchParams.set(
    "client_id",
    CLIENT_ID
  );

  googleUrl.searchParams.set(
    "redirect_uri",
    REDIRECT_URI
  );

  googleUrl.searchParams.set(
    "response_type",
    "code"
  );

  googleUrl.searchParams.set(
    "scope",
    "openid email profile"
  );

  googleUrl.searchParams.set(
    "state",
    state
  );

  googleUrl.searchParams.set(
    "access_type",
    "online"
  );

  googleUrl.searchParams.set(
    "prompt",
    "select_account"
  );

  return new Response(null,{
    status:302,

    headers:{
      Location:
        googleUrl.toString(),

      "Set-Cookie":
        createStateCookie(state),

      "Cache-Control":
        "no-store"
    }
  });
}


/* =========================
   GOOGLE CALLBACK
========================= */

async function handleCallback(
  request,
  env
) {

  const url =
    new URL(request.url);

  const code =
    url.searchParams.get("code");

  const returnedState =
    url.searchParams.get("state");

  const googleError =
    url.searchParams.get("error");

  if(googleError){

    return errorPage(
      `Google returned an error: ${googleError}`
    );
  }


  const savedState =
    getCookie(
      request,
      STATE_COOKIE
    );


  if(
    !code ||
    !returnedState ||
    !savedState
  ){

    return errorPage(
      "Invalid or expired login request. Please try again."
    );
  }


  if(
    returnedState !== savedState
  ){

    return errorPage(
      "Google security verification failed. Please try again."
    );
  }


  try {

    /* =====================
       CHECK CONFIGURATION
    ===================== */

    const adminEmail =
      String(
        env.ADMIN_EMAIL || ""
      )
      .trim()
      .toLowerCase();

    if(!adminEmail){

      return errorPage(
        "ADMIN_EMAIL is not configured."
      );
    }


    const clientSecret =
      String(
        env.GOOGLE_CLIENT_SECRET || ""
      ).trim();

    if(!clientSecret){

      return errorPage(
        "GOOGLE_CLIENT_SECRET is not configured."
      );
    }


    /* =====================
       GOOGLE CODE EXCHANGE
    ===================== */

    const tokenResponse =
      await fetch(
        GOOGLE_TOKEN_URL,
        {
          method:"POST",

          headers:{
            "Content-Type":
              "application/x-www-form-urlencoded"
          },

          body:
            new URLSearchParams({

              client_id:
                CLIENT_ID,

              client_secret:
                clientSecret,

              code:
                code,

              grant_type:
                "authorization_code",

              redirect_uri:
                REDIRECT_URI

            }).toString()
        }
      );


    const tokenText =
      await tokenResponse.text();

    let googleTokens;

    try{

      googleTokens =
        JSON.parse(
          tokenText
        );

    }catch{

      return errorPage(
        "Google returned an invalid token response."
      );
    }


    if(!tokenResponse.ok){

      console.error(
        "GOOGLE TOKEN ERROR:",
        googleTokens
      );

      return errorPage(
        `Google token exchange failed: ${
          googleTokens.error_description ||
          googleTokens.error ||
          "Unknown Google error."
        }`
      );
    }


    if(
      !googleTokens.access_token
    ){

      return errorPage(
        "Google did not return an access token."
      );
    }


    /* =====================
       GET GOOGLE ACCOUNT
    ===================== */

    const userResponse =
      await fetch(
        GOOGLE_USERINFO_URL,
        {
          method:"GET",

          headers:{
            Authorization:
              `Bearer ${googleTokens.access_token}`
          }
        }
      );


    const userText =
      await userResponse.text();

    let googleUser;

    try{

      googleUser =
        JSON.parse(
          userText
        );

    }catch{

      return errorPage(
        "Google account information could not be read."
      );
    }


    if(!userResponse.ok){

      console.error(
        "GOOGLE USERINFO ERROR:",
        googleUser
      );

      return errorPage(
        "Could not retrieve your Google account."
      );
    }


    /* =====================
       ADMIN EMAIL
    ===================== */

    const email =
      String(
        googleUser.email || ""
      )
      .trim()
      .toLowerCase();


    if(!email){

      return errorPage(
        "Google did not provide an email address."
      );
    }


    if(email !== adminEmail){

      return errorPage(
        "This Google account is not authorized for administrator access."
      );
    }


    /* =====================
       EMAIL VERIFICATION
    ===================== */

    if(
      googleUser.email_verified !== true
    ){

      return errorPage(
        "The administrator Google email must be verified."
      );
    }


    /* =====================
       GOOGLE ID
    ===================== */

    const googleId =
      String(
        googleUser.sub || ""
      );


    if(!googleId){

      return errorPage(
        "Google account information is incomplete."
      );
    }


    /* =====================
       CREATE / UPDATE USER
    ===================== */

    await env.DB.prepare(`
      INSERT INTO users
      (
        google_id,
        name,
        email,
        photo_url,
        email_verified,
        last_login
      )
      VALUES (?, ?, ?, ?, ?, CURRENT_TIMESTAMP)

      ON CONFLICT(google_id)
      DO UPDATE SET
        name = excluded.name,
        email = excluded.email,
        photo_url = excluded.photo_url,
        email_verified = excluded.email_verified,
        last_login = CURRENT_TIMESTAMP
    `)
    .bind(

      googleId,

      String(
        googleUser.name || ""
      ),

      email,

      String(
        googleUser.picture || ""
      ),

      1

    )
    .run();


    /* =====================
       GET USER
    ===================== */

    const user =
      await env.DB.prepare(`
        SELECT
          id,
          name,
          email
        FROM users
        WHERE google_id = ?
        LIMIT 1
      `)
      .bind(googleId)
      .first();


    if(!user){

      return errorPage(
        "Could not create the administrator account."
      );
    }


    /* =====================
       REMOVE OLD SESSIONS
    ===================== */

    await env.DB.prepare(`
      DELETE FROM sessions
      WHERE user_id = ?
    `)
    .bind(user.id)
    .run();


    /* =====================
       CREATE SESSION
    ===================== */

    const sessionToken =
      randomToken(32);

    const now =
      Math.floor(
        Date.now() / 1000
      );

    const expiresAt =
      now +
      SESSION_DAYS * 86400;


    await env.DB.prepare(`
      INSERT INTO sessions
      (
        id,
        user_id,
        expires_at
      )
      VALUES (?, ?, ?)
    `)
    .bind(
      sessionToken,
      user.id,
      expiresAt
    )
    .run();


    /* =====================
       CREATE ADMIN TICKET
    ===================== */

    const ticket =
      randomToken(32);

    const ticketExpires =
      now +
      TICKET_MINUTES * 60;


    await env.DB.prepare(`
      INSERT INTO admin_oauth_tickets
      (
        id,
        user_id,
        expires_at,
        session_token
      )
      VALUES (?, ?, ?, ?)
    `)
    .bind(
      ticket,
      user.id,
      ticketExpires,
      sessionToken
    )
    .run();


    /* =====================
       REDIRECT TO ADMIN PAGE
    ===================== */

    const redirect =
      new URL(
        ADMIN_LOGIN_PAGE
      );

    redirect.searchParams.set(
      "ticket",
      ticket
    );


    return new Response(null,{
      status:302,

      headers:{
        Location:
          redirect.toString(),

        "Set-Cookie":
          clearStateCookie(),

        "Cache-Control":
          "no-store"
      }
    });


  }catch(error){

    console.error(
      "ADMIN LOGIN ERROR:",
      error
    );

    return errorPage(
      `Administrator login failed: ${
        error?.message ||
        "Unknown error."
      }`
    );
  }
}


/* =========================
   EXCHANGE TICKET
========================= */

async function exchangeTicket(
  request,
  env
) {

  if(
    request.method !== "POST"
  ){

    return json({
      success:false,
      error:"POST required."
    },405);
  }


  let body;

  try{

    body =
      await request.json();

  }catch{

    return json({
      success:false,
      error:"Invalid JSON."
    },400);
  }


  const ticket =
    String(
      body.ticket || ""
    ).trim();


  if(!ticket){

    return json({
      success:false,
      error:"Ticket is required."
    },400);
  }


  const now =
    Math.floor(
      Date.now() / 1000
    );


  const row =
    await env.DB.prepare(`
      SELECT
        id,
        user_id,
        expires_at,
        session_token
      FROM admin_oauth_tickets
      WHERE id = ?
      LIMIT 1
    `)
    .bind(ticket)
    .first();


  if(!row){

    return json({
      success:false,
      error:"Invalid or expired ticket."
    },401);
  }


  if(
    Number(row.expires_at) <= now
  ){

    await env.DB.prepare(`
      DELETE FROM admin_oauth_tickets
      WHERE id = ?
    `)
    .bind(ticket)
    .run();

    return json({
      success:false,
      error:"Ticket expired."
    },401);
  }


  if(!row.session_token){

    return json({
      success:false,
      error:"Ticket has no administrator session."
    },401);
  }


  /* =====================
     VERIFY SESSION
  ===================== */

  const session =
    await env.DB.prepare(`
      SELECT
        s.id,
        s.user_id,
        s.expires_at,
        u.email
      FROM sessions s
      INNER JOIN users u
        ON u.id = s.user_id
      WHERE s.id = ?
      AND s.user_id = ?
      LIMIT 1
    `)
    .bind(
      row.session_token,
      row.user_id
    )
    .first();


  if(!session){

    await env.DB.prepare(`
      DELETE FROM admin_oauth_tickets
      WHERE id = ?
    `)
    .bind(ticket)
    .run();

    return json({
      success:false,
      error:"Administrator session was not found."
    },401);
  }


  if(
    Number(session.expires_at) <= now
  ){

    await env.DB.prepare(`
      DELETE FROM admin_oauth_tickets
      WHERE id = ?
    `)
    .bind(ticket)
    .run();

    return json({
      success:false,
      error:"Administrator session expired."
    },401);
  }


  const adminEmail =
    String(
      env.ADMIN_EMAIL || ""
    )
    .trim()
    .toLowerCase();


  if(
    String(session.email || "")
      .trim()
      .toLowerCase()
      !== adminEmail
  ){

    await env.DB.prepare(`
      DELETE FROM admin_oauth_tickets
      WHERE id = ?
    `)
    .bind(ticket)
    .run();

    return json({
      success:false,
      error:"Administrator access denied."
    },403);
  }


  /* =====================
     ONE-TIME TICKET
  ===================== */

  await env.DB.prepare(`
    DELETE FROM admin_oauth_tickets
    WHERE id = ?
  `)
  .bind(ticket)
  .run();


  return json({
    success:true,
    token:
      row.session_token
  });
}


/* =========================
   CLEAN OLD TICKETS
========================= */

async function cleanTickets(env){

  try{

    const now =
      Math.floor(
        Date.now() / 1000
      );

    await env.DB.prepare(`
      DELETE FROM admin_oauth_tickets
      WHERE expires_at <= ?
    `)
    .bind(now)
    .run();

  }catch(error){

    console.error(
      "TICKET CLEANUP ERROR:",
      error
    );

  }
}


/* =========================
   MAIN ROUTER
========================= */

export default {

  async fetch(
    request,
    env
  ){

    const url =
      new URL(request.url);


    await cleanTickets(env);


    /* =====================
       HOME
    ===================== */

    if(
      request.method === "GET" &&
      url.pathname === "/"
    ){

      return json({
        success:true,
        service:
          "CreateLK Jobs Admin Login",
        status:"online"
      });
    }


    /* =====================
       HEALTH
    ===================== */

    if(
      request.method === "GET" &&
      url.pathname === "/health"
    ){

      return json({
        success:true,
        service:
          "CreateLK Jobs Admin Login",
        status:"online"
      });
    }


    /* =====================
       GOOGLE LOGIN
    ===================== */

    if(
      request.method === "GET" &&
      (
        url.pathname === "/login" ||
        url.pathname === "/auth/google"
      )
    ){

      return startGoogleLogin();
    }


    /* =====================
       GOOGLE CALLBACK
    ===================== */

    if(
      request.method === "GET" &&
      url.pathname === "/callback"
    ){

      return handleCallback(
        request,
        env
      );
    }


    /* =====================
       TICKET EXCHANGE
    ===================== */

    if(
      request.method === "POST" &&
      url.pathname === "/exchange"
    ){

      return exchangeTicket(
        request,
        env
      );
    }


    return json({
      success:false,
      error:"Not found"
    },404);
  }

};