582157960266const CLIENT_ID =
  "582157960266-rsril7394snes3qg1cjpiqnolea7qagp.apps.googleusercontent.com";

const REDIRECT_URI =
  "https://admin-login.createlk.workers.dev/callback";

const ADMIN_LOGIN_PAGE =
  "https://createlk.com/LK/admin-login.html";

const ADMIN_DASHBOARD =
  "https://createlk.com/LK/admin.html";

const GOOGLE_AUTH_URL =
  "https://accounts.google.com/o/oauth2/v2/auth";

const GOOGLE_TOKEN_URL =
  "https://oauth2.googleapis.com/token";

const GOOGLE_USERINFO_URL =
  "https://openidconnect.googleapis.com/v1/userinfo";

const STATE_COOKIE =
  "createlk_admin_oauth_state";

const SESSION_DAYS = 30;
const TICKET_MINUTES = 5;


/* =========================
   CORS
========================= */

function corsHeaders() {
  return {
    "Access-Control-Allow-Origin": "https://createlk.com",
    "Access-Control-Allow-Methods": "GET, POST, OPTIONS",
    "Access-Control-Allow-Headers": "Content-Type",
    "Access-Control-Max-Age": "86400"
  };
}


/* =========================
   JSON RESPONSE
========================= */

function json(data, status = 200) {
  return new Response(
    JSON.stringify(data),
    {
      status,
      headers: {
        "Content-Type": "application/json;charset=UTF-8",
        "Cache-Control": "no-store",
        ...corsHeaders()
      }
    }
  );
}


/* =========================
   RANDOM TOKEN
========================= */

function randomToken(bytes = 32) {
  const array = new Uint8Array(bytes);
  crypto.getRandomValues(array);

  return Array.from(array)
    .map(b => b.toString(16).padStart(2, "0"))
    .join("");
}


/* =========================
   COOKIE PARSER
========================= */

function getCookie(request, name) {
  const cookieHeader =
    request.headers.get("Cookie") || "";

  const cookies = cookieHeader.split(";");

  for (const cookie of cookies) {
    const index = cookie.indexOf("=");

    if (index === -1) continue;

    const key =
      cookie.slice(0, index).trim();

    const value =
      cookie.slice(index + 1).trim();

    if (key === name) {
      return decodeURIComponent(value);
    }
  }

  return null;
}


/* =========================
   SET COOKIE
========================= */

function setCookie(
  name,
  value,
  maxAge
) {
  return [
    `${name}=${encodeURIComponent(value)}`,
    "Path=/",
    "HttpOnly",
    "Secure",
    "SameSite=Lax",
    `Max-Age=${maxAge}`
  ].join("; ");
}


/* =========================
   DELETE COOKIE
========================= */

function deleteCookie(name) {
  return [
    `${name}=`,
    "Path=/",
    "HttpOnly",
    "Secure",
    "SameSite=Lax",
    "Max-Age=0"
  ].join("; ");
}


/* =========================
   GOOGLE LOGIN
========================= */

function startGoogleLogin() {

  const state =
    randomToken(32);

  const authUrl =
    new URL(GOOGLE_AUTH_URL);

  authUrl.searchParams.set(
    "client_id",
    CLIENT_ID
  );

  authUrl.searchParams.set(
    "redirect_uri",
    REDIRECT_URI
  );

  authUrl.searchParams.set(
    "response_type",
    "code"
  );

  authUrl.searchParams.set(
    "scope",
    "openid email profile"
  );

  authUrl.searchParams.set(
    "state",
    state
  );

  authUrl.searchParams.set(
    "access_type",
    "offline"
  );

  authUrl.searchParams.set(
    "prompt",
    "select_account"
  );

  return new Response(null, {
    status: 302,
    headers: {
      "Location": authUrl.toString(),
      "Set-Cookie": setCookie(
        STATE_COOKIE,
        state,
        600
      )
    }
  });
}


/* =========================
   GOOGLE CALLBACK
========================= */

async function handleCallback(
  request,
  env
) {

  const url =
    new URL(request.url);

  const code =
    url.searchParams.get("code");

  const returnedState =
    url.searchParams.get("state");

  const savedState =
    getCookie(
      request,
      STATE_COOKIE
    );

  if (!code) {
    return new Response(
      "Google authentication failed: authorization code missing.",
      { status: 400 }
    );
  }

  if (
    !returnedState ||
    !savedState ||
    returnedState !== savedState
  ) {
    return new Response(
      "Google authentication failed: invalid OAuth state.",
      { status: 400 }
    );
  }

  if (!env.GOOGLE_CLIENT_SECRET) {
    return new Response(
      "GOOGLE_CLIENT_SECRET is not configured.",
      { status: 500 }
    );
  }

  if (!env.DB) {
    return new Response(
      "D1 database binding DB is not configured.",
      { status: 500 }
    );
  }


  /* =========================
     EXCHANGE GOOGLE CODE
  ========================= */

  const tokenResponse =
    await fetch(
      GOOGLE_TOKEN_URL,
      {
        method: "POST",
        headers: {
          "Content-Type":
            "application/x-www-form-urlencoded"
        },
        body:
          new URLSearchParams({
            client_id: CLIENT_ID,
            client_secret:
              env.GOOGLE_CLIENT_SECRET,
            code,
            grant_type:
              "authorization_code",
            redirect_uri:
              REDIRECT_URI
          })
      }
    );


  if (!tokenResponse.ok) {

    const errorText =
      await tokenResponse.text();

    return new Response(
      "Google token exchange failed: " +
      errorText,
      { status: 401 }
    );
  }


  const tokenData =
    await tokenResponse.json();

  const accessToken =
    tokenData.access_token;

  if (!accessToken) {
    return new Response(
      "Google authentication failed: access token missing.",
      { status: 401 }
    );
  }


  /* =========================
     GOOGLE USER INFO
  ========================= */

  const userResponse =
    await fetch(
      GOOGLE_USERINFO_URL,
      {
        headers: {
          Authorization:
            `Bearer ${accessToken}`
        }
      }
    );


  if (!userResponse.ok) {

    const errorText =
      await userResponse.text();

    return new Response(
      "Google user information failed: " +
      errorText,
      { status: 401 }
    );
  }


  const googleUser =
    await userResponse.json();


  const googleId =
    String(
      googleUser.sub || ""
    ).trim();

  const name =
    String(
      googleUser.name || ""
    ).trim();

  const email =
    String(
      googleUser.email || ""
    ).trim()
    .toLowerCase();

  const photoUrl =
    String(
      googleUser.picture || ""
    ).trim();

  const emailVerified =
    googleUser.email_verified
      ? 1
      : 0;


  if (!googleId || !email) {
    return new Response(
      "Google account information is incomplete.",
      { status: 400 }
    );
  }


  /* =========================
     ADMIN EMAIL CHECK
  ========================= */

  const adminEmail =
    String(
      env.ADMIN_EMAIL || ""
    )
    .trim()
    .toLowerCase();


  if (!adminEmail) {
    return new Response(
      "ADMIN_EMAIL is not configured.",
      { status: 500 }
    );
  }


  if (email !== adminEmail) {
    return new Response(
      "Administrator login denied. This Google account is not authorized.",
      { status: 403 }
    );
  }


  /* =========================
     CREATE / UPDATE USER
  ========================= */

  await env.DB
    .prepare(`
      INSERT INTO users (
        google_id,
        name,
        email,
        photo_url,
        email_verified,
        last_login
      )
      VALUES (?, ?, ?, ?, ?, CURRENT_TIMESTAMP)

      ON CONFLICT(google_id)
      DO UPDATE SET
        name = excluded.name,
        email = excluded.email,
        photo_url = excluded.photo_url,
        email_verified = excluded.email_verified,
        last_login = CURRENT_TIMESTAMP
    `)
    .bind(
      googleId,
      name,
      email,
      photoUrl,
      emailVerified
    )
    .run();


  /* =========================
     GET USER ID
  ========================= */

  const user =
    await env.DB
      .prepare(`
        SELECT
          id,
          google_id,
          name,
          email,
          photo_url,
          email_verified
        FROM users
        WHERE google_id = ?
        LIMIT 1
      `)
      .bind(googleId)
      .first();


  if (!user) {
    return new Response(
      "Administrator user could not be created.",
      { status: 500 }
    );
  }


  /* =========================
     CREATE ADMIN SESSION
  ========================= */

  const sessionToken =
    randomToken(32);

  const expiresAt =
    Math.floor(
      Date.now() / 1000
    ) +
    SESSION_DAYS * 24 * 60 * 60;


  /* Remove old sessions for this user */

  await env.DB
    .prepare(`
      DELETE FROM sessions
      WHERE user_id = ?
    `)
    .bind(user.id)
    .run();


  /* Create new session */

  await env.DB
    .prepare(`
      INSERT INTO sessions (
        id,
        user_id,
        expires_at
      )
      VALUES (?, ?, ?)
    `)
    .bind(
      sessionToken,
      user.id,
      expiresAt
    )
    .run();


  /* =========================
     CREATE ONE-TIME TICKET
  ========================= */

  const ticket =
    randomToken(32);

  const ticketExpires =
    Math.floor(
      Date.now() / 1000
    ) +
    TICKET_MINUTES * 60;


  await env.DB
    .prepare(`
      INSERT INTO admin_oauth_tickets (
        id,
        user_id,
        expires_at,
        session_token
      )
      VALUES (?, ?, ?, ?)
    `)
    .bind(
      ticket,
      user.id,
      ticketExpires,
      sessionToken
    )
    .run();


  /* =========================
     CLEAN OLD TICKETS
  ========================= */

  await cleanTickets(env);


  /* =========================
     REDIRECT TO ADMIN LOGIN
  ========================= */

  const redirectUrl =
    new URL(ADMIN_LOGIN_PAGE);

  redirectUrl.searchParams.set(
    "ticket",
    ticket
  );


  return new Response(null, {
    status: 302,
    headers: {
      "Location":
        redirectUrl.toString(),

      "Set-Cookie":
        deleteCookie(
          STATE_COOKIE
        ),

      "Cache-Control":
        "no-store"
    }
  });
}


/* =========================
   CLEAN EXPIRED TICKETS
========================= */

async function cleanTickets(env) {

  await env.DB
    .prepare(`
      DELETE FROM admin_oauth_tickets
      WHERE expires_at <= ?
    `)
    .bind(
      Math.floor(
        Date.now() / 1000
      )
    )
    .run();
}


/* =========================
   EXCHANGE TICKET
========================= */

async function exchangeTicket(
  request,
  env
) {

  try {

    const body =
      await request.json();

    const ticket =
      String(
        body.ticket || ""
      ).trim();


    if (!ticket) {
      return json({
        success: false,
        error: "Ticket is required."
      }, 400);
    }


    /* =========================
       FIND TICKET
    ========================= */

    const row =
      await env.DB
        .prepare(`
          SELECT
            t.id,
            t.user_id,
            t.expires_at,
            t.session_token,
            u.name,
            u.email,
            u.photo_url
          FROM admin_oauth_tickets t

          JOIN users u
            ON u.id = t.user_id

          WHERE t.id = ?

          LIMIT 1
        `)
        .bind(ticket)
        .first();


    if (!row) {
      return json({
        success: false,
        error:
          "Invalid or expired administrator ticket."
      }, 401);
    }


    /* =========================
       CHECK EXPIRATION
    ========================= */

    const now =
      Math.floor(
        Date.now() / 1000
      );


    if (
      Number(row.expires_at) <= now
    ) {

      await env.DB
        .prepare(`
          DELETE FROM admin_oauth_tickets
          WHERE id = ?
        `)
        .bind(ticket)
        .run();


      return json({
        success: false,
        error:
          "Administrator ticket expired."
      }, 401);
    }


    /* =========================
       CHECK ADMIN EMAIL
    ========================= */

    const adminEmail =
      String(
        env.ADMIN_EMAIL || ""
      )
      .trim()
      .toLowerCase();


    const userEmail =
      String(
        row.email || ""
      )
      .trim()
      .toLowerCase();


    if (
      !adminEmail ||
      userEmail !== adminEmail
    ) {

      await env.DB
        .prepare(`
          DELETE FROM admin_oauth_tickets
          WHERE id = ?
        `)
        .bind(ticket)
        .run();


      return json({
        success: false,
        error:
          "Admin access required."
      }, 403);
    }


    /* =========================
       CHECK SESSION
    ========================= */

    if (!row.session_token) {

      return json({
        success: false,
        error:
          "Administrator session was not created."
      }, 500);
    }


    const session =
      await env.DB
        .prepare(`
          SELECT
            id,
            user_id,
            expires_at
          FROM sessions
          WHERE id = ?
          LIMIT 1
        `)
        .bind(row.session_token)
        .first();


    if (!session) {

      return json({
        success: false,
        error:
          "Administrator session not found."
      }, 401);
    }


    if (
      Number(session.expires_at) <= now
    ) {

      await env.DB
        .prepare(`
          DELETE FROM sessions
          WHERE id = ?
        `)
        .bind(row.session_token)
        .run();


      await env.DB
        .prepare(`
          DELETE FROM admin_oauth_tickets
          WHERE id = ?
        `)
        .bind(ticket)
        .run();


      return json({
        success: false,
        error:
          "Administrator session expired."
      }, 401);
    }


    /* =========================
       ONE-TIME TICKET
    ========================= */

    await env.DB
      .prepare(`
        DELETE FROM admin_oauth_tickets
        WHERE id = ?
      `)
      .bind(ticket)
      .run();


    /* =========================
       SUCCESS
    ========================= */

    return json({
      success: true,

      token:
        row.session_token,

      user: {
        name:
          row.name || "",

        email:
          row.email || "",

        photo_url:
          row.photo_url || ""
      }
    });

  } catch (error) {

    return json({
      success: false,
      error:
        error?.message ||
        "Administrator login failed."
    }, 500);
  }
}


/* =========================
   MAIN WORKER
========================= */

export default {

  async fetch(
    request,
    env
  ) {

    /* =========================
       CORS PREFLIGHT
    ========================= */

    if (
      request.method === "OPTIONS"
    ) {

      return new Response(
        null,
        {
          status: 204,
          headers:
            corsHeaders()
        }
      );
    }


    const url =
      new URL(request.url);

    const path =
      url.pathname;


    /* =========================
       HEALTH
    ========================= */

    if (
      path === "/health" &&
      request.method === "GET"
    ) {

      return json({
        success: true,
        service:
          "CreateLK Jobs Admin Login",
        status: "online"
      });
    }


    /* =========================
       ROOT
    ========================= */

    if (
      path === "/" &&
      request.method === "GET"
    ) {

      return json({
        success: true,
        service:
          "CreateLK Jobs Admin Login",
        status: "online"
      });
    }


    /* =========================
       GOOGLE LOGIN
    ========================= */

    if (
      path === "/login" &&
      request.method === "GET"
    ) {

      return startGoogleLogin();
    }


    if (
      path === "/auth/google" &&
      request.method === "GET"
    ) {

      return startGoogleLogin();
    }


    /* =========================
       GOOGLE CALLBACK
    ========================= */

    if (
      path === "/callback" &&
      request.method === "GET"
    ) {

      return handleCallback(
        request,
        env
      );
    }


    /* =========================
       TICKET EXCHANGE
    ========================= */

    if (
      path === "/exchange" &&
      request.method === "POST"
    ) {

      return exchangeTicket(
        request,
        env
      );
    }


    /* =========================
       LOGOUT
    ========================= */

    if (
      path === "/logout" &&
      request.method === "GET"
    ) {

      const token =
        getCookie(
          request,
          "createlk_admin_session"
        );


      if (token && env.DB) {

        await env.DB
          .prepare(`
            DELETE FROM sessions
            WHERE id = ?
          `)
          .bind(token)
          .run();
      }


      return new Response(
        "Logged out.",
        {
          status: 302,
          headers: {
            "Location":
              ADMIN_LOGIN_PAGE,
            "Set-Cookie":
              deleteCookie(
                "createlk_admin_session"
              )
          }
        }
      );
    }


    /* =========================
       NOT FOUND
    ========================= */

    return json({
      success: false,
      error: "Not found."
    }, 404);
  }
};