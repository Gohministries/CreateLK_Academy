const corsHeaders = {
  "Access-Control-Allow-Origin": "https://createlk.com",
  "Access-Control-Allow-Credentials": "true",
  "Access-Control-Allow-Methods": "GET, POST, OPTIONS",
  "Access-Control-Allow-Headers": "Content-Type, Authorization",
  "Access-Control-Max-Age": "86400"
};

function json(data, status = 200) {
  return new Response(
    JSON.stringify(data),
    {
      status,
      headers: {
        ...corsHeaders,
        "Content-Type": "application/json; charset=UTF-8"
      }
    }
  );
}


// ======================================================
// COOKIE PARSER
// ======================================================

function parseCookies(header) {

  const cookies = {};

  String(header || "")
    .split(";")
    .forEach(part => {

      const index = part.indexOf("=");

      if (index === -1) {
        return;
      }

      const key =
        part
          .slice(0, index)
          .trim();

      const value =
        part
          .slice(index + 1)
          .trim();

      if (key) {
        cookies[key] = value;
      }
    });

  return cookies;
}


// ======================================================
// GET LOGGED-IN USER
// ======================================================

async function getUser(request, env) {

  const cookies =
    parseCookies(
      request.headers.get("Cookie") || ""
    );

  const sessionId =
    cookies["createlk_session"];

  if (!sessionId) {
    return null;
  }

  try {

    const user =
      await env.DB.prepare(`
        SELECT
          users.id,
          users.google_id,
          users.name,
          users.email,
          users.photo_url,
          users.email_verified,
          sessions.id AS session_id,
          sessions.expires_at
        FROM sessions
        INNER JOIN users
          ON users.id = sessions.user_id
        WHERE sessions.id = ?
        LIMIT 1
      `)
      .bind(sessionId)
      .first();

    if (!user) {
      return null;
    }

    const now =
      Math.floor(
        Date.now() / 1000
      );

    if (
      Number(user.expires_at) <= now
    ) {

      await env.DB.prepare(`
        DELETE FROM sessions
        WHERE id = ?
      `)
      .bind(sessionId)
      .run();

      return null;
    }

    return user;

  } catch (error) {

    console.error(
      "Authentication error:",
      error
    );

    return null;
  }
}


// ======================================================
// FILE NAME
// ======================================================

function safeFilename(name) {

  return String(
    name || "file"
  )
    .replace(
      /[^a-zA-Z0-9._-]/g,
      "_"
    )
    .replace(
      /_+/g,
      "_"
    )
    .slice(0, 150);
}


// ======================================================
// FILE EXTENSION
// ======================================================

function extensionFromType(type) {

  const map = {
    "image/jpeg": "jpg",
    "image/png": "png",
    "image/webp": "webp",
    "application/pdf": "pdf"
  };

  return map[type] || "bin";
}


// ======================================================
// ALLOWED FILE TYPES
// ======================================================

function allowedType(type, folder) {

  const images = [
    "image/jpeg",
    "image/png",
    "image/webp"
  ];

  if (folder === "ads") {
    return images.includes(type);
  }

  if (folder === "payments") {

    return [
      "image/jpeg",
      "image/png",
      "image/webp",
      "application/pdf"
    ].includes(type);
  }

  return false;
}


// ======================================================
// MAIN
// ======================================================

export default {

  async fetch(request, env) {

    // --------------------------------------------------
    // OPTIONS / CORS
    // --------------------------------------------------

    if (
      request.method === "OPTIONS"
    ) {

      return new Response(
        null,
        {
          status: 204,
          headers: corsHeaders
        }
      );
    }


    const url =
      new URL(request.url);


    // ==================================================
    // HOME
    // ==================================================

    if (
      request.method === "GET" &&
      url.pathname === "/"
    ) {

      return json({
        success: true,
        worker:
          "CreateLK Jobs Upload Worker",
        status: "online"
      });
    }


    // ==================================================
    // HEALTH
    // ==================================================

    if (
      request.method === "GET" &&
      url.pathname === "/health"
    ) {

      let db = false;
      let r2 = false;

      try {

        await env.DB
          .prepare("SELECT 1")
          .first();

        db = true;

      } catch (error) {

        db = false;
      }


      try {

        const key =
          "health/" +
          crypto.randomUUID() +
          ".txt";

        await env.JOBS_BUCKET.put(
          key,
          "CreateLK Jobs Upload Worker"
        );

        await env.JOBS_BUCKET.delete(
          key
        );

        r2 = true;

      } catch (error) {

        r2 = false;
      }


      return json({
        success: true,
        worker: "upload",
        db,
        r2
      });
    }


    // ==================================================
    // R2 TEST
    // ==================================================

    if (
      request.method === "GET" &&
      url.pathname === "/test-r2"
    ) {

      try {

        const key =
          "test/" +
          crypto.randomUUID() +
          ".txt";

        await env.JOBS_BUCKET.put(
          key,
          "CreateLK Jobs R2 test"
        );

        return json({
          success: true,
          message: "R2 is working",
          key
        });

      } catch (error) {

        return json({
          success: false,
          error:
            error?.message ||
            "R2 test failed."
        }, 500);
      }
    }


    // ==================================================
    // AUTH TEST
    // ==================================================

    if (
      request.method === "GET" &&
      url.pathname === "/auth-test"
    ) {

      const user =
        await getUser(
          request,
          env
        );

      if (!user) {

        return json({
          success: false,
          loggedIn: false,
          error:
            "createlk_session cookie was not accepted."
        }, 401);
      }


      return json({
        success: true,
        loggedIn: true,
        user: {
          id: user.id,
          name: user.name,
          email: user.email
        }
      });
    }


    // ==================================================
    // UPLOAD
    // ==================================================

    if (
      request.method === "POST" &&
      url.pathname === "/upload"
    ) {

      // ----------------------------------------------
      // CHECK LOGIN
      // ----------------------------------------------

      const user =
        await getUser(
          request,
          env
        );

      if (!user) {

        return json({
          success: false,
          error: "Unauthorized."
        }, 401);
      }


      try {

        // --------------------------------------------
        // FORM DATA
        // --------------------------------------------

        const form =
          await request.formData();

        const file =
          form.get("file");

        const folder =
          String(
            form.get("folder") || ""
          )
            .trim()
            .toLowerCase();


        // --------------------------------------------
        // FOLDER CHECK
        // --------------------------------------------

        if (
          folder !== "ads" &&
          folder !== "payments"
        ) {

          return json({
            success: false,
            error:
              "Invalid upload folder."
          }, 400);
        }


        // --------------------------------------------
        // FILE CHECK
        // --------------------------------------------

        if (
          !file ||
          typeof file !== "object" ||
          typeof file.arrayBuffer !==
            "function"
        ) {

          return json({
            success: false,
            error:
              "No file was provided."
          }, 400);
        }


        // --------------------------------------------
        // SIZE CHECK
        // --------------------------------------------

        const MAX_SIZE =
          5 * 1024 * 1024;

        if (
          file.size > MAX_SIZE
        ) {

          return json({
            success: false,
            error:
              "File size cannot exceed 5 MB."
          }, 400);
        }


        if (
          file.size <= 0
        ) {

          return json({
            success: false,
            error:
              "The uploaded file is empty."
          }, 400);
        }


        // --------------------------------------------
        // TYPE CHECK
        // --------------------------------------------

        const contentType =
          String(
            file.type || ""
          )
            .toLowerCase();


        if (
          !allowedType(
            contentType,
            folder
          )
        ) {

          return json({
            success: false,
            error:
              folder === "ads"
                ? "Ads accept JPG, PNG or WebP files only."
                : "Payment slips accept JPG, PNG, WebP or PDF files only."
          }, 400);
        }


        // --------------------------------------------
        // USER ID
        // --------------------------------------------

        const userId =
          user.id;


        // --------------------------------------------
        // FILE NAME
        // --------------------------------------------

        const originalName =
          safeFilename(
            file.name ||
            "upload"
          );


        // --------------------------------------------
        // EXTENSION
        // --------------------------------------------

        const extension =
          extensionFromType(
            contentType
          );


        // --------------------------------------------
        // R2 KEY
        // --------------------------------------------

        const key =
          folder +
          "/" +
          String(userId) +
          "/" +
          Date.now() +
          "-" +
          crypto.randomUUID() +
          "-" +
          originalName.replace(
            /\.[^.]+$/,
            ""
          ) +
          "." +
          extension;


        // --------------------------------------------
        // FILE DATA
        // --------------------------------------------

        const body =
          await file.arrayBuffer();


        // --------------------------------------------
        // R2 UPLOAD
        // --------------------------------------------

        await env.JOBS_BUCKET.put(
          key,
          body,
          {
            httpMetadata: {
              contentType
            },

            customMetadata: {

              user_id:
                String(userId),

              original_name:
                originalName,

              folder,

              uploaded_at:
                new Date().toISOString()
            }
          }
        );


        // --------------------------------------------
        // SUCCESS
        // --------------------------------------------

        return json({
          success: true,
          key,
          filename:
            originalName,
          content_type:
            contentType,
          size:
            file.size,
          folder,
          user_id:
            userId
        });


      } catch (error) {

        console.error(
          "Upload error:",
          error
        );

        return json({
          success: false,
          error:
            error?.message ||
            "Upload failed."
        }, 500);
      }
    }


    // ==================================================
    // NOT FOUND
    // ==================================================

    return json({
      success: false,
      error: "Not Found"
    }, 404);
  }
};