const API = "https://itpro.lk/api/v1/jobs";

export default {
  async fetch(request) {
    const url = new URL(request.url);

    if (url.pathname === "/api/external-jobs") {
      try {
        const res = await fetch(API, {
          headers: {
            "Accept": "application/json"
          }
        });

        if (!res.ok) {
          return Response.json(
            { success: false, error: "Job API unavailable" },
            { status: 502 }
          );
        }

        const data = await res.json();

        const jobs = Array.isArray(data) ? data.map(job => ({
          id: String(job.id || ""),
          title: job.title || "",
          company: job.company || "",
          location: job.location || "",
          description: job.description || "",
          website: job.website || "",
          created_on: job.created_on || "",
          source: "ITPro.lk",
          source_url: `https://itpro.lk/job/${job.id}`
        })) : [];

        return Response.json(
          {
            success: true,
            source: "ITPro.lk",
            count: jobs.length,
            jobs
          },
          {
            headers: {
              "Cache-Control": "public, max-age=300"
            }
          }
        );
      } catch (e) {
        return Response.json(
          {
            success: false,
            error: "Unable to load external jobs"
          },
          { status: 500 }
        );
      }
    }

    return new Response("CreateLK External Jobs API");
  }
};