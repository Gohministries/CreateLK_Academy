const ADMIN_PASSWORD = "CHANGE_THIS_GOV_PASSWORD_2026";

const CORS_HEADERS = {
  "Access-Control-Allow-Origin": "*",
  "Access-Control-Allow-Methods": "GET,POST,PUT,DELETE,OPTIONS",
  "Access-Control-Allow-Headers": "Content-Type, Authorization"
};

function json(data, status = 200) {
  return new Response(JSON.stringify(data), {
    status,
    headers: {
      "Content-Type": "application/json; charset=utf-8",
      ...CORS_HEADERS
    }
  });
}

function today() {
  return new Date().toISOString().slice(0, 10);
}

function clean(value) {
  if (value === undefined || value === null) {
    return "";
  }

  return String(value).trim();
}

function getPassword(request) {
  const auth = request.headers.get("Authorization") || "";

  if (!auth.startsWith("Bearer ")) {
    return "";
  }

  return auth.slice(7);
}

function authorized(request) {
  return getPassword(request) === ADMIN_PASSWORD;
}

function validStatus(status) {
  return [
    "active",
    "expired",
    "deleted"
  ].includes(status);
}

export default {
  async fetch(request, env) {
    const url = new URL(request.url);

    if (request.method === "OPTIONS") {
      return new Response(null, {
        status: 204,
        headers: CORS_HEADERS
      });
    }

    try {

      // --------------------------------------------------
      // HEALTH CHECK
      // --------------------------------------------------

      if (
        request.method === "GET" &&
        url.pathname === "/"
      ) {
        return json({
          success: true,
          service: "CreateLK Government Jobs API",
          worker: "gov",
          database: "lkjobs",
          date: today()
        });
      }


      // --------------------------------------------------
      // PUBLIC JOB LIST
      // --------------------------------------------------

      if (
        request.method === "GET" &&
        url.pathname === "/jobs"
      ) {

        const search = clean(
          url.searchParams.get("search")
        );

        const district = clean(
          url.searchParams.get("district")
        );

        const province = clean(
          url.searchParams.get("province")
        );

        let sql = `
          SELECT
            id,
            title,
            institution,
            description,
            district,
            province,
            closing_date,
            gazette_number,
            gazette_date,
            language,
            official_url,
            source_url,
            image_url,
            created_at
          FROM government_jobs
          WHERE status = 'active'
          AND closing_date >= ?
        `;

        const params = [today()];


        // SEARCH
        if (search) {

          sql += `
            AND (
              title LIKE ?
              OR institution LIKE ?
              OR description LIKE ?
              OR gazette_number LIKE ?
            )
          `;

          const s = `%${search}%`;

          params.push(
            s,
            s,
            s,
            s
          );
        }


        // DISTRICT
        if (
          district &&
          district !== "All Sri Lanka"
        ) {

          sql += `
            AND (
              district = ?
              OR district = 'All Sri Lanka'
            )
          `;

          params.push(district);
        }


        // PROVINCE
        if (
          province &&
          province !== "All Sri Lanka"
        ) {

          sql += `
            AND (
              province = ?
              OR province = 'All Sri Lanka'
            )
          `;

          params.push(province);
        }


        sql += `
          ORDER BY closing_date ASC, id DESC
        `;


        const result = await env.DB
          .prepare(sql)
          .bind(...params)
          .all();


        return json({
          success: true,
          count: result.results.length,
          jobs: result.results
        });
      }


      // --------------------------------------------------
      // PUBLIC SINGLE JOB
      // --------------------------------------------------

      if (
        request.method === "GET" &&
        /^\/jobs\/[0-9]+$/.test(url.pathname)
      ) {

        const id =
          url.pathname.split("/")[2];


        const job = await env.DB
          .prepare(`
            SELECT *
            FROM government_jobs
            WHERE id = ?
            AND status = 'active'
            AND closing_date >= ?
          `)
          .bind(
            id,
            today()
          )
          .first();


        if (!job) {

          return json({
            success: false,
            message:
              "Government job not found or expired"
          }, 404);

        }


        return json({
          success: true,
          job
        });
      }


      // --------------------------------------------------
      // ADMIN LIST
      // --------------------------------------------------

      if (
        request.method === "GET" &&
        url.pathname === "/admin/jobs"
      ) {

        if (!authorized(request)) {

          return json({
            success: false,
            message: "Unauthorized"
          }, 401);

        }


        const result = await env.DB
          .prepare(`
            SELECT *
            FROM government_jobs
            ORDER BY id DESC
          `)
          .all();


        return json({
          success: true,
          jobs: result.results
        });
      }


      // --------------------------------------------------
      // ADMIN ADD JOB
      // --------------------------------------------------

      if (
        request.method === "POST" &&
        url.pathname === "/admin/jobs"
      ) {

        if (!authorized(request)) {

          return json({
            success: false,
            message: "Unauthorized"
          }, 401);

        }


        const body =
          await request.json();


        const title =
          clean(body.title);

        const institution =
          clean(body.institution);

        const closingDate =
          clean(body.closing_date);

        const officialUrl =
          clean(body.official_url);

        const sourceUrl =
          clean(body.source_url);


        if (!title) {

          return json({
            success: false,
            message: "Job title is required"
          }, 400);

        }


        if (!institution) {

          return json({
            success: false,
            message: "Institution is required"
          }, 400);

        }


        if (!closingDate) {

          return json({
            success: false,
            message: "Closing date is required"
          }, 400);

        }


        if (!officialUrl) {

          return json({
            success: false,
            message:
              "Official application URL is required"
          }, 400);

        }


        if (!sourceUrl) {

          return json({
            success: false,
            message:
              "Official source URL is required"
          }, 400);

        }


        const result = await env.DB
          .prepare(`
            INSERT INTO government_jobs (
              title,
              institution,
              description,
              district,
              province,
              closing_date,
              gazette_number,
              gazette_date,
              language,
              official_url,
              source_url,
              image_url,
              status
            )
            VALUES (
              ?,
              ?,
              ?,
              ?,
              ?,
              ?,
              ?,
              ?,
              ?,
              ?,
              ?,
              ?,
              'active'
            )
          `)
          .bind(
            title,
            institution,
            clean(body.description),
            clean(
              body.district ||
              "All Sri Lanka"
            ),
            clean(
              body.province ||
              "All Sri Lanka"
            ),
            closingDate,
            clean(body.gazette_number),
            clean(body.gazette_date),
            clean(
              body.language ||
              "English"
            ),
            officialUrl,
            sourceUrl,
            clean(body.image_url)
          )
          .run();


        return json({
          success: true,
          id: result.meta.last_row_id
        }, 201);
      }


      // --------------------------------------------------
      // ADMIN UPDATE JOB
      // --------------------------------------------------

      if (
        request.method === "PUT" &&
        /^\/admin\/jobs\/[0-9]+$/.test(
          url.pathname
        )
      ) {

        if (!authorized(request)) {

          return json({
            success: false,
            message: "Unauthorized"
          }, 401);

        }


        const id =
          url.pathname.split("/")[3];


        const body =
          await request.json();


        const existing =
          await env.DB
            .prepare(`
              SELECT *
              FROM government_jobs
              WHERE id = ?
            `)
            .bind(id)
            .first();


        if (!existing) {

          return json({
            success: false,
            message: "Job not found"
          }, 404);

        }


        const title =
          clean(
            body.title ||
            existing.title
          );


        const institution =
          clean(
            body.institution ||
            existing.institution
          );


        const description =
          body.description !== undefined
            ? clean(body.description)
            : existing.description;


        const district =
          body.district !== undefined
            ? clean(body.district)
            : existing.district;


        const province =
          body.province !== undefined
            ? clean(body.province)
            : existing.province;


        const closingDate =
          clean(
            body.closing_date ||
            existing.closing_date
          );


        const gazetteNumber =
          body.gazette_number !== undefined
            ? clean(body.gazette_number)
            : existing.gazette_number;


        const gazetteDate =
          body.gazette_date !== undefined
            ? clean(body.gazette_date)
            : existing.gazette_date;


        const language =
          body.language !== undefined
            ? clean(body.language)
            : existing.language;


        const officialUrl =
          clean(
            body.official_url ||
            existing.official_url
          );


        const sourceUrl =
          clean(
            body.source_url ||
            existing.source_url
          );


        const imageUrl =
          body.image_url !== undefined
            ? clean(body.image_url)
            : existing.image_url;


        const status =
          body.status !== undefined
            ? clean(body.status)
            : existing.status;


        if (!validStatus(status)) {

          return json({
            success: false,
            message: "Invalid status"
          }, 400);

        }


        await env.DB
          .prepare(`
            UPDATE government_jobs
            SET
              title = ?,
              institution = ?,
              description = ?,
              district = ?,
              province = ?,
              closing_date = ?,
              gazette_number = ?,
              gazette_date = ?,
              language = ?,
              official_url = ?,
              source_url = ?,
              image_url = ?,
              status = ?,
              updated_at = CURRENT_TIMESTAMP
            WHERE id = ?
          `)
          .bind(
            title,
            institution,
            description,
            district,
            province,
            closingDate,
            gazetteNumber,
            gazetteDate,
            language,
            officialUrl,
            sourceUrl,
            imageUrl,
            status,
            id
          )
          .run();


        return json({
          success: true
        });
      }


      // --------------------------------------------------
      // ADMIN DELETE
      // --------------------------------------------------

      if (
        request.method === "DELETE" &&
        /^\/admin\/jobs\/[0-9]+$/.test(
          url.pathname
        )
      ) {

        if (!authorized(request)) {

          return json({
            success: false,
            message: "Unauthorized"
          }, 401);

        }


        const id =
          url.pathname.split("/")[3];


        await env.DB
          .prepare(`
            UPDATE government_jobs
            SET
              status = 'deleted',
              updated_at = CURRENT_TIMESTAMP
            WHERE id = ?
          `)
          .bind(id)
          .run();


        return json({
          success: true
        });
      }


      // --------------------------------------------------
      // NOT FOUND
      // --------------------------------------------------

      return json({
        success: false,
        message: "Endpoint not found"
      }, 404);


    } catch (error) {

      return json({
        success: false,
        message: "Server error",
        error: error.message
      }, 500);

    }
  }
};