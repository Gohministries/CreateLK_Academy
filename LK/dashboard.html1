<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">

<title>CreateLK Jobs Dashboard</title>

<meta name="description"
      content="CreateLK Jobs user dashboard">

<style>
*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

body{
  font-family:Arial,Helvetica,sans-serif;
  background:#f5f7fb;
  color:#172033;
  min-height:100vh;
}

header{
  background:#0b1f3a;
  color:white;
  padding:14px 20px;
  box-shadow:0 2px 10px rgba(0,0,0,.12);
}

.header-inner{
  max-width:1200px;
  margin:auto;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:15px;
}

.brand{
  display:flex;
  align-items:center;
  gap:10px;
  text-decoration:none;
  color:white;
  font-weight:700;
  font-size:20px;
}

.brand img{
  width:42px;
  height:42px;
  object-fit:contain;
  border-radius:8px;
  background:white;
}

.logout{
  border:1px solid rgba(255,255,255,.4);
  background:transparent;
  color:white;
  padding:9px 16px;
  border-radius:7px;
  cursor:pointer;
  font-weight:600;
}

.logout:hover{
  background:rgba(255,255,255,.1);
}

main{
  max-width:1200px;
  margin:0 auto;
  padding:30px 20px 50px;
}

.welcome{
  margin-bottom:25px;
}

.welcome h1{
  font-size:30px;
  margin-bottom:7px;
}

.welcome p{
  color:#667085;
}

.profile-card{
  background:white;
  border-radius:14px;
  padding:25px;
  display:flex;
  align-items:center;
  gap:20px;
  box-shadow:0 3px 15px rgba(0,0,0,.06);
  margin-bottom:25px;
}

.profile-photo{
  width:75px;
  height:75px;
  border-radius:50%;
  object-fit:cover;
  background:#e8edf5;
}

.profile-info h2{
  font-size:21px;
  margin-bottom:5px;
}

.profile-info p{
  color:#667085;
  margin:3px 0;
}

.grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:20px;
}

.card{
  background:white;
  padding:25px;
  border-radius:14px;
  box-shadow:0 3px 15px rgba(0,0,0,.06);
}

.card h3{
  margin-bottom:10px;
}

.card p{
  color:#667085;
  line-height:1.5;
  margin-bottom:18px;
}

.btn{
  display:inline-block;
  text-decoration:none;
  background:#0b1f3a;
  color:white;
  padding:11px 17px;
  border-radius:7px;
  font-weight:600;
}

.btn.gold{
  background:#d4a72c;
  color:#111;
}

.status{
  position:fixed;
  inset:0;
  display:flex;
  align-items:center;
  justify-content:center;
  background:#f5f7fb;
  z-index:100;
}

.status-box{
  background:white;
  width:min(420px,90%);
  padding:30px;
  text-align:center;
  border-radius:14px;
  box-shadow:0 5px 25px rgba(0,0,0,.1);
}

.status-box h2{
  margin-bottom:10px;
}

.status-box p{
  color:#667085;
  line-height:1.5;
}

.error{
  color:#b42318;
}

.hidden{
  display:none !important;
}

@media(max-width:800px){
  .grid{
    grid-template-columns:1fr;
  }

  .profile-card{
    align-items:flex-start;
  }

  .welcome h1{
    font-size:25px;
  }
}

@media(max-width:500px){
  header{
    padding:12px 15px;
  }

  main{
    padding:25px 15px 40px;
  }

  .brand span{
    font-size:17px;
  }

  .profile-card{
    padding:20px;
  }

  .profile-photo{
    width:60px;
    height:60px;
  }
}
</style>
</head>

<body>

<div id="loading" class="status">
  <div class="status-box">
    <h2>Loading...</h2>
    <p>Checking your CreateLK Jobs account.</p>
  </div>
</div>

<div id="errorScreen" class="status hidden">
  <div class="status-box">
    <h2>Session Required</h2>
    <p id="errorMessage">
      Please sign in to your CreateLK Jobs account to continue.
    </p>

    <br>

    <a
      class="btn"
      href="https://createlk.com/LK/login.html">
      Sign In
    </a>
  </div>
</div>

<div id="app" class="hidden">

<header>
  <div class="header-inner">

    <a class="brand" href="https://createlk.com/">
      <img
        src="https://assets.createlk.com/file_00000000f05482118c11cccfc653fd0f.png"
        alt="CreateLK Jobs">

      <span>CreateLK Jobs</span>
    </a>

    <button
      id="logoutBtn"
      class="logout"
      type="button">
      Logout
    </button>

  </div>
</header>

<main>

  <section class="welcome">
    <h1 id="welcomeTitle">
      Welcome
    </h1>

    <p>
      Manage your jobs, applications and profile.
    </p>
  </section>

  <section class="profile-card">

    <img
      id="profilePhoto"
      class="profile-photo"
      src=""
      alt="Profile photo">

    <div class="profile-info">

      <h2 id="profileName">
        User
      </h2>

      <p id="profileEmail">
        -
      </p>

      <p id="profileVerified">
        Account
      </p>

    </div>

  </section>

  <section class="grid">

    <div class="card">
      <h3>Find Jobs</h3>

      <p>
        Browse available jobs and find your next opportunity.
      </p>

      <a
        class="btn"
        href="/LK/jobs.html">
        Find Jobs
      </a>
    </div>

    <div class="card">
      <h3>Post a Job</h3>

      <p>
        Publish your job and connect with suitable candidates.
      </p>

      <a
        class="btn gold"
        href="/LK/post-job.html">
        Post a Job
      </a>
    </div>

    <div class="card">
      <h3>My Jobs</h3>

      <p>
        View and manage jobs you have posted.
      </p>

      <a
        class="btn"
        href="/LK/my-jobs.html">
        My Jobs
      </a>
    </div>

    <div class="card">
      <h3>Applications</h3>

      <p>
        View and manage your job applications.
      </p>

      <a
        class="btn"
        href="/LK/applications.html">
        Applications
      </a>
    </div>

    <div class="card">
      <h3>Profile</h3>

      <p>
        Update your account and profile information.
      </p>

      <a
        class="btn"
        href="/LK/profile.html">
        My Profile
      </a>
    </div>

    <div class="card">
      <h3>Account</h3>

      <p>
        Your CreateLK Jobs account is connected with Google.
      </p>

      <span
        id="accountStatus"
        class="btn">
        Active
      </span>
    </div>

  </section>

</main>

</div>

<script>

const LOGIN_API =
  "https://login.createlk.workers.dev";

const LOGIN_PAGE =
  "https://createlk.com/LK/login.html";

const TOKEN_KEY =
  "createlk_session_token";

const CUSTOMER_KEY =
  "createlk_customer";


/* -----------------------------
   ELEMENTS
----------------------------- */

const loading =
  document.getElementById("loading");

const errorScreen =
  document.getElementById("errorScreen");

const errorMessage =
  document.getElementById("errorMessage");

const app =
  document.getElementById("app");

const welcomeTitle =
  document.getElementById("welcomeTitle");

const profileName =
  document.getElementById("profileName");

const profileEmail =
  document.getElementById("profileEmail");

const profilePhoto =
  document.getElementById("profilePhoto");

const profileVerified =
  document.getElementById("profileVerified");

const accountStatus =
  document.getElementById("accountStatus");

const logoutBtn =
  document.getElementById("logoutBtn");


/* -----------------------------
   SHOW ERROR
----------------------------- */

function showError(message){

  loading.classList.add("hidden");

  app.classList.add("hidden");

  errorMessage.textContent =
    message ||
    "Please sign in to continue.";

  errorScreen.classList.remove("hidden");
}


/* -----------------------------
   SHOW APP
----------------------------- */

function showApp(){

  loading.classList.add("hidden");

  errorScreen.classList.add("hidden");

  app.classList.remove("hidden");
}


/* -----------------------------
   SAVE USER
----------------------------- */

function saveUser(user){

  try{

    sessionStorage.setItem(
      CUSTOMER_KEY,
      JSON.stringify(user)
    );

  }catch(e){

    console.error(
      "Could not save user",
      e
    );

  }

}


/* -----------------------------
   GET TOKEN
----------------------------- */

function getToken(){

  return sessionStorage.getItem(
    TOKEN_KEY
  );

}


/* -----------------------------
   EXCHANGE TICKET
----------------------------- */

async function exchangeTicket(ticket){

  const response =
    await fetch(
      LOGIN_API +
      "/exchange?ticket=" +
      encodeURIComponent(ticket),
      {
        method:"GET",
        cache:"no-store"
      }
    );

  let data;

  try{

    data =
      await response.json();

  }catch(e){

    throw new Error(
      "Invalid server response."
    );

  }

  if(
    !response.ok ||
    !data.success ||
    !data.token
  ){

    throw new Error(
      data.error ||
      "Login session could not be created."
    );

  }

  sessionStorage.setItem(
    TOKEN_KEY,
    data.token
  );

  if(data.user){

    saveUser(data.user);

  }

  return data;

}


/* -----------------------------
   GET CURRENT USER
----------------------------- */

async function getMe(token){

  const response =
    await fetch(
      LOGIN_API + "/me",
      {
        method:"GET",
        headers:{
          "Authorization":
            "Bearer " + token
        },
        cache:"no-store"
      }
    );

  let data;

  try{

    data =
      await response.json();

  }catch(e){

    throw new Error(
      "Invalid session response."
    );

  }

  if(
    response.status === 401 ||
    !response.ok ||
    !data.success
  ){

    throw new Error(
      data.error ||
      "Your session has expired."
    );

  }

  return data;

}


/* -----------------------------
   DISPLAY USER
----------------------------- */

function displayUser(user){

  const name =
    user.name ||
    "CreateLK Jobs User";

  const email =
    user.email ||
    "";

  profileName.textContent =
    name;

  profileEmail.textContent =
    email;

  welcomeTitle.textContent =
    "Welcome, " + name;

  if(user.photo_url){

    profilePhoto.src =
      user.photo_url;

  }else{

    profilePhoto.removeAttribute(
      "src"
    );

    profilePhoto.alt =
      name;

  }

  if(
    user.email_verified === true ||
    user.email_verified === 1
  ){

    profileVerified.textContent =
      "✓ Google account verified";

  }else{

    profileVerified.textContent =
      "Google account";

  }

  accountStatus.textContent =
    "Active";

}


/* -----------------------------
   REMOVE TICKET FROM URL
----------------------------- */

function removeTicketFromURL(){

  const cleanURL =
    window.location.origin +
    window.location.pathname;

  window.history.replaceState(
    {},
    document.title,
    cleanURL
  );

}


/* -----------------------------
   LOGOUT
----------------------------- */

async function logout(){

  const token =
    getToken();

  logoutBtn.disabled =
    true;

  logoutBtn.textContent =
    "Logging out...";

  try{

    if(token){

      await fetch(
        LOGIN_API + "/logout",
        {
          method:"GET",
          headers:{
            "Authorization":
              "Bearer " + token
          },
          cache:"no-store"
        }
      );

    }

  }catch(e){

    console.error(
      "Logout request failed",
      e
    );

  }

  sessionStorage.removeItem(
    TOKEN_KEY
  );

  sessionStorage.removeItem(
    CUSTOMER_KEY
  );

  window.location.replace(
    LOGIN_PAGE
  );

}


/* -----------------------------
   LOGOUT BUTTON
----------------------------- */

logoutBtn.addEventListener(
  "click",
  logout
);


/* -----------------------------
   START
----------------------------- */

async function start(){

  try{

    /*
      First check whether Google
      redirected here with a ticket.
    */

    const params =
      new URLSearchParams(
        window.location.search
      );

    const ticket =
      params.get("ticket");

    let token =
      getToken();


    /*
      New Google login:
      exchange one-time ticket
      for normal session token.
    */

    if(ticket){

      const result =
        await exchangeTicket(
          ticket
        );

      token =
        result.token;

      removeTicketFromURL();

    }


    /*
      No token means the user
      is not logged in.
    */

    if(!token){

      showError(
        "Please sign in to your CreateLK Jobs account to continue."
      );

      return;

    }


    /*
      Verify the token with
      the login Worker.
    */

    const result =
      await getMe(token);


    /*
      Save latest user information.
    */

    if(result.user){

      saveUser(
        result.user
      );

      displayUser(
        result.user
      );

    }else{

      throw new Error(
        "User information is missing."
      );

    }


    /*
      Show dashboard.
    */

    showApp();

  }catch(error){

    console.error(
      "Dashboard error:",
      error
    );

    sessionStorage.removeItem(
      TOKEN_KEY
    );

    sessionStorage.removeItem(
      CUSTOMER_KEY
    );

    showError(
      error.message ||
      "Your login session could not be verified."
    );

  }

}


/* -----------------------------
   START DASHBOARD
----------------------------- */

start();

</script>

</body>
</html>