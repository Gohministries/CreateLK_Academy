<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">

<title>Post an Ad | CreateLK Jobs</title>

<meta name="description"
content="Post your job advertisement on CreateLK Jobs and reach job seekers across Sri Lanka.">

<style>
*{box-sizing:border-box;margin:0;padding:0}

body{
font-family:Arial,sans-serif;
background:#f5f7fb;
color:#1f2937;
}

header{
background:#fff;
border-bottom:1px solid #e5e7eb;
position:sticky;
top:0;
z-index:10;
}

.nav{
max-width:1200px;
margin:auto;
padding:14px 20px;
display:flex;
align-items:center;
justify-content:space-between;
gap:20px;
}

.logo{
display:flex;
align-items:center;
gap:9px;
text-decoration:none;
color:#111827;
font-size:20px;
font-weight:800;
}

.logo img{
width:42px;
height:42px;
object-fit:contain;
}

.navlinks{
display:flex;
flex-wrap:wrap;
gap:18px;
}

.navlinks a{
color:#374151;
text-decoration:none;
font-size:14px;
font-weight:600;
}

.navlinks a:hover{
color:#2563eb;
}

.container{
max-width:850px;
margin:35px auto;
padding:0 18px 50px;
}

.card{
background:#fff;
border-radius:16px;
padding:28px;
box-shadow:0 5px 25px rgba(0,0,0,.06);
}

h1{
font-size:30px;
margin-bottom:8px;
color:#111827;
}

.subtitle{
color:#6b7280;
margin-bottom:25px;
}

label{
display:block;
margin:17px 0 7px;
font-weight:700;
font-size:14px;
}

input,
textarea,
select{
width:100%;
padding:12px 13px;
border:1px solid #d1d5db;
border-radius:9px;
font-size:15px;
outline:none;
background:#fff;
}

input:focus,
textarea:focus,
select:focus{
border-color:#2563eb;
}

textarea{
min-height:130px;
resize:vertical;
}

.row{
display:grid;
grid-template-columns:1fr 1fr;
gap:15px;
}

small{
display:block;
color:#6b7280;
margin-top:5px;
}

.price-box{
margin-top:20px;
padding:16px;
background:#f8fafc;
border:1px solid #e5e7eb;
border-radius:10px;
}

.price{
font-size:20px;
font-weight:800;
color:#2563eb;
margin-top:4px;
}

.upload-box{
margin-top:8px;
padding:15px;
border:1px dashed #cbd5e1;
border-radius:10px;
background:#f8fafc;
}

.bank-box{
display:none;
margin-top:20px;
padding:18px;
background:#fffdf5;
border:1px solid #e5c75a;
border-radius:12px;
}

.bank-box.show{
display:block;
}

.bank-title{
font-size:18px;
font-weight:800;
margin-bottom:5px;
color:#111827;
}

.bank-note{
font-size:13px;
color:#6b7280;
margin-bottom:14px;
}

.bank-row{
display:flex;
align-items:center;
justify-content:space-between;
gap:12px;
padding:11px 0;
border-bottom:1px solid #eadfb5;
}

.bank-row:last-child{
border-bottom:0;
}

.bank-label{
font-size:12px;
color:#6b7280;
margin-bottom:3px;
}

.bank-value{
font-size:15px;
font-weight:800;
color:#111827;
word-break:break-word;
}

.copy-btn{
width:auto;
margin:0;
padding:7px 12px;
border-radius:7px;
background:#111827;
font-size:12px;
font-weight:700;
}

.copy-btn:hover{
background:#000;
}

button{
width:100%;
border:0;
border-radius:10px;
padding:14px;
margin-top:25px;
background:#2563eb;
color:#fff;
font-size:16px;
font-weight:800;
cursor:pointer;
}

button:hover{
background:#1d4ed8;
}

button:disabled{
opacity:.6;
cursor:not-allowed;
}

.message{
display:none;
margin-top:18px;
padding:13px;
border-radius:9px;
font-size:14px;
white-space:pre-wrap;
word-break:break-word;
}

.success{
display:block;
background:#ecfdf5;
color:#047857;
border:1px solid #a7f3d0;
}

.error{
display:block;
background:#fef2f2;
color:#b91c1c;
border:1px solid #fecaca;
}

.loading{
display:none;
margin-top:15px;
text-align:center;
color:#2563eb;
font-weight:700;
}

@media(max-width:700px){

.nav{
flex-direction:column;
align-items:flex-start;
}

.navlinks{
gap:12px;
}

.row{
grid-template-columns:1fr;
}

.card{
padding:20px;
}

h1{
font-size:25px;
}

.bank-row{
align-items:flex-start;
}

.copy-btn{
flex-shrink:0;
}

}
</style>
</head>

<body>

<header>
<div class="nav">

<a class="logo" href="https://createlk.com/">
<img
src="https://assets.createlk.com/file_00000000f05482118c11cccfc653fd0f.png"
alt="CreateLK Jobs">
<span>CreateLK Jobs</span>
</a>

<nav class="navlinks">
<a href="https://createlk.com/">Home</a>
<a href="https://createlk.com/LK/jobs.html">Find Jobs</a>
<a href="https://createlk.com/LK/categories.html">Categories</a>
<a href="https://createlk.com/LK/companies.html">Companies</a>
<a href="https://createlk.com/LK/login.html">Login</a>
</nav>

</div>
</header>

<main class="container">

<div class="card">

<h1>Post an Ad</h1>

<p class="subtitle">
Post your job advertisement and reach job seekers across Sri Lanka.
</p>

<form id="adForm">

<label for="title">Job Title</label>
<input
id="title"
type="text"
placeholder="Example: Bank Assistant"
required>

<label for="description">Job Description</label>
<textarea
id="description"
placeholder="Describe the job, requirements and responsibilities..."
required></textarea>

<div class="row">

<div>
<label for="whatsapp">WhatsApp Number</label>
<input
id="whatsapp"
type="tel"
placeholder="07XXXXXXXX"
required>
</div>

<div>
<label for="call">Call Number</label>
<input
id="call"
type="tel"
placeholder="07XXXXXXXX"
required>
</div>

</div>

<label for="province">Province</label>
<select id="province" required>
<option value="">Select Province</option>
</select>

<label for="district">District</label>
<select id="district" required disabled>
<option value="">Select District</option>
</select>

<label for="city">City / Area</label>
<select id="city" required disabled>
<option value="">Select City / Area</option>
</select>

<label for="category">Job Category</label>
<select id="category" required>
<option value="">Loading categories...</option>
</select>

<label for="adType">Advertisement Type</label>

<select id="adType" required>

<option value="free">
Free — Rs. 0 — 30 days
</option>

<option value="featured">
Featured — Rs. 500 — 30 days
</option>

<option value="urgent">
Urgent — Rs. 500 — 30 days
</option>

<option value="top">
Top — Rs. 500 — 30 days
</option>

<option value="featured_urgent_top">
Featured + Urgent + Top — Rs. 1,500 — 30 days
</option>

</select>

<div class="price-box">

<div>Advertisement Price</div>

<div class="price" id="price">
Rs. 0
</div>

</div>

<!-- BANK DETAILS -->

<div id="bankBox" class="bank-box">

<div class="bank-title">
Bank Deposit Details
</div>

<div class="bank-note">
Please deposit the exact advertisement amount to the account below.
</div>

<div class="bank-row">

<div>
<div class="bank-label">
Account No.
</div>

<div class="bank-value">
292200280023178
</div>
</div>

<button
type="button"
class="copy-btn"
onclick="copyText('292200280023178',this)">
Copy
</button>

</div>

<div class="bank-row">

<div>
<div class="bank-label">
Bank
</div>

<div class="bank-value">
People's Bank
</div>
</div>

<button
type="button"
class="copy-btn"
onclick="copyText(&quot;People's Bank&quot;,this)">
Copy
</button>

</div>

<div class="bank-row">

<div>
<div class="bank-label">
Branch
</div>

<div class="bank-value">
Udapussellawa
</div>
</div>

<button
type="button"
class="copy-btn"
onclick="copyText('Udapussellawa',this)">
Copy
</button>

</div>

<div class="bank-row">

<div>
<div class="bank-label">
Customer Name
</div>

<div class="bank-value">
Thinarathnam Saththiyanadan
</div>
</div>

<button
type="button"
class="copy-btn"
onclick="copyText('Thinarathnam Saththiyanadan',this)">
Copy
</button>

</div>

</div>

<label for="photo">
Job Photo
</label>

<div class="upload-box">

<input
id="photo"
type="file"
accept="image/jpeg,image/png,image/webp">

<small>
JPG, PNG or WebP. Maximum 5 MB.
</small>

</div>

<!-- PAYMENT -->

<div id="paymentBox" style="display:none">

<label for="depositorName">
Depositor Name
</label>

<input
id="depositorName"
type="text"
placeholder="Name used for the bank deposit">

<label for="depositDate">
Deposit Date
</label>

<input
id="depositDate"
type="date">

<label for="referenceNumber">
Reference Number
</label>

<input
id="referenceNumber"
type="text"
placeholder="Bank deposit reference number">

<label for="paymentSlip">
Payment Slip
</label>

<div class="upload-box">

<input
id="paymentSlip"
type="file"
accept="image/jpeg,image/png,image/webp,application/pdf">

<small>
JPG, PNG, WebP or PDF. Maximum 5 MB.
</small>

</div>

</div>

<button id="submitBtn" type="submit">
Post Advertisement
</button>

<div id="loading" class="loading">
Processing...
</div>

<div id="message" class="message"></div>

</form>

</div>

</main>

<script>

const ADS_API="https://ads.createlk.workers.dev";
const UPLOAD_API="https://ads.createlk.workers.dev";
const CATEGORY_API="https://categories.createlk.workers.dev";

/*
IMPORTANT:
Keep your OLD working token system.
Do not change the key.
*/
const TOKEN_KEY="createlk_session_token";

const provinceEl=
document.getElementById("province");

const districtEl=
document.getElementById("district");

const cityEl=
document.getElementById("city");

const categoryEl=
document.getElementById("category");

const adTypeEl=
document.getElementById("adType");

const priceEl=
document.getElementById("price");

const bankBox=
document.getElementById("bankBox");

const paymentBox=
document.getElementById("paymentBox");

const messageEl=
document.getElementById("message");

const loadingEl=
document.getElementById("loading");

const submitBtn=
document.getElementById("submitBtn");


/* KEEP OLD LOGIN SYSTEM */

function getToken(){

return(
sessionStorage.getItem(TOKEN_KEY)||
localStorage.getItem(TOKEN_KEY)||
""
);

}


/* MESSAGE */

function showMessage(text,type){

messageEl.textContent=text;
messageEl.className="message "+type;

}

function clearMessage(){

messageEl.textContent="";
messageEl.className="message";

}


/* PRICES */

function priceFor(type){

if(type==="featured")return 500;

if(type==="urgent")return 500;

if(type==="top")return 500;

if(type==="featured_urgent_top")return 1500;

return 0;

}


/* PACKAGE CHANGE */

function updatePrice(){

const price=
priceFor(adTypeEl.value);

priceEl.textContent=
"Rs. "+price.toLocaleString();

const paid=price>0;

bankBox.style.display=
paid?"block":"none";

paymentBox.style.display=
paid?"block":"none";

document.getElementById(
"depositorName"
).required=paid;

document.getElementById(
"depositDate"
).required=paid;

document.getElementById(
"referenceNumber"
).required=paid;

document.getElementById(
"paymentSlip"
).required=paid;

}

adTypeEl.addEventListener(
"change",
updatePrice
);


/* COPY BANK DETAILS */

async function copyText(text,button){

try{

await navigator.clipboard.writeText(text);

const old=
button.textContent;

button.textContent="Copied";

setTimeout(()=>{

button.textContent=old;

},1200);

}catch{

alert(
"Copy failed. Please copy manually."
);

}

}


/* API */

async function api(url,options={}){

const response=
await fetch(url,options);

const text=
await response.text();

let data;

try{

data=JSON.parse(text);

}catch{

data={
success:false,
error:text||
"Invalid server response"
};

}

if(!response.ok){

throw new Error(
data.error||
data.message||
("HTTP "+response.status)
);

}

return data;

}


/* LOCATIONS */

async function loadProvinces(){

try{

const data=
await api(
ADS_API+"/locations"
);

provinceEl.innerHTML=
'<option value="">Select Province</option>';

const provinces=
Array.isArray(data)
?data
:data.locations||
data.provinces||
[];

provinces.forEach(item=>{

const value=
typeof item==="string"
?item
:item.province||
item.name||
"";

if(!value)return;

const option=
document.createElement("option");

option.value=value;
option.textContent=value;

provinceEl.appendChild(option);

});

}catch(error){

provinceEl.innerHTML=
'<option value="">Unable to load provinces</option>';

showMessage(
"Could not load locations: "+
error.message,
"error"
);

}

}


/* DISTRICTS */

async function loadDistricts(){

const province=
provinceEl.value;

districtEl.innerHTML=
'<option value="">Select District</option>';

cityEl.innerHTML=
'<option value="">Select City / Area</option>';

districtEl.disabled=true;
cityEl.disabled=true;

if(!province)return;

try{

const data=
await api(
ADS_API+
"/locations?province="+
encodeURIComponent(province)
);

const districts=
Array.isArray(data)
?data
:data.locations||
data.districts||
[];

districts.forEach(item=>{

const value=
typeof item==="string"
?item
:item.district||
item.name||
"";

if(!value)return;

const option=
document.createElement("option");

option.value=value;
option.textContent=value;

districtEl.appendChild(option);

});

districtEl.disabled=false;

}catch(error){

showMessage(
"Could not load districts: "+
error.message,
"error"
);

}

}


/* CITIES */

async function loadCities(){

const province=
provinceEl.value;

const district=
districtEl.value;

cityEl.innerHTML=
'<option value="">Select City / Area</option>';

cityEl.disabled=true;

if(!province||!district)return;

try{

const data=
await api(
ADS_API+
"/locations?province="+
encodeURIComponent(province)+
"&district="+
encodeURIComponent(district)
);

const cities=
Array.isArray(data)
?data
:data.locations||
data.cities||
[];

cities.forEach(item=>{

const value=
typeof item==="string"
?item
:item.city||
item.area||
item.name||
"";

if(!value)return;

const option=
document.createElement("option");

option.value=value;
option.textContent=value;

cityEl.appendChild(option);

});

cityEl.disabled=false;

}catch(error){

showMessage(
"Could not load cities: "+
error.message,
"error"
);

}

}

provinceEl.addEventListener(
"change",
loadDistricts
);

districtEl.addEventListener(
"change",
loadCities
);


/* CATEGORIES */

async function loadCategories(){

try{

const data=
await api(
CATEGORY_API+"/categories"
);

categoryEl.innerHTML=
'<option value="">Select Category</option>';

const categories=
Array.isArray(data)
?data
:data.categories||[];

categories.forEach(item=>{

const id=
item.id??
item.category_id??
"";

const name=
item.name||
item.title||
item.category_name||
"";

if(id===""||!name)return;

const option=
document.createElement("option");

option.value=id;
option.textContent=name;

categoryEl.appendChild(option);

});

}catch(error){

categoryEl.innerHTML=
'<option value="">Unable to load categories</option>';

showMessage(
"Could not load categories: "+
error.message,
"error"
);

}

}


/* UPLOAD */

async function uploadFile(file,folder){

const formData=
new FormData();

formData.append(
"file",
file
);

formData.append(
"folder",
folder
);

const token=
getToken();

const response=
await fetch(
UPLOAD_API+"/upload",
{
method:"POST",

headers:{
"Authorization":
"Bearer "+token
},

body:formData
}
);

const text=
await response.text();

let data;

try{

data=JSON.parse(text);

}catch{

throw new Error(
"Upload response: "+
(text||"Invalid response")
);

}

if(
!response.ok||
data.success===false
){

throw new Error(
data.error||
data.message||
("Upload failed: HTTP "+
response.status)
);

}

return data;

}


/* SUBMIT */

document.getElementById(
"adForm"
).addEventListener(
"submit",
async function(e){

e.preventDefault();

clearMessage();

const token=
getToken();

/*
IMPORTANT:
Same OLD behavior.
No /me request.
No new session check.
*/

if(!token){

showMessage(
"Please login before posting an advertisement.",
"error"
);

setTimeout(()=>{

location.href=
"https://createlk.com/LK/login.html";

},1000);

return;

}

const title=
document.getElementById(
"title"
).value.trim();

const description=
document.getElementById(
"description"
).value.trim();

const whatsapp=
document.getElementById(
"whatsapp"
).value.trim();

const call=
document.getElementById(
"call"
).value.trim();

const province=
provinceEl.value;

const district=
districtEl.value;

const city=
cityEl.value;

const categoryId=
Number(categoryEl.value);

const adType=
adTypeEl.value;

const photo=
document.getElementById(
"photo"
).files[0];

const depositorName=
document.getElementById(
"depositorName"
).value.trim();

const depositDate=
document.getElementById(
"depositDate"
).value;

const referenceNumber=
document.getElementById(
"referenceNumber"
).value.trim();

const paymentSlip=
document.getElementById(
"paymentSlip"
).files[0];

if(
!title||
!description||
!whatsapp||
!call||
!province||
!district||
!city||
!categoryId||
!adType
){

showMessage(
"Please complete all required fields.",
"error"
);

return;

}

if(photo&&photo.size>5242880){

showMessage(
"Job photo must be 5 MB or smaller.",
"error"
);

return;

}

const price=
priceFor(adType);

if(price>0){

if(
!depositorName||
!depositDate||
!referenceNumber||
!paymentSlip
){

showMessage(
"Please provide all payment details and upload the payment slip.",
"error"
);

return;

}

if(paymentSlip.size>5242880){

showMessage(
"Payment slip must be 5 MB or smaller.",
"error"
);

return;

}

}

try{

submitBtn.disabled=true;
loadingEl.style.display="block";

let photoData={
key:""
};

if(photo){

photoData=
await uploadFile(
photo,
"ads"
);

}

let slipData={
key:""
};

if(price>0){

slipData=
await uploadFile(
paymentSlip,
"payments"
);

}

const photoKey=
photoData.key||
photoData.url||
photoData.photo_url||
"";

const slipKey=
slipData.key||
slipData.url||
slipData.slip_url||
"";

const payload={

title:title,

description:description,

whatsapp_no:whatsapp,

call_no:call,

province:province,

district:district,

city:city,

category_id:categoryId,

ad_type:adType,

photo_url:photoKey,

payment_slip_url:slipKey,

slip_url:slipKey,

payment_slip:slipKey,

depositor_name:depositorName,

deposit_date:depositDate,

reference_number:referenceNumber

};

const response=
await fetch(
ADS_API+"/create",
{
method:"POST",

headers:{
"Content-Type":
"application/json",

"Authorization":
"Bearer "+token
},

body:JSON.stringify(payload)

}
);

const responseText=
await response.text();

let result;

try{

result=
JSON.parse(responseText);

}catch{

result={
success:false,
error:
responseText||
"Invalid server response"
};

}

if(
!response.ok||
result.success===false
){

throw new Error(
result.error||
result.message||
("Create failed. HTTP "+
response.status)
);

}

showMessage(
result.message||
"Advertisement submitted successfully. It is waiting for approval.",
"success"
);

setTimeout(()=>{

location.href=
"https://createlk.com/LK/my-ads.html";

},1500);

}catch(error){

console.error(
"POST AD ERROR:",
error
);

showMessage(
"Error: "+error.message,
"error"
);

}finally{

submitBtn.disabled=false;
loadingEl.style.display="none";

}

});


/* START */

updatePrice();

loadProvinces();

loadCategories();

</script>

</body>
</html>