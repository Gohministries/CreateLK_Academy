const ORIGIN = "https://createlk.com";

const MAX = 5 * 1024 * 1024;

const IMAGES = [
  "image/jpeg",
  "image/png",
  "image/webp"
];

const SLIPS = [
  ...IMAGES,
  "application/pdf"
];

const PRICES = {
  free: 0,
  featured: 500,
  urgent: 500,
  top: 500,
  featured_urgent_top: 1500
};

const PAID = [
  "featured",
  "urgent",
  "top",
  "featured_urgent_top"
];

const cors = {
  "Access-Control-Allow-Origin": ORIGIN,
  "Access-Control-Allow-Methods": "GET,POST,OPTIONS",
  "Access-Control-Allow-Headers": "Content-Type,Authorization",
  "Access-Control-Max-Age": "86400",
  "Vary": "Origin"
};

function json(data, status = 200) {
  return new Response(JSON.stringify(data), {
    status,
    headers: {
      "Content-Type": "application/json; charset=utf-8",
      ...cors
    }
  });
}

function token(request) {
  const auth = request.headers.get("Authorization") || "";

  if (!auth.startsWith("Bearer ")) {
    return null;
  }

  return auth.slice(7).trim();
}

async function getUser(request, env) {
  const sessionToken = token(request);

  if (!sessionToken) {
    return null;
  }

  const row = await env.DB.prepare(`
    SELECT
      s.user_id,
      s.expires_at,
      u.name,
      u.email,
      u.phone
    FROM sessions s
    JOIN users u
      ON u.id = s.user_id
    WHERE s.token = ?
    LIMIT 1
  `)
    .bind(sessionToken)
    .first();

  if (!row) {
    return null;
  }

  const now = Math.floor(Date.now() / 1000);

  if (
    row.expires_at &&
    Number(row.expires_at) <= now
  ) {
    await env.DB.prepare(`
      DELETE FROM sessions
      WHERE token = ?
    `)
      .bind(sessionToken)
      .run();

    return null;
  }

  return {
    id: row.user_id,
    name: row.name,
    email: row.email,
    phone: row.phone
  };
}

async function auth(request, env) {
  return await getUser(request, env);
}

async function upload(request, env) {
  const user = await auth(request, env);

  if (!user) {
    return json({
      success: false,
      error: "Unauthorized"
    }, 401);
  }

  const url = new URL(request.url);
  const folder = url.searchParams.get("folder") || "ads";

  if (!["ads", "payments"].includes(folder)) {
    return json({
      success: false,
      error: "Invalid upload folder"
    }, 400);
  }

  const contentType =
    request.headers.get("Content-Type") || "";

  const allowed =
    folder === "payments"
      ? SLIPS
      : IMAGES;

  if (!allowed.includes(contentType)) {
    return json({
      success: false,
      error: "Unsupported file type"
    }, 400);
  }

  const contentLength =
    Number(request.headers.get("Content-Length") || 0);

  if (contentLength > MAX) {
    return json({
      success: false,
      error: "File is too large. Maximum size is 5 MB."
    }, 413);
  }

  const body = await request.arrayBuffer();

  if (body.byteLength > MAX) {
    return json({
      success: false,
      error: "File is too large. Maximum size is 5 MB."
    }, 413);
  }

  let extension = "bin";

  if (contentType === "image/jpeg") {
    extension = "jpg";
  } else if (contentType === "image/png") {
    extension = "png";
  } else if (contentType === "image/webp") {
    extension = "webp";
  } else if (contentType === "application/pdf") {
    extension = "pdf";
  }

  const key =
    `${folder}/${user.id}/${crypto.randomUUID()}.${extension}`;

  await env.JOBS_BUCKET.put(key, body, {
    httpMetadata: {
      contentType
    }
  });

  return json({
    success: true,
    key,
    url: `/photo?key=${encodeURIComponent(key)}`
  });
}

async function locations(request, env) {
  const url = new URL(request.url);

  const province =
    url.searchParams.get("province");

  const district =
    url.searchParams.get("district");

  if (!province) {
    const result = await env.DB.prepare(`
      SELECT DISTINCT province
      FROM locations
      WHERE province IS NOT NULL
        AND province != ''
    `).all();

    const order = [
      "Western",
      "Central",
      "Southern",
      "Northern",
      "Eastern",
      "North Western",
      "North Central",
      "Uva",
      "Sabaragamuwa",
      "Remote",
      "Overseas"
    ];

    const provinces =
      (result.results || [])
        .map(x => x.province)
        .sort((a, b) => {
          const ai = order.indexOf(a);
          const bi = order.indexOf(b);

          if (ai === -1 && bi === -1) {
            return a.localeCompare(b);
          }

          if (ai === -1) return 1;
          if (bi === -1) return -1;

          return ai - bi;
        });

    return json({
      success: true,
      provinces
    });
  }

  if (!district) {
    const result = await env.DB.prepare(`
      SELECT DISTINCT district
      FROM locations
      WHERE province = ?
        AND district IS NOT NULL
        AND district != ''
      ORDER BY district
    `)
      .bind(province)
      .all();

    return json({
      success: true,
      districts:
        (result.results || [])
          .map(x => x.district)
    });
  }

  const result = await env.DB.prepare(`
    SELECT DISTINCT city
    FROM locations
    WHERE province = ?
      AND district = ?
      AND city IS NOT NULL
      AND city != ''
    ORDER BY city
  `)
    .bind(province, district)
    .all();

  return json({
    success: true,
    cities:
      (result.results || [])
        .map(x => x.city)
  });
}

async function validateLocation(
  env,
  province,
  district,
  city
) {
  const row = await env.DB.prepare(`
    SELECT 1
    FROM locations
    WHERE province = ?
      AND district = ?
      AND city = ?
    LIMIT 1
  `)
    .bind(province, district, city)
    .first();

  return !!row;
}

async function createAd(request, env) {
  const user = await auth(request, env);

  if (!user) {
    return json({
      success: false,
      error: "Unauthorized"
    }, 401);
  }

  let body;

  try {
    body = await request.json();
  } catch {
    return json({
      success: false,
      error: "Invalid JSON"
    }, 400);
  }

  const {
    photo_url,
    title,
    description,
    whatsapp_no,
    call_no,
    province,
    district,
    city,
    ad_type = "free",
    slip_url,
    deposit_date
  } = body;

  const type = String(ad_type || "free").trim();

  if (!Object.prototype.hasOwnProperty.call(PRICES, type)) {
    return json({
      success: false,
      error: "Invalid ad type"
    }, 400);
  }

  if (
    !photo_url ||
    !title ||
    !description ||
    !whatsapp_no ||
    !call_no ||
    !province ||
    !district ||
    !city
  ) {
    return json({
      success: false,
      error: "All required fields must be completed."
    }, 400);
  }

  const validLocation =
    await validateLocation(
      env,
      province,
      district,
      city
    );

  if (!validLocation) {
    return json({
      success: false,
      error: "Invalid location."
    }, 400);
  }

  /*
   * Free Ad rules:
   *
   * Pending  -> cannot post another
   * Approved -> cannot post another for 30 days
   * Rejected -> can post again
   * Expired 30+ days -> can post again
   */

  if (type === "free") {

    const existing =
      await env.DB.prepare(`
        SELECT
          id,
          status,
          approved_at
        FROM ads
        WHERE user_id = ?
          AND ad_type = 'free'
          AND (
            status = 'pending'
            OR (
              status = 'approved'
              AND approved_at IS NOT NULL
              AND datetime(approved_at)
                  >= datetime('now', '-30 days')
            )
          )
        LIMIT 1
      `)
        .bind(user.id)
        .first();

    if (existing) {

      if (existing.status === "pending") {

        return json({
          success: false,
          error:
            "You already have a Free Ad waiting for admin approval. Please wait until it is approved or rejected before posting another Free Ad."
        }, 429);

      }

      return json({
        success: false,
        error:
          "You already have an approved Free Ad. You can post another Free Ad after 30 days from approval."
      }, 429);
    }
  }

  let paymentId = null;

  if (PAID.includes(type)) {

    if (!slip_url || !deposit_date) {
      return json({
        success: false,
        error:
          "Payment slip and deposit date are required for paid ads."
      }, 400);
    }

    const amount = PRICES[type];

    const payment =
      await env.DB.prepare(`
        INSERT INTO payments (
          user_id,
          bank_name,
          branch_name,
          account_name,
          account_number,
          amount,
          slip_url,
          deposit_date,
          status,
          created_at
        )
        VALUES (
          ?,
          ?,
          ?,
          ?,
          ?,
          ?,
          ?,
          ?,
          'pending',
          CURRENT_TIMESTAMP
        )
      `)
        .bind(
          user.id,
          "People's Bank",
          "Udapussellawa",
          "Thinarathnam Saththiyanadan",
          "292200280023178",
          amount,
          slip_url,
          deposit_date
        )
        .run();

    paymentId =
      payment.meta?.last_row_id || null;
  }

  const ad =
    await env.DB.prepare(`
      INSERT INTO ads (
        user_id,
        photo_url,
        title,
        description,
        whatsapp_no,
        call_no,
        province,
        district,
        city,
        ad_type,
        status,
        payment_status,
        payment_id,
        created_at,
        approved_at,
        expires_at
      )
      VALUES (
        ?,
        ?,
        ?,
        ?,
        ?,
        ?,
        ?,
        ?,
        ?,
        ?,
        'pending',
        ?,
        ?,
        CURRENT_TIMESTAMP,
        NULL,
        NULL
      )
    `)
      .bind(
        user.id,
        photo_url,
        title,
        description,
        whatsapp_no,
        call_no,
        province,
        district,
        city,
        type,
        PAID.includes(type)
          ? "pending"
          : "not_required",
        paymentId
      )
      .run();

  const adId =
    ad.meta?.last_row_id || null;

  if (paymentId && adId) {
    await env.DB.prepare(`
      UPDATE payments
      SET ad_id = ?
      WHERE id = ?
    `)
      .bind(adId, paymentId)
      .run();
  }

  return json({
    success: true,
    ad_id: adId,
    payment_id: paymentId,
    status: "pending"
  });
}

async function myAds(request, env) {
  const user = await auth(request, env);

  if (!user) {
    return json({
      success: false,
      error: "Unauthorized"
    }, 401);
  }

  const result =
    await env.DB.prepare(`
      SELECT
        id,
        photo_url,
        title,
        description,
        whatsapp_no,
        call_no,
        province,
        district,
        city,
        ad_type,
        status,
        payment_status,
        payment_id,
        rejection_reason,
        created_at,
        approved_at,
        expires_at
      FROM ads
      WHERE user_id = ?
      ORDER BY id DESC
    `)
      .bind(user.id)
      .all();

  return json({
    success: true,
    ads: result.results || []
  });
}

async function photo(request, env) {
  const url = new URL(request.url);

  const key =
    url.searchParams.get("key");

  if (!key) {
    return new Response("Missing key", {
      status: 400,
      headers: cors
    });
  }

  if (!key.startsWith("ads/")) {
    return new Response("Invalid key", {
      status: 403,
      headers: cors
    });
  }

  const approved =
    await env.DB.prepare(`
      SELECT id
      FROM ads
      WHERE status = 'approved'
        AND approved_at IS NOT NULL
        AND (
          expires_at IS NULL
          OR datetime(expires_at) > datetime('now')
        )
        AND photo_url = ?
      LIMIT 1
    `)
      .bind(key)
      .first();

  if (!approved) {
    return new Response("Not available", {
      status: 404,
      headers: cors
    });
  }

  const object =
    await env.JOBS_BUCKET.get(key);

  if (!object) {
    return new Response("Not found", {
      status: 404,
      headers: cors
    });
  }

  const headers = new Headers(cors);

  headers.set(
    "Content-Type",
    object.httpMetadata?.contentType ||
      "application/octet-stream"
  );

  headers.set(
    "Cache-Control",
    "public, max-age=3600"
  );

  return new Response(
    object.body,
    {
      status: 200,
      headers
    }
  );
}

export default {
  async fetch(request, env) {

    if (request.method === "OPTIONS") {
      return new Response(null, {
        status: 204,
        headers: cors
      });
    }

    const url =
      new URL(request.url);

    const path =
      url.pathname;

    try {

      if (
        path === "/" &&
        request.method === "GET"
      ) {
        return json({
          success: true,
          service: "CreateLK Jobs Ads Worker"
        });
      }

      if (
        path === "/health" &&
        request.method === "GET"
      ) {
        return json({
          success: true,
          status: "ok"
        });
      }

      if (
        path === "/locations" &&
        request.method === "GET"
      ) {
        return locations(
          request,
          env
        );
      }

      if (
        path === "/upload" &&
        request.method === "POST"
      ) {
        return upload(
          request,
          env
        );
      }

      if (
        path === "/ads" &&
        request.method === "POST"
      ) {
        return createAd(
          request,
          env
        );
      }

      if (
        path === "/my-ads" &&
        request.method === "GET"
      ) {
        return myAds(
          request,
          env
        );
      }

      if (
        path === "/photo" &&
        request.method === "GET"
      ) {
        return photo(
          request,
          env
        );
      }

      return json({
        success: false,
        error: "Not found"
      }, 404);

    } catch (error) {

      console.error(error);

      return json({
        success: false,
        error: "Internal server error"
      }, 500);
    }
  }
};