const ORIGINS = [
  "https://createlk.com",
  "https://www.createlk.com"
];

const MAX = 5 * 1024 * 1024;

const IMAGES = [
  "image/jpeg",
  "image/png",
  "image/webp"
];

const SLIPS = [
  ...IMAGES,
  "application/pdf"
];

const PRICES = {
  free: 0,
  featured: 500,
  urgent: 500,
  top: 500,
  featured_urgent_top: 1500
};

const META = {
  free: ["FREE", 0],
  featured: ["FEATURED", 2],
  urgent: ["URGENT", 1],
  top: ["TOP", 3],
  featured_urgent_top: ["FEATURED • URGENT • TOP", 4]
};

const PAID = [
  "featured",
  "urgent",
  "top",
  "featured_urgent_top"
];

function cors(r) {
  const origin = r.headers.get("Origin");

  const h = {
    "Access-Control-Allow-Methods": "GET,POST,OPTIONS",
    "Access-Control-Allow-Headers": "Content-Type, Authorization",
    "Access-Control-Max-Age": "86400",
    "Vary": "Origin"
  };

  if (ORIGINS.includes(origin)) {
    h["Access-Control-Allow-Origin"] = origin;
  }

  return h;
}

function json(data, status = 200, r) {
  return new Response(JSON.stringify(data), {
    status,
    headers: {
      ...cors(r),
      "Content-Type": "application/json;charset=utf-8",
      "Cache-Control": "no-store"
    }
  });
}

function token(r) {
  const h = r.headers.get("Authorization") || "";

  if (!h.startsWith("Bearer ")) {
    return null;
  }

  return h.slice(7).trim();
}

async function user(r, e) {
  const t = token(r);

  if (!t) {
    return null;
  }

  const u = await e.DB.prepare(`
    SELECT
      users.id,
      users.name,
      users.email,
      users.photo_url,
      users.email_verified,
      sessions.id AS session_id,
      sessions.expires_at
    FROM sessions
    JOIN users
      ON users.id = sessions.user_id
    WHERE sessions.id = ?
    LIMIT 1
  `)
    .bind(t)
    .first();

  if (!u) {
    return null;
  }

  if (
    Number(u.expires_at) <=
    Math.floor(Date.now() / 1000)
  ) {
    return null;
  }

  return u;
}

function uuid() {
  return crypto.randomUUID();
}

async function upload(r, e) {
  const u = await user(r, e);

  if (!u) {
    return json(
      {
        success: false,
        error: "Unauthorized"
      },
      401,
      r
    );
  }

  const form = await r.formData();

  const file = form.get("file");
  const folder = form.get("folder");

  if (!(file instanceof File)) {
    return json(
      {
        success: false,
        error: "File is required"
      },
      400,
      r
    );
  }

  if (!["ads", "payments"].includes(folder)) {
    return json(
      {
        success: false,
        error: "Invalid upload folder"
      },
      400,
      r
    );
  }

  if (file.size <= 0) {
    return json(
      {
        success: false,
        error: "Empty file"
      },
      400,
      r
    );
  }

  if (file.size > MAX) {
    return json(
      {
        success: false,
        error: "Maximum file size is 5 MB"
      },
      400,
      r
    );
  }

  const allowed =
    folder === "ads"
      ? IMAGES
      : SLIPS;

  if (!allowed.includes(file.type)) {
    return json(
      {
        success: false,
        error: "Unsupported file type"
      },
      400,
      r
    );
  }

  let ext = "bin";

  if (file.type === "image/jpeg") ext = "jpg";
  if (file.type === "image/png") ext = "png";
  if (file.type === "image/webp") ext = "webp";
  if (file.type === "application/pdf") ext = "pdf";

  const key =
    `${folder}/${u.id}/${uuid()}.${ext}`;

  await e.JOBS_BUCKET.put(
    key,
    file.stream(),
    {
      httpMetadata: {
        contentType: file.type,
        cacheControl: "public, max-age=31536000"
      }
    }
  );

  return json(
    {
      success: true,
      key,
      url:
        `/photo?key=${encodeURIComponent(key)}`
    },
    200,
    r
  );
}

async function locations(r, e) {
  const q = new URL(r.url).searchParams;

  const province = q.get("province");
  const district = q.get("district");

  if (district) {
    const rows = await e.DB.prepare(`
      SELECT DISTINCT city
      FROM locations
      WHERE province = ?
        AND district = ?
      ORDER BY city
    `)
      .bind(province, district)
      .all();

    return json(
      {
        success: true,
        cities:
          (rows.results || [])
            .map(x => x.city)
            .filter(Boolean)
      },
      200,
      r
    );
  }

  if (province) {
    const rows = await e.DB.prepare(`
      SELECT DISTINCT district
      FROM locations
      WHERE province = ?
      ORDER BY district
    `)
      .bind(province)
      .all();

    return json(
      {
        success: true,
        districts:
          (rows.results || [])
            .map(x => x.district)
            .filter(Boolean)
      },
      200,
      r
    );
  }

  const rows = await e.DB.prepare(`
    SELECT DISTINCT province
    FROM locations
    ORDER BY province
  `).all();

  return json(
    {
      success: true,
      provinces:
        (rows.results || [])
          .map(x => x.province)
          .filter(Boolean)
    },
    200,
    r
  );
}

async function createAd(r, e) {
  const u = await user(r, e);

  if (!u) {
    return json(
      {
        success: false,
        error: "Unauthorized"
      },
      401,
      r
    );
  }

  let body;

  try {
    body = await r.json();
  } catch {
    return json(
      {
        success: false,
        error: "Invalid JSON"
      },
      400,
      r
    );
  }

  const title =
    String(body.title || "").trim();

  const description =
    String(body.description || "").trim();

  const whatsapp =
    String(body.whatsapp_no || "").trim();

  const call =
    String(body.call_no || "").trim();

  const province =
    String(body.province || "").trim();

  const district =
    String(body.district || "").trim();

  const city =
    String(body.city || "").trim();

  const photo =
    String(body.photo_url || "").trim();

  const paymentSlip =
    String(body.payment_slip_url || "").trim();

  const adType =
    String(body.ad_type || "free").trim();

  const categoryId =
    Number(body.category_id);

  const depositDate =
    String(body.deposit_date || "").trim();

  const depositorName =
    String(
      body.depositor_name ||
      u.name ||
      ""
    ).trim();

  const bankName =
    String(
      body.bank_name ||
      "People's Bank"
    ).trim();

  const branchName =
    String(
      body.branch_name ||
      "Udapussellawa"
    ).trim();

  const accountName =
    String(
      body.account_name ||
      "Thinarathnam Saththiyanadan"
    ).trim();

  const accountNumber =
    String(
      body.account_number ||
      "292200280023178"
    ).trim();

  const referenceNumber =
    String(
      body.reference_number ||
      ""
    ).trim();

  if (
    !title ||
    !description ||
    !whatsapp ||
    !call ||
    !province ||
    !district ||
    !city
  ) {
    return json(
      {
        success: false,
        error:
          "Please complete all required fields"
      },
      400,
      r
    );
  }

  if (!Number.isInteger(categoryId) || categoryId <= 0) {
    return json(
      {
        success: false,
        error: "Invalid category"
      },
      400,
      r
    );
  }

  if (!Object.prototype.hasOwnProperty.call(
    META,
    adType
  )) {
    return json(
      {
        success: false,
        error: "Invalid ad type"
      },
      400,
      r
    );
  }

  const category =
    await e.DB.prepare(`
      SELECT id
      FROM categories
      WHERE id = ?
      LIMIT 1
    `)
      .bind(categoryId)
      .first();

  if (!category) {
    return json(
      {
        success: false,
        error: "Category not found"
      },
      400,
      r
    );
  }

  const location =
    await e.DB.prepare(`
      SELECT 1
      FROM locations
      WHERE province = ?
        AND district = ?
        AND city = ?
      LIMIT 1
    `)
      .bind(
        province,
        district,
        city
      )
      .first();

  if (!location) {
    return json(
      {
        success: false,
        error:
          "Invalid province, district or city"
      },
      400,
      r
    );
  }

  if (photo) {
    if (!photo.startsWith("ads/")) {
      return json(
        {
          success: false,
          error: "Invalid job photo"
        },
        400,
        r
      );
    }

    const photoObject =
      await e.JOBS_BUCKET.head(photo);

    if (!photoObject) {
      return json(
        {
          success: false,
          error: "Job photo not found"
        },
        400,
        r
      );
    }
  }

  if (PAID.includes(adType)) {
    if (!paymentSlip) {
      return json(
        {
          success: false,
          error:
            "Payment slip is required"
        },
        400,
        r
      );
    }

    if (!paymentSlip.startsWith("payments/")) {
      return json(
        {
          success: false,
          error:
            "Invalid payment slip"
        },
        400,
        r
      );
    }

    const slipObject =
      await e.JOBS_BUCKET.head(
        paymentSlip
      );

    if (!slipObject) {
      return json(
        {
          success: false,
          error:
            "Payment slip not found"
        },
        400,
        r
      );
    }

    if (!depositDate) {
      return json(
        {
          success: false,
          error:
            "Deposit date is required"
        },
        400,
        r
      );
    }
  }

  if (adType === "free") {
    const existing =
      await e.DB.prepare(`
        SELECT id
        FROM ads
        WHERE user_id = ?
          AND ad_type = 'free'
          AND status IN ('pending','approved')
        LIMIT 1
      `)
        .bind(u.id)
        .first();

    if (existing) {
      return json(
        {
          success: false,
          error:
            "You already have a free ad"
        },
        400,
        r
      );
    }
  }

  const now =
    new Date().toISOString();

  const expires =
    new Date(
      Date.now() +
      30 * 24 * 60 * 60 * 1000
    ).toISOString();

  /*
   * IMPORTANT:
   * This INSERT matches the actual
   * ads table exactly.
   *
   * There is NO price column.
   * There is NO label column.
   */

  const adResult =
    await e.DB.prepare(`
      INSERT INTO ads(
        user_id,
        photo_url,
        title,
        description,
        whatsapp_no,
        call_no,
        province,
        district,
        city,
        ad_type,
        status,
        payment_status,
        category_id,
        priority,
        created_at,
        expires_at
      )
      VALUES(
        ?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?
      )
    `)
      .bind(
        u.id,
        photo,
        title,
        description,
        whatsapp,
        call,
        province,
        district,
        city,
        adType,
        "pending",
        adType === "free"
          ? "not_required"
          : "pending",
        categoryId,
        META[adType][1],
        now,
        expires
      )
      .run();

  const adId =
    adResult.meta?.last_row_id;

  if (!adId) {
    return json(
      {
        success: false,
        error:
          "Unable to create advertisement"
      },
      500,
      r
    );
  }

  let paymentId = null;

  if (PAID.includes(adType)) {
    const amount =
      PRICES[adType];

    const paymentResult =
      await e.DB.prepare(`
        INSERT INTO payments(
          user_id,
          ad_id,
          amount,
          bank_name,
          branch_name,
          account_name,
          account_number,
          depositor_name,
          deposit_date,
          reference_number,
          slip_url,
          status,
          created_at
        )
        VALUES(
          ?,?,?,?,?,?,?,?,?,?,?,
          'pending',
          CURRENT_TIMESTAMP
        )
      `)
        .bind(
          u.id,
          adId,
          amount,
          bankName,
          branchName,
          accountName,
          accountNumber,
          depositorName,
          depositDate,
          referenceNumber,
          paymentSlip
        )
        .run();

    paymentId =
      paymentResult.meta?.last_row_id;

    if (paymentId) {
      await e.DB.prepare(`
        UPDATE ads
        SET payment_id = ?
        WHERE id = ?
      `)
        .bind(
          paymentId,
          adId
        )
        .run();
    }
  }

  return json(
    {
      success: true,
      message:
        PAID.includes(adType)
          ? "Advertisement submitted. Payment is pending admin approval."
          : "Advertisement submitted for approval.",
      ad_id: adId,
      payment_id: paymentId,
      ad_type: adType,
      amount: PRICES[adType]
    },
    200,
    r
  );
}

async function myAds(r, e) {
  const u = await user(r, e);

  if (!u) {
    return json(
      {
        success: false,
        error: "Unauthorized"
      },
      401,
      r
    );
  }

  const rows =
    await e.DB.prepare(`
      SELECT
        ads.id,
        ads.user_id,
        ads.photo_url,
        ads.title,
        ads.description,
        ads.whatsapp_no,
        ads.call_no,
        ads.province,
        ads.district,
        ads.city,
        ads.ad_type,
        ads.status,
        ads.payment_status,
        ads.payment_id,
        ads.rejection_reason,
        ads.created_at,
        ads.approved_at,
        ads.expires_at,
        ads.category_id,
        ads.priority,
        categories.name AS category_name
      FROM ads
      LEFT JOIN categories
        ON categories.id = ads.category_id
      WHERE ads.user_id = ?
      ORDER BY
        ads.priority DESC,
        ads.created_at DESC
    `)
      .bind(u.id)
      .all();

  return json(
    {
      success: true,
      ads: rows.results || []
    },
    200,
    r
  );
}

async function latest(r, e) {
  const rows =
    await e.DB.prepare(`
      SELECT
        ads.id,
        ads.photo_url,
        ads.title,
        ads.description,
        ads.whatsapp_no,
        ads.call_no,
        ads.province,
        ads.district,
        ads.city,
        ads.ad_type,
        ads.status,
        ads.created_at,
        ads.expires_at,
        ads.category_id,
        ads.priority,
        categories.name AS category_name
      FROM ads
      LEFT JOIN categories
        ON categories.id = ads.category_id
      WHERE ads.status = 'approved'
        AND (
          ads.expires_at IS NULL
          OR ads.expires_at > ?
        )
      ORDER BY
        ads.priority DESC,
        ads.created_at DESC
      LIMIT 50
    `)
      .bind(
        new Date().toISOString()
      )
      .all();

  return json(
    {
      success: true,
      ads: rows.results || []
    },
    200,
    r
  );
}

async function photo(r, e) {
  const q =
    new URL(r.url).searchParams;

  const key = q.get("key");

  if (!key) {
    return new Response(
      "Missing key",
      {
        status: 400,
        headers: cors(r)
      }
    );
  }

  if (
    !key.startsWith("ads/") &&
    !key.startsWith("payments/")
  ) {
    return new Response(
      "Invalid key",
      {
        status: 400,
        headers: cors(r)
      }
    );
  }

  const object =
    await e.JOBS_BUCKET.get(key);

  if (!object) {
    return new Response(
      "Not found",
      {
        status: 404,
        headers: cors(r)
      }
    );
  }

  const headers =
    new Headers(cors(r));

  object.writeHttpMetadata(headers);

  headers.set(
    "ETag",
    object.httpEtag
  );

  headers.set(
    "Cache-Control",
    "public, max-age=31536000"
  );

  return new Response(
    object.body,
    {
      status: 200,
      headers
    }
  );
}

