const ORIGINS=["https://createlk.com","https://www.createlk.com"];
const MAX=5*1024*1024;
const IMAGES=["image/jpeg","image/png","image/webp"];
const SLIPS=[...IMAGES,"application/pdf"];

const PRICES={
  free:0,
  featured:500,
  urgent:500,
  top:500,
  featured_urgent_top:1500
};

const PAID=["featured","urgent","top","featured_urgent_top"];

const META={
  free:["FREE",0],
  featured:["FEATURED",2],
  urgent:["URGENT",1],
  top:["TOP",3],
  featured_urgent_top:["FEATURED • URGENT • TOP",4]
};

function cors(r){
  const o=r.headers.get("Origin");
  const h={
    "Access-Control-Allow-Methods":"GET,POST,OPTIONS",
    "Access-Control-Allow-Headers":"Content-Type, Authorization",
    "Access-Control-Max-Age":"86400",
    "Vary":"Origin"
  };
  if(ORIGINS.includes(o))h["Access-Control-Allow-Origin"]=o;
  return h;
}

function json(d,s=200,r){
  return new Response(JSON.stringify(d),{
    status:s,
    headers:{
      ...cors(r),
      "Content-Type":"application/json;charset=utf-8",
      "Cache-Control":"no-store"
    }
  });
}

function token(r){
  const h=r.headers.get("Authorization")||"";
  return h.startsWith("Bearer ")?h.slice(7).trim():null;
}

async function user(r,e){
  const t=token(r);
  if(!t)return null;

  const u=await e.DB.prepare(`
    SELECT
      users.id,
      users.name,
      users.email,
      users.photo_url,
      users.email_verified,
      sessions.id AS session_id,
      sessions.expires_at
    FROM sessions
    JOIN users ON users.id=sessions.user_id
    WHERE sessions.id=?
    LIMIT 1
  `).bind(t).first();

  if(!u)return null;

  if(Number(u.expires_at)<=Math.floor(Date.now()/1000))
    return null;

  return u;
}

function uid(){
  return crypto.randomUUID();
}

/* =========================
   UPLOAD
========================= */

async function upload(r,e){
  const u=await user(r,e);

  if(!u)
    return json({
      success:false,
      error:"Unauthorized"
    },401,r);

  const f=await r.formData();
  const file=f.get("file");
  const folder=String(f.get("folder")||"ads");

  if(!(file instanceof File))
    return json({
      success:false,
      error:"File required"
    },400,r);

  if(!["ads","payments"].includes(folder))
    return json({
      success:false,
      error:"Invalid folder"
    },400,r);

  if(file.size>MAX)
    return json({
      success:false,
      error:"Maximum file size is 5 MB"
    },400,r);

  const type=file.type||"";
  const allowed=folder==="payments"?SLIPS:IMAGES;

  if(!allowed.includes(type))
    return json({
      success:false,
      error:"Invalid file type"
    },400,r);

  const ext={
    "image/jpeg":"jpg",
    "image/png":"png",
    "image/webp":"webp",
    "application/pdf":"pdf"
  }[type]||"bin";

  const key=`${folder}/${u.id}/${uid()}.${ext}`;

  await e.JOBS_BUCKET.put(key,file.stream(),{
    httpMetadata:{
      contentType:type
    }
  });

  return json({
    success:true,
    key,
    url:`/photo?key=${encodeURIComponent(key)}`
  },200,r);
}

/* =========================
   LOCATIONS
========================= */

async function locations(r,e){
  const q=new URL(r.url).searchParams;
  const province=q.get("province");
  const district=q.get("district");

  if(district){
    const rows=await e.DB.prepare(`
      SELECT DISTINCT city
      FROM locations
      WHERE province=? AND district=?
      ORDER BY city
    `).bind(province,district).all();

    return json({
      success:true,
      cities:(rows.results||[]).map(x=>x.city)
    },200,r);
  }

  if(province){
    const rows=await e.DB.prepare(`
      SELECT DISTINCT district
      FROM locations
      WHERE province=?
      ORDER BY district
    `).bind(province).all();

    return json({
      success:true,
      districts:(rows.results||[]).map(x=>x.district)
    },200,r);
  }

  const rows=await e.DB.prepare(`
    SELECT DISTINCT province
    FROM locations
    ORDER BY province
  `).all();

  return json({
    success:true,
    provinces:(rows.results||[]).map(x=>x.province)
  },200,r);
}

/* =========================
   CREATE AD
========================= */

async function createAd(r,e){
  const u=await user(r,e);

  if(!u)
    return json({
      success:false,
      error:"Unauthorized"
    },401,r);

  const d=await r.json();

  const title=String(d.title||"").trim();
  const description=String(d.description||"").trim();

  const whatsapp=String(
    d.whatsapp_no||
    d.whatsapp_number||
    ""
  ).trim();

  const call=String(
    d.call_no||
    d.call_number||
    d.phone||
    d.phone_number||
    ""
  ).trim();

  const province=String(d.province||"").trim();
  const district=String(d.district||"").trim();
  const city=String(d.city||"").trim();

  const categoryId=Number(
    d.category_id||
    d.category||
    0
  );

  const photo=String(
    d.photo_url||
    d.photo||
    ""
  ).trim();

  const adType=String(
    d.ad_type||
    "free"
  ).trim();

  const slip=String(
    d.slip_url||
    d.payment_slip||
    d.payment_slip_url||
    ""
  ).trim();

  const depositor=String(
    d.depositor_name||
    u.name||
    ""
  ).trim();

  const depositDate=String(
    d.deposit_date||
    ""
  ).trim();

  const reference=String(
    d.reference_number||
    ""
  ).trim();

  if(
    !title||
    !description||
    !whatsapp||
    !call||
    !province||
    !district||
    !city||
    !categoryId
  ){
    return json({
      success:false,
      error:"Please fill all required fields"
    },400,r);
  }

  if(!PRICES.hasOwnProperty(adType)){
    return json({
      success:false,
      error:"Invalid advertisement type"
    },400,r);
  }

  /* CATEGORY CHECK */

  const category=await e.DB.prepare(`
    SELECT id
    FROM categories
    WHERE id=?
    LIMIT 1
  `).bind(categoryId).first();

  if(!category){
    return json({
      success:false,
      error:"Invalid category"
    },400,r);
  }

  /* LOCATION CHECK */

  const location=await e.DB.prepare(`
    SELECT 1
    FROM locations
    WHERE province=?
      AND district=?
      AND city=?
    LIMIT 1
  `).bind(
    province,
    district,
    city
  ).first();

  if(!location){
    return json({
      success:false,
      error:"Invalid location"
    },400,r);
  }

  /* JOB PHOTO */

  if(photo){
    if(!photo.startsWith("ads/")){
      return json({
        success:false,
        error:"Invalid job photo"
      },400,r);
    }

    const obj=await e.JOBS_BUCKET.head(photo);

    if(!obj){
      return json({
        success:false,
        error:"Ad photo not found"
      },400,r);
    }
  }

  /* FREE AD CHECK */

  if(adType==="free"){
    const existing=await e.DB.prepare(`
      SELECT id
      FROM ads
      WHERE user_id=?
        AND status IN ('pending','approved')
        AND ad_type='free'
      ORDER BY created_at DESC
      LIMIT 1
    `).bind(u.id).first();

    if(existing){
      return json({
        success:false,
        error:"You already have an active or pending free advertisement"
      },400,r);
    }
  }

  /* PAID AD CHECK */

  if(PAID.includes(adType)){
    if(!slip){
      return json({
        success:false,
        error:"Payment slip is required"
      },400,r);
    }

    if(!depositDate){
      return json({
        success:false,
        error:"Deposit date is required"
      },400,r);
    }

    if(!slip.startsWith("payments/")){
      return json({
        success:false,
        error:"Invalid payment slip"
      },400,r);
    }

    const obj=await e.JOBS_BUCKET.head(slip);

    if(!obj){
      return json({
        success:false,
        error:"Payment slip not found"
      },400,r);
    }
  }

  const price=PRICES[adType];

  try{

    /* IMPORTANT:
       NO price COLUMN HERE
    */

    const adResult=await e.DB.prepare(`
      INSERT INTO ads(
        user_id,
        photo_url,
        title,
        description,
        whatsapp_no,
        call_no,
        province,
        district,
        city,
        category_id,
        ad_type,
        label,
        priority,
        status,
        payment_status,
        created_at
      )
      VALUES(
        ?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?
      )
    `).bind(
      u.id,
      photo,
      title,
      description,
      whatsapp,
      call,
      province,
      district,
      city,
      categoryId,
      adType,
      META[adType][0],
      META[adType][1],
      "pending",
      adType==="free"?"free":"pending",
      new Date().toISOString()
    ).run();

    let adId=adResult.meta?.last_row_id;

    if(!adId){
      const latest=await e.DB.prepare(`
        SELECT id
        FROM ads
        WHERE user_id=?
        ORDER BY created_at DESC
        LIMIT 1
      `).bind(u.id).first();

      adId=latest?.id;
    }

    if(!adId)
      throw new Error(
        "Unable to determine created advertisement ID"
      );

    let paymentId=null;

    /* PAYMENT */

    if(PAID.includes(adType)){

      const paymentResult=await e.DB.prepare(`
        INSERT INTO payments(
          user_id,
          ad_id,
          amount,
          bank_name,
          branch_name,
          account_name,
          account_number,
          depositor_name,
          deposit_date,
          reference_number,
          slip_url,
          status,
          created_at
        )
        VALUES(
          ?,?,?,?,?,?,?,?,?,?,?,
          'pending',
          CURRENT_TIMESTAMP
        )
      `).bind(
        u.id,
        adId,
        price,
        "People's Bank",
        "Udapussellawa",
        "Thinarathnam Saththiyanadan",
        "292200280023178",
        depositor,
        depositDate,
        reference,
        slip
      ).run();

      paymentId=paymentResult.meta?.last_row_id;

      await e.DB.prepare(`
        UPDATE ads
        SET
          payment_id=?,
          payment_status='pending'
        WHERE id=?
      `).bind(
        paymentId,
        adId
      ).run();
    }

    return json({
      success:true,
      message:PAID.includes(adType)
        ?"Advertisement submitted. Payment is pending admin approval."
        :"Advertisement submitted successfully. Pending admin approval.",
      ad_id:adId,
      payment_id:paymentId,
      price
    },200,r);

  }catch(error){

    return json({
      success:false,
      error:"Unable to create ad: "+
        String(error?.message||error)
    },500,r);
  }
}

/* =========================
   MY ADS
========================= */

async function myAds(r,e){
  const u=await user(r,e);

  if(!u)
    return json({
      success:false,
      error:"Unauthorized"
    },401,r);

  const rows=await e.DB.prepare(`
    SELECT *
    FROM ads
    WHERE user_id=?
    ORDER BY created_at DESC
  `).bind(u.id).all();

  return json({
    success:true,
    ads:rows.results||[]
  },200,r);
}

/* =========================
   LATEST ADS
========================= */

async function latest(r,e){
  const rows=await e.DB.prepare(`
    SELECT
      ads.*,
      categories.name AS category_name,
      users.name AS user_name
    FROM ads
    LEFT JOIN categories
      ON categories.id=ads.category_id
    LEFT JOIN users
      ON users.id=ads.user_id
    WHERE ads.status='approved'
    ORDER BY
      ads.priority DESC,
      ads.created_at DESC
    LIMIT 50
  `).all();

  return json({
    success:true,
    ads:rows.results||[]
  },200,r);
}

/* =========================
   PHOTO
========================= */

async function photo(r,e){
  const key=new URL(r.url).searchParams.get("key");

  if(!key)
    return new Response(
      "Missing key",
      {status:400}
    );

  if(
    !key.startsWith("ads/")&&
    !key.startsWith("payments/")
  ){
    return new Response(
      "Invalid key",
      {status:400}
    );
  }

  const obj=await e.JOBS_BUCKET.get(key);

  if(!obj)
    return new Response(
      "Not found",
      {status:404}
    );

  const h=new Headers();

  obj.writeHttpMetadata(h);
  h.set(
    "Cache-Control",
    "public,max-age=86400"
  );

  return new Response(
    obj.body,
    {headers:h}
  );
}

/* =========================
   CLEANUP
========================= */

async function cleanup(e){
  await e.DB.prepare(`
    DELETE FROM sessions
    WHERE expires_at<=?
  `).bind(
    Math.floor(Date.now()/1000)
  ).run();
}

/* =========================
   WORKER
========================= */

export default{

  async fetch(r,e){

    try{

      if(r.method==="OPTIONS"){
        return new Response(
          null,
          {
            status:204,
            headers:cors(r)
          }
        );
      }

      const p=new URL(r.url).pathname;

      if(
        p==="/health"&&
        r.method==="GET"
      ){
        return json({
          success:true,
          service:"CreateLK Jobs Ads API",
          status:"online"
        },200,r);
      }

      if(
        p==="/upload"&&
        r.method==="POST"
      ){
        return upload(r,e);
      }

      if(
        p==="/locations"&&
        r.method==="GET"
      ){
        return locations(r,e);
      }

      if(
        (p==="/create"||p==="/ads")&&
        r.method==="POST"
      ){
        return createAd(r,e);
      }

      if(
        p==="/my-ads"&&
        r.method==="GET"
      ){
        return myAds(r,e);
      }

      if(
        p==="/latest"&&
        r.method==="GET"
      ){
        return latest(r,e);
      }

      if(
        p==="/photo"&&
        r.method==="GET"
      ){
        return photo(r,e);
      }

      return json({
        success:false,
        error:"Not found"
      },404,r);

    }catch(error){

      return json({
        success:false,
        error:String(
          error?.message||error
        )
      },500,r);
    }
  },

  async scheduled(event,e){

    try{
      await cleanup(e);
    }catch(error){
      console.error(error);
    }

  }

};