const ALLOWED_ORIGIN = "https://createlk.com";

const MAX_FILE_SIZE = 5 * 1024 * 1024;

const ALLOWED_IMAGE_TYPES = [
  "image/jpeg",
  "image/png",
  "image/webp"
];

const ALLOWED_SLIP_TYPES = [
  "image/jpeg",
  "image/png",
  "image/webp",
  "application/pdf"
];

const PAID_TYPES = [
  "featured",
  "urgent",
  "top",
  "featured_urgent_top"
];

const AD_TYPES = [
  "free",
  "featured",
  "urgent",
  "top",
  "featured_urgent_top"
];


/*
==================================================
CORS
==================================================
*/

function corsHeaders() {
  return {
    "Access-Control-Allow-Origin": ALLOWED_ORIGIN,
    "Access-Control-Allow-Headers": "Content-Type, Authorization",
    "Access-Control-Allow-Methods": "GET, POST, OPTIONS"
  };
}


/*
==================================================
JSON RESPONSE
==================================================
*/

function json(data, status = 200) {
  return new Response(
    JSON.stringify(data),
    {
      status,
      headers: {
        "Content-Type": "application/json",
        ...corsHeaders()
      }
    }
  );
}


/*
==================================================
RANDOM ID
==================================================
*/

function randomId(length = 32) {
  const bytes = new Uint8Array(length);

  crypto.getRandomValues(bytes);

  return [...bytes]
    .map(b =>
      b.toString(16).padStart(2, "0")
    )
    .join("");
}


/*
==================================================
GET SESSION TOKEN
==================================================
*/

function getToken(request) {
  const auth =
    request.headers.get("Authorization") || "";

  if (!auth.startsWith("Bearer ")) {
    return null;
  }

  const token =
    auth.substring(7).trim();

  return token || null;
}


/*
==================================================
GET USER
==================================================
Directly checks users + sessions in D1.
==================================================
*/

async function getUser(request, env) {

  const token =
    getToken(request);

  if (!token) {
    return null;
  }

  const session =
    await env.DB.prepare(`
      SELECT
        s.id AS session_id,
        s.user_id,
        s.expires_at,
        u.id,
        u.google_id,
        u.name,
        u.email,
        u.photo_url,
        u.email_verified
      FROM sessions s
      INNER JOIN users u
        ON u.id = s.user_id
      WHERE s.id = ?
      LIMIT 1
    `)
      .bind(token)
      .first();

  if (!session) {
    return null;
  }


  /*
  Expired session
  */

  if (
    Number(session.expires_at) <= Date.now()
  ) {

    await env.DB.prepare(`
      DELETE FROM sessions
      WHERE id = ?
    `)
      .bind(token)
      .run();

    return null;
  }


  return {
    id: session.user_id,
    google_id: session.google_id,
    name: session.name,
    email: session.email,
    photo_url: session.photo_url,
    email_verified:
      Number(session.email_verified) === 1
  };
}


/*
==================================================
CLEAN INPUT
==================================================
*/

function clean(
  value,
  maxLength = 5000
) {

  return String(value || "")
    .trim()
    .slice(0, maxLength);
}


/*
==================================================
FILE EXTENSION
==================================================
*/

function extensionFromType(type) {

  const map = {

    "image/jpeg": "jpg",

    "image/png": "png",

    "image/webp": "webp",

    "application/pdf": "pdf"

  };

  return map[type] || "file";
}


/*
==================================================
UPLOAD FILE
==================================================
*/

async function uploadFile(
  env,
  file,
  folder
) {

  if (!file) {
    throw new Error(
      "File is required."
    );
  }


  if (file.size > MAX_FILE_SIZE) {
    throw new Error(
      "File must be 5 MB or smaller."
    );
  }


  const type =
    file.type || "";


  const allowed =
    folder === "ads"
      ? ALLOWED_IMAGE_TYPES
      : ALLOWED_SLIP_TYPES;


  if (!allowed.includes(type)) {
    throw new Error(
      "Unsupported file type."
    );
  }


  const extension =
    extensionFromType(type);


  const key =
    `${folder}/${Date.now()}-${randomId(12)}.${extension}`;


  await env.JOBS_BUCKET.put(
    key,
    file.stream(),
    {
      httpMetadata: {
        contentType: type
      }
    }
  );


  return key;
}


/*
==================================================
PAID AD TYPES
==================================================
*/

function isPaidType(adType) {
  return PAID_TYPES.includes(adType);
}


/*
==================================================
AD PRICES
==================================================
*/

function getPrice(adType) {

  const prices = {

    free: 0,

    featured: 500,

    urgent: 500,

    top: 500,

    featured_urgent_top: 1500

  };

  return prices[adType] ?? 0;
}


/*
==================================================
UPLOAD
==================================================
*/

async function handleUpload(
  request,
  env
) {

  const user =
    await getUser(
      request,
      env
    );


  if (!user || !user.id) {

    return json(
      {
        error: "Unauthorized"
      },
      401
    );
  }


  const form =
    await request.formData();


  const file =
    form.get("file");


  const uploadType =
    clean(
      form.get("type"),
      20
    );


  if (!(file instanceof File)) {

    return json(
      {
        error:
          "No file uploaded."
      },
      400
    );
  }


  if (
    uploadType !== "ad_photo" &&
    uploadType !== "bank_slip"
  ) {

    return json(
      {
        error:
          "Invalid upload type."
      },
      400
    );
  }


  const folder =
    uploadType === "ad_photo"
      ? "ads"
      : "payments";


  if (
    uploadType === "ad_photo" &&
    !ALLOWED_IMAGE_TYPES.includes(
      file.type
    )
  ) {

    return json(
      {
        error:
          "Ad photo must be JPG, PNG or WebP."
      },
      400
    );
  }


  if (
    uploadType === "bank_slip" &&
    !ALLOWED_SLIP_TYPES.includes(
      file.type
    )
  ) {

    return json(
      {
        error:
          "Bank slip must be JPG, PNG, WebP or PDF."
      },
      400
    );
  }


  try {

    const key =
      await uploadFile(
        env,
        file,
        folder
      );


    return json({
      success: true,
      key,
      type: uploadType
    });


  } catch (error) {

    return json(
      {
        error:
          error.message ||
          "Upload failed."
      },
      400
    );
  }
}


/*
==================================================
CREATE AD
==================================================
*/

async function handleCreateAd(
  request,
  env
) {

  const user =
    await getUser(
      request,
      env
    );


  if (!user || !user.id) {

    return json(
      {
        error: "Unauthorized"
      },
      401
    );
  }


  const form =
    await request.formData();


  const title =
    clean(
      form.get("title"),
      200
    );


  const description =
    clean(
      form.get("description"),
      5000
    );


  const whatsapp =
    clean(
      form.get("whatsapp_no"),
      30
    );


  const call =
    clean(
      form.get("call_no"),
      30
    );


  const adType =
    clean(
      form.get("ad_type"),
      40
    );


  const photoKey =
    clean(
      form.get("photo_key"),
      500
    );


  const slipKey =
    clean(
      form.get("slip_key"),
      500
    );


  /*
  ==============================================
  BASIC VALIDATION
  ==============================================
  */

  if (!title) {

    return json(
      {
        error:
          "Title is required."
      },
      400
    );
  }


  if (!description) {

    return json(
      {
        error:
          "Description is required."
      },
      400
    );
  }


  if (!whatsapp) {

    return json(
      {
        error:
          "WhatsApp number is required."
      },
      400
    );
  }


  if (!call) {

    return json(
      {
        error:
          "Call number is required."
      },
      400
    );
  }


  if (
    !photoKey ||
    !photoKey.startsWith("ads/")
  ) {

    return json(
      {
        error:
          "Valid ad photo is required."
      },
      400
    );
  }


  /*
  ==============================================
  VALIDATE AD TYPE
  ==============================================
  */

  if (
    !AD_TYPES.includes(adType)
  ) {

    return json(
      {
        error:
          "Invalid ad type."
      },
      400
    );
  }


  const paid =
    isPaidType(adType);


  /*
  ==============================================
  FREE AD LIMIT
  ==============================================

  ONLY APPROVED FREE ADS COUNT.

  Pending = does NOT count
  Rejected = does NOT count
  Approved = counts
  Older than 30 days = does NOT block

  The 30-day period starts from approved_at.
  ==============================================
  */

  if (adType === "free") {

    const existingFreeAd =
      await env.DB.prepare(`
        SELECT
          id,
          approved_at
        FROM ads
        WHERE user_id = ?
          AND ad_type = 'free'
          AND status = 'approved'
          AND approved_at IS NOT NULL
          AND datetime(approved_at)
              >= datetime('now', '-30 days')
        ORDER BY approved_at DESC
        LIMIT 1
      `)
        .bind(user.id)
        .first();


    if (existingFreeAd) {

      return json(
        {
          error:
            "You already have an approved Free Ad. You can post another Free Ad after 30 days."
        },
        429
      );
    }
  }


  /*
  ==============================================
  PAID AD REQUIRES BANK SLIP
  ==============================================
  */

  if (
    paid &&
    (
      !slipKey ||
      !slipKey.startsWith(
        "payments/"
      )
    )
  ) {

    return json(
      {
        error:
          "Bank deposit slip is required for paid ads."
      },
      400
    );
  }


  /*
  ==============================================
  PAYMENT STATUS
  ==============================================
  */

  const paymentStatus =
    paid
      ? "pending"
      : "not_required";


  /*
  ==============================================
  INSERT AD
  ==============================================
  */

  const result =
    await env.DB.prepare(`
      INSERT INTO ads (
        user_id,
        photo_url,
        title,
        description,
        whatsapp_no,
        call_no,
        ad_type,
        status,
        payment_status
      )
      VALUES (
        ?,
        ?,
        ?,
        ?,
        ?,
        ?,
        ?,
        'pending',
        ?
      )
    `)
      .bind(

        user.id,

        photoKey,

        title,

        description,

        whatsapp,

        call,

        adType,

        paymentStatus

      )
      .run();


  const adId =
    result.meta.last_row_id;


  /*
  ==============================================
  PAID PAYMENT RECORD
  ==============================================
  */

  if (paid) {

    const depositDate =
      clean(
        form.get("deposit_date"),
        30
      );


    if (!depositDate) {

      /*
      Remove the newly-created ad if the
      required deposit date is missing.
      */

      await env.DB.prepare(`
        DELETE FROM ads
        WHERE id = ?
          AND user_id = ?
          AND status = 'pending'
      `)
        .bind(
          adId,
          user.id
        )
        .run();


      return json(
        {
          error:
            "Bank deposit date is required."
        },
        400
      );
    }


    const paymentResult =
      await env.DB.prepare(`
        INSERT INTO payments (
          user_id,
          ad_id,
          amount,
          bank_name,
          branch_name,
          account_name,
          account_number,
          depositor_name,
          deposit_date,
          reference_number,
          slip_url,
          status
        )
        VALUES (
          ?,
          ?,
          ?,
          ?,
          ?,
          ?,
          ?,
          '',
          ?,
          '',
          ?,
          'pending'
        )
      `)
        .bind(

          user.id,

          adId,

          getPrice(adType),

          "People's Bank",

          "Udapussellawa",

          "Thinarathnam Saththiyanadan",

          "292200280023178",

          depositDate,

          slipKey

        )
        .run();


    /*
    Link payment to ad
    */

    await env.DB.prepare(`
      UPDATE ads
      SET payment_id = ?
      WHERE id = ?
    `)
      .bind(
        paymentResult.meta.last_row_id,
        adId
      )
      .run();
  }


  /*
  ==============================================
  SUCCESS
  ==============================================
  */

  return json({

    success: true,

    ad_id: adId,

    status:
      "pending",

    payment_status:
      paymentStatus

  });
}


/*
==================================================
MY ADS
==================================================
*/

async function handleMyAds(
  request,
  env
) {

  const user =
    await getUser(
      request,
      env
    );


  if (!user || !user.id) {

    return json(
      {
        error:
          "Unauthorized"
      },
      401
    );
  }


  const result =
    await env.DB.prepare(`
      SELECT
        id,
        title,
        description,
        whatsapp_no,
        call_no,
        ad_type,
        status,
        payment_status,
        rejection_reason,
        created_at,
        approved_at,
        expires_at
      FROM ads
      WHERE user_id = ?
      ORDER BY id DESC
    `)
      .bind(user.id)
      .all();


  return json({

    success: true,

    ads:
      result.results || []

  });
}


/*
==================================================
PUBLIC APPROVED ADS
==================================================
*/

async function handleApproved(
  request,
  env
) {

  const result =
    await env.DB.prepare(`
      SELECT
        id,
        photo_url,
        title,
        description,
        whatsapp_no,
        call_no,
        ad_type,
        approved_at,
        expires_at
      FROM ads
      WHERE status = 'approved'
        AND (
          expires_at IS NULL
          OR datetime(expires_at) > datetime('now')
        )
      ORDER BY
        CASE ad_type
          WHEN 'featured_urgent_top' THEN 1
          WHEN 'featured' THEN 2
          WHEN 'urgent' THEN 3
          WHEN 'top' THEN 4
          ELSE 5
        END,
        approved_at DESC
    `)
      .all();


  return json({

    success: true,

    ads:
      result.results || []

  });
}


/*
==================================================
PUBLIC PHOTO
==================================================
*/

async function handlePublicPhoto(
  request,
  env,
  key
) {

  if (
    !key.startsWith("ads/")
  ) {

    return new Response(
      "Not Found",
      {
        status: 404,
        headers:
          corsHeaders()
      }
    );
  }


  const ad =
    await env.DB.prepare(`
      SELECT id
      FROM ads
      WHERE photo_url = ?
        AND status = 'approved'
        AND (
          expires_at IS NULL
          OR datetime(expires_at) > datetime('now')
        )
      LIMIT 1
    `)
      .bind(key)
      .first();


  if (!ad) {

    return new Response(
      "Not Found",
      {
        status: 404,
        headers:
          corsHeaders()
      }
    );
  }


  const object =
    await env.JOBS_BUCKET.get(key);


  if (!object) {

    return new Response(
      "Not Found",
      {
        status: 404,
        headers:
          corsHeaders()
      }
    );
  }


  const headers =
    new Headers(
      corsHeaders()
    );


  object.writeHttpMetadata(
    headers
  );


  headers.set(
    "Cache-Control",
    "public, max-age=3600"
  );


  return new Response(
    object.body,
    {
      headers
    }
  );
}


/*
==================================================
MAIN WORKER
==================================================
*/

export default {

  async fetch(
    request,
    env
  ) {

    /*
    ----------------------------------------------
    CORS OPTIONS
    ----------------------------------------------
    */

    if (
      request.method === "OPTIONS"
    ) {

      return new Response(
        null,
        {
          status: 204,
          headers:
            corsHeaders()
        }
      );
    }


    const url =
      new URL(request.url);


    try {

      /*
      --------------------------------------------
      API STATUS
      --------------------------------------------
      */

      if (
        url.pathname === "/"
      ) {

        return json({

          service:
            "CreateLK Jobs Ads API",

          status:
            "online"

        });
      }


      /*
      --------------------------------------------
      UPLOAD
      --------------------------------------------
      */

      if (
        url.pathname === "/upload" &&
        request.method === "POST"
      ) {

        return await handleUpload(
          request,
          env
        );
      }


      /*
      --------------------------------------------
      CREATE AD
      --------------------------------------------
      */

      if (
        url.pathname === "/ads" &&
        request.method === "POST"
      ) {

        return await handleCreateAd(
          request,
          env
        );
      }


      /*
      --------------------------------------------
      MY ADS
      --------------------------------------------
      */

      if (
        url.pathname === "/my-ads" &&
        request.method === "GET"
      ) {

        return await handleMyAds(
          request,
          env
        );
      }


      /*
      --------------------------------------------
      APPROVED ADS
      --------------------------------------------
      */

      if (
        url.pathname === "/approved" &&
        request.method === "GET"
      ) {

        return await handleApproved(
          request,
          env
        );
      }


      /*
      --------------------------------------------
      PUBLIC PHOTO
      --------------------------------------------
      */

      if (
        url.pathname === "/photo" &&
        request.method === "GET"
      ) {

        const key =
          url.searchParams.get("key") || "";


        return await handlePublicPhoto(
          request,
          env,
          key
        );
      }


      /*
      --------------------------------------------
      NOT FOUND
      --------------------------------------------
      */

      return json(
        {
          error:
            "Not Found"
        },
        404
      );


    } catch (error) {

      console.error(error);


      return json(
        {
          error:
            "Server error."
        },
        500
      );
    }
  }
};