const ORIGIN = "https://createlk.com";
const MAX = 5 * 1024 * 1024;

const IMAGES = ["image/jpeg", "image/png", "image/webp"];
const SLIPS = [...IMAGES, "application/pdf"];

const PRICES = {
  free: 0,
  featured: 500,
  urgent: 500,
  top: 500,
  featured_urgent_top: 1500
};

const PAID = ["featured", "urgent", "top", "featured_urgent_top"];

const cors = {
  "Access-Control-Allow-Origin": ORIGIN,
  "Access-Control-Allow-Methods": "GET,POST,OPTIONS",
  "Access-Control-Allow-Headers": "Content-Type,Authorization"
};

function json(data, status = 200) {
  return new Response(JSON.stringify(data), {
    status,
    headers: {
      ...cors,
      "Content-Type": "application/json"
    }
  });
}

function token(request) {
  const h = request.headers.get("Authorization");
  return h?.startsWith("Bearer ") ? h.slice(7).trim() : null;
}


/* =========================================================
   AUTH
   expires_at = Unix seconds
   ========================================================= */

async function getUser(request, env) {

  const t = token(request);
  if (!t) return null;

  const s = await env.DB.prepare(`
    SELECT
      s.user_id,
      s.expires_at,
      u.google_id,
      u.name,
      u.email,
      u.photo_url,
      u.email_verified
    FROM sessions s
    JOIN users u ON u.id = s.user_id
    WHERE s.id = ?
    LIMIT 1
  `).bind(t).first();

  if (!s) return null;

  if (Number(s.expires_at) <= Math.floor(Date.now() / 1000)) {
    await env.DB.prepare(
      `DELETE FROM sessions WHERE id = ?`
    ).bind(t).run();

    return null;
  }

  return {
    id: s.user_id,
    google_id: s.google_id,
    name: s.name,
    email: s.email,
    photo_url: s.photo_url,
    email_verified: Number(s.email_verified) === 1
  };
}

async function auth(request, env) {
  const user = await getUser(request, env);

  return user
    ? user
    : null;
}


/* =========================================================
   UPLOAD
   ========================================================= */

async function upload(request, env) {

  const user = await auth(request, env);
  if (!user) return json({ error: "Unauthorized" }, 401);

  const form = await request.formData();
  const file = form.get("file");
  const folder = String(form.get("folder") || "ads");

  if (!(file instanceof File))
    return json({ error: "File is required." }, 400);

  if (file.size > MAX)
    return json({ error: "Maximum file size is 5 MB." }, 400);

  const allowed =
    folder === "payments" ? SLIPS : IMAGES;

  if (!allowed.includes(file.type))
    return json({ error: "Invalid file type." }, 400);

  const ext =
    file.type === "image/jpeg" ? "jpg" :
    file.type === "image/png" ? "png" :
    file.type === "image/webp" ? "webp" :
    "pdf";

  const key =
    `${folder}/${user.id}/${crypto.randomUUID()}.${ext}`;

  await env.JOBS_BUCKET.put(
    key,
    file.stream(),
    {
      httpMetadata: {
        contentType: file.type
      }
    }
  );

  return json({
    success: true,
    key
  });
}


/* =========================================================
   CREATE AD
   ========================================================= */

async function createAd(request, env) {

  const user = await auth(request, env);
  if (!user) return json({ error: "Unauthorized" }, 401);

  const b = await request.json();

  const photo = String(b.photo_url || "").trim();
  const title = String(b.title || "").trim();
  const description = String(b.description || "").trim();
  const whatsapp = String(b.whatsapp_no || "").trim();
  const call = String(b.call_no || "").trim();
  const type = String(b.ad_type || "free").trim();
  const slip = String(b.slip_url || "").trim();
  const depositDate = String(b.deposit_date || "").trim();

  const types = Object.keys(PRICES);

  if (!types.includes(type))
    return json({ error: "Invalid ad type." }, 400);

  if (!photo || !title || !description || !whatsapp || !call)
    return json({
      error: "Please complete all required fields."
    }, 400);


  /* ---------------------------------------------------------
     FREE AD: only approved ads count
     --------------------------------------------------------- */

  if (type === "free") {

    const existing = await env.DB.prepare(`
      SELECT id
      FROM ads
      WHERE user_id = ?
        AND ad_type = 'free'
        AND status = 'approved'
        AND approved_at IS NOT NULL
        AND datetime(approved_at)
            >= datetime('now', '-30 days')
      LIMIT 1
    `).bind(user.id).first();

    if (existing) {
      return json({
        error:
          "You already have an approved Free Ad. You can post another Free Ad after 30 days."
      }, 429);
    }
  }


  /* ---------------------------------------------------------
     PAYMENT
     --------------------------------------------------------- */

  let paymentId = null;

  if (PAID.includes(type)) {

    if (!slip || !depositDate)
      return json({
        error:
          "Bank slip and deposit date are required."
      }, 400);

    const payment = await env.DB.prepare(`
      INSERT INTO payments (
        user_id,
        ad_id,
        amount,
        bank_name,
        branch_name,
        account_name,
        account_number,
        depositor_name,
        deposit_date,
        reference_number,
        slip_url,
        status,
        rejection_reason,
        approved_at
      )
      VALUES (
        ?, NULL, ?,
        ?, ?, ?, ?,
        '', ?, '',
        ?, 'pending', '', NULL
      )
    `).bind(
      user.id,
      PRICES[type],
      "People's Bank",
      "Udapussellawa",
      "Thinarathnam Saththiyanadan",
      "292200280023178",
      depositDate,
      slip
    ).run();

    paymentId = payment.meta.last_row_id;
  }


  /* ---------------------------------------------------------
     AD
     --------------------------------------------------------- */

  const ad = await env.DB.prepare(`
    INSERT INTO ads (
      user_id,
      photo_url,
      title,
      description,
      whatsapp_no,
      call_no,
      ad_type,
      status,
      payment_status,
      payment_id,
      rejection_reason,
      created_at,
      approved_at,
      expires_at
    )
    VALUES (
      ?, ?, ?, ?, ?, ?, ?,
      'pending', ?, ?, '',
      CURRENT_TIMESTAMP, NULL, NULL
    )
  `).bind(
    user.id,
    photo,
    title,
    description,
    whatsapp,
    call,
    type,
    PAID.includes(type) ? "pending" : "not_required",
    paymentId
  ).run();

  const adId = ad.meta.last_row_id;

  if (paymentId) {
    await env.DB.prepare(`
      UPDATE payments
      SET ad_id = ?
      WHERE id = ?
    `).bind(adId, paymentId).run();
  }

  return json({
    success: true,
    ad_id: adId,
    payment_id: paymentId,
    status: "pending"
  }, 201);
}


/* =========================================================
   MY ADS
   ========================================================= */

async function myAds(request, env) {

  const user = await auth(request, env);
  if (!user) return json({ error: "Unauthorized" }, 401);

  const result = await env.DB.prepare(`
    SELECT
      id,
      photo_url,
      title,
      description,
      whatsapp_no,
      call_no,
      ad_type,
      status,
      payment_status,
      payment_id,
      rejection_reason,
      created_at,
      approved_at,
      expires_at
    FROM ads
    WHERE user_id = ?
    ORDER BY id DESC
  `).bind(user.id).all();

  return json({
    success: true,
    ads: result.results || []
  });
}


/* =========================================================
   PUBLIC ADS
   ========================================================= */

async function approved(request, env) {

  const result = await env.DB.prepare(`
    SELECT
      id,
      photo_url,
      title,
      description,
      whatsapp_no,
      call_no,
      ad_type,
      approved_at,
      expires_at
    FROM ads
    WHERE status = 'approved'
      AND (
        expires_at IS NULL
        OR datetime(expires_at) > datetime('now')
      )
    ORDER BY
      CASE ad_type
        WHEN 'featured_urgent_top' THEN 1
        WHEN 'featured' THEN 2
        WHEN 'urgent' THEN 3
        WHEN 'top' THEN 4
        ELSE 5
      END,
      approved_at DESC
  `).all();

  return json({
    success: true,
    ads: result.results || []
  });
}


/* =========================================================
   PUBLIC PHOTO
   ========================================================= */

async function photo(request, env) {

  const key =
    new URL(request.url).searchParams.get("key");

  if (!key || !key.startsWith("ads/"))
    return new Response("Forbidden", {
      status: 403,
      headers: cors
    });

  const ad = await env.DB.prepare(`
    SELECT id
    FROM ads
    WHERE photo_url = ?
      AND status = 'approved'
      AND (
        expires_at IS NULL
        OR datetime(expires_at) > datetime('now')
      )
    LIMIT 1
  `).bind(key).first();

  if (!ad)
    return new Response("Not found", {
      status: 404,
      headers: cors
    });

  const object =
    await env.JOBS_BUCKET.get(key);

  if (!object)
    return new Response("Not found", {
      status: 404,
      headers: cors
    });

  return new Response(object.body, {
    headers: {
      ...cors,
      "Content-Type":
        object.httpMetadata?.contentType ||
        "application/octet-stream",
      "Cache-Control":
        "public, max-age=3600"
    }
  });
}


/* =========================================================
   WORKER
   ========================================================= */

export default {

  async fetch(request, env) {

    if (request.method === "OPTIONS")
      return new Response(null, {
        status: 204,
        headers: cors
      });

    try {

      const path =
        new URL(request.url).pathname;

      if (path === "/")
        return json({
          success: true,
          service: "CreateLK Jobs Ads API",
          status: "online"
        });

      if (path === "/health")
        return json({
          success: true,
          status: "online"
        });

      if (
        path === "/upload" &&
        request.method === "POST"
      )
        return upload(request, env);

      if (
        path === "/ads" &&
        request.method === "POST"
      )
        return createAd(request, env);

      if (
        path === "/my-ads" &&
        request.method === "GET"
      )
        return myAds(request, env);

      if (
        path === "/approved" &&
        request.method === "GET"
      )
        return approved(request, env);

      if (
        path === "/photo" &&
        request.method === "GET"
      )
        return photo(request, env);

      return json({
        error: "Endpoint not found."
      }, 404);

    } catch (error) {

      console.error(error);

      return json({
        error: "Internal server error."
      }, 500);
    }
  }
};