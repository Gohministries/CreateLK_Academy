async function cleanup(e) {
  try {
    await e.DB.prepare(`
      DELETE FROM sessions
      WHERE expires_at <= ?
    `)
      .bind(
        Math.floor(Date.now() / 1000)
      )
      .run();
  } catch (err) {
    console.error(
      "Session cleanup error:",
      err
    );
  }
}

export default {
  async fetch(request, env) {
    if (request.method === "OPTIONS") {
      return new Response(
        null,
        {
          status: 204,
          headers: cors(request)
        }
      );
    }

    const url =
      new URL(request.url);

    const path =
      url.pathname.replace(/\/+$/, "") ||
      "/";

    try {
      if (
        request.method === "GET" &&
        path === "/health"
      ) {
        return health(request);
      }

      if (
        request.method === "POST" &&
        path === "/upload"
      ) {
        return upload(
          request,
          env
        );
      }

      if (
        request.method === "GET" &&
        path === "/locations"
      ) {
        return locations(
          request,
          env
        );
      }

      if (
        request.method === "POST" &&
        (
          path === "/create" ||
          path === "/ads"
        )
      ) {
        return createAd(
          request,
          env
        );
      }

      if (
        request.method === "GET" &&
        path === "/my-ads"
      ) {
        return myAds(
          request,
          env
        );
      }

      if (
        request.method === "GET" &&
        path === "/latest"
      ) {
        return latest(
          request,
          env
        );
      }

      if (
        request.method === "GET" &&
        path === "/photo"
      ) {
        return photo(
          request,
          env
        );
      }

      return json(
        {
          success: false,
          error: "Not found"
        },
        404,
        request
      );

    } catch (err) {
      console.error(err);

      return json(
        {
          success: false,
          error:
            err?.message ||
            "Internal server error"
        },
        500,
        request
      );
    }
  },

  async scheduled(event, env) {
    await cleanup(env);
  }
};