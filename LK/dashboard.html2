<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">

<title>CreateLK Jobs Dashboard</title>
<meta name="description" content="Manage your CreateLK Jobs advertisements and discover premium advertising benefits.">

<style>
*{
box-sizing:border-box;
margin:0;
padding:0;
}

:root{
--blue:#1261a0;
--blue-light:#eaf4fc;
--dark:#083d68;
--gold:#f2b705;
--gold-dark:#d99f00;
--bg:#f3f8fc;
--text:#172b3a;
--muted:#687b8b;
--border:#d9e5ee;
--green:#16834b;
--orange:#b86b00;
--red:#c52b22;
}

body{
font-family:Arial,Helvetica,sans-serif;
background:linear-gradient(180deg,#edf6fc,#f9fcff);
color:var(--text);
min-height:100vh;
line-height:1.45;
}

button,
a{
font-family:inherit;
}

header{
background:linear-gradient(135deg,var(--dark),var(--blue));
color:#fff;
padding:12px 20px;
box-shadow:0 3px 15px #0002;
position:sticky;
top:0;
z-index:20;
}

.header-inner{
max-width:1200px;
margin:auto;
display:flex;
align-items:center;
justify-content:space-between;
gap:15px;
}

.brand{
display:flex;
align-items:center;
gap:10px;
color:#fff;
text-decoration:none;
font-weight:800;
font-size:20px;
}

.brand img{
width:43px;
height:43px;
object-fit:contain;
border-radius:9px;
background:#fff;
padding:3px;
}

.logout{
border:1px solid #ffffff55;
background:#ffffff12;
color:#fff;
padding:9px 16px;
border-radius:8px;
cursor:pointer;
font-weight:700;
font-size:14px;
}

.logout:hover{
background:#ffffff22;
}

main{
max-width:1200px;
margin:auto;
padding:30px 20px 60px;
}

.welcome{
margin-bottom:20px;
}

.welcome h1{
font-size:30px;
line-height:1.2;
color:var(--dark);
margin-bottom:7px;
}

.welcome p{
font-size:15px;
color:var(--muted);
}

/* PROFILE */

.profile-card{
background:#fff;
border:1px solid var(--border);
border-radius:16px;
padding:20px 22px;
display:flex;
align-items:center;
gap:17px;
box-shadow:0 7px 25px #1261a012;
margin-bottom:20px;
}

.profile-photo{
width:68px;
height:68px;
border-radius:50%;
object-fit:cover;
background:#e7eef5;
border:2px solid #e6eef5;
}

.profile-info h2{
font-size:20px;
margin-bottom:4px;
}

.profile-info p{
font-size:14px;
color:var(--muted);
margin:3px 0;
}

.verified{
color:var(--green)!important;
font-weight:700;
}

/* PRIMARY ACTIONS */

.primary-actions{
display:grid;
grid-template-columns:1fr 1fr;
gap:16px;
margin-bottom:28px;
}

.primary-action{
position:relative;
display:flex;
align-items:center;
gap:16px;
padding:20px;
border-radius:16px;
text-decoration:none;
border:1px solid transparent;
transition:
transform .18s ease,
box-shadow .18s ease,
border-color .18s ease;
overflow:hidden;
}

.primary-action:hover{
transform:translateY(-2px);
box-shadow:0 10px 25px #1261a01c;
}

.primary-action:active{
transform:translateY(0);
}

.primary-action.post{
background:linear-gradient(135deg,#fff8d9,#fffdf4);
border-color:#ead27b;
}

.primary-action.ads{
background:linear-gradient(135deg,#eef7fd,#fff);
border-color:#cfe2f1;
}

.action-icon{
width:52px;
height:52px;
min-width:52px;
border-radius:13px;
display:flex;
align-items:center;
justify-content:center;
font-size:25px;
font-weight:800;
}

.post .action-icon{
background:#fff0b5;
color:#866500;
}

.ads .action-icon{
background:#dceefb;
color:var(--blue);
}

.action-content{
flex:1;
}

.action-content h2{
font-size:19px;
color:var(--dark);
margin-bottom:3px;
}

.action-content p{
font-size:13px;
color:var(--muted);
line-height:1.45;
}

.action-arrow{
font-size:23px;
font-weight:700;
color:var(--dark);
}

/* ERROR */

.api-error{
display:none;
background:#fff1ef;
color:#a5231b;
border:1px solid #efc0bc;
padding:12px 15px;
border-radius:9px;
margin-bottom:20px;
font-size:14px;
}

/* SECTION */

.section-title{
font-size:22px;
color:var(--dark);
margin:28px 0 14px;
}

/* STATUS */

.status-grid{
display:grid;
grid-template-columns:repeat(4,1fr);
gap:14px;
margin-bottom:15px;
}

.status-card{
background:#fff;
border:1px solid var(--border);
border-radius:13px;
padding:18px;
box-shadow:0 5px 18px #0000000c;
}

.status-card h3{
font-size:13px;
color:var(--muted);
margin-bottom:8px;
}

.status-number{
font-size:28px;
font-weight:800;
line-height:1.1;
}

.pending{
color:var(--orange);
}

.approved{
color:var(--green);
}

.rejected{
color:var(--red);
}

.remaining{
background:linear-gradient(135deg,#fff9df,#fffdf5);
border-color:#ead27b;
}

.remaining .status-number{
color:#856400;
}

.refresh{
margin-top:2px;
border:0;
background:var(--blue);
color:#fff;
padding:10px 17px;
border-radius:8px;
cursor:pointer;
font-weight:700;
font-size:14px;
}

.refresh:hover{
background:var(--dark);
}

.refresh:disabled,
.logout:disabled{
opacity:.6;
cursor:not-allowed;
}

/* INFO */

.info-grid{
display:grid;
grid-template-columns:1fr 1fr;
gap:18px;
margin-top:20px;
}

.info-card{
background:#fff;
border-radius:16px;
padding:23px;
border:1px solid var(--border);
box-shadow:0 6px 22px #1261a012;
}

.info-card.free{
border-top:5px solid var(--blue);
}

.info-card.premium{
border-top:5px solid var(--gold);
}

.info-card h2{
font-size:20px;
color:var(--dark);
margin-bottom:9px;
}

.info-card.premium h2{
color:#765900;
}

.info-card>p{
font-size:14px;
color:var(--muted);
line-height:1.55;
margin-bottom:16px;
}

.benefits{
list-style:none;
display:grid;
gap:9px;
}

.benefits li{
padding:9px 11px;
border-radius:8px;
background:#f5f9fc;
font-size:14px;
color:#40586a;
}

.benefits li::before{
content:"✓";
color:var(--green);
font-weight:900;
margin-right:8px;
}

.premium-list li::before{
content:"★";
color:var(--gold-dark);
}

.premium-types{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:9px;
margin-top:15px;
}

.premium-type{
background:#fff9df;
border:1px solid #ead27b;
border-radius:9px;
padding:11px;
}

.premium-type strong{
display:block;
color:#765900;
font-size:14px;
margin-bottom:3px;
}

.premium-type span{
font-size:12px;
color:#766c4d;
}

/* LOADING */

.status{
position:fixed;
inset:0;
display:flex;
align-items:center;
justify-content:center;
background:var(--bg);
z-index:100;
padding:20px;
}

.status-box{
background:#fff;
width:min(420px,100%);
padding:30px;
text-align:center;
border-radius:15px;
box-shadow:0 8px 30px #0002;
}

.status-box h2{
color:var(--dark);
margin-bottom:9px;
font-size:22px;
}

.status-box p{
color:var(--muted);
line-height:1.5;
font-size:14px;
}

.btn{
display:inline-block;
text-decoration:none;
background:var(--blue);
color:#fff;
padding:11px 17px;
border-radius:8px;
font-weight:700;
}

.btn:hover{
background:var(--dark);
}

.hidden{
display:none!important;
}

/* TABLET */

@media(max-width:850px){

.status-grid{
grid-template-columns:repeat(2,1fr);
}

.info-grid{
grid-template-columns:1fr;
}

.premium-types{
grid-template-columns:repeat(3,1fr);
}

}

/* MOBILE */

@media(max-width:600px){

header{
padding:10px 14px;
}

.brand{
font-size:16px;
}

.brand img{
width:39px;
height:39px;
}

.logout{
padding:8px 12px;
font-size:13px;
}

main{
padding:22px 14px 45px;
}

.welcome{
margin-bottom:16px;
}

.welcome h1{
font-size:24px;
margin-bottom:5px;
}

.welcome p{
font-size:14px;
}

/* PROFILE */

.profile-card{
padding:16px;
gap:13px;
margin-bottom:16px;
}

.profile-photo{
width:58px;
height:58px;
}

.profile-info h2{
font-size:18px;
}

.profile-info p{
font-size:13px;
}

/* PRIMARY ACTIONS */

.primary-actions{
grid-template-columns:1fr;
gap:11px;
margin-bottom:24px;
}

.primary-action{
min-height:82px;
padding:15px;
gap:13px;
border-radius:14px;
}

.action-icon{
width:46px;
height:46px;
min-width:46px;
font-size:22px;
border-radius:11px;
}

.action-content h2{
font-size:17px;
}

.action-content p{
font-size:12.5px;
}

.action-arrow{
font-size:21px;
}

/* STATUS */

.section-title{
font-size:19px;
margin:24px 0 12px;
}

.status-grid{
grid-template-columns:1fr 1fr;
gap:9px;
}

.status-card{
padding:14px;
border-radius:11px;
}

.status-card h3{
font-size:12px;
margin-bottom:7px;
}

.status-number{
font-size:23px;
}

.refresh{
width:100%;
padding:11px 15px;
font-size:13px;
}

/* INFO */

.info-grid{
gap:13px;
margin-top:17px;
}

.info-card{
padding:18px;
border-radius:14px;
}

.info-card h2{
font-size:18px;
}

.info-card>p{
font-size:13px;
}

.benefits li{
font-size:13px;
padding:8px 10px;
}

.premium-types{
grid-template-columns:1fr;
gap:8px;
}

.premium-type{
padding:10px;
}

.premium-type strong{
font-size:13px;
}

.premium-type span{
font-size:11px;
}

}

/* VERY SMALL PHONES */

@media(max-width:380px){

main{
padding-left:11px;
padding-right:11px;
}

.brand span{
display:none;
}

.welcome h1{
font-size:22px;
}

.profile-card{
padding:14px;
}

.status-card{
padding:12px;
}

.status-number{
font-size:21px;
}

.action-content h2{
font-size:16px;
}

.action-content p{
font-size:12px;
}

}
</style>
</head>

<body>

<div id="loading" class="status">
<div class="status-box">
<h2>Loading...</h2>
<p>Checking your CreateLK Jobs account.</p>
</div>
</div>

<div id="errorScreen" class="status hidden">
<div class="status-box">
<h2>Session Required</h2>
<p id="errorMessage">Please sign in to your CreateLK Jobs account.</p>
<br>
<a class="btn" href="https://createlk.com/LK/login.html">Sign In</a>
</div>
</div>

<div id="app" class="hidden">

<header>
<div class="header-inner">

<a class="brand" href="https://createlk.com/">
<img
src="https://assets.createlk.com/file_00000000f05482118c11cccfc653fd0f.png"
alt="CreateLK Jobs">
<span>CreateLK Jobs</span>
</a>

<button id="logoutBtn" class="logout" type="button">
Logout
</button>

</div>
</header>

<main>

<section class="welcome">
<h1 id="welcomeTitle">Welcome</h1>
<p>Manage your advertisements and grow your reach on CreateLK Jobs.</p>
</section>

<div id="apiError" class="api-error"></div>

<section class="profile-card">

<img
id="profilePhoto"
class="profile-photo"
src=""
alt="Profile photo">

<div class="profile-info">
<h2 id="profileName">User</h2>
<p id="profileEmail">-</p>
<p id="profileVerified" class="verified">Account</p>
</div>

</section>

<!-- PRIMARY ACTIONS -->

<section class="primary-actions">

<a class="primary-action post" href="/LK/post-ad.html">

<div class="action-icon">＋</div>

<div class="action-content">
<h2>Post an Ad</h2>
<p>Create a new job advertisement and reach job seekers.</p>
</div>

<div class="action-arrow">›</div>

</a>

<a class="primary-action ads" href="/LK/my-ads.html">

<div class="action-icon">▤</div>

<div class="action-content">
<h2>My Ads</h2>
<p>View, manage and check the status of your advertisements.</p>
</div>

<div class="action-arrow">›</div>

</a>

</section>

<h2 class="section-title">Advertisement Overview</h2>

<div class="status-grid">

<div class="status-card">
<h3>Pending</h3>
<div id="pendingCount" class="status-number pending">0</div>
</div>

<div class="status-card">
<h3>Approved</h3>
<div id="approvedCount" class="status-number approved">0</div>
</div>

<div class="status-card">
<h3>Rejected</h3>
<div id="rejectedCount" class="status-number rejected">0</div>
</div>

<div class="status-card remaining">
<h3>Free Ad Remaining</h3>
<div id="freeRemaining" class="status-number">Available</div>
</div>

</div>

<button id="refreshBtn" class="refresh" type="button">
Refresh Ads
</button>

<h2 class="section-title">Advertising Options</h2>

<section class="info-grid">

<div class="info-card free">

<h2>Free Advertisement</h2>

<p>
Post your job at no cost and make it visible to job seekers
across Sri Lanka.
</p>

<ul class="benefits">
<li>Post for Rs. 0</li>
<li>30-day advertisement period</li>
<li>Reach Sri Lankan job seekers</li>
<li>Easy online advertisement submission</li>
</ul>

</div>

<div class="info-card premium">

<h2>Premium Advertisement</h2>

<p>
Give your vacancy more visibility with premium placement
options designed to help job seekers notice your advertisement.
</p>

<ul class="benefits premium-list">
<li>More prominent placement</li>
<li>Premium label on your advertisement</li>
<li>Priority visibility in job listings</li>
<li>Choose the promotion that fits your needs</li>
</ul>

<div class="premium-types">

<div class="premium-type">
<strong>Featured</strong>
<span>Rs. 500 • 30 days</span>
</div>

<div class="premium-type">
<strong>Urgent</strong>
<span>Rs. 500 • 30 days</span>
</div>

<div class="premium-type">
<strong>Top</strong>
<span>Rs. 500 • 30 days</span>
</div>

</div>

<div class="premium-type" style="margin-top:9px">
<strong>Featured + Urgent + Top</strong>
<span>Rs. 1,500 • 30 days</span>
</div>

</div>

</section>

</main>
</div>

<script>
const LOGIN_API="https://login.createlk.workers.dev";
const ADS_API="https://ads.createlk.workers.dev";
const LOGIN_PAGE="https://createlk.com/LK/login.html";
const TOKEN_KEY="createlk_session_token";
const CUSTOMER_KEY="createlk_customer";

const $=id=>document.getElementById(id);

function showError(message){

$("loading").classList.add("hidden");
$("app").classList.add("hidden");

$("errorMessage").textContent=
message||"Please sign in to continue.";

$("errorScreen").classList.remove("hidden");
}

function showApp(){

$("loading").classList.add("hidden");
$("errorScreen").classList.add("hidden");
$("app").classList.remove("hidden");
}

function getToken(){
return sessionStorage.getItem(TOKEN_KEY);
}

function saveUser(user){

try{
sessionStorage.setItem(
CUSTOMER_KEY,
JSON.stringify(user)
);
}catch(e){
console.error(e);
}
}

async function exchangeTicket(ticket){

const response=await fetch(
LOGIN_API+"/exchange?ticket="+
encodeURIComponent(ticket),
{
method:"GET",
cache:"no-store"
}
);

const data=await response
.json()
.catch(()=>({}));

if(
!response.ok||
!data.success||
!data.token
){
throw new Error(
data.error||
"Login session could not be created."
);
}

sessionStorage.setItem(
TOKEN_KEY,
data.token
);

if(data.user){
saveUser(data.user);
}

return data;
}

async function getMe(token){

const response=await fetch(
LOGIN_API+"/me",
{
method:"GET",
headers:{
Authorization:"Bearer "+token
},
cache:"no-store"
}
);

const data=await response
.json()
.catch(()=>({}));

if(
response.status===401||
response.status===403||
!response.ok||
!data.success
){
throw new Error(
data.error||
"Your session has expired."
);
}

return data;
}

function displayUser(user){

const name=
user.name||
"CreateLK Jobs User";

$("profileName").textContent=name;

$("profileEmail").textContent=
user.email||"";

$("welcomeTitle").textContent=
"Welcome, "+name;

if(user.photo_url){

$("profilePhoto").src=
user.photo_url;

}else{

$("profilePhoto")
.removeAttribute("src");

}

$("profileVerified").textContent=
user.email_verified===true||
user.email_verified===1
?"✓ Google account verified"
:"Google account";
}

function daysLeft(date){

const end=
new Date(date).getTime();

if(!Number.isFinite(end)){
return null;
}

const now=Date.now();

if(end<=now){
return 0;
}

return Math.ceil(
(end-now)/86400000
);
}

function updateFreeRemaining(ads){

const freeAds=ads.filter(
ad=>
String(ad.ad_type||"")
.toLowerCase()==="free"
);

if(!freeAds.length){

$("freeRemaining")
.textContent="Available";

return;
}

const activeFree=freeAds
.filter(ad=>{

const status=
String(ad.status||"")
.toLowerCase();

return status==="pending"||
status==="approved";

})
.sort((a,b)=>{

const da=
Date.parse(a.created_at||"")||0;

const db=
Date.parse(b.created_at||"")||0;

return db-da;

})[0];

if(!activeFree){

$("freeRemaining")
.textContent="Available";

return;
}

const days=
daysLeft(activeFree.expires_at);

if(days===null){

$("freeRemaining")
.textContent="Active";

return;
}

if(days<=0){

$("freeRemaining")
.textContent="Expired";

return;
}

$("freeRemaining").textContent=
days+
" day"+
(days===1?"":"s");
}

async function loadMyAds(){

const token=getToken();

if(!token){
throw new Error(
"Login session not found."
);
}

$("apiError").style.display="none";

try{

const response=await fetch(
ADS_API+"/my-ads",
{
method:"GET",
headers:{
Authorization:"Bearer "+token,
Accept:"application/json"
},
cache:"no-store"
}
);

const text=await response.text();

let data={};

try{

data=text?
JSON.parse(text):
{};

}catch{

throw new Error(
"Ads Worker returned an invalid response."
);

}

if(
response.status===401||
response.status===403
){

throw new Error(
"Ads Worker rejected your login session."
);

}

if(!response.ok){

throw new Error(
data.error||
"Could not load your advertisements."
);

}

if(!data.success){

throw new Error(
data.error||
"Could not load your advertisements."
);

}

const ads=
Array.isArray(data.ads)?
data.ads:
[];

let pending=0;
let approved=0;
let rejected=0;

ads.forEach(ad=>{

const status=
String(ad.status||"")
.trim()
.toLowerCase();

if(status==="pending"){
pending++;
}

else if(status==="approved"){
approved++;
}

else if(status==="rejected"){
rejected++;
}

});

$("pendingCount").textContent=
pending;

$("approvedCount").textContent=
approved;

$("rejectedCount").textContent=
rejected;

updateFreeRemaining(ads);

return true;

}catch(error){

console.error(error);

$("pendingCount").textContent="—";
$("approvedCount").textContent="—";
$("rejectedCount").textContent="—";

$("apiError").textContent=
"Unable to load your advertisements: "+
(error.message||"Unknown error");

$("apiError").style.display="block";

return false;
}

}

function removeTicketFromURL(){

history.replaceState(
{},
document.title,
location.origin+
location.pathname
);
}

async function logout(){

const token=getToken();

$("logoutBtn").disabled=true;
$("logoutBtn").textContent=
"Logging out...";

try{

if(token){

await fetch(
LOGIN_API+"/logout",
{
method:"GET",
headers:{
Authorization:"Bearer "+token
},
cache:"no-store"
}
);

}

}catch(e){

console.error(e);

}

sessionStorage.removeItem(
TOKEN_KEY
);

sessionStorage.removeItem(
CUSTOMER_KEY
);

location.replace(LOGIN_PAGE);
}

$("logoutBtn").addEventListener(
"click",
logout
);

$("refreshBtn").addEventListener(
"click",
async function(){

this.disabled=true;
this.textContent=
"Refreshing...";

await loadMyAds();

this.disabled=false;
this.textContent=
"Refresh Ads";
}
);

async function start(){

try{

const params=
new URLSearchParams(
location.search
);

const ticket=
params.get("ticket");

let token=getToken();

if(ticket){

const result=
await exchangeTicket(ticket);

token=result.token;

removeTicketFromURL();

}

if(!token){

showError(
"Please sign in to your CreateLK Jobs account to continue."
);

return;
}

const result=
await getMe(token);

if(!result.user){

throw new Error(
"User information is missing."
);

}

saveUser(result.user);

displayUser(result.user);

showApp();

await loadMyAds();

}catch(error){

console.error(
"Dashboard error:",
error
);

sessionStorage.removeItem(
TOKEN_KEY
);

sessionStorage.removeItem(
CUSTOMER_KEY
);

showError(
error.message||
"Your login session could not be verified."
);
}

}

start();
</script>

</body>
</html>