const MSG1 = `📋 Have you created your CreateLK Jobs Job Seeker Profile yet?
https://createlk.com/LK/wanted.html`;

const MSG2 = `📝 Just a friendly reminder from CreateLK Jobs.
Create your Job Seeker Profile and let employers find you.
https://createlk.com/LK/wanted.html`;

const MSG3 = `👤 Final reminder from CreateLK Jobs.
If you're still looking for a job, create your Job Seeker Profile here:
https://createlk.com/LK/wanted.html`;

export default {

  async fetch(request, env) {
    const url = new URL(request.url);

    if (request.method === "OPTIONS") {
      return new Response(null, { headers: cors() });
    }

    if (url.pathname === "/") {
      return json({ success: true, service: "CreateLK SMS Follow-up" });
    }

    if (url.pathname === "/api/leads" && request.method === "POST") {
      const body = await request.json();

      if (body.admin_key !== env.ADMIN_KEY)
        return json({ success:false, error:"Unauthorized" }, 401);

      if (!body.phone)
        return json({ success:false, error:"Phone number required" }, 400);

      const phone = normalizePhone(body.phone);

      const existing = await env.DB.prepare(
        `SELECT id FROM leads WHERE phone=? AND completed=0 LIMIT 1`
      ).bind(phone).first();

      if (existing)
        return json({ success:false, error:"Lead already exists" }, 409);

      await env.DB.prepare(`
        INSERT INTO leads
        (name,phone,created_at)
        VALUES (?,?,?)
      `).bind(
        body.name || "",
        phone,
        new Date().toISOString()
      ).run();

      return json({ success:true, message:"Lead added" });
    }

    if (url.pathname === "/api/leads" && request.method === "GET") {
      if (url.searchParams.get("key") !== env.ADMIN_KEY)
        return json({ success:false, error:"Unauthorized" }, 401);

      const { results } = await env.DB.prepare(`
        SELECT *
        FROM leads
        ORDER BY id DESC
      `).all();

      return json({ success:true, leads:results });
    }

    if (url.pathname === "/api/complete" && request.method === "POST") {
      const body = await request.json();

      if (body.admin_key !== env.ADMIN_KEY)
        return json({ success:false, error:"Unauthorized" }, 401);

      await env.DB.prepare(`
        UPDATE leads
        SET completed=1
        WHERE id=?
      `).bind(body.id).run();

      return json({ success:true });
    }

    return json({ success:false, error:"Not found" }, 404);
  },

  async scheduled(event, env, ctx) {
    ctx.waitUntil(runFollowups(env));
  }

};


async function runFollowups(env) {

  const { results } = await env.DB.prepare(`
    SELECT *
    FROM leads
    WHERE completed=0
  `).all();

  const now = Date.now();

  for (const lead of results) {

    const created =
      new Date(lead.created_at).getTime();

    const days =
      (now - created) / 86400000;

    let message = null;
    let field = null;

    /*
      Day 1 → Message 1
      Day 3 → Message 2
      Day 7 → Message 3
    */

    if (days >= 7 && !lead.message3_sent) {
      message = MSG3;
      field = "message3_sent";

    } else if (days >= 3 && !lead.message2_sent) {
      message = MSG2;
      field = "message2_sent";

    } else if (days >= 1 && !lead.message1_sent) {
      message = MSG1;
      field = "message1_sent";
    }

    if (!message) continue;

    try {

      const response = await fetch(
        "https://smslenz.lk/api/send-sms",
        {
          method: "POST",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify({
            user_id: env.SMSLENZ_USER_ID,
            api_key: env.SMSLENZ_API_KEY,
            sender_id: env.SMSLENZ_SENDER_ID,
            contact: lead.phone,
            message: message
          })
        }
      );

      const result = await response.json();

      if (
        response.ok &&
        (
          result.success === true ||
          result.status === "success"
        )
      ) {

        await env.DB.prepare(`
          UPDATE leads
          SET ${field}=1
          WHERE id=?
        `).bind(lead.id).run();

      } else {
        console.log("SMS failed:", result);
      }

    } catch (error) {
      console.log("SMS error:", error);
    }
  }
}


function normalizePhone(phone) {

  phone = String(phone)
    .replace(/\s+/g, "")
    .replace(/-/g, "");

  if (phone.startsWith("07"))
    return "+94" + phone.substring(1);

  if (phone.startsWith("947"))
    return "+" + phone;

  return phone;
}


function cors() {
  return {
    "Access-Control-Allow-Origin": "https://createlk.com",
    "Access-Control-Allow-Headers": "Content-Type",
    "Access-Control-Allow-Methods": "GET,POST,OPTIONS"
  };
}


function json(data, status=200) {

  return new Response(
    JSON.stringify(data),
    {
      status,
      headers: {
        "Content-Type": "application/json",
        ...cors()
      }
    }
  );
}