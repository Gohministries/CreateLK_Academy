/* =========================================================
   APPROVE AD
========================================================= */

async function approveAd(
  request,
  env,
  id
) {

  const check =
    await requireAdmin(
      request,
      env
    );

  if (!check.ok)
    return check.response;


  const ad =
    await env.DB.prepare(`
      SELECT
        id,
        ad_type,
        status,
        payment_id
      FROM ads
      WHERE id = ?
      LIMIT 1
    `)
    .bind(id)
    .first();


  if (!ad) {

    return json({
      success: false,
      error: "Ad not found."
    }, 404);

  }


  if (ad.status !== "pending") {

    return json({
      success: false,
      error:
        "Only pending ads can be approved."
    }, 400);

  }


  /*
    ONE-CLICK APPROVAL

    If this ad has a payment record,
    automatically approve that payment.

    No separate payment approval
    is required.
  */

  if (ad.payment_id) {

    const payment =
      await env.DB.prepare(`
        SELECT id
        FROM payments
        WHERE id = ?
        LIMIT 1
      `)
      .bind(ad.payment_id)
      .first();


    if (payment) {

      await env.DB.prepare(`
        UPDATE payments
        SET
          status = 'approved',
          approved_at =
            CURRENT_TIMESTAMP,
          rejection_reason = ''
        WHERE id = ?
      `)
      .bind(ad.payment_id)
      .run();

    }

  }


  await env.DB.prepare(`
    UPDATE ads
    SET
      status = 'approved',

      payment_status =
        CASE
          WHEN payment_id IS NOT NULL
          THEN 'approved'
          ELSE payment_status
        END,

      approved_at =
        CURRENT_TIMESTAMP,

      expires_at =
        datetime('now', '+30 days'),

      rejection_reason = ''

    WHERE id = ?
  `)
  .bind(id)
  .run();


  return json({

    success: true,

    message:
      "Advertisement approved successfully."

  });

}


/* =========================================================
   REJECT AD
========================================================= */

async function rejectAd(
  request,
  env,
  id
) {

  const check =
    await requireAdmin(
      request,
      env
    );

  if (!check.ok)
    return check.response;


  let body = {};

  try {

    body =
      await request.json();

  } catch {}


  const reason =
    String(
      body.rejection_reason || ""
    ).trim();


  if (!reason) {

    return json({
      success: false,
      error:
        "Rejection reason is required."
    }, 400);

  }


  const ad =
    await env.DB.prepare(`
      SELECT
        id,
        status,
        payment_id
      FROM ads
      WHERE id = ?
      LIMIT 1
    `)
    .bind(id)
    .first();


  if (!ad) {

    return json({
      success: false,
      error: "Ad not found."
    }, 404);

  }


  if (ad.status !== "pending") {

    return json({
      success: false,
      error:
        "Only pending ads can be rejected."
    }, 400);

  }


  await env.DB.prepare(`
    UPDATE ads
    SET
      status = 'rejected',
      rejection_reason = ?
    WHERE id = ?
  `)
  .bind(reason, id)
  .run();


  /*
    If the ad has a payment record,
    keep the payment synchronized
    with the rejected advertisement.
  */

  if (ad.payment_id) {

    await env.DB.prepare(`
      UPDATE payments
      SET
        status = 'rejected',
        rejection_reason = ?
      WHERE id = ?
        AND status = 'pending'
    `)
    .bind(
      reason,
      ad.payment_id
    )
    .run();

  }


  return json({

    success: true,

    message:
      "Advertisement rejected successfully."

  });

}


/* =========================================================
   WORKER
========================================================= */

export default {

  async fetch(request, env) {

    if (
      request.method === "OPTIONS"
    ) {

      return new Response(
        null,
        {
          status: 204,
          headers: cors
        }
      );

    }


    try {

      const url =
        new URL(request.url);

      const path =
        url.pathname;


      /* HEALTH */

      if (
        path === "/health" &&
        request.method === "GET"
      ) {

        return health(
          request,
          env
        );

      }


      /* STATS */

      if (
        path === "/stats" &&
        request.method === "GET"
      ) {

        return stats(
          request,
          env
        );

      }


      /* ADS */

      if (
        path === "/ads" &&
        request.method === "GET"
      ) {

        return adminAds(
          request,
          env
        );

      }


      /* PHOTO */

      if (
        path === "/photo" &&
        request.method === "GET"
      ) {

        return photo(
          request,
          env
        );

      }


      /* APPROVE AD */

      const approveAdMatch =
        path.match(
          /^\/ads\/(\d+)\/approve$/
        );


      if (
        approveAdMatch &&
        request.method === "POST"
      ) {

        return approveAd(
          request,
          env,
          approveAdMatch[1]
        );

      }


      /* REJECT AD */

      const rejectAdMatch =
        path.match(
          /^\/ads\/(\d+)\/reject$/
        );


      if (
        rejectAdMatch &&
        request.method === "POST"
      ) {

        return rejectAd(
          request,
          env,
          rejectAdMatch[1]
        );

      }


      /* PAYMENT SLIP */

      if (
        path === "/slip" &&
        request.method === "GET"
      ) {

        return slip(
          request,
          env
        );

      }


      return json({

        success: false,

        error:
          "Endpoint not found."

      }, 404);


    } catch (error) {

      console.error(
        "ADMIN WORKER ERROR:",
        error
      );


      return json({

        success: false,

        error:
          "Internal server error."

      }, 500);

    }

  }

};