/* =========================================================
   STATS
========================================================= */

async function stats(request, env) {

  const check =
    await requireAdmin(
      request,
      env
    );

  if (!check.ok)
    return check.response;


  const pendingAds =
    await env.DB.prepare(`
      SELECT COUNT(*) AS count
      FROM ads
      WHERE status = 'pending'
    `)
    .first();


  const approvedAds =
    await env.DB.prepare(`
      SELECT COUNT(*) AS count
      FROM ads
      WHERE status = 'approved'
    `)
    .first();


  const rejectedAds =
    await env.DB.prepare(`
      SELECT COUNT(*) AS count
      FROM ads
      WHERE status = 'rejected'
    `)
    .first();


  const users =
    await env.DB.prepare(`
      SELECT COUNT(*) AS count
      FROM users
    `)
    .first();


  const totalAds =
    await env.DB.prepare(`
      SELECT COUNT(*) AS count
      FROM ads
    `)
    .first();


  return json({

    success: true,

    pending_ads:
      Number(
        pendingAds?.count || 0
      ),

    approved_ads:
      Number(
        approvedAds?.count || 0
      ),

    rejected_ads:
      Number(
        rejectedAds?.count || 0
      ),

    users:
      Number(
        users?.count || 0
      ),

    total_ads:
      Number(
        totalAds?.count || 0
      )

  });

}


/* =========================================================
   PENDING ADS
========================================================= */

async function adminAds(request, env) {

  const check =
    await requireAdmin(
      request,
      env
    );

  if (!check.ok)
    return check.response;


  const result =
    await env.DB.prepare(`
      SELECT

        a.id,
        a.user_id,
        a.photo_url,
        a.title,
        a.description,
        a.whatsapp_no,
        a.call_no,
        a.province,
        a.district,
        a.city,
        a.ad_type,
        a.status,
        a.payment_status,
        a.payment_id,
        a.rejection_reason,
        a.created_at,
        a.approved_at,
        a.expires_at,

        u.name AS user_name,
        u.email AS user_email,

        p.amount AS payment_amount,
        p.bank_name,
        p.branch_name,
        p.account_name,
        p.account_number,
        p.deposit_date,
        p.reference_number,
        p.slip_url,
        p.status AS payment_record_status,
        p.rejection_reason
          AS payment_rejection_reason,
        p.created_at
          AS payment_created_at,
        p.approved_at
          AS payment_approved_at

      FROM ads a

      JOIN users u
        ON u.id = a.user_id

      LEFT JOIN payments p
        ON p.id = a.payment_id

      WHERE a.status = 'pending'

      ORDER BY a.id DESC
    `)
    .all();


  return json({

    success: true,

    ads:
      result.results || []

  });

}


/* =========================================================
   AD PHOTO
   GET /photo?key=ads/...
========================================================= */

async function photo(request, env) {

  const check =
    await requireAdmin(
      request,
      env
    );

  if (!check.ok)
    return check.response;


  const key =
    new URL(request.url)
      .searchParams
      .get("key");


  if (
    !key ||
    !key.startsWith("ads/")
  ) {

    return new Response(
      "Forbidden",
      {
        status: 403,
        headers: cors
      }
    );

  }


  const ad =
    await env.DB.prepare(`
      SELECT id
      FROM ads
      WHERE photo_url = ?
      LIMIT 1
    `)
    .bind(key)
    .first();


  if (!ad) {

    return new Response(
      "Not found",
      {
        status: 404,
        headers: cors
      }
    );

  }


  const object =
    await env.JOBS_BUCKET.get(key);


  if (!object) {

    return new Response(
      "Not found",
      {
        status: 404,
        headers: cors
      }
    );

  }


  return new Response(
    object.body,
    {
      status: 200,
      headers: {
        ...cors,
        "Content-Type":
          object.httpMetadata?.contentType ||
          "application/octet-stream",
        "Cache-Control":
          "private, no-store"
      }
    }
  );

}


