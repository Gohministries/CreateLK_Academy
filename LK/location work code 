const corsHeaders = {
"Access-Control-Allow-Origin": "https://createlk.com",
"Access-Control-Allow-Methods": "GET, OPTIONS",
"Access-Control-Allow-Headers": "Content-Type",
"Access-Control-Max-Age": "86400"
};

function json(data, status = 200) {
return new Response(JSON.stringify(data), {
status,
headers: {
"Content-Type": "application/json; charset=UTF-8",
...corsHeaders
}
});
}

export default {
async fetch(request, env) {
if (request.method === "OPTIONS") {
return new Response(null, {
status: 204,
headers: corsHeaders
});
}

const url = new URL(request.url);  

if (request.method === "GET" && url.pathname === "/health") {  
  return json({  
    success: true,  
    service: "CreateLK Jobs Locations API",  
    status: "online"  
  });  
}  

if (request.method === "GET" && url.pathname === "/locations") {  
  try {  
    const result = await env.DB.prepare(`  
      SELECT  
        id,  
        province,  
        district,  
        city  
      FROM locations  
      ORDER BY province ASC, district ASC, city ASC  
    `).all();  

    return json({  
      success: true,  
      locations: result.results || []  
    });  
  } catch (error) {  
    return json({  
      success: false,  
      error: "Unable to load locations."  
    }, 500);  
  }  
}  

if (request.method === "GET" && url.pathname === "/provinces") {  
  try {  
    const result = await env.DB.prepare(`  
      SELECT DISTINCT province  
      FROM locations  
      WHERE province IS NOT NULL  
        AND province != ''  
      ORDER BY province ASC  
    `).all();  

    return json({  
      success: true,  
      provinces: (result.results || []).map(item => item.province)  
    });  
  } catch (error) {  
    return json({  
      success: false,  
      error: "Unable to load provinces."  
    }, 500);  
  }  
}  

if (request.method === "GET" && url.pathname === "/districts") {  
  const province = url.searchParams.get("province");  

  try {  
    let result;  

    if (province) {  
      result = await env.DB.prepare(`  
        SELECT DISTINCT district  
        FROM locations  
        WHERE province = ?  
          AND district IS NOT NULL  
          AND district != ''  
        ORDER BY district ASC  
      `).bind(province).all();  
    } else {  
      result = await env.DB.prepare(`  
        SELECT DISTINCT district  
        FROM locations  
        WHERE district IS NOT NULL  
          AND district != ''  
        ORDER BY district ASC  
      `).all();  
    }  

    return json({  
      success: true,  
      districts: (result.results || []).map(item => item.district)  
    });  
  } catch (error) {  
    return json({  
      success: false,  
      error: "Unable to load districts."  
    }, 500);  
  }  
}  

if (request.method === "GET" && url.pathname === "/cities") {  
  const province = url.searchParams.get("province");  
  const district = url.searchParams.get("district");  

  try {  
    let result;  

    if (province && district) {  
      result = await env.DB.prepare(`  
        SELECT DISTINCT city  
        FROM locations  
        WHERE province = ?  
          AND district = ?  
          AND city IS NOT NULL  
          AND city != ''  
        ORDER BY city ASC  
      `).bind(province, district).all();  
    } else if (province) {  
      result = await env.DB.prepare(`  
        SELECT DISTINCT city  
        FROM locations  
        WHERE province = ?  
          AND city IS NOT NULL  
          AND city != ''  
        ORDER BY city ASC  
      `).bind(province).all();  
    } else {  
      result = await env.DB.prepare(`  
        SELECT DISTINCT city  
        FROM locations  
        WHERE city IS NOT NULL  
          AND city != ''  
        ORDER BY city ASC  
      `).all();  
    }  

    return json({  
      success: true,  
      cities: (result.results || []).map(item => item.city)  
    });  
  } catch (error) {  
    return json({  
      success: false,  
      error: "Unable to load cities."  
    }, 500);  
  }  
}  

if (request.method === "GET" && url.pathname === "/") {  
  return json({  
    success: true,  
    service: "CreateLK Jobs Locations API",  
    endpoints: [  
      "/health",  
      "/locations",  
      "/provinces",  
      "/districts",  
      "/cities"  
    ]  
  });  
}  

return json({  
  success: false,  
  error: "Not Found"  
}, 404);

}
};