<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">

<title>CreateLK Jobs | Find Jobs & Hire Talent in Sri Lanka</title>
<meta name="description" content="Find jobs, discover opportunities and hire talent across Sri Lanka on CreateLK Jobs.">
<meta name="theme-color" content="#102a56">

<link rel="icon" href="https://assets.createlk.com/file_00000000f05482118c11cccfc653fd0f.png">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">

<style>
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{
font-family:Arial,Helvetica,sans-serif;
background:#f7f9fc;
color:#172033;
line-height:1.5
}
a{text-decoration:none;color:inherit}
button,input,select{font:inherit}
.container{width:min(1120px,92%);margin:auto}

header{
background:#fff;
border-bottom:1px solid #e7ebf2;
position:sticky;
top:0;
z-index:1000
}

.header{
min-height:70px;
display:flex;
align-items:center;
justify-content:space-between;
gap:20px
}

.logo{
display:flex;
align-items:center;
gap:9px;
color:#102a56;
font-size:19px;
font-weight:800
}

.logo img{
width:40px;
height:40px;
object-fit:contain;
border-radius:8px
}

.nav{
display:flex;
align-items:center;
gap:18px
}

.nav a{
font-size:13px;
font-weight:700;
color:#455168
}

.nav a:hover{color:#102a56}

.nav .login{
border:1px solid #d9e0ea;
padding:9px 14px;
border-radius:7px
}

.nav .register{
background:#102a56;
color:#fff;
padding:10px 15px;
border-radius:7px
}

.nav .post{
background:#d69b16;
color:#fff;
padding:10px 15px;
border-radius:7px
}

.menu{
display:none;
border:0;
background:none;
color:#102a56;
font-size:26px;
cursor:pointer
}

.mobile-menu{
display:none;
background:#fff;
border-top:1px solid #eee;
padding:10px 5%
}

.mobile-menu a{
display:block;
text-align:center;
padding:11px;
margin:3px 0;
font-size:13px;
font-weight:700;
color:#455168
}

.mobile-menu .mobile-post{
background:#d69b16;
color:#fff;
border-radius:7px
}

.hero{
padding:58px 0 70px;
background:
radial-gradient(circle at 20% 20%,#e5efff,transparent 35%),
radial-gradient(circle at 80% 20%,#fff2cc,transparent 35%),
linear-gradient(135deg,#f9fbff,#eef3fb)
}

.hero-content{
max-width:760px;
margin:auto;
text-align:center
}

.badge{
display:inline-flex;
background:#fff;
border:1px solid #dce3ed;
color:#102a56;
padding:7px 13px;
border-radius:30px;
font-size:12px;
font-weight:800;
margin-bottom:18px
}

.hero h1{
font-family:"Playfair Display",serif;
color:#102a56;
font-size:clamp(34px,5vw,50px);
line-height:1.15;
margin-bottom:15px
}

.hero h1 span{color:#d69b16}

.hero p{
max-width:620px;
margin:auto;
color:#667287;
font-size:15px;
line-height:1.7
}

.hero-actions{
display:flex;
justify-content:center;
align-items:center;
gap:10px;
flex-wrap:wrap;
margin-top:24px
}

.btn{
display:inline-flex;
align-items:center;
justify-content:center;
min-height:43px;
padding:0 18px;
border-radius:7px;
background:#102a56;
border:1px solid #102a56;
color:#fff;
font-size:13px;
font-weight:800;
cursor:pointer
}

.btn:hover{opacity:.9}
.btn-gold{
background:#d69b16;
border-color:#d69b16
}

.search-section{
margin-top:-28px;
position:relative;
z-index:5
}

.search{
background:#fff;
border:1px solid #e0e5ed;
border-radius:12px;
padding:13px;
box-shadow:0 10px 30px rgba(16,42,86,.08);
display:grid;
grid-template-columns:1fr 1.5fr 1fr 1fr 1fr auto;
gap:9px
}

.search input,
.search select{
width:100%;
height:45px;
border:1px solid #dce2ea;
border-radius:7px;
padding:0 12px;
background:#fff;
color:#3e4a60;
outline:none;
font-size:13px
}

.search input:focus,
.search select:focus{
border-color:#102a56
}

.search select:disabled{
background:#f1f4f8;
color:#8a94a5
}

.search button{
height:45px;
border:0;
border-radius:7px;
padding:0 20px;
background:#102a56;
color:#fff;
font-size:13px;
font-weight:800;
cursor:pointer
}

.section{padding:58px 0 0}

.section-heading{
text-align:center;
margin-bottom:25px
}

.section-heading h2{
font-family:"Playfair Display",serif;
color:#102a56;
font-size:28px;
margin-bottom:6px
}

.section-heading p{
color:#718096;
font-size:13px
}

.jobs{
display:flex;
flex-direction:column;
align-items:center;
gap:16px
}

.job{
width:100%;
max-width:900px;
background:#fff;
border:1px solid #e1e6ee;
border-radius:11px;
overflow:hidden;
transition:.2s;
box-shadow:0 3px 12px rgba(16,42,86,.03)
}

.job:hover{
transform:translateY(-3px);
box-shadow:0 10px 25px rgba(16,42,86,.08)
}

.job-main{
display:grid;
grid-template-columns:220px 1fr;
min-height:230px
}

.photo-wrap{
width:100%;
height:100%;
min-height:230px
}

.job-photo{
width:100%;
height:100%;
min-height:230px;
object-fit:cover;
display:block;
background:#eef2f7
}

.no-photo{
width:100%;
height:100%;
min-height:230px;
display:flex;
align-items:center;
justify-content:center;
background:#eef2f7;
color:#718096;
font-size:12px;
font-weight:700
}

.job-content{
padding:24px;
display:flex;
flex-direction:column;
align-items:center;
justify-content:center;
text-align:center
}

.job-location{
width:100%;
color:#6b7280;
font-size:11px;
font-weight:700;
margin-bottom:10px
}

.job-title{
color:#102a56;
font-family:"Playfair Display",serif;
font-size:21px;
font-weight:700;
line-height:1.35;
margin-bottom:10px
}

.description{
max-width:570px;
color:#68748a;
font-size:13px;
line-height:1.7;
display:-webkit-box;
-webkit-line-clamp:5;
-webkit-box-orient:vertical;
overflow:hidden
}

.job-actions{
display:grid;
grid-template-columns:1fr 1fr;
gap:10px;
padding:13px;
border-top:1px solid #edf0f4
}

.contact-btn{
height:44px;
display:flex;
align-items:center;
justify-content:center;
border-radius:7px;
font-size:13px;
font-weight:800;
border:0;
cursor:pointer
}

.whatsapp{
background:#168b45;
color:#fff
}

.call{
background:#102a56;
color:#fff
}

.disabled{
background:#e3e7ed;
color:#8993a4;
cursor:not-allowed
}

.status{
width:100%;
max-width:900px;
text-align:center;
background:#fff;
border:1px solid #e1e6ee;
border-radius:11px;
padding:35px 20px;
color:#718096;
font-size:13px
}

.status strong{
display:block;
color:#102a56;
font-size:15px;
margin-bottom:4px
}

.error strong{color:#b42318}

.cta-section{padding:58px 0 65px}

.cta{
background:#102a56;
border-radius:13px;
padding:36px 30px;
text-align:center;
color:#fff
}

.cta h2{
font-family:"Playfair Display",serif;
color:#fff;
font-size:27px;
margin-bottom:7px
}

.cta p{
color:#cbd5e4;
font-size:13px;
margin-bottom:20px
}

.cta .btn{
background:#d69b16;
border-color:#d69b16
}

footer{
background:#0c1e3c;
color:#aebbd0;
text-align:center
}

.footer{
padding:40px 0 28px;
display:grid;
grid-template-columns:2fr 1fr 1fr 1fr;
gap:25px
}

.footer-column{text-align:center}

.footer-logo{
display:flex;
justify-content:center;
align-items:center;
gap:8px;
color:#fff;
font-size:17px;
font-weight:800;
margin-bottom:10px
}

.footer-logo img{
width:36px;
height:36px;
object-fit:contain
}

.footer-description{
max-width:300px;
margin:auto;
font-size:11px;
line-height:1.7
}

.footer h3{
color:#fff;
font-size:13px;
margin-bottom:10px
}

.footer a{
display:block;
color:#aebbd0;
font-size:11px;
margin:6px 0
}

.footer a:hover{color:#fff}

.copyright{
border-top:1px solid #263a58;
padding:16px 5%;
color:#8190a8;
font-size:10px
}

@media(max-width:1000px){

.nav{gap:10px}
.nav a{font-size:11px}

.search{
grid-template-columns:1fr 1fr
}

.search button{
grid-column:1/-1
}

.footer{
grid-template-columns:repeat(2,1fr)
}

}

@media(max-width:700px){

.container{width:90%}

.nav{display:none}
.menu{display:block}

.hero{padding:48px 0 60px}

.hero h1{font-size:35px}
.hero p{font-size:14px}

.search{
grid-template-columns:1fr;
padding:11px
}

.search button{grid-column:auto}

.section{padding-top:50px}

.section-heading h2{font-size:25px}

.footer{
grid-template-columns:1fr
}

.job-main{
grid-template-columns:1fr
}

.photo-wrap{
height:210px;
min-height:210px
}

.job-photo,
.no-photo{
height:210px;
min-height:210px
}

.job-content{
padding:22px 18px
}

.job-title{font-size:20px}
.description{font-size:13px}

.job-actions{
grid-template-columns:1fr 1fr
}

.contact-btn{height:44px}

.cta{padding:32px 20px}

}

@media(max-width:450px){

.hero h1{font-size:32px}

.hero-actions{
flex-direction:column
}

.hero-actions .btn{
width:100%;
max-width:280px
}

.job-actions{
gap:8px;
padding:11px
}

.contact-btn{font-size:12px}

}
</style>
</head>

<body>

<header>

<div class="container header">

<a href="index.html" class="logo">
<img src="https://assets.createlk.com/file_00000000f05482118c11cccfc653fd0f.png" alt="CreateLK Jobs">
<span>CreateLK Jobs</span>
</a>

<nav class="nav">

<a href="index.html">Home</a>
<a href="LK/jobs.html">Find Jobs</a>
<a href="LK/categories.html">Categories</a>
<a href="LK/companies.html">Companies</a>
<a href="LK/login.html" class="login">Login</a>
<a href="LK/register.html" class="register">Register</a>
<a href="LK/login.html" class="post">Post a Job</a>

</nav>

<button class="menu" id="menuBtn">☰</button>

</div>

<div class="mobile-menu" id="mobileMenu">

<a href="index.html">Home</a>
<a href="LK/jobs.html">Find Jobs</a>
<a href="LK/categories.html">Categories</a>
<a href="LK/companies.html">Companies</a>
<a href="LK/login.html">Login</a>
<a href="LK/register.html">Register</a>
<a href="LK/login.html" class="mobile-post">➕ Post a Job</a>

</div>

</header>


<main>

<section class="hero">

<div class="container hero-content">

<div class="badge">🇱🇰 Sri Lanka Job Marketplace</div>

<h1>Find Your Next <span>Opportunity</span></h1>

<p>
Discover jobs, connect with employers and take the next step in your career with CreateLK Jobs.
</p>

<div class="hero-actions">

<a href="LK/jobs.html" class="btn">🔎 Find Jobs</a>

<a href="LK/login.html" class="btn btn-gold">➕ Post a Job</a>

</div>

</div>

</section>


<section class="search-section">

<div class="container">

<form class="search" id="searchForm">

<select id="category">
<option value="">All Categories</option>
</select>

<input
type="search"
id="searchInput"
placeholder="Job title, keyword or company..."
autocomplete="off">

<select id="province">
<option value="">All Provinces</option>
</select>

<select id="district" disabled>
<option value="">All Districts</option>
</select>

<select id="city" disabled>
<option value="">All Cities</option>
</select>

<button type="submit">🔎 Search Jobs</button>

</form>

</div>

</section>


<section class="section">

<div class="container">

<div class="section-heading">

<h2>Recent Jobs</h2>

<p>Latest approved job opportunities.</p>

</div>

<div class="jobs" id="featuredJobs">

<div class="status">
<strong>Loading jobs...</strong>
Please wait.
</div>

</div>

</div>

</section>


<section class="cta-section">

<div class="container">

<div class="cta">

<h2>Are You Hiring?</h2>

<p>
Post your vacancy and connect with talented people.
</p>

<a href="LK/login.html" class="btn">Post a Job</a>

</div>

</div>

</section>

</main>


<footer>

<div class="container footer">

<div class="footer-column">

<div class="footer-logo">

<img src="https://assets.createlk.com/file_00000000f05482118c11cccfc653fd0f.png" alt="CreateLK Jobs">

<span>CreateLK Jobs</span>

</div>

<p class="footer-description">
Find jobs, discover opportunities and connect with employers.
</p>

</div>


<div class="footer-column">

<h3>Job Seekers</h3>

<a href="LK/jobs.html">Find Jobs</a>
<a href="LK/applications.html">Applications</a>
<a href="LK/dashboard.html">My Account</a>
<a href="LK/dashboard.html">Dashboard</a>

</div>


<div class="footer-column">

<h3>Employers</h3>

<a href="LK/login.html">Post a Job</a>
<a href="LK/my-jobs.html">My Posted Jobs</a>
<a href="LK/companies.html">Companies</a>

</div>


<div class="footer-column">

<h3>Information</h3>

<a href="LK/about.html">About Us</a>
<a href="LK/contact.html">Contact Us</a>
<a href="LK/terms.html">Terms</a>
<a href="LK/privacy.html">Privacy</a>
<a href="LK/refund.html">Refund Policy</a>

</div>

</div>

<div class="copyright">
© 2026 CreateLK Jobs. All rights reserved.
</div>

</footer>


<script>

const ADS_API="https://ads.createlk.workers.dev";
const CATEGORY_API="https://categories.createlk.workers.dev";

const category=document.getElementById("category");
const province=document.getElementById("province");
const district=document.getElementById("district");
const city=document.getElementById("city");
const searchInput=document.getElementById("searchInput");
const searchForm=document.getElementById("searchForm");
const jobsBox=document.getElementById("featuredJobs");

let approvedAds=[];


/* MENU */

document.getElementById("menuBtn").onclick=()=>{
const menu=document.getElementById("mobileMenu");
menu.style.display=menu.style.display==="block"?"none":"block";
};


/* API */

async function getJSON(url){

const response=await fetch(url,{
cache:"no-store",
headers:{Accept:"application/json"}
});

if(!response.ok){
throw new Error("HTTP "+response.status);
}

return response.json();

}


/* ESCAPE */

function esc(value){

return String(value??"")
.replace(/[&<>"']/g,c=>({
"&":"&amp;",
"<":"&lt;",
">":"&gt;",
'"':"&quot;",
"'":"&#039;"
}[c]));

}


/* PHONE */

function cleanPhone(value){

let p=String(value||"")
.replace(/[^\d+]/g,"");

if(p.startsWith("+")){
p=p.substring(1);
}

if(p.startsWith("0")){
p="94"+p.substring(1);
}

return p;

}


/* PHOTO */

function getPhoto(value){

if(!value)return "";

if(/^https?:\/\//i.test(value)){
return value;
}

return ADS_API+"/photo?key="+encodeURIComponent(value);

}


/* CATEGORIES */

async function loadCategories(){

try{

const data=await getJSON(
CATEGORY_API+"/categories"
);

const list=
Array.isArray(data.categories)
?data.categories
:[];

category.innerHTML=
'<option value="">All Categories</option>';

list.forEach(item=>{

const option=document.createElement("option");

option.value=
item.id??item.slug??item.name;

option.textContent=
item.name??item.slug??"";

option.dataset.name=
item.name??"";

option.dataset.slug=
item.slug??"";

category.appendChild(option);

});

}catch(error){

console.error("Categories:",error);

}

}


/* PROVINCES */

async function loadProvinces(){

try{

const data=await getJSON(
ADS_API+"/locations"
);

const list=
Array.isArray(data.provinces)
?data.provinces
:[];

province.innerHTML=
'<option value="">All Provinces</option>';

list.forEach(item=>{

const option=document.createElement("option");

option.value=item;
option.textContent=item;

province.appendChild(option);

});

}catch(error){

console.error("Provinces:",error);

}

}


/* DISTRICTS */

async function loadDistricts(name){

district.innerHTML=
'<option value="">All Districts</option>';

city.innerHTML=
'<option value="">All Cities</option>';

district.disabled=true;
city.disabled=true;

if(!name)return;

try{

const data=await getJSON(
ADS_API+
"/locations?province="+
encodeURIComponent(name)
);

const list=
Array.isArray(data.districts)
?data.districts
:[];

list.forEach(item=>{

const option=document.createElement("option");

option.value=item;
option.textContent=item;

district.appendChild(option);

});

district.disabled=false;

}catch(error){

console.error("Districts:",error);

}

}


/* CITIES */

async function loadCities(p,d){

city.innerHTML=
'<option value="">All Cities</option>';

city.disabled=true;

if(!p||!d)return;

try{

const data=await getJSON(
ADS_API+
"/locations?province="+
encodeURIComponent(p)+
"&district="+
encodeURIComponent(d)
);

const list=
Array.isArray(data.cities)
?data.cities
:[];

list.forEach(item=>{

const option=document.createElement("option");

option.value=item;
option.textContent=item;

city.appendChild(option);

});

city.disabled=false;

}catch(error){

console.error("Cities:",error);

}

}


/* LOCATION */

province.onchange=async()=>{

await loadDistricts(province.value);

filterJobs();

};

district.onchange=async()=>{

await loadCities(
province.value,
district.value
);

filterJobs();

};

city.onchange=filterJobs;
category.onchange=filterJobs;


/* SEARCH */

searchForm.onsubmit=e=>{

e.preventDefault();
filterJobs();

};


/* CATEGORY MATCH */

function categoryMatch(ad){

const selected=category.value;

if(!selected)return true;

const option=
category.options[category.selectedIndex];

const id=
String(selected).toLowerCase();

const name=
String(option?.dataset.name||"").toLowerCase();

const slug=
String(option?.dataset.slug||"").toLowerCase();

const adId=
String(
ad.category_id??
ad.categoryId??
""
).toLowerCase();

const adCategory=
String(
ad.category??
ad.category_name??
ad.categoryName??
ad.category_slug??
""
).toLowerCase();

return(
adId===id||
adCategory===id||
adCategory===name||
adCategory===slug
);

}


/* FILTER */

function filterJobs(){

const q=
searchInput.value.trim().toLowerCase();

const p=
province.value.toLowerCase();

const d=
district.value.toLowerCase();

const c=
city.value.toLowerCase();

const filtered=
approvedAds.filter(ad=>{

const title=
String(ad.title||"").toLowerCase();

const description=
String(ad.description||"").toLowerCase();

const adProvince=
String(ad.province||"").toLowerCase();

const adDistrict=
String(ad.district||"").toLowerCase();

const adCity=
String(ad.city||"").toLowerCase();

return(
(!q||
title.includes(q)||
description.includes(q))&&
(!p||adProvince===p)&&
(!d||adDistrict===d)&&
(!c||adCity===c)&&
categoryMatch(ad)
);

});

renderJobs(filtered);

}


/* LOAD APPROVED */

async function loadJobs(){

jobsBox.innerHTML=`
<div class="status">
<strong>Loading jobs...</strong>
Please wait.
</div>
`;

try{

const data=
await getJSON(
ADS_API+"/approved"
);

approvedAds=
Array.isArray(data.ads)
?data.ads
:[];


approvedAds.sort((a,b)=>{

const aDate=
Date.parse(a.approved_at||"");

const bDate=
Date.parse(b.approved_at||"");

return(
(bDate||0)-
(aDate||0)
);

});


filterJobs();

}catch(error){

console.error(
"Approved ads:",
error
);

jobsBox.innerHTML=`

<div class="status error">

<strong>
Jobs could not be loaded.
</strong>

Please try again later.

</div>

`;

}

}


/* RENDER */

function renderJobs(ads){

jobsBox.innerHTML="";

const list=ads.slice(0,6);

if(!list.length){

jobsBox.innerHTML=`

<div class="status">

<strong>
No approved jobs found.
</strong>

Try another search or location.

</div>

`;

return;

}


list.forEach(ad=>{

const title=
ad.title||
"Job Opportunity";

const description=
ad.description||
"No description provided.";

const location=[
ad.province,
ad.district,
ad.city
]
.filter(Boolean)
.join(" • ");

const image=getPhoto(
ad.photo_url||
ad.photo||
ad.photo_key
);

const whatsapp=
String(ad.whatsapp_no||"").trim();

const call=
String(ad.call_no||"").trim();


const card=document.createElement("article");

card.className="job";

card.innerHTML=`

<div class="job-main">

<div class="photo-wrap">

${
image
?
`
<img
class="job-photo"
src="${esc(image)}"
alt="${esc(title)}"
loading="lazy"
onerror="this.style.display='none';this.nextElementSibling.style.display='flex';">

<div class="no-photo" style="display:none">
No Photo
</div>
`
:
`
<div class="no-photo">
No Photo
</div>
`
}

</div>


<div class="job-content">

${
location
?
`
<div class="job-location">
📍 ${esc(location)}
</div>
`
:""
}


<div class="job-title">
${esc(title)}
</div>


<p class="description">
${esc(description)}
</p>

</div>

</div>


<div class="job-actions">

${
whatsapp
?
`
<a
class="contact-btn whatsapp"
href="https://wa.me/${cleanPhone(whatsapp)}"
target="_blank"
rel="noopener noreferrer">

WhatsApp

</a>
`
:
`
button
class="contact-btn disabled"
disabled>

WhatsApp

</button>
`
}


${
call
?
`
<a
class="contact-btn call"
href="tel:${cleanPhone(call)}">

Call

</a>
`
:
`
<button
class="contact-btn disabled"
disabled>

Call

</button>
`
}

</div>

`;


jobsBox.appendChild(card);

});

}


/* START */

Promise.all([
loadCategories(),
loadProvinces(),
loadJobs()
]);

</script>

</body>
</html>