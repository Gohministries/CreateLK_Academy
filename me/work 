const TTL=86400,MAX=60*1024*1024;

export default{
 async fetch(r,e){
  try{
   const u=new URL(r.url),p=u.pathname;

   if(p==="/api/login/status")return status(r,e);
   if(p==="/api/login"&&r.method==="POST")return login(r,e);
   if(p==="/api/logout"&&r.method==="POST")return logout();

   if(!p.startsWith("/api/"))
    return e.ASSETS.fetch(r);

   if(!await auth(r,e))
    return J({error:"Unauthorized."},401);

   if(p==="/api/vault/meta")
    return r.method==="GET"?meta(e):saveMeta(r,e);

   if(p==="/api/categories")
    return r.method==="GET"?categories(e):addCategory(r,e);

   if(p==="/api/stats")
    return stats(e);

   if(p==="/api/items")
    return r.method==="GET"?items(e):addItem(r,e);

   let m=p.match(/^\/api\/items\/(\d+)$/);
   if(m){
    const id=+m[1];
    if(r.method==="PUT")return editItem(r,e,id);
    if(r.method==="DELETE")return delItem(e,id);
   }

   if(p==="/api/photos")
    return r.method==="GET"?photos(e):upload(r,e);

   m=p.match(/^\/api\/photos\/(\d+)\/download$/);
   if(m&&r.method==="GET")return download(e,+m[1]);

   m=p.match(/^\/api\/photos\/(\d+)$/);
   if(m&&r.method==="DELETE")return delPhoto(e,+m[1]);

   return J({error:"API route not found."},404);
  }catch(x){
   return J({error:x.message||"Server error."},500);
  }
 }
};

async function login(r,e){
 let s=await e.DB.prepare(
  "SELECT * FROM login_security WHERE id=1"
 ).first();

 if(!s){
  await e.DB.prepare(
   "INSERT OR IGNORE INTO login_security(id) VALUES(1)"
  ).run();
  s={failed_attempts:0,blocked:0};
 }

 if(s.blocked)
  return J({error:"Login blocked after 3 failed attempts."},429);

 const b=await r.json();

 if(
  String(b.username)!==String(e.VAULT_USER)||
  String(b.password)!==String(e.VAULT_PASSWORD)
 ){
  const n=Number(s.failed_attempts)+1;

  if(n>=3){
   await e.DB.prepare(
    "UPDATE login_security SET failed_attempts=3,blocked=1 WHERE id=1"
   ).run();

   return J({
    error:"Login blocked after 3 failed attempts."
   },429);
  }

  await e.DB.prepare(
   "UPDATE login_security SET failed_attempts=? WHERE id=1"
  ).bind(n).run();

  return J({
   error:"Invalid username or password."
  },401);
 }

 await e.DB.prepare(
  "UPDATE login_security SET failed_attempts=0,blocked=0 WHERE id=1"
 ).run();

 const payload=b64(
  new TextEncoder().encode(
   JSON.stringify({
    exp:Date.now()+TTL*1000,
    n:crypto.randomUUID()
   })
  )
 );

 const sig=await sign(payload,e.SESSION_SECRET);

 return J(
  {authenticated:true},
  200,
  {
   "Set-Cookie":
   `session=${payload}.${sig}; HttpOnly; Secure; SameSite=Strict; Path=/; Max-Age=${TTL}`
  }
 );
}

async function status(r,e){
 return J({
  authenticated:await auth(r,e)
 });
}

async function logout(){
 return J(
  {success:true},
  200,
  {
   "Set-Cookie":
   "session=; HttpOnly; Secure; SameSite=Strict; Path=/; Max-Age=0"
  }
 );
}

async function auth(r,e){
 const c=r.headers.get("Cookie")||"";

 const t=c.split(";")
  .map(x=>x.trim())
  .find(x=>x.startsWith("session="))
  ?.slice(8);

 if(!t)return false;

 try{
  const [a,s]=t.split(".");
  const p=JSON.parse(
   new TextDecoder().decode(fb64(a))
  );

  return p.exp>Date.now() &&
   s===await sign(a,e.SESSION_SECRET);
 }catch{
  return false;
 }
}

async function sign(v,s){
 const k=await crypto.subtle.importKey(
  "raw",
  new TextEncoder().encode(s),
  {name:"HMAC",hash:"SHA-256"},
  false,
  ["sign"]
 );

 return b64(
  new Uint8Array(
   await crypto.subtle.sign(
    "HMAC",
    k,
    new TextEncoder().encode(v)
   )
  )
 );
}

async function meta(e){
 const x=await e.DB.prepare(
  "SELECT salt,verifier FROM vault_meta WHERE id=1"
 ).first();

 return J(
  x?{exists:true,...x}:{exists:false}
 );
}

async function saveMeta(r,e){
 const b=await r.json();

 if(!b.salt||!b.verifier)
  return J({
   error:"Invalid vault metadata."
  },400);

 const old=await e.DB.prepare(
  "SELECT id FROM vault_meta WHERE id=1"
 ).first();

 if(old)
  return J({
   error:"Vault already initialized."
  },409);

 await e.DB.prepare(
  "INSERT INTO vault_meta(id,salt,verifier) VALUES(1,?,?)"
 ).bind(
  b.salt,
  b.verifier
 ).run();

 return J({success:true});
}

async function categories(e){
 const x=await e.DB.prepare(
  "SELECT id,name FROM categories ORDER BY id"
 ).all();

 return J({
  categories:x.results
 });
}

async function addCategory(r,e){
 const b=await r.json();
 const name=String(b.name||"").trim();

 if(!name)
  return J({error:"Category name is required."},400);

 try{
  await e.DB.prepare(
   "INSERT INTO categories(name) VALUES(?)"
  ).bind(name).run();
 }catch{
  return J({error:"Category already exists."},409);
 }

 return J({success:true});
}

async function stats(e){
 const a=await e.DB.prepare(
  "SELECT COUNT(*) n FROM vault_items"
 ).first();

 const b=await e.DB.prepare(
  "SELECT COUNT(*) n FROM files"
 ).first();

 const c=await e.DB.prepare(
  "SELECT COUNT(*) n FROM categories"
 ).first();

 const d=await e.DB.prepare(
  "SELECT COUNT(*) n FROM vault_items WHERE created_at>=datetime('now','-7 days')"
 ).first();

 return J({
  total_items:Number(a.n),
  total_files:Number(b.n),
  total_categories:Number(c.n),
  recent_items:Number(d.n)
 });
}

async function items(e){
 const x=await e.DB.prepare(
  `SELECT id,category,title,username,
   encrypted_password,encrypted_backup_codes,
   encrypted_notes,created_at,updated_at
   FROM vault_items
   ORDER BY updated_at DESC,id DESC`
 ).all();

 return J({
  items:x.results
 });
}

async function addItem(r,e){
 const b=await r.json();

 if(!b.category||!b.title)
  return J({
   error:"Category and title are required."
  },400);

 await e.DB.prepare(
  `INSERT INTO vault_items
   (category,title,username,encrypted_password,
    encrypted_backup_codes,encrypted_notes)
   VALUES(?,?,?,?,?,?)`
 ).bind(
  b.category,
  b.title,
  b.username||"",
  b.encrypted_password||"",
  b.encrypted_backup_codes||"",
  b.encrypted_notes||""
 ).run();

 return J({success:true});
}

async function editItem(r,e,id){
 const b=await r.json();

 if(!b.category||!b.title)
  return J({
   error:"Category and title are required."
  },400);

 await e.DB.prepare(
  `UPDATE vault_items SET
   category=?,title=?,username=?,
   encrypted_password=?,
   encrypted_backup_codes=?,
   encrypted_notes=?,
   updated_at=CURRENT_TIMESTAMP
   WHERE id=?`
 ).bind(
  b.category,
  b.title,
  b.username||"",
  b.encrypted_password||"",
  b.encrypted_backup_codes||"",
  b.encrypted_notes||"",
  id
 ).run();

 return J({success:true});
}

async function delItem(e,id){
 await e.DB.prepare(
  "DELETE FROM vault_items WHERE id=?"
 ).bind(id).run();

 return J({success:true});
}

async function photos(e){
 const x=await e.DB.prepare(
  `SELECT id,filename,file_type,file_size,created_at
   FROM files ORDER BY id DESC`
 ).all();

 return J({
  files:x.results
 });
}

async function upload(r,e){
 const f=await r.formData();
 const file=f.get("file");

 if(!(file instanceof File))
  return J({error:"File required."},400);

 if(file.size>MAX+12)
  return J({
   error:"Maximum file size is 60 MB."
  },413);

 const key="vault/"+crypto.randomUUID();

 await e.PHOTOS.put(
  key,
  file.stream(),
  {
   httpMetadata:{
    contentType:"application/octet-stream"
   }
  }
 );

 try{
  await e.DB.prepare(
   `INSERT INTO files
    (filename,r2_key,file_type,file_size)
    VALUES(?,?,?,?)`
  ).bind(
   String(f.get("filename")||"file").slice(0,200),
   key,
   String(f.get("file_type")||""),
   Number(f.get("file_size"))||0
  ).run();
 }catch(x){
  await e.PHOTOS.delete(key);
  throw x;
 }

 return J({success:true});
}

async function download(e,id){
 const x=await e.DB.prepare(
  "SELECT r2_key FROM files WHERE id=?"
 ).bind(id).first();

 if(!x)
  return J({error:"File not found."},404);

 const o=await e.PHOTOS.get(x.r2_key);

 if(!o)
  return J({
   error:"Stored file not found."
  },404);

 return new Response(o.body,{
  headers:{
   "Content-Type":"application/octet-stream",
   "Cache-Control":"no-store"
  }
 });
}

async function delPhoto(e,id){
 const x=await e.DB.prepare(
  "SELECT r2_key FROM files WHERE id=?"
 ).bind(id).first();

 if(!x)
  return J({error:"File not found."},404);

 await e.PHOTOS.delete(x.r2_key);

 await e.DB.prepare(
  "DELETE FROM files WHERE id=?"
 ).bind(id).run();

 return J({success:true});
}

function J(x,s=200,h={}){
 return new Response(
  JSON.stringify(x),
  {
   status:s,
   headers:{
    "Content-Type":"application/json",
    "Cache-Control":"no-store",
    ...h
   }
  }
 );
}

function b64(a){
 return btoa(
  String.fromCharCode(...a)
 ).replace(/\+/g,"-")
  .replace(/\//g,"_")
  .replace(/=+$/,"");
}

function fb64(s){
 s=s.replace(/-/g,"+").replace(/_/g,"/");
 while(s.length%4)s+="=";
 return Uint8Array.from(
  atob(s),
  c=>c.charCodeAt(0)
 );
}