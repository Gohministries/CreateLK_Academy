const SESSION = 86400;
const DEVICE = 2592000;
const MAX_FILE = 60 * 1024 * 1024;

const json = (data, status = 200, extra = {}) =>
  new Response(JSON.stringify(data), {
    status,
    headers: {
      "Content-Type": "application/json",
      "Cache-Control": "no-store",
      ...extra
    }
  });

async function hash(text) {
  const digest = await crypto.subtle.digest(
    "SHA-256",
    new TextEncoder().encode(text)
  );

  return [...new Uint8Array(digest)]
    .map(b => b.toString(16).padStart(2, "0"))
    .join("");
}

function randomToken() {
  const bytes = crypto.getRandomValues(new Uint8Array(32));
  return [...bytes]
    .map(b => b.toString(16).padStart(2, "0"))
    .join("");
}

async function sign(text, secret) {
  const key = await crypto.subtle.importKey(
    "raw",
    new TextEncoder().encode(secret),
    { name: "HMAC", hash: "SHA-256" },
    false,
    ["sign"]
  );

  const sig = await crypto.subtle.sign(
    "HMAC",
    key,
    new TextEncoder().encode(text)
  );

  return [...new Uint8Array(sig)]
    .map(b => b.toString(16).padStart(2, "0"))
    .join("");
}

async function makeSession(env) {
  const token = randomToken();
  const exp = Math.floor(Date.now() / 1000) + SESSION;
  const data = `${token}.${exp}`;
  const signature = await sign(data, env.SESSION_SECRET);
  return `${data}.${signature}`;
}

function getCookie(request, name) {
  const cookies = request.headers.get("Cookie") || "";

  for (const part of cookies.split(";")) {
    const [key, ...value] = part.trim().split("=");

    if (key === name) return value.join("=");
  }

  return null;
}

function sessionCookie(value) {
  return `SESSION=${value}; Path=/; HttpOnly; Secure; SameSite=Strict; Max-Age=${SESSION}`;
}

function deviceCookie(value) {
  return `DEVICE=${value}; Path=/; HttpOnly; Secure; SameSite=Strict; Max-Age=${DEVICE}`;
}

function clearCookie(name) {
  return `${name}=; Path=/; HttpOnly; Secure; SameSite=Strict; Max-Age=0`;
}

async function verifySession(request, env) {
  const cookie = getCookie(request, "SESSION");

  if (!cookie) return false;

  const parts = cookie.split(".");

  if (parts.length !== 3) return false;

  const [token, exp, signature] = parts;

  if (Number(exp) < Math.floor(Date.now() / 1000)) {
    return false;
  }

  const expected = await sign(
    `${token}.${exp}`,
    env.SESSION_SECRET
  );

  return signature === expected;
}

async function trustedDevice(request, env) {
  const token = getCookie(request, "DEVICE");

  if (!token) return false;

  const tokenHash = await hash(token);

  const row = await env.DB
    .prepare(
      `SELECT id
       FROM trusted_devices
       WHERE device_token_hash = ?`
    )
    .bind(tokenHash)
    .first();

  if (!row) return false;

  await env.DB
    .prepare(
      `UPDATE trusted_devices
       SET last_used_at = CURRENT_TIMESTAMP
       WHERE id = ?`
    )
    .bind(row.id)
    .run();

  return true;
}

export default {
  async fetch(request, env) {
    const url = new URL(request.url);
    const path = url.pathname;
    const method = request.method;

    if (method === "OPTIONS") {
      return new Response(null, { status: 204 });
    }

    /* LOGIN STATUS */

    if (
      method === "GET" &&
      path === "/api/login/status"
    ) {
      try {
        const loggedIn =
          await verifySession(request, env);

        const trustedDevice =
          await trustedDeviceCheck(request, env);

        const security =
          await env.DB
            .prepare(
              `SELECT failed_attempts, blocked
               FROM login_security
               WHERE id = 1`
            )
            .first();

        return json({
          loggedIn,
          blocked: !!security?.blocked,
          trustedDevice
        });
      } catch (e) {
        return json({
          error: e.message
        }, 500);
      }
    }

    /* DEVICE CHECK */

    if (
      method === "POST" &&
      path === "/api/device/verify"
    ) {
      try {
        const body = await request.json();

        const code = String(body.code || "").trim();

        const deviceName =
          String(
            body.deviceName || "Unknown Device"
          ).slice(0, 200);

        if (!code) {
          return json({
            error: "Enter Secret Code."
          }, 400);
        }

        if (code !== env.VAULT_DEVICE_CODE) {
          return json({
            error: "Invalid Secret Code."
          }, 401);
        }

        const token = randomToken();
        const tokenHash = await hash(token);

        await env.DB
          .prepare(
            `INSERT INTO trusted_devices
             (device_token_hash, device_name)
             VALUES (?, ?)`
          )
          .bind(tokenHash, deviceName)
          .run();

        return json(
          {
            success: true,
            message: "Device trusted."
          },
          200,
          {
            "Set-Cookie": deviceCookie(token)
          }
        );
      } catch (e) {
        return json({
          error: "Device verification failed.",
          detail: e.message
        }, 500);
      }
    }

    /* LOGIN */

    if (
      method === "POST" &&
      path === "/api/login"
    ) {
      try {
        const trusted =
          await trustedDeviceCheck(request, env);

        if (!trusted) {
          return json({
            error: "Device not trusted."
          }, 403);
        }

        const security =
          await env.DB
            .prepare(
              `SELECT failed_attempts, blocked
               FROM login_security
               WHERE id = 1`
            )
            .first();

        if (security?.blocked) {
          return json({
            error: "Account blocked.",
            blocked: true
          }, 403);
        }

        const body = await request.json();

        const username = String(body.username || "");
        const password = String(body.password || "");

        if (
          username !== env.VAULT_USER ||
          password !== env.VAULT_PASSWORD
        ) {
          const attempts =
            Number(security?.failed_attempts || 0) + 1;

          if (attempts >= 3) {
            await env.DB
              .prepare(
                `UPDATE login_security
                 SET failed_attempts = ?,
                     blocked = 1
                 WHERE id = 1`
              )
              .bind(attempts)
              .run();

            return json({
              error: "Account blocked.",
              blocked: true
            }, 403);
          }

          await env.DB
            .prepare(
              `UPDATE login_security
               SET failed_attempts = ?
               WHERE id = 1`
            )
            .bind(attempts)
            .run();

          return json({
            error: "Invalid username or password.",
            attemptsLeft: 3 - attempts
          }, 401);
        }

        await env.DB
          .prepare(
            `UPDATE login_security
             SET failed_attempts = 0,
                 blocked = 0
             WHERE id = 1`
          )
          .run();

        const session = await makeSession(env);

        return json(
          { success: true },
          200,
          {
            "Set-Cookie": sessionCookie(session)
          }
        );
      } catch (e) {
        return json({
          error: "Login failed.",
          detail: e.message
        }, 500);
      }
    }

    /* RECOVERY */

    if (
      method === "POST" &&
      path === "/api/login/recovery"
    ) {
      try {
        const body = await request.json();

        const code = String(body.code || "").trim();

        if (code !== env.VAULT_RECOVERY_CODE) {
          return json({
            error: "Invalid Recovery Code."
          }, 401);
        }

        await env.DB
          .prepare(
            `UPDATE login_security
             SET failed_attempts = 0,
                 blocked = 0
             WHERE id = 1`
          )
          .run();

        return json({
          success: true,
          message: "Account unlocked."
        });
      } catch (e) {
        return json({
          error: "Recovery failed.",
          detail: e.message
        }, 500);
      }
    }

    /* LOGOUT */

    if (
      method === "POST" &&
      path === "/api/logout"
    ) {
      return json(
        { success: true },
        200,
        {
          "Set-Cookie": clearCookie("SESSION")
        }
      );
    }

    /* AUTH */

    if (path.startsWith("/api/")) {
      const loggedIn =
        await verifySession(request, env);

      if (!loggedIn) {
        return json({
          error: "Authentication required."
        }, 401);
      }
    }

    /* VAULT META */

    if (
      method === "GET" &&
      path === "/api/vault/meta"
    ) {
      const row =
        await env.DB
          .prepare(
            `SELECT salt, verifier
             FROM vault_meta
             WHERE id = 1`
          )
          .first();

      return json(row || null);
    }

    if (
      method === "POST" &&
      path === "/api/vault/meta"
    ) {
      const body = await request.json();

      if (!body.salt || !body.verifier) {
        return json({
          error: "Invalid vault metadata."
        }, 400);
      }

      await env.DB
        .prepare(
          `INSERT INTO vault_meta
           (id, salt, verifier)
           VALUES (1, ?, ?)
           ON CONFLICT(id)
           DO UPDATE SET
             salt = excluded.salt,
             verifier = excluded.verifier`
        )
        .bind(body.salt, body.verifier)
        .run();

      return json({
        success: true
      });
    }

    /* VERIFIER */

    if (
      method === "GET" &&
      path === "/api/vault/verifier"
    ) {
      const row =
        await env.DB
          .prepare(
            `SELECT verifier
             FROM vault_meta
             WHERE id = 1`
          )
          .first();

      return json(row || {});
    }

    /* CATEGORIES */

    if (
      method === "GET" &&
      path === "/api/categories"
    ) {
      const result =
        await env.DB
          .prepare(
            `SELECT id, name
             FROM categories
             ORDER BY name`
          )
          .all();

      return json(result.results || []);
    }

    /* STATS */

    if (
      method === "GET" &&
      path === "/api/stats"
    ) {
      const items =
        await env.DB
          .prepare(
            `SELECT COUNT(*) AS c
             FROM vault_items`
          )
          .first();

      const photos =
        await env.DB
          .prepare(
            `SELECT COUNT(*) AS c
             FROM files`
          )
          .first();

      const categories =
        await env.DB
          .prepare(
            `SELECT COUNT(*) AS c
             FROM categories`
          )
          .first();

      return json({
        items: Number(items?.c || 0),
        photos: Number(photos?.c || 0),
        categories: Number(categories?.c || 0)
      });
    }

    /* ITEMS */

    if (
      method === "GET" &&
      path === "/api/items"
    ) {
      const result =
        await env.DB
          .prepare(
            `SELECT
               id,
               category,
               title,
               username,
               encrypted_password,
               encrypted_backup_codes,
               encrypted_notes,
               created_at,
               updated_at
             FROM vault_items
             ORDER BY id DESC`
          )
          .all();

      return json(result.results || []);
    }

    if (
      method === "POST" &&
      path === "/api/items"
    ) {
      const body = await request.json();

      if (!body.category || !body.title) {
        return json({
          error: "Category and title are required."
        }, 400);
      }

      const result =
        await env.DB
          .prepare(
            `INSERT INTO vault_items
             (
               category,
               title,
               username,
               encrypted_password,
               encrypted_backup_codes,
               encrypted_notes
             )
             VALUES (?, ?, ?, ?, ?, ?)`
          )
          .bind(
            body.category,
            body.title,
            body.username || "",
            body.encrypted_password || "",
            body.encrypted_backup_codes || "",
            body.encrypted_notes || ""
          )
          .run();

      const id = result.meta.last_row_id;

      await env.DB
        .prepare(
          `INSERT INTO audit_logs
           (action, item_type, item_id)
           VALUES ('CREATE', 'item', ?)`
        )
        .bind(id)
        .run();

      return json({
        success: true,
        id
      });
    }

    const itemMatch =
      path.match(/^\/api\/items\/(\d+)$/);

    if (itemMatch) {
      const id = Number(itemMatch[1]);

      if (method === "PUT") {
        const body = await request.json();

        await env.DB
          .prepare(
            `UPDATE vault_items
             SET
               category = ?,
               title = ?,
               username = ?,
               encrypted_password = ?,
               encrypted_backup_codes = ?,
               encrypted_notes = ?,
               updated_at = CURRENT_TIMESTAMP
             WHERE id = ?`
          )
          .bind(
            body.category,
            body.title,
            body.username || "",
            body.encrypted_password || "",
            body.encrypted_backup_codes || "",
            body.encrypted_notes || "",
            id
          )
          .run();

        return json({
          success: true
        });
      }

      if (method === "DELETE") {
        await env.DB
          .prepare(
            `DELETE FROM vault_items
             WHERE id = ?`
          )
          .bind(id)
          .run();

        await env.DB
          .prepare(
            `INSERT INTO audit_logs
             (action, item_type, item_id)
             VALUES ('DELETE', 'item', ?)`
          )
          .bind(id)
          .run();

        return json({
          success: true
        });
      }
    }

    /* PHOTOS */

    if (
      method === "GET" &&
      path === "/api/photos"
    ) {
      const result =
        await env.DB
          .prepare(
            `SELECT
               id,
               filename,
               file_type,
               file_size,
               created_at
             FROM files
             ORDER BY id DESC`
          )
          .all();

      return json(result.results || []);
    }

    if (
      method === "POST" &&
      path === "/api/photos"
    ) {
      const contentLength =
        Number(
          request.headers.get("Content-Length") || 0
        );

      if (contentLength > MAX_FILE) {
        return json({
          error: "File is too large."
        }, 413);
      }

      const data =
        await request.arrayBuffer();

      if (data.byteLength > MAX_FILE) {
        return json({
          error: "File is too large."
        }, 413);
      }

      const encodedName =
        request.headers.get("X-File-Name") || "photo";

      let filename = "photo";

      try {
        filename =
          decodeURIComponent(encodedName);
      } catch {}

      filename =
        filename.slice(0, 255);

      const fileType =
        request.headers.get("X-File-Type") ||
        "application/octet-stream";

      const key =
        `${Date.now()}-${randomToken()}`;

      await env.PHOTOS.put(
        key,
        data,
        {
          httpMetadata: {
            contentType:
              "application/octet-stream"
          }
        }
      );

      const result =
        await env.DB
          .prepare(
            `INSERT INTO files
             (
               filename,
               r2_key,
               file_type,
               file_size
             )
             VALUES (?, ?, ?, ?)`
          )
          .bind(
            filename,
            key,
            fileType,
            data.byteLength
          )
          .run();

      return json({
        success: true,
        id: result.meta.last_row_id
      });
    }

    /* PHOTO DOWNLOAD */

    const downloadMatch =
      path.match(
        /^\/api\/photos\/(\d+)\/download$/
      );

    if (
      method === "GET" &&
      downloadMatch
    ) {
      const id =
        Number(downloadMatch[1]);

      const row =
        await env.DB
          .prepare(
            `SELECT r2_key
             FROM files
             WHERE id = ?`
          )
          .bind(id)
          .first();

      if (!row) {
        return new Response(
          "Not found",
          { status: 404 }
        );
      }

      const object =
        await env.PHOTOS.get(row.r2_key);

      if (!object) {
        return new Response(
          "File not found",
          { status: 404 }
        );
      }

      return new Response(object.body, {
        headers: {
          "Content-Type":
            "application/octet-stream",
          "Cache-Control":
            "private, no-store"
        }
      });
    }

    /* PHOTO DELETE */

    const photoMatch =
      path.match(
        /^\/api\/photos\/(\d+)$/
      );

    if (photoMatch) {
      const id =
        Number(photoMatch[1]);

      if (method === "DELETE") {
        const row =
          await env.DB
            .prepare(
              `SELECT r2_key
               FROM files
               WHERE id = ?`
            )
            .bind(id)
            .first();

        if (row) {
          await env.PHOTOS.delete(
            row.r2_key
          );
        }

        await env.DB
          .prepare(
            `DELETE FROM files
             WHERE id = ?`
          )
          .bind(id)
          .run();

        return json({
          success: true
        });
      }
    }

    /* HTML */

    if (
      method === "GET" &&
      !path.startsWith("/api/")
    ) {
      return env.ASSETS.fetch(request);
    }

    return json({
      error: "Not found"
    }, 404);
  }
};

async function trustedDeviceCheck(request, env) {
  const token =
    getCookie(request, "DEVICE");

  if (!token) return false;

  const tokenHash =
    await hash(token);

  const row =
    await env.DB
      .prepare(
        `SELECT id
         FROM trusted_devices
         WHERE device_token_hash = ?`
      )
      .bind(tokenHash)
      .first();

  if (!row) return false;

  await env.DB
    .prepare(
      `UPDATE trusted_devices
       SET last_used_at = CURRENT_TIMESTAMP
       WHERE id = ?`
    )
    .bind(row.id)
    .run();

  return true;
}