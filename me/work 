/* ================= PHOTOS ================= */

async function photos(request,env,ctx){

 if(!(await requireAuth(request,env)))
  return J({error:"Unauthorized."},401);

 if(request.method==="GET"){

  const{results}=await env.DB.prepare(`
   SELECT
    id,
    filename,
    file_type,
    file_size,
    category,
    created_at,
    google_drive_file_id,
    google_drive_url
   FROM files
   ORDER BY created_at DESC,id DESC
  `).all();

  return J({files:results});
 }

 if(request.method==="POST"){

  let filename=
   request.headers.get("X-Filename")||
   "encrypted-file";

  try{
   filename=decodeURIComponent(filename);
  }catch{}

  const type=
   request.headers.get("X-File-Type")||
   "application/octet-stream";

  let category=
   request.headers.get("X-Category")||
   "Other";

  try{
   category=decodeURIComponent(category);
  }catch{}

  category=String(category).trim()||"Other";

  const allowed=[
   "Family",
   "Church",
   "Ministry",
   "Personal",
   "Documents",
   "Travel",
   "Memories",
   "Backup",
   "Other"
  ];

  if(!allowed.includes(category))
   category="Other";

  const data=request.body;

  const size=
   Number(request.headers.get("Content-Length"))||0;

  const key=
   crypto.randomUUID()+
   "-"+
   filename.replace(/[^\w.\- ]/g,"_");

  await env.PHOTOS.put(
   key,
   data,
   {
    httpMetadata:{
     contentType:
      "application/octet-stream"
    }
   }
  );

  try{

   const r=await env.DB.prepare(`
    INSERT INTO files(
     filename,
     r2_key,
     file_type,
     file_size,
     category
    )
    VALUES(?,?,?,?,?)
    RETURNING
     id,
     filename,
     file_type,
     file_size,
     category,
     created_at
   `).bind(
    filename,
    key,
    type,
    size,
    category
   ).first();

   if(r?.id){

    await env.DB.prepare(`
     INSERT OR REPLACE INTO file_features(
      file_id,
      category
     )
     VALUES(?,?)
    `).bind(
     r.id,
     category
    ).run();

    /*
     * Google Drive backup runs AFTER
     * Cloudflare R2 + D1 are saved.
     *
     * It does not block the upload.
     */
    if(ctx?.waitUntil){
     ctx.waitUntil(
      backupFile(env,r.id).catch(
       console.error
      )
     );
    }
   }

   return J(r);

  }catch(e){

   await env.PHOTOS.delete(key);

   throw e;
  }
 }

 return J({
  error:"Method not allowed."
 },405);
}

