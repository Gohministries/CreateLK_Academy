const ORIGIN = "https://createlk.com";
const TTL = 86400;

const corsHeaders = {
  "Access-Control-Allow-Origin": ORIGIN,
  "Access-Control-Allow-Credentials": "true",
  "Access-Control-Allow-Headers": "Content-Type, X-Filename, X-File-Type",
  "Access-Control-Allow-Methods": "GET, POST, PUT, DELETE, OPTIONS",
  "Vary": "Origin"
};

function C() {
  return { ...corsHeaders };
}

function J(data, status = 200, extra = {}) {
  return new Response(JSON.stringify(data), {
    status,
    headers: {
      ...C(),
      "Content-Type": "application/json; charset=utf-8",
      ...extra
    }
  });
}

async function sha256(text) {
  const b = await crypto.subtle.digest(
    "SHA-256",
    new TextEncoder().encode(text)
  );
  return [...new Uint8Array(b)]
    .map(x => x.toString(16).padStart(2, "0"))
    .join("");
}

function b64u(bytes) {
  let s = "";
  for (const b of bytes) s += String.fromCharCode(b);
  return btoa(s)
    .replace(/\+/g, "-")
    .replace(/\//g, "_")
    .replace(/=+$/, "");
}

function ub64u(s) {
  s = s.replace(/-/g, "+").replace(/_/g, "/");
  while (s.length % 4) s += "=";
  const bin = atob(s);
  return Uint8Array.from(bin, c => c.charCodeAt(0));
}

async function hmac(data, secret) {
  const key = await crypto.subtle.importKey(
    "raw",
    new TextEncoder().encode(secret),
    { name: "HMAC", hash: "SHA-256" },
    false,
    ["sign", "verify"]
  );

  return new Uint8Array(
    await crypto.subtle.sign(
      "HMAC",
      key,
      new TextEncoder().encode(data)
    )
  );
}

async function makeSession(user, secret) {
  const payload = b64u(
    new TextEncoder().encode(
      JSON.stringify({
        u: user,
        exp: Math.floor(Date.now() / 1000) + TTL
      })
    )
  );

  const sig = b64u(await hmac(payload, secret));

  return `${payload}.${sig}`;
}

async function checkSession(request, env) {
  const cookie = request.headers.get("Cookie") || "";
  const m = cookie.match(/(?:^|;\s*)session=([^;]+)/);

  if (!m) return false;

  const parts = m[1].split(".");
  if (parts.length !== 2) return false;

  const [payload, sig] = parts;

  try {
    const expected = await hmac(payload, env.SESSION_SECRET);

    const a = ub64u(sig);
    if (a.length !== expected.length) return false;

    let ok = true;
    for (let i = 0; i < a.length; i++) {
      if (a[i] !== expected[i]) ok = false;
    }

    if (!ok) return false;

    const data = JSON.parse(
      new TextDecoder().decode(ub64u(payload))
    );

    if (!data.exp || data.exp < Math.floor(Date.now() / 1000)) {
      return false;
    }

    return data.u === env.VAULT_USER;
  } catch {
    return false;
  }
}

async function requireAuth(request, env) {
  return await checkSession(request, env);
}

function cookie(value, maxAge) {
  return `session=${value}; HttpOnly; Secure; SameSite=None; Path=/; Max-Age=${maxAge}`;
}

async function login(request, env) {
  const sec =
    await env.DB.prepare(
      "SELECT failed_attempts, blocked FROM login_security WHERE id=1"
    ).first();

  if (sec?.blocked) {
    return J(
      { error: "Login blocked after 3 failed attempts." },
      403
    );
  }

  let body;

  try {
    body = await request.json();
  } catch {
    return J({ error: "Invalid request." }, 400);
  }

  const username = String(body.username || "");
  const password = String(body.password || "");

  if (
    username !== env.VAULT_USER ||
    password !== env.VAULT_PASSWORD
  ) {
    const attempts = (sec?.failed_attempts || 0) + 1;
    const blocked = attempts >= 3 ? 1 : 0;

    await env.DB.prepare(`
      INSERT INTO login_security(id,failed_attempts,blocked)
      VALUES(1,?,?)
      ON CONFLICT(id) DO UPDATE SET
        failed_attempts=excluded.failed_attempts,
        blocked=excluded.blocked
    `).bind(attempts, blocked).run();

    if (blocked) {
      return J(
        { error: "Login blocked after 3 failed attempts." },
        403
      );
    }

    return J(
      {
        error: "Invalid username or password.",
        attempts_left: 3 - attempts
      },
      401
    );
  }

  await env.DB.prepare(`
    INSERT INTO login_security(id,failed_attempts,blocked)
    VALUES(1,0,0)
    ON CONFLICT(id) DO UPDATE SET
      failed_attempts=0,
      blocked=0
  `).run();

  const session = await makeSession(
    env.VAULT_USER,
    env.SESSION_SECRET
  );

  return J(
    { ok: true },
    200,
    {
      "Set-Cookie": cookie(session, TTL)
    }
  );
}

async function logout() {
  return J(
    { ok: true },
    200,
    {
      "Set-Cookie": cookie("", 0)
    }
  );
}

async function vaultMeta(request, env) {
  if (!(await requireAuth(request, env))) {
    return J({ error: "Unauthorized." }, 401);
  }

  if (request.method === "GET") {
    const row = await env.DB
      .prepare("SELECT salt, verifier FROM vault_meta WHERE id=1")
      .first();

    return J({
      initialized: !!row,
      salt: row?.salt || null,
      verifier: row?.verifier || null
    });
  }

  if (request.method === "POST") {
    let body;

    try {
      body = await request.json();
    } catch {
      return J({ error: "Invalid request." }, 400);
    }

    if (!body.salt || !body.verifier) {
      return J({ error: "Missing vault data." }, 400);
    }

    const existing = await env.DB
      .prepare("SELECT id FROM vault_meta WHERE id=1")
      .first();

    if (existing) {
      return J({ error: "Vault is already initialized." }, 409);
    }

    await env.DB.prepare(`
      INSERT INTO vault_meta(id,salt,verifier)
      VALUES(1,?,?)
    `).bind(
      body.salt,
      body.verifier
    ).run();

    return J({ ok: true });
  }

  return J({ error: "Method not allowed." }, 405);
}

async function categories(request, env) {
  if (!(await requireAuth(request, env))) {
    return J({ error: "Unauthorized." }, 401);
  }

  if (request.method === "GET") {
    const { results } = await env.DB
      .prepare(
        "SELECT id,name,created_at FROM categories ORDER BY name COLLATE NOCASE"
      )
      .all();

    return J({ categories: results });
  }

  if (request.method === "POST") {
    let body;

    try {
      body = await request.json();
    } catch {
      return J({ error: "Invalid request." }, 400);
    }

    const name = String(body.name || "").trim();

    if (!name) {
      return J({ error: "Category name required." }, 400);
    }

    try {
      const r = await env.DB.prepare(`
        INSERT INTO categories(name)
        VALUES(?)
        RETURNING id,name,created_at
      `).bind(name).first();

      return J(r);
    } catch {
      return J({ error: "Category already exists." }, 409);
    }
  }

  return J({ error: "Method not allowed." }, 405);
}

async function stats(request, env) {
  if (!(await requireAuth(request, env))) {
    return J({ error: "Unauthorized." }, 401);
  }

  const items = await env.DB
    .prepare("SELECT COUNT(*) AS n FROM vault_items")
    .first();

  const files = await env.DB
    .prepare("SELECT COUNT(*) AS n FROM files")
    .first();

  const size = await env.DB
    .prepare("SELECT COALESCE(SUM(file_size),0) AS n FROM files")
    .first();

  return J({
    items: items?.n || 0,
    files: files?.n || 0,
    file_size: size?.n || 0
  });
}

async function items(request, env) {
  if (!(await requireAuth(request, env))) {
    return J({ error: "Unauthorized." }, 401);
  }

  if (request.method === "GET") {
    const { results } = await env.DB.prepare(`
      SELECT
        id,
        category,
        title,
        username,
        encrypted_password,
        encrypted_backup_codes,
        encrypted_notes,
        created_at,
        updated_at
      FROM vault_items
      ORDER BY updated_at DESC, id DESC
    `).all();

    return J({ items: results });
  }

  let body;

  try {
    body = await request.json();
  } catch {
    return J({ error: "Invalid request." }, 400);
  }

  if (request.method === "POST") {
    if (!body.category || !body.title) {
      return J({ error: "Category and title are required." }, 400);
    }

    const r = await env.DB.prepare(`
      INSERT INTO vault_items(
        category,
        title,
        username,
        encrypted_password,
        encrypted_backup_codes,
        encrypted_notes
      )
      VALUES(?,?,?,?,?,?)
      RETURNING *
    `).bind(
      body.category,
      body.title,
      body.username || "",
      body.encrypted_password || "",
      body.encrypted_backup_codes || "",
      body.encrypted_notes || ""
    ).first();

    return J(r);
  }

  return J({ error: "Method not allowed." }, 405);
}

async function itemById(request, env, id) {
  if (!(await requireAuth(request, env))) {
    return J({ error: "Unauthorized." }, 401);
  }

  if (!/^\d+$/.test(id)) {
    return J({ error: "Invalid ID." }, 400);
  }

  if (request.method === "DELETE") {
    await env.DB
      .prepare("DELETE FROM vault_items WHERE id=?")
      .bind(Number(id))
      .run();

    return J({ ok: true });
  }

  if (request.method === "PUT") {
    let body;

    try {
      body = await request.json();
    } catch {
      return J({ error: "Invalid request." }, 400);
    }

    const r = await env.DB.prepare(`
      UPDATE vault_items
      SET
        category=?,
        title=?,
        username=?,
        encrypted_password=?,
        encrypted_backup_codes=?,
        encrypted_notes=?,
        updated_at=CURRENT_TIMESTAMP
      WHERE id=?
      RETURNING *
    `).bind(
      body.category,
      body.title,
      body.username || "",
      body.encrypted_password || "",
      body.encrypted_backup_codes || "",
      body.encrypted_notes || "",
      Number(id)
    ).first();

    if (!r) return J({ error: "Item not found." }, 404);

    return J(r);
  }

  return J({ error: "Method not allowed." }, 405);
}

async function photos(request, env) {
  if (!(await requireAuth(request, env))) {
    return J({ error: "Unauthorized." }, 401);
  }

  if (request.method === "GET") {
    const { results } = await env.DB.prepare(`
      SELECT id,filename,file_type,file_size,created_at
      FROM files
      ORDER BY created_at DESC, id DESC
    `).all();

    return J({ files: results });
  }

  if (request.method === "POST") {
    const filename =
      request.headers.get("X-Filename") || "encrypted-file";

    const type =
      request.headers.get("X-File-Type") ||
      "application/octet-stream";

    const size =
      Number(request.headers.get("Content-Length")) || 0;

    const key =
      crypto.randomUUID() + "-" +
      filename.replace(/[^\w.\- ]/g, "_");

    await env.PHOTOS.put(key, request.body, {
      httpMetadata: {
        contentType: "application/octet-stream"
      }
    });

    const r = await env.DB.prepare(`
      INSERT INTO files(
        filename,
        r2_key,
        file_type,
        file_size
      )
      VALUES(?,?,?,?)
      RETURNING id,filename,file_type,file_size,created_at
    `).bind(
      filename,
      key,
      type,
      size
    ).first();

    return J(r);
  }

  return J({ error: "Method not allowed." }, 405);
}

async function photoDownload(request, env, id) {
  if (!(await requireAuth(request, env))) {
    return J({ error: "Unauthorized." }, 401);
  }

  if (!/^\d+$/.test(id)) {
    return J({ error: "Invalid ID." }, 400);
  }

  const row = await env.DB.prepare(
    "SELECT filename,r2_key FROM files WHERE id=?"
  ).bind(Number(id)).first();

  if (!row) {
    return J({ error: "File not found." }, 404);
  }

  const object = await env.PHOTOS.get(row.r2_key);

  if (!object) {
    return J({ error: "File not found in storage." }, 404);
  }

  return new Response(object.body, {
    headers: {
      ...C(),
      "Content-Type": "application/octet-stream",
      "Content-Disposition":
        `attachment; filename="${row.filename.replace(/"/g, "")}"`
    }
  });
}

async function photoDelete(request, env, id) {
  if (!(await requireAuth(request, env))) {
    return J({ error: "Unauthorized." }, 401);
  }

  if (!/^\d+$/.test(id)) {
    return J({ error: "Invalid ID." }, 400);
  }

  const row = await env.DB.prepare(
    "SELECT r2_key FROM files WHERE id=?"
  ).bind(Number(id)).first();

  if (!row) {
    return J({ error: "File not found." }, 404);
  }

  await env.PHOTOS.delete(row.r2_key);

  await env.DB.prepare(
    "DELETE FROM files WHERE id=?"
  ).bind(Number(id)).run();

  return J({ ok: true });
}

export default {
  async fetch(request, env) {
    const url = new URL(request.url);
    const path = url.pathname;

    if (request.method === "OPTIONS") {
      return new Response(null, {
        status: 204,
        headers: C()
      });
    }

    try {
      if (path === "/api/login/status") {
        return J({
          logged_in: await checkSession(request, env)
        });
      }

      if (path === "/api/login" && request.method === "POST") {
        return await login(request, env);
      }

      if (path === "/api/logout" && request.method === "POST") {
        return await logout();
      }

      if (path === "/api/vault/meta") {
        return await vaultMeta(request, env);
      }

      if (path === "/api/categories") {
        return await categories(request, env);
      }

      if (path === "/api/stats") {
        return await stats(request, env);
      }

      if (path === "/api/items") {
        return await items(request, env);
      }

      const itemMatch =
        path.match(/^\/api\/items\/(\d+)$/);

      if (itemMatch) {
        return await itemById(
          request,
          env,
          itemMatch[1]
        );
      }

      if (path === "/api/photos") {
        return await photos(request, env);
      }

      const downloadMatch =
        path.match(/^\/api\/photos\/(\d+)\/download$/);

      if (downloadMatch) {
        return await photoDownload(
          request,
          env,
          downloadMatch[1]
        );
      }

      const photoMatch =
        path.match(/^\/api\/photos\/(\d+)$/);

      if (photoMatch) {
        return await photoDelete(
          request,
          env,
          photoMatch[1]
        );
      }

      return new Response("Personal Vault API", {
        status: 404,
        headers: C()
      });

    } catch (e) {
      return J(
        {
          error: "Server error.",
          detail: String(e?.message || e)
        },
        500
      );
    }
  }
};