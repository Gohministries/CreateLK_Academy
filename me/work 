/* ================= GOOGLE DRIVE ================= */

async function googleToken(env){

 const r=await fetch(
  "https://oauth2.googleapis.com/token",
  {
   method:"POST",
   headers:{
    "Content-Type":
    "application/x-www-form-urlencoded"
   },
   body:new URLSearchParams({
    client_id:GOOGLE_CLIENT_ID,
    client_secret:env.GOOGLE_CLIENT_SECRET,
    refresh_token:env.GOOGLE_REFRESH_TOKEN,
    grant_type:"refresh_token"
   })
  }
 );

 const d=await r.json();

 if(!r.ok)
  throw Error(
   d.error_description||
   "Google authentication failed"
  );

 return d.access_token;
}

async function backupFile(env,id){

 const file=await env.DB.prepare(`
  SELECT *
  FROM files
  WHERE id=?
 `).bind(id).first();

 if(!file)
  throw Error("File not found");

 /* Already backed up */
 if(file.google_drive_file_id)
  return {
   success:true,
   duplicate:true,
   url:file.google_drive_url
  };

 const token=await googleToken(env);

 /* Find existing Drive copy */
 const q=
  `trashed=false and appProperties has `+
  `{key='vault_file_id' and value='${id}'}`;

 const check=await fetch(
  "https://www.googleapis.com/drive/v3/files?"+
  new URLSearchParams({
   q,
   fields:"files(id,webViewLink)",
   pageSize:"1"
  }),
  {
   headers:{
    Authorization:"Bearer "+token
   }
  }
 );

 const found=await check.json();

 if(found.files?.length){

  const g=found.files[0];

  const url=
   g.webViewLink||
   `https://drive.google.com/file/d/${g.id}/view`;

  await env.DB.prepare(`
   UPDATE files
   SET
    google_drive_file_id=?,
    google_drive_url=?
   WHERE id=?
  `).bind(
   g.id,
   url,
   id
  ).run();

  return {
   success:true,
   duplicate:true,
   url
  };
 }

 /* Get encrypted object from R2 */
 const object=await env.PHOTOS.get(
  file.r2_key
 );

 if(!object)
  throw Error(
   "Cloudflare R2 file missing"
  );

 /* Google Drive metadata */
 const metadata={
  name:file.filename,
  mimeType:"application/octet-stream",
  parents:[env.GOOGLE_DRIVE_ROOT_ID],
  appProperties:{
   vault_file_id:String(id)
  }
 };

 /* Start resumable upload */
 const start=await fetch(
  "https://www.googleapis.com/upload/drive/v3/files?uploadType=resumable",
  {
   method:"POST",
   headers:{
    Authorization:"Bearer "+token,
    "Content-Type":"application/json",
    "X-Upload-Content-Type":
     "application/octet-stream",
    "X-Upload-Content-Length":
     String(object.size)
   },
   body:JSON.stringify(metadata)
  }
 );

 if(!start.ok)
  throw Error(await start.text());

 const location=
  start.headers.get("Location");

 if(!location)
  throw Error(
   "Google upload URL missing"
  );

 /* Upload encrypted R2 data */
 const upload=await fetch(
  location,
  {
   method:"PUT",
   headers:{
    "Content-Type":
     "application/octet-stream",
    "Content-Length":
     String(object.size)
   },
   body:object.body
  }
 );

 const result=await upload.json();

 if(!upload.ok)
  throw Error(
   result.error?.message||
   "Google Drive upload failed"
  );

 const url=
  result.webViewLink||
  `https://drive.google.com/file/d/${result.id}/view`;

 /* Save Drive information */
 await env.DB.prepare(`
  UPDATE files
  SET
   google_drive_file_id=?,
   google_drive_url=?
  WHERE id=?
 `).bind(
  result.id,
  url,
  id
 ).run();

 return {
  success:true,
  duplicate:false,
  url
 };
}

