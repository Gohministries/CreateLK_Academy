/* ================= MAIN ================= */

export default {

 async fetch(request,env,ctx){

  const url=new URL(request.url);
  const path=url.pathname;

  if(request.method==="OPTIONS"){
   return new Response(null,{
    status:204,
    headers:C()
   });
  }

  try{

   /* LOGIN */
   if(path==="/api/login/status")
    return J({
     logged_in:
      await checkSession(request,env)
    });

   if(
    path==="/api/login"&&
    request.method==="POST"
   )
    return await login(request,env);

   if(
    path==="/api/logout"&&
    request.method==="POST"
   )
    return await logout();

   /* VAULT */
   if(path==="/api/vault/meta")
    return await vaultMeta(
     request,env
    );

   /* CATEGORIES */
   if(path==="/api/categories")
    return await categories(
     request,env
    );

   /* STATS */
   if(path==="/api/stats")
    return await stats(
     request,env
    );

   /* ITEMS */
   if(path==="/api/items")
    return await items(
     request,env
    );

   const itemMatch=
    path.match(/^\/api\/items\/(\d+)$/);

   if(itemMatch)
    return await itemById(
     request,
     env,
     itemMatch[1]
    );

   /* PHOTOS */
   if(path==="/api/photos")
    return await photos(
     request,
     env,
     ctx
    );

   const downloadMatch=
    path.match(
     /^\/api\/photos\/(\d+)\/download$/
    );

   if(downloadMatch)
    return await photoDownload(
     request,
     env,
     downloadMatch[1]
    );

   const photoMatch=
    path.match(
     /^\/api\/photos\/(\d+)$/
    );

   if(photoMatch)
    return await photoDelete(
     request,
     env,
     photoMatch[1]
    );

   /* GOOGLE STATUS */
   if(
    path==="/api/google/status"&&
    request.method==="GET"
   )
    return await googleStatus(
     request,
     env
    );

   /* GOOGLE MANUAL BACKUP */
   const backupMatch=
    path.match(
     /^\/api\/google\/backup\/(\d+)$/
    );

   if(
    backupMatch&&
    request.method==="POST"
   )
    return await googleBackup(
     request,
     env,
     Number(backupMatch[1])
    );

   return new Response(
    "Personal Vault API",
    {
     status:404,
     headers:C()
    }
   );

  }catch(e){

   return J(
    {
     error:"Server error.",
     detail:String(
      e?.message||e
     )
    },
    500
   );
  }
 }
};