const COOKIE = "vault_session";
const SESSION_DAYS = 7;

function cors(request) {
  const origin = request.headers.get("Origin") || "";

  return {
    "Access-Control-Allow-Origin": origin,
    "Access-Control-Allow-Credentials": "true",
    "Access-Control-Allow-Methods": "GET,POST,DELETE,OPTIONS",
    "Access-Control-Allow-Headers":
      "Content-Type,X-Filename,X-File-Type,X-Category",
    "Vary": "Origin"
  };
}

function json(data, status, request) {
  return new Response(JSON.stringify(data), {
    status: status || 200,
    headers: {
      "Content-Type": "application/json",
      "Cache-Control": "no-store",
      ...cors(request)
    }
  });
}

function getCookie(request, name) {
  const cookie = request.headers.get("Cookie") || "";
  const match = cookie.match(
    new RegExp("(?:^|;\\s*)" + name + "=([^;]+)")
  );
  return match ? match[1] : null;
}

function encode64(bytes) {
  let binary = "";
  for (const byte of bytes) {
    binary += String.fromCharCode(byte);
  }

  return btoa(binary)
    .replace(/\+/g, "-")
    .replace(/\//g, "_")
    .replace(/=+$/, "");
}

function decode64(value) {
  value = value.replace(/-/g, "+").replace(/_/g, "/");

  while (value.length % 4) {
    value += "=";
  }

  const binary = atob(value);
  const bytes = new Uint8Array(binary.length);

  for (let i = 0; i < binary.length; i++) {
    bytes[i] = binary.charCodeAt(i);
  }

  return bytes;
}

async function createSignature(text, secret) {
  const key = await crypto.subtle.importKey(
    "raw",
    new TextEncoder().encode(secret),
    {
      name: "HMAC",
      hash: "SHA-256"
    },
    false,
    ["sign"]
  );

  return new Uint8Array(
    await crypto.subtle.sign(
      "HMAC",
      key,
      new TextEncoder().encode(text)
    )
  );
}

async function createSession(env) {
  const timestamp = Date.now().toString();
  const data = `${env.VAULT_USER}.${timestamp}`;

  const signature = encode64(
    await createSignature(
      data,
      env.SESSION_SECRET
    )
  );

  return encode64(
    new TextEncoder().encode(
      `${data}.${signature}`
    )
  );
}

async function verifySession(token, env) {
  try {
    if (!token) return false;

    const decoded = new TextDecoder().decode(
      decode64(token)
    );

    const parts = decoded.split(".");

    if (parts.length !== 3) {
      return false;
    }

    const username = parts[0];
    const timestamp = Number(parts[1]);
    const signature = parts[2];

    if (username !== env.VAULT_USER) {
      return false;
    }

    if (!timestamp) {
      return false;
    }

    if (
      Date.now() - timestamp >
      SESSION_DAYS * 24 * 60 * 60 * 1000
    ) {
      return false;
    }

    const expected = encode64(
      await createSignature(
        `${username}.${timestamp}`,
        env.SESSION_SECRET
      )
    );

    return signature === expected;
  } catch {
    return false;
  }
}

async function isAuthenticated(request, env) {
  const token = getCookie(
    request,
    COOKIE
  );

  return verifySession(token, env);
}

function getCategory(type) {
  if (!type) return "General";

  if (type.startsWith("image/")) {
    return "Photos";
  }

  if (type.startsWith("video/")) {
    return "Videos";
  }

  if (type.startsWith("audio/")) {
    return "Audio";
  }

  if (type === "application/pdf") {
    return "Documents";
  }

  return "General";
}

export default {
  async fetch(request, env) {
    const url = new URL(request.url);
    const path = url.pathname;

    /* CORS */

    if (request.method === "OPTIONS") {
      return new Response(null, {
        status: 204,
        headers: cors(request)
      });
    }

    try {

      /* LOGIN */

      if (
        path === "/api/login" &&
        request.method === "POST"
      ) {
        const body = await request.json();

        if (
          body.username !== env.VAULT_USER ||
          body.password !== env.VAULT_PASSWORD
        ) {
          return json(
            {
              ok: false,
              error: "Invalid username or password"
            },
            401,
            request
          );
        }

        const session =
          await createSession(env);

        return new Response(
          JSON.stringify({
            ok: true
          }),
          {
            status: 200,
            headers: {
              "Content-Type":
                "application/json",

              "Cache-Control":
                "no-store",

              "Set-Cookie":
                `${COOKIE}=${session}; ` +
                `Path=/; ` +
                `HttpOnly; ` +
                `Secure; ` +
                `SameSite=None; ` +
                `Max-Age=${SESSION_DAYS * 86400}`,

              ...cors(request)
            }
          }
        );
      }

      /* AUTH STATUS */

      if (
        path === "/api/auth/status" &&
        request.method === "GET"
      ) {
        const authenticated =
          await isAuthenticated(
            request,
            env
          );

        return json(
          {
            authenticated
          },
          200,
          request
        );
      }

      /* LOGOUT */

      if (
        path === "/api/logout" &&
        request.method === "POST"
      ) {
        return new Response(
          JSON.stringify({
            ok: true
          }),
          {
            status: 200,
            headers: {
              "Content-Type":
                "application/json",

              "Set-Cookie":
                `${COOKIE}=; ` +
                `Path=/; ` +
                `HttpOnly; ` +
                `Secure; ` +
                `SameSite=None; ` +
                `Max-Age=0`,

              ...cors(request)
            }
          }
        );
      }

      /* PROTECTED API */

      if (
        !(await isAuthenticated(
          request,
          env
        ))
      ) {
        return json(
          {
            ok: false,
            error: "Unauthorized"
          },
          401,
          request
        );
      }

      /* SERVICE STATUS */

      if (
        path === "/api/status" &&
        request.method === "GET"
      ) {
        return json(
          {
            ok: true,
            service: "Personal Vault"
          },
          200,
          request
        );
      }

      /* STATS */

      if (
        path === "/api/stats" &&
        request.method === "GET"
      ) {
        const result =
          await env.DB.prepare(`
            SELECT
              COUNT(*) AS count,
              COALESCE(
                SUM(file_size),
                0
              ) AS total_size
            FROM files
          `).first();

        return json(
          {
            count:
              Number(
                result?.count || 0
              ),

            total_size:
              Number(
                result?.total_size || 0
              )
          },
          200,
          request
        );
      }

      /* CATEGORIES */

      if (
        path === "/api/categories" &&
        request.method === "GET"
      ) {
        const result =
          await env.DB.prepare(`
            SELECT DISTINCT category
            FROM files
            ORDER BY category
          `).all();

        return json(
          {
            categories:
              result.results || []
          },
          200,
          request
        );
      }

      /* FILE LIST */

      if (
        path === "/api/items" &&
        request.method === "GET"
      ) {
        const result =
          await env.DB.prepare(`
            SELECT
              id,
              filename,
              file_type,
              file_size,
              created_at,
              category
            FROM files
            ORDER BY
              created_at DESC,
              id DESC
          `).all();

        return json(
          {
            items:
              result.results || []
          },
          200,
          request
        );
      }

      /* SINGLE FILE */

      const itemMatch =
        path.match(
          /^\/api\/items\/(\d+)$/
        );

      if (
        itemMatch &&
        request.method === "GET"
      ) {
        const id =
          Number(itemMatch[1]);

        const item =
          await env.DB.prepare(`
            SELECT
              id,
              filename,
              file_type,
              file_size,
              created_at,
              category
            FROM files
            WHERE id = ?
          `)
            .bind(id)
            .first();

        if (!item) {
          return json(
            {
              error: "File not found"
            },
            404,
            request
          );
        }

        return json(
          item,
          200,
          request
        );
      }

      /* UPLOAD */

      if (
        path === "/api/photos" &&
        request.method === "POST"
      ) {
        const filename =
          request.headers.get(
            "X-Filename"
          ) || "file";

        const fileType =
          request.headers.get(
            "X-File-Type"
          ) ||
          "application/octet-stream";

        const category =
          request.headers.get(
            "X-Category"
          ) ||
          getCategory(fileType);

        const encrypted =
          await request.arrayBuffer();

        const safeName =
          filename.replace(
            /[^\w.\- ]/g,
            "_"
          );

        const r2Key =
          crypto.randomUUID() +
          "-" +
          safeName;

        await env.PHOTOS.put(
          r2Key,
          encrypted,
          {
            httpMetadata: {
              contentType:
                "application/octet-stream"
            }
          }
        );

        const result =
          await env.DB.prepare(`
            INSERT INTO files
            (
              filename,
              r2_key,
              file_type,
              file_size,
              category
            )
            VALUES (?, ?, ?, ?, ?)
          `)
            .bind(
              filename,
              r2Key,
              fileType,
              encrypted.byteLength,
              category
            )
            .run();

        const id =
          result.meta.last_row_id;

        try {
          await env.DB.prepare(`
            INSERT INTO file_features
            (
              file_id,
              category
            )
            VALUES (?, ?)
          `)
            .bind(
              id,
              category
            )
            .run();
        } catch {}

        return json(
          {
            ok: true,
            id
          },
          201,
          request
        );
      }

      /* DOWNLOAD */

      const downloadMatch =
        path.match(
          /^\/api\/photos\/(\d+)\/download$/
        );

      if (
        downloadMatch &&
        request.method === "GET"
      ) {
        const id =
          Number(downloadMatch[1]);

        const item =
          await env.DB.prepare(`
            SELECT
              filename,
              r2_key,
              file_type
            FROM files
            WHERE id = ?
          `)
            .bind(id)
            .first();

        if (!item) {
          return json(
            {
              error: "File not found"
            },
            404,
            request
          );
        }

        const object =
          await env.PHOTOS.get(
            item.r2_key
          );

        if (!object) {
          return json(
            {
              error: "Stored file not found"
            },
            404,
            request
          );
        }

        return new Response(
          object.body,
          {
            status: 200,
            headers: {
              "Content-Type":
                "application/octet-stream",

              "X-Filename":
                encodeURIComponent(
                  item.filename
                ),

              "X-File-Type":
                item.file_type ||
                "application/octet-stream",

              "Cache-Control":
                "no-store",

              ...cors(request)
            }
          }
        );
      }

      /* DELETE */

      const deleteMatch =
        path.match(
          /^\/api\/photos\/(\d+)$/
        );

      if (
        deleteMatch &&
        request.method === "DELETE"
      ) {
        const id =
          Number(deleteMatch[1]);

        const item =
          await env.DB.prepare(`
            SELECT r2_key
            FROM files
            WHERE id = ?
          `)
            .bind(id)
            .first();

        if (!item) {
          return json(
            {
              error: "File not found"
            },
            404,
            request
          );
        }

        await env.PHOTOS.delete(
          item.r2_key
        );

        try {
          await env.DB.prepare(`
            DELETE FROM file_features
            WHERE file_id = ?
          `)
            .bind(id)
            .run();
        } catch {}

        await env.DB.prepare(`
          DELETE FROM files
          WHERE id = ?
        `)
          .bind(id)
          .run();

        return json(
          {
            ok: true
          },
          200,
          request
        );
      }

      return json(
        {
          error: "Not found"
        },
        404,
        request
      );

    } catch (error) {
      return json(
        {
          ok: false,
          error:
            error?.message ||
            "Internal server error"
        },
        500,
        request
      );
    }
  }
};