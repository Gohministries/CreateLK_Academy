<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#111827">
<title>Personal Vault</title>
<style>
*{box-sizing:border-box}body{margin:0;background:#f3f4f6;color:#111827;font:15px Arial}
header{background:#111827;color:#fff;padding:12px 15px;display:flex;justify-content:space-between;align-items:center}
main{max-width:850px;margin:auto;padding:10px}.card{background:#fff;padding:14px;border-radius:12px;margin-bottom:10px;box-shadow:0 2px 7px #0001}
h2,h3{margin:0 0 10px}input,textarea,select{width:100%;padding:11px;margin:4px 0 9px;border:1px solid #d1d5db;border-radius:8px;font-size:15px}
textarea{min-height:70px}button{border:0;border-radius:8px;padding:10px 14px;min-height:42px;background:#111827;color:#fff;font-size:14px;font-weight:600}
button:active{transform:scale(.97)}.hidden{display:none!important}.msg{color:#dc2626;margin-top:7px}.small{font-size:12px;color:#6b7280}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:7px}.stat{background:#f8fafc;padding:10px;text-align:center;border-radius:8px}.stat b{display:block;font-size:20px}
.actions{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}.danger{background:#dc2626}.item,.file{border:1px solid #e5e7eb;border-radius:9px;padding:10px;margin:7px 0}
.viewbar{display:flex;justify-content:space-between;align-items:center}.viewbuttons{display:flex;gap:5px}
.files{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:8px;margin-top:10px}.files.list{display:block}
.file{padding:0;overflow:hidden;background:#fff}.preview{height:105px;background:#f3f4f6;display:flex;align-items:center;justify-content:center}
.preview img,.preview video{width:100%;height:100%;object-fit:cover}.icon{font-size:34px}.fileinfo{padding:9px}.filename{font-weight:bold;font-size:13px;word-break:break-word}
.files.list .file{display:flex;padding:7px}.files.list .preview{width:65px;height:65px;flex:none;border-radius:6px}.files.list .fileinfo{flex:1;padding:3px 9px}
.progress{height:5px;background:#ddd;border-radius:5px;margin-top:7px;overflow:hidden}.progress i{display:block;height:100%;width:0;background:#111827;transition:width .2s}
.session-loading{text-align:center;padding:25px;color:#6b7280}.spinner{width:26px;height:26px;margin:auto;border:3px solid #e5e7eb;border-top-color:#111827;border-radius:50%;animation:spin .7s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}@media(max-width:500px){header b{font-size:16px}.files{grid-template-columns:repeat(2,1fr)}.actions button{padding:9px 11px}}
</style>
</head>

<body>
<header>
<b>🔐 Personal Vault</b>
<div><button id="lock" class="hidden">Lock</button> <button id="logout" class="hidden">Logout</button></div>
</header>

<main>
<div id="sessionLoading" class="card session-loading"><div class="spinner"></div>Checking secure session...</div>

<div id="login" class="card hidden">
<h2>🔐 Login</h2>
<input id="user" placeholder="Username" autocomplete="username">
<input id="pass" type="password" placeholder="Login Password" autocomplete="current-password">
<button id="loginBtn">Login</button><div id="loginMsg" class="msg"></div>
</div>

<div id="master" class="card hidden">
<h2>🔑 Master Password</h2><div class="small">Used only in this browser.</div>
<input id="masterPass" type="password" placeholder="Master Password" autocomplete="off">
<button id="unlockBtn">Unlock Vault</button><div id="masterMsg" class="msg"></div>
</div>

<div id="app" class="hidden">

<div class="card"><h2>🔐 Vault</h2><div class="stats">
<div class="stat"><b id="itemCount">0</b>Items</div>
<div class="stat"><b id="catCount">0</b>Categories</div>
<div class="stat"><b id="fileCount">0</b>Files</div>
</div></div>

<div class="card">
<h3>➕ Add Item</h3>
<select id="category"></select>
<input id="title" placeholder="Title">
<input id="username" placeholder="Username">
<input id="password" type="password" placeholder="Password" autocomplete="new-password">
<textarea id="backup" placeholder="Backup Codes"></textarea>
<textarea id="notes" placeholder="Notes"></textarea>
<button id="saveItem">Save Item</button><div id="itemMsg" class="msg"></div>
</div>

<div class="card">
<h3>📁 Categories</h3>
<input id="newCategory" placeholder="New category">
<button id="addCategory">Add Category</button>
<div id="categories"></div>
</div>

<div class="card"><h3>🔐 Vault Items</h3><div id="items"></div></div>

<div class="card">
<div class="viewbar"><h3>🖼️ Files</h3><div class="viewbuttons">
<button id="grid">Grid</button><button id="list">List</button>
</div></div>
<div class="small">Encrypted before upload • Maximum 60 MB</div>
<input id="file" type="file">
<div id="progress" class="progress hidden"><i id="progressBar"></i></div>
<div id="fileMsg" class="msg"></div><div id="files" class="files"></div>
</div>

</div>
</main>

<script>
const API="https://personal.createlk.workers.dev",DB="personal-vault-key";
let key=null,meta=null,files=[];
const $=id=>document.getElementById(id),say=(id,t)=>$(id).textContent=t;
const progressBar=$("progressBar");

function b64(a){let s="";for(let i=0;i<a.length;i+=32768)s+=String.fromCharCode(...a.subarray(i,i+32768));return btoa(s)}
function un64(s){let x=atob(s),a=new Uint8Array(x.length);for(let i=0;i<x.length;i++)a[i]=x.charCodeAt(i);return a}
function esc(s){return String(s??"").replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[m]))}

async function api(p,o={}){
o.credentials="include";o.headers={...(o.headers||{})};
let r=await fetch(API+p,o),d={};try{d=await r.json()}catch{}
if(!r.ok)throw Error(d.error||"Request failed");return d
}

async function derive(p,s){
let b=await crypto.subtle.importKey("raw",new TextEncoder().encode(p),"PBKDF2",false,["deriveKey"]);
return crypto.subtle.deriveKey({name:"PBKDF2",salt:s,iterations:600000,hash:"SHA-256"},b,{name:"AES-GCM",length:256},true,["encrypt","decrypt"])
}

async function enc(t){
let iv=crypto.getRandomValues(new Uint8Array(12));
let d=await crypto.subtle.encrypt({name:"AES-GCM",iv},key,new TextEncoder().encode(t||""));
return JSON.stringify({iv:b64(iv),data:b64(new Uint8Array(d))})
}

async function dec(v){
if(!v)return"";let x=JSON.parse(v);
let d=await crypto.subtle.decrypt({name:"AES-GCM",iv:un64(x.iv)},key,un64(x.data));
return new TextDecoder().decode(d)
}

function keyDB(){
return new Promise((ok,no)=>{
let r=indexedDB.open(DB,1);
r.onupgradeneeded=()=>r.result.createObjectStore("k");
r.onsuccess=()=>ok(r.result);r.onerror=()=>no(r.error)
})
}

async function saveKey(){
let d=await keyDB(),raw=await crypto.subtle.exportKey("raw",key);
d.transaction("k","readwrite").objectStore("k").put(b64(new Uint8Array(raw)),"key")
}

async function getKey(){
try{
let d=await keyDB(),v=await new Promise(ok=>{
let r=d.transaction("k").objectStore("k").get("key");
r.onsuccess=()=>ok(r.result);r.onerror=()=>ok(null)
});
return v?crypto.subtle.importKey("raw",un64(v),{name:"AES-GCM"},true,["encrypt","decrypt"]):null
}catch{return null}
}

async function clearKey(){
try{let d=await keyDB();d.transaction("k","readwrite").objectStore("k").delete("key")}catch{}
}

/* SESSION */
async function status(){
try{
let s=await api("/api/login/status");
if(!s.logged_in){$("login").classList.remove("hidden");return}
$("logout").classList.remove("hidden");
meta=await api("/api/vault/meta");key=await getKey();

if(key)try{if(await dec(meta.verifier)==="VAULT-CHECK"){openApp();return}}catch{}
key=null;$("master").classList.remove("hidden");
}catch(e){
console.error(e);$("login").classList.remove("hidden");say("loginMsg","Unable to check session.")
}finally{$("sessionLoading").classList.add("hidden")}
}

/* LOGIN */
$("loginBtn").onclick=async()=>{
say("loginMsg","");
try{
let r=await fetch(API+"/api/login",{
method:"POST",credentials:"include",
headers:{"Content-Type":"application/json"},
body:JSON.stringify({username:$("user").value.trim(),password:$("pass").value})
});
let d={};try{d=await r.json()}catch{}
if(!r.ok)throw Error(d.error||"Login failed");
let s=await api("/api/login/status");
if(!s.logged_in)throw Error("Session cookie was not accepted.");
$("login").classList.add("hidden");$("master").classList.remove("hidden");$("logout").classList.remove("hidden");
meta=await api("/api/vault/meta");$("pass").value="";
}catch(e){say("loginMsg",e.message)}
};

/* MASTER */
$("unlockBtn").onclick=async()=>{
say("masterMsg","");
try{
let p=$("masterPass").value;if(!p)throw Error("Enter Master Password.");

if(!meta.initialized){
let salt=crypto.getRandomValues(new Uint8Array(16));key=await derive(p,salt);
let verifier=await enc("VAULT-CHECK");
await api("/api/vault/meta",{
method:"POST",headers:{"Content-Type":"application/json"},
body:JSON.stringify({salt:b64(salt),verifier})
});
meta={initialized:true,salt:b64(salt),verifier};
}else{
key=await derive(p,un64(meta.salt));
if(await dec(meta.verifier)!=="VAULT-CHECK")throw Error("Incorrect master password.")
}

await saveKey();$("masterPass").value="";openApp();
}catch(e){key=null;say("masterMsg",e.message)}
};

function openApp(){
$("master").classList.add("hidden");$("app").classList.remove("hidden");$("lock").classList.remove("hidden");load()
}

$("lock").onclick=async()=>{
key=null;await clearKey();
$("app").classList.add("hidden");$("master").classList.remove("hidden");$("lock").classList.add("hidden")
};

$("logout").onclick=async()=>{
key=null;await clearKey();
try{await api("/api/logout",{method:"POST"})}catch{}location.reload()
};

/* CATEGORIES */
async function cats(){
let c=(await api("/api/categories")).categories||[];
$("catCount").textContent=c.length;
$("category").innerHTML=c.map(x=>`<option>${esc(x.name)}</option>`).join("")||"<option>General</option>";
$("categories").innerHTML=c.map(x=>`<div class="small">📁 ${esc(x.name)}</div>`).join("")
}

$("addCategory").onclick=async()=>{
let n=$("newCategory").value.trim();if(!n)return;
try{
await api("/api/categories",{
method:"POST",headers:{"Content-Type":"application/json"},
body:JSON.stringify({name:n})
});
$("newCategory").value="";await cats()
}catch(e){alert(e.message)}
};

/* ITEMS */
async function items(){
let a=(await api("/api/items")).items||[];
$("itemCount").textContent=a.length;$("items").innerHTML="";

for(let x of a){
let u="",p="",b="",n="";
try{
u=await dec(x.username);p=await dec(x.encrypted_password);
b=await dec(x.encrypted_backup_codes);n=await dec(x.encrypted_notes)
}catch{}

let d=document.createElement("div");d.className="item";
d.innerHTML=`
<b>${esc(x.title)}</b>
<div class="small">📁 ${esc(x.category)}</div>
<div class="actions">
<button type="button">Show</button>
<button type="button" class="danger">Delete</button>
</div>
<div class="secret hidden">
<p><b>Username</b><br>${esc(u)}</p>
<p><b>Password</b><br>${esc(p)}</p>
<p><b>Backup Codes</b><br>${esc(b).replace(/\n/g,"<br>")}</p>
<p><b>Notes</b><br>${esc(n).replace(/\n/g,"<br>")}</p>
</div>`;

let show=d.querySelector("button");
show.onclick=function(){
let s=d.querySelector(".secret");s.classList.toggle("hidden");
this.textContent=s.classList.contains("hidden")?"Show":"Hide"
};

d.querySelector(".danger").onclick=async()=>{
if(confirm("Delete this item?")){
try{await api("/api/items/"+x.id,{method:"DELETE"});await items()}
catch(e){alert(e.message)}
}
};

$("items").append(d)
}
}

$("saveItem").onclick=async()=>{
say("itemMsg","");
try{
if(!$("title").value.trim())throw Error("Enter a title.");

await api("/api/items",{
method:"POST",headers:{"Content-Type":"application/json"},
body:JSON.stringify({
category:$("category").value||"General",
title:$("title").value,
username:await enc($("username").value),
encrypted_password:await enc($("password").value),
encrypted_backup_codes:await enc($("backup").value),
encrypted_notes:await enc($("notes").value)
})
});

["title","username","password","backup","notes"].forEach(x=>$(x).value="");
say("itemMsg","Item saved.");await items();
}catch(e){say("itemMsg",e.message)}
};

/* FILES */
async function fileData(f){
let r=await fetch(API+"/api/photos/"+f.id+"/download",{credentials:"include",cache:"no-store"});
if(!r.ok)throw Error("File unavailable.");
let a=new Uint8Array(await r.arrayBuffer());
return crypto.subtle.decrypt({name:"AES-GCM",iv:a.slice(0,12)},key,a.slice(12))
}

async function fileURL(f){
return URL.createObjectURL(new Blob([await fileData(f)],{type:f.file_type||"application/octet-stream"}))
}

async function loadFiles(){
try{
files=(await api("/api/photos")).files||[];
$("fileCount").textContent=files.length;$("files").innerHTML="";

files.forEach(f=>{
let d=document.createElement("div");d.className="file";
d.innerHTML=`
<div class="preview"><span class="icon">📄</span></div>
<div class="fileinfo">
<div class="filename">${esc(f.filename)}</div>
<div class="small">${Math.round((f.file_size||0)/1024)} KB</div>
<div class="actions">
<button type="button">View</button>
<button type="button">Download</button>
<button type="button" class="danger">Delete</button>
</div>
</div>`;

let pv=d.querySelector(".preview");

if(f.file_type?.startsWith("image/"))
fileURL(f).then(u=>pv.innerHTML=`<img src="${u}" alt="">`)
.catch(()=>pv.innerHTML=`<span class="icon">🖼️</span>`);

if(f.file_type?.startsWith("video/"))
fileURL(f).then(u=>pv.innerHTML=`<video src="${u}" muted playsinline preload="metadata"></video>`)
.catch(()=>pv.innerHTML=`<span class="icon">🎬</span>`);

let bs=d.querySelectorAll("button");
bs[0].onclick=()=>view(f);
bs[1].onclick=()=>download(f);
bs[2].onclick=async()=>{
if(confirm("Delete this file?")){
try{await api("/api/photos/"+f.id,{method:"DELETE"});await loadFiles()}
catch(e){say("fileMsg",e.message)}
}
};

$("files").append(d)
});
}catch(e){say("fileMsg",e.message)}
}

/* VIEW */
async function view(f){
let w=window.open("","_blank");
if(!w)return alert("Please allow pop-ups.");
w.document.write("<p>Opening...</p>");

try{
let u=await fileURL(f);w.document.body.innerHTML="";
if(f.file_type?.startsWith("image/"))
w.document.body.innerHTML=`<img src="${u}" style="max-width:100%;max-height:100vh;display:block;margin:auto">`;
else if(f.file_type?.startsWith("video/"))
w.document.body.innerHTML=`<video src="${u}" controls autoplay style="width:100%;height:100vh"></video>`;
else
w.document.body.innerHTML=`<a href="${u}" download="${esc(f.filename)}" style="font-size:20px">Download ${esc(f.filename)}</a>`;
}catch(e){w.document.body.textContent=e.message}
}

/* DOWNLOAD */
async function download(f){
try{
say("fileMsg","Preparing download...");
let u=await fileURL(f),a=document.createElement("a");
a.href=u;a.download=f.filename;document.body.append(a);a.click();
setTimeout(()=>{a.remove();URL.revokeObjectURL(u)},5000);
say("fileMsg","Download started.")
}catch(e){say("fileMsg",e.message)}
}

/* UPLOAD */
$("file").onchange=async()=>{
let f=$("file").files[0];if(!f)return;

if(f.size>60*1024*1024){
$("file").value="";return say("fileMsg","Maximum 60 MB.")
}

$("progress").classList.remove("hidden");
progressBar.style.width="0%";
say("fileMsg","Encrypting file...");

try{
let iv=crypto.getRandomValues(new Uint8Array(12));
let d=new Uint8Array(await crypto.subtle.encrypt(
{name:"AES-GCM",iv},key,await f.arrayBuffer()
));

let a=new Uint8Array(12+d.length);a.set(iv);a.set(d,12);

progressBar.style.width="50%";
say("fileMsg","Uploading...");

let r=await fetch(API+"/api/photos",{
method:"POST",credentials:"include",
headers:{
"Content-Type":"application/octet-stream",
"X-Filename":encodeURIComponent(f.name),
"X-File-Type":f.type||"application/octet-stream"
},
body:a
});

if(!r.ok){
let x={};try{x=await r.json()}catch{}
throw Error(x.error||"Upload failed.")
}

progressBar.style.width="100%";
$("file").value="";say("fileMsg","File uploaded.");
await loadFiles();

}catch(e){
console.error(e);say("fileMsg",e.message)
}finally{
setTimeout(()=>{
$("progress").classList.add("hidden");
progressBar.style.width="0%";
},700)
}
};

/* VIEW MODE */
function mode(m){
$("files").classList.toggle("list",m==="list");
localStorage.fileView=m
}

$("grid").onclick=()=>mode("grid");
$("list").onclick=()=>mode("list");
mode(localStorage.fileView||"grid");

async function load(){
await cats();await items();await loadFiles()
}

status();
</script>
</body>
</html>