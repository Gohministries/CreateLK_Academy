
/**
 * CreateLK Marketplace API
 * Worker: createlk-marketplace-api
 * Database binding: DB
 *
 * Required D1 tables:
 * users, sessions, listings
 *
 * Required environment variables:
 * GOOGLE_CLIENT_ID
 * ALLOWED_ORIGIN
 */

const SESSION_DAYS = 30;
const MAX_PAGE_SIZE = 24;

function json(data, status = 200, headers = {}) {
  return new Response(JSON.stringify(data), {
    status,
    headers: {
      "Content-Type": "application/json; charset=utf-8",
      "Cache-Control": "no-store",
      ...headers,
    },
  });
}

function getAllowedOrigins(env) {
  return (env.ALLOWED_ORIGIN || "https://createlk.com,https://www.createlk.com")
    .split(",")
    .map((origin) => origin.trim())
    .filter(Boolean);
}

function corsHeaders(request, env) {
  const origin = request.headers.get("Origin") || "";
  const allowed = getAllowedOrigins(env);
  const headers = {
    "Access-Control-Allow-Methods": "GET, POST, OPTIONS",
    "Access-Control-Allow-Headers": "Content-Type, Authorization",
    "Access-Control-Max-Age": "86400",
    "Vary": "Origin",
  };

  if (allowed.includes(origin)) {
    headers["Access-Control-Allow-Origin"] = origin;
  }

  return headers;
}

function respond(request, env, data, status = 200) {
  return json(data, status, corsHeaders(request, env));
}

async function sha256(value) {
  const bytes = new TextEncoder().encode(value);
  const hash = await crypto.subtle.digest("SHA-256", bytes);
  return Array.from(new Uint8Array(hash))
    .map((byte) => byte.toString(16).padStart(2, "0"))
    .join("");
}

function createToken() {
  const bytes = crypto.getRandomValues(new Uint8Array(32));
  return Array.from(bytes)
    .map((byte) => byte.toString(16).padStart(2, "0"))
    .join("");
}

async function readJson(request) {
  try {
    return await request.json();
  } catch {
    return null;
  }
}

function getBearerToken(request) {
  const header = request.headers.get("Authorization") || "";
  const match = header.match(/^Bearer\s+(.+)$/i);
  return match ? match[1].trim() : "";
}

async function getCurrentUser(request, env) {
  const token = getBearerToken(request);
  if (!token) return null;

  const tokenHash = await sha256(token);
  const now = Math.floor(Date.now() / 1000);

  return await env.DB.prepare(`
    SELECT
      u.id,
      u.google_id,
      u.email,
      u.display_name,
      u.avatar_url,
      u.role,
      s.expires_at
    FROM sessions s
    JOIN users u ON u.id = s.user_id
    WHERE s.token_hash = ?
      AND s.expires_at > ?
    LIMIT 1
  `).bind(tokenHash, now).first();
}

function publicUser(user) {
  return {
    id: user.id,
    email: user.email,
    name: user.display_name || "",
    avatar: user.avatar_url || "",
    role: user.role || "user",
  };
}

async function googleLogin(request, env) {
  if (!env.GOOGLE_CLIENT_ID) {
    return respond(request, env, {
      error: "Google login is not configured on the server.",
    }, 500);
  }

  const body = await readJson(request);
  const idToken = body?.id_token;

  if (typeof idToken !== "string" || !idToken.trim()) {
    return respond(request, env, {
      error: "A Google ID token is required.",
    }, 400);
  }

  let googleData;

  try {
    const verificationUrl = new URL(
      "https://oauth2.googleapis.com/tokeninfo"
    );
    verificationUrl.searchParams.set("id_token", idToken);

    const response = await fetch(verificationUrl.toString());

    if (!response.ok) {
      return respond(request, env, {
        error: "Google login verification failed. Please sign in again.",
      }, 401);
    }

    googleData = await response.json();
  } catch {
    return respond(request, env, {
      error: "Unable to verify the Google login right now.",
    }, 502);
  }

  const verifiedEmail =
    googleData.email_verified === true ||
    googleData.email_verified === "true";

  if (
    googleData.aud !== env.GOOGLE_CLIENT_ID ||
    !googleData.sub ||
    !googleData.email ||
    !verifiedEmail
  ) {
    return respond(request, env, {
      error: "Invalid or unverified Google account.",
    }, 401);
  }

  const googleId = googleData.sub;
  const email = googleData.email.toLowerCase();
  const name = googleData.name || "";
  const avatar = googleData.picture || "";

  try {
    await env.DB.prepare(`
      INSERT INTO users (
        google_id,
        email,
        display_name,
        avatar_url
      )
      VALUES (?, ?, ?, ?)
      ON CONFLICT(google_id) DO UPDATE SET
        email = excluded.email,
        display_name = excluded.display_name,
        avatar_url = excluded.avatar_url
    `).bind(googleId, email, name, avatar).run();

    const user = await env.DB.prepare(`
      SELECT id, email, display_name, avatar_url, role
      FROM users
      WHERE google_id = ?
      LIMIT 1
    `).bind(googleId).first();

    if (!user) {
      return respond(request, env, {
        error: "Unable to create the user account.",
      }, 500);
    }

    const token = createToken();
    const tokenHash = await sha256(token);
    const expiresAt =
      Math.floor(Date.now() / 1000) + SESSION_DAYS * 86400;

    await env.DB.prepare(`
      INSERT INTO sessions (token_hash, user_id, expires_at)
      VALUES (?, ?, ?)
    `).bind(tokenHash, user.id, expiresAt).run();

    return respond(request, env, {
      success: true,
      token,
      expires_at: expiresAt,
      user: publicUser(user),
    });
  } catch (error) {
    console.error("Google login database error:", error);
    return respond(request, env, {
      error: "Unable to complete login. Please try again.",
    }, 500);
  }
}

async function getMe(request, env) {
  try {
    const user = await getCurrentUser(request, env);

    if (!user) {
      return respond(request, env, {
        authenticated: false,
        error: "Your session is missing or expired.",
      }, 401);
    }

    return respond(request, env, {
      authenticated: true,
      user: publicUser(user),
      expires_at: user.expires_at,
    });
  } catch (error) {
    console.error("Session lookup error:", error);
    return respond(request, env, {
      error: "Unable to check your session.",
    }, 500);
  }
}

async function logout(request, env) {
  const token = getBearerToken(request);

  if (token) {
    try {
      const tokenHash = await sha256(token);
      await env.DB.prepare(`
        DELETE FROM sessions WHERE token_hash = ?
      `).bind(tokenHash).run();
    } catch (error) {
      console.error("Logout error:", error);
      return respond(request, env, {
        error: "Unable to end the session.",
      }, 500);
    }
  }

  return respond(request, env, { success: true });
}

async function getListings(request, env) {
  const url = new URL(request.url);

  const q = (url.searchParams.get("q") ||
    url.searchParams.get("search") || "").trim().slice(0, 100);

  const category = (url.searchParams.get("category") || "")
    .trim().slice(0, 80);

  const district = (url.searchParams.get("district") || "")
    .trim().slice(0, 80);

  const requestedPage = Number.parseInt(
    url.searchParams.get("page") || "1", 10
  );

  const requestedLimit = Number.parseInt(
    url.searchParams.get("limit") || "12", 10
  );

  const page = Number.isFinite(requestedPage)
    ? Math.max(1, Math.min(requestedPage, 1000000))
    : 1;

  const limit = Number.isFinite(requestedLimit)
    ? Math.max(1, Math.min(requestedLimit, MAX_PAGE_SIZE))
    : 12;

  const conditions = [`status = 'approved'`];
  const values = [];

  if (q) {
    conditions.push(
      "(title LIKE ? OR description LIKE ? OR town LIKE ?)"
    );
    const term = `%${q}%`;
    values.push(term, term, term);
  }

  if (category) {
    conditions.push("category = ?");
    values.push(category);
  }

  if (district) {
    conditions.push("district = ?");
    values.push(district);
  }

  const where = conditions.join(" AND ");
  const offset = (page - 1) * limit;

  try {
    const countResult = await env.DB.prepare(`
      SELECT COUNT(*) AS total
      FROM listings
      WHERE ${where}
    `).bind(...values).first();

    const results = await env.DB.prepare(`
      SELECT
        id,
        title,
        description,
        price_lkr,
        category,
        district,
        town,
        image_url,
        contact_phone,
        seller_name,
        created_at
      FROM listings
      WHERE ${where}
      ORDER BY created_at DESC, id DESC
      LIMIT ? OFFSET ?
    `).bind(...values, limit, offset).all();

    const total = Number(countResult?.total || 0);

    return respond(request, env, {
      success: true,
      listings: results.results || [],
      pagination: {
        page,
        limit,
        total,
        total_pages: Math.ceil(total / limit),
      },
    });
  } catch (error) {
    console.error("Listings query error:", error);
    return respond(request, env, {
      error: "Unable to load listings.",
    }, 500);
  }
}

async function getListing(request, env, id) {
  if (!/^\d+$/.test(id)) {
    return respond(request, env, {
      error: "Invalid listing ID.",
    }, 400);
  }

  try {
    const listing = await env.DB.prepare(`
      SELECT
        id,
        title,
        description,
        price_lkr,
        category,
        district,
        town,
        image_url,
        contact_phone,
        seller_name,
        created_at
      FROM listings
      WHERE id = ? AND status = 'approved'
      LIMIT 1
    `).bind(Number(id)).first();

    if (!listing) {
      return respond(request, env, {
        error: "Listing not found.",
      }, 404);
    }

    return respond(request, env, {
      success: true,
      listing,
    });
  } catch (error) {
    console.error("Listing detail error:", error);
    return respond(request, env, {
      error: "Unable to load this listing.",
    }, 500);
  }
}

async function handleRequest(request, env) {
  const url = new URL(request.url);
  const path = url.pathname.replace(/\/+$/, "") || "/";
  const method = request.method.toUpperCase();

  if (method === "OPTIONS") {
    const headers = corsHeaders(request, env);

    if (
      request.headers.get("Origin") &&
      !headers["Access-Control-Allow-Origin"]
    ) {
      return new Response(null, { status: 403 });
    }

    return new Response(null, { status: 204, headers });
  }

  const origin = request.headers.get("Origin");
  if (origin && !getAllowedOrigins(env).includes(origin)) {
    return respond(request, env, {
      error: "Origin not allowed.",
    }, 403);
  }

  if (method === "GET" && path === "/") {
    return respond(request, env, {
      service: "CreateLK Marketplace API",
      status: "running",
      version: "1.0.0",
    });
  }

  if (method === "POST" && path === "/api/auth/google") {
    return googleLogin(request, env);
  }

  if (method === "GET" && path === "/api/auth/me") {
    return getMe(request, env);
  }

  if (method === "POST" && path === "/api/auth/logout") {
    return logout(request, env);
  }

  if (method === "GET" && path === "/api/listings") {
    return getListings(request, env);
  }

  const listingMatch = path.match(/^\/api\/listings\/(\d+)$/);

  if (method === "GET" && listingMatch) {
    return getListing(request, env, listingMatch[1]);
  }

  return respond(request, env, {
    error: "Endpoint not found.",
  }, 404);
}

export default {
  async fetch(request, env) {
    try {
      return await handleRequest(request, env);
    } catch (error) {
      console.error("Unexpected Worker error:", error);

      const headers = corsHeaders(request, env);
      return json({
        error: "An unexpected server error occurred.",
      }, 500, headers);
    }
  },
};
