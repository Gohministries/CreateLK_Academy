<script>
const STATS_API="https://createlk-public-stats.createlk.workers.dev/";
const BASE={free:380,premium:120,certificates:18};

async function loadStats(){
try{
const r=await fetch(STATS_API,{cache:"no-store"});
if(!r.ok)throw Error("API error");
const d=await r.json();
if(!d.success)throw Error("Invalid response");

animate("freeStudents",BASE.free+Number(d.freeStudents||0));
animate("premiumStudents",BASE.premium+Number(d.premiumStudents||0));
animate("certificatesIssued",BASE.certificates+Number(d.certificatesIssued||0));
}catch(e){
console.log("Statistics unavailable:",e);
}
}

function animate(id,target){
const el=document.getElementById(id);
if(!el)return;

const start=Number(el.textContent.replace(/,/g,""))||0;
const duration=900;
const begin=performance.now();

function frame(now){
const p=Math.min((now-begin)/duration,1);
const value=Math.round(start+(target-start)*(1-Math.pow(1-p,3)));
el.textContent=value.toLocaleString();
if(p<1)requestAnimationFrame(frame);
}

requestAnimationFrame(frame);
}

loadStats();

/* Referral */
const REFERRAL_KEY="createlk_referral_code";
const ref=new URLSearchParams(location.search).get("ref");

if(ref){
const code=ref.trim().toUpperCase();

if(/^CLK[0-9]{5}$/.test(code)){
localStorage.setItem(REFERRAL_KEY,code);
location.href="register.html?ref="+encodeURIComponent(code);
}
}
</script>

