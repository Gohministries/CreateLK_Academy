const SITE="https://createlk.com";
const PAY="https://pay-a.createlk.workers.dev";
const AFF="https://affiliate-a.createlk.workers.dev";

const SESSION="english_session";
const COINS=5;
const XP=10;
const MAX=3;
const DAYS=30;
const SESSION_DAYS=30;

const origin=r=>{
  const o=r.headers.get("Origin")||"";
  return o==="https://createlk.com"||o==="https://www.createlk.com"?o:SITE;
};

const H=r=>({
  "Content-Type":"application/json",
  "Access-Control-Allow-Origin":origin(r),
  "Access-Control-Allow-Credentials":"true",
  "Access-Control-Allow-Methods":"GET,POST,OPTIONS",
  "Access-Control-Allow-Headers":"Content-Type",
  "Vary":"Origin"
});

const json=(o,s=200,r)=>new Response(JSON.stringify(o),{
  status:s,
  headers:H(r)
});

const err=(x,s=400,e={},r)=>json({
  success:false,
  error:x,
  ...e
},s,r);

const body=async r=>{
  try{return await r.json()}catch{return{}}
};

const cookie=(r,n)=>
  r.headers.get("Cookie")?.match(
    new RegExp(`${n}=([^;]+)`)
  )?.[1]||"";

const token=r=>cookie(r,SESSION);
const now=()=>Date.now();

async function user(r,e){
  const s=token(r);
  if(!s)return null;

  const x=await e.DB.prepare(
    "SELECT u.* FROM users u JOIN sessions s ON s.user_id=u.id WHERE s.token_hash=? AND s.expires_at>?"
  ).bind(
    s,
    new Date().toISOString()
  ).first();

  return x||null;
}

async function rewards(id,e){
  let x=await e.DB.prepare(
    "SELECT coins,xp FROM user_rewards WHERE user_id=?"
  ).bind(id).first();

  if(!x){
    await e.DB.prepare(
      "INSERT INTO user_rewards(user_id,coins,xp,updated_at) VALUES(?,?,?,?)"
    ).bind(
      id,
      0,
      0,
      new Date().toISOString()
    ).run();

    x={coins:0,xp:0};
  }

  return x;
}

async function me(r,e){
  const u=await user(r,e);

  if(!u){
    return json({
      success:true,
      user:null,
      premium:false,
      coins:0,
      xp:0
    },200,r);
  }

  const p=await e.DB.prepare(
    "SELECT membership_expiry FROM premium_users WHERE user_id=? AND membership_expiry>?"
  ).bind(
    u.id,
    new Date().toISOString()
  ).first();

  const rw=await rewards(u.id,e);
  const premium=!!p;

  return json({
    success:true,
    user:{
      id:u.id,
      name:u.name,
      email:u.email,
      picture:u.picture||null,
      membership_status:premium?"PREMIUM":"FREE",
      membership_expiry:p?.membership_expiry||null,
      is_premium:premium,
      coins:Number(rw.coins||0),
      xp:Number(rw.xp||0)
    },
    premium,
    membership_expiry:p?.membership_expiry||null,
    coins:Number(rw.coins||0),
    xp:Number(rw.xp||0)
  },200,r);
}

async function titles(r,e){
  const x=await e.DB.prepare(
    "SELECT id,title,access_type,active FROM lessons WHERE active=1 ORDER BY id"
  ).all();

  return json({
    success:true,
    titles:(x.results||[]).map(x=>({
      id:x.id,
      title:x.title,
      access_type:x.access_type,
      premium:String(x.access_type||"").toUpperCase()==="PREMIUM"
    }))
  },200,r);
}

async function questions(r,e){
  const u=await user(r,e);
  if(!u)return err("Login required",401,{},r);

  const url=new URL(r.url);
  const lid=Number(url.searchParams.get("lesson_id"));

  if(!lid)return err("Lesson required",400,{},r);

  const l=await e.DB.prepare(
    "SELECT id,title,access_type,active FROM lessons WHERE id=? AND active=1"
  ).bind(lid).first();

  if(!l)return err("Lesson not found",404,{},r);

  const p=await e.DB.prepare(
    "SELECT membership_expiry FROM premium_users WHERE user_id=? AND membership_expiry>?"
  ).bind(
    u.id,
    new Date().toISOString()
  ).first();

  const premium=!!p;

  if(
    String(l.access_type||"").toUpperCase()==="PREMIUM" &&
    lid!==1 &&
    !premium
  ){
    return json({
      success:false,
      premium_required:true,
      error:"Premium membership required."
    },403,r);
  }

  const q=await e.DB.prepare(
    `SELECT id,lesson_id,question,option_a,option_b,option_c,option_d
     FROM questions
     WHERE lesson_id=? AND active=1
     ORDER BY id`
  ).bind(lid).all();

  return json({
    success:true,
    lesson:{
      id:l.id,
      title:l.title
    },
    questions:q.results||[]
  },200,r);
}

async function start(r,e){
  const u=await user(r,e);
  if(!u)return err("Login required",401,{},r);

  const b=await body(r);
  const lid=Number(b.lesson_id);

  if(!lid)return err("Lesson required",400,{},r);

  const l=await e.DB.prepare(
    "SELECT id,title,access_type,active FROM lessons WHERE id=? AND active=1"
  ).bind(lid).first();

  if(!l)return err("Lesson not found",404,{},r);

  const p=await e.DB.prepare(
    "SELECT membership_expiry FROM premium_users WHERE user_id=? AND membership_expiry>?"
  ).bind(
    u.id,
    new Date().toISOString()
  ).first();

  const premium=!!p;

  if(
    String(l.access_type||"").toUpperCase()==="PREMIUM" &&
    lid!==1 &&
    !premium
  ){
    return json({
      success:false,
      premium_required:true,
      error:"Premium membership required."
    },403,r);
  }

  const since=new Date(
    now()-DAYS*86400000
  ).toISOString();

  const c=await e.DB.prepare(
    "SELECT COUNT(*) AS n FROM quiz_results WHERE user_id=? AND completed_at>=?"
  ).bind(
    u.id,
    since
  ).first();

  if(Number(c?.n||0)>=MAX){
    return json({
      success:false,
      max_attempts:true,
      error:"You can submit a maximum of 3 quizzes in 30 days."
    },429,r);
  }

  const id=crypto.randomUUID();

  await e.DB.prepare(
    "INSERT INTO quiz_attempts(id,user_id,lesson_id,created_at) VALUES(?,?,?,?)"
  ).bind(
    id,
    u.id,
    lid,
    new Date().toISOString()
  ).run();

  return json({
    success:true,
    attempt_id:id,
    lesson_id:lid
  },200,r);
}

async function check(r,e){
  const u=await user(r,e);
  if(!u)return err("Login required",401,{},r);

  const b=await body(r);

  const q=await e.DB.prepare(
    "SELECT id,correct_answer FROM questions WHERE id=? AND active=1"
  ).bind(
    Number(b.question_id)
  ).first();

  if(!q)return err("Question not found",404,{},r);

  const n=v=>{
    v=String(v??"")
      .trim()
      .toLowerCase()
      .replace(/[.)]$/,"");

    return {
      1:"a",
      2:"b",
      3:"c",
      4:"d",
      a:"a",
      b:"b",
      c:"c",
      d:"d"
    }[v]||null;
  };

  const selected=n(b.answer);
  const correctAnswer=n(q.correct_answer);
  const correct=
    selected!==null &&
    correctAnswer!==null &&
    selected===correctAnswer;

  return json({
    success:true,
    correct,
    selected_answer:selected,
    correct_answer:correctAnswer,
    reward_coins:correct?COINS:0,
    reward_xp:correct?XP:0
  },200,r);
}

async function submit(r,e){
  const u=await user(r,e);
  if(!u)return err("Login required",401,{},r);

  const b=await body(r);
  const lid=Number(b.lesson_id);
  const aid=String(b.attempt_id||"");

  if(!lid||!aid)return err("Invalid quiz.",400,{},r);

  const a=await e.DB.prepare(
    "SELECT id,user_id,lesson_id,completed_at FROM quiz_attempts WHERE id=? AND user_id=? AND lesson_id=?"
  ).bind(
    aid,
    u.id,
    lid
  ).first();

  if(!a)return err("Quiz attempt not found.",404,{},r);
  if(a.completed_at)return err("Quiz already submitted.",400,{},r);

  const q=await e.DB.prepare(
    `SELECT id,correct_answer
     FROM questions
     WHERE lesson_id=? AND active=1
     ORDER BY id`
  ).bind(lid).all();

  const questions=q.results||[];
  const answers=Array.isArray(b.answers)?b.answers:[];

  const n=v=>{
    v=String(v??"")
      .trim()
      .toLowerCase()
      .replace(/[.)]$/,"");

    return {
      1:"a",
      2:"b",
      3:"c",
      4:"d",
      a:"a",
      b:"b",
      c:"c",
      d:"d"
    }[v]||null;
  };

  let score=0;

  for(const qx of questions){
    const ax=answers.find(
      x=>Number(x.question_id)===Number(qx.id)
    );

    if(
      ax &&
      n(ax.answer) &&
      n(ax.answer)===n(qx.correct_answer)
    ){
      score++;
    }
  }

  const total=questions.length;
  const percentage=total
    ?Math.round(score/total*100)
    :0;

  const completed=new Date().toISOString();

  await e.DB.prepare(
    `INSERT INTO quiz_results
     (user_id,lesson_id,score,total,percentage,completed_at)
     VALUES(?,?,?,?,?,?)`
  ).bind(
    u.id,
    lid,
    score,
    total,
    percentage,
    completed
  ).run();

  await e.DB.prepare(
    "UPDATE quiz_attempts SET completed_at=? WHERE id=?"
  ).bind(
    completed,
    aid
  ).run();

  const rewardCoins=score*COINS;
  const rewardXp=score*XP;

  await e.DB.prepare(
    `INSERT INTO user_rewards(user_id,coins,xp,updated_at)
     VALUES(?,?,?,?)
     ON CONFLICT(user_id)
     DO UPDATE SET
     coins=user_rewards.coins+excluded.coins,
     xp=user_rewards.xp+excluded.xp,
     updated_at=excluded.updated_at`
  ).bind(
    u.id,
    rewardCoins,
    rewardXp,
    completed
  ).run();

  const rw=await rewards(u.id,e);

  return json({
    success:true,
    score,
    total,
    percentage,
    coins:rewardCoins,
    xp:rewardXp,
    reward_coins:rewardCoins,
    reward_xp:rewardXp,
    total_coins:Number(rw.coins||0),
    total_xp:Number(rw.xp||0)
  },200,r);
}

async function logout(r,e){
  const s=token(r);

  if(s){
    await e.DB.prepare(
      "DELETE FROM sessions WHERE token_hash=?"
    ).bind(s).run();
  }

  return new Response(null,{
    status:302,
    headers:{
      "Location":SITE+"/a/",
      "Set-Cookie":`${SESSION}=; Path=/; HttpOnly; Secure; SameSite=None; Max-Age=0`
    }
  });
}

async function google(r,e){
  const state=crypto.randomUUID();

  await e.DB.prepare(
    "INSERT INTO oauth_states(state,expires_at) VALUES(?,?)"
  ).bind(
    state,
    now()+10*60*1000
  ).run();

  const u=new URL("https://accounts.google.com/o/oauth2/v2/auth");

  u.searchParams.set("client_id",e.GOOGLE_CLIENT_ID);
  u.searchParams.set(
    "redirect_uri",
    "https://eng-a.createlk.workers.dev/auth/callback"
  );
  u.searchParams.set("response_type","code");
  u.searchParams.set("scope","openid email profile");
  u.searchParams.set("state",state);
  u.searchParams.set("access_type","offline");
  u.searchParams.set("prompt","select_account");

  return Response.redirect(u.toString(),302);
}

async function callback(r,e){
  const url=new URL(r.url);
  const code=url.searchParams.get("code");
  const state=url.searchParams.get("state");

  if(!code||!state)return err("Invalid Google login.",400,{},r);

  const st=await e.DB.prepare(
    "SELECT state FROM oauth_states WHERE state=? AND expires_at>?"
  ).bind(
    state,
    now()
  ).first();

  if(!st)return err("Login session expired.",400,{},r);

  await e.DB.prepare(
    "DELETE FROM oauth_states WHERE state=?"
  ).bind(state).run();

  const tr=await fetch(
    "https://oauth2.googleapis.com/token",
    {
      method:"POST",
      headers:{
        "Content-Type":"application/x-www-form-urlencoded"
      },
      body:new URLSearchParams({
        code,
        client_id:e.GOOGLE_CLIENT_ID,
        client_secret:e.GOOGLE_CLIENT_SECRET,
        redirect_uri:"https://eng-a.createlk.workers.dev/auth/callback",
        grant_type:"authorization_code"
      })
    }
  );

  const td=await tr.json();

  if(!td.access_token){
    return err("Google login failed.",400,{},r);
  }

  const gr=await fetch(
    "https://openidconnect.googleapis.com/v1/userinfo",
    {
      headers:{
        Authorization:`Bearer ${td.access_token}`
      }
    }
  );

  const g=await gr.json();

  if(!g.sub||!g.email){
    return err("Unable to read Google account.",400,{},r);
  }

  let u=await e.DB.prepare(
    "SELECT * FROM users WHERE google_id=? OR email=? LIMIT 1"
  ).bind(
    g.sub,
    g.email
  ).first();

  if(!u){
    await e.DB.prepare(
      `INSERT INTO users
       (google_id,name,email,membership_status,auth_provider,picture)
       VALUES(?,?,?,?,?,?)`
    ).bind(
      g.sub,
      g.name||g.email.split("@")[0],
      g.email,
      "FREE",
      "google",
      g.picture||null
    ).run();

    u=await e.DB.prepare(
      "SELECT * FROM users WHERE google_id=?"
    ).bind(g.sub).first();
  }else{
    await e.DB.prepare(
      `UPDATE users
       SET google_id=?,name=?,picture=?,auth_provider='google'
       WHERE id=?`
    ).bind(
      g.sub,
      g.name||u.name,
      g.picture||u.picture||null,
      u.id
    ).run();
  }

  await rewards(u.id,e);

  const s=crypto.randomUUID();
  const exp=now()+SESSION_DAYS*86400000;

  await e.DB.prepare(
    `INSERT INTO sessions
     (user_id,token_hash,expires_at,created_at)
     VALUES(?,?,?,?)`
  ).bind(
    u.id,
    s,
    new Date(exp).toISOString(),
    new Date().toISOString()
  ).run();

  return new Response(null,{
    status:302,
    headers:{
      "Location":SITE+"/a/",
      "Set-Cookie":
        `${SESSION}=${s}; Path=/; HttpOnly; Secure; SameSite=None; Max-Age=${SESSION_DAYS*86400}`
    }
  });
}

export default{
  async fetch(r,e){
    if(r.method==="OPTIONS"){
      return new Response(null,{
        status:204,
        headers:H(r)
      });
    }

    const p=new URL(r.url).pathname;

    try{
      if(p==="/api/me")return me(r,e);
      if(p==="/api/titles")return titles(r,e);
      if(p==="/api/questions")return questions(r,e);
      if(p==="/api/quiz/start")return start(r,e);
      if(p==="/api/quiz/check")return check(r,e);
      if(p==="/api/quiz/submit")return submit(r,e);
      if(p==="/auth/google")return google(r,e);
      if(p==="/auth/callback")return callback(r,e);
      if(p==="/auth/logout")return logout(r,e);

      return new Response("CreateLK English",{status:200});
    }catch(x){
      return err(
        x?.message||"Server error",
        500,
        {},
        r
      );
    }
  }
};