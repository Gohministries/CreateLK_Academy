const SITE="https://createlk.com";
const AFF="https://affiliate-a.createlk.workers.dev";
const SESSION="english_session";
const REFERRAL="english_referral";
const COINS=5,XP=10,MAX=3,DAYS=30;

const cors=o=>({
  "Access-Control-Allow-Origin":o||SITE,
  "Access-Control-Allow-Credentials":"true",
  "Access-Control-Allow-Headers":"Content-Type,Authorization",
  "Access-Control-Allow-Methods":"GET,POST,OPTIONS"
});

function json(d,s=200,o,extra={}){
  const h={...cors(o),"Content-Type":"application/json",...extra};
  return new Response(JSON.stringify(d),{status:s,headers:h});
}

function cookie(req,n){
  const x=(req.headers.get("Cookie")||"").split(";").find(x=>x.trim().startsWith(n+"="));
  return x?decodeURIComponent(x.trim().slice(n.length+1)):null;
}

function setCookie(n,v,max){
  return `${n}=${encodeURIComponent(v)}; Max-Age=${max}; Path=/; Secure; HttpOnly; SameSite=Lax`;
}

const delCookie=n=>`${n}=; Max-Age=0; Path=/; Secure; HttpOnly; SameSite=Lax`;
const now=()=>new Date().toISOString();
const future=d=>new Date(Date.now()+d*86400000).toISOString();
const clean=x=>String(x??"").trim();

function answer(x){
  x=clean(x).toLowerCase();
  return ["a","b","c","d"].includes(x)?x:
    ["1","2","3","4"].includes(x)
      ?["a","b","c","d"][Number(x)-1]:"";
}

function numAnswer(x){
  const a=answer(x);
  return a?["a","b","c","d"].indexOf(a)+1:0;
}

function letter(n){
  return ["","a","b","c","d"][Number(n)]||"";
}

async function user(req,e){
  const t=cookie(req,SESSION);
  if(!t)return null;

  return e.DB.prepare(
    `SELECT u.id,u.google_id,u.name,u.email,u.membership_status,
    u.membership_expiry,u.picture,s.expires_at
    FROM sessions s JOIN users u ON u.id=s.user_id
    WHERE s.token_hash=? AND s.expires_at>? LIMIT 1`
  ).bind(t,now()).first();
}

async function rewards(e,id){
  let r=await e.DB.prepare(
    "SELECT user_id,coins,xp FROM user_rewards WHERE user_id=?"
  ).bind(id).first();

  if(!r){
    await e.DB.prepare(
      "INSERT INTO user_rewards(user_id,coins,xp,updated_at) VALUES(?,?,?,?)"
    ).bind(id,0,0,now()).run();
    return {user_id:id,coins:0,xp:0};
  }
  return r;
}

async function premium(e,id){
  return e.DB.prepare(
    `SELECT user_id,membership_expiry FROM premium_users
     WHERE user_id=? AND (status='PREMIUM' OR status='ACTIVE')
     AND (membership_expiry IS NULL OR membership_expiry>?) LIMIT 1`
  ).bind(id,now()).first();
}

async function lesson(e,id){
  return e.DB.prepare(
    "SELECT id,title,access_type FROM lessons WHERE id=? AND active=1 LIMIT 1"
  ).bind(id).first();
}

async function allowed(e,id,l){
  return String(l.access_type||"").toUpperCase()!=="PREMIUM" ||
    !!await premium(e,id);
}

async function me(req,e,o){
  const u=await user(req,e);

  if(!u)return json({
    success:true,logged_in:false,user:null,premium:false,
    membership_expiry:null,rewards:{coins:0,xp:0},coins:0,xp:0
  },200,o);

  const p=await premium(e,u.id);
  const r=await rewards(e,u.id);
  const expiry=(p&&p.membership_expiry)||u.membership_expiry||null;

  return json({
    success:true,logged_in:true,
    user:{
      id:u.id,name:u.name,email:u.email,picture:u.picture||"",
      membership_status:u.membership_status,
      membership_expiry:expiry,is_premium:!!p
    },
    premium:!!p,
    membership_expiry:expiry,
    rewards:{coins:+r.coins||0,xp:+r.xp||0},
    coins:+r.coins||0,xp:+r.xp||0
  },200,o);
}

async function titles(e,o){
  const r=await e.DB.prepare(
    "SELECT id,title,access_type FROM lessons WHERE active=1 ORDER BY id"
  ).all();

  const list=(r.results||[]).map(x=>({
    id:x.id,title:x.title,access_type:x.access_type,
    premium:String(x.access_type||"").toUpperCase()==="PREMIUM",
    is_premium:String(x.access_type||"").toUpperCase()==="PREMIUM"
  }));

  return json({success:true,titles:list,lessons:list},200,o);
}

async function questions(req,e,o){
  const u=await user(req,e);
  if(!u)return json({success:false,error:"LOGIN_REQUIRED"},401,o);

  const id=Number(new URL(req.url).searchParams.get("lesson_id"));
  if(!id)return json({success:false,error:"LESSON_REQUIRED"},400,o);

  const l=await lesson(e,id);
  if(!l)return json({success:false,error:"LESSON_NOT_FOUND"},404,o);

  if(!await allowed(e,u.id,l))
    return json({success:false,premium_required:true,error:"PREMIUM_REQUIRED"},403,o);

  const r=await e.DB.prepare(
    `SELECT id,lesson_id,question,option_a,option_b,option_c,option_d
     FROM questions WHERE lesson_id=? AND active=1 ORDER BY id`
  ).bind(id).all();

  const qs=(r.results||[]).map(q=>({
    id:q.id,lesson_id:q.lesson_id,question:q.question,
    option_a:q.option_a,option_b:q.option_b,
    option_c:q.option_c,option_d:q.option_d,
    options:[q.option_a,q.option_b,q.option_c,q.option_d]
  }));

  return json({
    success:true,
    lesson:{id:l.id,title:l.title,access_type:l.access_type},
    lesson_id:id,questions:qs
  },200,o);
}

async function start(req,e,o){
  const u=await user(req,e);
  if(!u)return json({success:false,error:"LOGIN_REQUIRED"},401,o);

  let b;
  try{b=await req.json()}catch{return json({success:false,error:"INVALID_JSON"},400,o)}

  const id=Number(b.lesson_id);
  if(!id)return json({success:false,error:"LESSON_REQUIRED"},400,o);

  const l=await lesson(e,id);
  if(!l)return json({success:false,error:"LESSON_NOT_FOUND"},404,o);

  if(!await allowed(e,u.id,l))
    return json({success:false,premium_required:true,error:"PREMIUM_REQUIRED"},403,o);

  const since=future(-DAYS);
  const c=await e.DB.prepare(
    "SELECT COUNT(*) total FROM quiz_results WHERE user_id=? AND completed_at>=?"
  ).bind(u.id,since).first();

  if(Number(c?.total||0)>=MAX)
    return json({
      success:false,max_attempts:true,
      error:"Maximum 3 quiz submissions reached."
    },403,o);

  const id2=crypto.randomUUID();

  await e.DB.prepare(
    "INSERT INTO quiz_attempts(id,user_id,lesson_id,created_at) VALUES(?,?,?,?)"
  ).bind(id2,u.id,id,now()).run();

  return json({
    success:true,attempt_id:id2,
    lesson:{id:l.id,title:l.title,access_type:l.access_type}
  },200,o);
}

async function check(req,e,o){
  const u=await user(req,e);
  if(!u)return json({success:false,error:"LOGIN_REQUIRED"},401,o);

  let b;
  try{b=await req.json()}catch{return json({success:false,error:"INVALID_JSON"},400,o)}

  const aid=clean(b.attempt_id);
  const qid=Number(b.question_id);
  const a=answer(b.answer);

  if(!aid||!qid||!a)
    return json({success:false,error:"INVALID_REQUEST"},400,o);

  const at=await e.DB.prepare(
    "SELECT id,user_id,lesson_id,completed_at FROM quiz_attempts WHERE id=? AND user_id=?"
  ).bind(aid,u.id).first();

  if(!at)return json({success:false,error:"ATTEMPT_NOT_FOUND"},404,o);
  if(at.completed_at)return json({success:false,error:"ATTEMPT_COMPLETED"},400,o);

  const q=await e.DB.prepare(
    `SELECT id,option_a,option_b,option_c,option_d,correct_answer
     FROM questions WHERE id=? AND lesson_id=? AND active=1`
  ).bind(qid,at.lesson_id).first();

  if(!q)return json({success:false,error:"QUESTION_NOT_FOUND"},404,o);

  const n=numAnswer(a);
  const correct=n===Number(q.correct_answer);
  const ca=letter(q.correct_answer);

  const text=q["option_"+ca];

  return json({
    success:true,correct,
    selected_answer:a,
    correct_answer:ca,
    correct_text:correct?"":text,
    reward_coins:correct?COINS:0,
    reward_xp:correct?XP:0,
    reward:{coins:correct?COINS:0,xp:correct?XP:0}
  },200,o);
}

async function submit(req,e,o){
  const u=await user(req,e);
  if(!u)return json({success:false,error:"LOGIN_REQUIRED"},401,o);

  let b;
  try{b=await req.json()}catch{return json({success:false,error:"INVALID_JSON"},400,o)}

  const aid=clean(b.attempt_id);
  const lid=Number(b.lesson_id);
  const answers=Array.isArray(b.answers)?b.answers:[];

  if(!aid||!lid||!answers.length)
    return json({success:false,error:"INVALID_REQUEST"},400,o);

  const at=await e.DB.prepare(
    `SELECT id,user_id,lesson_id,completed_at
     FROM quiz_attempts WHERE id=? AND user_id=? AND lesson_id=?`
  ).bind(aid,u.id,lid).first();

  if(!at)return json({success:false,error:"ATTEMPT_NOT_FOUND"},404,o);
  if(at.completed_at)
    return json({success:false,error:"ATTEMPT_ALREADY_COMPLETED"},400,o);

  const qr=await e.DB.prepare(
    "SELECT id,correct_answer FROM questions WHERE lesson_id=? AND active=1"
  ).bind(lid).all();

  const key={};
  (qr.results||[]).forEach(q=>key[q.id]=Number(q.correct_answer));

  let correct=0,total=0;
  const seen={};

  answers.forEach(x=>{
    const id=Number(x.question_id);
    const a=numAnswer(x.answer);

    if(!id||!a||seen[id]||key[id]===undefined)return;

    seen[id]=1;
    total++;

    if(a===key[id])correct++;
  });

  if(!total)
    return json({success:false,error:"NO_VALID_ANSWERS"},400,o);

  const pct=Math.round(correct/total*100);
  const earnedCoins=correct*COINS;
  const earnedXp=correct*XP;
  const done=now();

  await e.DB.prepare(
    `INSERT INTO quiz_results
     (user_id,lesson_id,score,total,percentage,completed_at)
     VALUES(?,?,?,?,?,?)`
  ).bind(u.id,lid,correct,total,pct,done).run();

  await e.DB.prepare(
    "UPDATE quiz_attempts SET completed_at=? WHERE id=? AND user_id=?"
  ).bind(done,aid,u.id).run();

  await rewards(e,u.id);

  await e.DB.prepare(
    "UPDATE user_rewards SET coins=coins+?,xp=xp+?,updated_at=? WHERE user_id=?"
  ).bind(earnedCoins,earnedXp,done,u.id).run();

  const r=await rewards(e,u.id);

  return json({
    success:true,
    score:correct,total,percentage:pct,
    coins:earnedCoins,xp:earnedXp,
    reward_coins:earnedCoins,reward_xp:earnedXp,
    total_coins:+r.coins||0,total_xp:+r.xp||0,
    result:{correct,total,percentage:pct},
    reward:{coins:earnedCoins,xp:earnedXp},
    balance:{coins:+r.coins||0,xp:+r.xp||0}
  },200,o);
}

async function referral(req,e,o){
  let code=cookie(req,REFERRAL);
  if(!/^CLK[A-Z0-9]+$/i.test(clean(code)))code=null;

  return json({
    success:true,
    referral_code:code?clean(code).toUpperCase():null
  },200,o);
}

async function ref(req,e,o){
  const code=clean(
    new URL(req.url).searchParams.get("ref")
  ).toUpperCase();

  if(!/^CLK[A-Z0-9]+$/.test(code))
    return json({success:false,error:"INVALID_REFERRAL"},400,o);

  try{
    await fetch(AFF+"/api/click",{
      method:"POST",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify({referral_code:code})
    });
  }catch(e){}

  return json(
    {success:true,referral_code:code},
    200,o,
    {"Set-Cookie":setCookie(REFERRAL,code,2592000)}
  );
}

async function google(req,e){
  const state=crypto.randomUUID();

  await e.DB.prepare(
    "INSERT INTO oauth_states(state,expires_at) VALUES(?,?)"
  ).bind(state,future(.007)).run();

  const u=new URL(req.url);
  const ref=clean(u.searchParams.get("ref")).toUpperCase();

  const p=new URLSearchParams({
    client_id:e.GOOGLE_CLIENT_ID,
    redirect_uri:"https://eng-a.createlk.workers.dev/auth/callback",
    response_type:"code",
    scope:"openid email profile",
    state
  });

  if(/^CLK[A-Z0-9]+$/.test(ref))p.set("ref",ref);

  return Response.redirect(
    "https://accounts.google.com/o/oauth2/v2/auth?"+p,
    302
  );
}

async function callback(req,e){
  const u=new URL(req.url);
  const code=u.searchParams.get("code");
  const state=u.searchParams.get("state");

  if(!code||!state)
    return Response.redirect(SITE+"/Eng/?error=login",302);

  const s=await e.DB.prepare(
    "SELECT state FROM oauth_states WHERE state=? AND expires_at>? LIMIT 1"
  ).bind(state,now()).first();

  if(!s)
    return Response.redirect(SITE+"/Eng/?error=state",302);

  await e.DB.prepare(
    "DELETE FROM oauth_states WHERE state=?"
  ).bind(state).run();

  const tr=await fetch("https://oauth2.googleapis.com/token",{
    method:"POST",
    headers:{"Content-Type":"application/x-www-form-urlencoded"},
    body:new URLSearchParams({
      code,
      client_id:e.GOOGLE_CLIENT_ID,
      client_secret:e.GOOGLE_CLIENT_SECRET,
      redirect_uri:"https://eng-a.createlk.workers.dev/auth/callback",
      grant_type:"authorization_code"
    })
  });

  if(!tr.ok)
    return Response.redirect(SITE+"/Eng/?error=token",302);

  const tk=await tr.json();

  if(!tk.access_token)
    return Response.redirect(SITE+"/Eng/?error=token",302);

  const ir=await fetch(
    "https://openidconnect.googleapis.com/v1/userinfo",
    {headers:{Authorization:"Bearer "+tk.access_token}}
  );

  if(!ir.ok)
    return Response.redirect(SITE+"/Eng/?error=user",302);

  const g=await ir.json();
  const gid=clean(g.sub);
  const email=clean(g.email).toLowerCase();
  const name=clean(g.name)||"CreateLK User";
  const picture=clean(g.picture);

  if(!gid||!email)
    return Response.redirect(SITE+"/Eng/?error=account",302);

  let usr=await e.DB.prepare(
    "SELECT id FROM users WHERE google_id=? LIMIT 1"
  ).bind(gid).first();

  if(usr){
    await e.DB.prepare(
      `UPDATE users SET name=?,email=?,picture=?,
       auth_provider='google',last_active_at=? WHERE id=?`
    ).bind(name,email,picture,Date.now(),usr.id).run();
  }else{
    usr=await e.DB.prepare(
      "SELECT id FROM users WHERE lower(email)=? LIMIT 1"
    ).bind(email).first();

    if(usr){
      await e.DB.prepare(
        `UPDATE users SET google_id=?,name=?,picture=?,
         auth_provider='google',last_active_at=? WHERE id=?`
      ).bind(gid,name,picture,Date.now(),usr.id).run();
    }else{
      await e.DB.prepare(
        `INSERT INTO users
         (google_id,name,email,membership_status,auth_provider,last_active_at,picture)
         VALUES(?,?,?,'FREE','google',?,?)`
      ).bind(gid,name,email,Date.now(),picture).run();

      usr=await e.DB.prepare(
        "SELECT id FROM users WHERE google_id=? LIMIT 1"
      ).bind(gid).first();
    }
  }

  if(!usr?.id)
    return Response.redirect(SITE+"/Eng/?error=account",302);

  await rewards(e,usr.id);

  const token=crypto.randomUUID();

  await e.DB.prepare(
    `INSERT INTO sessions(token_hash,user_id,expires_at,created_at)
     VALUES(?,?,?,?)`
  ).bind(token,usr.id,future(30),now()).run();

  const rc=clean(u.searchParams.get("ref")).toUpperCase();

  const cookies=[
    setCookie(SESSION,token,2592000)
  ];

  if(/^CLK[A-Z0-9]+$/.test(rc))
    cookies.push(setCookie(REFERRAL,rc,2592000));

  return new Response(null,{
    status:302,
    headers:{
      Location:SITE+"/Eng/",
      "Set-Cookie":cookies.join(", ")
    }
  });
}

async function logout(req,e){
  const t=cookie(req,SESSION);

  if(t){
    try{
      await e.DB.prepare(
        "DELETE FROM sessions WHERE token_hash=?"
      ).bind(t).run();
    }catch(e){}
  }

  return new Response(null,{
    status:302,
    headers:{
      Location:SITE+"/Eng/",
      "Set-Cookie":delCookie(SESSION)
    }
  });
}

export default{
  async fetch(req,e){
    const u=new URL(req.url);
    const p=u.pathname;
    const o=req.headers.get("Origin")||SITE;

    if(req.method==="OPTIONS")
      return new Response(null,{status:204,headers:cors(o)});

    try{
      if(p==="/api/health")
        return json({
          success:true,
          worker:"eng-a",
          status:"OK"
        },200,o);

      if(p==="/auth/google"&&req.method==="GET")
        return google(req,e);

      if(p==="/auth/callback"&&req.method==="GET")
        return callback(req,e);

      if(p==="/auth/logout"&&req.method==="GET")
        return logout(req,e);

      if(p==="/api/me"&&req.method==="GET")
        return me(req,e,o);

      if(p==="/api/titles"&&req.method==="GET")
        return titles(e,o);

      if(p==="/api/questions"&&req.method==="GET")
        return questions(req,e,o);

      if(p==="/api/quiz/start"&&req.method==="POST")
        return start(req,e,o);

      if(p==="/api/quiz/check"&&req.method==="POST")
        return check(req,e,o);

      if(p==="/api/quiz/submit"&&req.method==="POST")
        return submit(req,e,o);

      if(p==="/api/ref"&&req.method==="GET")
        return ref(req,e,o);

      if(p==="/api/referral"&&req.method==="GET")
        return referral(req,e,o);

      return json({
        success:false,
        error:"NOT_FOUND"
      },404,o);

    }catch(err){
      console.error("ENG-A ERROR",err);

      return json({
        success:false,
        error:"SERVER_ERROR",
        message:err?.message||"Unknown error"
      },500,o);
    }
  }
};