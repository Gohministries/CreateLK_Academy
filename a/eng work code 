const SITE="https://createlk.com";
const AFF="https://affiliate-a.createlk.workers.dev";
const SESSION="english_session";
const REFERRAL="english_referral";
const COINS=5,XP=10,MAX=3,DAYS=30,SESSION_DAYS=30;

function cors(o){
  const a=["https://createlk.com","https://www.createlk.com"];
  return {
    "Access-Control-Allow-Origin":a.includes(o)?o:SITE,
    "Access-Control-Allow-Credentials":"true",
    "Access-Control-Allow-Headers":"Content-Type, Authorization",
    "Access-Control-Allow-Methods":"GET, POST, OPTIONS"
  };
}

function out(d,s=200,o=SITE,x={}){
  return new Response(JSON.stringify(d),{
    status:s,
    headers:{"Content-Type":"application/json",...cors(o),...x}
  });
}

function red(u,x={}){
  return new Response(null,{status:302,headers:{Location:u,...x}});
}

function clean(v){return String(v??"").trim()}
function validRef(v){return /^CLK[A-Z0-9]+$/i.test(clean(v))}

function cookie(req,n){
  const h=req.headers.get("Cookie")||"";
  for(const p of h.split(";")){
    const [k,...v]=p.trim().split("=");
    if(k===n)return decodeURIComponent(v.join("="));
  }
  return null;
}

function setCookie(n,v,max){
  return `${n}=${encodeURIComponent(v)}; Max-Age=${max}; Path=/; Secure; HttpOnly; SameSite=Lax`;
}

function delCookie(n){
  return `${n}=; Max-Age=0; Path=/; Secure; HttpOnly; SameSite=Lax`;
}

async function getUser(req,e){
  const t=cookie(req,SESSION);
  if(!t)return null;

  return await e.DB.prepare(`
    SELECT u.id,u.google_id,u.name,u.email,u.membership_status,
           u.membership_expiry,u.picture,s.token,s.expires_at
    FROM sessions s JOIN users u ON u.id=s.user_id
    WHERE s.token=? AND s.expires_at>? LIMIT 1
  `).bind(t,Date.now()).first();
}

async function rewards(e,id){
  let r=await e.DB.prepare(`
    SELECT user_id,coins,xp FROM user_rewards
    WHERE user_id=? LIMIT 1
  `).bind(id).first();

  if(!r){
    await e.DB.prepare(`
      INSERT INTO user_rewards(user_id,coins,xp)
      VALUES(?,0,0)
    `).bind(id).run();
    r={user_id:id,coins:0,xp:0};
  }
  return r;
}

async function premium(e,id){
  return await e.DB.prepare(`
    SELECT user_id,email,name,status,membership_expiry
    FROM premium_users
    WHERE user_id=?
      AND (status='ACTIVE' OR status='PREMIUM')
      AND (membership_expiry IS NULL OR membership_expiry>datetime('now'))
    LIMIT 1
  `).bind(id).first();
}

async function me(req,e,o){
  const u=await getUser(req,e);

  if(!u)return out({
    success:true,
    logged_in:false,
    user:null,
    premium:null,
    rewards:{coins:0,xp:0}
  },200,o);

  const p=await premium(e,u.id);
  const r=await rewards(e,u.id);

  return out({
    success:true,
    logged_in:true,
    user:{
      id:u.id,
      name:u.name,
      email:u.email,
      picture:u.picture||"",
      membership_status:u.membership_status,
      membership_expiry:u.membership_expiry
    },
    premium:p?{
      status:p.status,
      membership_expiry:p.membership_expiry
    }:null,
    rewards:{
      coins:Number(r.coins||0),
      xp:Number(r.xp||0)
    }
  },200,o);
}

async function titles(e,o){
  const r=await e.DB.prepare(`
    SELECT id,title,description,order_no,status
    FROM lessons
    WHERE status='ACTIVE'
    ORDER BY order_no ASC,id ASC
  `).all();

  return out({
    success:true,
    lessons:r.results||[]
  },200,o);
}

async function questions(req,e,o){
  const u=await getUser(req,e);

  if(!u)return out({
    success:false,error:"LOGIN_REQUIRED"
  },401,o);

  const url=new URL(req.url);
  const lid=Number(
    url.searchParams.get("lesson_id")||
    url.searchParams.get("lesson")||0
  );

  if(!lid)return out({
    success:false,error:"LESSON_REQUIRED"
  },400,o);

  const p=await premium(e,u.id);

  if(!p&&lid!==1)return out({
    success:false,error:"PREMIUM_REQUIRED"
  },403,o);

  const r=await e.DB.prepare(`
    SELECT id,lesson_id,question,option_a,option_b,option_c,option_d
    FROM questions
    WHERE lesson_id=? AND status='ACTIVE'
    ORDER BY id ASC
  `).bind(lid).all();

  return out({
    success:true,
    lesson_id:lid,
    questions:(r.results||[]).map(q=>({
      id:q.id,
      lesson_id:q.lesson_id,
      question:q.question,
      options:[
        q.option_a,
        q.option_b,
        q.option_c,
        q.option_d
      ]
    }))
  },200,o);
}

async function quizStart(req,e,o){
  const u=await getUser(req,e);

  if(!u)return out({
    success:false,error:"LOGIN_REQUIRED"
  },401,o);

  const b=await req.json().catch(()=>({}));
  const lid=Number(b.lesson_id||b.lessonId||0);

  if(!lid)return out({
    success:false,error:"LESSON_REQUIRED"
  },400,o);

  const p=await premium(e,u.id);

  if(!p&&lid!==1)return out({
    success:false,error:"PREMIUM_REQUIRED"
  },403,o);

  const since=Date.now()-DAYS*86400000;

  const c=await e.DB.prepare(`
    SELECT COUNT(*) total
    FROM quiz_results
    WHERE user_id=? AND created_at>=?
  `).bind(u.id,since).first();

  if(Number(c?.total||0)>=MAX)return out({
    success:false,
    error:"QUIZ_LIMIT_REACHED",
    max:MAX
  },403,o);

  const r=await e.DB.prepare(`
    INSERT INTO quiz_attempts(user_id,lesson_id,started_at,status)
    VALUES(?,?,?,'STARTED')
    RETURNING id
  `).bind(u.id,lid,Date.now()).first();

  return out({
    success:true,
    attempt_id:r?.id
  },200,o);
}

async function quizCheck(req,e,o){
  const u=await getUser(req,e);

  if(!u)return out({
    success:false,error:"LOGIN_REQUIRED"
  },401,o);

  const b=await req.json().catch(()=>({}));
  const qid=Number(b.question_id||b.questionId||0);
  const answer=clean(b.answer||b.selected_answer);

  if(!qid||!answer)return out({
    success:false,error:"INVALID_REQUEST"
  },400,o);

  const q=await e.DB.prepare(`
    SELECT answer FROM questions
    WHERE id=? AND status='ACTIVE' LIMIT 1
  `).bind(qid).first();

  if(!q)return out({
    success:false,error:"QUESTION_NOT_FOUND"
  },404,o);

  const correct=
    answer.toUpperCase()===clean(q.answer).toUpperCase();

  return out({
    success:true,
    correct,
    reward:correct
      ?{coins:COINS,xp:XP}
      :{coins:0,xp:0}
  },200,o);
}

async function quizSubmit(req,e,o){
  const u=await getUser(req,e);

  if(!u)return out({
    success:false,error:"LOGIN_REQUIRED"
  },401,o);

  const b=await req.json().catch(()=>({}));
  const aid=Number(b.attempt_id||b.attemptId||0);
  const lid=Number(b.lesson_id||b.lessonId||0);
  const answers=Array.isArray(b.answers)?b.answers:[];

  if(!aid||!lid||!answers.length)return out({
    success:false,error:"INVALID_REQUEST"
  },400,o);

  const attempt=await e.DB.prepare(`
    SELECT id,user_id,status
    FROM quiz_attempts
    WHERE id=? AND user_id=? LIMIT 1
  `).bind(aid,u.id).first();

  if(!attempt)return out({
    success:false,error:"ATTEMPT_NOT_FOUND"
  },404,o);

  if(attempt.status==="COMPLETED")return out({
    success:false,error:"ATTEMPT_ALREADY_COMPLETED"
  },400,o);

  let correct=0;

  for(const a of answers){
    const qid=Number(a.question_id||a.questionId||0);
    const ans=clean(a.answer||a.selected_answer);
    if(!qid||!ans)continue;

    const q=await e.DB.prepare(`
      SELECT answer FROM questions
      WHERE id=? AND lesson_id=? AND status='ACTIVE'
      LIMIT 1
    `).bind(qid,lid).first();

    if(q&&ans.toUpperCase()===clean(q.answer).toUpperCase())
      correct++;
  }

  const total=answers.length;
  const coins=correct*COINS;
  const xp=correct*XP;

  await e.DB.prepare(`
    INSERT INTO quiz_results(
      user_id,lesson_id,attempt_id,score,total,
      coins_earned,xp_earned,created_at
    ) VALUES(?,?,?,?,?,?,?,?)
  `).bind(
    u.id,lid,aid,correct,total,coins,xp,Date.now()
  ).run();

  await e.DB.prepare(`
    UPDATE quiz_attempts
    SET status='COMPLETED',completed_at=?
    WHERE id=?
  `).bind(Date.now(),aid).run();

  await rewards(e,u.id);

  await e.DB.prepare(`
    UPDATE user_rewards
    SET coins=coins+?,xp=xp+?
    WHERE user_id=?
  `).bind(coins,xp,u.id).run();

  const r=await rewards(e,u.id);

  return out({
    success:true,
    result:{
      correct,
      total,
      percentage:total?Math.round(correct/total*100):0
    },
    reward:{coins,xp},
    balance:{
      coins:Number(r.coins||0),
      xp:Number(r.xp||0)
    }
  },200,o);
}

async function referral(req,e,o){
  const code=cookie(req,REFERRAL);

  return out({
    success:true,
    referral_code:validRef(code)?code.toUpperCase():null
  },200,o);
}

async function captureReferral(req,e,o){
  const code=clean(
    new URL(req.url).searchParams.get("ref")
  ).toUpperCase();

  if(!validRef(code))return out({
    success:false,error:"INVALID_REFERRAL"
  },400,o);

  try{
    await fetch(`${AFF}/api/click`,{
      method:"POST",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify({referral_code:code})
    });
  }catch(_){}

  return out({
    success:true,
    referral_code:code
  },200,o,{
    "Set-Cookie":setCookie(
      REFERRAL,code,30*86400
    )
  });
}

async function googleLogin(e){
  const state=crypto.randomUUID();

  await e.DB.prepare(`
    INSERT INTO oauth_states(state,expires_at)
    VALUES(?,?)
  `).bind(
    state,
    Date.now()+600000
  ).run();

  const p=new URLSearchParams({
    client_id:e.GOOGLE_CLIENT_ID,
    redirect_uri:"https://eng-a.createlk.workers.dev/auth/callback",
    response_type:"code",
    scope:"openid email profile",
    access_type:"online",
    state
  });

  return red(
    `https://accounts.google.com/o/oauth2/v2/auth?${p}`
  );
}

async function googleCallback(req,e){
  const u=new URL(req.url);
  const code=u.searchParams.get("code");
  const state=u.searchParams.get("state");

  if(!code||!state)return red(
    `${SITE}/Eng/?error=google_login`
  );

  const s=await e.DB.prepare(`
    SELECT state FROM oauth_states
    WHERE state=? AND expires_at>? LIMIT 1
  `).bind(state,Date.now()).first();

  if(!s)return red(
    `${SITE}/Eng/?error=invalid_state`
  );

  await e.DB.prepare(`
    DELETE FROM oauth_states WHERE state=?
  `).bind(state).run();

  const tr=await fetch(
    "https://oauth2.googleapis.com/token",
    {
      method:"POST",
      headers:{
        "Content-Type":
          "application/x-www-form-urlencoded"
      },
      body:new URLSearchParams({
        code,
        client_id:e.GOOGLE_CLIENT_ID,
        client_secret:e.GOOGLE_CLIENT_SECRET,
        redirect_uri:
          "https://eng-a.createlk.workers.dev/auth/callback",
        grant_type:"authorization_code"
      })
    }
  );

  if(!tr.ok)return red(
    `${SITE}/Eng/?error=google_token`
  );

  const tokens=await tr.json();

  const ir=await fetch(
    "https://openidconnect.googleapis.com/v1/userinfo",
    {
      headers:{
        Authorization:`Bearer ${tokens.access_token}`
      }
    }
  );

  if(!ir.ok)return red(
    `${SITE}/Eng/?error=google_user`
  );

  const info=await ir.json();

  const gid=clean(info.sub);
  const name=clean(info.name)||"CreateLK User";
  const email=clean(info.email).toLowerCase();
  const picture=clean(info.picture);

  if(!gid||!email)return red(
    `${SITE}/Eng/?error=google_account`
  );

  let u=await e.DB.prepare(`
    SELECT id FROM users
    WHERE google_id=? LIMIT 1
  `).bind(gid).first();

  if(u){
    await e.DB.prepare(`
      UPDATE users
      SET name=?,email=?,picture=?,
          auth_provider='google',last_active_at=?
      WHERE id=?
    `).bind(
      name,email,picture,Date.now(),u.id
    ).run();
  }else{
    u=await e.DB.prepare(`
      SELECT id FROM users
      WHERE lower(email)=? LIMIT 1
    `).bind(email).first();

    if(u){
      await e.DB.prepare(`
        UPDATE users
        SET google_id=?,name=?,email=?,picture=?,
            auth_provider='google',last_active_at=?
        WHERE id=?
      `).bind(
        gid,name,email,picture,Date.now(),u.id
      ).run();
    }else{
      u=await e.DB.prepare(`
        INSERT INTO users(
          google_id,name,email,membership_status,
          created_at,auth_provider,last_active_at,picture
        )
        VALUES(?,?,?,'FREE',CURRENT_TIMESTAMP,'google',?,?)
        RETURNING id
      `).bind(
        gid,name,email,Date.now(),picture
      ).first();
    }
  }

  await rewards(e,u.id);

  const token=
    crypto.randomUUID()+
    crypto.randomUUID().replace(/-/g,"");

  await e.DB.prepare(`
    INSERT INTO sessions(
      token,user_id,expires_at,created_at
    ) VALUES(?,?,?,?)
  `).bind(
    token,
    u.id,
    Date.now()+SESSION_DAYS*86400000,
    Date.now()
  ).run();

  return red(
    `${SITE}/Eng/`,
    {
      "Set-Cookie":setCookie(
        SESSION,
        token,
        SESSION_DAYS*86400
      )
    }
  );
}

export default{
  async fetch(req,e){
    const url=new URL(req.url);
    const path=url.pathname;
    const origin=req.headers.get("Origin")||SITE;

    if(req.method==="OPTIONS")
      return new Response(null,{
        status:204,
        headers:cors(origin)
      });

    try{

      if(path==="/api/health")
        return out({
          success:true,
          worker:"eng-a",
          status:"OK"
        },200,origin);

      if(path==="/auth/google"&&req.method==="GET")
        return googleLogin(e);

      if(path==="/auth/callback"&&req.method==="GET")
        return googleCallback(req,e);

      if(path==="/auth/logout"&&req.method==="GET")
        return red(`${SITE}/Eng/`,{
          "Set-Cookie":delCookie(SESSION)
        });

      if(path==="/api/me"&&req.method==="GET")
        return me(req,e,origin);

      if(
        (path==="/api/titles"||path==="/api/lessons")&&
        req.method==="GET"
      )
        return titles(e,origin);

      if(path==="/api/questions"&&req.method==="GET")
        return questions(req,e,origin);

      if(
        (path==="/api/quiz/start"||path==="/api/start")&&
        req.method==="POST"
      )
        return quizStart(req,e,origin);

      if(
        (path==="/api/quiz/check"||path==="/api/check")&&
        req.method==="POST"
      )
        return quizCheck(req,e,origin);

      if(
        (path==="/api/quiz/submit"||path==="/api/submit")&&
        req.method==="POST"
      )
        return quizSubmit(req,e,origin);

      if(path==="/api/ref"&&req.method==="GET")
        return captureReferral(req,e,origin);

      if(path==="/api/referral"&&req.method==="GET")
        return referral(req,e,origin);

      return out({
        success:false,
        error:"NOT_FOUND"
      },404,origin);

    }catch(err){
      console.error(err);

      return out({
        success:false,
        error:"SERVER_ERROR",
        message:err?.message||"Unknown error"
      },500,origin);
    }
  }
};