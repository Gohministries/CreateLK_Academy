const SITE="https://createlk.com",PAY="https://pay-a.createlk.workers.dev",AFF="https://affiliate-a.createlk.workers.dev";
const SESSION="english_session",COINS=5,XP=10,MAX=3,DAYS=30,SESSION_DAYS=30;

const origin=r=>{
  const o=r.headers.get("Origin")||"";
  return o==="https://createlk.com"||o==="https://www.createlk.com"?o:SITE;
};

const H=r=>({
  "Content-Type":"application/json",
  "Access-Control-Allow-Origin":origin(r),
  "Access-Control-Allow-Credentials":"true",
  "Access-Control-Allow-Methods":"GET,POST,OPTIONS",
  "Access-Control-Allow-Headers":"Content-Type",
  "Vary":"Origin"
});

const json=(o,s=200,r)=>new Response(JSON.stringify(o),{status:s,headers:H(r)});
const err=(x,s=400,e={},r)=>json({success:false,error:x,...e},s,r);
const body=async r=>{try{return await r.json()}catch{return{}}};
const cookie=(r,n)=>r.headers.get("Cookie")?.match(new RegExp(`${n}=([^;]+)`))?.[1]||"";
const token=r=>cookie(r,SESSION);
const now=()=>Date.now();

async function user(r,e){
  const s=token(r);
  if(!s)return null;

  const x=await e.DB.prepare(
    "SELECT u.* FROM users u JOIN sessions s ON s.user_id=u.id WHERE s.token_hash=? AND s.expires_at>?"
  ).bind(s,new Date().toISOString()).first();

  return x||null;
}

async function rewards(id,e){
  let x=await e.DB.prepare(
    "SELECT coins,xp FROM user_rewards WHERE user_id=?"
  ).bind(id).first();

  if(!x){
    await e.DB.prepare(
      "INSERT INTO user_rewards(user_id,coins,xp,updated_at) VALUES(?,?,?,?)"
    ).bind(id,0,0,new Date().toISOString()).run();

    x={coins:0,xp:0};
  }

  return x;
}

async function google(r,e){
  const u=new URL(r.url);
  const ref=u.searchParams.get("ref")||"";
  const state=btoa(JSON.stringify({t:now(),ref}));

  await e.DB.prepare(
    "INSERT INTO oauth_states(state,expires_at) VALUES(?,?)"
  ).bind(state,now()+600000).run();

  const q=new URLSearchParams({
    client_id:e.GOOGLE_CLIENT_ID,
    redirect_uri:"https://eng-a.createlk.workers.dev/auth/callback",
    response_type:"code",
    scope:"openid email profile",
    state
  });

  return Response.redirect(
    "https://accounts.google.com/o/oauth2/v2/auth?"+q,
    302
  );
}

async function callback(r,e){
  const u=new URL(r.url);
  const code=u.searchParams.get("code");
  const state=u.searchParams.get("state");

  if(!code||!state)return err("Invalid login",400,{},r);

  const st=await e.DB.prepare(
    "SELECT * FROM oauth_states WHERE state=? AND expires_at>?"
  ).bind(state,now()).first();

  if(!st)return err("Invalid or expired state",400,{},r);

  await e.DB.prepare(
    "DELETE FROM oauth_states WHERE state=?"
  ).bind(state).run();

  const t=await fetch("https://oauth2.googleapis.com/token",{
    method:"POST",
    headers:{"Content-Type":"application/x-www-form-urlencoded"},
    body:new URLSearchParams({
      code,
      client_id:e.GOOGLE_CLIENT_ID,
      client_secret:e.GOOGLE_CLIENT_SECRET,
      redirect_uri:"https://eng-a.createlk.workers.dev/auth/callback",
      grant_type:"authorization_code"
    })
  });

  const tk=await t.json();

  if(!tk.access_token)
    return err("Google login failed",400,{},r);

  const g=await fetch("https://www.googleapis.com/oauth2/v3/userinfo",{
    headers:{Authorization:`Bearer ${tk.access_token}`}
  });

  const p=await g.json();

  if(!p.email)return err("Email unavailable",400,{},r);

  let uo=await e.DB.prepare(
    "SELECT * FROM users WHERE email=?"
  ).bind(p.email.toLowerCase()).first();

  if(!uo){
    uo=await e.DB.prepare(
      "INSERT INTO users(email,name,created_at,membership_status) VALUES(?,?,?,?) RETURNING *"
    ).bind(
      p.email.toLowerCase(),
      p.name||p.email,
      new Date().toISOString(),
      "FREE"
    ).first();
  }else{
    await e.DB.prepare(
      "UPDATE users SET name=?,picture=?,google_id=?,auth_provider='google',last_active_at=? WHERE id=?"
    ).bind(
      p.name||uo.name,
      p.picture||null,
      p.sub||null,
      now(),
      uo.id
    ).run();
  }

  const s=crypto.randomUUID();
  const exp=now()+SESSION_DAYS*86400000;

  await e.DB.prepare(
    "INSERT INTO sessions(user_id,token_hash,expires_at,created_at) VALUES(?,?,?,?)"
  ).bind(
    uo.id,
    s,
    new Date(exp).toISOString(),
    new Date().toISOString()
  ).run();

  let ref="";

  try{
    ref=JSON.parse(atob(state)).ref||"";
  }catch{}

  if(ref)await createReferral(ref,uo.id,e);

  return new Response(null,{
    status:302,
    headers:{
      Location:`${SITE}/a/`,
      "Set-Cookie":`${SESSION}=${s}; Path=/; HttpOnly; Secure; SameSite=None; Max-Age=${SESSION_DAYS*86400}`
    }
  });
}

async function me(r,e){
  const u=await user(r,e);

  if(!u)
    return json({success:false,user:null,premium:false},200,r);

  const p=await premium(u,e);
  const rw=await rewards(u.id,e);

  return json({
    success:true,
    user:{
      id:u.id,
      name:u.name,
      email:u.email,
      picture:u.picture||null,
      membership_status:p.premium?"PREMIUM":"FREE",
      membership_expiry:p.membership_expiry,
      is_premium:p.premium,
      coins:Number(rw.coins||0),
      xp:Number(rw.xp||0)
    },
    premium:p.premium,
    membership_expiry:p.membership_expiry,
    coins:Number(rw.coins||0),
    xp:Number(rw.xp||0)
  },200,r);
}

async function premium(u,e){
  try{
    const x=await e.PAY.fetch("https://pay/internal/check",{
      method:"POST",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify({email:u.email})
    });

    const d=await x.json();

    return{
      premium:d.premium===true,
      membership_expiry:d.membership_expiry||null
    };
  }catch{
    const p=
      String(u.membership_status||"").toUpperCase()==="PREMIUM"&&
      u.membership_expiry&&
      new Date(u.membership_expiry)>new Date();

    return{
      premium:!!p,
      membership_expiry:u.membership_expiry||null
    };
  }
}

async function titles(r,e){
  const q=await e.DB.prepare(
    "SELECT id,title,access_type FROM lessons WHERE active=1 ORDER BY id"
  ).all();

  return json({
    success:true,
    titles:q.results||[]
  },200,r);
}

async function questions(r,e){
  const id=Number(new URL(r.url).searchParams.get("lesson_id"));

  if(!id)return err("lesson_id required",400,{},r);

  const t=await e.DB.prepare(
    "SELECT * FROM lessons WHERE id=? AND active=1"
  ).bind(id).first();

  if(!t)return err("Lesson not found",404,{},r);

  if(id!==1&&String(t.access_type).toUpperCase()!=="FREE"){
    const u=await user(r,e);

    if(!u)
      return err("Login required",401,{login_required:true},r);

    const p=await premium(u,e);

    if(!p.premium)
      return err("Premium required",403,{premium_required:true},r);
  }

  const q=await e.DB.prepare(
    "SELECT id,lesson_id,question,option_a,option_b,option_c,option_d FROM questions WHERE lesson_id=? AND active=1 ORDER BY id"
  ).bind(id).all();

  return json({
    success:true,
    lesson:{
      id:t.id,
      title:t.title,
      access_type:t.access_type
    },
    questions:q.results||[]
  },200,r);
}

async function startQuiz(r,e){
  const u=await user(r,e);

  if(!u)
    return err("Login required",401,{login_required:true},r);

  const b=await body(r);
  const lesson=Number(b.lesson_id);

  if(!lesson)return err("lesson_id required",400,{},r);

  const t=await e.DB.prepare(
    "SELECT * FROM lessons WHERE id=? AND active=1"
  ).bind(lesson).first();

  if(!t)return err("Lesson not found",404,{},r);

  if(lesson!==1&&String(t.access_type).toUpperCase()!=="FREE"){
    const p=await premium(u,e);

    if(!p.premium)
      return err("Premium required",403,{premium_required:true},r);
  }

  const since=new Date(now()-DAYS*86400000).toISOString();

  const a=await e.DB.prepare(
    "SELECT COUNT(*) n FROM quiz_results WHERE user_id=? AND completed_at>?"
  ).bind(u.id,since).first();

  if(Number(a?.n||0)>=MAX)
    return err(
      "Maximum 3 quiz attempts reached",
      429,
      {limit:MAX,max_attempts:true},
      r
    );

  const id=crypto.randomUUID();

  await e.DB.prepare(
    "INSERT INTO quiz_attempts(id,user_id,lesson_id,created_at) VALUES(?,?,?,?)"
  ).bind(
    id,
    u.id,
    lesson,
    new Date().toISOString()
  ).run();

  return json({
    success:true,
    attempt_id:id,
    lesson_id:lesson
  },200,r);
}

async function check(r,e){
  const u=await user(r,e);

  if(!u)return err("Login required",401,{},r);

  const b=await body(r);

  const q=await e.DB.prepare(
    "SELECT correct_answer FROM questions WHERE id=? AND active=1"
  ).bind(Number(b.question_id)).first();

  if(!q)return err("Question not found",404,{},r);

  const correct=Number(b.answer)===Number(q.correct_answer);

  return json({
    success:true,
    correct,
    reward_coins:correct?COINS:0,
    reward_xp:correct?XP:0,
    reward:{
      coins:correct?COINS:0,
      xp:correct?XP:0
    }
  },200,r);
}

async function submit(r,e){
  const u=await user(r,e);

  if(!u)return err("Login required",401,{},r);

  const b=await body(r);
  const attempt=b.attempt_id;

  if(!attempt)return err("attempt_id required",400,{},r);

  const a=await e.DB.prepare(
    "SELECT * FROM quiz_attempts WHERE id=? AND user_id=?"
  ).bind(attempt,u.id).first();

  if(!a)
    return err("Invalid attempt",400,{},r);

  if(a.completed_at)
    return err("Quiz already submitted",400,{},r);

  const answers=Array.isArray(b.answers)?b.answers:[];
  let score=0;

  for(const x of answers){
    const q=await e.DB.prepare(
      "SELECT correct_answer FROM questions WHERE id=? AND active=1"
    ).bind(Number(x.question_id)).first();

    if(q&&Number(x.answer)===Number(q.correct_answer))
      score++;
  }

  const total=answers.length||0;

  const allq=await e.DB.prepare(
    "SELECT COUNT(*) n FROM questions WHERE lesson_id=? AND active=1"
  ).bind(a.lesson_id).first();

  const questionTotal=Number(allq?.n||total||1);
  const percentage=Math.round(score/questionTotal*100);

  const earnedCoins=score*COINS;
  const earnedXp=score*XP;
  const completedAt=new Date().toISOString();

  await e.DB.prepare(
    "INSERT INTO quiz_results(user_id,lesson_id,score,total,percentage,completed_at) VALUES(?,?,?,?,?,?)"
  ).bind(
    u.id,
    a.lesson_id,
    score,
    questionTotal,
    percentage,
    completedAt
  ).run();

  await e.DB.prepare(
    "UPDATE quiz_attempts SET completed_at=? WHERE id=?"
  ).bind(
    completedAt,
    attempt
  ).run();

  await e.DB.prepare(
    `INSERT INTO user_rewards(user_id,coins,xp,updated_at)
     VALUES(?,?,?,?)
     ON CONFLICT(user_id)
     DO UPDATE SET
       coins=user_rewards.coins+excluded.coins,
       xp=user_rewards.xp+excluded.xp,
       updated_at=excluded.updated_at`
  ).bind(
    u.id,
    earnedCoins,
    earnedXp,
    completedAt
  ).run();

  const rw=await rewards(u.id,e);

  return json({
    success:true,
    score,
    total:questionTotal,
    percentage,
    coins:earnedCoins,
    xp:earnedXp,
    reward_coins:earnedCoins,
    reward_xp:earnedXp,
    total_coins:Number(rw.coins||0),
    total_xp:Number(rw.xp||0)
  },200,r);
}

async function referral(r,e){
  const u=await user(r,e);

  if(!u)return err("Login required",401,{},r);

  const code="ENG"+u.id;

  return json({
    success:true,
    referral_code:code,
    referral_url:`${SITE}/a/?ref=${encodeURIComponent(code)}`
  },200,r);
}

async function createReferral(code,userId,e){
  if(!/^ENG\d+$/i.test(code))return;

  const owner=Number(code.slice(3));

  if(owner===userId)return;

  try{
    await e.DB.prepare(
      "INSERT OR IGNORE INTO referrals(referrer_id,referred_id,referral_code,created_at) VALUES(?,?,?,?)"
    ).bind(
      owner,
      userId,
      code.toUpperCase(),
      new Date().toISOString()
    ).run();
  }catch{}
}

async function payment(r,e){
  const u=await user(r,e);

  if(!u)return err("Login required",401,{},r);

  return e.PAY.fetch("https://pay/internal/start",{
    method:"POST",
    headers:{"Content-Type":"application/json"},
    body:JSON.stringify({
      email:u.email,
      user_id:u.id
    })
  });
}

async function affiliate(r,e){
  const u=new URL(r.url);

  return e.AFF.fetch(
    new Request("https://affiliate"+u.pathname+u.search,r)
  );
}

async function logout(r){
  return new Response(null,{
    status:302,
    headers:{
      Location:`${SITE}/a/`,
      "Set-Cookie":`${SESSION}=; Path=/; HttpOnly; Secure; SameSite=None; Max-Age=0`,
      "Access-Control-Allow-Origin":origin(r),
      "Access-Control-Allow-Credentials":"true"
    }
  });
}

export default{
  async fetch(r,e){
    if(r.method==="OPTIONS")
      return new Response(null,{headers:H(r)});

    try{
      const p=new URL(r.url).pathname;

      if(p==="/auth/google")
        return google(r,e);

      if(p==="/auth/callback")
        return callback(r,e);

      if(p==="/auth/logout")
        return logout(r);

      if(p==="/api/me")
        return me(r,e);

      if(p==="/api/titles")
        return titles(r,e);

      if(p==="/api/questions")
        return questions(r,e);

      if(p==="/api/quiz/start"&&r.method==="POST")
        return startQuiz(r,e);

      if(p==="/api/quiz/check"&&r.method==="POST")
        return check(r,e);

      if(p==="/api/quiz/submit"&&r.method==="POST")
        return submit(r,e);

      if(p==="/api/referral")
        return referral(r,e);

      if(p==="/api/payment/start"&&r.method==="POST")
        return payment(r,e);

      if(
        p==="/api/affiliate"||
        p==="/api/affiliate/withdrawal"||
        p==="/api/affiliate/click"
      )
        return affiliate(r,e);

      if(p==="/api/health")
        return json({success:true},200,r);

      return err("Not found",404,{},r);

    }catch(ex){
      console.error(ex);
      return err(
        "Server error",
        500,
        {detail:String(ex?.message||ex)},
        r
      );
    }
  }
};