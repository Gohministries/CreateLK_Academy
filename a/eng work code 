const SITE="https://createlk.com";
const AFF="https://affiliate-a.createlk.workers.dev";
const SESSION="english_session";
const REFERRAL="english_referral";
const COINS=5;
const XP=10;
const MAX=3;
const DAYS=30;

function headers(origin){
  return {
    "Access-Control-Allow-Origin":origin||SITE,
    "Access-Control-Allow-Credentials":"true",
    "Access-Control-Allow-Headers":"Content-Type,Authorization",
    "Access-Control-Allow-Methods":"GET,POST,OPTIONS"
  };
}

function response(data,status,origin,extra){
  var h=headers(origin);
  h["Content-Type"]="application/json";
  if(extra){
    Object.keys(extra).forEach(function(k){h[k]=extra[k]});
  }
  return new Response(JSON.stringify(data),{status:status,headers:h});
}

function getCookie(req,name){
  var c=req.headers.get("Cookie")||"";
  var a=c.split(";");
  for(var i=0;i<a.length;i++){
    var p=a[i].trim().split("=");
    if(p[0]===name)return decodeURIComponent(p.slice(1).join("="));
  }
  return null;
}

function cookie(name,value,seconds){
  return name+"="+encodeURIComponent(value)+
    "; Max-Age="+seconds+
    "; Path=/; Secure; HttpOnly; SameSite=Lax";
}

function deleteCookie(name){
  return name+"=; Max-Age=0; Path=/; Secure; HttpOnly; SameSite=Lax";
}

function clean(v){
  return String(v||"").trim();
}

async function getUser(req,env){
  var token=getCookie(req,SESSION);
  if(!token)return null;

  return await env.DB.prepare(
    "SELECT u.id,u.google_id,u.name,u.email,u.membership_status,"+
    "u.membership_expiry,u.picture,s.token,s.expires_at "+
    "FROM sessions s JOIN users u ON u.id=s.user_id "+
    "WHERE s.token=? AND s.expires_at>? LIMIT 1"
  ).bind(token,Date.now()).first();
}

async function getRewards(env,userId){
  var r=await env.DB.prepare(
    "SELECT user_id,coins,xp FROM user_rewards WHERE user_id=?"
  ).bind(userId).first();

  if(!r){
    await env.DB.prepare(
      "INSERT INTO user_rewards(user_id,coins,xp) VALUES(?,0,0)"
    ).bind(userId).run();

    r={coins:0,xp:0};
  }

  return r;
}

async function isPremium(env,userId){
  return await env.DB.prepare(
    "SELECT user_id,email,name,status,membership_expiry "+
    "FROM premium_users WHERE user_id=? "+
    "AND (status='PREMIUM' OR status='ACTIVE') "+
    "AND (membership_expiry IS NULL OR membership_expiry>datetime('now')) "+
    "LIMIT 1"
  ).bind(userId).first();
}

async function apiMe(req,env,origin){
  var u=await getUser(req,env);

  if(!u){
    return response({
      success:true,
      logged_in:false,
      user:null,
      premium:null,
      rewards:{coins:0,xp:0}
    },200,origin);
  }

  var p=await isPremium(env,u.id);
  var r=await getRewards(env,u.id);

  return response({
    success:true,
    logged_in:true,
    user:{
      id:u.id,
      name:u.name,
      email:u.email,
      picture:u.picture||"",
      membership_status:u.membership_status,
      membership_expiry:u.membership_expiry
    },
    premium:p||null,
    rewards:{
      coins:Number(r.coins||0),
      xp:Number(r.xp||0)
    }
  },200,origin);
}

async function apiTitles(env,origin){
  var r=await env.DB.prepare(
    "SELECT id,title,description,order_no,status "+
    "FROM lessons WHERE status='ACTIVE' "+
    "ORDER BY order_no,id"
  ).all();

  return response({
    success:true,
    lessons:r.results||[]
  },200,origin);
}

async function apiQuestions(req,env,origin){
  var u=await getUser(req,env);

  if(!u){
    return response({success:false,error:"LOGIN_REQUIRED"},401,origin);
  }

  var url=new URL(req.url);
  var lessonId=Number(url.searchParams.get("lesson_id")||0);

  if(!lessonId){
    return response({success:false,error:"LESSON_REQUIRED"},400,origin);
  }

  if(lessonId!==1){
    var p=await isPremium(env,u.id);
    if(!p){
      return response({
        success:false,
        error:"PREMIUM_REQUIRED"
      },403,origin);
    }
  }

  var r=await env.DB.prepare(
    "SELECT id,lesson_id,question,option_a,option_b,option_c,option_d "+
    "FROM questions WHERE lesson_id=? AND status='ACTIVE' ORDER BY id"
  ).bind(lessonId).all();

  var list=(r.results||[]).map(function(q){
    return {
      id:q.id,
      lesson_id:q.lesson_id,
      question:q.question,
      options:[
        q.option_a,
        q.option_b,
        q.option_c,
        q.option_d
      ]
    };
  });

  return response({
    success:true,
    lesson_id:lessonId,
    questions:list
  },200,origin);
}

async function apiQuizStart(req,env,origin){
  var u=await getUser(req,env);

  if(!u){
    return response({success:false,error:"LOGIN_REQUIRED"},401,origin);
  }

  var b=await req.json();
  var lessonId=Number(b.lesson_id||0);

  if(!lessonId){
    return response({success:false,error:"LESSON_REQUIRED"},400,origin);
  }

  if(lessonId!==1){
    var p=await isPremium(env,u.id);
    if(!p){
      return response({
        success:false,
        error:"PREMIUM_REQUIRED"
      },403,origin);
    }
  }

  var since=Date.now()-DAYS*86400000;

  var count=await env.DB.prepare(
    "SELECT COUNT(*) total FROM quiz_results "+
    "WHERE user_id=? AND created_at>=?"
  ).bind(u.id,since).first();

  if(Number(count.total||0)>=MAX){
    return response({
      success:false,
      error:"QUIZ_LIMIT_REACHED",
      max:MAX
    },403,origin);
  }

  var now=Date.now();

  await env.DB.prepare(
    "INSERT INTO quiz_attempts(user_id,lesson_id,started_at,status) "+
    "VALUES(?,?,?,'STARTED')"
  ).bind(u.id,lessonId,now).run();

  var attempt=await env.DB.prepare(
    "SELECT id FROM quiz_attempts "+
    "WHERE user_id=? AND lesson_id=? AND started_at=? "+
    "ORDER BY id DESC LIMIT 1"
  ).bind(u.id,lessonId,now).first();

  return response({
    success:true,
    attempt_id:attempt?attempt.id:null
  },200,origin);
}

async function apiQuizCheck(req,env,origin){
  var u=await getUser(req,env);

  if(!u){
    return response({success:false,error:"LOGIN_REQUIRED"},401,origin);
  }

  var b=await req.json();
  var questionId=Number(b.question_id||0);
  var answer=clean(b.answer);

  if(!questionId||!answer){
    return response({success:false,error:"INVALID_REQUEST"},400,origin);
  }

  var q=await env.DB.prepare(
    "SELECT answer FROM questions "+
    "WHERE id=? AND status='ACTIVE' LIMIT 1"
  ).bind(questionId).first();

  if(!q){
    return response({
      success:false,
      error:"QUESTION_NOT_FOUND"
    },404,origin);
  }

  var correct=
    answer.toUpperCase()===clean(q.answer).toUpperCase();

  return response({
    success:true,
    correct:correct,
    reward:correct?
      {coins:COINS,xp:XP}:
      {coins:0,xp:0}
  },200,origin);
}

async function apiQuizSubmit(req,env,origin){
  var u=await getUser(req,env);

  if(!u){
    return response({success:false,error:"LOGIN_REQUIRED"},401,origin);
  }

  var b=await req.json();
  var attemptId=Number(b.attempt_id||0);
  var lessonId=Number(b.lesson_id||0);
  var answers=Array.isArray(b.answers)?b.answers:[];

  if(!attemptId||!lessonId||!answers.length){
    return response({success:false,error:"INVALID_REQUEST"},400,origin);
  }

  var attempt=await env.DB.prepare(
    "SELECT id,user_id,status FROM quiz_attempts "+
    "WHERE id=? AND user_id=? LIMIT 1"
  ).bind(attemptId,u.id).first();

  if(!attempt){
    return response({
      success:false,
      error:"ATTEMPT_NOT_FOUND"
    },404,origin);
  }

  if(attempt.status==="COMPLETED"){
    return response({
      success:false,
      error:"ATTEMPT_ALREADY_COMPLETED"
    },400,origin);
  }

  var correct=0;

  for(var i=0;i<answers.length;i++){
    var item=answers[i];
    var qid=Number(item.question_id||0);
    var ans=clean(item.answer);

    if(!qid||!ans)continue;

    var q=await env.DB.prepare(
      "SELECT answer FROM questions "+
      "WHERE id=? AND lesson_id=? AND status='ACTIVE' LIMIT 1"
    ).bind(qid,lessonId).first();

    if(q&&ans.toUpperCase()===clean(q.answer).toUpperCase()){
      correct++;
    }
  }

  var total=answers.length;
  var coins=correct*COINS;
  var xp=correct*XP;
  var now=Date.now();

  await env.DB.prepare(
    "INSERT INTO quiz_results("+
    "user_id,lesson_id,attempt_id,score,total,"+
    "coins_earned,xp_earned,created_at) "+
    "VALUES(?,?,?,?,?,?,?,?)"
  ).bind(
    u.id,lessonId,attemptId,correct,total,coins,xp,now
  ).run();

  await env.DB.prepare(
    "UPDATE quiz_attempts "+
    "SET status='COMPLETED',completed_at=? WHERE id=?"
  ).bind(now,attemptId).run();

  await getRewards(env,u.id);

  await env.DB.prepare(
    "UPDATE user_rewards "+
    "SET coins=coins+?,xp=xp+? WHERE user_id=?"
  ).bind(coins,xp,u.id).run();

  var r=await getRewards(env,u.id);

  return response({
    success:true,
    result:{
      correct:correct,
      total:total,
      percentage:total?
        Math.round(correct/total*100):0
    },
    reward:{
      coins:coins,
      xp:xp
    },
    balance:{
      coins:Number(r.coins||0),
      xp:Number(r.xp||0)
    }
  },200,origin);
}

async function apiReferral(req,env,origin){
  var code=getCookie(req,REFERRAL);

  if(!/^CLK[A-Z0-9]+$/i.test(clean(code))){
    code=null;
  }

  return response({
    success:true,
    referral_code:code?clean(code).toUpperCase():null
  },200,origin);
}

async function apiRef(req,env,origin){
  var url=new URL(req.url);
  var code=clean(url.searchParams.get("ref")).toUpperCase();

  if(!/^CLK[A-Z0-9]+$/.test(code)){
    return response({
      success:false,
      error:"INVALID_REFERRAL"
    },400,origin);
  }

  try{
    await fetch(AFF+"/api/click",{
      method:"POST",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify({referral_code:code})
    });
  }catch(e){}

  return response({
    success:true,
    referral_code:code
  },200,origin,{
    "Set-Cookie":cookie(REFERRAL,code,2592000)
  });
}

async function googleLogin(env){
  var state=crypto.randomUUID();

  await env.DB.prepare(
    "INSERT INTO oauth_states(state,expires_at) VALUES(?,?)"
  ).bind(state,Date.now()+600000).run();

  var p=new URLSearchParams();

  p.set("client_id",env.GOOGLE_CLIENT_ID);
  p.set(
    "redirect_uri",
    "https://eng-a.createlk.workers.dev/auth/callback"
  );
  p.set("response_type","code");
  p.set("scope","openid email profile");
  p.set("state",state);

  return Response.redirect(
    "https://accounts.google.com/o/oauth2/v2/auth?"+p.toString(),
    302
  );
}

async function googleCallback(req,env){
  var url=new URL(req.url);
  var code=url.searchParams.get("code");
  var state=url.searchParams.get("state");

  if(!code||!state){
    return Response.redirect(
      SITE+"/Eng/?error=login",302
    );
  }

  var stateRow=await env.DB.prepare(
    "SELECT state FROM oauth_states "+
    "WHERE state=? AND expires_at>? LIMIT 1"
  ).bind(state,Date.now()).first();

  if(!stateRow){
    return Response.redirect(
      SITE+"/Eng/?error=state",302
    );
  }

  await env.DB.prepare(
    "DELETE FROM oauth_states WHERE state=?"
  ).bind(state).run();

  var tokenResponse=await fetch(
    "https://oauth2.googleapis.com/token",
    {
      method:"POST",
      headers:{
        "Content-Type":
          "application/x-www-form-urlencoded"
      },
      body:new URLSearchParams({
        code:code,
        client_id:env.GOOGLE_CLIENT_ID,
        client_secret:env.GOOGLE_CLIENT_SECRET,
        redirect_uri:
          "https://eng-a.createlk.workers.dev/auth/callback",
        grant_type:"authorization_code"
      })
    }
  );

  if(!tokenResponse.ok){
    return Response.redirect(
      SITE+"/Eng/?error=token",302
    );
  }

  var token=await tokenResponse.json();

  var infoResponse=await fetch(
    "https://openidconnect.googleapis.com/v1/userinfo",
    {
      headers:{
        Authorization:"Bearer "+token.access_token
      }
    }
  );

  if(!infoResponse.ok){
    return Response.redirect(
      SITE+"/Eng/?error=user",302
    );
  }

  var info=await infoResponse.json();

  var googleId=clean(info.sub);
  var email=clean(info.email).toLowerCase();
  var name=clean(info.name)||"CreateLK User";
  var picture=clean(info.picture);

  if(!googleId||!email){
    return Response.redirect(
      SITE+"/Eng/?error=account",302
    );
  }

  var u=await env.DB.prepare(
    "SELECT id FROM users WHERE google_id=? LIMIT 1"
  ).bind(googleId).first();

  if(u){
    await env.DB.prepare(
      "UPDATE users SET name=?,email=?,picture=?,"+
      "auth_provider='google',last_active_at=? WHERE id=?"
    ).bind(
      name,email,picture,Date.now(),u.id
    ).run();
  }else{
    u=await env.DB.prepare(
      "SELECT id FROM users WHERE lower(email)=? LIMIT 1"
    ).bind(email).first();

    if(u){
      await env.DB.prepare(
        "UPDATE users SET google_id=?,name=?,picture=?,"+
        "auth_provider='google',last_active_at=? WHERE id=?"
      ).bind(
        googleId,name,picture,Date.now(),u.id
      ).run();
    }else{
      await env.DB.prepare(
        "INSERT INTO users("+
        "google_id,name,email,membership_status,"+
        "auth_provider,last_active_at,picture) "+
        "VALUES(?,?,?,'FREE','google',?,?)"
      ).bind(
        googleId,name,email,Date.now(),picture
      ).run();

      u=await env.DB.prepare(
        "SELECT id FROM users WHERE google_id=? LIMIT 1"
      ).bind(googleId).first();
    }
  }

  await getRewards(env,u.id);

  var session=crypto.randomUUID()+
    crypto.randomUUID().replace(/-/g,"");

  await env.DB.prepare(
    "INSERT INTO sessions(token,user_id,expires_at,created_at) "+
    "VALUES(?,?,?,?)"
  ).bind(
    session,
    u.id,
    Date.now()+30*86400000,
    Date.now()
  ).run();

  return new Response(null,{
    status:302,
    headers:{
      Location:SITE+"/Eng/",
      "Set-Cookie":cookie(
        SESSION,session,30*86400
      )
    }
  });
}

export default {
  async fetch(req,env){
    var url=new URL(req.url);
    var path=url.pathname;
    var origin=req.headers.get("Origin")||SITE;

    if(req.method==="OPTIONS"){
      return new Response(null,{
        status:204,
        headers:headers(origin)
      });
    }

    try{
      if(path==="/api/health"){
        return response({
          success:true,
          worker:"eng-a",
          status:"OK"
        },200,origin);
      }

      if(path==="/auth/google"){
        return googleLogin(env);
      }

      if(path==="/auth/callback"){
        return googleCallback(req,env);
      }

      if(path==="/auth/logout"){
        return new Response(null,{
          status:302,
          headers:{
            Location:SITE+"/Eng/",
            "Set-Cookie":deleteCookie(SESSION)
          }
        });
      }

      if(path==="/api/me"){
        return apiMe(req,env,origin);
      }

      if(path==="/api/titles"){
        return apiTitles(env,origin);
      }

      if(path==="/api/questions"){
        return apiQuestions(req,env,origin);
      }

      if(path==="/api/quiz/start"&&req.method==="POST"){
        return apiQuizStart(req,env,origin);
      }

      if(path==="/api/quiz/check"&&req.method==="POST"){
        return apiQuizCheck(req,env,origin);
      }

      if(path==="/api/quiz/submit"&&req.method==="POST"){
        return apiQuizSubmit(req,env,origin);
      }

      if(path==="/api/ref"){
        return apiRef(req,env,origin);
      }

      if(path==="/api/referral"){
        return apiReferral(req,env,origin);
      }

      return response({
        success:false,
        error:"NOT_FOUND"
      },404,origin);

    }catch(err){
      console.error(err);

      return response({
        success:false,
        error:"SERVER_ERROR",
        message:err.message||"Unknown error"
      },500,origin);
    }
  }
};