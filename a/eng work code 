const SITE="https://createlk.com";
const AFF="https://affiliate-a.createlk.workers.dev";
const SESSION="english_session";
const REFERRAL="english_referral";
const COINS=5,XP=10,MAX=3,DAYS=30,SESSION_DAYS=30;

const cors=o=>({
  "Access-Control-Allow-Origin":
    ["https://createlk.com","https://www.createlk.com"].includes(o)?o:SITE,
  "Access-Control-Allow-Credentials":"true",
  "Access-Control-Allow-Headers":"Content-Type, Authorization",
  "Access-Control-Allow-Methods":"GET,POST,OPTIONS"
});

const json=(d,s=200,o=SITE,h={})=>new Response(JSON.stringify(d),{
  status:s,
  headers:{"Content-Type":"application/json",...cors(o),...h}
});

const cookie=(r,n)=>{
  const c=r.headers.get("Cookie")||"";
  for(const x of c.split(";")){
    const [k,...v]=x.trim().split("=");
    if(k===n)return decodeURIComponent(v.join("="));
  }
  return null;
};

const setCookie=(n,v,max)=>
  `${n}=${encodeURIComponent(v)}; Max-Age=${max}; Path=/; Secure; HttpOnly; SameSite=Lax`;

const delCookie=n=>
  `${n}=; Max-Age=0; Path=/; Secure; HttpOnly; SameSite=Lax`;

const text=v=>String(v??"").trim();

async function user(req,e){
  const t=cookie(req,SESSION);
  if(!t)return null;

  return e.DB.prepare(`
    SELECT u.id,u.google_id,u.name,u.email,u.membership_status,
    u.membership_expiry,u.picture,s.token,s.expires_at
    FROM sessions s JOIN users u ON u.id=s.user_id
    WHERE s.token=? AND s.expires_at>? LIMIT 1
  `).bind(t,Date.now()).first();
}

async function rewards(e,id){
  let r=await e.DB.prepare(
    `SELECT user_id,coins,xp FROM user_rewards WHERE user_id=?`
  ).bind(id).first();

  if(!r){
    await e.DB.prepare(`
      INSERT INTO user_rewards(user_id,coins,xp) VALUES(?,0,0)
    `).bind(id).run();
    r={coins:0,xp:0};
  }

  return r;
}

async function premium(e,id){
  return e.DB.prepare(`
    SELECT user_id,email,name,status,membership_expiry
    FROM premium_users
    WHERE user_id=?
    AND (status='PREMIUM' OR status='ACTIVE')
    AND (membership_expiry IS NULL OR membership_expiry>datetime('now'))
    LIMIT 1
  `).bind(id).first();
}

async function me(req,e,o){
  const u=await user(req,e);

  if(!u)return json({
    success:true,
    logged_in:false,
    user:null,
    premium:null,
    rewards:{coins:0,xp:0}
  },200,o);

  const p=await premium(e,u.id);
  const r=await rewards(e,u.id);

  return json({
    success:true,
    logged_in:true,
    user:{
      id:u.id,
      name:u.name,
      email:u.email,
      picture:u.picture||"",
      membership_status:u.membership_status,
      membership_expiry:u.membership_expiry
    },
    premium:p||null,
    rewards:{
      coins:Number(r.coins||0),
      xp:Number(r.xp||0)
    }
  },200,o);
}

async function titles(e,o){
  const r=await e.DB.prepare(`
    SELECT id,title,description,order_no,status
    FROM lessons
    WHERE status='ACTIVE'
    ORDER BY order_no,id
  `).all();

  return json({
    success:true,
    lessons:r.results||[]
  },200,o);
}

async function questions(req,e,o){
  const u=await user(req,e);
  if(!u)return json({success:false,error:"LOGIN_REQUIRED"},401,o);

  const id=Number(new URL(req.url).searchParams.get("lesson_id")||0);
  if(!id)return json({success:false,error:"LESSON_REQUIRED"},400,o);

  if(id!==1&&!await premium(e,u.id))
    return json({success:false,error:"PREMIUM_REQUIRED"},403,o);

  const r=await e.DB.prepare(`
    SELECT id,lesson_id,question,option_a,option_b,option_c,option_d
    FROM questions
    WHERE lesson_id=? AND status='ACTIVE'
    ORDER BY id
  `).bind(id).all();

  return json({
    success:true,
    lesson_id:id,
    questions:(r.results||[]).map(q=>({
      id:q.id,
      lesson_id:q.lesson_id,
      question:q.question,
      options:[q.option_a,q.option_b,q.option_c,q.option_d]
    }))
  },200,o);
}

async function quizStart(req,e,o){
  const u=await user(req,e);
  if(!u)return json({success:false,error:"LOGIN_REQUIRED"},401,o);

  const b=await req.json().catch(()=>({}));
  const lid=Number(b.lesson_id||0);

  if(!lid)return json({success:false,error:"LESSON_REQUIRED"},400,o);

  if(lid!==1&&!await premium(e,u.id))
    return json({success:false,error:"PREMIUM_REQUIRED"},403,o);

  const since=Date.now()-DAYS*86400000;

  const c=await e.DB.prepare(`
    SELECT COUNT(*) total FROM quiz_results
    WHERE user_id=? AND created_at>=?
  `).bind(u.id,since).first();

  if(Number(c?.total||0)>=MAX)
    return json({
      success:false,
      error:"QUIZ_LIMIT_REACHED",
      max:MAX
    },403,o);

  const now=Date.now();

  await e.DB.prepare(`
    INSERT INTO quiz_attempts(user_id,lesson_id,started_at,status)
    VALUES(?,?,?,'STARTED')
  `).bind(u.id,lid,now).run();

  const a=await e.DB.prepare(`
    SELECT id FROM quiz_attempts
    WHERE user_id=? AND lesson_id=? AND started_at=?
    ORDER BY id DESC LIMIT 1
  `).bind(u.id,lid,now).first();

  return json({
    success:true,
    attempt_id:a?.id
  },200,o);
}

async function quizCheck(req,e,o){
  const u=await user(req,e);
  if(!u)return json({success:false,error:"LOGIN_REQUIRED"},401,o);

  const b=await req.json().catch(()=>({}));
  const id=Number(b.question_id||0);
  const answer=text(b.answer);

  if(!id||!answer)
    return json({success:false,error:"INVALID_REQUEST"},400,o);

  const q=await e.DB.prepare(`
    SELECT answer FROM questions
    WHERE id=? AND status='ACTIVE'
  `).bind(id).first();

  if(!q)return json({
    success:false,
    error:"QUESTION_NOT_FOUND"
  },404,o);

  const correct=answer.toUpperCase()===text(q.answer).toUpperCase();

  return json({
    success:true,
    correct,
    reward:correct?{coins:COINS,xp:XP}:{coins:0,xp:0}
  },200,o);
}

async function quizSubmit(req,e,o){
  const u=await user(req,e);
  if(!u)return json({success:false,error:"LOGIN_REQUIRED"},401,o);

  const b=await req.json().catch(()=>({}));
  const aid=Number(b.attempt_id||0);
  const lid=Number(b.lesson_id||0);
  const answers=Array.isArray(b.answers)?b.answers:[];

  if(!aid||!lid||!answers.length)
    return json({success:false,error:"INVALID_REQUEST"},400,o);

  const a=await e.DB.prepare(`
    SELECT id,user_id,status
    FROM quiz_attempts
    WHERE id=? AND user_id=?
  `).bind(aid,u.id).first();

  if(!a)return json({
    success:false,
    error:"ATTEMPT_NOT_FOUND"
  },404,o);

  if(a.status==="COMPLETED")
    return json({
      success:false,
      error:"ATTEMPT_ALREADY_COMPLETED"
    },400,o);

  let correct=0;

  for(const x of answers){
    const qid=Number(x.question_id||0);
    const ans=text(x.answer);
    if(!qid||!ans)continue;

    const q=await e.DB.prepare(`
      SELECT answer FROM questions
      WHERE id=? AND lesson_id=? AND status='ACTIVE'
    `).bind(qid,lid).first();

    if(q&&ans.toUpperCase()===text(q.answer).toUpperCase())
      correct++;
  }

  const total=answers.length;
  const coins=correct*COINS;
  const xp=correct*XP;
  const now=Date.now();

  await e.DB.prepare(`
    INSERT INTO quiz_results(
      user_id,lesson_id,attempt_id,score,total,
      coins_earned,xp_earned,created_at
    ) VALUES(?,?,?,?,?,?,?,?)
  `).bind(
    u.id,lid,aid,correct,total,coins,xp,now
  ).run();

  await e.DB.prepare(`
    UPDATE quiz_attempts
    SET status='COMPLETED',completed_at=?
    WHERE id=?
  `).bind(now,aid).run();

  await rewards(e,u.id);

  await e.DB.prepare(`
    UPDATE user_rewards
    SET coins=coins+?,xp=xp+?
    WHERE user_id=?
  `).bind(coins,xp,u.id).run();

  const r=await rewards(e,u.id);

  return json({
    success:true,
    result:{
      correct,
      total,
      percentage:total?Math.round(correct/total*100):0
    },
    reward:{coins,xp},
    balance:{
      coins:Number(r.coins||0),
      xp:Number(r.xp||0)
    }
  },200,o);
}

async function referral(req,e,o){
  const r=cookie(req,REFERRAL);

  return json({
    success:true,
    referral_code:/^CLK[A-Z0-9]+$/i.test(text(r))
      ?text(r).toUpperCase()
      :null
  },200,o);
}

async function captureRef(req,e,o){
  const code=text(
    new URL(req.url).searchParams.get("ref")
  ).toUpperCase();

  if(!/^CLK[A-Z0-9]+$/.test(code))
    return json({
      success:false,
      error:"INVALID_REFERRAL"
    },400,o);

  try{
    await fetch(`${AFF}/api/click`,{
      method:"POST",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify({referral_code:code})
    });
  }catch(_){}

  return json({
    success:true,
    referral_code:code
  },200,o,{
    "Set-Cookie":setCookie(REFERRAL,code,2592000)
  });
}

async function google(req,e){
  const state=crypto.randomUUID();

  await e.DB.prepare(`
    INSERT INTO oauth_states(state,expires_at)
    VALUES(?,?)
  `).bind(state,Date.now()+600000).run();

  const p=new URLSearchParams({
    client_id:e.GOOGLE_CLIENT_ID,
    redirect_uri:"https://eng-a.createlk.workers.dev/auth/callback",
    response_type:"code",
    scope:"openid email profile",
    state
  });

  return Response.redirect(
    `https://accounts.google.com/o/oauth2/v2/auth?${p}`,
    302
  );
}

async function callback(req,e){
  const u=new URL(req.url);
  const code=u.searchParams.get("code");
  const state=u.searchParams.get("state");

  if(!code||!state)
    return Response.redirect(`${SITE}/Eng/?error=login`,302);

  const s=await e.DB.prepare(`
    SELECT state FROM oauth_states
    WHERE state=? AND expires_at>?
  `).bind(state,Date.now()).first();

  if(!s)
    return Response.redirect(`${SITE}/Eng/?error=state`,302);

  await e.DB.prepare(
    `DELETE FROM oauth_states WHERE state=?`
  ).bind(state).run();

  const t=await fetch(
    "https://oauth2.googleapis.com/token",
    {
      method:"POST",
      headers:{
        "Content-Type":
          "application/x-www-form-urlencoded"
      },
      body:new URLSearchParams({
        code,
        client_id:e.GOOGLE_CLIENT_ID,
        client_secret:e.GOOGLE_CLIENT_SECRET,
        redirect_uri:
          "https://eng-a.createlk.workers.dev/auth/callback",
        grant_type:"authorization_code"
      })
    }
  );

  if(!t.ok)
    return Response.redirect(`${SITE}/Eng/?error=token`,302);

  const token=await t.json();

  const g=await fetch(
    "https://openidconnect.googleapis.com/v1/userinfo",
    {
      headers:{
        Authorization:`Bearer ${token.access_token}`
      }
    }
  );

  if(!g.ok)
    return Response.redirect(`${SITE}/Eng/?error=user`,302);

  const x=await g.json();
  const gid=text(x.sub);
  const email=text(x.email).toLowerCase();
  const name=text(x.name)||"CreateLK User";
  const picture=text(x.picture);

  if(!gid||!email)
    return Response.redirect(`${SITE}/Eng/?error=account`,302);

  let u=await e.DB.prepare(`
    SELECT id FROM users WHERE google_id=? LIMIT 1
  `).bind(gid).first();

  if(u){
    await e.DB.prepare(`
      UPDATE users
      SET name=?,email=?,picture=?,last_active_at=?
      WHERE id=?
    `).bind(
      name,email,picture,Date.now(),u.id
    ).run();
  }else{
    u=await e.DB.prepare(`
      SELECT id FROM users
      WHERE lower(email)=? LIMIT 1
    `).bind(email).first();

    if(u){
      await e.DB.prepare(`
        UPDATE users
        SET google_id=?,name=?,picture=?,
        auth_provider='google',last_active_at=?
        WHERE id=?
      `).bind(
        gid,name,picture,Date.now(),u.id
      ).run();
    }else{
      await e.DB.prepare(`
        INSERT INTO users(
          google_id,name,email,membership_status,
          auth_provider,last_active_at,picture
        )
        VALUES(?,?,?,'FREE','google',?,?)
      `).bind(
        gid,name,email,Date.now(),picture
      ).run();

      u=await e.DB.prepare(`
        SELECT id FROM users
        WHERE google_id=? LIMIT 1
      `).bind(gid).first();
    }
  }

  await rewards(e,u.id);

  const st=crypto.randomUUID()+crypto.randomUUID().replace(/-/g,"");

  await e.DB.prepare(`
    INSERT INTO sessions(token,user_id,expires_at,created_at)
    VALUES(?,?,?,?)
  `).bind(
    st,
    u.id,
    Date.now()+SESSION_DAYS*86400000,
    Date.now()
  ).run();

  return new Response(null,{
    status:302,
    headers:{
      Location:`${SITE}/Eng/`,
      "Set-Cookie":setCookie(
        SESSION,st,SESSION_DAYS*86400
      )
    }
  });
}

export default{
  async fetch(req,e){
    const u=new URL(req.url);
    const p=u.pathname;
    const o=req.headers.get("Origin")||SITE;

    if(req.method==="OPTIONS")
      return new Response(null,{
        status:204,
        headers:cors(o)
      });

    try{
      if(p==="/api/health")
        return json({success:true,status:"OK"},200,o);

      if(p==="/auth/google")
        return google(req,e);

      if(p==="/auth/callback")
        return callback(req,e);

      if(p==="/auth/logout")
        return new Response(null,{
          status:302,
          headers:{
            Location:`${SITE}/Eng/`,
            "Set-Cookie":delCookie(SESSION)
          }
        });

      if(p==="/api/me")
        return me(req,e,o);

      if(p==="/api/titles")
        return titles(e,o);

      if(p==="/api/questions")
        return questions(req,e,o);

      if(p==="/api/quiz/start"&&req.method==="POST")
        return quizStart(req,e,o);

      if(p==="/api/quiz/check"&&req.method==="POST")
        return quizCheck(req,e,o);

      if(p==="/api/quiz/submit"&&req.method==="POST")
        return quizSubmit(req,e,o);

      if(p==="/api/ref")
        return captureRef(req,e,o);

      if(p==="/api/referral")
        return referral(req,e,o);

      return json({
        success:false,
        error:"NOT_FOUND"
      },404,o);

    }catch(err){
      console.error(err);
      return json({
        success:false,
        error:"SERVER_ERROR",
        message:err.message
      },500,o);
    }
  }
};