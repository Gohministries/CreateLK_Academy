const CORS = {
  "Access-Control-Allow-Origin": "https://createlk.com",
  "Access-Control-Allow-Methods": "GET,POST,OPTIONS",
  "Access-Control-Allow-Headers": "Content-Type,Authorization"
};

const RETURN_URL =
  "https://createlk.com/shop.html?payment=success";

const CANCEL_URL =
  "https://createlk.com/shop.html?payment=cancelled";

const NOTIFY_URL =
  "https://createlk-payhere.createlk.workers.dev/notify";


function json(data, status = 200) {
  return new Response(JSON.stringify(data), {
    status,
    headers: {
      ...CORS,
      "Content-Type": "application/json"
    }
  });
}

function error(message, status = 400) {
  return json({
    success: false,
    error: message
  }, status);
}


/* =========================================================
   MD5
========================================================= */

function md5(input) {

  function add(x, y) {
    return (x + y) | 0;
  }

  function rol(x, n) {
    return (x << n) | (x >>> (32 - n));
  }

  function cmn(q, a, b, x, s, t) {
    return add(
      rol(
        add(
          add(a, q),
          add(x, t)
        ),
        s
      ),
      b
    );
  }

  function ff(a, b, c, d, x, s, t) {
    return cmn(
      (b & c) | ((~b) & d),
      a, b, x, s, t
    );
  }

  function gg(a, b, c, d, x, s, t) {
    return cmn(
      (b & d) | (c & (~d)),
      a, b, x, s, t
    );
  }

  function hh(a, b, c, d, x, s, t) {
    return cmn(
      b ^ c ^ d,
      a, b, x, s, t
    );
  }

  function ii(a, b, c, d, x, s, t) {
    return cmn(
      c ^ (b | (~d)),
      a, b, x, s, t
    );
  }

  const encoded = unescape(
    encodeURIComponent(input)
  );

  const bytes = [];

  for (let i = 0; i < encoded.length; i++) {
    bytes.push(encoded.charCodeAt(i));
  }

  const bitLength = bytes.length * 8;

  bytes.push(128);

  while (bytes.length % 64 !== 56) {
    bytes.push(0);
  }

  for (let i = 0; i < 8; i++) {
    bytes.push(
      (bitLength >>> (8 * i)) & 255
    );
  }

  let a0 = 0x67452301;
  let b0 = 0xefcdab89;
  let c0 = 0x98badcfe;
  let d0 = 0x10325476;

  const K = [
    0xd76aa478, 0xe8c7b756, 0x242070db, 0xc1bdceee,
    0xf57c0faf, 0x4787c62a, 0xa8304613, 0xfd469501,
    0x698098d8, 0x8b44f7af, 0xffff5bb1, 0x895cd7be,
    0x6b901122, 0xfd987193, 0xa679438e, 0x49b40821,
    0xf61e2562, 0xc040b340, 0x265e5a51, 0xe9b6c7aa,
    0xd62f105d, 0x02441453, 0xd8a1e681, 0xe7d3fbc8,
    0x21e1cde6, 0xc33707d6, 0xf4d50d87, 0x455a14ed,
    0xa9e3e905, 0xfcefa3f8, 0x676f02d9, 0x8d2a4c8a,
    0xfffa3942, 0x8771f681, 0x6d9d6122, 0xfde5380c,
    0xa4beea44, 0x4bdecfa9, 0xf6bb4b60, 0xbebfbc70,
    0x289b7ec6, 0xeaa127fa, 0xd4ef3085, 0x04881d05,
    0xd9d4d039, 0xe6db99e5, 0x1fa27cf8, 0xc4ac5665,
    0xf4292244, 0x432aff97, 0xab9423a7, 0xfc93a039,
    0x655b59c3, 0x8f0ccc92, 0xffeff47d, 0x85845dd1,
    0x6fa87e4f, 0xfe2ce6e0, 0xa3014314, 0x4e0811a1,
    0xf7537e82, 0xbd3af235, 0x2ad7d2bb, 0xeb86d391
  ];

  const S = [
    7,12,17,22,7,12,17,22,
    7,12,17,22,7,12,17,22,
    5,9,14,20,5,9,14,20,
    5,9,14,20,5,9,14,20,
    4,11,16,23,4,11,16,23,
    4,11,16,23,4,11,16,23,
    6,10,15,21,6,10,15,21,
    6,10,15,21,6,10,15,21
  ];

  for (
    let offset = 0;
    offset < bytes.length;
    offset += 64
  ) {

    const M = new Array(16);

    for (let i = 0; i < 16; i++) {

      const p = offset + i * 4;

      M[i] =
        bytes[p] |
        (bytes[p + 1] << 8) |
        (bytes[p + 2] << 16) |
        (bytes[p + 3] << 24);
    }

    let A = a0;
    let B = b0;
    let C = c0;
    let D = d0;

    for (let i = 0; i < 64; i++) {

      let F;
      let g;

      if (i < 16) {
        F = ff;
        g = i;
      } else if (i < 32) {
        F = gg;
        g = (5 * i + 1) % 16;
      } else if (i < 48) {
        F = hh;
        g = (3 * i + 5) % 16;
      } else {
        F = ii;
        g = (7 * i) % 16;
      }

      const oldD = D;

      D = C;
      C = B;

      B = F(
        B,
        C,
        D,
        M[g],
        S[i],
        K[i]
      );

      A = oldD;
    }

    a0 = add(a0, A);
    b0 = add(b0, B);
    c0 = add(c0, C);
    d0 = add(d0, D);
  }

  function hex(n) {

    let result = "";

    for (let i = 0; i < 4; i++) {

      result += (
        (n >>> (8 * i)) & 255
      ).toString(16).padStart(2, "0");
    }

    return result;
  }

  return (
    hex(a0) +
    hex(b0) +
    hex(c0) +
    hex(d0)
  ).toUpperCase();
}


/* =========================================================
   BASE64 / SESSION
========================================================= */

function decodeBase64(text) {

  text = text
    .replace(/-/g, "+")
    .replace(/_/g, "/");

  while (text.length % 4) {
    text += "=";
  }

  return atob(text);
}


function base64url(text) {

  return btoa(text)
    .replace(/\+/g, "-")
    .replace(/\//g, "_")
    .replace(/=+$/, "");
}


async function hmac(text, secret) {

  const key =
    await crypto.subtle.importKey(
      "raw",
      new TextEncoder().encode(secret),
      {
        name: "HMAC",
        hash: "SHA-256"
      },
      false,
      ["sign"]
    );

  const result =
    await crypto.subtle.sign(
      "HMAC",
      key,
      new TextEncoder().encode(text)
    );

  return base64url(
    String.fromCharCode(
      ...new Uint8Array(result)
    )
  );
}


async function getCustomer(request, env) {

  const authorization =
    request.headers.get("Authorization") || "";

  if (!authorization.startsWith("Bearer ")) {
    return null;
  }

  try {

    const token =
      authorization.slice(7);

    const parts =
      token.split(".");

    if (parts.length !== 2) {
      return null;
    }

    const payload = parts[0];
    const signature = parts[1];

    const expected =
      await hmac(
        payload,
        env.SESSION_SECRET
      );

    if (signature !== expected) {
      return null;
    }

    const data =
      JSON.parse(
        decodeBase64(payload)
      );

    if (
      !data.id ||
      !data.exp ||
      Date.now() > data.exp
    ) {
      return null;
    }

    return await env.DB.prepare(`
      SELECT
        id,
        first_name,
        last_name,
        email,
        phone
      FROM customers
      WHERE id = ?
    `)
      .bind(data.id)
      .first();

  } catch {
    return null;
  }
}


/* =========================================================
   WORKER
========================================================= */

export default {

  async fetch(request, env) {

    if (request.method === "OPTIONS") {
      return new Response(null, {
        headers: CORS
      });
    }

    const url = new URL(request.url);

    const path =
      url.pathname.replace(/\/$/, "");

    try {

      /* =========================================
         HEALTH CHECK
      ========================================= */

      if (path === "" || path === "/") {

        return json({
          success: true,
          service: "CreateLK PayHere",
          mode: "LIVE",
          status: "online"
        });
      }


      /* =========================================
         CHECKOUT
      ========================================= */

      if (
        path === "/checkout" &&
        request.method === "POST"
      ) {

        const customer =
          await getCustomer(request, env);

        if (!customer) {

          return error(
            "Please login first.",
            401
          );
        }

        const body =
          await request.json();

        const productId =
          Number(body.product_id);

        if (!productId) {

          return error(
            "Product ID is required."
          );
        }


        /* Product */

        const product =
          await env.DB.prepare(`
            SELECT
              id,
              title,
              price
            FROM products
            WHERE id = ?
            AND published = 1
          `)
            .bind(productId)
            .first();

        if (!product) {

          return error(
            "Product not found.",
            404
          );
        }


        /* Already paid */

        const existing =
          await env.DB.prepare(`
            SELECT
              id,
              order_id
            FROM purchases
            WHERE customer_id = ?
            AND product_id = ?
            AND status = 'PAID'
            LIMIT 1
          `)
            .bind(
              customer.id,
              productId
            )
            .first();

        if (existing) {

          return json({
            success: true,
            already_purchased: true,
            order_id: existing.order_id
          });
        }


        /* New order */

        const orderId =
          "CLK-" +
          Date.now() +
          "-" +
          crypto.randomUUID()
            .replace(/-/g, "")
            .slice(0, 8)
            .toUpperCase();

        const amount =
          Number(product.price).toFixed(2);


        await env.DB.prepare(`
          INSERT INTO purchases
          (
            customer_id,
            product_id,
            order_id,
            amount,
            currency,
            status
          )
          VALUES
          (?, ?, ?, ?, ?, 'PENDING')
        `)
          .bind(
            customer.id,
            product.id,
            orderId,
            amount,
            "LKR"
          )
          .run();


        /* PayHere checkout hash */

        const merchantSecretHash =
          md5(
            env.PAYHERE_MERCHANT_SECRET
          );

        const checkoutHash =
          md5(
            env.PAYHERE_MERCHANT_ID +
            orderId +
            amount +
            "LKR" +
            merchantSecretHash
          );


        return json({

          success: true,

          action:
            "https://www.payhere.lk/pay/checkout",

          fields: {

            merchant_id:
              env.PAYHERE_MERCHANT_ID,

            return_url:
              RETURN_URL,

            cancel_url:
              CANCEL_URL,

            notify_url:
              NOTIFY_URL,

            first_name:
              customer.first_name,

            last_name:
              customer.last_name || "",

            email:
              customer.email,

            phone:
              customer.phone || "0000000000",

            address:
              "Sri Lanka",

            city:
              "Sri Lanka",

            country:
              "Sri Lanka",

            order_id:
              orderId,

            items:
              product.title,

            currency:
              "LKR",

            amount:
              amount,

            hash:
              checkoutHash
          }
        });
      }


      /* =========================================
         PAYHERE NOTIFY
      ========================================= */

      if (
        path === "/notify" &&
        request.method === "POST"
      ) {

        const form =
          await request.formData();

        const merchantId =
          String(
            form.get("merchant_id") || ""
          );

        const orderId =
          String(
            form.get("order_id") || ""
          );

        const paymentId =
          String(
            form.get("payment_id") || ""
          );

        const amount =
          String(
            form.get("payhere_amount") || ""
          );

        const currency =
          String(
            form.get("payhere_currency") || ""
          );

        const statusCode =
          String(
            form.get("status_code") || ""
          );

        const receivedSignature =
          String(
            form.get("md5sig") || ""
          ).toUpperCase();


        /* Merchant check */

        if (
          merchantId !==
          env.PAYHERE_MERCHANT_ID
        ) {

          return new Response(
            "INVALID MERCHANT",
            { status: 400 }
          );
        }


        /* Verify PayHere signature */

        const merchantSecretHash =
          md5(
            env.PAYHERE_MERCHANT_SECRET
          );

        const localSignature =
          md5(
            merchantId +
            orderId +
            amount +
            currency +
            statusCode +
            merchantSecretHash
          );


        if (
          receivedSignature !==
          localSignature
        ) {

          console.error(
            "Invalid PayHere signature"
          );

          return new Response(
            "INVALID SIGNATURE",
            { status: 400 }
          );
        }


        /* Find purchase */

        const purchase =
          await env.DB.prepare(`
            SELECT
              id,
              amount,
              currency,
              status
            FROM purchases
            WHERE order_id = ?
            LIMIT 1
          `)
            .bind(orderId)
            .first();

        if (!purchase) {

          return new Response(
            "ORDER NOT FOUND",
            { status: 404 }
          );
        }


        /* Amount protection */

        if (
          Number(purchase.amount)
            .toFixed(2) !==
          Number(amount)
            .toFixed(2)
        ) {

          return new Response(
            "AMOUNT MISMATCH",
            { status: 400 }
          );
        }


        /* Currency protection */

        if (
          String(purchase.currency)
            .toUpperCase() !==
          currency.toUpperCase()
        ) {

          return new Response(
            "CURRENCY MISMATCH",
            { status: 400 }
          );
        }


        /* =====================================
           SUCCESS
        ===================================== */

        if (statusCode === "2") {

          await env.DB.prepare(`
            UPDATE purchases
            SET
              payment_id = ?,
              status = 'PAID',
              purchased_at = CURRENT_TIMESTAMP
            WHERE id = ?
          `)
            .bind(
              paymentId,
              purchase.id
            )
            .run();
        }


        /* =====================================
           CANCELLED
        ===================================== */

        else if (statusCode === "-1") {

          await env.DB.prepare(`
            UPDATE purchases
            SET
              payment_id = ?,
              status = 'CANCELLED'
            WHERE id = ?
          `)
            .bind(
              paymentId,
              purchase.id
            )
            .run();
        }


        /* =====================================
           FAILED
        ===================================== */

        else if (statusCode === "-2") {

          await env.DB.prepare(`
            UPDATE purchases
            SET
              payment_id = ?,
              status = 'FAILED'
            WHERE id = ?
          `)
            .bind(
              paymentId,
              purchase.id
            )
            .run();
        }


        /* =====================================
           CHARGEBACK
        ===================================== */

        else if (statusCode === "-3") {

          await env.DB.prepare(`
            UPDATE purchases
            SET
              payment_id = ?,
              status = 'CHARGEDBACK'
            WHERE id = ?
          `)
            .bind(
              paymentId,
              purchase.id
            )
            .run();
        }


        /* =====================================
           PENDING
        ===================================== */

        else if (statusCode === "0") {

          await env.DB.prepare(`
            UPDATE purchases
            SET
              payment_id = ?,
              status = 'PENDING'
            WHERE id = ?
          `)
            .bind(
              paymentId,
              purchase.id
            )
            .run();
        }


        return new Response(
          "OK",
          { status: 200 }
        );
      }


      /* =========================================
         UNKNOWN ROUTE
      ========================================= */

      return error(
        "Route not found.",
        404
      );

    } catch (err) {

      console.error(err);

      return error(
        err.message || "Server error.",
        500
      );
    }
  }
};