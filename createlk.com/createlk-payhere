const CORS = {
  "Access-Control-Allow-Origin": "https://createlk.com",
  "Access-Control-Allow-Methods": "GET,POST,OPTIONS",
  "Access-Control-Allow-Headers": "Content-Type,Authorization"
};

function json(data, status = 200) {
  return new Response(JSON.stringify(data), {
    status,
    headers: {
      ...CORS,
      "Content-Type": "application/json"
    }
  });
}

/* BASE64 */

function base64Encode(data) {
  return btoa(
    String.fromCharCode(...new Uint8Array(data))
  )
    .replace(/\+/g, "-")
    .replace(/\//g, "_")
    .replace(/=+$/, "");
}

function base64Decode(value) {
  value = value
    .replace(/-/g, "+")
    .replace(/_/g, "/");

  while (value.length % 4) value += "=";

  const binary = atob(value);
  const bytes = new Uint8Array(binary.length);

  for (let i = 0; i < binary.length; i++) {
    bytes[i] = binary.charCodeAt(i);
  }

  return bytes;
}

/* SESSION */

async function verifyToken(token, secret) {
  try {
    if (!token || !secret) return null;

    const parts = token.split(".");

    if (parts.length !== 2) return null;

    const key = await crypto.subtle.importKey(
      "raw",
      new TextEncoder().encode(secret),
      {
        name: "HMAC",
        hash: "SHA-256"
      },
      false,
      ["sign"]
    );

    const signature = await crypto.subtle.sign(
      "HMAC",
      key,
      new TextEncoder().encode(parts[0])
    );

    if (base64Encode(signature) !== parts[1]) {
      return null;
    }

    const payload = JSON.parse(
      new TextDecoder().decode(
        base64Decode(parts[0])
      )
    );

    if (
      !payload.exp ||
      Date.now() >= Number(payload.exp)
    ) {
      return null;
    }

    return payload;

  } catch {
    return null;
  }
}

async function getCustomer(request, env) {

  const authorization =
    request.headers.get("Authorization") || "";

  if (!authorization.startsWith("Bearer ")) {
    return null;
  }

  const token =
    authorization.slice(7).trim();

  const payload =
    await verifyToken(
      token,
      env.SESSION_SECRET
    );

  if (!payload?.id) {
    return null;
  }

  return await env.DB.prepare(`
    SELECT
      id,
      first_name,
      last_name,
      email,
      phone
    FROM customers
    WHERE id = ?
    LIMIT 1
  `)
    .bind(payload.id)
    .first();
}

/* MD5 */

function md5(input) {

  const S = [
    7,12,17,22,
    7,12,17,22,
    7,12,17,22,
    7,12,17,22,

    5,9,14,20,
    5,9,14,20,
    5,9,14,20,
    5,9,14,20,

    4,11,16,23,
    4,11,16,23,
    4,11,16,23,
    4,11,16,23,

    6,10,15,21,
    6,10,15,21,
    6,10,15,21,
    6,10,15,21
  ];

  const K = [
    0xd76aa478,0xe8c7b756,0x242070db,0xc1bdceee,
    0xf57c0faf,0x4787c62a,0xa8304613,0xfd469501,
    0x698098d8,0x8b44f7af,0xffff5bb1,0x895cd7be,
    0x6b901122,0xfd987193,0xa679438e,0x49b40821,
    0xf61e2562,0xc040b340,0x265e5a51,0xe9b6c7aa,
    0xd62f105d,0x02441453,0xd8a1e681,0xe7d3fbc8,
    0x21e1cde6,0xc33707d6,0xf4d50d87,0x455a14ed,
    0xa9e3e905,0xfcefa3f8,0x676f02d9,0x8d2a4c8a,
    0xfffa3942,0x8771f681,0x6d9d6122,0xfde5380c,
    0xa4beea44,0x4bdecfa9,0xf6bb4b60,0xbebfbc70,
    0x289b7ec6,0xeaa127fa,0xd4ef3085,0x04881d05,
    0xd9d4d039,0xe6db99e5,0x1fa27cf8,0xc4ac5665,
    0xf4292244,0x432aff97,0xab9423a7,0xfc93a039,
    0x655b59c3,0x8f0ccc92,0xffeff47d,0x85845dd1,
    0x6fa87e4f,0xfe2ce6e0,0xa3014314,0x4e0811a1,
    0xf7537e82,0xbd3af235,0x2ad7d2bb,0xeb86d391
  ];

  const bytes =
    Array.from(
      new TextEncoder().encode(input)
    );

  const originalLength = bytes.length;

  bytes.push(0x80);

  while (bytes.length % 64 !== 56) {
    bytes.push(0);
  }

  const bitLength =
    originalLength * 8;

  for (let i = 0; i < 8; i++) {
    bytes.push(
      Math.floor(
        bitLength /
        Math.pow(2, i * 8)
      ) & 255
    );
  }

  let A = 0x67452301;
  let B = 0xefcdab89;
  let C = 0x98badcfe;
  let D = 0x10325476;

  const add32 = (a, b) =>
    (a + b) | 0;

  const rotateLeft = (x, n) =>
    (x << n) |
    (x >>> (32 - n));

  for (
    let offset = 0;
    offset < bytes.length;
    offset += 64
  ) {

    const M = [];

    for (let i = 0; i < 16; i++) {

      const j =
        offset + i * 4;

      M[i] =
        bytes[j] |
        (bytes[j + 1] << 8) |
        (bytes[j + 2] << 16) |
        (bytes[j + 3] << 24);
    }

    let a = A;
    let b = B;
    let c = C;
    let d = D;

    for (let i = 0; i < 64; i++) {

      let F;
      let g;

      if (i < 16) {

        F =
          (b & c) |
          (~b & d);

        g = i;

      } else if (i < 32) {

        F =
          (d & b) |
          (~d & c);

        g =
          (5 * i + 1) % 16;

      } else if (i < 48) {

        F =
          b ^ c ^ d;

        g =
          (3 * i + 5) % 16;

      } else {

        F =
          c ^ (b | ~d);

        g =
          (7 * i) % 16;
      }

      const oldD = d;

      d = c;
      c = b;

      const value =
        add32(
          add32(a, F),
          add32(M[g], K[i])
        );

      b =
        add32(
          b,
          rotateLeft(
            value,
            S[i]
          )
        );

      a = oldD;
    }

    A = add32(A, a);
    B = add32(B, b);
    C = add32(C, c);
    D = add32(D, d);
  }

  function toHex(value) {

    let result = "";

    for (let i = 0; i < 4; i++) {

      result +=
        ((value >> (i * 8)) & 255)
          .toString(16)
          .padStart(2, "0");
    }

    return result;
  }

  return (
    toHex(A) +
    toHex(B) +
    toHex(C) +
    toHex(D)
  ).toUpperCase();
}

/* CREATE CHECKOUT */

async function createCheckout(request, env) {

  const customer =
    await getCustomer(
      request,
      env
    );

  if (!customer) {
    throw Error(
      "Please login first."
    );
  }

  if (!customer.email) {
    throw Error(
      "Please add your email address first."
    );
  }

  const plan =
    await env.DB.prepare(`
      SELECT
        id,
        name,
        price_lkr,
        duration_days
      FROM premium_plans
      WHERE active = 1
      ORDER BY id DESC
      LIMIT 1
    `)
      .first();

  if (!plan) {
    throw Error(
      "Premium plan not found."
    );
  }

  const amount =
    Number(plan.price_lkr)
      .toFixed(2);

  const orderId =
    "PREM-" +
    Date.now() +
    "-" +
    crypto.randomUUID()
      .replace(/-/g, "")
      .slice(0, 8)
      .toUpperCase();

  /*
    Your existing table requires
    user_id, so both IDs are inserted.
  */

  await env.DB.prepare(`
    INSERT INTO premium_orders
    (
      user_id,
      customer_id,
      plan_id,
      order_id,
      amount,
      currency,
      status,
      duration_days
    )
    VALUES
    (?, ?, ?, ?, ?, 'LKR', 'pending', ?)
  `)
    .bind(
      customer.id,
      customer.id,
      plan.id,
      orderId,
      amount,
      plan.duration_days
    )
    .run();

  const secretHash =
    md5(
      env.PAYHERE_MERCHANT_SECRET
    );

  const hash =
    md5(
      MERCHANT_ID +
      orderId +
      amount +
      "LKR" +
      secretHash
    );

  return {
    merchant_id:
      MERCHANT_ID,

    return_url:
      RETURN_URL,

    cancel_url:
      CANCEL_URL,

    notify_url:
      NOTIFY_URL,

    first_name:
      customer.first_name ||
      "Customer",

    last_name:
      customer.last_name ||
      "",

    email:
      customer.email,

    phone:
      customer.phone ||
      "",

    address:
      "Sri Lanka",

    city:
      "Kandy",

    country:
      "Sri Lanka",

    order_id:
      orderId,

    items:
      plan.name ||
      "CreateLK Academy Premium",

    currency:
      "LKR",

    amount:
      amount,

    hash:
      hash
  };
}

/* PAYHERE NOTIFY */

async function handleNotify(request, env) {

  const form =
    await request.formData();

  const merchantId =
    String(
      form.get("merchant_id") || ""
    );

  const orderId =
    String(
      form.get("order_id") || ""
    );

  const amount =
    String(
      form.get("payhere_amount") || ""
    );

  const currency =
    String(
      form.get("payhere_currency") || ""
    );

  const statusCode =
    String(
      form.get("status_code") || ""
    );

  const paymentId =
    String(
      form.get("payment_id") || ""
    );

  const receivedSignature =
    String(
      form.get("md5sig") || ""
    );

  if (
    merchantId !== MERCHANT_ID ||
    !orderId ||
    !amount ||
    !currency ||
    !statusCode ||
    !receivedSignature
  ) {
    return new Response(
      "Invalid notification",
      { status: 400 }
    );
  }

  const secretHash =
    md5(
      env.PAYHERE_MERCHANT_SECRET
    );

  const expectedSignature =
    md5(
      merchantId +
      orderId +
      amount +
      currency +
      statusCode +
      secretHash
    );

  if (
    expectedSignature.toUpperCase() !==
    receivedSignature.toUpperCase()
  ) {
    return new Response(
      "Invalid signature",
      { status: 400 }
    );
  }

  const order =
    await env.DB.prepare(`
      SELECT *
      FROM premium_orders
      WHERE order_id = ?
      LIMIT 1
    `)
      .bind(orderId)
      .first();

  if (!order) {
    return new Response(
      "Order not found",
      { status: 404 }
    );
  }

  if (
    Number(amount).toFixed(2) !==
    Number(order.amount).toFixed(2)
  ) {
    return new Response(
      "Amount mismatch",
      { status: 400 }
    );
  }

  if (currency !== "LKR") {
    return new Response(
      "Currency mismatch",
      { status: 400 }
    );
  }

  /* SUCCESS */

  if (statusCode === "2") {

    if (
      String(order.status).toLowerCase() ===
      "paid"
    ) {
      return new Response(
        "OK",
        { status: 200 }
      );
    }

    const duration =
      Number(
        order.duration_days || 30
      );

    const start =
      new Date();

    const expires =
      new Date(
        start.getTime() +
        duration * 86400000
      );

    const formatDate =
      date =>
        date.toISOString()
          .slice(0, 19)
          .replace("T", " ");

    /*
      Mark order paid.
    */

    await env.DB.prepare(`
      UPDATE premium_orders
      SET
        status = 'paid',
        payment_id = ?,
        paid_at = CURRENT_TIMESTAMP
      WHERE order_id = ?
    `)
      .bind(
        paymentId,
        orderId
      )
      .run();

    /*
      Expire previous subscription.
    */

    await env.DB.prepare(`
      UPDATE premium_subscriptions
      SET status = 'EXPIRED'
      WHERE
        customer_id = ?
        AND grade = 'spoken-english'
        AND status = 'ACTIVE'
    `)
      .bind(
        order.customer_id ||
        order.user_id
      )
      .run();

    /*
      Create new subscription.
    */

    await env.DB.prepare(`
      INSERT INTO premium_subscriptions
      (
        customer_id,
        grade,
        status,
        order_id,
        payment_id,
        amount,
        currency,
        starts_at,
        expires_at
      )
      VALUES
      (
        ?,
        'spoken-english',
        'ACTIVE',
        ?,
        ?,
        ?,
        'LKR',
        ?,
        ?
      )
    `)
      .bind(
        order.customer_id ||
        order.user_id,
        orderId,
        paymentId,
        order.amount,
        formatDate(start),
        formatDate(expires)
      )
      .run();

    return new Response(
      "OK",
      { status: 200 }
    );
  }

  /* PENDING */

  if (statusCode === "0") {

    await env.DB.prepare(`
      UPDATE premium_orders
      SET
        status = 'pending',
        payment_id = ?
      WHERE order_id = ?
    `)
      .bind(
        paymentId,
        orderId
      )
      .run();

    return new Response(
      "OK",
      { status: 200 }
    );
  }

  /* FAILED / CANCELLED / OTHER */

  await env.DB.prepare(`
    UPDATE premium_orders
    SET
      status = 'failed',
      payment_id = ?
    WHERE order_id = ?
  `)
    .bind(
      paymentId,
      orderId
    )
    .run();

  return new Response(
    "OK",
    { status: 200 }
  );
}

/* WORKER */

export default {

  async fetch(request, env) {

    if (
      request.method === "OPTIONS"
    ) {
      return new Response(
        null,
        {
          status: 204,
          headers: CORS
        }
      );
    }

    const url =
      new URL(request.url);

    const path =
      url.pathname.replace(
        /\/$/,
        ""
      );

    try {

      /* HEALTH */

      if (
        path === "" ||
        path === "/"
      ) {
        return json({
          success: true,
          service:
            "CreateLK PayHere Worker",
          status:
            "online",
          price:
            999,
          duration_days:
            30,
          notify:
            "/notify"
        });
      }

      /* CHECKOUT */

      if (
        path === "/premium-checkout" &&
        request.method === "POST"
      ) {

        const fields =
          await createCheckout(
            request,
            env
          );

        return json({
          success: true,
          fields
        });
      }

      /* NOTIFY */

      if (
        path === "/notify" &&
        request.method === "POST"
      ) {

        return await handleNotify(
          request,
          env
        );
      }

      return json(
        {
          success: false,
          error:
            "Route not found."
        },
        404
      );

    } catch (error) {

      console.error(
        "Worker error:",
        error
      );

      return json(
        {
          success: false,
          error:
            error.message ||
            "Internal server error."
        },
        500
      );
    }
  }
};