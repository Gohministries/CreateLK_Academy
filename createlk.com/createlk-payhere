const MERCHANT_ID = "257692";
const RETURN_URL = "https://createlk.com/Aca/dashboard.html?premium=success";
const CANCEL_URL = "https://createlk.com/Aca/dashboard.html?premium=cancelled";
const NOTIFY_URL = "https://createlk-payhere.createlk.workers.dev/notify";

const CORS = {
  "Access-Control-Allow-Origin": "https://createlk.com",
  "Access-Control-Allow-Methods": "GET,POST,OPTIONS",
  "Access-Control-Allow-Headers": "Content-Type,Authorization"
};

const json = (data, status = 200) =>
  new Response(JSON.stringify(data), {
    status,
    headers: {
      ...CORS,
      "Content-Type": "application/json"
    }
  });

function b64(data) {
  return btoa(String.fromCharCode(...new Uint8Array(data)))
    .replace(/\+/g, "-")
    .replace(/\//g, "_")
    .replace(/=+$/, "");
}

function unb64(v) {
  v = v.replace(/-/g, "+").replace(/_/g, "/");
  while (v.length % 4) v += "=";

  const b = atob(v);
  const a = new Uint8Array(b.length);

  for (let i = 0; i < b.length; i++) {
    a[i] = b.charCodeAt(i);
  }

  return a;
}

async function verifyToken(token, secret) {
  try {
    if (!token || !secret) return null;

    const p = token.split(".");
    if (p.length !== 2) return null;

    const key = await crypto.subtle.importKey(
      "raw",
      new TextEncoder().encode(secret),
      { name: "HMAC", hash: "SHA-256" },
      false,
      ["sign"]
    );

    const sig = await crypto.subtle.sign(
      "HMAC",
      key,
      new TextEncoder().encode(p[0])
    );

    if (b64(sig) !== p[1]) return null;

    const payload = JSON.parse(
      new TextDecoder().decode(unb64(p[0]))
    );

    if (payload.exp) {
      let exp = Number(payload.exp);

      if (exp < 100000000000) {
        exp *= 1000;
      }

      if (Date.now() >= exp) return null;
    }

    return payload;

  } catch {
    return null;
  }
}

async function getCustomer(request, env) {
  const auth = request.headers.get("Authorization") || "";

  if (!auth.startsWith("Bearer ")) return null;

  const payload = await verifyToken(
    auth.slice(7).trim(),
    env.SESSION_SECRET
  );

  if (!payload?.id) return null;

  return env.DB.prepare(`
    SELECT id, first_name, last_name, email, phone
    FROM customers
    WHERE id = ?
    LIMIT 1
  `)
    .bind(payload.id)
    .first();
}

function md5(input) {
  const S = [
    7,12,17,22,7,12,17,22,7,12,17,22,7,12,17,22,
    5,9,14,20,5,9,14,20,5,9,14,20,5,9,14,20,
    4,11,16,23,4,11,16,23,4,11,16,23,4,11,16,23,
    6,10,15,21,6,10,15,21,6,10,15,21,6,10,15,21
  ];

  const K = [
    0xd76aa478,0xe8c7b756,0x242070db,0xc1bdceee,
    0xf57c0faf,0x4787c62a,0xa8304613,0xfd469501,
    0x698098d8,0x8b44f7af,0xffff5bb1,0x895cd7be,
    0x6b901122,0xfd987193,0xa679438e,0x49b40821,
    0xf61e2562,0xc040b340,0x265e5a51,0xe9b6c7aa,
    0xd62f105d,0x02441453,0xd8a1e681,0xe7d3fbc8,
    0x21e1cde6,0xc33707d6,0xf4d50d87,0x455a14ed,
    0xa9e3e905,0xfcefa3f8,0x676f02d9,0x8d2a4c8a,
    0xfffa3942,0x8771f681,0x6d9d6122,0xfde5380c,
    0xa4beea44,0x4bdecfa9,0xf6bb4b60,0xbebfbc70,
    0x289b7ec6,0xeaa127fa,0xd4ef3085,0x04881d05,
    0xd9d4d039,0xe6db99e5,0x1fa27cf8,0xc4ac5665,
    0xf4292244,0x432aff97,0xab9423a7,0xfc93a039,
    0x655b59c3,0x8f0ccc92,0xffeff47d,0x85845dd1,
    0x6fa87e4f,0xfe2ce6e0,0xa3014314,0x4e0811a1,
    0xf7537e82,0xbd3af235,0x2ad7d2bb,0xeb86d391
  ];

  const bytes = Array.from(
    new TextEncoder().encode(input)
  );

  const len = bytes.length;

  bytes.push(0x80);

  while (bytes.length % 64 !== 56) {
    bytes.push(0);
  }

  const bits = len * 8;

  for (let i = 0; i < 8; i++) {
    bytes.push(
      Math.floor(bits / Math.pow(2, i * 8)) & 255
    );
  }

  let A = 0x67452301;
  let B = 0xefcdab89;
  let C = 0x98badcfe;
  let D = 0x10325476;

  const add = (a, b) => (a + b) | 0;
  const rot = (x, n) =>
    (x << n) | (x >>> (32 - n));

  for (let off = 0; off < bytes.length; off += 64) {
    const M = [];

    for (let i = 0; i < 16; i++) {
      const j = off + i * 4;

      M[i] =
        bytes[j] |
        (bytes[j + 1] << 8) |
        (bytes[j + 2] << 16) |
        (bytes[j + 3] << 24);
    }

    let a = A;
    let b = B;
    let c = C;
    let d = D;

    for (let i = 0; i < 64; i++) {
      let F, g;

      if (i < 16) {
        F = (b & c) | (~b & d);
        g = i;
      } else if (i < 32) {
        F = (d & b) | (~d & c);
        g = (5 * i + 1) % 16;
      } else if (i < 48) {
        F = b ^ c ^ d;
        g = (3 * i + 5) % 16;
      } else {
        F = c ^ (b | ~d);
        g = (7 * i) % 16;
      }

      const oldD = d;

      d = c;
      c = b;

      b = add(
        b,
        rot(
          add(
            add(a, F),
            add(M[g], K[i])
          ),
          S[i]
        )
      );

      a = oldD;
    }

    A = add(A, a);
    B = add(B, b);
    C = add(C, c);
    D = add(D, d);
  }

  const hex = v => {
    let r = "";

    for (let i = 0; i < 4; i++) {
      r += ((v >> (i * 8)) & 255)
        .toString(16)
        .padStart(2, "0");
    }

    return r;
  };

  return (
    hex(A) +
    hex(B) +
    hex(C) +
    hex(D)
  ).toUpperCase();
}

async function createCheckout(request, env) {
  const customer = await getCustomer(request, env);

  if (!customer) {
    throw Error("Please login first.");
  }

  if (!customer.email) {
    throw Error("Please add your email address first.");
  }

  const plan = await env.DB.prepare(`
    SELECT id, name, price_lkr, duration_days
    FROM premium_plans
    WHERE active = 1
    ORDER BY id DESC
    LIMIT 1
  `).first();

  if (!plan) {
    throw Error("Premium plan not found.");
  }

  const amount = Number(plan.price_lkr).toFixed(2);
  const duration = Number(plan.duration_days || 30);

  const orderId =
    "PREM-" +
    Date.now() +
    "-" +
    crypto.randomUUID()
      .replace(/-/g, "")
      .slice(0, 8)
      .toUpperCase();

  await env.DB.prepare(`
    INSERT INTO premium_orders
    (
      user_id,
      customer_id,
      plan_id,
      order_id,
      amount,
      currency,
      status,
      duration_days
    )
    VALUES (?, ?, ?, ?, ?, 'LKR', 'pending', ?)
  `)
    .bind(
      customer.id,
      customer.id,
      plan.id,
      orderId,
      amount,
      duration
    )
    .run();

  const secretHash = md5(
    env.PAYHERE_MERCHANT_SECRET
  );

  const hash = md5(
    MERCHANT_ID +
    orderId +
    amount +
    "LKR" +
    secretHash
  );

  return {
    merchant_id: MERCHANT_ID,
    return_url: RETURN_URL,
    cancel_url: CANCEL_URL,
    notify_url: NOTIFY_URL,

    first_name: customer.first_name || "Customer",
    last_name: customer.last_name || "",
    email: customer.email,
    phone: customer.phone || "",

    address: "Sri Lanka",
    city: "Kandy",
    country: "Sri Lanka",

    order_id: orderId,
    items: plan.name || "CreateLK Academy Premium",
    currency: "LKR",
    amount,
    hash
  };
}

async function handleNotify(request, env) {
  const form = await request.formData();

  const merchantId =
    String(form.get("merchant_id") || "");

  const orderId =
    String(form.get("order_id") || "");

  const amount =
    String(form.get("payhere_amount") || "");

  const currency =
    String(form.get("payhere_currency") || "");

  const statusCode =
    String(form.get("status_code") || "");

  const paymentId =
    String(form.get("payment_id") || "");

  const signature =
    String(form.get("md5sig") || "");

  if (
    merchantId !== MERCHANT_ID ||
    !orderId ||
    !amount ||
    !currency ||
    !statusCode ||
    !signature
  ) {
    return new Response(
      "Invalid notification",
      { status: 400 }
    );
  }

  const secretHash = md5(
    env.PAYHERE_MERCHANT_SECRET
  );

  const expected = md5(
    merchantId +
    orderId +
    amount +
    currency +
    statusCode +
    secretHash
  );

  if (
    expected.toUpperCase() !==
    signature.toUpperCase()
  ) {
    return new Response(
      "Invalid signature",
      { status: 400 }
    );
  }

  const order = await env.DB.prepare(`
    SELECT
      id,
      user_id,
      customer_id,
      amount,
      duration_days
    FROM premium_orders
    WHERE order_id = ?
    LIMIT 1
  `)
    .bind(orderId)
    .first();

  if (!order) {
    return new Response(
      "Order not found",
      { status: 404 }
    );
  }

  if (
    Number(amount).toFixed(2) !==
    Number(order.amount).toFixed(2)
  ) {
    return new Response(
      "Amount mismatch",
      { status: 400 }
    );
  }

  if (
    currency.toUpperCase() !== "LKR"
  ) {
    return new Response(
      "Currency mismatch",
      { status: 400 }
    );
  }

  if (statusCode === "2") {
    const customerId =
      order.customer_id || order.user_id;

    if (!customerId) {
      return new Response(
        "Customer ID not found",
        { status: 500 }
      );
    }

    const existing =
      await env.DB.prepare(`
        SELECT id
        FROM premium_subscriptions
        WHERE order_id = ?
        LIMIT 1
      `)
        .bind(orderId)
        .first();

    if (existing) {
      await env.DB.prepare(`
        UPDATE premium_orders
        SET status = 'paid',
            payment_id = ?
        WHERE id = ?
      `)
        .bind(paymentId, order.id)
        .run();

      return new Response("OK");
    }

    const start = new Date();

    const expires = new Date(
      start.getTime() +
      Number(order.duration_days || 30) *
      86400000
    );

    const date = d =>
      d.toISOString()
        .slice(0, 19)
        .replace("T", " ");

    await env.DB.prepare(`
      UPDATE premium_subscriptions
      SET status = 'EXPIRED'
      WHERE customer_id = ?
      AND LOWER(
        REPLACE(TRIM(grade), '-', ' ')
      ) = 'spoken english'
      AND UPPER(TRIM(status)) = 'ACTIVE'
    `)
      .bind(customerId)
      .run();

    await env.DB.prepare(`
      UPDATE premium_orders
      SET status = 'paid',
          payment_id = ?
      WHERE id = ?
    `)
      .bind(paymentId, order.id)
      .run();

    await env.DB.prepare(`
      INSERT INTO premium_subscriptions
      (
        customer_id,
        grade,
        status,
        order_id,
        payment_id,
        amount,
        currency,
        starts_at,
        expires_at
      )
      VALUES (
        ?,
        'spoken-english',
        'ACTIVE',
        ?,
        ?,
        ?,
        'LKR',
        ?,
        ?
      )
    `)
      .bind(
        customerId,
        orderId,
        paymentId,
        Number(order.amount),
        date(start),
        date(expires)
      )
      .run();

    return new Response("OK");
  }

  if (statusCode === "0") {
    await env.DB.prepare(`
      UPDATE premium_orders
      SET status = 'pending',
          payment_id = ?
      WHERE id = ?
    `)
      .bind(paymentId, order.id)
      .run();

    return new Response("OK");
  }

  await env.DB.prepare(`
    UPDATE premium_orders
    SET status = 'failed',
        payment_id = ?
    WHERE id = ?
  `)
    .bind(paymentId, order.id)
    .run();

  return new Response("OK");
}

export default {
  async fetch(request, env) {

    if (request.method === "OPTIONS") {
      return new Response(null, {
        status: 204,
        headers: CORS
      });
    }

    const path =
      new URL(request.url)
        .pathname
        .replace(/\/$/, "");

    try {

      if (
        (path === "" || path === "/") &&
        request.method === "GET"
      ) {
        return json({
          success: true,
          service: "CreateLK PayHere Worker",
          status: "online",
          price: 999,
          duration_days: 30,
          notify: "/notify"
        });
      }

      if (
        path === "/premium-checkout" &&
        request.method === "POST"
      ) {
        return json({
          success: true,
          fields:
            await createCheckout(request, env)
        });
      }

      if (
        path === "/notify" &&
        request.method === "POST"
      ) {
        return await handleNotify(
          request,
          env
        );
      }

      return json({
        success: false,
        error: "Route not found."
      }, 404);

    } catch (error) {

      console.error(
        "PayHere Worker Error:",
        error
      );

      return json({
        success: false,
        error:
          error.message ||
          "Internal server error."
      }, 500);
    }
  }
};