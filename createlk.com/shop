    <div class="info-card">
      <div class="info-icon">🔐</div>
      <h3>Your Account</h3>
      <p>
        Your purchases are linked to your personal CreateLK account.
      </p>
    </div>

  </section>

</main>

<footer>

  <div class="footer-inner">

    <div class="footer-grid">

      <div>
        <div class="footer-brand">
          <img src="https://assets.createlk.com/file_000000003e448207b8c6a7ecc4a7e1d4.png"
               alt="CreateLK">
          <span>CreateLK Digital Shop</span>
        </div>

        <p>
          Digital educational resources for learners.
          Buy once and access your purchased resources online.
        </p>
      </div>

      <div>
        <h4>Shop</h4>
        <div class="footer-links">
          <a href="shop.html">All Resources</a>
          <a href="account.html">My Purchases</a>
          <a href="login.html">Login</a>
          <a href="register.html">Register</a>
        </div>
      </div>

      <div>
        <h4>Information</h4>
        <div class="footer-links">
          <a href="terms.html">Terms of Use</a>
          <a href="privacy.html">Privacy Policy</a>
          <a href="refund.html">Refund Policy</a>
          <a href="contact.html">Contact</a>
