<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#07164d">

<title>CreateLK Digital Shop | Educational Resources</title>

<meta name="description"
content="CreateLK Digital Shop – Buy educational digital resources once and access them online anytime.">

<link rel="icon"
href="https://assets.createlk.com/file_000000003e448207b8c6a7ecc4a7e1d4.png">

<style>
*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

:root{
  --navy:#07164d;
  --blue:#087ff5;
  --cyan:#11c5f7;
  --purple:#843cff;
  --pink:#f2188f;
  --gold:#ffb300;
  --bg:#f5f8ff;
  --text:#101828;
  --muted:#667085;
  --white:#fff;
  --border:#e5e7eb;
  --shadow:0 12px 35px rgba(7,22,77,.10);
}

body{
  font-family:Arial,Helvetica,sans-serif;
  background:var(--bg);
  color:var(--text);
  line-height:1.5;
}

a{
  text-decoration:none;
  color:inherit;
}

button,
input,
select{
  font:inherit;
}

/* HEADER */

header{
  background:var(--navy);
  position:sticky;
  top:0;
  z-index:1000;
  box-shadow:0 5px 20px rgba(0,0,0,.15);
}

.nav{
  max-width:1200px;
  margin:auto;
  min-height:76px;
  padding:10px 20px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:20px;
}

.logo{
  display:flex;
  align-items:center;
  gap:10px;
  color:white;
  font-weight:800;
  font-size:20px;
}

.logo img{
  width:48px;
  height:48px;
  object-fit:contain;
  background:white;
  border-radius:12px;
  padding:4px;
}

.nav-links{
  display:flex;
  align-items:center;
  gap:8px;
}

.nav-links a{
  color:#fff;
  padding:10px 14px;
  border-radius:10px;
  font-weight:600;
}

.nav-links a:hover,
.nav-links a.active{
  background:rgba(255,255,255,.14);
}

.account-btn{
  background:linear-gradient(135deg,var(--cyan),var(--blue));
  color:white!important;
}

/* HERO */

.hero{
  background:
    radial-gradient(circle at 15% 20%,rgba(17,197,247,.25),transparent 28%),
    radial-gradient(circle at 85% 20%,rgba(242,24,143,.22),transparent 28%),
    linear-gradient(135deg,#07164d,#123b91 55%,#5d27c9);
  color:white;
  padding:65px 20px;
}

.hero-inner{
  max-width:1200px;
  margin:auto;
  text-align:center;
}

.hero-badge{
  display:inline-block;
  padding:8px 16px;
  border-radius:50px;
  background:rgba(255,255,255,.13);
  border:1px solid rgba(255,255,255,.25);
  font-weight:700;
  margin-bottom:18px;
}

.hero h1{
  font-size:clamp(34px,6vw,58px);
  line-height:1.05;
  margin-bottom:18px;
}

.gradient-text{
  background:linear-gradient(90deg,#11c5f7,#fff,#ff72c0);
  -webkit-background-clip:text;
  background-clip:text;
  color:transparent;
}

.hero p{
  max-width:720px;
  margin:auto;
  color:#e5edff;
  font-size:18px;
}

.hero-features{
  margin-top:28px;
  display:flex;
  justify-content:center;
  flex-wrap:wrap;
  gap:10px;
}

.hero-features span{
  background:rgba(255,255,255,.12);
  border:1px solid rgba(255,255,255,.2);
  padding:9px 15px;
  border-radius:50px;
}

/* MAIN */

main{
  max-width:1200px;
  margin:auto;
  padding:35px 20px 70px;
}

/* SEARCH */

.controls{
  background:white;
  padding:18px;
  border-radius:18px;
  box-shadow:var(--shadow);
  display:grid;
  grid-template-columns:1fr 220px;
  gap:12px;
  margin-top:-65px;
  position:relative;
}

.search-box{
  position:relative;
}

.search-box input{
  width:100%;
  border:2px solid var(--border);
  border-radius:13px;
  padding:14px 16px 14px 44px;
  outline:none;
  transition:.2s;
}

.search-box input:focus{
  border-color:var(--blue);
}

.search-icon{
  position:absolute;
  left:15px;
  top:50%;
  transform:translateY(-50%);
  color:var(--muted);
}

select{
  width:100%;
  border:2px solid var(--border);
  border-radius:13px;
  padding:14px;
  background:white;
  outline:none;
}

/* SECTION */

.section-head{
  display:flex;
  align-items:end;
  justify-content:space-between;
  gap:15px;
  margin:45px 0 20px;
}

.section-head h2{
  font-size:30px;
  color:var(--navy);
}

.section-head p{
  color:var(--muted);
}

/* PRODUCTS */

.products{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:20px;
}

.product{
  background:white;
  border-radius:20px;
  overflow:hidden;
  border:1px solid #edf0f5;
  box-shadow:0 8px 25px rgba(7,22,77,.07);
  transition:.25s;
  display:flex;
  flex-direction:column;
}

.product:hover{
  transform:translateY(-5px);
  box-shadow:0 18px 40px rgba(7,22,77,.13);
}

.product-image{
  height:190px;
  background:linear-gradient(135deg,#e9f6ff,#eee8ff);
  display:flex;
  align-items:center;
  justify-content:center;
  overflow:hidden;
}

.product-image img{
  width:100%;
  height:100%;
  object-fit:cover;
}

.product-placeholder{
  font-size:55px;
}

.product-body{
  padding:18px;
  display:flex;
  flex-direction:column;
  flex:1;
}

.subject{
  display:inline-block;
  width:max-content;
  padding:5px 10px;
  border-radius:50px;
  background:#eaf3ff;
  color:var(--blue);
  font-size:12px;
  font-weight:800;
  margin-bottom:10px;
}

.product h3{
  color:var(--navy);
  font-size:19px;
  margin-bottom:8px;
}

.product-description{
  color:var(--muted);
  font-size:14px;
  margin-bottom:16px;
  flex:1;
}

.product-bottom{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
}

.price{
  font-size:20px;
  font-weight:900;
  color:var(--pink);
}

.buy-btn{
  border:0;
  cursor:pointer;
  padding:10px 15px;
  border-radius:10px;
  color:white;
  font-weight:800;
  background:linear-gradient(135deg,var(--purple),var(--blue));
  transition:.2s;
}

.buy-btn:hover{
  transform:scale(1.03);
}

/* EMPTY / LOADING */

.status{
  grid-column:1/-1;
  background:white;
  border-radius:18px;
  padding:45px 20px;
  text-align:center;
  color:var(--muted);
  box-shadow:var(--shadow);
}

.loader{
  width:38px;
  height:38px;
  border:4px solid #e5e7eb;
  border-top-color:var(--blue);
  border-radius:50%;
  animation:spin .8s linear infinite;
  margin:0 auto 15px;
}

@keyframes spin{
  to{transform:rotate(360deg)}
}

/* INFO */

.info{
  margin-top:55px;
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:18px;
}

.info-card{
  background:white;
  border-radius:18px;
  padding:25px;
  text-align:center;
  box-shadow:var(--shadow);
}

.info-icon{
  font-size:35px;
  margin-bottom:10px;
}

.info-card h3{
  color:var(--navy);
  margin-bottom:6px;
}

.info-card p{
  color:var(--muted);
  font-size:14px;
}

/* LOGIN NOTICE */

.login-notice{
  display:none;
  margin-top:25px;
  padding:16px 18px;
  border-radius:14px;
  background:#fff8e6;
  border:1px solid #ffd76a;
  color:#7a5200;
  text-align:center;
}

.login-notice a{
  color:var(--blue);
  font-weight:800;
}

/* FOOTER */

footer{
  background:var(--navy);
  color:#dbe5ff;
  padding:45px 20px 25px;
}

.footer-inner{
  max-width:1200px;
  margin:auto;
}

.footer-grid{
  display:grid;
  grid-template-columns:2fr 1fr 1fr;
  gap:35px;
}

.footer-brand{
  display:flex;
  align-items:center;
  gap:10px;
  color:white;
  font-size:20px;
  font-weight:800;
  margin-bottom:12px;
}

.footer-brand img{
  width:42px;
  height:42px;
  object-fit:contain;
  background:white;
  border-radius:10px;
  padding:4px;
}

footer p{
  color:#aebde0;
  font-size:14px;
}

footer h4{
  color:white;
  margin-bottom:12px;
}

.footer-links{
  display:flex;
  flex-direction:column;
  gap:8px;
}

.footer-links a:hover{
  color:white;
}

.copyright{
  border-top:1px solid rgba(255,255,255,.12);
  margin-top:30px;
  padding-top:20px;
  text-align:center;
  color:#91a4d0;
  font-size:13px;
}

/* MOBILE */

@media(max-width:1000px){
  .products{
    grid-template-columns:repeat(2,1fr);
  }
}

@media(max-width:700px){

  .nav{
    min-height:68px;
    padding:8px 14px;
  }

  .logo span{
    display:none;
  }

  .nav-links a{
    padding:8px 9px;
    font-size:13px;
  }

  .controls{
    grid-template-columns:1fr;
    margin-top:-45px;
  }

  .hero{
    padding:50px 18px;
  }

  .hero p{
    font-size:16px;
  }

  .section-head{
    display:block;
  }

  .section-head h2{
    font-size:25px;
    margin-bottom:5px;
  }

  .products{
    grid-template-columns:1fr;
  }

  .info{
    grid-template-columns:1fr;
  }

  .footer-grid{
    grid-template-columns:1fr;
  }
}
</style>
</head>

<body>

<header>
  <nav class="nav">

    <a href="home.html" class="logo">
      <img src="https://assets.createlk.com/file_000000003e448207b8c6a7ecc4a7e1d4.png"
           alt="CreateLK">
      <span>CreateLK Digital Shop</span>
    </a>

    <div class="nav-links">
      <a href="home.html">Home</a>
      <a href="shop.html" class="active">Shop</a>
      <a href="account.html" class="account-btn">My Account</a>
    </div>

  </nav>
</header>

<section class="hero">

  <div class="hero-inner">

    <div class="hero-badge">📚 Digital Learning Resources</div>

    <h1>
      Learn More.<br>
      <span class="gradient-text">Buy Once. Access Anytime.</span>
    </h1>

    <p>
      Explore educational resources from different subjects.
      Make a one-time payment and read your purchased resources online.
    </p>

    <div class="hero-features">
      <span>✓ One-Time Payment</span>
      <span>✓ Online Access</span>
      <span>✓ No Subscription</span>
      <span>✓ Multiple Subjects</span>
    </div>

  </div>

</section>

<main>

  <div class="controls">

    <div class="search-box">
