<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">

<meta name="theme-color" content="#176B5B">

<title>Shop | CreateLK Digital Learning Shop</title>

<meta name="description"
content="Browse digital educational resources from CreateLK Digital Learning Shop.">

<link rel="icon"
href="https://assets.createlk.com/file_000000003e448207b8c6a7ecc4a7e1d4.png">

<style>
*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

:root{
  --green:#176B5B;
  --green2:#16A085;
  --green3:#12806c;
  --light:#F5FAF8;
  --text:#17332e;
  --muted:#667873;
  --white:#fff;
  --border:#dfece8;
  --soft:#e4f6f1;
  --shadow:0 10px 30px rgba(23,107,91,.08);
}

html{
  scroll-behavior:smooth;
}

body{
  font-family:Arial,Helvetica,sans-serif;
  background:var(--light);
  color:var(--text);
  line-height:1.6;
}

a{
  text-decoration:none;
  color:inherit;
}

/* HEADER */

header{
  position:sticky;
  top:0;
  z-index:1000;
  background:rgba(255,255,255,.97);
  backdrop-filter:blur(12px);
  border-bottom:1px solid var(--border);
}

.nav{
  max-width:1200px;
  min-height:74px;
  margin:auto;
  padding:9px 20px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:20px;
}

.logo{
  display:flex;
  align-items:center;
  gap:11px;
}

.logo img{
  width:50px;
  height:50px;
  object-fit:cover;
  border-radius:12px;
}

.logo-title{
  color:var(--green);
  font-size:20px;
  font-weight:900;
}

.logo-sub{
  color:#71827e;
  font-size:9px;
  letter-spacing:1.8px;
  font-weight:700;
}

.nav-links{
  display:flex;
  align-items:center;
  gap:12px;
  font-size:14px;
  font-weight:700;
}

.nav-links a{
  padding:9px 13px;
}

.nav-links a:hover{
  color:var(--green2);
}

.home-btn{
  border:1px solid var(--border);
  border-radius:10px;
}

.account-btn{
  color:#fff!important;
  background:var(--green2);
  border-radius:10px;
}

.account-btn:hover{
  background:var(--green3)!important;
}

/* PAGE HERO */

.shop-hero{
  background:#176B5B;
  color:#fff;
  padding:55px 20px;
}

.shop-hero-inner{
  max-width:1200px;
  margin:auto;
  text-align:center;
}

.shop-hero h1{
  font-size:clamp(36px,5vw,54px);
  line-height:1.1;
  margin-bottom:12px;
  letter-spacing:-1px;
}

.shop-hero p{
  max-width:680px;
  margin:auto;
  color:#d7eee8;
  font-size:16px;
}

/* SHOP AREA */

.shop-section{
  max-width:1200px;
  margin:auto;
  padding:45px 20px 80px;
}

/* SEARCH */

.shop-tools{
  display:flex;
  gap:12px;
  margin-bottom:30px;
  align-items:center;
}

.search-box{
  flex:1;
  position:relative;
}

.search-box input{
  width:100%;
  height:50px;
  padding:0 18px 0 48px;
  border:1px solid var(--border);
  border-radius:12px;
  background:#fff;
  color:var(--text);
  font-size:14px;
  outline:none;
  box-shadow:0 5px 18px rgba(23,107,91,.04);
}

.search-box input:focus{
  border-color:#9bcfc2;
  box-shadow:0 0 0 3px rgba(22,160,133,.10);
}

.search-icon{
  position:absolute;
  left:17px;
  top:50%;
  transform:translateY(-50%);
  font-size:18px;
}

/* FILTER */

.filter{
  height:50px;
  min-width:190px;
  padding:0 14px;
  border:1px solid var(--border);
  border-radius:12px;
  background:#fff;
  color:var(--text);
  font-size:14px;
  outline:none;
  cursor:pointer;
}

.filter:focus{
  border-color:#9bcfc2;
}

/* RESULT */

.result-info{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:15px;
  margin-bottom:20px;
}

.result-info h2{
  color:var(--green);
  font-size:22px;
}

#count{
  color:var(--muted);
  font-size:13px;
}

/* PRODUCT GRID */

.product-grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:20px;
}

/* PRODUCT CARD */

.product{
  background:#fff;
  border:1px solid var(--border);
  border-radius:18px;
  overflow:hidden;
  box-shadow:0 7px 24px rgba(23,107,91,.05);
  transition:.2s;
  display:flex;
  flex-direction:column;
}

.product:hover{
  transform:translateY(-4px);
  box-shadow:var(--shadow);
  border-color:#b9ddd3;
}

.product-image{
  width:100%;
  aspect-ratio:4/3;
  background:#edf7f4;
  display:flex;
  align-items:center;
  justify-content:center;
  overflow:hidden;
}

.product-image img{
  width:100%;
  height:100%;
  object-fit:cover;
}

.product-placeholder{
  color:var(--green);
  font-size:45px;
}

.product-content{
  padding:19px;
  display:flex;
  flex-direction:column;
  flex:1;
}

.subject-tag{
  display:inline-block;
  width:max-content;
  padding:5px 9px;
  border-radius:20px;
  background:var(--soft);
  color:var(--green);
  font-size:10px;
  font-weight:800;
  text-transform:uppercase;
  margin-bottom:10px;
}

.product h3{
  color:var(--text);
  font-size:17px;
  line-height:1.35;
  margin-bottom:7px;
}

.product-description{
  color:var(--muted);
  font-size:12px;
  line-height:1.55;
  margin-bottom:15px;

  display:-webkit-box;
  -webkit-line-clamp:3;
  -webkit-box-orient:vertical;
  overflow:hidden;
}

.product-bottom{
  margin-top:auto;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
}

.price{
  color:var(--green);
  font-size:18px;
  font-weight:900;
  white-space:nowrap;
}

.view-btn{
  display:inline-block;
  padding:9px 13px;
  background:var(--green2);
  color:#fff;
  border-radius:9px;
  font-size:12px;
  font-weight:800;
}

.view-btn:hover{
  background:var(--green3);
}

/* STATES */

.state{
  background:#fff;
  border:1px solid var(--border);
  border-radius:18px;
  padding:55px 20px;
  text-align:center;
}

.state-icon{
  font-size:42px;
  margin-bottom:10px;
}

.state h3{
  color:var(--green);
  margin-bottom:6px;
}

.state p{
  color:var(--muted);
  font-size:14px;
}

.spinner{
  width:38px;
  height:38px;
  margin:0 auto 15px;
  border:4px solid #dceee9;
  border-top-color:var(--green2);
  border-radius:50%;
  animation:spin .8s linear infinite;
}

@keyframes spin{
  to{
    transform:rotate(360deg);
  }
}

/* FOOTER */

footer{
  background:#125246;
  color:#fff;
  padding:45px 20px 22px;
}

.footer{
  max-width:1200px;
  margin:auto;
  display:grid;
  grid-template-columns:1.5fr 1fr 1fr;
  gap:40px;
}

.footer-logo{
  display:flex;
  align-items:center;
  gap:10px;
  margin-bottom:13px;
}

.footer-logo img{
  width:48px;
  height:48px;
  border-radius:11px;
}

.footer strong{
  font-size:17px;
}

.footer small{
  color:#c4e1d9;
}

.footer h3{
  margin-bottom:12px;
  font-size:16px;
}

.footer p,
.footer a{
  color:#c6ddd8;
  font-size:13px;
}

.footer a{
  display:block;
  margin:7px 0;
}

.footer a:hover{
  color:#fff;
}

.copy{
  max-width:1200px;
  margin:30px auto 0;
  padding-top:18px;
  border-top:1px solid rgba(255,255,255,.15);
  text-align:center;
  color:#a9c9c0;
  font-size:12px;
}

/* MOBILE */

@media(max-width:950px){

  .product-grid{
    grid-template-columns:repeat(3,1fr);
  }

}

@media(max-width:700px){

  .nav-links a:not(.home-btn):not(.account-btn){
    display:none;
  }

  .shop-tools{
    flex-direction:column;
    align-items:stretch;
  }

  .filter{
    width:100%;
  }

  .product-grid{
    grid-template-columns:repeat(2,1fr);
  }

  .footer{
    grid-template-columns:1fr;
  }

}

@media(max-width:500px){

  .nav{
    padding:8px 13px;
  }

  .logo img{
    width:43px;
    height:43px;
  }

  .logo-title{
    font-size:16px;
  }

  .logo-sub{
    font-size:7px;
  }

  .account-btn{
    padding:9px 11px!important;
    font-size:12px;
  }

  .home-btn{
    padding:8px 10px!important;
    font-size:12px;
  }

  .shop-hero{
    padding:45px 15px;
  }

  .shop-hero h1{
    font-size:36px;
  }

  .shop-hero p{
    font-size:14px;
  }

  .shop-section{
    padding:30px 15px 60px;
  }

  .product-grid{
    grid-template-columns:1fr;
  }

  .product-image{
    aspect-ratio:16/10;
  }

  .result-info h2{
    font-size:19px;
  }
}
</style>
</head>

<body>

<!-- HEADER -->

<header>

<nav class="nav">

  <a href="/home" class="logo">

    <img
      src="https://assets.createlk.com/file_000000003e448207b8c6a7ecc4a7e1d4.png"
      alt="CreateLK">

    <div>

      <div class="logo-title">
        CreateLK
      </div>

      <div class="logo-sub">
        DIGITAL LEARNING SHOP
      </div>

    </div>

  </a>


  <div class="nav-links">

    <a href="/home" class="home-btn">
      Home
    </a>

    <a href="/account" class="account-btn">
      My Account
    </a>

  </div>

</nav>

</header>


<!-- SHOP HERO -->

<section class="shop-hero">

  <div class="shop-hero-inner">

    <h1>
      Explore Our Learning Resources
    </h1>

    <p>
      Find quality digital educational resources across
      different subjects. Pay once and access your
      purchased content online.
    </p>

  </div>

</section>


<!-- SHOP -->

<main class="shop-section">


  <!-- SEARCH + FILTER -->

  <div class="shop-tools">

    <div class="search-box">

      <span class="search-icon">
        🔎
      </span>

      <input
        type="search"
        id="search"
        placeholder="Search learning resources..."
        autocomplete="off">

    </div>


    <select id="subject" class="filter">

      <option value="">
        All Subjects
      </option>

      <option value="english">
        English
      </option>

      <option value="mathematics">
        Mathematics
      </option>

      <option value="science">
        Science
      </option>

      <option value="ict">
        ICT
      </option>

      <option value="history">
        History
      </option>

      <option value="geography">
        Geography
      </option>

      <option value="tamil">
        Tamil
      </option>

      <option value="sinhala">
        Sinhala
      </option>

      <option value="exam">
        Exam Preparation
      </option>

      <option value="practice">
        Practice
      </option>

    </select>

  </div>


  <!-- RESULT INFO -->

  <div class="result-info">

    <h2>
      Learning Resources
    </h2>

    <span id="count">
      Loading...
    </span>

  </div>


  <!-- PRODUCTS -->

  <div id="products" class="product-grid">

    <div class="state">

      <div class="spinner"></div>

      <h3>
        Loading Resources
      </h3>

      <p>
        Please wait while we load the available resources.
      </p>

    </div>

  </div>


</main>


<!-- FOOTER -->

<footer>

  <div class="footer">

    <div>

      <div class="footer-logo">

        <img
          src="https://assets.createlk.com/file_000000003e448207b8c6a7ecc4a7e1d4.png"
          alt="CreateLK">

        <div>

          <strong>
            CreateLK
          </strong>

          <br>

          <small>
            Digital Learning Shop
          </small>

        </div>

      </div>

      <p>
        Quality digital educational resources across multiple
        subjects, available with simple one-time payment.
      </p>

    </div>


    <div>

      <h3>
        Shop
      </h3>

      <a href="/shop">
        All Resources
      </a>

      <a href="/home#subjects">
        Subjects
      </a>

      <a href="/account">
        My Account
      </a>

    </div>


    <div>

      <h3>
        Information
      </h3>

      <a href="/terms">
        Terms & Conditions
      </a>

      <a href="/privacy">
        Privacy Policy
      </a>

      <a href="/refund">
        Refund Policy
      </a>

      <a href="/contact">
        Contact
      </a>

    </div>

  </div>


  <div class="copy">

    © <span id="year"></span>
    CreateLK Digital Learning Shop.
    All rights reserved.

  </div>

</footer>


<script>

/*
==================================================
CREATE LK SHOP API
==================================================

Replace ONLY the URL below with your actual
Cloudflare Worker API URL.

Expected endpoint:

GET /api/products

Example response:

[
  {
    "id":1,
    "title":"Spoken English Basics",
    "subject":"english",
    "description":"Learn useful English expressions.",
    "price":499,
    "currency":"LKR",
    "image_url":"https://...",
    "active":1
  }
]

or:

{
  "products":[ ... ]
}
*/

const API_BASE =
  "https://YOUR-CLOUDFLARE-WORKER.workers.dev";


const productsEl =
  document.getElementById("products");

const searchEl =
  document.getElementById("search");

const subjectEl =
  document.getElementById("subject");

const countEl =
  document.getElementById("count");


let allProducts = [];


/* LOAD PRODUCTS */

async function loadProducts(){

  try{

    const response =
      await fetch(
        API_BASE + "/api/products"
      );

    if(!response.ok){
      throw new Error(
        "HTTP " + response.status
      );
    }

    const data =
      await response.json();

    if(Array.isArray(data)){
      allProducts = data;
    }
    else if(
      data &&
      Array.isArray(data.products)
    ){
      allProducts = data.products;
    }
    else{
      allProducts = [];
    }

    allProducts =
      allProducts.filter(product => {

        return (
          product.active === undefined ||
          product.active === 1 ||
          product.active === true ||
          product.active === "1"
        );

      });

    renderProducts();

  }
  catch(error){

    console.error(
      "CreateLK Shop:",
      error
    );

    countEl.textContent = "";

    productsEl.innerHTML = `

      <div class="state">

        <div class="state-icon">
          ⚠️
        </div>

        <h3>
          Unable to Load Resources
        </h3>

        <p>
          Please try again later.
        </p>

      </div>

    `;

  }

}


/* FILTER PRODUCTS */

function getFilteredProducts(){

  const search =
    searchEl.value
      .trim()
      .toLowerCase();

  const subject =
    subjectEl.value
      .trim()
      .toLowerCase();


  return allProducts.filter(product => {

    const title =
      String(product.title || "")
        .toLowerCase();

    const description =
      String(product.description || "")
        .toLowerCase();

    const productSubject =
      String(product.subject || "")
        .toLowerCase();


    const matchesSearch =
      !search ||
      title.includes(search) ||
      description.includes(search) ||
      productSubject.includes(search);


    const matchesSubject =
      !subject ||
      productSubject === subject;


    return (
      matchesSearch &&
      matchesSubject
    );

  });

}


/* FORMAT PRICE */

function formatPrice(product){

  const price =
    Number(product.price || 0);

  const currency =
    String(
      product.currency || "LKR"
    ).toUpperCase();


  if(currency === "LKR"){

    return "LKR " +
      price.toLocaleString(
        "en-LK",
        {
          minimumFractionDigits:0,
          maximumFractionDigits:2
        }
      );

  }


  return currency + " " +
    price.toLocaleString(
      undefined,
      {
        minimumFractionDigits:0,
        maximumFractionDigits:2
      }
    );

}


/* ESCAPE HTML */

function escapeHTML(value){

  return String(value || "")
    .replace(/&/g,"&amp;")
    .replace(/</g,"&lt;")
    .replace(/>/g,"&gt;")
    .replace(/"/g,"&quot;")
    .replace(/'/g,"&#039;");

}


/* RENDER */

function renderProducts(){

  const products =
    getFilteredProducts();


  countEl.textContent =
    products.length +
    (
      products.length === 1
        ? " resource"
        : " resources"
    );


  if(!products.length){

    productsEl.innerHTML = `

      <div class="state">

        <div class="state-icon">
          🔍
        </div>

        <h3>
          No Resources Found
        </h3>

        <p>
          Try a different search or subject.
        </p>

      </div>

    `;

    return;

  }


  productsEl.innerHTML =
    products.map(product => {

      const id =
        encodeURIComponent(
          product.id
        );

      const title =
        escapeHTML(
          product.title
        );

      const description =
        escapeHTML(
          product.description
        );

      const subject =
        escapeHTML(
          product.subject || "Learning"
        );


      const image =
        product.image_url;


      return `

        <article class="product">

          <div class="product-image">

            ${
              image

              ?

              `
              <img
                src="${escapeHTML(image)}"
                alt="${title}"
                loading="lazy"
                onerror="this.style.display='none';this.parentElement.innerHTML='<div class=\\'product-placeholder\\'>📚</div>';">
              `

              :

              `
              <div class="product-placeholder">
                📚
              </div>
              `
            }

          </div>


          <div class="product-content">

            <span class="subject-tag">
              ${subject}
            </span>


            <h3>
              ${title}
            </h3>


            <p class="product-description">
              ${description}
            </p>


            <div class="product-bottom">

              <div class="price">
                ${formatPrice(product)}
              </div>


              <a
                href="/product?id=${id}"
                class="view-btn">

                View Resource

              </a>

            </div>

          </div>

        </article>

      `;

    }).join("");

}


/* SEARCH */

searchEl.addEventListener(
  "input",
  renderProducts
);


/* SUBJECT */

subjectEl.addEventListener(
  "change",
  function(){

    const params =
      new URLSearchParams(
        window.location.search
      );


    if(this.value){

      params.set(
        "subject",
        this.value
      );

    }
    else{

      params.delete(
        "subject"
      );

    }


    const query =
      params.toString();


    history.replaceState(
      {},
      "",
      "/shop" +
      (
        query
          ? "?" + query
          : ""
      )
    );


    renderProducts();

  }
);


/* READ SUBJECT FROM URL */

function loadSubjectFromURL(){

  const params =
    new URLSearchParams(
      window.location.search
    );

  const subject =
    params.get("subject");


  if(subject){

    subjectEl.value =
      subject.toLowerCase();

  }

}


/* YEAR */

document.getElementById("year").textContent =
  new Date().getFullYear();


/* START */

loadSubjectFromURL();

loadProducts();

</script>

</body>
</html>