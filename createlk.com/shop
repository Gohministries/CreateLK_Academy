*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

:root{
  --navy:#163A63;
  --navy-dark:#102E50;
  --blue:#2563EB;
  --blue-dark:#1D4ED8;
  --blue-light:#EFF6FF;
  --white:#FFFFFF;
  --soft:#F7F9FC;
  --heading:#172B3A;
  --text:#263238;
  --muted:#6B7785;
  --border:#E2E8F0;
  --shadow:0 8px 25px rgba(23,43,58,.07);
}

html{
  scroll-behavior:smooth;
}

body{
  font-family:Arial,Helvetica,sans-serif;
  background:#FFFFFF;
  color:var(--text);
  line-height:1.6;
}

a{
  text-decoration:none;
  color:inherit;
}


/* =========================
   HEADER
========================= */

header{
  position:sticky;
  top:0;
  z-index:1000;
  background:#FFFFFF;
  border-bottom:1px solid var(--border);
}

.nav{
  max-width:1200px;
  min-height:62px;
  margin:auto;
  padding:7px 20px;

  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:20px;
}

.logo{
  display:flex;
  align-items:center;
  gap:9px;
}

.logo img{
  width:38px;
  height:38px;
  border-radius:9px;
  object-fit:cover;
}

.logo-title{
  color:var(--navy);
  font-size:18px;
  font-weight:900;
  line-height:1.1;
}

.logo-sub{
  color:#7A8796;
  font-size:8px;
  font-weight:700;
  letter-spacing:1.3px;
}

.nav-links{
  display:flex;
  align-items:center;
  gap:6px;
  font-size:13px;
  font-weight:700;
}

.nav-links a{
  padding:8px 11px;
}

.nav-links a:hover{
  color:var(--blue);
}

.login{
  border:1px solid var(--border);
  border-radius:8px;
}

.shop-btn{
  background:var(--blue);
  color:#FFFFFF!important;
  border-radius:8px;
}

.shop-btn:hover{
  background:var(--blue-dark)!important;
}


/* =========================
   HERO
========================= */

.hero{
  background:#FFFFFF;
  padding:45px 20px 35px;
}

.hero-inner{
  max-width:1050px;
  margin:auto;

  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:35px;
}

.hero-text{
  max-width:650px;
}

.badge{
  display:inline-block;
  background:var(--blue-light);
  color:var(--blue);
  padding:6px 12px;
  border-radius:30px;
  font-size:11px;
  font-weight:800;
  margin-bottom:13px;
}

.hero h1{
  color:var(--heading);
  font-size:clamp(32px,5vw,47px);
  line-height:1.1;
  letter-spacing:-1.2px;
  margin-bottom:12px;
}

.hero h1 span{
  color:var(--blue);
}

.hero p{
  color:var(--muted);
  font-size:15px;
  max-width:620px;
}

.hero-box{
  min-width:180px;
  padding:23px;
  border:1px solid var(--border);
  border-radius:16px;
  background:#FFFFFF;
  box-shadow:var(--shadow);
  text-align:center;
}

.hero-box-icon{
  font-size:30px;
  margin-bottom:6px;
}

.hero-box strong{
  display:block;
  color:var(--heading);
  font-size:14px;
}

.hero-box span{
  color:var(--muted);
  font-size:11px;
}


/* =========================
   SHOP BAR
========================= */

.shop-tools{
  background:var(--soft);
  border-top:1px solid var(--border);
  border-bottom:1px solid var(--border);
  padding:16px 20px;
}

.shop-tools-inner{
  max-width:1050px;
  margin:auto;

  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:15px;
}

.shop-title{
  color:var(--heading);
  font-size:18px;
  font-weight:900;
}

.shop-note{
  color:var(--muted);
  font-size:11px;
}


/* =========================
   SUBJECT FILTER
========================= */

.categories{
  max-width:1050px;
  margin:28px auto 0;
  padding:0 20px;
}

.category-scroll{
  display:flex;
  gap:8px;
  overflow-x:auto;
  padding-bottom:4px;
  scrollbar-width:none;
}

.category-scroll::-webkit-scrollbar{
  display:none;
}

.category{
  flex:0 0 auto;
  padding:8px 13px;
  border:1px solid var(--border);
  background:#FFFFFF;
  border-radius:20px;
  color:#455464;
  font-size:11px;
  font-weight:700;
  cursor:pointer;
}

.category:hover,
.category.active{
  background:var(--blue);
  border-color:var(--blue);
  color:#FFFFFF;
}


/* =========================
   PRODUCTS
========================= */

.shop-section{
  padding:38px 20px 70px;
}

.shop-container{
  max-width:1050px;
  margin:auto;
}

.product-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:18px;
}

.product{
  background:#FFFFFF;
  border:1px solid var(--border);
  border-radius:16px;
  overflow:hidden;
  box-shadow:0 4px 16px rgba(23,43,58,.04);
  transition:.2s;
}

.product:hover{
  transform:translateY(-3px);
  box-shadow:var(--shadow);
}

.product-top{
  padding:24px 20px 17px;
  background:#FFFFFF;
}

.product-icon{
  width:54px;
  height:54px;
  display:grid;
  place-items:center;
  background:var(--blue-light);
  border-radius:13px;
  font-size:25px;
  margin-bottom:14px;
}

.product-category{
  color:var(--blue);
  font-size:10px;
  font-weight:900;
  text-transform:uppercase;
  letter-spacing:1px;
  margin-bottom:5px;
}

.product h2{
  color:var(--heading);
  font-size:18px;
  line-height:1.3;
  margin-bottom:7px;
}

.product-description{
  color:var(--muted);
  font-size:12px;
  line-height:1.55;
  min-height:57px;
}

.product-bottom{
  padding:15px 20px 19px;
  border-top:1px solid var(--border);

  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
}

.price{
  color:var(--navy);
  font-size:18px;
  font-weight:900;
}

.price small{
  display:block;
  color:var(--muted);
  font-size:9px;
  font-weight:600;
}

.buy-btn{
  display:inline-block;
  background:var(--blue);
  color:#FFFFFF;
  padding:9px 14px;
  border-radius:8px;
  font-size:11px;
  font-weight:800;
}

.buy-btn:hover{
  background:var(--blue-dark);
}


/* =========================
   INFO STRIP
========================= */

.info{
