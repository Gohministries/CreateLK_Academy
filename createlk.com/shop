      </div>

    </div>

    <div class="copyright">
      © <span id="year"></span> CreateLK Digital Shop. All rights reserved.
    </div>

  </div>

</footer>

<script>

/*
=========================================================
CREATE LK DIGITAL SHOP
CLOUDFLARE API CONFIGURATION
=========================================================

Replace this URL with your actual Cloudflare Worker API.

Example:
https://createlk-shop-api.createlk.workers.dev

The Worker should provide:

GET /api/products

Expected response:

[
  {
    "id": 1,
    "title": "Spoken English Essentials",
    "subject": "English",
    "description": "Educational English resource.",
    "price": 499,
    "currency": "LKR",
    "image_url": "",
    "active": 1
  }
]

=========================================================
*/

const API_BASE = "https://YOUR-CLOUDFLARE-WORKER.workers.dev";

let allProducts = [];


/* YEAR */

document.getElementById("year").textContent =
  new Date().getFullYear();


/* LOAD PRODUCTS */

async function loadProducts(){

  const container = document.getElementById("products");

  try{

    const response =
      await fetch(API_BASE + "/api/products");

    if(!response.ok){
      throw new Error("Failed to load products");
    }

    const data = await response.json();

    allProducts =
      Array.isArray(data)
      ? data
      : (data.products || []);

    populateSubjects();

    displayProducts(allProducts);

  }catch(error){

    console.error(error);

    container.innerHTML = `
      <div class="status">
        <div style="font-size:42px;margin-bottom:10px">📚</div>

        <h3 style="color:#07164d;margin-bottom:8px">
          Resources are currently unavailable
        </h3>

        <p>
          Please try again shortly.
        </p>
      </div>
    `;
  }
}


/* SUBJECT FILTER */

function populateSubjects(){

  const select =
    document.getElementById("subject");

  const subjects =
    [...new Set(
      allProducts
        .map(product => product.subject)
        .filter(Boolean)
    )].sort();

  select.innerHTML =
    `<option value="">All Subjects</option>`;

  subjects.forEach(subject => {

    const option =
      document.createElement("option");

    option.value = subject;
    option.textContent = subject;

    select.appendChild(option);

  });
}


/* DISPLAY PRODUCTS */

function displayProducts(products){

  const container =
    document.getElementById("products");

  if(!products.length){

    container.innerHTML = `
      <div class="status">
        <div style="font-size:42px;margin-bottom:10px">🔎</div>

        <h3 style="color:#07164d;margin-bottom:8px">
          No resources found
        </h3>

        <p>
          Try another search or subject.
        </p>
      </div>
    `;

    return;
  }

  container.innerHTML =
    products.map(product => {

      const id =
        escapeHtml(product.id);

      const title =
        escapeHtml(product.title || "Learning Resource");

      const subject =
        escapeHtml(product.subject || "Education");

      const description =
        escapeHtml(
          product.description ||
          "Digital educational resource."
        );

      const price =
        Number(product.price || 0).toLocaleString();

      const currency =
        escapeHtml(product.currency || "LKR");

      const image =
        product.image_url || product.image || "";

      const imageHTML =
        image
        ? `
          <img
            src="${escapeAttribute(image)}"
            alt="${escapeAttribute(title)}"
            loading="lazy"
            onerror="this.parentElement.innerHTML='<div class=\\'product-placeholder\\'>📚</div>'">
        `
        : `<div class="product-placeholder">📚</div>`;

      return `

        <article class="product">

          <div class="product-image">
            ${imageHTML}
          </div>

          <div class="product-body">

            <span class="subject">
              ${subject}
            </span>

            <h3>
              ${title}
            </h3>

            <p class="product-description">
              ${description}
            </p>

            <div class="product-bottom">

              <div class="price">
                ${currency} ${price}
              </div>

              <button
                class="buy-btn"
                onclick="openProduct('${id}')">
                View Resource
              </button>

            </div>

          </div>

        </article>

      `;

    }).join("");
}


/* SEARCH + FILTER */

function filterProducts(){

  const search =
    document.getElementById("search")
      .value
      .toLowerCase()
      .trim();

  const subject =
    document.getElementById("subject")
      .value;

  const filtered =
    allProducts.filter(product => {

      const text = `
        ${product.title || ""}
        ${product.description || ""}
        ${product.subject || ""}
      `.toLowerCase();

      const matchesSearch =
        !search || text.includes(search);

      const matchesSubject =
        !subject || product.subject === subject;

      return matchesSearch && matchesSubject;

    });

  displayProducts(filtered);
}


document
  .getElementById("search")
  .addEventListener("input", filterProducts);

document
  .getElementById("subject")
  .addEventListener("change", filterProducts);


/* PRODUCT PAGE */

function openProduct(id){

  window.location.href =
    "product.html?id=" +
    encodeURIComponent(id);

}


/* BASIC HTML ESCAPING */

function escapeHtml(value){

  return String(value)
    .replace(/&/g,"&amp;")
    .replace(/</g,"&lt;")
    .replace(/>/g,"&gt;")
    .replace(/"/g,"&quot;")
    .replace(/'/g,"&#039;");
}

function escapeAttribute(value){
  return escapeHtml(value);
}


/* START */

loadProducts();

</script>

</body>
