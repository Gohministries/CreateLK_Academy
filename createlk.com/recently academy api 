const cors={
  "Access-Control-Allow-Origin":"*",
  "Access-Control-Allow-Methods":"GET,POST,OPTIONS",
  "Access-Control-Allow-Headers":"Content-Type,Authorization"
};

const json=(data,status=200)=>new Response(
  JSON.stringify(data),
  {status,headers:{...cors,"Content-Type":"application/json"}}
);

async function auth(request,env){
  const h=request.headers.get("Authorization");
  if(!h?.startsWith("Bearer "))return null;
  try{
    const r=await env.AUTH.fetch(
      new Request("https://auth.internal/auth/me",{
        headers:{Authorization:h}
      })
    );
    if(!r.ok)return null;
    const d=await r.json();
    return d.customer||d.user||d;
  }catch{return null}
}

async function subscription(env,id){
  return env.DB.prepare(`
    SELECT id,customer_id,grade,status,order_id,payment_id,
           amount,currency,starts_at,expires_at
    FROM premium_subscriptions
    WHERE customer_id=?
      AND REPLACE(LOWER(TRIM(grade)),'-',' ')='spoken english'
      AND status='ACTIVE'
      AND expires_at>datetime('now')
    ORDER BY id DESC LIMIT 1
  `).bind(id).first();
}

async function findLesson(env,n){
  return env.DB.prepare(`
    SELECT id,grade,subject,unit,lesson_number,lesson_code,
           duration,video_url,image_url,is_active,is_free,created_at
    FROM premium_lessons
    WHERE LOWER(TRIM(grade))='spoken english'
      AND LOWER(TRIM(subject))='spoken english'
      AND lesson_number=? AND is_active=1
    LIMIT 1
  `).bind(n).first();
}

async function findTitle(env,n){
  return env.DB.prepare(`
    SELECT id,lesson_number,title,description,access_type
    FROM lessons
    WHERE subject_id=6 AND lesson_number=? AND published=1
    LIMIT 1
  `).bind(n).first();
}

async function getTodayGrammar(env){
  const d=new Date();
  const start=Date.UTC(d.getUTCFullYear(),0,1);
  const today=Date.UTC(
    d.getUTCFullYear(),
    d.getUTCMonth(),
    d.getUTCDate()
  );
  const day=Math.floor((today-start)/86400000)+1;

  let row=await env.DB.prepare(`
    SELECT id,title,description,day_number
    FROM grammar_lessons
    WHERE day_number=? AND is_active=1
    LIMIT 1
  `).bind(day).first();

  if(!row){
    row=await env.DB.prepare(`
      SELECT id,title,description,day_number
      FROM grammar_lessons
      WHERE is_active=1
      ORDER BY day_number ASC
      LIMIT 1
    `).first();
  }

  return{day,row};
}

export default{
async fetch(request,env){

  const url=new URL(request.url);

  if(request.method==="OPTIONS")
    return new Response(null,{headers:cors});

  try{

    if(url.pathname==="/"&&request.method==="GET")
      return json({
        success:true,
        service:"CreateLK Academy API",
        status:"online",
        version:"2.8"
      });

    if(url.pathname==="/auth-test"){
      const customer=await auth(request,env);
      if(!customer)
        return json({success:false,authenticated:false},401);

      return json({
        success:true,
        authenticated:true,
        customer
      });
    }

    if(url.pathname==="/grammar/today"&&request.method==="GET"){
      const{day,row}=await getTodayGrammar(env);

      if(!row)
        return json({
          success:false,
          error:"No grammar lessons found.",
          requested_day:day
        },404);

      return json({
        success:true,
        requested_day:day,
        day_number:Number(row.day_number),
        grammar:{
          id:row.id,
          title:row.title||"",
          description:row.description||""
        }
      });
    }

    if(url.pathname==="/lessons"&&request.method==="GET"){

      const course=url.searchParams.get("course")||"spoken-english";
      const language=url.searchParams.get("language")||"en";

      if(course!=="spoken-english")
        return json({
          success:false,
          error:"Invalid course."
        },400);

      const customer=await auth(request,env);
      let premium=false;

      if(customer){
        const id=customer.id||customer.customer_id;
        if(id)premium=!!await subscription(env,id);
      }

      const r=await env.DB.prepare(`
        SELECT
          p.id,
          l.id AS title_id,
          l.lesson_number,
          l.title,
          l.description,
          l.access_type,
          p.lesson_code,
          p.duration,
          p.video_url,
          p.image_url,
          p.is_active,
          p.is_free
        FROM lessons l
        LEFT JOIN premium_lessons p
          ON p.lesson_number=l.lesson_number
          AND LOWER(TRIM(p.grade))='spoken english'
          AND LOWER(TRIM(p.subject))='spoken english'
          AND p.is_active=1
        WHERE l.subject_id=6
          AND l.published=1
        ORDER BY l.lesson_number
      `).all();

      const lessons=(r.results||[]).map(x=>{
        const n=Number(x.lesson_number);
        return{
          id:x.id,
          title_id:x.title_id,
          lesson_number:n,
          title:x.title||`Lesson ${n}`,
          description:x.description||"",
          access_type:x.access_type||(n<=2?"free":"premium"),
          premium:n>2,
          lesson_code:x.lesson_code||"",
          duration:x.duration||"",
          video_url:x.video_url||"",
          image_url:x.image_url||"",
          is_active:x.is_active??1,
          is_free:n<=2?1:0
        };
      });

      return json({
        success:true,
        course,
        language,
        premium,
        total_lessons:lessons.length,
        lessons
      });
    }

    if(url.pathname==="/lesson"&&request.method==="GET"){

      const course=url.searchParams.get("course")||"spoken-english";
      const language=url.searchParams.get("language")||"en";
      const n=Number(url.searchParams.get("lesson")||1);

      if(
        course!=="spoken-english"||
        !Number.isInteger(n)||
        n<1||
        n>100
      )
        return json({
          success:false,
          error:"Invalid lesson."
        },400);

      const customer=await auth(request,env);

      if(!customer)
        return json({
          success:false,
          error:"Unauthorized."
        },401);

      const customerId=customer.id||customer.customer_id;
      const lesson=await findLesson(env,n);

      if(!lesson)
        return json({
          success:false,
          error:"Lesson not found.",
          lesson_number:n
        },404);

      const title=await findTitle(env,n);
      const free=n<=2;
      let sub=null;

      if(!free)
        sub=await subscription(env,customerId);

      if(!free&&!sub)
        return json({
          success:false,
          premium_required:true,
          message:"This lesson requires a Premium subscription.",
          lesson:{
            id:lesson.id,
            lesson_number:n,
            lesson_code:lesson.lesson_code,
            title:title?.title||`Lesson ${n}`,
            free:false
          }
        },403);

      let translation=await env.DB.prepare(`
        SELECT id,language,title,objectives,content,key_points,summary
        FROM premium_lesson_translations
        WHERE lesson_id=? AND language=?
        LIMIT 1
      `).bind(lesson.id,language).first();

      if(!translation&&language!=="en"){
        translation=await env.DB.prepare(`
          SELECT id,language,title,objectives,content,key_points,summary
          FROM premium_lesson_translations
          WHERE lesson_id=? AND language='en'
          LIMIT 1
        `).bind(lesson.id).first();
      }

      let dialogues=await env.DB.prepare(`
        SELECT id,dialogue_number,speaker_a,text_a,speaker_b,text_b
        FROM lesson_dialogues
        WHERE lesson_id=? AND language=?
        ORDER BY dialogue_number
      `).bind(lesson.id,language).all();

      dialogues=dialogues.results||[];

      if(!dialogues.length&&language!=="en"){
        const fallback=await env.DB.prepare(`
          SELECT id,dialogue_number,speaker_a,text_a,speaker_b,text_b
          FROM lesson_dialogues
          WHERE lesson_id=? AND language='en'
          ORDER BY dialogue_number
        `).bind(lesson.id).all();

        dialogues=fallback.results||[];
      }

      let questions=[];

      try{
        const q=await env.DB.prepare(`
          SELECT id,question,option_a,option_b,option_c,option_d,
                 correct_answer,explanation
          FROM premium_questions
          WHERE lesson_id=? AND language=?
          ORDER BY id
        `).bind(lesson.id,language).all();

        questions=q.results||[];
      }catch{}

      return json({
        success:true,
        access:true,
        course,
        free,
        lesson:{
          id:lesson.id,
          lesson_number:lesson.lesson_number,
          lesson_code:lesson.lesson_code,
          duration:lesson.duration,
          video_url:lesson.video_url,
          image_url:lesson.image_url,
          language:translation?.language||language,
          title:title?.title||translation?.title||`Lesson ${n}`,
          objectives:translation?.objectives||"",
          content:translation?.content||"",
          key_points:translation?.key_points||"",
          summary:translation?.summary||"",
          dialogues,
          questions
        },
        subscription:sub?{
          active:true,
          starts_at:sub.starts_at,
          expires_at:sub.expires_at
        }:null
      });
    }

    if(url.pathname==="/premium/status"&&request.method==="GET"){

      const customer=await auth(request,env);

      if(!customer)
        return json({
          success:false,
          error:"Unauthorized."
        },401);

      const id=customer.id||customer.customer_id;
      const sub=await subscription(env,id);

      return json({
        success:true,
        course:"spoken-english",
        premium:!!sub,
        subscription:sub?{
          id:sub.id,
          status:sub.status,
          starts_at:sub.starts_at,
          expires_at:sub.expires_at,
          amount:sub.amount,
          currency:sub.currency
        }:null
      });
    }

    if(url.pathname==="/progress"&&request.method==="GET"){

      const course=url.searchParams.get("course")||"spoken-english";
      const customer=await auth(request,env);

      if(!customer)
        return json({
          success:false,
          error:"Unauthorized."
        },401);

      const id=customer.id||customer.customer_id;

      const r=await env.DB.prepare(`
        SELECT lesson_number,completed_at
        FROM lesson_progress
        WHERE customer_id=? AND course=?
        ORDER BY lesson_number
      `).bind(id,course).all();

      const lessons=r.results||[];

      return json({
        success:true,
        course,
        completed_count:lessons.length,
        total_lessons:100,
        lessons
      });
    }

    if(
      url.pathname==="/lesson/complete"&&
      request.method==="POST"
    ){

      const customer=await auth(request,env);

      if(!customer)
        return json({
          success:false,
          error:"Unauthorized."
        },401);

      let body;

      try{
        body=await request.json();
      }catch{
        return json({
          success:false,
          error:"Invalid JSON."
        },400);
      }

      const course=body.course||"spoken-english";
      const n=Number(body.lesson_number);
      const id=customer.id||customer.customer_id;

      if(
        course!=="spoken-english"||
        !Number.isInteger(n)||
        n<1||
        n>100
      )
        return json({
          success:false,
          error:"Invalid lesson."
        },400);

      const lesson=await findLesson(env,n);

      if(!lesson)
        return json({
          success:false,
          error:"Lesson does not exist."
        },404);

      await env.DB.prepare(`
        INSERT OR IGNORE INTO lesson_progress
        (customer_id,course,lesson_number)
        VALUES(?,?,?)
      `).bind(id,course,n).run();

      const count=await env.DB.prepare(`
        SELECT COUNT(*) AS count
        FROM lesson_progress
        WHERE customer_id=? AND course=?
      `).bind(id,course).first();

      const completed=Number(count?.count||0);

      return json({
        success:true,
        course,
        lesson_number:n,
        completed_count:completed,
        total_lessons:100,
        certificate_ready:completed>=100
      });
    }

    return json({
      success:false,
      error:"API route not found.",
      path:url.pathname
    },404);

  }catch(e){

    console.error(e);

    return json({
      success:false,
      error:"Internal server error.",
      details:e?.message||String(e)
    },500);
  }
}
};