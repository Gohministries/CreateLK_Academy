export default {
  async fetch(request, env) {
    const url = new URL(request.url);

    /* =========================
       CORS / OPTIONS
       ========================= */

    if (request.method === "OPTIONS") {
      return new Response(null, {
        status: 204,
        headers: corsHeaders()
      });
    }

    try {

      /* =========================
         PREMIUM STATUS
         ========================= */

      if (
        url.pathname === "/premium/status" &&
        request.method === "GET"
      ) {

        const grade =
          url.searchParams.get("grade");

        if (!grade) {
          return json({
            success: false,
            error: "Grade is required"
          }, 400);
        }

        const customer =
          await getCustomer(request, env);

        if (!customer) {
          return json({
            success: false,
            error: "Unauthorized"
          }, 401);
        }

        const subscription =
          await env.DB.prepare(`
            SELECT
              id,
              customer_id,
              grade,
              status,
              starts_at,
              expires_at
            FROM premium_subscriptions
            WHERE customer_id = ?
              AND grade = ?
              AND status = 'ACTIVE'
              AND expires_at > datetime('now')
            ORDER BY id DESC
            LIMIT 1
          `)
          .bind(
            customer.id,
            grade
          )
          .first();

        /* No active subscription */

        if (!subscription) {
          return json({
            success: true,
            premium: {
              active: false,
              grade: grade
            }
          });
        }

        /* Active subscription */

        return json({
          success: true,
          premium: {
            active: true,
            grade: subscription.grade,
            starts_at: subscription.starts_at,
            expires_at: subscription.expires_at
          }
        });
      }


      /* =========================
         PREMIUM CONTENT
         ========================= */

      if (
        url.pathname === "/content" &&
        request.method === "GET"
      ) {

        const grade =
          url.searchParams.get("grade");

        const subject =
          url.searchParams.get("subject");

        const language =
          url.searchParams.get("language") || "en";

        if (!grade || !subject) {
          return json({
            success: false,
            error: "Grade and subject are required"
          }, 400);
        }

        const customer =
          await getCustomer(request, env);

        if (!customer) {
          return json({
            success: false,
            error: "Unauthorized"
          }, 401);
        }

        /* =========================
           CHECK PREMIUM
           ========================= */

        const subscription =
          await env.DB.prepare(`
            SELECT
              id
            FROM premium_subscriptions
            WHERE customer_id = ?
              AND grade = ?
              AND status = 'ACTIVE'
              AND expires_at > datetime('now')
            ORDER BY id DESC
            LIMIT 1
          `)
          .bind(
            customer.id,
            grade
          )
          .first();

        if (!subscription) {
          return json({
            success: false,
            error: "Premium required",
            payment_required: true
          }, 403);
        }


        /* =========================
           GET CONTENT
           ========================= */

        const content =
          await env.DB.prepare(`
            SELECT *
            FROM premium_content
            WHERE grade = ?
              AND subject = ?
              AND language = ?
            LIMIT 1
          `)
          .bind(
            grade,
            subject,
            language
          )
          .first();

        if (!content) {
          return json({
            success: false,
            error: "Content not found"
          }, 404);
        }

        return json({
          success: true,
          product: content
        });
      }


      /* =========================
         PREMIUM CHECKOUT
         
         Placeholder for now.
         PayHere integration can be
         added separately.
         ========================= */

      if (
        url.pathname === "/premium/checkout" &&
        request.method === "GET"
      ) {

        const grade =
          url.searchParams.get("grade");

        if (!grade) {
          return json({
            success: false,
            error: "Grade is required"
          }, 400);
        }

        const customer =
          await getCustomer(request, env);

        if (!customer) {
          return json({
            success: false,
            error: "Unauthorized"
          }, 401);
        }

        return json({
          success: false,
          error: "Premium checkout is not configured yet.",
          grade: grade,
          customer_id: customer.id
        }, 501);
      }


      /* =========================
         HEALTH CHECK
         ========================= */

      if (
        url.pathname === "/" &&
        request.method === "GET"
      ) {

        return json({
          success: true,
          service: "CreateLK Premium API",
          status: "online"
        });
      }


      /* =========================
         NOT FOUND
         ========================= */

      return json({
        success: false,
        error: "Not found"
      }, 404);

    } catch (error) {

      console.error(
        "Premium Worker error:",
        error
      );

      return json({
        success: false,
        error:
          error.message ||
          "Server error."
      }, 500);
    }
  }
};


/* =====================================================
   AUTHENTICATION
   =====================================================

   Uses Cloudflare Service Binding:

   AUTH → createlk-auth-api

   This avoids calling the Auth Worker through its
   public workers.dev URL and avoids error 1042.
   ===================================================== */

async function getCustomer(request, env) {

  const authorization =
    request.headers.get("Authorization");

  /* No Authorization header */

  if (
    !authorization ||
    !authorization.startsWith("Bearer ")
  ) {

    console.log(
      "Premium Auth: Missing Authorization header"
    );

    return null;
  }

  const token =
    authorization
      .substring(7)
      .trim();

  /* Empty token */

  if (!token) {

    console.log(
      "Premium Auth: Empty token"
    );

    return null;
  }

  try {

    /*
      Create an internal request for the
      Auth Worker Service Binding.
    */

    const authRequest =
      new Request(
        "https://auth.internal/auth/me",
        {
          method: "GET",

          headers: {
            "Authorization":
              "Bearer " + token,

            "Accept":
              "application/json"
          }
        }
      );


    /*
      IMPORTANT:

      AUTH is the Service Binding variable
      connected to createlk-auth-api.
    */

    const authResponse =
      await env.AUTH.fetch(
        authRequest
      );


    /* Read response */

    const text =
      await authResponse.text();


    console.log(
      "Auth Worker status:",
      authResponse.status
    );

    console.log(
      "Auth Worker response:",
      text
    );


    /* Auth rejected token */

    if (!authResponse.ok) {

      console.log(
        "Premium Auth: Authentication failed"
      );

      return null;
    }


    /* Parse JSON */

    let data;

    try {

      data =
        JSON.parse(text);

    } catch (error) {

      console.error(
        "Premium Auth: Invalid JSON response"
      );

      return null;
    }


    /* Check response */

    if (
      !data ||
      !data.success ||
      !data.customer
    ) {

      console.log(
        "Premium Auth: Customer not found"
      );

      return null;
    }


    console.log(
      "Premium Auth: Customer verified",
      data.customer.id
    );


    return data.customer;

  } catch (error) {

    console.error(
      "Premium Auth Service Binding error:",
      error
    );

    return null;
  }
}


/* =====================================================
   JSON RESPONSE
   ===================================================== */

function json(
  data,
  status = 200
) {

  return new Response(
    JSON.stringify(data),

    {
      status: status,

      headers: {
        ...corsHeaders(),

        "Content-Type":
          "application/json"
      }
    }
  );
}


/* =====================================================
   CORS HEADERS
   ===================================================== */

function corsHeaders() {

  return {

    "Access-Control-Allow-Origin":
      "*",

    "Access-Control-Allow-Methods":
      "GET, POST, OPTIONS",

    "Access-Control-Allow-Headers":
      "Content-Type, Authorization",

    "Access-Control-Max-Age":
      "86400"
  };
}