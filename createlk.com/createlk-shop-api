const CORS = {
  "Access-Control-Allow-Origin": "*",
  "Access-Control-Allow-Methods": "GET,POST,OPTIONS",
  "Access-Control-Allow-Headers": "Content-Type,Authorization"
};

const response = (data, status = 200) =>
  new Response(JSON.stringify(data), {
    status,
    headers: {
      ...CORS,
      "Content-Type": "application/json"
    }
  });

const fail = (message, status = 400) =>
  response({ success: false, error: message }, status);

async function sha256(text) {
  const hash = await crypto.subtle.digest(
    "SHA-256",
    new TextEncoder().encode(text)
  );

  return [...new Uint8Array(hash)]
    .map(x => x.toString(16).padStart(2, "0"))
    .join("");
}

function base64url(text) {
  return btoa(text)
    .replace(/\+/g, "-")
    .replace(/\//g, "_")
    .replace(/=+$/, "");
}

function decodeBase64(text) {
  text = text.replace(/-/g, "+").replace(/_/g, "/");
  while (text.length % 4) text += "=";
  return atob(text);
}

async function hmac(text, secret) {
  const key = await crypto.subtle.importKey(
    "raw",
    new TextEncoder().encode(secret),
    { name: "HMAC", hash: "SHA-256" },
    false,
    ["sign"]
  );

  const result = await crypto.subtle.sign(
    "HMAC",
    key,
    new TextEncoder().encode(text)
  );

  return base64url(
    String.fromCharCode(...new Uint8Array(result))
  );
}

async function token(customer, env) {
  const payload = base64url(JSON.stringify({
    id: customer.id,
    exp: Date.now() + 30 * 24 * 60 * 60 * 1000
  }));

  return payload + "." +
    await hmac(payload, env.SESSION_SECRET);
}

async function user(request, env) {
  const header = request.headers.get("Authorization") || "";

  if (!header.startsWith("Bearer ")) return null;

  try {
    const [payload, signature] = header.slice(7).split(".");

    const valid =
      await hmac(payload, env.SESSION_SECRET);

    if (signature !== valid) return null;

    const data = JSON.parse(decodeBase64(payload));

    if (Date.now() > data.exp) return null;

    return await env.DB.prepare(`
      SELECT id,first_name,last_name,email,phone,created_at
      FROM customers
      WHERE id=?
    `).bind(data.id).first();

  } catch {
    return null;
  }
}

export default {
  async fetch(request, env) {

    if (request.method === "OPTIONS") {
      return new Response(null, { headers: CORS });
    }

    const url = new URL(request.url);
    const path = url.pathname.replace(/\/$/, "");

    try {

      /* HEALTH */

      if (path === "" || path === "/") {
        return response({
          success: true,
          service: "CreateLK Shop API",
          status: "online"
        });
      }

      /* REGISTER */

      if (
        path === "/auth/register" &&
        request.method === "POST"
      ) {
        const d = await request.json();

        const first = String(d.first_name || "").trim();
        const last = String(d.last_name || "").trim();
        const email = String(d.email || "")
          .trim()
          .toLowerCase();
        const phone = String(d.phone || "").trim();
        const password = String(d.password || "");

        if (!first || !email || password.length < 6) {
          return fail(
            "First name, email and password are required."
          );
        }

        const exists = await env.DB.prepare(`
          SELECT id FROM customers WHERE email=?
        `).bind(email).first();

        if (exists) {
          return fail(
            "Email already registered.",
            409
          );
        }

        const passwordHash = await sha256(password);

        const result = await env.DB.prepare(`
          INSERT INTO customers
          (first_name,last_name,email,phone,password_hash)
          VALUES(?,?,?,?,?)
        `).bind(
          first,
          last,
          email,
          phone,
          passwordHash
        ).run();

        const customer = await env.DB.prepare(`
          SELECT id,first_name,last_name,email,phone,created_at
          FROM customers
          WHERE id=?
        `).bind(result.meta.last_row_id).first();

        return response({
          success: true,
          token: await token(customer, env),
          customer
        }, 201);
      }

      /* LOGIN */

      if (
        path === "/auth/login" &&
        request.method === "POST"
      ) {
        const d = await request.json();

        const email = String(d.email || "")
          .trim()
          .toLowerCase();

        const password = String(d.password || "");

        const customer = await env.DB.prepare(`
          SELECT *
          FROM customers
          WHERE email=?
        `).bind(email).first();

        if (
          !customer ||
          await sha256(password) !== customer.password_hash
        ) {
          return fail(
            "Invalid email or password.",
            401
          );
        }

        delete customer.password_hash;

        return response({
          success: true,
          token: await token(customer, env),
          customer
        });
      }

      /* CURRENT USER */

      if (path === "/auth/me") {
        const customer = await user(request, env);

        if (!customer) {
          return fail("Please login.", 401);
        }

        return response({
          success: true,
          customer
        });
      }

      /* PRODUCTS */

      if (
        path === "/products" &&
        request.method === "GET"
      ) {
        const subject =
          url.searchParams.get("subject");

        const search =
          url.searchParams.get("search");

        let sql = `
          SELECT
            id,title,subject,price,
            description,image
          FROM products
          WHERE published=1
        `;

        const params = [];

        if (subject) {
          sql += " AND LOWER(subject)=LOWER(?)";
          params.push(subject);
        }

        if (search) {
          sql += `
            AND (
              LOWER(title) LIKE LOWER(?)
              OR LOWER(description) LIKE LOWER(?)
            )
          `;

          const q = `%${search}%`;

          params.push(q, q);
        }

        sql += " ORDER BY id DESC";

        const result = await env.DB
          .prepare(sql)
          .bind(...params)
          .all();

        return response({
          success: true,
          products: result.results
        });
      }

      /* SINGLE PRODUCT */

      const productMatch =
        path.match(/^\/products\/(\d+)$/);

      if (
        productMatch &&
        request.method === "GET"
      ) {
        const product = await env.DB.prepare(`
          SELECT
            id,title,subject,price,
            description,image
          FROM products
          WHERE id=? AND published=1
        `).bind(
          Number(productMatch[1])
        ).first();

        if (!product) {
          return fail(
            "Product not found.",
            404
          );
        }

        return response({
          success: true,
          product
        });
      }

      /* CREATE PENDING PURCHASE */

      if (
        path === "/purchase" &&
        request.method === "POST"
      ) {
        const customer = await user(request, env);

        if (!customer) {
          return fail(
            "Please login first.",
            401
          );
        }

        const d = await request.json();

        const productId =
          Number(d.product_id);

        const product = await env.DB.prepare(`
          SELECT *
          FROM products
          WHERE id=? AND published=1
        `).bind(productId).first();

        if (!product) {
          return fail(
            "Product not found.",
            404
          );
        }

        const paid = await env.DB.prepare(`
          SELECT id,order_id,status
          FROM purchases
          WHERE customer_id=?
          AND product_id=?
          AND status='PAID'
          LIMIT 1
        `).bind(
          customer.id,
          productId
        ).first();

        if (paid) {
          return response({
            success: true,
            already_purchased: true,
            purchase: paid
          });
        }

        const orderId =
          "CLK-" +
          Date.now() +
          "-" +
          crypto.randomUUID()
            .replace(/-/g, "")
            .slice(0, 8)
            .toUpperCase();

        const amount =
          Number(product.price).toFixed(2);

        const result = await env.DB.prepare(`
          INSERT INTO purchases
          (
            customer_id,
            product_id,
            order_id,
            amount,
            currency,
            status
          )
          VALUES(?,?,?,?,?,'PENDING')
        `).bind(
          customer.id,
          productId,
          orderId,
          amount,
          "LKR"
        ).run();

        return response({
          success: true,
          purchase_id: result.meta.last_row_id,
          order_id: orderId,
          product_id: productId,
          amount,
          currency: "LKR"
        }, 201);
      }

      /* MY PURCHASES */

      if (path === "/my-purchases") {
        const customer = await user(request, env);

        if (!customer) {
          return fail("Please login.", 401);
        }

        const result = await env.DB.prepare(`
          SELECT
            p.id,
            p.order_id,
            p.payment_id,
            p.amount,
            p.currency,
            p.status,
            p.purchased_at,
            pr.id AS product_id,
            pr.title,
            pr.subject,
            pr.description,
            pr.image
          FROM purchases p
          JOIN products pr
            ON pr.id=p.product_id
          WHERE p.customer_id=?
          ORDER BY p.id DESC
        `).bind(customer.id).all();

        return response({
          success: true,
          purchases: result.results
        });
      }

      /* PURCHASE STATUS */

      if (path === "/purchase-status") {
        const customer = await user(request, env);

        if (!customer) {
          return fail("Please login.", 401);
        }

        const orderId =
          url.searchParams.get("order_id");

        if (!orderId) {
          return fail("Order ID required.");
        }

        const purchase = await env.DB.prepare(`
          SELECT
            p.id,
            p.order_id,
            p.payment_id,
            p.amount,
            p.currency,
            p.status,
            p.purchased_at,
            p.product_id,
            pr.title
          FROM purchases p
          JOIN products pr
            ON pr.id=p.product_id
          WHERE p.order_id=?
          AND p.customer_id=?
        `).bind(
          orderId,
          customer.id
        ).first();

        if (!purchase) {
          return fail(
            "Purchase not found.",
            404
          );
        }

        return response({
          success: true,
          purchase
        });
      }

      /* PROTECTED PRODUCT CONTENT */

      const content =
        path.match(/^\/content\/(\d+)$/);

      if (content) {
        const customer = await user(request, env);

        if (!customer) {
          return fail("Please login.", 401);
        }

        const product = await env.DB.prepare(`
          SELECT
            pr.id,
            pr.title,
            pr.subject,
            pr.content
          FROM products pr
          JOIN purchases p
            ON p.product_id=pr.id
          WHERE pr.id=?
          AND p.customer_id=?
          AND p.status='PAID'
          LIMIT 1
        `).bind(
          Number(content[1]),
          customer.id
        ).first();

        if (!product) {
          return fail(
            "You have not purchased this resource.",
            403
          );
        }

        return response({
          success: true,
          product
        });
      }

      return fail(
        "Route not found.",
        404
      );

    } catch (e) {
      console.error(e);

      return fail(
        e.message || "Server error.",
        500
      );
    }
  }
};