const cors = {
  "Access-Control-Allow-Origin": "*",
  "Access-Control-Allow-Methods": "GET,POST,OPTIONS",
  "Access-Control-Allow-Headers": "Content-Type,Authorization"
};

const COURSE = "facebook-creator";
const GRADE = "facebook creator";
const SUBJECT = "facebook creator study";
const PRICE = 999;
const PERIOD_DAYS = 30;

const json = (data, status = 200) =>
  new Response(JSON.stringify(data), {
    status,
    headers: { ...cors, "Content-Type": "application/json" }
  });

async function auth(request, env) {
  const h = request.headers.get("Authorization");
  if (!h?.startsWith("Bearer ")) return null;

  try {
    const r = await env.AUTH.fetch(
      new Request("https://auth.internal/auth/me", {
        headers: { Authorization: h }
      })
    );

    if (!r.ok) return null;

    const d = await r.json();
    return d.customer || d.user || d;
  } catch {
    return null;
  }
}

async function subscription(env, customerId) {
  return await env.DB.prepare(`
    SELECT id,customer_id,grade,status,order_id,payment_id,
           amount,currency,starts_at,expires_at
    FROM premium_subscriptions
    WHERE customer_id=?
      AND LOWER(TRIM(grade))=?
      AND status='ACTIVE'
      AND expires_at>datetime('now')
    ORDER BY id DESC
    LIMIT 1
  `).bind(customerId, GRADE).first();
}

async function findLesson(env, number) {
  return await env.DB.prepare(`
    SELECT id,grade,subject,unit,lesson_number,lesson_code,
           duration,video_url,image_url,is_active,is_free,created_at
    FROM premium_lessons
    WHERE LOWER(TRIM(grade))=?
      AND LOWER(TRIM(subject))=?
      AND lesson_number=?
      AND is_active=1
    LIMIT 1
  `).bind(GRADE, SUBJECT, number).first();
}

async function lessonCount(env) {
  const r = await env.DB.prepare(`
    SELECT COUNT(*) AS count
    FROM premium_lessons
    WHERE LOWER(TRIM(grade))=?
      AND LOWER(TRIM(subject))=?
      AND is_active=1
  `).bind(GRADE, SUBJECT).first();

  return Number(r?.count || 0);
}

export default {
  async fetch(request, env) {
    const url = new URL(request.url);

    if (request.method === "OPTIONS")
      return new Response(null, { headers: cors });

    try {

      if (url.pathname === "/" && request.method === "GET") {
        return json({
          success: true,
          service: "CreateLK Facebook Creator Academy API",
          status: "online",
          course: COURSE,
          version: "1.0"
        });
      }

      if (url.pathname === "/auth-test") {
        const customer = await auth(request, env);

        return customer
          ? json({
              success: true,
              authenticated: true,
              customer
            })
          : json({
              success: false,
              authenticated: false
            }, 401);
      }

      if (url.pathname === "/lessons" && request.method === "GET") {
        const course = url.searchParams.get("course") || COURSE;
        const language = url.searchParams.get("language") || "en";

        if (course !== COURSE) {
          return json({
            success: false,
            error: "Invalid course."
          }, 400);
        }

        const customer = await auth(request, env);
        let premium = false;

        if (customer) {
          const id = customer.id || customer.customer_id;

          if (id)
            premium = !!await subscription(env, id);
        }

        const r = await env.DB.prepare(`
          SELECT
            p.id,
            p.grade,
            p.subject,
            p.unit,
            p.lesson_number,
            p.lesson_code,
            p.duration,
            p.video_url,
            p.image_url,
            p.is_active,
            p.is_free,
            t.language,
            t.title,
            t.objectives,
            t.summary
          FROM premium_lessons p
          LEFT JOIN premium_lesson_translations t
            ON t.lesson_id=p.id
            AND t.language=?
          WHERE LOWER(TRIM(p.grade))=?
            AND LOWER(TRIM(p.subject))=?
            AND p.is_active=1
          ORDER BY p.lesson_number
        `).bind(language, GRADE, SUBJECT).all();

        const lessons = r.results || [];
        const total = lessons.length;

        return json({
          success: true,
          course: COURSE,
          language,
          premium,
          total_lessons: total,
          lessons
        });
      }

      if (url.pathname === "/lesson" && request.method === "GET") {
        const course = url.searchParams.get("course") || COURSE;
        const language = url.searchParams.get("language") || "en";
        const number = Number(
          url.searchParams.get("lesson") || 1
        );

        if (
          course !== COURSE ||
          !Number.isInteger(number) ||
          number < 1
        ) {
          return json({
            success: false,
            error: "Invalid lesson."
          }, 400);
        }

        const customer = await auth(request, env);

        if (!customer) {
          return json({
            success: false,
            error: "Unauthorized."
          }, 401);
        }

        const customerId =
          customer.id || customer.customer_id;

        const lesson = await findLesson(env, number);

        if (!lesson) {
          return json({
            success: false,
            error: "Lesson not found.",
            lesson_number: number
          }, 404);
        }

        const free = Number(lesson.is_free) === 1;

        let sub = null;

        if (!free)
          sub = await subscription(env, customerId);

        if (!free && !sub) {
          return json({
            success: false,
            premium_required: true,
            message:
              "This lesson requires a Premium subscription.",
            lesson: {
              id: lesson.id,
              lesson_number: number,
              lesson_code: lesson.lesson_code,
              free: false,
              image_url: lesson.image_url
            }
          }, 403);
        }

        let t = await env.DB.prepare(`
          SELECT
            id,
            language,
            title,
            objectives,
            content,
            key_points,
            summary
          FROM premium_lesson_translations
          WHERE lesson_id=?
            AND language=?
          LIMIT 1
        `).bind(
          lesson.id,
          language
        ).first();

        if (!t && language !== "en") {
          t = await env.DB.prepare(`
            SELECT
              id,
              language,
              title,
              objectives,
              content,
              key_points,
              summary
            FROM premium_lesson_translations
            WHERE lesson_id=?
              AND language='en'
            LIMIT 1
          `).bind(lesson.id).first();
        }

        return json({
          success: true,
          access: true,
          course: COURSE,
          free,

          lesson: {
            id: lesson.id,
            lesson_number: lesson.lesson_number,
            lesson_code: lesson.lesson_code,
            unit: lesson.unit,
            duration: lesson.duration,
            video_url: lesson.video_url,
            image_url: lesson.image_url,

            language: t?.language || language,
            title: t?.title || `Lesson ${number}`,
            objectives: t?.objectives || "",
            content: t?.content || "",
            key_points: t?.key_points || "",
            summary: t?.summary || ""
          },

          subscription: sub
            ? {
                active: true,
                starts_at: sub.starts_at,
                expires_at: sub.expires_at,
                amount: sub.amount,
                currency: sub.currency
              }
            : null
        });
      }

      if (
        url.pathname === "/premium/status" &&
        request.method === "GET"
      ) {
        const customer = await auth(request, env);

        if (!customer) {
          return json({
            success: false,
            error: "Unauthorized."
          }, 401);
        }

        const customerId =
          customer.id || customer.customer_id;

        const sub =
          await subscription(env, customerId);

        return json({
          success: true,
          course: COURSE,
          premium: !!sub,

          subscription: sub
            ? {
                id: sub.id,
                status: sub.status,
                starts_at: sub.starts_at,
                expires_at: sub.expires_at,
                amount: sub.amount,
                currency: sub.currency
              }
            : null
        });
      }

      if (
        url.pathname === "/progress" &&
        request.method === "GET"
      ) {
        const course =
          url.searchParams.get("course") || COURSE;

        if (course !== COURSE) {
          return json({
            success: false,
            error: "Invalid course."
          }, 400);
        }

        const customer = await auth(request, env);

        if (!customer) {
          return json({
            success: false,
            error: "Unauthorized."
          }, 401);
        }

        const customerId =
          customer.id || customer.customer_id;

        const r = await env.DB.prepare(`
          SELECT lesson_number,completed_at
          FROM lesson_progress
          WHERE customer_id=?
            AND course=?
          ORDER BY lesson_number
        `).bind(
          customerId,
          COURSE
        ).all();

        const lessons = r.results || [];
        const total = await lessonCount(env);

        return json({
          success: true,
          course: COURSE,
          completed_count: lessons.length,
          total_lessons: total,
          lessons
        });
      }

      if (
        url.pathname === "/lesson/complete" &&
        request.method === "POST"
      ) {
        const customer = await auth(request, env);

        if (!customer) {
          return json({
            success: false,
            error: "Unauthorized."
          }, 401);
        }

        let body;

        try {
          body = await request.json();
        } catch {
          return json({
            success: false,
            error: "Invalid JSON."
          }, 400);
        }

        const course = body.course || COURSE;
        const number = Number(body.lesson_number);

        const customerId =
          customer.id || customer.customer_id;

        if (
          course !== COURSE ||
          !Number.isInteger(number) ||
          number < 1
        ) {
          return json({
            success: false,
            error: "Invalid lesson."
          }, 400);
        }

        const lesson =
          await findLesson(env, number);

        if (!lesson) {
          return json({
            success: false,
            error: "Lesson does not exist."
          }, 404);
        }

        await env.DB.prepare(`
          INSERT OR IGNORE INTO lesson_progress
          (customer_id,course,lesson_number)
          VALUES (?,?,?)
        `).bind(
          customerId,
          COURSE,
          number
        ).run();

        const count = await env.DB.prepare(`
          SELECT COUNT(*) AS count
          FROM lesson_progress
          WHERE customer_id=?
            AND course=?
        `).bind(
          customerId,
          COURSE
        ).first();

        const completed =
          Number(count?.count || 0);

        const total =
          await lessonCount(env);

        return json({
          success: true,
          course: COURSE,
          lesson_number: number,
          completed_count: completed,
          total_lessons: total,
          certificate_ready:
            total > 0 && completed >= total
        });
      }

      if (
        url.pathname === "/premium/checkout" &&
        request.method === "GET"
      ) {
        const customer = await auth(request, env);

        if (!customer) {
          return json({
            success: false,
            error: "Unauthorized."
          }, 401);
        }

        return json({
          success: false,
          configured: false,
          message:
            "Premium payment is not configured yet.",
          course: COURSE,
          price: PRICE,
          currency: "LKR",
          period_days: PERIOD_DAYS
        }, 501);
      }

      return json({
        success: false,
        error: "API route not found.",
        path: url.pathname
      }, 404);

    } catch (e) {
      console.error(e);

      return json({
        success: false,
        error: "Internal server error.",
        details: e?.message || String(e)
      }, 500);
    }
  }
};