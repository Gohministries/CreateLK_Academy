<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#155eef">
<title>Facebook Creator Study</title>

<style>
*{box-sizing:border-box}

body{
  margin:0;
  background:#f5f7fb;
  color:#101828;
  font:15px Arial,sans-serif
}

header{
  background:linear-gradient(135deg,#155eef,#7c3aed);
  color:#fff;
  padding:18px 16px;
  text-align:center
}

header h1{
  margin:0;
  font-size:22px
}

header p{
  margin:6px 0 12px;
  opacity:.95
}

.logout{
  border:0;
  background:rgba(255,255,255,.18);
  color:#fff;
  padding:8px 14px;
  border-radius:10px;
  cursor:pointer
}

.container{
  max-width:850px;
  margin:auto;
  padding:16px
}

.card{
  background:#fff;
  border-radius:18px;
  padding:18px;
  margin-bottom:16px;
  box-shadow:0 5px 20px rgba(16,24,40,.07)
}

.card h2{
  margin:0 0 8px;
  font-size:20px
}

.card p{
  color:#667085;
  line-height:1.5
}

.languages{
  display:flex;
  gap:8px;
  flex-wrap:wrap;
  margin-top:14px
}

.lang{
  border:1px solid #d0d5dd;
  background:#fff;
  padding:9px 13px;
  border-radius:10px;
  cursor:pointer
}

.lang.active{
  background:#155eef;
  color:#fff;
  border-color:#155eef
}

.status{
  padding:12px;
  border-radius:12px;
  background:#eef4ff;
  color:#155eef;
  font-weight:700;
  margin-bottom:16px
}

.premium{
  background:linear-gradient(135deg,#fff7ed,#f5f3ff);
  border:1px solid #e9d5ff
}

.price{
  font-size:25px;
  font-weight:800;
  margin:8px 0
}

.buy{
  width:100%;
  border:0;
  background:#7c3aed;
  color:#fff;
  padding:13px;
  border-radius:12px;
  font-size:16px;
  font-weight:700;
  cursor:pointer
}

.buy:disabled{
  opacity:.6
}

.search-box{
  display:flex;
  align-items:center;
  gap:10px;
  background:#fff;
  border:2px solid #e4e7ec;
  border-radius:16px;
  padding:12px 15px;
  margin:18px 0;
  box-shadow:0 4px 14px rgba(16,24,40,.05)
}

.search-box:focus-within{
  border-color:#155eef
}

.search-box input{
  width:100%;
  border:0;
  outline:0;
  font-size:16px;
  background:transparent
}

.lesson-count{
  margin:0 0 12px;
  color:#667085;
  font-weight:600
}

.lesson-card{
  display:flex;
  align-items:center;
  gap:14px;
  background:#fff;
  border-radius:16px;
  padding:15px;
  margin-bottom:10px;
  box-shadow:0 3px 12px rgba(16,24,40,.06);
  cursor:pointer;
  transition:.15s
}

.lesson-card:active{
  transform:scale(.98)
}

.lesson-number{
  min-width:45px;
  height:45px;
  display:flex;
  align-items:center;
  justify-content:center;
  border-radius:13px;
  background:#eef4ff;
  color:#155eef;
  font-weight:800
}

.lesson-info{
  min-width:0;
  flex:1
}

.lesson-title{
  font-weight:700;
  line-height:1.35
}

.lesson-status{
  margin-top:5px;
  font-size:13px;
  color:#667085
}

.lesson-status.free{
  color:#16a34a
}

.lesson-status.locked{
  color:#7c3aed
}

.no-results{
  text-align:center;
  background:#fff;
  padding:30px 15px;
  border-radius:16px;
  color:#667085
}

.loading{
  text-align:center;
  padding:30px;
  color:#667085
}

footer{
  text-align:center;
  padding:25px 15px;
  color:#667085;
  font-size:13px
}

.hidden{
  display:none!important
}
</style>
</head>

<body>

<header>
  <h1>📱 Facebook Creator Study</h1>
  <p>Learn. Create. Grow.</p>
  <div>🇬🇧 English • 🇱🇰 தமிழ் • 🇱🇰 සිංහල</div>
  <br>
  <button class="logout" onclick="logout()">Logout</button>
</header>

<main class="container">

  <section class="card">
    <h2>📚 Creator Study</h2>

    <p>
      Learn practical skills for creating content,
      growing an audience, understanding insights,
      and building your creator journey.
    </p>

    <div class="languages">

      <button
        class="lang"
        data-lang="en"
        onclick="changeLanguage('en')">
        🇬🇧 English
      </button>

      <button
        class="lang"
        data-lang="ta"
        onclick="changeLanguage('ta')">
        🇱🇰 தமிழ்
      </button>

      <button
        class="lang"
        data-lang="si"
        onclick="changeLanguage('si')">
        🇱🇰 සිංහල
      </button>

    </div>
  </section>

  <div id="status" class="status">
    Loading...
  </div>

  <section id="premiumBox" class="card premium">

    <h2>⭐ Premium Access</h2>

    <p>
      Lessons 1–10 are free.
      Unlock all available lessons with Premium.
    </p>

    <div class="price">
      LKR 999
      <small style="font-size:14px;font-weight:400">
        / 30 days
      </small>
    </div>

    <button
      id="buyBtn"
      class="buy"
      onclick="buyPremium()">
      ⭐ Get Premium
    </button>

  </section>

  <div class="search-box">
    🔎
    <input
      id="lessonSearch"
      type="search"
      autocomplete="off"
      placeholder="Search lessons..."
      oninput="searchLessons()">
  </div>

  <div id="lessonCount" class="lesson-count"></div>

  <div id="lessons">
    <div class="loading">
      Loading lessons...
    </div>
  </div>

</main>

<footer>
  <div>Facebook Creator Study</div>
  <div style="margin-top:6px">
    Independent online education platform
  </div>
</footer>

<script>

const API="https://lesson.createlk.workers.dev";
const PAY="https://createlk-payhere.createlk.workers.dev";

let allLessons=[];
let premiumActive=false;

const freeTitles={
  1:{
    en:"👤 What Is a Facebook Creator?",
    ta:"👤 Facebook Creator என்றால் என்ன?",
    si:"👤 Facebook Creator කෙනෙක් යනු කවුද?"
  },
  2:{
    en:"🎯 Choose Your Creator Niche",
    ta:"🎯 உங்கள் Creator Niche-ஐ தேர்ந்தெடுக்கவும்",
    si:"🎯 ඔබේ Creator Niche එක තෝරන්න"
  },
  3:{
    en:"👥 Understand Your Audience",
    ta:"👥 உங்கள் பார்வையாளர்களைப் புரிந்துகொள்ளுங்கள்",
    si:"👥 ඔබේ Audience එක තේරුම් ගන්න"
  },
  4:{
    en:"💡 Find Content Ideas",
    ta:"💡 Content Ideas கண்டுபிடிக்கவும்",
    si:"💡 Content Ideas සොයා ගන්න"
  },
  5:{
    en:"✍️ Write Better Facebook Posts",
    ta:"✍️ சிறந்த Facebook Posts எழுதுங்கள்",
    si:"✍️ වඩා හොඳ Facebook Posts ලියන්න"
  },
  6:{
    en:"🎨 Create Attractive Visual Content",
    ta:"🎨 கவர்ச்சியான Visual Content உருவாக்குங்கள்",
    si:"🎨 ආකර්ෂණීය Visual Content සාදන්න"
  },
  7:{
    en:"🎥 Facebook Video Basics",
    ta:"🎥 Facebook Video அடிப்படைகள்",
    si:"🎥 Facebook Video මූලික කරුණු"
  },
  8:{
    en:"🎬 Introduction to Reels",
    ta:"🎬 Reels அறிமுகம்",
    si:"🎬 Reels හැඳින්වීම"
  },
  9:{
    en:"💬 Get More Engagement",
    ta:"💬 அதிக Engagement பெறுங்கள்",
    si:"💬 වැඩි Engagement ලබා ගන්න"
  },
  10:{
    en:"📊 Understand Facebook Insights",
    ta:"📊 Facebook Insights-ஐ புரிந்துகொள்ளுங்கள்",
    si:"📊 Facebook Insights තේරුම් ගන්න"
  }
};

function getToken(){
  return localStorage.getItem("createlk_token") || "";
}

function getLanguage(){
  return localStorage.getItem("fb_language") || "en";
}

function setLanguageButtons(){

  document.querySelectorAll(".lang").forEach(btn=>{
    btn.classList.toggle(
      "active",
      btn.dataset.lang===getLanguage()
    );
  });

}

async function loadLessons(){

  const lang=getLanguage();

  document.getElementById("lessons").innerHTML=
    '<div class="loading">Loading lessons...</div>';

  try{

    const r=await fetch(
      `${API}/lessons?course=facebook-creator&language=${encodeURIComponent(lang)}`
    );

    const d=await r.json();

    if(!r.ok || !d.success){
      throw new Error(
        d.error || "Unable to load lessons"
      );
    }

    allLessons=Array.isArray(d.lessons)
      ? d.lessons
      : [];

    document.getElementById("lessonCount").textContent=
      `${allLessons.length} lessons`;

    renderLessons(allLessons);

  }catch(e){

    document.getElementById("lessonCount").textContent="";

    document.getElementById("lessons").innerHTML=`
      <div class="no-results">

        ❌ Unable to load lessons

        <br><br>

        <button
          onclick="loadLessons()"
          style="
            padding:9px 15px;
            border:0;
            border-radius:10px;
            background:#155eef;
            color:#fff;
            cursor:pointer">
          Try Again
        </button>

      </div>
    `;
  }
}

function getTitle(lesson){

  const number=Number(
    lesson.lesson_number
  );

  return(
    lesson.title ||
    lesson.title_en ||
    lesson.name ||
    freeTitles[number]?.[getLanguage()] ||
    freeTitles[number]?.en ||
    `Lesson ${number}`
  );
}

function renderLessons(list){

  const box=document.getElementById("lessons");

  if(!list.length){

    box.innerHTML=`
      <div class="no-results">
        🔎 No lessons found
      </div>
    `;

    return;
  }

  box.innerHTML=list.map(lesson=>{

    const number=Number(
      lesson.lesson_number
    );

    const title=getTitle(lesson);

    const isFree=
      Number(lesson.is_free)===1;

    const unlocked=
      isFree || premiumActive;

    return`

      <div
        class="lesson-card"
        onclick="openLesson(${number},${unlocked})">

        <div class="lesson-number">
          ${number}
        </div>

        <div class="lesson-info">

          <div class="lesson-title">
            ${escapeHtml(title)}
          </div>

          <div class="lesson-status ${
            unlocked
              ? "free"
              : "locked"
          }">

            ${
              unlocked
                ? "▶ Start Lesson"
                : "🔒 Premium — Tap to Unlock"
            }

          </div>

        </div>

      </div>

    `;

  }).join("");
}

function searchLessons(){

  const q=document
    .getElementById("lessonSearch")
    .value
    .trim()
    .toLowerCase();

  if(!q){

    document.getElementById("lessonCount").textContent=
      `${allLessons.length} lessons`;

    renderLessons(allLessons);

    return;
  }

  const results=allLessons.filter(lesson=>{

    const number=String(
      lesson.lesson_number || ""
    ).toLowerCase();

    const title=String(
      lesson.title ||
      lesson.title_en ||
      lesson.name ||
      ""
    ).toLowerCase();

    const unit=String(
      lesson.unit || ""
    ).toLowerCase();

    const code=String(
      lesson.lesson_code || ""
    ).toLowerCase();

    return(
      number.includes(q) ||
      title.includes(q) ||
      unit.includes(q) ||
      code.includes(q)
    );

  });

  document.getElementById("lessonCount").textContent=
    `${results.length} lessons found`;

  renderLessons(results);
}

async function checkPremium(){

  const t=getToken();

  if(!t){

    premiumActive=false;

    document.getElementById("status").textContent=
      "Free access — Lessons 1–10 are available";

    document.getElementById("premiumBox")
      .classList.remove("hidden");

    renderLessons(allLessons);

    return;
  }

  try{

    const r=await fetch(
      `${API}/premium/status?course=facebook-creator`,
      {
        headers:{
          Authorization:`Bearer ${t}`
        }
      }
    );

    const d=await r.json();

    let active=
      d.active===true ||
      d.premium===true ||
      d.is_premium===true ||
      String(d.status || "").toUpperCase()==="ACTIVE" ||
      String(d.membership_status || "").toUpperCase()==="PREMIUM";

    const expiry=
      d.expires_at ||
      d.membership_expiry ||
      d.expiry ||
      d.expiry_date ||
      null;

    if(expiry){

      const time=
        new Date(expiry).getTime();

      if(
        !isNaN(time) &&
        time<=Date.now()
      ){
        active=false;
      }
    }

    premiumActive=active;

    if(active){

      document.getElementById("status").textContent=
        "✓ Premium Active — All lessons unlocked";

      document.getElementById("premiumBox")
        .classList.add("hidden");

    }else{

      document.getElementById("status").textContent=
        "Premium not active — Lessons 1–10 are free";

      document.getElementById("premiumBox")
        .classList.remove("hidden");
    }

    renderLessons(allLessons);

  }catch(e){

    premiumActive=false;

    document.getElementById("status").textContent=
      "Premium not active — Lessons 1–10 are free";

    document.getElementById("premiumBox")
      .classList.remove("hidden");

    renderLessons(allLessons);
  }
}

function openLesson(number,unlocked){

  if(unlocked){

    location.href=
      `/fb/lesson.html?lesson=${encodeURIComponent(number)}&language=${encodeURIComponent(getLanguage())}`;

    return;
  }

  /*
    Locked Premium lesson:
    directly open the same PayHere checkout
    used by the Get Premium button.
  */

  buyPremium();
}

async function buyPremium(){

  const t=getToken();

  if(!t){

    location.href="/fb/login.html";

    return;
  }

  const btn=
    document.getElementById("buyBtn");

  if(btn){

    btn.disabled=true;
    btn.textContent=
      "Preparing Payment...";
  }

  try{

    const r=await fetch(
      `${PAY}/premium-checkout`,
      {
        method:"POST",

        headers:{
          Authorization:`Bearer ${t}`,
          "Content-Type":"application/json"
        },

        body:JSON.stringify({
          course:"facebook-creator"
        })
      }
    );

    const d=await r.json();

    if(!r.ok){

      throw new Error(
        d.error ||
        d.message ||
        "Payment could not be started"
      );
    }

    const fields=
      d.fields ||
      d.checkout;

    if(
      !fields ||
      typeof fields!=="object"
    ){

      throw new Error(
        "Payment information unavailable"
      );
    }

    const form=
      document.createElement("form");

    form.method="POST";

    form.action=
      "https://www.payhere.lk/pay/checkout";

    form.style.display="none";

    Object.entries(fields).forEach(
      ([key,value])=>{

        if(
          value===undefined ||
          value===null
        ){
          return;
        }

        const input=
          document.createElement("input");

        input.type="hidden";
        input.name=key;
        input.value=value;

        form.appendChild(input);
      }
    );

    document.body.appendChild(form);

    form.submit();

  }catch(e){

    alert(
      e.message ||
      "Payment error"
    );

    if(btn){

      btn.disabled=false;

      btn.textContent=
        "⭐ Get Premium";
    }
  }
}

function changeLanguage(lang){

  localStorage.setItem(
    "fb_language",
    lang
  );

  setLanguageButtons();

  document.getElementById("lessonSearch").value="";

  loadLessons();
}

function logout(){

  localStorage.removeItem(
    "createlk_token"
  );

  localStorage.removeItem(
    "createlk_customer"
  );

  location.href="/fb/login.html";
}

function escapeHtml(value){

  return String(value)
    .replace(/&/g,"&amp;")
    .replace(/</g,"&lt;")
    .replace(/>/g,"&gt;")
    .replace(/"/g,"&quot;")
    .replace(/'/g,"&#039;");
}

async function init(){

  setLanguageButtons();

  await loadLessons();

  await checkPremium();
}

init();

</script>

</body>
</html>