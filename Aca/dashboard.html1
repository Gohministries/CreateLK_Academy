<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>CreateLK Academy</title>

<style>
*{box-sizing:border-box;margin:0}

body{
font-family:Arial,sans-serif;
background:linear-gradient(180deg,#f8faff,#eef3ff);
color:#172033
}

header{
background:linear-gradient(135deg,#0f172a,#1e3a8a,#312e81);
color:#fff;
padding:16px 20px
}

.head,.wrap{
max-width:1050px;
margin:auto
}

.head{
display:flex;
justify-content:space-between;
align-items:center
}

.logo{
font-size:22px;
font-weight:800
}

.logo b{
color:#fbbf24
}

button,select{
font:inherit;
cursor:pointer
}

.logout{
background:#ffffff18;
color:#fff;
border:1px solid #ffffff30;
padding:9px 14px;
border-radius:9px;
font-weight:bold
}

.wrap{
padding:24px 15px 50px
}

.hero{
padding:40px 20px;
text-align:center;
color:#fff;
border-radius:23px;
background:linear-gradient(135deg,#1d4ed8,#4338ca,#312e81);
box-shadow:0 12px 30px #312e8135
}

.hero small{
letter-spacing:1.5px
}

.hero h1{
font-size:35px;
margin:10px 0
}

.hero p{
line-height:1.6
}

.badge{
display:inline-block;
margin-top:18px;
padding:8px 15px;
border:1px solid #ffffff35;
background:#ffffff18;
border-radius:30px;
font-size:13px;
font-weight:bold
}

.card{
background:#fff;
border:1px solid #e2e8f0;
border-radius:18px;
padding:20px;
margin-top:18px;
box-shadow:0 6px 22px #1e3a8a12
}

/* DAILY LESSON */

.daily{
background:linear-gradient(135deg,#eef4ff,#f5f0ff);
border-color:#c7d2fe;
text-align:center
}

.daily-label{
font-size:12px;
font-weight:bold;
letter-spacing:1px;
color:#4f46e5
}

.daily h2{
font-size:25px;
margin:8px 0
}

.daily-number{
font-size:12px;
font-weight:bold;
color:#2563eb;
margin-bottom:7px
}

.daily p{
color:#64748b;
font-size:14px;
line-height:1.5
}

.daily-buttons{
display:flex;
justify-content:center;
gap:10px;
margin-top:16px;
flex-wrap:wrap
}

.start-daily{
background:linear-gradient(135deg,#2563eb,#4338ca);
color:#fff;
border:0;
padding:11px 20px;
border-radius:10px;
font-weight:bold
}

.random-daily{
background:#fff;
color:#4338ca;
border:1px solid #c7d2fe;
padding:11px 20px;
border-radius:10px;
font-weight:bold
}

.section{
text-align:center;
margin:30px 0 15px;
color:#172554
}

#lessons{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:14px
}

.lesson{
background:#fff;
padding:18px;
border-radius:16px;
border:1px solid #dbe4f0;
transition:.2s
}

.lesson:hover{
transform:translateY(-3px);
box-shadow:0 8px 20px #2563eb15
}

.num{
font-size:11px;
font-weight:bold;
color:#2563eb;
letter-spacing:.7px
}

.lesson h3{
font-size:16px;
margin:8px 0
}

.lesson p{
font-size:13px;
color:#64748b;
line-height:1.5
}

.bottom{
display:flex;
justify-content:space-between;
align-items:center;
margin-top:13px
}

.free{
font-size:11px;
font-weight:bold;
color:#16a34a
}

.open,.complete{
background:linear-gradient(135deg,#2563eb,#4338ca);
color:#fff;
border:0;
padding:9px 14px;
border-radius:9px;
font-weight:bold
}

.lock{
background:#eef2f7;
color:#64748b;
border:0;
padding:9px 13px;
border-radius:9px
}

/* MODAL */

.modal-bg{
display:none;
position:fixed;
inset:0;
background:#0f172acc;
padding:15px;
overflow:auto;
z-index:5
}

.modal{
max-width:760px;
margin:20px auto;
background:#fff;
border-radius:20px;
overflow:hidden
}

.modal-head{
background:linear-gradient(135deg,#1e3a8a,#4338ca);
color:#fff;
padding:22px;
position:relative
}

.close{
position:absolute;
right:12px;
top:10px;
background:#ffffff20;
color:#fff;
border:0;
padding:4px 10px;
border-radius:8px;
font-size:22px
}

.modal-body{
padding:18px
}

.controls{
display:flex;
gap:8px;
margin-bottom:15px
}

.language-select,.play,.stop{
flex:1;
padding:11px;
border-radius:9px
}

.language-select{
border:1px solid #dbe4f0;
background:#f8faff;
font-weight:bold
}

.play{
background:#1e3a8a;
color:#fff;
border:0;
font-weight:bold
}

.stop{
background:#dc2626;
color:#fff;
border:0;
font-weight:bold
}

.dialogue{
padding:16px;
margin:10px 0;
border:1px solid #e2e8f0;
border-radius:14px;
background:#fbfdff
}

.dialogue.playing{
border-color:#2563eb;
box-shadow:0 0 0 3px #2563eb18
}

.lang{
font-size:10px;
font-weight:bold;
color:#2563eb;
margin-top:10px
}

.text{
margin-top:4px;
line-height:1.5
}

.loading{
text-align:center;
padding:30px;
color:#64748b
}

.error{
text-align:center;
padding:25px;
color:#dc2626
}

@media(max-width:750px){
#lessons{
grid-template-columns:repeat(2,1fr)
}
}

@media(max-width:520px){
.hero h1{
font-size:28px
}

#lessons{
grid-template-columns:1fr
}

.controls{
flex-wrap:wrap
}

.language-select{
flex-basis:100%
}

.play,.stop{
min-width:45%
}

.daily h2{
font-size:22px
}
}
</style>
</head>

<body>

<script>
if(!localStorage.getItem("createlk_token")){
document.documentElement.style.display="none";
location.replace("/Aca/login.html");
}
</script>

<header>
<div class="head">
<div class="logo">CreateLK <b>Academy</b></div>
<button class="logout" onclick="logout()">Logout</button>
</div>
</header>

<main class="wrap">

<section class="hero">
<small>ONLINE COURSE</small>
<h1>Spoken English</h1>
<p>Build confidence through practical conversations and real-life situations.</p>
<div class="badge">100 Lessons • 2,500 Practical Dialogues</div>
</section>

<section class="card daily">

<div class="daily-label">📚 TODAY'S LESSON</div>

<div id="dailyLesson">
<div class="loading">Choosing today's lesson...</div>
</div>

</section>

<section class="card premium-card" id="premiumCard">

<div class="premium-title">👑 Premium Membership</div>

<div class="price">LKR 999 • 30 Days</div>

<div id="premiumStatus" class="status">
Checking...
</div>

<button id="premiumBtn"
class="premium"
onclick="buyPremium()">
GET PREMIUM
</button>

</section>

<h2 class="section">100 Spoken English Lessons</h2>

<div id="lessons">
<div class="loading">Loading...</div>
</div>

</main>

<div id="modalBg" class="modal-bg">

<div class="modal">

<div class="modal-head">

<button class="close" onclick="closeLesson()">×</button>

<small id="modalNum">LESSON</small>

<h2 id="modalTitle">Loading...</h2>

</div>

<div id="modalBody" class="modal-body">

<div class="loading">
Loading lesson...
</div>

</div>

</div>

</div>

<script>

const API="https://createlk-academy-api.createlk.workers.dev";
const PAY="https://createlk-payhere.createlk.workers.dev";
const COURSE="spoken-english";

const token=localStorage.getItem("createlk_token");

const H={
"Content-Type":"application/json",
"Authorization":"Bearer "+token
};

const $=id=>document.getElementById(id);

let premium=false;
let dialogues=[];
let currentLesson=0;
let playing=false;
let selectedLanguage="en";

const titles=[
"Introducing Yourself",
"Greetings and Small Talk",
"Talking About Your Family",
"Talking About Your Home",
"Daily Routine",
"Morning Activities",
"Talking About Your Job",
"Talking About School",
"Talking About Friends",
"Asking for Personal Information",
"Meeting Someone New",
"Making a Phone Call",
"Sending a Message",
"Talking About the Time",
"Talking About the Date",
"Making Plans",
"Weekend Plans",
"Invitations",
"Accepting an Invitation",
"Refusing Politely",
"At the Restaurant",
"Ordering Food",
"Asking About a Menu",
"Paying the Bill",
"At a Café",
"Buying Groceries",
"At a Supermarket",
"Shopping for Clothes",
"Asking the Price",
"Returning an Item",
"At the Bus Stop",
"Taking a Bus",
"Taking a Taxi",
"Asking for Directions",
"Finding a Place",
"At the Train Station",
"Buying a Ticket",
"At the Airport",
"Checking Into a Hotel",
"Hotel Problems",
"Talking About Weather",
"Talking About Hobbies",
"Sports and Games",
"Music",
"Movies and TV",
"Reading Books",
"Weekend Activities",
"Holidays",
"Birthday Conversations",
"Celebrations",
"At the Doctor",
"Describing Symptoms",
"At the Pharmacy",
"Healthy Habits",
"Exercise and Fitness",
"Asking for Help",
"Offering Help",
"Giving Advice",
"Asking for Permission",
"Saying Sorry",
"Thanking Someone",
"Compliments",
"Agreeing and Disagreeing",
"Expressing Opinions",
"Making Suggestions",
"Making Decisions",
"Solving a Problem",
"Making a Complaint",
"Apologizing Professionally",
"Workplace Conversations",
"Job Interviews",
"Talking With a Customer",
"Talking With a Manager",
"Making an Appointment",
"Office Phone Calls",
"Meetings",
"Giving Instructions",
"Asking Questions at Work",
"Discussing a Project",
"Talking About Money",
"Banking",
"Using an ATM",
"Online Shopping",
"Using the Internet",
"Social Media Conversations",
"Learning English",
"Practicing English",
"Common English Mistakes",
"Understanding Fast English",
"Everyday Expressions",
"Making Conversation",
"Keeping a Conversation Going",
"Speaking Politely",
"Speaking Confidently",
"Natural English",
"Travel Conversations",
"Emergency Conversations",
"Real-Life Situations",
"Advanced Everyday Conversations",
"Speaking English Confidently"
];

function esc(x){
return String(x??"").replace(/[&<>"']/g,m=>({
"&":"&amp;",
"<":"&lt;",
">":"&gt;",
'"':"&quot;",
"'":"&#039;"
}[m]));
}

/* DAILY LESSON */

function getDailyLesson(){

const now=new Date();

const key=
now.getFullYear()+"-"+
(now.getMonth()+1)+"-"+
now.getDate();

let hash=0;

for(let i=0;i<key.length;i++){
hash=(hash*31+key.charCodeAt(i))>>>0;
}

return (hash%100)+1;
}

let dailyLesson=getDailyLesson();

function showDailyLesson(){

const n=dailyLesson;
const title=titles[n-1];

$("dailyLesson").innerHTML=`

<div class="daily-number">
LESSON ${n} OF 100
</div>

<h2>${esc(title)}</h2>

<p>
Today's recommended lesson to help you build
practical English speaking confidence.
</p>

<div class="daily-buttons">

<button class="start-daily"
onclick="openLesson(${n})">
▶ Start Today's Lesson
</button>

<button class="random-daily"
onclick="anotherDailyLesson()">
🎲 Try Another
</button>

</div>
`;
}

function anotherDailyLesson(){

let n;

do{
n=Math.floor(Math.random()*100)+1;
}while(n===dailyLesson);

dailyLesson=n;

showDailyLesson();
}

/* LESSONS */

async function loadLessons(){

try{

const r=await fetch(
`${API}/lessons?course=${COURSE}&language=en`,
{headers:H}
);

if(r.status===401)return logout();

const d=await r.json();

if(!r.ok||!d.success)
throw Error(d.error||"Unable to load lessons");

premium=!!d.premium;

$("premiumStatus").innerHTML=premium?
'<span class="active">✓ Premium Active</span>':
"Premium not active";

$("premiumBtn").style.display=
premium?"none":"inline-block";

const api=d.lessons||[];

$("lessons").innerHTML=titles.map((title,i)=>{

const n=i+1;

const a=api.find(
x=>+x.lesson_number===n
);

const free=
n===1||
+a?.is_free===1;

const unlocked=
free||premium;

return `
<article class="lesson">

<div class="num">
LESSON ${n}
</div>

<h3>
${esc(a?.title||title)}
</h3>

<p>
${esc(
a?.summary||
a?.objectives||
"Practical English conversation"
)}
</p>

<div class="bottom">

<span class="free">
${free?"FREE":"PREMIUM"}
</span>

<button
class="${unlocked?"open":"lock"}"
onclick="${
unlocked
?`openLesson(${n})`
:"buyPremium()"
}">
${unlocked?"Open":"🔒 Locked"}
</button>

</div>

</article>
`;

}).join("");

}catch(e){

$("lessons").innerHTML=
`<div class="error">${esc(e.message)}</div>`;

}
}

/* GET LESSON */

async function getLesson(n,lang){

const r=await fetch(
`${API}/lesson?course=${COURSE}&lesson=${n}&language=${lang}`,
{headers:H}
);

if(r.status===401){

logout();
throw Error("Login expired");

}

const d=await r.json();

if(!r.ok||!d.success)
throw Error(
d.error||"Lesson unavailable"
);

return d;
}

/* OPEN LESSON */

async function openLesson(n){

stopSpeech();

currentLesson=n;
selectedLanguage="en";

$("modalBg").style.display="block";

$("modalNum").textContent=
"LESSON "+n;

$("modalTitle").textContent=
"Loading...";

$("modalBody").innerHTML=
'<div class="loading">Loading lesson...</div>';

try{

const [en,si,ta]=await Promise.all([
getLesson(n,"en"),
getLesson(n,"si"),
getLesson(n,"ta")
]);

const ed=en.lesson.dialogues||[];
const sd=si.lesson?.dialogues||[];
const td=ta.lesson?.dialogues||[];

$("modalTitle").textContent=
en.lesson.title;

dialogues=ed.map((x,i)=>({

number:x.dialogue_number,

lines:[

["English",
x.speaker_a,
x.text_a],

["English",
x.speaker_b,
x.text_b],

["Sinhala",
sd[i]?.speaker_a,
sd[i]?.text_a],

["Sinhala",
sd[i]?.speaker_b,
sd[i]?.text_b],

["Tamil",
td[i]?.speaker_a,
td[i]?.text_a],

["Tamil",
td[i]?.speaker_b,
td[i]?.text_b]

]

}));

renderModal();

}catch(e){

$("modalBody").innerHTML=
`<div class="error">${esc(e.message)}</div>`;

}
}

/* DIALOGUE DISPLAY */

function linesHTML(d){

return d.lines.map(x=>{

const show=
selectedLanguage==="en"
?x[0]==="English"
:selectedLanguage==="ta"
?x[0]==="English"||x[0]==="Tamil"
:x[0]==="English"||x[0]==="Sinhala";

return show&&x[2]
?`
<div class="lang">
${x[0]}
</div>

<div class="text">
<b>${esc(x[1])}:</b>
${esc(x[2])}
</div>
`
:"";

}).join("");

}

/* MODAL */

function renderModal(){

let html=`

<div class="controls">

<select
id="languageSelect"
class="language-select"
onchange="changeLanguage()">

<option value="en">
English Only
</option>

<option value="ta">
English → Tamil
</option>

<option value="si">
English → Sinhala
</option>

</select>

<button
id="playBtn"
class="play"
onclick="playAll()">
▶️ Play All
</button>

<button
class="stop"
onclick="stopSpeech()">
⏹️ Stop
</button>

</div>
`;

html+=dialogues.map((d,i)=>`

<div class="dialogue" id="d${i}">

<div class="num">
DIALOGUE ${d.number}
</div>

${linesHTML(d)}

</div>

`).join("");

$("modalBody").innerHTML=html;
}

function changeLanguage(){

selectedLanguage=
$("languageSelect").value;

stopSpeech();

dialogues.forEach((d,i)=>{

const box=$("d"+i);

box.innerHTML=
`
<div class="num">
DIALOGUE ${d.number}
</div>
${linesHTML(d)}
`;

box.className="dialogue";

});

}

/* PLAY */

function playAll(){

stopSpeech();

if(!dialogues.length)return;

playing=true;

$("playBtn").textContent=
"⏸️ Playing...";

let i=0;

function next(){

if(!playing||i>=dialogues.length){

stopSpeech();
return;

}

const d=dialogues[i];

const box=$("d"+i);

document
.querySelectorAll(".dialogue")
.forEach(x=>
x.classList.remove("playing")
);

box?.classList.add("playing");

box?.scrollIntoView({
behavior:"smooth",
block:"center"
});

const allowed=
selectedLanguage==="en"
?["English"]
:selectedLanguage==="ta"
?["English","Tamil"]
:["English","Sinhala"];

const lines=
d.lines.filter(
x=>allowed.includes(x[0])
);

speak(lines,0,()=>{

i++;
next();

});

}

next();

}

/* SPEECH */

function speak(lines,i,done){

if(!playing||i>=lines.length){

done();
return;

}

const u=
new SpeechSynthesisUtterance(
lines[i][2]
);

u.lang={
English:"en-US",
Tamil:"ta-LK",
Sinhala:"si-LK"
}[lines[i][0]];

u.rate=.88;

u.onend=()=>
speak(lines,i+1,done);

u.onerror=()=>
speak(lines,i+1,done);

speechSynthesis.speak(u);

}

/* STOP */

function stopSpeech(){

playing=false;

speechSynthesis.cancel();

document
.querySelectorAll(".dialogue")
.forEach(x=>
x.classList.remove("playing")
);

if($("playBtn"))
$("playBtn").textContent=
"▶️ Play All";

}

/* PREMIUM */

async function buyPremium(){

const b=$("premiumBtn");

if(!b||b.disabled)return;

b.disabled=true;
b.textContent="Connecting...";

try{

const r=await fetch(
`${PAY}/premium-checkout`,
{
method:"POST",
headers:H,
body:"{}"
}
);

if(r.status===401)
return logout();

const d=await r.json();

if(!r.ok||!d.success)
throw Error(
d.error||
d.message||
"Checkout failed"
);

const fields=
d.fields||d.checkout;

const form=
document.createElement("form");

form.method="POST";

form.action=
"https://www.payhere.lk/pay/checkout";

Object.entries(fields).forEach(
([k,v])=>{

const input=
document.createElement("input");

input.type="hidden";
input.name=k;
input.value=v??"";

form.appendChild(input);

});

document.body.appendChild(form);

form.submit();

}catch(e){

alert(e.message||"Payment failed");

b.disabled=false;
b.textContent="GET PREMIUM";

}

}

/* CLOSE */

function closeLesson(){

stopSpeech();

$("modalBg").style.display="none";

}

function logout(){

localStorage.removeItem(
"createlk_token"
);

localStorage.removeItem(
"createlk_customer"
);

sessionStorage.clear();

location.replace("/index.html");

}

$("modalBg").onclick=e=>{

if(e.target===$("modalBg"))
closeLesson();

};

/* START */

showDailyLesson();
loadLessons();

</script>

</body>
</html>