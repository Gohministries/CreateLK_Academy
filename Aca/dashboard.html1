<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>CreateLK Academy</title>
<style>
*{box-sizing:border-box;margin:0}
body{font-family:Arial,sans-serif;background:linear-gradient(180deg,#f8faff,#eef3ff);color:#172033}
header{background:linear-gradient(135deg,#0f172a,#1e3a8a,#312e81);color:#fff;padding:17px 20px}
.head,.wrap{max-width:1050px;margin:auto}.head{display:flex;justify-content:space-between;align-items:center}
.logo{font-size:22px;font-weight:800}.logo b{color:#fbbf24}
button,select{font:inherit;cursor:pointer}.logout{background:#ffffff18;color:#fff;border:1px solid #ffffff30;padding:9px 14px;border-radius:10px;font-weight:bold}
.wrap{padding:25px 15px 55px}
.hero{padding:42px 28px;border-radius:25px;color:#fff;text-align:center;background:linear-gradient(135deg,#1d4ed8,#4338ca,#312e81);box-shadow:0 14px 35px #312e8140}
.hero small{font-weight:bold;letter-spacing:1.5px;opacity:.85}.hero h1{font-size:36px;margin:10px 0}.hero p{line-height:1.6}.badge{display:inline-block;margin-top:20px;background:#ffffff18;border:1px solid #ffffff30;padding:9px 16px;border-radius:30px;font-size:13px;font-weight:bold}
.card{background:#fff;padding:21px;border-radius:20px;margin-top:19px;box-shadow:0 7px 25px #1e3a8a12;border:1px solid #e2e8f0}
.premium-card{background:linear-gradient(135deg,#fffdf5,#fff7df);border-color:#f5d77a}.row{display:flex;flex-direction:column;align-items:center;text-align:center;gap:15px}
.premium-title{font-size:18px;font-weight:800;color:#92400e}.price{font-size:19px;font-weight:800;margin-top:6px}.status{font-size:13px;color:#64748b}.active{color:#15803d;font-weight:bold}
.premium{background:linear-gradient(135deg,#f59e0b,#d97706);color:#fff;padding:12px 24px;border:0;border-radius:11px;font-weight:800}.premium:disabled{opacity:.6}
.certificate{text-align:center}.certificate-btn{width:100%;max-width:320px;background:linear-gradient(135deg,#2563eb,#4338ca);color:#fff;border:0;padding:13px;border-radius:11px;font-weight:800}
.section{text-align:center;margin:32px 0 16px;color:#172554}
#lessons{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}
.lesson{background:linear-gradient(145deg,#fff,#f8faff);padding:18px;border-radius:18px;border:1px solid #dbe4f0;transition:.2s}
.lesson:hover{transform:translateY(-3px);box-shadow:0 10px 25px #2563eb18}
.num{font-size:11px;font-weight:800;color:#2563eb;letter-spacing:.8px}.lesson h3{font-size:16px;line-height:1.4;margin-top:7px}.lesson p{font-size:13px;color:#64748b;margin-top:7px;line-height:1.5}
.bottom{display:flex;justify-content:space-between;align-items:center;margin-top:15px}.free{color:#16a34a;font-weight:bold;font-size:11px}
.open,.complete{background:linear-gradient(135deg,#2563eb,#4338ca);color:#fff;border:0;padding:9px 14px;border-radius:9px;font-weight:bold}.lock{background:#eef2f7;color:#64748b;border:0;padding:9px 13px;border-radius:9px}
.progress{height:7px;background:#e5e7eb;border-radius:20px;overflow:hidden;margin:10px 0}.fill{height:100%;background:linear-gradient(90deg,#2563eb,#7c3aed);width:0}
.modal-bg{display:none;position:fixed;inset:0;background:#0f172acc;backdrop-filter:blur(5px);padding:15px;overflow:auto;z-index:10}
.modal{background:#fff;max-width:760px;margin:25px auto;border-radius:22px;overflow:hidden}
.modal-head{background:linear-gradient(135deg,#1e3a8a,#4338ca);color:#fff;padding:24px;position:relative}.close{position:absolute;right:15px;top:12px;background:#ffffff20;color:#fff;border:0;font-size:22px;border-radius:9px;padding:4px 10px}
.modal-body{padding:20px}.controls{display:flex;gap:10px;margin-bottom:18px}.controls>*{flex:1}
.play,.stop{border:0;padding:12px;border-radius:10px;font-weight:bold}.play{background:#1e3a8a;color:#fff}.stop{background:#dc2626;color:#fff}.language-select{border:1px solid #dbe4f0;border-radius:10px;padding:12px;background:#f8faff;font-weight:bold}
.dialogue{padding:17px;margin:12px 0;border:1px solid #e2e8f0;border-radius:15px;background:#fbfdff}.dialogue.playing{border-color:#2563eb;box-shadow:0 0 0 3px #2563eb18}.dialogue.saved{border-color:#16a34a;background:#f0fdf4}
.lang{font-size:11px;font-weight:bold;color:#2563eb;margin-top:12px}.text{margin-top:4px;line-height:1.55}.loading{text-align:center;padding:35px;color:#64748b}.error{text-align:center;padding:30px;color:#dc2626}
@media(max-width:750px){#lessons{grid-template-columns:repeat(2,1fr)}.hero h1{font-size:29px}}
@media(max-width:520px){.wrap{padding:18px 12px 40px}.hero{padding:30px 20px}.hero h1{font-size:27px}.premium{width:100%}#lessons{grid-template-columns:1fr}.controls{flex-wrap:wrap}.language-select{width:100%;flex:none}}
</style>
</head>

<body>

<script>
if(!localStorage.getItem("createlk_token")){
 document.documentElement.style.display="none";
 location.replace("/auth/login.html");
}
</script>

<header>
<div class="head">
<div class="logo">CreateLK <b>Academy</b></div>
<button class="logout" onclick="logout()">Logout</button>
</div>
</header>

<main class="wrap">

<section class="hero">
<small>ONLINE COURSE</small>
<h1>Spoken English</h1>
<p>Build confidence through practical conversations and real-life situations.</p>
<span class="badge">100 Lessons • 2,500 Practical Dialogues</span>
</section>

<section class="card">
<b>Your Progress</b>
<div class="progress"><div id="totalFill" class="fill"></div></div>
<div id="totalText" class="status">0 / 2,500 dialogues • 0 / 100 lessons</div>
</section>

<section class="card premium-card">
<div class="row">
<div>
<div class="premium-title">👑 Premium Membership</div>
<div class="price">LKR 999 <span class="status">• 30 Days</span></div>
<div id="premiumStatus" class="status">Checking...</div>
</div>
<button id="premiumBtn" class="premium" onclick="buyPremium()">GET PREMIUM</button>
</div>
</section>

<section class="card certificate">
<button class="certificate-btn" onclick="location.href='/auth/certificate.html'">
🎓 GET YOUR CERTIFICATE
</button>
</section>

<h2 class="section">100 Spoken English Lessons</h2>
<div id="lessons"><div class="loading">Loading...</div></div>

</main>

<div id="modalBg" class="modal-bg">
<div class="modal">
<div class="modal-head">
<button class="close" onclick="closeLesson()">×</button>
<small id="modalNum">LESSON</small>
<h2 id="modalTitle">Loading...</h2>
</div>
<div id="modalBody" class="modal-body"></div>
</div>
</div>

<script>
const API="https://createlk-academy-api.createlk.workers.dev";
const PAY="https://createlk-payhere.createlk.workers.dev";
const COURSE="spoken-english";
const token=localStorage.getItem("createlk_token");
const H={"Content-Type":"application/json","Authorization":"Bearer "+token};

let premium=false,completed=[],played=new Set(),dialogues=[],playing=false,language="en";

const $=x=>document.getElementById(x);

const titles=[
"Introducing Yourself","Greetings and Small Talk","Talking About Your Family","Talking About Your Home",
"Daily Routine","Morning Activities","Talking About Your Job","Talking About School","Talking About Friends",
"Asking for Personal Information","Meeting Someone New","Making a Phone Call","Sending a Message","Talking About the Time",
"Talking About the Date","Making Plans","Weekend Plans","Invitations","Accepting an Invitation","Refusing Politely",
"At the Restaurant","Ordering Food","Asking About a Menu","Paying the Bill","At a Café","Buying Groceries",
"At a Supermarket","Shopping for Clothes","Asking the Price","Returning an Item","At the Bus Stop","Taking a Bus",
"Taking a Taxi","Asking for Directions","Finding a Place","At the Train Station","Buying a Ticket","At the Airport",
"Checking Into a Hotel","Hotel Problems","Talking About Weather","Talking About Hobbies","Sports and Games","Music",
"Movies and TV","Reading Books","Weekend Activities","Holidays","Birthday Conversations","Celebrations","At the Doctor",
"Describing Symptoms","At the Pharmacy","Healthy Habits","Exercise and Fitness","Asking for Help","Offering Help",
"Giving Advice","Asking for Permission","Saying Sorry","Thanking Someone","Compliments","Agreeing and Disagreeing",
"Expressing Opinions","Making Suggestions","Making Decisions","Solving a Problem","Making a Complaint",
"Apologizing Professionally","Workplace Conversations","Job Interviews","Talking With a Customer","Talking With a Manager",
"Making an Appointment","Office Phone Calls","Meetings","Giving Instructions","Asking Questions at Work","Discussing a Project",
"Talking About Money","Banking","Using an ATM","Online Shopping","Using the Internet","Social Media Conversations",
"Learning English","Practicing English","Common English Mistakes","Understanding Fast English","Everyday Expressions",
"Making Conversation","Keeping a Conversation Going","Speaking Politely","Speaking Confidently","Natural English",
"Travel Conversations","Emergency Conversations","Real-Life Situations","Advanced Everyday Conversations",
"Speaking English Confidently"
];

function esc(x){
return String(x??"").replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[m]));
}

/* PROGRESS */

function normalizePlayed(a){
const s=new Set();
(a||[]).forEach(x=>{
if(typeof x==="string"){
const m=x.match(/^(\d+):(\d+)$/);
if(m)s.add(`${+m[1]}:${+m[2]}`);
}else if(x){
const l=x.lesson_number??x.lesson??x.lessonNumber;
const d=x.dialogue_number??x.dialogue??x.dialogueNumber;
if(l!=null&&d!=null)s.add(`${+l}:${+d}`);
}
});
return s;
}

function lessonProgress(n){
let c=0,p=n+":";
for(const x of played)if(x.startsWith(p))c++;
return Math.min(c,25);
}

function updateProgress(){
const n=played.size;
$("totalFill").style.width=Math.min(n/25,100)+"%";
$("totalText").textContent=`${n.toLocaleString()} / 2,500 dialogues • ${completed.length} / 100 lessons`;
}

/* LESSONS */

async function loadLessons(){
try{
const r=await fetch(`${API}/progress?course=${COURSE}`,{headers:H,cache:"no-store"});
if(r.status===401)return logout();

const d=await r.json();

premium=!!d.premium;
completed=(d.completed_lessons||[]).map(Number);
played=normalizePlayed(d.played_dialogues);

$("premiumStatus").innerHTML=premium
?'<span class="active">✓ Premium Active</span>'
:"Premium not active";

$("premiumBtn").style.display=premium?"none":"block";

updateProgress();

const lr=await fetch(`${API}/lessons?course=${COURSE}&language=en`,{headers:H});
const ld=await lr.json();
const list=ld.lessons||[];

$("lessons").innerHTML=titles.map((title,i)=>{
const n=i+1,x=list.find(a=>+a.lesson_number===n);
const free=n===1||+x?.is_free===1;
const unlocked=free||premium;
const done=completed.includes(n);
const p=lessonProgress(n);

return `
<article class="lesson">
<div class="num">LESSON ${n}</div>
<h3>${esc(x?.title||title)}</h3>
<p>${esc(x?.summary||"Practical English conversation")}</p>
<div class="progress"><div class="fill" style="width:${p*4}%"></div></div>
<div class="bottom">
<span class="free">${done?"✓ COMPLETED":free?"FREE":"PREMIUM"} • ${p}/25</span>
<button class="${unlocked?"open":"lock"}" onclick="${unlocked?`openLesson(${n})`:"buyPremium()"}">
${unlocked?"Open":"🔒 Locked"}
</button>
</div>
</article>`;
}).join("");

}catch(e){
$("lessons").innerHTML=`<div class="error">${esc(e.message||"Unable to load.")}</div>`;
}
}

/* LESSON */

async function getLesson(n,l){
const r=await fetch(`${API}/lesson?course=${COURSE}&lesson=${n}&language=${l}`,{headers:H});
if(r.status===401){logout();throw Error("Session expired");}
const d=await r.json();
if(!r.ok||!d.success)throw Error(d.error||d.message||"Lesson unavailable");
return d;
}

async function openLesson(n){
stopSpeech();

$("modalBg").style.display="block";
$("modalNum").textContent="LESSON "+n;
$("modalTitle").textContent=titles[n-1];
$("modalBody").innerHTML='<div class="loading">Loading...</div>';

try{
const [en,si,ta]=await Promise.all([getLesson(n,"en"),getLesson(n,"si"),getLesson(n,"ta")]);

const E=en.lesson.dialogues||[],S=si.lesson?.dialogues||[],T=ta.lesson?.dialogues||[];

dialogues=E.map((x,i)=>({
number:x.dialogue_number,
lines:[
["English",x.speaker_a,x.text_a],["English",x.speaker_b,x.text_b],
["Sinhala",S[i]?.speaker_a,S[i]?.text_a],["Sinhala",S[i]?.speaker_b,S[i]?.text_b],
["Tamil",T[i]?.speaker_a,T[i]?.text_a],["Tamil",T[i]?.speaker_b,T[i]?.text_b]
]
}));

renderLesson(n);

}catch(e){
$("modalBody").innerHTML=`<div class="error">${esc(e.message)}</div>`;
}
}

function visible(x){
return language==="en"
?x[0]==="English"
:language==="ta"
?x[0]==="English"||x[0]==="Tamil"
:x[0]==="English"||x[0]==="Sinhala";
}

function renderLines(d){
return d.lines.map(x=>visible(x)&&x[2]?`
<div class="lang">${x[0]}</div>
<div class="text"><b>${esc(x[1])}:</b> ${esc(x[2])}</div>`:"").join("");
}

function renderLesson(n){
$("modalBody").innerHTML=`
<div class="controls">
<select id="languageSelect" class="language-select" onchange="changeLanguage()">
<option value="en">English Only</option>
<option value="ta">English → Tamil</option>
<option value="si">English → Sinhala</option>
</select>
<button id="playBtn" class="play" onclick="playAll()">▶️ Play All</button>
<button class="stop" onclick="stopSpeech()">⏹ Stop</button>
</div>
<div id="dialogueList">
${dialogues.map((d,i)=>`
<div class="dialogue ${played.has(`${n}:${d.number}`)?"saved":""}" id="d${i}">
<div class="num">DIALOGUE ${d.number}</div>${renderLines(d)}
</div>`).join("")}
</div>
<button class="complete" onclick="completeLesson(${n})">✓ Mark Lesson Complete</button>`;
$("languageSelect").value=language;
}

/* DIALOGUE PROGRESS */

async function saveDialogue(lesson,n){
const key=`${lesson}:${n}`;
if(played.has(key))return;

played.add(key);
updateProgress();
loadLessons();

const i=dialogues.findIndex(x=>+x.number===+n);
$("d"+i)?.classList.add("saved");

try{
const r=await fetch(`${API}/dialogue/progress`,{
method:"POST",headers:H,
body:JSON.stringify({
course:COURSE,
lesson_number:+lesson,
dialogue_number:+n
})
});

if(r.status===401)return logout();

if(!r.ok){
played.delete(key);
updateProgress();
loadLessons();
$("d"+i)?.classList.remove("saved");
}
}catch(e){
played.delete(key);
updateProgress();
loadLessons();
$("d"+i)?.classList.remove("saved");
}
}

/* LANGUAGE */

function changeLanguage(){
language=$("languageSelect").value;
stopSpeech();
document.querySelectorAll(".dialogue").forEach((box,i)=>{
box.innerHTML=`<div class="num">DIALOGUE ${dialogues[i].number}</div>${renderLines(dialogues[i])}`;
});
}

/* SPEECH */

const voices={English:"en-US",Tamil:"ta-LK",Sinhala:"si-LK"};

function playAll(){
if(playing){stopSpeech();return}

playing=true;
$("playBtn").textContent="⏸️ Playing...";

let i=0;

function next(){
if(!playing||i>=dialogues.length){
stopSpeech();
return;
}

document.querySelectorAll(".dialogue").forEach(x=>x.classList.remove("playing"));

const box=$("d"+i);
box?.classList.add("playing");
box?.scrollIntoView({behavior:"smooth",block:"center"});

const allowed=language==="en"?["English"]:language==="ta"?["English","Tamil"]:["English","Sinhala"];
const lines=dialogues[i].lines.filter(x=>allowed.includes(x[0]));

speak(lines,0,()=>{
saveDialogue(currentLesson(),dialogues[i].number);
box?.classList.remove("playing");
i++;
next();
});
}

next();
}

function speak(lines,i,done){
if(!playing||i>=lines.length)return done();

const u=new SpeechSynthesisUtterance(lines[i][2]);
u.lang=voices[lines[i][0]];
u.rate=.88;
u.onend=()=>speak(lines,i+1,done);
u.onerror=()=>speak(lines,i+1,done);
speechSynthesis.speak(u);
}

function speakOne(i){
stopSpeech();
const lines=dialogues[i].lines.filter(x=>x[0]==="English");
speakOnce(lines);
}

function speakOnce(lines){
if(!lines.length)return;
const u=new SpeechSynthesisUtterance(lines[0][2]);
u.lang="en-US";
speechSynthesis.speak(u);
}

function stopSpeech(){
playing=false;
speechSynthesis.cancel();
document.querySelectorAll(".dialogue").forEach(x=>x.classList.remove("playing"));
if($("playBtn"))$("playBtn").textContent="▶️ Play All";
}

function currentLesson(){
return +$("modalNum").textContent.replace(/\D/g,"");
}

/* COMPLETE */

async function completeLesson(n){
try{
const r=await fetch(`${API}/lesson/complete`,{
method:"POST",headers:H,
body:JSON.stringify({course:COURSE,lesson_number:n})
});

if(r.status===401)return logout();

if(!r.ok)throw Error("Unable to complete lesson");

if(!completed.includes(n))completed.push(n);

closeLesson();
loadLessons();

}catch(e){alert(e.message)}
}

/* PREMIUM */

async function buyPremium(){
const btn=$("premiumBtn");
if(!btn||btn.disabled)return;

btn.disabled=true;
btn.textContent="Connecting...";

try{
const r=await fetch(`${PAY}/premium-checkout`,{
method:"POST",headers:H,body:"{}"
});

if(r.status===401)return logout();

const d=await r.json();
if(!r.ok||!d.success)throw Error(d.message||d.error||"Checkout failed");

const fields=d.fields||d.checkout;
if(!fields)throw Error("Payment details missing");

const f=document.createElement("form");
f.method="POST";
f.action="https://www.payhere.lk/pay/checkout";

Object.entries(fields).forEach(([k,v])=>{
const i=document.createElement("input");
i.type="hidden";i.name=k;i.value=v??"";
f.appendChild(i);
});

document.body.appendChild(f);
f.submit();

}catch(e){
alert(e.message||"Payment error");
btn.disabled=false;
btn.textContent="GET PREMIUM";
}
}

/* OTHER */

function closeLesson(){
stopSpeech();
$("modalBg").style.display="none";
}

function logout(){
localStorage.removeItem("createlk_token");
localStorage.removeItem("createlk_customer");
sessionStorage.clear();
location.replace("/index.html");
}

$("modalBg").onclick=e=>{
if(e.target===$("modalBg"))closeLesson();
};

loadLessons();
</script>

</body>
</html>