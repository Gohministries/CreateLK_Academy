<!doctype html><html><head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Prayer Attendance</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.4/jspdf.plugin.autotable.min.js"></script>
<style>
*{box-sizing:border-box}body{margin:0;font:14px Arial;background:#f4f7fb;color:#172033}button,input{font:inherit}button{border:0;cursor:pointer}.hidden{display:none!important}
.wrap{max-width:1050px;margin:auto;padding:12px}.login{min-height:100vh;display:grid;place-items:center;background:#102a56;padding:20px}.box,.card{background:#fff;padding:18px;border-radius:14px;box-shadow:0 3px 15px #0001}.login .box{width:min(380px,100%);text-align:center}.logo{font-size:30px;color:#d69b16;background:#102a56;border-radius:50%;width:60px;height:60px;display:grid;place-items:center;margin:auto}.login h1,h2{color:#102a56}.login h1{margin:10px 0}.login p{color:#687386}
input{padding:10px;border:1px solid #d5dce7;border-radius:8px;width:100%}.btn{padding:10px 13px;border-radius:8px;font-weight:bold}.p{background:#102a56;color:white}.g{background:#d69b16;color:white}.green{background:#16834b;color:white}.red{background:#d64545;color:white}.gray{background:#e8edf4}.full{width:100%}.msg{color:#d64545;min-height:20px;margin-top:7px}
header{background:#102a56;color:white;position:sticky;top:0;z-index:5}.head{max-width:1050px;margin:auto;padding:10px 12px;display:flex;justify-content:space-between;align-items:center}.brand{font-weight:bold;font-size:17px}.brand small{display:block;color:#d69b16;font-size:10px}.menu{position:relative}.menu>button{background:#ffffff18;color:white;font-size:20px;padding:8px 12px;border-radius:7px}.menu div{position:absolute;right:0;top:45px;background:white;width:160px;border-radius:9px;box-shadow:0 5px 20px #0003;overflow:hidden}.menu div button{display:block;width:100%;padding:11px;text-align:left;background:white}
.card{margin:12px 0}.card h2{font-size:18px;margin:0 0 12px}.grid{display:grid;grid-template-columns:1fr auto auto;gap:7px}.stats,.reportStats{display:grid;grid-template-columns:repeat(5,1fr);gap:7px;margin-top:8px}.reportStats{grid-template-columns:repeat(4,1fr)}.stat{background:#f5f7fa;padding:9px;text-align:center;border-radius:9px}.stat b{display:block;font-size:18px;color:#102a56}.stat span{font-size:10px;color:#687386}
.add{display:grid;grid-template-columns:1fr auto;gap:7px}.member{display:flex;justify-content:space-between;align-items:center;padding:8px;border:1px solid #e2e7ee;border-radius:8px;margin-top:6px}.member b{color:#102a56}.small{padding:6px 8px;border-radius:6px;font-size:12px}.row{display:flex;gap:7px;flex-wrap:wrap}.att{border:1px solid #e1e6ee;border-radius:10px;padding:10px;margin:7px 0}.attTop{display:flex;justify-content:space-between;gap:7px;margin-bottom:7px}.attName{font-weight:bold;color:#102a56}.status{display:flex;gap:5px}.status button{padding:6px 9px;border-radius:6px;background:#e9edf3}.yes{background:#16834b!important;color:white}.no{background:#d64545!important;color:white}.fields{display:grid;grid-template-columns:1fr 1fr;gap:7px}.field label{font-size:10px;color:#687386;display:block}.checks{display:flex;gap:7px;margin-top:6px}.check{flex:1;text-align:center;padding:7px;border:1px solid #dfe5ed;border-radius:7px;background:#f8fafc}.check input{width:auto}.reportBtns{display:flex;gap:7px;margin-top:7px}.table{overflow:auto;margin-top:8px}table{border-collapse:collapse;width:100%;min-width:650px}th,td{padding:7px;border-bottom:1px solid #ddd;text-align:left;white-space:nowrap}th{background:#102a56;color:white}.empty{text-align:center;padding:20px;color:#788496}footer{text-align:center;padding:15px;color:#7b8797;font-size:11px}.late{color:#c66b00;font-weight:bold}
.modal{position:fixed;inset:0;background:#0008;display:grid;place-items:center;padding:20px;z-index:10}.modal .box{width:min(380px,100%)}.modalBtns{display:flex;gap:7px;margin-top:8px}.modalBtns button{flex:1}
@media(max-width:700px){.stats,.reportStats{grid-template-columns:repeat(2,1fr)}.grid{grid-template-columns:1fr 1fr}.grid input{grid-column:1/-1}.attTop{flex-direction:column}.status button{flex:1}.fields{grid-template-columns:1fr}}@media(max-width:400px){.add{grid-template-columns:1fr}}
</style></head><body>

<section id="login" class="login"><div class="box">
<div class="logo">✝</div><h1>Prayer Attendance</h1><p>Korea - Sri Lanka Prayer Group</p>
<input id="pass" type="password" placeholder="Admin password"><button id="loginBtn" class="btn p full" style="margin-top:7px">Admin Login</button><div id="msg" class="msg"></div>
</div></section>

<section id="app" class="hidden"><header><div class="head">
<div class="brand">Prayer Attendance<small>Korea - Sri Lanka Prayer Group</small></div>
<div class="menu"><button id="menuBtn">☰</button><div id="menu" class="hidden">
<button onclick="go('top')">Dashboard</button><button onclick="go('members')">Members</button><button onclick="go('attendance')">Attendance</button><button onclick="go('report')">Period Report</button><button onclick="logout()">Logout</button>
</div></div></div></header>

<main id="top" class="wrap">

<section class="card"><h2>Daily Attendance</h2><div class="grid">
<input id="date" type="date"><button id="load" class="btn p">Load</button><button id="save" class="btn g">Save</button>
</div><div class="stats">
<div class="stat"><b id="mc">0</b><span>Members</span></div>
<div class="stat"><b id="pc">0</b><span>Present</span></div>
<div class="stat"><b id="ac">0</b><span>Absent</span></div>
<div class="stat"><b id="pct">0%</b><span>Attendance</span></div>
<div class="stat"><b id="pt">0h 0m</b><span>Prayer Time</span></div>
</div></section>

<section id="members" class="card"><h2>Saved Members</h2><div class="add">
<input id="name" placeholder="Member name"><button id="add" class="btn p">Add Member</button>
</div><div id="memberList"></div></section>

<section id="attendance" class="card"><h2>Attendance — <span id="day"></span></h2><div class="row">
<button id="all" class="btn green">Mark All Present</button><button id="saveAll" class="btn g">Save All</button><button id="delDay" class="btn red">Delete Day</button>
</div><div id="attList"></div></section>

<section id="report" class="card"><h2>Period Report</h2><div class="grid">
<input id="from" type="date"><input id="to" type="date"><button id="reportBtn" class="btn p">Load Report</button>
</div><div class="reportStats">
<div class="stat"><b id="totalAttendance">0</b><span>Total Attendance</span></div>
<div class="stat"><b id="micDays">0</b><span>Days Mic ON</span></div>
<div class="stat"><b id="videoDays">0</b><span>Days Video ON</span></div>
<div class="stat"><b id="activeDays">0</b><span>Fully Active Days</span></div>
<div class="stat"><b id="totalPresent">0</b><span>Total Present</span></div>
<div class="stat"><b id="totalAbsent">0</b><span>Total Absent</span></div>
<div class="stat"><b id="delayDays">0</b><span>Delay Days</span></div>
<div class="stat"><b id="totalPrayer">0h 0m</b><span>Total Prayer Time</span></div>
</div><div class="reportBtns"><button id="csv" class="btn green">CSV</button><button id="pdf" class="btn g">Download PDF</button></div>
<div id="reportList" class="table"></div></section>

<footer>Korea - Sri Lanka Prayer Group<br>Prayer Attendance</footer>
</main></section>

<div id="modal" class="modal hidden"><div class="box"><h2>Edit Member</h2><input id="editName"><div class="modalBtns">
<button id="cancel" class="btn gray">Cancel</button><button id="editSave" class="btn p">Save</button>
</div></div></div>

<script>
const API="https://attendance.createlk.workers.dev",KEY="prayer_attendance_admin",$=x=>document.getElementById(x);
let M=[],D=[],R=[],eid=null;
const esc=x=>String(x??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[c]));
const today=()=>new Date().toLocaleDateString("en-CA",{timeZone:"Asia/Colombo"});
const fmt=n=>(n=+n||0,`${Math.floor(n/60)}h ${n%60}m`);

async function api(p,o={}){let r=await fetch(API+p,{...o,headers:{"Content-Type":"application/json","X-Admin-Key":localStorage.getItem(KEY)||"",...(o.headers||{})}}),d=await r.json().catch(()=>({}));if(!r.ok)throw Error(d.error||"Request failed");return d}
function showApp(v){$("login").classList.toggle("hidden",v);$("app").classList.toggle("hidden",!v)}

async function login(){
let p=$("pass").value.trim();if(!p)return $("msg").textContent="Enter password.";
try{let r=await fetch(API+"/api/login",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({password:p})}),d=await r.json();
if(!r.ok||!d.success)throw Error(d.error||"Login failed");localStorage.setItem(KEY,p);showApp(1);init()
}catch(e){$("msg").textContent=e.message}
}

async function init(){$("date").value=today();$("from").value=today();$("to").value=today();await members();await day();await report()}

async function members(){
try{M=(await api("/api/members")).rows||[];$("mc").textContent=M.length;
$("memberList").innerHTML=M.length?M.map(m=>`<div class="member"><b>${esc(m.name)}</b><span><button class="small gray" onclick="edit(${m.id})">Edit</button> <button class="small red" onclick="removeM(${m.id})">Delete</button></span></div>`).join(""):`<div class="empty">No members.</div>`
}catch(e){alert(e.message)}
}

async function addM(){
let name=$("name").value.trim();if(!name)return alert("Enter member name.");
try{await api("/api/members",{method:"POST",body:JSON.stringify({name})});$("name").value="";await members();day()}catch(e){alert(e.message)}
}

function edit(id){let m=M.find(x=>+x.id===+id);if(!m)return;eid=id;$("editName").value=m.name;$("modal").classList.remove("hidden")}
async function editSave(){let name=$("editName").value.trim();if(!name)return;try{await api("/api/members/"+eid,{method:"PUT",body:JSON.stringify({name})});close();await members();day()}catch(e){alert(e.message)}}
function close(){$("modal").classList.add("hidden");eid=null}

async function removeM(id){
let m=M.find(x=>+x.id===+id);if(!m||!confirm(`Delete "${m.name}" and attendance records?`))return;
try{await api("/api/members/"+id,{method:"DELETE"});await members();await day();report()}catch(e){alert(e.message)}
}

async function day(){
let d=$("date").value;if(!d)return;$("day").textContent=d;
try{D=(await api("/api/day?date="+d)).rows||[];render()}catch(e){alert(e.message)}
}

function render(){
if(!D.length){$("attList").innerHTML=`<div class="empty">Add members first.</div>`;return stat()}
$("attList").innerHTML=D.map((x,i)=>{
let p=x.status==="PRESENT";
return `<div class="att"><div class="attTop"><b class="attName">${esc(x.name)}</b><div class="status">
<button class="${p?"yes":""}" onclick="status(${i},1)">Present</button>
<button class="${!p?"no":""}" onclick="status(${i},0)">Absent</button></div></div>
<div class="fields"><div><label>In Time</label><input type="time" value="${x.in_time||""}" ${p?"":"disabled"} onchange="time(${i},'in_time',this.value)"></div>
<div><label>Out Time</label><input type="time" value="${x.out_time||""}" ${p?"":"disabled"} onchange="time(${i},'out_time',this.value)"></div></div>
<div class="checks"><label class="check"><input type="checkbox" ${+x.mic?"checked":""} ${p?"":"disabled"} onchange="check(${i},'mic',this.checked)"> Mic ON</label>
<label class="check"><input type="checkbox" ${+x.video?"checked":""} ${p?"":"disabled"} onchange="check(${i},'video',this.checked)"> Video ON</label></div></div>`
}).join("");stat()
}

function status(i,p){
let x=D[i];x.status=p?"PRESENT":"ABSENT";
if(p){x.in_time||="05:00";x.out_time||="06:00"}else{x.in_time=x.out_time="";x.mic=x.video=0}
render()
}
function time(i,k,v){D[i][k]=v;stat()}
function check(i,k,v){D[i][k]=v?1:0}

function mins(x){
if(x.status!=="PRESENT"||!x.in_time||!x.out_time)return 0;
let a=x.in_time.split(":").map(Number),b=x.out_time.split(":").map(Number),n=b[0]*60+b[1]-a[0]*60-a[1];return n<0?n+1440:n
}

function delayed(x){return x.status==="PRESENT"&&((x.in_time&&x.in_time>"05:00")||(x.out_time&&x.out_time<"06:00"))}

function stat(){
let n=D.length,p=D.filter(x=>x.status==="PRESENT").length,m=D.reduce((s,x)=>s+mins(x),0);
$("mc").textContent=n;$("pc").textContent=p;$("ac").textContent=n-p;$("pct").textContent=n?Math.round(p/n*100)+"%":"0%";$("pt").textContent=fmt(m)
}

function allP(){D.forEach(x=>{x.status="PRESENT";x.in_time||="05:00";x.out_time||="06:00"});render()}

async function saveD(){
if(!D.length)return alert("No members.");
try{await api("/api/save",{method:"POST",body:JSON.stringify({rows:D.map(x=>({member_id:+x.member_id,date:$("date").value,status:x.status,in_time:x.in_time||"",out_time:x.out_time||"",mic:+x.mic?1:0,video:+x.video?1:0}))})});
alert("Attendance saved.");day();report()}catch(e){alert(e.message)}
}

async function delD(){
let d=$("date").value;if(!confirm(`Delete ALL attendance for ${d}?`))return;
try{await api("/api/delete-day?date="+d,{method:"DELETE"});day();report()}catch(e){alert(e.message)}
}

function reportStats(){
let p=R.filter(x=>x.status==="PRESENT"),a=R.filter(x=>x.status!=="PRESENT");
let md=[...new Set(R.filter(x=>+x.mic&&x.status==="PRESENT").map(x=>x.date))].length;
let vd=[...new Set(R.filter(x=>+x.video&&x.status==="PRESENT").map(x=>x.date))].length;
let ad=[...new Set(R.filter(x=>+x.mic&&+x.video&&x.status==="PRESENT").map(x=>x.date))].length;
let dd=[...new Set(R.filter(delayed).map(x=>x.date))].length;
$("totalAttendance").textContent=R.length;$("micDays").textContent=md;$("videoDays").textContent=vd;$("activeDays").textContent=ad;
$("totalPresent").textContent=p.length;$("totalAbsent").textContent=a.length;$("delayDays").textContent=dd;$("totalPrayer").textContent=fmt(R.reduce((s,x)=>s+(+x.total_minutes||mins(x)),0))
}

async function report(){
let f=$("from").value,t=$("to").value;if(!f||!t||f>t)return;
try{
let d=await api(`/api/period?from=${f}&to=${t}`);R=d.rows||[];reportStats();
$("reportList").innerHTML=R.length?`<table><tr><th>Date</th><th>Name</th><th>Status</th><th>In</th><th>Out</th><th>Time</th><th>Mic</th><th>Video</th><th>Delay</th></tr>${R.map(x=>`<tr><td>${esc(x.date)}</td><td>${esc(x.name)}</td><td>${x.status}</td><td>${x.in_time||"-"}</td><td>${x.out_time||"-"}</td><td>${fmt(x.total_minutes)}</td><td>${+x.mic?"ON":"OFF"}</td><td>${+x.video?"ON":"OFF"}</td><td class="${delayed(x)?"late":""}">${delayed(x)?"DELAY":"-"}</td></tr>`).join("")}</table>`:`<div class="empty">No saved attendance.</div>`
}catch(e){alert(e.message)}
}

function CSV(){
if(!R.length)return alert("Load a report first.");
let a=document.createElement("a"),s=[["Date","Name","Status","In","Out","Time","Mic","Video","Delay"],...R.map(x=>[x.date,x.name,x.status,x.in_time||"",x.out_time||"",fmt(x.total_minutes),+x.mic?"ON":"OFF",+x.video?"ON":"OFF",delayed(x)?"DELAY":""])]
.map(r=>r.map(v=>`"${String(v).replace(/"/g,'""')}"`).join(",")).join("\n");
a.href=URL.createObjectURL(new Blob(["\ufeff"+s],{type:"text/csv"}));a.download="prayer-attendance.csv";a.click()
}

function PDF(){
if(!R.length)return alert("Load a report first.");
if(!window.jspdf)return alert("PDF library not loaded. Please try again.");

let members=[...new Set(R.map(x=>x.name))].map(name=>{
let a=R.filter(x=>x.name===name),p=a.filter(x=>x.status==="PRESENT").length;
return[
name,p,a.length-p,
[...new Set(a.filter(x=>+x.mic&&x.status==="PRESENT").map(x=>x.date))].length,
[...new Set(a.filter(x=>+x.video&&x.status==="PRESENT").map(x=>x.date))].length,
[...new Set(a.filter(x=>+x.mic&&+x.video&&x.status==="PRESENT").map(x=>x.date))].length,
[...new Set(a.filter(delayed).map(x=>x.date))].length,
(a.length?Math.round(p/a.length*100):0)+"%"
]
});

let{jsPDF}=window.jspdf,doc=new jsPDF({orientation:"landscape",unit:"mm",format:"a4"});
doc.setFillColor(16,42,86);doc.rect(0,0,297,30,"F");
doc.setTextColor(255,255,255);doc.setFontSize(20);doc.setFont("helvetica","bold");
doc.text("Prayer Attendance Report",148.5,12,{align:"center"});
doc.setFontSize(11);doc.setFont("helvetica","normal");
doc.text("Korea - Sri Lanka Prayer Group",148.5,19,{align:"center"});
doc.setFontSize(9);doc.text(`${$("from").value} — ${$("to").value}`,148.5,25,{align:"center"});

doc.setTextColor(16,42,86);doc.setFontSize(13);doc.setFont("helvetica","bold");
doc.text("Member Attendance Summary",148.5,40,{align:"center"});

doc.autoTable({
startY:45,
head:[["Member","Present","Absent","Mic ON","Video ON","Fully Active","Delay","Attendance Rate"]],
body:members,
theme:"grid",
headStyles:{fillColor:[16,42,86],textColor:255,fontStyle:"bold",halign:"center"},
bodyStyles:{fontSize:10,cellPadding:4,halign:"center"},
columnStyles:{0:{halign:"left",fontStyle:"bold"}},
alternateRowStyles:{fillColor:[245,247,250]},
margin:{left:12,right:12}
});

doc.setFontSize(8);doc.setTextColor(100,110,125);
doc.text("Korea - Sri Lanka Prayer Group • Prayer Attendance",148.5,202,{align:"center"});
doc.save(`prayer-attendance-${$("from").value}-to-${$("to").value}.pdf`);
}

function go(id){$("menu").classList.add("hidden");$(id).scrollIntoView({behavior:"smooth"})}
function logout(){localStorage.removeItem(KEY);showApp(0)}

$("loginBtn").onclick=login;$("pass").onkeydown=e=>e.key==="Enter"&&login();
$("menuBtn").onclick=()=>$("menu").classList.toggle("hidden");$("add").onclick=addM;
$("name").onkeydown=e=>e.key==="Enter"&&addM();$("load").onclick=day;$("save").onclick=saveD;
$("saveAll").onclick=saveD;$("all").onclick=allP;$("delDay").onclick=delD;$("reportBtn").onclick=report;
$("csv").onclick=CSV;$("pdf").onclick=PDF;$("cancel").onclick=close;$("editSave").onclick=editSave;$("date").onchange=day;

(async()=>{
if(!localStorage.getItem(KEY))return showApp(0);
try{await api("/api/check-login");showApp(1);init()}catch{localStorage.removeItem(KEY);showApp(0)}
})();
</script></body></html>