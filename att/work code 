
const HTML=`<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Prayer Group Attendance</title><style>
:root{--bg:#0b1628;--p:#13233b;--g:#ffd166;--l:#30435f;--t:#f3f6fc}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--t);font:14px Arial}header{text-align:center;padding:18px;background:#101e33;border-bottom:1px solid var(--l)}h1,h2{color:var(--g)}h1{font-size:21px;margin:0}h2{font-size:17px}main{max-width:1000px;margin:auto;padding:10px}.panel{background:var(--p);padding:12px;border:1px solid var(--l);border-radius:10px;margin-bottom:12px}.row{display:flex;gap:7px;flex-wrap:wrap;align-items:center}.row>*{flex:1;min-width:0}input,select,button{font:inherit;padding:9px;border-radius:6px;border:1px solid var(--l)}input,select{background:var(--bg);color:var(--t);max-width:100%}button{background:var(--g);color:#172033;font-weight:bold;cursor:pointer}.alt{background:#243854;color:white}.danger{background:#7f2935;color:white}.small{font-size:12px;color:#aab8ce}.msg{color:var(--g);font-size:12px;margin-top:8px}.hidden{display:none!important}.legend,.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:6px}.legend div,.stat{padding:9px;background:var(--bg);border-radius:6px}.legend b,.stat strong{color:var(--g)}.stat{text-align:center}.stat strong{display:block;font-size:20px}.stat span{font-size:11px;color:#aab8ce}.wrap{overflow:auto;max-height:65vh;border:1px solid var(--l)}table{border-collapse:separate;border-spacing:0;width:100%;font-size:11px}th,td{padding:4px;text-align:center;border-right:1px solid var(--l);border-bottom:1px solid var(--l);white-space:nowrap}th{position:sticky;top:0;background:#203552;color:var(--g);z-index:2}th:first-child,td:first-child{position:sticky;left:0;background:#172a44;z-index:1}.name{min-width:145px;text-align:left}.name input{width:140px;padding:6px}.cell{min-width:43px;padding:0}.cell>div{display:grid;grid-template-columns:repeat(3,1fr);gap:0}.mark{width:100%;min-width:0;padding:7px 0;border-radius:0;background:#203552;color:white;border:1px solid var(--l);font-size:11px}.mark.on{background:var(--g);color:#172033}.mark.abs.on{background:#ff7272;color:#24090d}footer{text-align:center;color:#aab8ce;padding:12px;font-size:11px}@media(max-width:500px){.legend,.stats{grid-template-columns:repeat(2,1fr)}main{padding:7px}.panel{padding:9px}.row>*{flex-basis:100%}}@media print{body{background:white;color:black}header{background:white}.noprint,#login,.legendpanel,footer{display:none!important}main{padding:0}.panel{background:white;border:0;padding:3px}h2{color:black}.wrap{overflow:visible;max-height:none}th,td,th:first-child,td:first-child{position:static;background:white!important;color:black!important}.name input{border:0;background:white;color:black;width:95px}}
</style></head><body><header><h1>Sri Lanka–Korea Prayer Group</h1><p>Monthly Attendance</p></header><main><section class="panel" id="login"><h2>Admin Login</h2><form id="lf" class="row"><input id="pw" type="password" placeholder="Admin password" required><button type="submit">Login</button></form><div id="lm" class="msg"></div></section><div id="app" class="hidden"><section class="panel noprint"><h2>Settings</h2><div class="row"><select id="mo"></select><select id="yr"></select><button id="load" class="alt" type="button">Load Month</button></div><div class="row" style="margin-top:8px"><button id="save" type="button">Save</button><button id="csv" class="alt" type="button">CSV</button><button id="print" class="alt" type="button">Print/PDF</button><button id="logout" class="danger" type="button">Logout</button></div><div id="msg" class="msg"></div></section><section class="panel legendpanel"><h2>Symbols</h2><div class="legend"><div><b>✓</b> Present</div><div><b>X</b> Absent</div><div><b>△</b> Video Off</div><div><b>M</b> Mic Off</div><div><b>L</b> Late</div><div><b>E</b> Early Out</div></div><p class="small">Select multiple symbols; X (Absent) is exclusive. Tap again to remove a symbol.</p></section><section class="panel"><h2>Monthly Summary</h2><div id="stats" class="stats"></div><div class="wrap" style="margin-top:8px"><table><thead><tr><th class="name">Member</th><th>Present</th><th>Absent</th><th>Video Off</th><th>Mic Off</th><th>Late</th><th>Early Out</th></tr></thead><tbody id="report"></tbody></table></div></section><section class="panel"><h2 id="title">Daily Attendance</h2><p class="small">Edit names and tap symbols for each day.</p><div class="wrap"><table><thead id="head"></thead><tbody id="body"></tbody></table></div><div class="row noprint" style="margin-top:8px"><button id="add" class="alt" type="button">Add Member</button><button id="clear" class="danger" type="button">Clear Month</button></div></section></div></main><footer>Cloudflare Worker + D1 attendance system</footer><script>
(()=>{'use strict';
const $=id=>document.getElementById(id),months=['January','February','March','April','May','June','July','August','September','October','November','December'],syms=[['P','✓','Present'],['A','X','Absent'],['V','△','Video Off'],['M','M','Mic Off'],['L','L','Late'],['E','E','Early Out']];
let r={names:[],days:{}},dirty=false,busy=false;
const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])),period=()=>({m:+$('mo').value,y:+$('yr').value}),key=()=>{let p=period();return p.y+'-'+String(p.m).padStart(2,'0')},nd=()=>new Date(period().y,period().m,0).getDate(),say=(id,s)=>$(id).textContent=s,empty=()=>({names:Array.from({length:30},(_,i)=>'Member '+(i+1)),days:{}});
async function api(path,opts={}){let q=await fetch(path,{credentials:'same-origin',...opts}),d={};try{d=await q.json()}catch{}if(!q.ok)throw Error(d.error||'Request failed: '+q.status);return d}
function marks(i,d){return(r.days[d]&&r.days[d][i]||[]).filter(x=>syms.some(s=>s[0]===x))}
function set(i,d,a){r.days[d]??={};r.days[d][i]=a.includes('A')?['A']:[...new Set(a)]}
function count(i,s){let n=0;for(let d=1;d<=nd();d++)if(marks(i,d).includes(s))n++;return n}
function changed(){dirty=true;say('msg','Unsaved changes. Save your attendance.')}
function render(){let p=period(),days=nd();$('title').textContent='Daily Attendance — '+months[p.m-1]+' '+p.y;
$('head').innerHTML='<tr><th class="name">Member</th>'+Array.from({length:days},(_,i)=>'<th>'+(i+1)+'</th>').join('')+'</tr>';
$('body').innerHTML=r.names.map((name,i)=>'<tr><td class="name"><input data-name="'+i+'" value="'+esc(name)+'" aria-label="Member '+(i+1)+'"></td>'+Array.from({length:days},(_,j)=>{let d=j+1,a=marks(i,d);return '<td class="cell"><div>'+syms.map(s=>'<button type="button" class="mark '+(a.includes(s[0])?'on ':'')+(s[0]==='A'?'abs':'')+'" data-i="'+i+'" data-d="'+d+'" data-s="'+s[0]+'" title="'+s[2]+'" aria-label="'+s[2]+'" '+(s[0]==='A'&&a.length&&!a.includes('A')?'disabled':'')+'>'+s[1]+'</button>').join('')+'</div></td>'}).join('')+'</tr>').join('');
$('report').innerHTML=r.names.map((n,i)=>'<tr><td class="name">'+esc(n)+'</td>'+['P','A','V','M','L','E'].map(s=>'<td>'+count(i,s)+'</td>').join('')+'</tr>').join('');
let totals=['P','A','L','V','M','E'].map(s=>r.names.reduce((n,_,i)=>n+count(i,s),0));
$('stats').innerHTML=[['Members',r.names.length],['Present',totals[0]],['Absent',totals[1]],['Late',totals[2]],['Video Off',totals[3]],['Mic Off',totals[4]],['Early Out',totals[5]]].map(x=>'<div class="stat"><strong>'+x[1]+'</strong><span>'+x[0]+'</span></div>').join('')}
async function load(){if(busy)return;busy=true;say('msg','Loading...');try{let p=period(),x=await api('/api/attendance?month='+p.m+'&year='+p.y);r=x.record&&Array.isArray(x.record.names)?x.record:empty();dirty=false;render();say('msg','Loaded '+months[p.m-1]+' '+p.y)}catch(e){say('msg',e.message)}finally{busy=false}}
async function save(){if(busy)return;busy=true;say('msg','Saving...');try{let p=period();await api('/api/attendance?month='+p.m+'&year='+p.y,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({record:r})});dirty=false;say('msg','Saved successfully.')}catch(e){say('msg',e.message)}finally{busy=false}}
$('lf').onsubmit=async e=>{e.preventDefault();say('lm','Signing in...');try{await api('/api/login',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({password:$('pw').value})});$('pw').value='';$('login').classList.add('hidden');$('app').classList.remove('hidden');await load()}catch(x){say('lm',x.message)}};
$('body').onclick=e=>{let b=e.target.closest('[data-s]');if(!b)return;let i=+b.dataset.i,d=+b.dataset.d,s=b.dataset.s,a=marks(i,d);if(s==='A')a=a.includes('A')?[]:['A'];else{a=a.filter(x=>x!=='A');a=a.includes(s)?a.filter(x=>x!==s):a.concat(s)}set(i,d,a);changed();render()};
$('body').onchange=e=>{if(e.target.dataset.name!==undefined){r.names[+e.target.dataset.name]=e.target.value.trim().slice(0,100);changed();render()}};
$('load').onclick=()=>{if(dirty&&!confirm('Discard unsaved changes?'))return;load()};
$('save').onclick=save;$('print').onclick=()=>print();
$('csv').onclick=()=>{let rows=[['Member','Day','Symbols','Meaning']],meaning=Object.fromEntries(syms.map(s=>[s[0],s[2]]));r.names.forEach((n,i)=>{for(let d=1;d<=nd();d++){let a=marks(i,d);if(a.length)rows.push([n,d,a.map(s=>syms.find(x=>x[0]===s)[1]).join(' '),a.map(s=>meaning[s]).join(', ')])}});
let csv=String.fromCharCode(65279)+rows.map(row=>row.map(v=>'"'+String(v).replace(/"/g,'""')+'"').join(',')).join(String.fromCharCode(13,10)),url=URL.createObjectURL(new Blob([csv],{type:'text/csv;charset=utf-8'})),a=document.createElement('a');a.href=url;a.download='attendance-'+key()+'.csv';a.click();URL.revokeObjectURL(url)};
$('add').onclick=()=>{if(r.names.length>=100)return alert('Maximum 100 members.');r.names.push('Member '+(r.names.length+1));changed();render()};
$('clear').onclick=()=>{if(confirm('Clear all marks for this month?')){r.days={};changed();render()}};
$('logout').onclick=async()=>{try{await api('/api/logout',{method:'POST'})}catch{}$('app').classList.add('hidden');$('login').classList.remove('hidden');say('lm','Logged out.')};
window.onbeforeunload=e=>{if(dirty){e.preventDefault();e.returnValue=''}};
months.forEach((m,i)=>$('mo').add(new Option(m,i+1)));let now=new Date();for(let y=now.getFullYear()-2;y<=now.getFullYear()+3;y++)$('yr').add(new Option(y,y,y===now.getFullYear(),y===now.getFullYear()));
$('mo').value=now.getMonth()+1;
api('/api/session').then(async d=>{if(d.loggedIn){$('login').classList.add('hidden');$('app').classList.remove('hidden');await load()}}).catch(()=>{});
})();
</script></body></html>`;

const json=(data,status=200,headers={})=>new Response(JSON.stringify(data),{status,headers:{"Content-Type":"application/json;charset=utf-8","Cache-Control":"no-store",...headers}});
const cookie=(req,name)=>{let m=(req.headers.get("Cookie")||"").match(new RegExp("(?:^|;\\s*)"+name+"=([^;]*)"));return m?m[1]:""};
const b64=b=>btoa(String.fromCharCode(...new Uint8Array(b))).replace(/\+/g,"-").replace(/\//g,"_").replace(/=+$/,"");
const unb64=s=>{s=s.replace(/-/g,"+").replace(/_/g,"/");while(s.length%4)s+="=";return Uint8Array.from(atob(s),c=>c.charCodeAt(0))};
async function sign(v,secret){let k=await crypto.subtle.importKey("raw",new TextEncoder().encode(secret),{name:"HMAC",hash:"SHA-256"},false,["sign"]);return b64(await crypto.subtle.sign("HMAC",k,new TextEncoder().encode(v)))}
async function session(secret){let p=b64(new TextEncoder().encode(JSON.stringify({exp:Date.now()+28800000})));return p+"."+await sign(p,secret)}
async function auth(req,secret){let t=cookie(req,"attendance_session").split(".");if(t.length!==2)return false;let a=t[1],b=await sign(t[0],secret);if(a.length!==b.length)return false;let diff=0;for(let i=0;i<a.length;i++)diff|=a.charCodeAt(i)^b.charCodeAt(i);if(diff)return false;try{return JSON.parse(new TextDecoder().decode(unb64(t[0]))).exp>Date.now()}catch{return false}}

async function init(db){
  await db.prepare(`CREATE TABLE IF NOT EXISTS attendance_months(
    year INTEGER NOT NULL,
    month INTEGER NOT NULL,
    data TEXT NOT NULL DEFAULT '{}',
    updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY(year,month)
  )`).run();
}

function period(u){
  let m=+u.searchParams.get("month"),y=+u.searchParams.get("year");
  return Number.isInteger(m)&&m>=1&&m<=12&&Number.isInteger(y)&&y>=2000&&y<=2100
    ?{year:y,month:m,key:y+"-"+String(m).padStart(2,"0")}:null;
}

function clean(r){
  if(!r||!Array.isArray(r.names)||!r.days||typeof r.days!=="object"||Array.isArray(r.days)||r.names.length>100)throw Error("Invalid attendance record");
  let names=r.names.map(n=>String(n||"").trim().slice(0,100)),days={},allowed=["P","A","V","M","L","E"];
  for(let[d,ms]of Object.entries(r.days)){
    if(!/^\d+$/.test(d)||+d<1||+d>31||!ms||typeof ms!=="object"||Array.isArray(ms))continue;
    days[d]={};
    for(let[i,a]of Object.entries(ms)){
      if(!/^\d+$/.test(i)||+i>=names.length||+i<0||!Array.isArray(a))continue;
      let v=[...new Set(a.filter(s=>allowed.includes(s)))];
      days[d][i]=v.includes("A")?["A"]:v;
    }
  }
  return{names,days};
}

export default{
  async fetch(req,env){
    let u=new URL(req.url),p=u.pathname;
    if(p==="/"||p==="/index.html"){
      return new Response(HTML,{headers:{"Content-Type":"text/html;charset=utf-8","Cache-Control":"no-store","X-Content-Type-Options":"nosniff"}});
    }
    if(!p.startsWith("/api/"))return new Response("Not found",{status:404});
    if(!env.DB||!env.ADMIN_PASSWORD||!env.SESSION_SECRET)return json({error:"Configure D1 binding DB and secrets ADMIN_PASSWORD, SESSION_SECRET."},500);

    try{
      await init(env.DB);

      if(p==="/api/login"&&req.method==="POST"){
        let b;
        try{b=await req.json()}catch{return json({error:"Invalid request."},400)}
        if(typeof b.password!=="string"||b.password!==env.ADMIN_PASSWORD)return json({error:"Incorrect password."},401);
        return json({ok:true},200,{"Set-Cookie":"attendance_session="+await session(env.SESSION_SECRET)+"; HttpOnly; Secure; SameSite=Strict; Path=/; Max-Age=28800"});
      }

      if(p==="/api/logout"&&req.method==="POST"){
        return json({ok:true},200,{"Set-Cookie":"attendance_session=; HttpOnly; Secure; SameSite=Strict; Path=/; Max-Age=0"});
      }

      if(p==="/api/session"&&req.method==="GET"){
        return json({loggedIn:await auth(req,env.SESSION_SECRET)});
      }

      if(!await auth(req,env.SESSION_SECRET))return json({error:"Please log in again."},401);

      if(p==="/api/attendance"){
        let per=period(u);
        if(!per)return json({error:"Invalid month or year."},400);

        if(req.method==="GET"){
          let row=await env.DB.prepare(
            "SELECT data FROM attendance_months WHERE year=? AND month=?"
          ).bind(per.year,per.month).first();

          if(!row)return json({record:null});
          try{return json({record:JSON.parse(row.data)})}
          catch{return json({error:"Stored data is invalid."},500)};
        }

        if(req.method==="PUT"){
          let b;
          try{b=await req.json()}catch{return json({error:"Invalid JSON."},400)}
          let r;
          try{r=clean(b.record)}catch(e){return json({error:e.message},400)}
          let now=new Date().toISOString();

          await env.DB.prepare(`
            INSERT INTO attendance_months(year,month,data,updated_at)
            VALUES(?,?,?,?)
            ON CONFLICT(year,month)
            DO UPDATE SET data=excluded.data,updated_at=excluded.updated_at
          `).bind(per.year,per.month,JSON.stringify(r),now).run();

          return json({ok:true,updatedAt:now});
        }
      }

      return json({error:"API route not found."},404);
    }catch(e){
      console.error("Attendance Worker error:",e);
      return json({error:"Server error. Check Worker logs and D1 binding."},500);
    }
  }
};
