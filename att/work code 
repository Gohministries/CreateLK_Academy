const ADMIN_PASSWORD="sathya#2026#";

const H={
 "Content-Type":"application/json;charset=UTF-8",
 "Access-Control-Allow-Origin":"*",
 "Access-Control-Allow-Headers":"Content-Type,X-Admin-Key",
 "Access-Control-Allow-Methods":"GET,POST,PUT,DELETE,OPTIONS"
};

const json=(d,s=200)=>new Response(JSON.stringify(d),{status:s,headers:H});
const clean=v=>String(v??"").trim();
const auth=r=>r.headers.get("X-Admin-Key")===ADMIN_PASSWORD;
const dateOK=v=>/^\d{4}-\d{2}-\d{2}$/.test(v);
const timeOK=v=>/^\d{2}:\d{2}$/.test(v);

function bool(v){
 return v===true||v===1||["1","true","yes","on"].includes(String(v).toLowerCase())?1:0;
}

function mins(date,a,b){
 if(!timeOK(a)||!timeOK(b))return 0;
 const x=new Date(`${date}T${a}:00`);
 let y=new Date(`${date}T${b}:00`);
 if(y<x)y.setDate(y.getDate()+1);
 return Math.max(0,Math.round((y-x)/60000));
}

async function setup(env){
 await env.DB.prepare(`
 CREATE TABLE IF NOT EXISTS members(
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  name TEXT NOT NULL UNIQUE,
  created_at TEXT DEFAULT CURRENT_TIMESTAMP
 )`).run();

 await env.DB.prepare(`
 CREATE TABLE IF NOT EXISTS daily_attendance(
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  member_id INTEGER NOT NULL,
  date TEXT NOT NULL,
  status TEXT NOT NULL DEFAULT 'ABSENT',
  in_time TEXT DEFAULT '',
  out_time TEXT DEFAULT '',
  total_minutes INTEGER DEFAULT 0,
  mic INTEGER DEFAULT 0,
  video INTEGER DEFAULT 0,
  created_at TEXT DEFAULT CURRENT_TIMESTAMP,
  updated_at TEXT DEFAULT CURRENT_TIMESTAMP,
  UNIQUE(member_id,date)
 )`).run();

 await env.DB.prepare(
  `CREATE INDEX IF NOT EXISTS idx_att_date ON daily_attendance(date)`
 ).run();
}

async function members(env){
 const r=await env.DB.prepare(
  `SELECT id,name FROM members ORDER BY name COLLATE NOCASE`
 ).all();
 return r.results||[];
}

async function day(env,date){
 const r=await env.DB.prepare(`
 SELECT m.id member_id,m.name,
 COALESCE(a.status,'ABSENT') status,
 COALESCE(a.in_time,'') in_time,
 COALESCE(a.out_time,'') out_time,
 COALESCE(a.total_minutes,0) total_minutes,
 COALESCE(a.mic,0) mic,
 COALESCE(a.video,0) video
 FROM members m
 LEFT JOIN daily_attendance a
 ON a.member_id=m.id AND a.date=?
 ORDER BY m.name COLLATE NOCASE
 `).bind(date).all();

 return r.results||[];
}

async function save(env,x){
 const id=Number(x.member_id);
 const date=clean(x.date);
 let status=clean(x.status).toUpperCase()==="PRESENT"?"PRESENT":"ABSENT";
 let inTime=clean(x.in_time);
 let outTime=clean(x.out_time);
 let mic=bool(x.mic),video=bool(x.video);
 let total=0;

 if(!id||!dateOK(date))throw Error("Invalid member or date.");

 if(status==="PRESENT"){
  if(inTime&&!timeOK(inTime))throw Error("Invalid in time.");
  if(outTime&&!timeOK(outTime))throw Error("Invalid out time.");
  if(inTime&&outTime){
   total=mins(date,inTime,outTime);
   if(total<=0)throw Error("Out time must be later than in time.");
  }
 }else{
  inTime="";
  outTime="";
  mic=0;
  video=0;
 }

 await env.DB.prepare(`
 INSERT INTO daily_attendance
 (member_id,date,status,in_time,out_time,total_minutes,mic,video)
 VALUES(?,?,?,?,?,?,?,?)
 ON CONFLICT(member_id,date) DO UPDATE SET
 status=excluded.status,
 in_time=excluded.in_time,
 out_time=excluded.out_time,
 total_minutes=excluded.total_minutes,
 mic=excluded.mic,
 video=excluded.video,
 updated_at=CURRENT_TIMESTAMP
 `).bind(
  id,date,status,inTime,outTime,total,mic,video
 ).run();
}

async function period(env,from,to){
 const r=await env.DB.prepare(`
 SELECT m.name,a.date,a.status,a.in_time,a.out_time,
 a.total_minutes,a.mic,a.video
 FROM daily_attendance a
 JOIN members m ON m.id=a.member_id
 WHERE a.date BETWEEN ? AND ?
 ORDER BY a.date,m.name COLLATE NOCASE
 `).bind(from,to).all();

 return r.results||[];
}

export default{
 async fetch(request,env){
  try{
   if(request.method==="OPTIONS")
    return new Response(null,{status:204,headers:H});

   const u=new URL(request.url);
   const p=u.pathname;

   if(p==="/api/health")
    return json({success:true,app:"Prayer Attendance",status:"online"});

   if(p==="/api/login"&&request.method==="POST"){
    const b=await request.json().catch(()=>({}));
    return clean(b.password)===ADMIN_PASSWORD
     ?json({success:true})
     :json({success:false,error:"Wrong password."},401);
   }

   if(p==="/api/check-login")
    return auth(request)
     ?json({success:true})
     :json({success:false,error:"Unauthorized."},401);

   if(!auth(request))
    return json({error:"Unauthorized."},401);

   await setup(env);

   if(p==="/api/members"&&request.method==="GET")
    return json({success:true,rows:await members(env)});

   if(p==="/api/members"&&request.method==="POST"){
    const b=await request.json().catch(()=>({}));
    const name=clean(b.name);
    if(!name)return json({error:"Member name required."},400);

    try{
     const r=await env.DB.prepare(
      `INSERT INTO members(name) VALUES(?)`
     ).bind(name).run();

     return json({
      success:true,
      id:r.meta.last_row_id,
      name
     });
    }catch{
     return json({error:"This member already exists."},409);
    }
   }

   if(p.startsWith("/api/members/")&&request.method==="PUT"){
    const id=Number(p.split("/").pop());
    const b=await request.json().catch(()=>({}));
    const name=clean(b.name);

    if(!id||!name)
     return json({error:"Member ID and name required."},400);

    try{
     const r=await env.DB.prepare(
      `UPDATE members SET name=? WHERE id=?`
     ).bind(name,id).run();

     return r.meta.changes
      ?json({success:true})
      :json({error:"Member not found."},404);
    }catch{
     return json({error:"This member already exists."},409);
    }
   }

   if(p.startsWith("/api/members/")&&request.method==="DELETE"){
    const id=Number(p.split("/").pop());

    await env.DB.batch([
     env.DB.prepare(`DELETE FROM daily_attendance WHERE member_id=?`).bind(id),
     env.DB.prepare(`DELETE FROM members WHERE id=?`).bind(id)
    ]);

    return json({success:true});
   }

   if(p==="/api/day"&&request.method==="GET"){
    const date=clean(u.searchParams.get("date"));

    if(!dateOK(date))
     return json({error:"Valid date required."},400);

    return json({
     success:true,
     date,
     rows:await day(env,date)
    });
   }

   if(p==="/api/save"&&request.method==="POST"){
    const b=await request.json().catch(()=>({}));

    if(!Array.isArray(b.rows))
     return json({error:"Invalid attendance data."},400);

    try{
     for(const x of b.rows)await save(env,x);
     return json({success:true,count:b.rows.length});
    }catch(e){
     return json({error:e.message||"Save failed."},400);
    }
   }

   if(p==="/api/delete-day"&&request.method==="DELETE"){
    const date=clean(u.searchParams.get("date"));

    if(!dateOK(date))
     return json({error:"Invalid date."},400);

    await env.DB.prepare(
     `DELETE FROM daily_attendance WHERE date=?`
    ).bind(date).run();

    return json({success:true});
   }

   if(p==="/api/period"&&request.method==="GET"){
    const from=clean(u.searchParams.get("from"));
    const to=clean(u.searchParams.get("to"));

    if(!dateOK(from)||!dateOK(to))
     return json({error:"Valid dates required."},400);

    if(from>to)
     return json({error:"From date cannot be after To date."},400);

    const rows=await period(env,from,to);

    const s=await env.DB.prepare(`
     SELECT
      COUNT(*) total_records,
      SUM(status='PRESENT') present,
      SUM(status='ABSENT') absent,
      COALESCE(SUM(total_minutes),0) minutes,
      COALESCE(SUM(mic=1),0) mic,
      COALESCE(SUM(video=1),0) video
     FROM daily_attendance
     WHERE date BETWEEN ? AND ?
    `).bind(from,to).first();

    return json({
     success:true,
     from,
     to,
     rows,
     summary:{
      total_records:Number(s?.total_records||0),
      present:Number(s?.present||0),
      absent:Number(s?.absent||0),
      minutes:Number(s?.minutes||0),
      mic:Number(s?.mic||0),
      video:Number(s?.video||0)
     }
    });
   }

   return json({error:"Not found."},404);

  }catch(e){
   return json({
    error:"Server error",
    message:e.message||"Unknown error"
   },500);
  }
 }
};