function reply(body,status=200,headers={}){return new Response(JSON.stringify(body),{status,headers:{"Content-Type":"application/json; charset=utf-8","Cache-Control":"no-store",...headers}})}
function cookie(value,age){return C+"="+value+"; Path=/; HttpOnly; Secure; SameSite=Strict; Max-Age="+age}
function getCookie(req){let s=(req.headers.get("Cookie")||"").split(";").map(x=>x.trim()).find(x=>x.startsWith(C+"="));return s?s.slice(C.length+1):""}
function b64(bytes){let s="";for(let x of bytes)s+=String.fromCharCode(x);return btoa(s).replace(/\+/g,"-").replace(/\//g,"_").replace(/=+$/g,"")}
function unb64(s){s=s.replace(/-/g,"+").replace(/_/g,"/");s+="=".repeat((4-s.length%4)%4);return Uint8Array.from(atob(s),x=>x.charCodeAt(0))}
async function sign(value,secret){let k=await crypto.subtle.importKey("raw",new TextEncoder().encode(secret),{name:"HMAC",hash:"SHA-256"},false,["sign"]);return b64(new Uint8Array(await crypto.subtle.sign("HMAC",k,new TextEncoder().encode(value))))}
async function newSession(secret){let p=b64(new TextEncoder().encode(JSON.stringify({admin:true,exp:Math.floor(Date.now()/1000)+D*86400})));return p+"."+await sign(p,secret)}
async function auth(req,secret){if(!secret)return false;let a=getCookie(req).split(".");if(a.length!==2)return false;let expected=await sign(a[0],secret);if(expected.length!==a[1].length)return false;let x=new TextEncoder().encode(expected),y=new TextEncoder().encode(a[1]),diff=0;for(let i=0;i<x.length;i++)diff|=x[i]^y[i];if(diff)return false;try{let p=JSON.parse(new TextDecoder().decode(unb64(a[0])));return p.admin===true&&p.exp>Date.now()/1000}catch{return false}}
async function schema(db){await db.prepare("CREATE TABLE IF NOT EXISTS attendance_months(year INTEGER NOT NULL,month INTEGER NOT NULL,data TEXT NOT NULL DEFAULT '{}',updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,PRIMARY KEY(year,month))").run()}
function validPeriod(m,y){return Number.isInteger(m)&&m>=1&&m<=12&&Number.isInteger(y)&&y>=2000&&y<=2100}
function clean(data,m,y){if(!data||typeof data!=="object"||Array.isArray(data))throw Error("Invalid attendance data");let out={},max=new Date(y,m,0).getDate(),allowed=new Set(S.map(s=>s[0]));for(let [k,v] of Object.entries(data)){let a=/^(\d{1,2})-(\d{1,2})$/.exec(k);if(!a)throw Error("Invalid cell");let p=+a[1],d=+a[2];if(p<0||p>=N||d<1||d>max||!Array.isArray(v)||v.length>7||v.some(x=>!allowed.has(x)))throw Error("Invalid attendance cell");v=norm(v);if(v.length)out[p+"-"+d]=v}return out}
async function apiHandler(req,env,url){
 if(!env.DB)return reply({error:"Missing D1 binding DB."},500);
 let path=url.pathname,method=req.method;
 if(path==="/api/login"&&method==="POST"){if(!env.ADMIN_PASSWORD||!env.SESSION_SECRET)return reply({error:"Configure ADMIN_PASSWORD and SESSION_SECRET."},500);let b;try{b=await req.json()}catch{return reply({error:"Invalid request."},400)}if(typeof b.password!=="string"||b.password!==env.ADMIN_PASSWORD)return reply({error:"Incorrect password."},401);return reply({ok:true},200,{"Set-Cookie":cookie(await newSession(env.SESSION_SECRET),D*86400)})}
 if(path==="/api/logout"&&method==="POST")return reply({ok:true},200,{"Set-Cookie":cookie("",0)});
 if(path==="/api/me"&&method==="GET")return await auth(req,env.SESSION_SECRET)?reply({ok:true}):reply({error:"Login required."},401);
 if(!await auth(req,env.SESSION_SECRET))return reply({error:"Login required."},401);
 if(path!=="/api/attendance")return reply({error:"Not found."},404);
 await schema(env.DB);
 if(method==="GET"){let m=+url.searchParams.get("month"),y=+url.searchParams.get("year");if(!validPeriod(m,y))return reply({error:"Invalid month/year."},400);let r=await env.DB.prepare("SELECT data FROM attendance_months WHERE year=? AND month=?").bind(y,m).first();try{return reply({data:r?JSON.parse(r.data):{}})}catch{return reply({error:"Stored data is invalid."},500)}}
 if(method==="PUT"){let b;try{b=await req.json()}catch{return reply({error:"Invalid request."},400)}let m=+b.month,y=+b.year;if(!validPeriod(m,y))return reply({error:"Invalid month/year."},400);let d;try{d=clean(b.data,m,y)}catch(e){return reply({error:e.message},400)}await env.DB.prepare("INSERT INTO attendance_months(year,month,data,updated_at) VALUES(?,?,?,CURRENT_TIMESTAMP) ON CONFLICT(year,month) DO UPDATE SET data=excluded.data,updated_at=CURRENT_TIMESTAMP").bind(y,m,JSON.stringify(d)).run();return reply({ok:true})}
 return reply({error:"Method not allowed."},405)
}
