const ADMIN_PASSWORD="sathya#2026#";

const HEADERS={
  "Content-Type":"application/json; charset=UTF-8",
  "Access-Control-Allow-Origin":"*",
  "Access-Control-Allow-Headers":"Content-Type, X-Admin-Key",
  "Access-Control-Allow-Methods":"GET, POST, PUT, DELETE, OPTIONS"
};

function json(data,status=200){
  return new Response(JSON.stringify(data),{status,headers:HEADERS});
}

function clean(value){return String(value??"").trim()}

function validDate(value){return /^\d{4}-\d{2}-\d{2}$/.test(value)}
function validTime(value){return /^\d{2}:\d{2}$/.test(value)}

function boolValue(value){
  if(value===true||value===1)return 1;
  if(value===false||value===0)return 0;
  const v=String(value??"").toLowerCase().trim();
  return ["1","true","yes","on"].includes(v)?1:0;
}

function minutesBetween(date,inTime,outTime){
  const start=new Date(`${date}T${inTime}:00`);
  let end=new Date(`${date}T${outTime}:00`);
  if(isNaN(start.getTime())||isNaN(end.getTime()))return 0;
  if(end<start)end.setDate(end.getDate()+1);
  return Math.max(0,Math.round((end-start)/60000));
}

function authorized(request){
  return request.headers.get("X-Admin-Key")===ADMIN_PASSWORD;
}

async function ensureDatabase(env){
  await env.DB.prepare(`
    CREATE TABLE IF NOT EXISTS attendance(
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      name TEXT NOT NULL,
      date TEXT NOT NULL,
      in_time TEXT NOT NULL,
      out_time TEXT NOT NULL,
      total_minutes INTEGER NOT NULL DEFAULT 0,
      mic INTEGER NOT NULL DEFAULT 0,
      camera INTEGER NOT NULL DEFAULT 0,
      created_at TEXT DEFAULT CURRENT_TIMESTAMP
    )
  `).run();

  const info=await env.DB.prepare(`PRAGMA table_info(attendance)`).all();
  const columns=(info.results||[]).map(x=>x.name);

  if(!columns.includes("mic")){
    await env.DB.prepare(
      `ALTER TABLE attendance ADD COLUMN mic INTEGER NOT NULL DEFAULT 0`
    ).run();
  }

  if(!columns.includes("camera")){
    await env.DB.prepare(
      `ALTER TABLE attendance ADD COLUMN camera INTEGER NOT NULL DEFAULT 0`
    ).run();
  }

  await env.DB.prepare(`
    CREATE INDEX IF NOT EXISTS idx_attendance_date
    ON attendance(date)
  `).run();

  await env.DB.prepare(`
    CREATE INDEX IF NOT EXISTS idx_attendance_name
    ON attendance(name)
  `).run();
}

async function getAttendance(env,month){
  const result=await env.DB.prepare(`
    SELECT
      id,name,date,in_time,out_time,total_minutes,
      mic,camera,created_at
    FROM attendance
    WHERE substr(date,1,7)=?
    ORDER BY date DESC,in_time ASC,name ASC
  `).bind(month).all();

  return result.results||[];
}

async function addAttendance(env,body){
  const name=clean(body.name);
  const date=clean(body.date);
  const inTime=clean(body.in_time);
  const outTime=clean(body.out_time);
  const mic=boolValue(body.mic);
  const camera=boolValue(body.camera);

  if(!name||!date||!inTime||!outTime){
    return json({
      error:"Name, date, in time and out time are required."
    },400);
  }

  if(!validDate(date)){
    return json({error:"Invalid date."},400);
  }

  if(!validTime(inTime)||!validTime(outTime)){
    return json({error:"Invalid time."},400);
  }

  const total=minutesBetween(date,inTime,outTime);

  if(total<=0){
    return json({
      error:"Out time must be later than in time."
    },400);
  }

  const result=await env.DB.prepare(`
    INSERT INTO attendance
    (name,date,in_time,out_time,total_minutes,mic,camera)
    VALUES(?,?,?,?,?,?,?)
  `).bind(
    name,
    date,
    inTime,
    outTime,
    total,
    mic,
    camera
  ).run();

  return json({
    success:true,
    id:result.meta.last_row_id,
    total_minutes:total,
    mic:!!mic,
    camera:!!camera
  });
}

async function updateAttendance(env,id,body){
  const name=clean(body.name);
  const date=clean(body.date);
  const inTime=clean(body.in_time);
  const outTime=clean(body.out_time);
  const mic=boolValue(body.mic);
  const camera=boolValue(body.camera);

  if(!id){
    return json({error:"Attendance ID required."},400);
  }

  if(!name||!date||!inTime||!outTime){
    return json({
      error:"Name, date, in time and out time are required."
    },400);
  }

  if(!validDate(date)){
    return json({error:"Invalid date."},400);
  }

  if(!validTime(inTime)||!validTime(outTime)){
    return json({error:"Invalid time."},400);
  }

  const total=minutesBetween(date,inTime,outTime);

  if(total<=0){
    return json({
      error:"Out time must be later than in time."
    },400);
  }

  const result=await env.DB.prepare(`
    UPDATE attendance
    SET
      name=?,
      date=?,
      in_time=?,
      out_time=?,
      total_minutes=?,
      mic=?,
      camera=?
    WHERE id=?
  `).bind(
    name,
    date,
    inTime,
    outTime,
    total,
    mic,
    camera,
    id
  ).run();

  if(!result.meta.changes){
    return json({
      error:"Attendance record not found."
    },404);
  }

  return json({
    success:true,
    total_minutes:total,
    mic:!!mic,
    camera:!!camera
  });
}

async function deleteAttendance(env,id){
  const result=await env.DB.prepare(
    `DELETE FROM attendance WHERE id=?`
  ).bind(id).run();

  if(!result.meta.changes){
    return json({
      error:"Attendance record not found."
    },404);
  }

  return json({success:true});
}

export default{
  async fetch(request,env){

    try{

      if(request.method==="OPTIONS"){
        return new Response(null,{
          status:204,
          headers:HEADERS
        });
      }

      const url=new URL(request.url);
      const path=url.pathname;

      if(path==="/api/health"){
        return json({
          success:true,
          app:"Prayer Attendance",
          status:"online"
        });
      }

      if(path==="/api/login"&&request.method==="POST"){

        let body;

        try{
          body=await request.json();
        }catch{
          return json({
            success:false,
            error:"Invalid JSON."
          },400);
        }

        const entered=String(body?.password??"");

        if(entered===ADMIN_PASSWORD){
          return json({success:true});
        }

        return json({
          success:false,
          error:"Wrong password."
        },401);
      }

      if(path==="/api/check-login"&&request.method==="GET"){

        if(!authorized(request)){
          return json({
            success:false,
            error:"Unauthorized."
          },401);
        }

        return json({success:true});
      }

      if(path==="/api/attendance"&&request.method==="GET"){

        if(!authorized(request)){
          return json({error:"Unauthorized."},401);
        }

        await ensureDatabase(env);

        const month=clean(url.searchParams.get("month"));

        if(!month){
          return json({error:"Month required."},400);
        }

        return json({
          success:true,
          rows:await getAttendance(env,month)
        });
      }

      if(path==="/api/attendance"&&request.method==="POST"){

        if(!authorized(request)){
          return json({error:"Unauthorized."},401);
        }

        await ensureDatabase(env);

        let body;

        try{
          body=await request.json();
        }catch{
          return json({error:"Invalid JSON."},400);
        }

        return await addAttendance(env,body);
      }

      if(path.startsWith("/api/attendance/")&&request.method==="PUT"){

        if(!authorized(request)){
          return json({error:"Unauthorized."},401);
        }

        await ensureDatabase(env);

        const id=path.split("/").pop();

        let body;

        try{
          body=await request.json();
        }catch{
          return json({error:"Invalid JSON."},400);
        }

        return await updateAttendance(env,id,body);
      }

      if(path.startsWith("/api/attendance/")&&request.method==="DELETE"){

        if(!authorized(request)){
          return json({error:"Unauthorized."},401);
        }

        await ensureDatabase(env);

        const id=path.split("/").pop();

        return await deleteAttendance(env,id);
      }

      if(path==="/api/summary"&&request.method==="GET"){

        if(!authorized(request)){
          return json({error:"Unauthorized."},401);
        }

        await ensureDatabase(env);

        const month=clean(url.searchParams.get("month"));

        if(!month){
          return json({error:"Month required."},400);
        }

        const result=await env.DB.prepare(`
          SELECT
            COUNT(*) AS meetings,
            COUNT(DISTINCT name) AS people,
            COALESCE(SUM(total_minutes),0) AS total_minutes,
            COALESCE(SUM(CASE WHEN mic=1 THEN 1 ELSE 0 END),0) AS mic_active,
            COALESCE(SUM(CASE WHEN camera=1 THEN 1 ELSE 0 END),0) AS camera_active,
            COALESCE(SUM(CASE WHEN mic=1 AND camera=1 THEN 1 ELSE 0 END),0) AS mic_camera_active
          FROM attendance
          WHERE substr(date,1,7)=?
        `).bind(month).first();

        return json({
          success:true,
          month,
          meetings:Number(result?.meetings||0),
          people:Number(result?.people||0),
          total_minutes:Number(result?.total_minutes||0),
          mic_active:Number(result?.mic_active||0),
          camera_active:Number(result?.camera_active||0),
          mic_camera_active:Number(result?.mic_camera_active||0)
        });
      }

      if(path==="/api/ranking"&&request.method==="GET"){

        if(!authorized(request)){
          return json({error:"Unauthorized."},401);
        }

        await ensureDatabase(env);

        const month=clean(url.searchParams.get("month"));

        if(!month){
          return json({error:"Month required."},400);
        }

        const result=await env.DB.prepare(`
          SELECT
            name,
            COUNT(*) AS meetings,
            COALESCE(SUM(total_minutes),0) AS total_minutes,
            COALESCE(SUM(CASE WHEN mic=1 THEN 1 ELSE 0 END),0) AS mic_active,
            COALESCE(SUM(CASE WHEN camera=1 THEN 1 ELSE 0 END),0) AS camera_active,
            COALESCE(SUM(CASE WHEN mic=1 AND camera=1 THEN 1 ELSE 0 END),0) AS mic_camera_active
          FROM attendance
          WHERE substr(date,1,7)=?
          GROUP BY name
          ORDER BY
            total_minutes DESC,
            meetings DESC,
            name ASC
        `).bind(month).all();

        return json({
          success:true,
          month,
          rows:result.results||[]
        });
      }

      if(path==="/"){
        return json({
          app:"Prayer Attendance",
          status:"online"
        });
      }

      return json({error:"Not found"},404);

    }catch(error){

      console.error(error);

      return json({
        error:"Server error",
        message:error?.message||"Unknown error"
      },500);
    }
  }
};