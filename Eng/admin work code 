async function health(request,env) {
  return j({
    success:true,
    service:"CreateLK Academy English API",
    time:new Date().toISOString()
  });
}

function corsHeaders() {
  return {
    "Access-Control-Allow-Origin":SITE,
    "Access-Control-Allow-Credentials":"true",
    "Access-Control-Allow-Headers":"Content-Type",
    "Access-Control-Allow-Methods":"GET,POST,OPTIONS"
  };
}

export default {
  async fetch(request,env) {

    const url=new URL(request.url);
    const path=url.pathname;

    if(request.method==="OPTIONS"){
      return new Response(null,{
        status:204,
        headers:corsHeaders()
      });
    }

    let response;

    if(path==="/auth/google"){
      response=await googleLogin(request,env);

    }else if(path==="/auth/callback"){
      response=await googleCallback(request,env);

    }else if(path==="/auth/logout"){
      response=await logout(request,env);

    }else if(path==="/api/me"){
      response=await me(request,env);

    }else if(path==="/api/admin/me"){
      response=await adminMe(request,env);

    }else if(
      path==="/api/admin/activate" &&
      request.method==="POST"
    ){
      response=await adminActivate(request,env);

    }else if(path==="/api/lessons"){
      response=await lessons(request,env);

    }else if(path==="/api/questions"){
      response=await questions(request,env);

    }else if(path==="/api/free-questions"){
      response=await freeQuestions(request,env);

    }else if(path==="/api/health"){
      response=await health(request,env);

    }else{
      response=j({
        success:false,
        error:"Not found"
      },404);
    }

    const headers=new Headers(response.headers);

    for(
      const [key,value]
      of Object.entries(corsHeaders())
    ){
      headers.set(key,value);
    }

    return new Response(response.body,{
      status:response.status,
      statusText:response.statusText,
      headers
    });
  }
};