
const SITE="https://createlk.com";
const GA="https://accounts.google.com/o/oauth2/v2/auth";
const GT="https://oauth2.googleapis.com/token";
const GU="https://openidconnect.googleapis.com/v1/userinfo";
const SC="english_session";
const SESSION_DAYS=30;

function j(data,status=200,extra={}) {
  return new Response(JSON.stringify(data),{
    status,
    headers:{
      "Content-Type":"application/json; charset=utf-8",
      ...extra
    }
  });
}

function html(text,status=200) {
  return new Response(text,{
    status,
    headers:{"Content-Type":"text/html; charset=utf-8"}
  });
}

function redirect(url) {
  return Response.redirect(url,302);
}

function cookies(request) {
  const result={};
  const header=request.headers.get("Cookie")||"";

  for(const part of header.split(";")){
    const i=part.indexOf("=");
    if(i===-1) continue;

    const key=part.slice(0,i).trim();
    const value=part.slice(i+1).trim();

    result[key]=decodeURIComponent(value);
  }

  return result;
}

function cookie(name,value,maxAge) {
  return `${name}=${encodeURIComponent(value)}; Max-Age=${maxAge}; Path=/; HttpOnly; Secure; SameSite=None`;
}

async function sha(value) {
  const data=new TextEncoder().encode(value);
  const hash=await crypto.subtle.digest("SHA-256",data);

  return [...new Uint8Array(hash)]
    .map(b=>b.toString(16).padStart(2,"0"))
    .join("");
}

function randomToken(length=48) {
  const bytes=new Uint8Array(length);
  crypto.getRandomValues(bytes);

  return [...bytes]
    .map(b=>b.toString(16).padStart(2,"0"))
    .join("");
}

function safeNext(value) {
  const next=String(value||"/Eng/quiz.html");

  if(
    next.startsWith("/") &&
    !next.startsWith("//") &&
    !next.includes("://")
  ) return next;

  return "/Eng/quiz.html";
}

async function auth(request,env) {
  const token=cookies(request)[SC];

  if(!token) return null;

  const hash=await sha(token);

  const row=await env.DB.prepare(`
    SELECT
      u.id,
      u.google_id,
      u.name,
      u.email,
      u.photo_url,
      u.referral_code,
      s.id AS session_id,
      s.expires_at
    FROM sessions s
    JOIN users u ON u.id=s.user_id
    WHERE s.session_token_hash=?
      AND s.expires_at>?
    LIMIT 1
  `).bind(
    hash,
    Math.floor(Date.now()/1000)
  ).first();

  return row||null;
}

async function googleLogin(request,env) {
  const url=new URL(request.url);
  const next=safeNext(url.searchParams.get("next"));

  const state=randomToken(32);
  const stateHash=await sha(state);
  const expires=new Date(Date.now()+600000).toISOString();

  await env.DB.prepare(`
    CREATE TABLE IF NOT EXISTS google_states(
      state_hash TEXT PRIMARY KEY,
      next TEXT NOT NULL,
      expires_at TEXT NOT NULL
    )
  `).run();

  await env.DB.prepare(`
    INSERT INTO google_states(state_hash,next,expires_at)
    VALUES(?,?,?)
  `).bind(
    stateHash,
    next,
    expires
  ).run();

  const params=new URLSearchParams({
    client_id:env.GOOGLE_CLIENT_ID,
    redirect_uri:`${SITE}/auth/callback`,
    response_type:"code",
    scope:"openid email profile",
    access_type:"offline",
    prompt:"select_account",
    state
  });

  return redirect(`${GA}?${params}`);
}

async function googleCallback(request,env) {
  const url=new URL(request.url);

  const code=url.searchParams.get("code");
  const state=url.searchParams.get("state");

  if(!code||!state)
    return html("Invalid Google login request.",400);

  const stateHash=await sha(state);

  const stateRow=await env.DB.prepare(`
    SELECT state_hash,next,expires_at
    FROM google_states
    WHERE state_hash=?
    LIMIT 1
  `).bind(stateHash).first();

  if(!stateRow)
    return html("Invalid or expired login state.",400);

  if(new Date(stateRow.expires_at).getTime()<Date.now()){
    await env.DB.prepare(`
      DELETE FROM google_states WHERE state_hash=?
    `).bind(stateHash).run();

    return html("Login request expired.",400);
  }

  await env.DB.prepare(`
    DELETE FROM google_states WHERE state_hash=?
  `).bind(stateHash).run();

  const tokenResponse=await fetch(GT,{
    method:"POST",
    headers:{
      "Content-Type":"application/x-www-form-urlencoded"
    },
    body:new URLSearchParams({
      code,
      client_id:env.GOOGLE_CLIENT_ID,
      client_secret:env.GOOGLE_CLIENT_SECRET,
      redirect_uri:`${SITE}/auth/callback`,
      grant_type:"authorization_code"
    })
  });

  if(!tokenResponse.ok)
    return html("Google token exchange failed.",500);

  const tokenData=await tokenResponse.json();
  const accessToken=tokenData.access_token;

  if(!accessToken)
    return html("Google access token missing.",500);

  const profileResponse=await fetch(GU,{
    headers:{
      Authorization:`Bearer ${accessToken}`
    }
  });

  if(!profileResponse.ok)
    return html("Unable to read Google account.",500);

  const profile=await profileResponse.json();

  const googleId=String(profile.sub||"");
  const email=String(profile.email||"").trim().toLowerCase();
  const name=String(profile.name||"");
  const photoUrl=String(profile.picture||"");

  if(!googleId||!email)
    return html("Google account information is incomplete.",400);

  let user=await env.DB.prepare(`
    SELECT id,google_id,name,email,photo_url,referral_code
    FROM users
    WHERE google_id=?
    LIMIT 1
  `).bind(googleId).first();

  if(!user){
    user=await env.DB.prepare(`
      SELECT id,google_id,name,email,photo_url,referral_code
      FROM users
      WHERE lower(email)=?
      LIMIT 1
    `).bind(email).first();
  }

  if(user){
    await env.DB.prepare(`
      UPDATE users
      SET google_id=?,name=?,email=?,photo_url=?
      WHERE id=?
    `).bind(
      googleId,
      name,
      email,
      photoUrl,
      user.id
    ).run();
  }else{
    const referralCode=
      "CL"+randomToken(5).toUpperCase().slice(0,8);

    user=await env.DB.prepare(`
      INSERT INTO users(
        google_id,name,email,photo_url,referral_code
      )
      VALUES(?,?,?,?,?)
      RETURNING id,google_id,name,email,photo_url,referral_code
    `).bind(
      googleId,
      name,
      email,
      photoUrl,
      referralCode
    ).first();
  }

  const sessionToken=randomToken(48);
  const sessionHash=await sha(sessionToken);

  const expiresAt=
    Math.floor(Date.now()/1000)+
    SESSION_DAYS*86400;

  await env.DB.prepare(`
    INSERT INTO sessions(
      session_token_hash,user_id,expires_at
    )
    VALUES(?,?,?)
  `).bind(
    sessionHash,
    user.id,
    expiresAt
  ).run();

  const next=safeNext(stateRow.next);

  const headers=new Headers();

  headers.set(
    "Location",
    `${SITE}${next}`
  );

  headers.append(
    "Set-Cookie",
    cookie(
      SC,
      sessionToken,
      SESSION_DAYS*86400
    )
  );

  return new Response(null,{
    status:302,
    headers
  });
}

async function logout(request,env) {
  const token=cookies(request)[SC];

  if(token){
    const hash=await sha(token);

    await env.DB.prepare(`
      DELETE FROM sessions
      WHERE session_token_hash=?
    `).bind(hash).run();
  }

  return new Response(null,{
    status:302,
    headers:{
      Location:`${SITE}/Eng/login.html`,
      "Set-Cookie":cookie(SC,"",0)
    }
  });
}

async function subscription(userId,env) {
  const now=new Date().toISOString();

  return await env.DB.prepare(`
    SELECT id,status,started_at,expires_at
    FROM subscriptions
    WHERE user_id=?
      AND status='active'
      AND (
        expires_at IS NULL
        OR expires_at>?
      )
    ORDER BY id DESC
    LIMIT 1
  `).bind(userId,now).first();
}

async function me(request,env) {
  const user=await auth(request,env);

  if(!user){
    return j({
      loggedIn:false,
      user:null
    });
  }

  const premium=await subscription(user.id,env);

  return j({
    loggedIn:true,
    user:{
      id:user.id,
      name:user.name,
      email:user.email,
      photo_url:user.photo_url,
      referral_code:user.referral_code
    },
    premium:!!premium,
    subscription:premium||null
  });
}

async function isAdmin(request,env) {
  const user=await auth(request,env);

  if(!user) return null;

  if(
    !env.ADMIN_EMAIL ||
    user.email.toLowerCase()!==
    env.ADMIN_EMAIL.toLowerCase()
  ){
    return null;
  }

  return user;
}

async function adminMe(request,env) {
  const admin=await isAdmin(request,env);

  return j({
    loggedIn:!!admin,
    admin:!!admin,
    email:admin?.email||null
  });
}

async function adminActivate(request,env) {
  const admin=await isAdmin(request,env);

  if(!admin){
    return j({
      success:false,
      error:"Unauthorized"
    },403);
  }

  let body;

  try{
    body=await request.json();
  }catch{
    return j({
      success:false,
      error:"Invalid request"
    },400);
  }

  const email=String(body.email||"")
    .trim()
    .toLowerCase();

  if(!email){
    return j({
      success:false,
      error:"Email required"
    },400);
  }

  const user=await env.DB.prepare(`
    SELECT id,name,email
    FROM users
    WHERE lower(email)=?
    LIMIT 1
  `).bind(email).first();

  if(!user){
    return j({
      success:false,
      error:"User not found"
    },404);
  }

  const active=await subscription(user.id,env);

  if(active){
    return j({
      success:false,
      error:"Premium is already active",
      expires_at:active.expires_at
    },400);
  }

  const now=new Date();

  const expires=new Date(
    now.getTime()+30*86400000
  );

  await env.DB.prepare(`
    INSERT INTO subscriptions(
      user_id,status,started_at,expires_at
    )
    VALUES(?,'active',?,?)
  `).bind(
    user.id,
    now.toISOString(),
    expires.toISOString()
  ).run();

  const payment=await env.DB.prepare(`
    SELECT id,amount,order_id
    FROM payments
    WHERE user_id=?
      AND status='pending'
    ORDER BY id DESC
    LIMIT 1
  `).bind(user.id).first();

  if(payment){

    await env.DB.prepare(`
      UPDATE payments
      SET status='paid',paid_at=?
      WHERE id=?
    `).bind(
      now.toISOString(),
      payment.id
    ).run();

    const referral=await env.DB.prepare(`
      SELECT id,referrer_user_id,referred_user_id
      FROM referrals
      WHERE referred_user_id=?
        AND status='registered'
      LIMIT 1
    `).bind(user.id).first();

    if(referral){

      await env.DB.prepare(`
        UPDATE referrals
        SET status='converted',converted_at=?
        WHERE id=?
      `).bind(
        now.toISOString(),
        referral.id
      ).run();

      const amount=Number(
        payment.amount||999
      );

      const commission=amount*0.20;

      await env.DB.prepare(`
        INSERT OR IGNORE INTO referral_commissions(
          referral_id,
          referrer_user_id,
          referred_user_id,
          payment_id,
          payment_amount,
          commission_percent,
          commission_amount,
          status,
          created_at
        )
        VALUES(?,?,?,?,?,20,?,'pending',?)
      `).bind(
        referral.id,
        referral.referrer_user_id,
        referral.referred_user_id,
        payment.id,
        amount,
        commission,
        now.toISOString()
      ).run();
    }
  }

  return j({
    success:true,
    email:user.email,
    name:user.name,
    expires_at:expires.toISOString()
  });
}

async function lessons(request,env) {
  const user=await auth(request,env);

  if(!user){
    return j({
      success:false,
      error:"Login required"
    },401);
  }

  const premium=await subscription(user.id,env);

  if(!premium){
    return j({
      success:false,
      error:"Premium required"
    },403);
  }

  const rows=await env.DB.prepare(`
    SELECT id,title,sort_order
    FROM lessons
    ORDER BY sort_order ASC
  `).all();

  return j({
    success:true,
    lessons:rows.results||[]
  });
}

async function questions(request,env) {
  const user=await auth(request,env);

  if(!user){
    return j({
      success:false,
      error:"Login required"
    },401);
  }

  const premium=await subscription(user.id,env);

  if(!premium){
    return j({
      success:false,
      error:"Premium required"
    },403);
  }

  const url=new URL(request.url);
  const lessonId=Number(
    url.searchParams.get("lesson_id")
  );

  if(!Number.isInteger(lessonId)||lessonId<1){
    return j({
      success:false,
      error:"Invalid lesson"
    },400);
  }

  const rows=await env.DB.prepare(`
    SELECT
      id,
      lesson_id,
      question,
      option_a,
      option_b,
      option_c,
      option_d,
      answer,
      explanation,
      question_number
    FROM questions
    WHERE lesson_id=?
    ORDER BY question_number ASC
    LIMIT 50
  `).bind(lessonId).all();

  return j({
    success:true,
    lesson_id:lessonId,
    questions:rows.results||[]
  });
}

