/* =========================
   CORS
========================= */

function cors(){
  return new Response(null,{
    status:204,
    headers:{
      "Access-Control-Allow-Origin":SITE,
      "Access-Control-Allow-Credentials":"true",
      "Access-Control-Allow-Methods":"GET,POST,OPTIONS",
      "Access-Control-Allow-Headers":"Content-Type"
    }
  });
}


/* =========================
   MAIN
========================= */

export default {

  async fetch(r,e){

    if(r.method==="OPTIONS"){
      return cors();
    }

    const url=new URL(r.url);
    const path=url.pathname;

    try{

      if(path==="/auth/google"){
        return googleLogin(r,e);
      }

      if(path==="/auth/callback"){
        return googleCallback(r,e);
      }

      if(path==="/auth/logout"){
        return logout(r,e);
      }

      if(path==="/api/me"){
        return me(r,e);
      }

      if(path==="/api/admin/me"){
        return adminMe(r,e);
      }

      if(
        path==="/api/admin/activate" &&
        r.method==="POST"
      ){
        return adminActivate(r,e);
      }

      if(path==="/api/referral"){
        return referral(r,e);
      }

      if(path==="/api/payment-start"){
        return paymentStart(r,e);
      }

      if(path==="/api/payment-session"){
        return paymentSession(r,e);
      }

      if(path==="/api/titles"){
        return titles(r,e);
      }

      if(path==="/api/questions"){
        return questions(r,e);
      }

      if(path==="/api/health"){
        return health(r,e);
      }

      return j({
        success:false,
        error:"Not found"
      },404);

    }catch(err){

      console.error("WORKER ERROR:",err);

      return j({
        success:false,
        error:String(err)
      },500);
    }
  }
};