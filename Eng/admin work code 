/* =========================
   PAYMENT START
========================= */

async function paymentStart(r,e){

  const u=await auth(r,e);

  if(!u){
    return j({
      success:false,
      error:"Login required"
    },401);
  }

  const active=await subscription(u.id,e);

  if(active){
    return j({
      success:false,
      error:"Premium already active"
    },400);
  }

  const pending=await e.DB.prepare(`
    SELECT order_id
    FROM payments
    WHERE user_id=?
      AND status='pending'
    ORDER BY id DESC
    LIMIT 1
  `).bind(u.id).first();

  if(pending){
    return j({
      success:true,
      pending:true,
      order_id:pending.order_id
    });
  }

  const orderId=
    "ACADEMY-" +
    Date.now() +
    "-" +
    randomToken().slice(0,8);

  await e.DB.prepare(`
    INSERT INTO payments
    (
      user_id,
      order_id,
      amount,
      currency,
      status,
      created_at
    )
    VALUES(?,?,999,'LKR','pending',?)
  `).bind(
    u.id,
    orderId,
    new Date().toISOString()
  ).run();

  return j({
    success:true,
    pending:true,
    order_id:orderId
  });
}


