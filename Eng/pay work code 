/* =========================
   APPROVE PAYMENT
========================= */

async function approve(req,env){

 if(!(await admin(req,env))){

  return json({
   success:false,
   error:"Unauthorized"
  },401);
 }


 const b=
  await req.json();

 const order=
  String(b.order_id||"");

 if(!order){

  return json({
   success:false,
   error:"Missing order_id"
  },400);
 }


 const p=
  await env.DB.prepare(`
   SELECT *
   FROM payments
   WHERE order_id=?
  `)
  .bind(order)
  .first();

 if(!p){

  return json({
   success:false,
   error:"Payment not found"
  },404);
 }


 if(p.status==="APPROVED"){

  return json({
   success:true,
   message:"Already approved"
  });
 }


 /*
  Get current membership expiry.
 */

 const u=
  await env.DB.prepare(`
   SELECT membership_expiry
   FROM users
   WHERE id=?
  `)
  .bind(p.user_id)
  .first();


 const currentExpiry=
  u?.membership_expiry
   ? Date.parse(u.membership_expiry)
   : 0;


 /*
  If current premium is still active,
  extend from current expiry.

  If expired/free,
  start from today.
 */

 const base=
  Math.max(
   Date.now(),
   Number.isFinite(currentExpiry)
    ? currentExpiry
    : 0
  );


 const expiry=
  new Date(
   base+
   Number(p.duration_days||30)*
   86400000
  ).toISOString();


 /*
  Update everything together.
 */

 await env.DB.batch([

  /* Payment */

  env.DB.prepare(`
   UPDATE payments
   SET
    status='APPROVED',
    paid_at=CURRENT_TIMESTAMP,
    approved_by=?,
    approved_at=CURRENT_TIMESTAMP
   WHERE order_id=?
  `)
  .bind(
   ADMIN,
   order
  ),


  /* Main user */

  env.DB.prepare(`
   UPDATE users
   SET
    membership_status='PREMIUM',
    membership_expiry=?
   WHERE id=?
  `)
  .bind(
   expiry,
   p.user_id
  ),


  /* Premium table */

  env.DB.prepare(`
   INSERT INTO premium_users
   (
    user_id,
    email,
    name,
    status,
    membership_expiry,
    updated_at
   )
   VALUES(
    ?,?,?,?,?,CURRENT_TIMESTAMP
   )

   ON CONFLICT(user_id)
   DO UPDATE SET
    email=excluded.email,
    name=excluded.name,
    status='PREMIUM',
    membership_expiry=excluded.membership_expiry,
    updated_at=CURRENT_TIMESTAMP
  `)
  .bind(
   p.user_id,
   p.email,
   p.name,
   "PREMIUM",
   expiry
  )

 ]);


 return json({
  success:true,
  premium:true,
  expiry
 });
}


