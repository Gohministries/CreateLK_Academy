/* =========================
   HELPERS
========================= */

async function body(r){

 try{
  return await r.json();
 }catch{
  return null;
 }

}


function token(n=32){

 const a=
  new Uint8Array(n);

 crypto.getRandomValues(a);

 return [...a]
  .map(x=>
   x.toString(16)
    .padStart(2,"0")
  )
  .join("");

}


async function sha256(x){

 const h=
  await crypto.subtle.digest(
   "SHA-256",
   new TextEncoder().encode(x)
  );

 return [...new Uint8Array(h)]
  .map(x=>
   x.toString(16)
    .padStart(2,"0")
  )
  .join("");

}


function cookies(r){

 const o={};

 const h=
  r.headers.get("Cookie");

 if(!h)
  return o;


 for(
  const p of h.split(";")
 ){

  const i=
   p.indexOf("=");

  if(i>=0){

   o[
    p.slice(0,i).trim()
   ]=
    decodeURIComponent(
     p.slice(i+1).trim()
    );

  }

 }

 return o;

}


function clean(x){

 return String(
  x||""
 ).trim();

}


function json(x,status=200){

 return cors(
  new Response(
   JSON.stringify(x),
   {
    status,
    headers:{
     "Content-Type":
      "application/json;charset=UTF-8"
    }
   }
  )
 );

}


function err(
 error,
 status=400,
 extra={}
){

 return json(
  {
   success:false,
   error,
   ...extra
  },
  status
 );

}


function cors(r){

 r.headers.set(
  "Access-Control-Allow-Origin",
  SITE
 );

 r.headers.set(
  "Access-Control-Allow-Credentials",
  "true"
 );

 r.headers.set(
  "Access-Control-Allow-Headers",
  "Content-Type"
 );

 r.headers.set(
  "Access-Control-Allow-Methods",
  "GET,POST,OPTIONS"
 );

 return r;

}