const ADMIN="gateofheavensl1@gmail.com";
const SITE="https://createlk.com";
const COOKIE="pay_admin";
const GOOGLE_AUTH="https://accounts.google.com/o/oauth2/v2/auth";
const GOOGLE_TOKEN="https://oauth2.googleapis.com/token";
const GOOGLE_USERINFO="https://openidconnect.googleapis.com/v1/userinfo";

export default {
 async fetch(req,env){
  const u=new URL(req.url);
  try{
   if(req.method==="OPTIONS")return cors(new Response(null,{status:204}));

   if(u.pathname==="/api/health")
    return json({success:true,message:"Premium API is running",version:"PREMIUM-2026-10-05"});

   if(u.pathname==="/auth/google")return login(env);
   if(u.pathname==="/auth/callback")return callback(req,env);
   if(u.pathname==="/auth/logout")return logout();

   if(u.pathname==="/api/me")return me(req,env);
   if(u.pathname==="/api/payment/create"&&req.method==="POST")return createPayment(req,env);
   if(u.pathname==="/api/payment/status")return paymentStatus(req,env);

   if(u.pathname==="/api/admin/me")return adminMe(req,env);
   if(u.pathname==="/api/admin/payments")return adminPayments(req,env);
   if(u.pathname==="/api/admin/approve"&&req.method==="POST")return approve(req,env);
   if(u.pathname==="/api/admin/reject"&&req.method==="POST")return reject(req,env);

   if(u.pathname==="/internal/check"&&req.method==="POST")return internalCheck(req,env);

   return json({success:false,error:"Not found"},404);
  }catch(e){
   console.error(e);
   return json({success:false,error:"Server error"},500);
  }
 }
};

function cors(r){
 const h=new Headers(r.headers);
 h.set("Access-Control-Allow-Origin","https://createlk.com");
 h.set("Access-Control-Allow-Credentials","true");
 h.set("Access-Control-Allow-Headers","Content-Type,Authorization");
 h.set("Access-Control-Allow-Methods","GET,POST,OPTIONS");
 return new Response(r.body,{status:r.status,headers:h});
}

function json(x,s=200){
 return cors(new Response(JSON.stringify(x),{
  status:s,
  headers:{"Content-Type":"application/json"}
 }));
}

function redir(url){
 return new Response(null,{status:302,headers:{Location:url}});
}

async function login(env){
 const state=crypto.randomUUID();
 const redirect=`https://pay.createlk.workers.dev/auth/callback`;
 await env.DB.prepare(
  "INSERT INTO oauth_states(state,expires_at) VALUES(?,?)"
 ).bind(state,Math.floor(Date.now()/1000)+600).run();

 const p=new URLSearchParams({
  client_id:env.GOOGLE_CLIENT_ID,
  redirect_uri:redirect,
  response_type:"code",
  scope:"openid email profile",
  state
 });
 return redir(`${GOOGLE_AUTH}?${p}`);
}

async function callback(req,env){
 const u=new URL(req.url);
 const code=u.searchParams.get("code");
 const state=u.searchParams.get("state");
 if(!code||!state)return json({success:false,error:"Invalid login"},400);

 const st=await env.DB.prepare(
  "SELECT state FROM oauth_states WHERE state=? AND expires_at>?"
 ).bind(state,Math.floor(Date.now()/1000)).first();

 if(!st)return json({success:false,error:"Invalid or expired state"},400);

 await env.DB.prepare("DELETE FROM oauth_states WHERE state=?").bind(state).run();

 const token=await fetch(GOOGLE_TOKEN,{
  method:"POST",
  headers:{"Content-Type":"application/x-www-form-urlencoded"},
  body:new URLSearchParams({
   code,
   client_id:env.GOOGLE_CLIENT_ID,
   client_secret:env.GOOGLE_CLIENT_SECRET,
   redirect_uri:"https://pay.createlk.workers.dev/auth/callback",
   grant_type:"authorization_code"
  })
 });
 const td=await token.json();
 if(!td.access_token)return json({success:false,error:"Google login failed"},400);

 const gr=await fetch(GOOGLE_USERINFO,{
  headers:{Authorization:`Bearer ${td.access_token}`}
 });
 const g=await gr.json();

 if((g.email||"").toLowerCase()!==ADMIN.toLowerCase())
  return json({success:false,error:"Admin access only"},403);

 const session=crypto.randomUUID();
 await env.DB.prepare(
  "INSERT OR REPLACE INTO admin_sessions(token_hash,expires_at) VALUES(?,?)"
 ).bind(await hash(session),new Date(Date.now()+86400000).toISOString()).run();

 return new Response(null,{
  status:302,
  headers:{
   Location:`${SITE}/admin/payments.html`,
   "Set-Cookie":`${COOKIE}=${session}; Path=/; HttpOnly; Secure; SameSite=Lax; Max-Age=86400`
  }
 });
}

async function logout(){
 return new Response(null,{
  status:302,
  headers:{
   Location:SITE,
   "Set-Cookie":`${COOKIE}=; Path=/; HttpOnly; Secure; Max-Age=0`
  }
 });
}

async function admin(req,env){
 const c=req.headers.get("Cookie")||"";
 const m=c.match(new RegExp(`${COOKIE}=([^;]+)`));
 if(!m)return false;

 const row=await env.DB.prepare(
  "SELECT token_hash FROM admin_sessions WHERE token_hash=? AND expires_at>?"
 ).bind(await hash(m[1]),new Date().toISOString()).first();

 return !!row;
}

async function adminMe(req,env){
 return json({success:true,admin:await admin(req,env)});
}

async function createPayment(req,env){
 const b=await req.json();
 const userId=Number(b.user_id);
 const email=String(b.email||"");
 const name=String(b.name||"");
 const amount=Number(b.amount||1000);
 const days=Number(b.duration_days||30);

 if(!userId||!email||amount<=0)return json({success:false,error:"Invalid payment"},400);

 const order=`CL${Date.now()}${Math.floor(Math.random()*1000)}`;

 await env.DB.prepare(`
  INSERT INTO payments
  (user_id,order_id,amount,currency,status,duration_days,email,name,created_at)
  VALUES(?,?,?,?,?,?,?,?,CURRENT_TIMESTAMP)
 `).bind(userId,order,amount,"LKR","PENDING",days,email,name).run();

 return json({success:true,order_id:order,amount,duration_days:days});
}

async function paymentStatus(req,env){
 const u=new URL(req.url);
 const order=u.searchParams.get("order_id");
 if(!order)return json({success:false,error:"Missing order_id"},400);

 const p=await env.DB.prepare(
  "SELECT * FROM payments WHERE order_id=?"
 ).bind(order).first();

 if(!p)return json({success:false,error:"Payment not found"},404);

 return json({
  success:true,
  status:p.status,
  order_id:p.order_id,
  amount:p.amount,
  duration_days:p.duration_days,
  paid_at:p.paid_at
 });
}

async function adminPayments(req,env){
 if(!(await admin(req,env)))return json({success:false,error:"Unauthorized"},401);

 const rows=await env.DB.prepare(
  "SELECT * FROM payments ORDER BY id DESC LIMIT 200"
 ).all();

 return json({success:true,payments:rows.results});
}

async function approve(req,env){
 if(!(await admin(req,env)))return json({success:false,error:"Unauthorized"},401);

 const b=await req.json();
 const order=String(b.order_id||"");
 if(!order)return json({success:false,error:"Missing order_id"},400);

 const p=await env.DB.prepare(
  "SELECT * FROM payments WHERE order_id=?"
 ).bind(order).first();

 if(!p)return json({success:false,error:"Payment not found"},404);
 if(p.status==="APPROVED")return json({success:true,message:"Already approved"});

 const expiry=new Date(
  Math.max(Date.now(),Date.parse(paidExpiry(p.user_id)))+
  Number(p.duration_days||30)*86400000
 ).toISOString();

 await env.DB.batch([
  env.DB.prepare(`
   UPDATE payments
   SET status='APPROVED',paid_at=CURRENT_TIMESTAMP,
       approved_by=?,approved_at=CURRENT_TIMESTAMP
   WHERE order_id=?
  `).bind(ADMIN,order),

  env.DB.prepare(`
   UPDATE users
   SET membership_status='PREMIUM',
       membership_expiry=?
   WHERE id=?
  `).bind(expiry,p.user_id),

  env.DB.prepare(`
   INSERT INTO premium_users
   (user_id,email,name,status,membership_expiry,updated_at)
   VALUES(?,?,?,?,?,CURRENT_TIMESTAMP)
   ON CONFLICT(user_id) DO UPDATE SET
   email=excluded.email,
   name=excluded.name,
   status='PREMIUM',
   membership_expiry=excluded.membership_expiry,
   updated_at=CURRENT_TIMESTAMP
  `).bind(p.user_id,p.email,p.name,"PREMIUM",expiry)
 ]);

 return json({success:true,premium:true,expiry});
}

async function reject(req,env){
 if(!(await admin(req,env)))return json({success:false,error:"Unauthorized"},401);

 const b=await req.json();
 if(!b.order_id)return json({success:false,error:"Missing order_id"},400);

 await env.DB.prepare(`
  UPDATE payments
  SET status='REJECTED',approved_by=?,approved_at=CURRENT_TIMESTAMP
  WHERE order_id=?
 `).bind(ADMIN,b.order_id).run();

 return json({success:true,status:"REJECTED"});
}

async function internalCheck(req,env){
 const auth=req.headers.get("Authorization")||"";
 if(auth!==`Bearer ${env.INTERNAL_SECRET}`)
  return json({success:false,error:"Unauthorized"},401);

 const b=await req.json();
 const id=Number(b.user_id);
 if(!id)return json({success:false,error:"Missing user_id"},400);

 const p=await env.DB.prepare(`
  SELECT membership_expiry,status
  FROM premium_users
  WHERE user_id=?
 `).bind(id).first();

 const u=await env.DB.prepare(`
  SELECT membership_status,membership_expiry
  FROM users WHERE id=?
 `).bind(id).first();

 const expiry=p?.membership_expiry||u?.membership_expiry||null;
 const premium=(
  (p?.status==="PREMIUM"||u?.membership_status==="PREMIUM")&&
  expiry&&new Date(expiry).getTime()>Date.now()
 );

 if(!premium&&u?.membership_status==="PREMIUM"){
  await env.DB.prepare(`
   UPDATE users SET membership_status='FREE'
   WHERE id=?
  `).bind(id).run();

  await env.DB.prepare(`
   UPDATE premium_users SET status='FREE',updated_at=CURRENT_TIMESTAMP
   WHERE user_id=?
  `).bind(id);
 }

 return json({
  success:true,
  premium:!!premium,
  membership_status:premium?"PREMIUM":"FREE",
  membership_expiry:premium?expiry:null
 });
}

async function me(req,env){
 const auth=req.headers.get("Authorization")||"";
 if(!auth.startsWith("Bearer "))
  return json({success:false,error:"Unauthorized"},401);

 return internalCheck(
  new Request("https://pay/internal/check",{
   method:"POST",
   headers:{
    Authorization:`Bearer ${env.INTERNAL_SECRET}`,
    "Content-Type":"application/json"
   },
   body:JSON.stringify({user_id:Number(auth.slice(7))})
  }),env
 );
}

async function hash(s){
 const b=await crypto.subtle.digest(
  "SHA-256",
  new TextEncoder().encode(s)
 );
 return [...new Uint8Array(b)].map(x=>x.toString(16).padStart(2,"0")).join("");
}

