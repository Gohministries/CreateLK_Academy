async function stats(r,e){
 try{await auth(r,e)}
 catch(x){return err(x.message,401)}

 const [u,p,a,c]=await Promise.all([
  e.DB.prepare(`SELECT COUNT(*) n FROM users`).first(),
  e.DB.prepare(`
   SELECT COUNT(*) n FROM users
   WHERE membership_status='PREMIUM'
   AND membership_expiry>?
  `).bind(now()).first(),
  e.DB.prepare(`
   SELECT COUNT(*) n,COALESCE(SUM(amount),0) total
   FROM payments WHERE status='APPROVED'
  `).first(),
  e.DB.prepare(`
   SELECT COUNT(*) n,COALESCE(SUM(commission_amount),0) total
   FROM referrals WHERE status='APPROVED'
  `).first()
 ]);

 return json({
  success:true,
  users:+u.n,
  premium:+p.n,
  free:+u.n-+p.n,
  payments:+a.n,
  payment_total:+a.total,
  referrals:+c.n,
  referral_commission:+c.total
 });
}

async function users(r,e){
 try{await auth(r,e)}
 catch(x){return err(x.message,401)}

 const q=new URL(r.url).searchParams.get("q")||"";

 const sql=`
 SELECT
  u.id user_id,
  u.email,
  u.name,
  u.membership_status status,
  u.membership_expiry,
  rl.referrer_id,
  rl.referrer_email,
  rl.referral_code,
  CASE WHEN rl.id IS NULL THEN 'DIRECT'
  ELSE 'REFERRED' END referral_status
 FROM users u
 LEFT JOIN referral_links rl
 ON rl.referred_user_id=u.id
 `;

 const x=q
 ?await e.DB.prepare(sql+`
  WHERE u.email LIKE ?
  OR u.name LIKE ?
  OR CAST(u.id AS TEXT)=?
  ORDER BY u.id DESC LIMIT 500
 `).bind(`%${q}%`,`%${q}%`,q).all()
 :await e.DB.prepare(sql+`
  ORDER BY u.id DESC LIMIT 500
 `).all();

 return json({success:true,users:x.results||[]});
}

async function find(r,e){
 try{await auth(r,e)}
 catch(x){return err(x.message,401)}

 const email=clean(
  new URL(r.url).searchParams.get("email")
 ).toLowerCase();

 if(!email)return err("Email required");

 const u=await e.DB.prepare(`
  SELECT id,email,name FROM users
  WHERE lower(email)=?
 `).bind(email).first();

 if(!u)return err("User not found",404);

 const x=await e.DB.prepare(`
  SELECT * FROM referral_links
  WHERE referred_user_id=?
  OR lower(referred_email)=?
  LIMIT 1
 `).bind(u.id,email).first();

 return json({
  success:true,
  user:{
   user_id:+u.id,
   email:u.email,
   name:u.name
  },
  referral:x||null,
  referral_status:x?"REFERRED":"DIRECT"
 });
}

async function save(r,e){
 try{await auth(r,e)}
 catch(x){return err(x.message,401)}

 if(r.method!=="POST")return err("POST required",405);

 const b=await body(r);
 const re=clean(b?.referred_email).toLowerCase();
 const rr=clean(b?.referrer_email).toLowerCase();

 if(!re||!rr)return err("Emails required");
 if(re===rr)return err("Self referral not allowed");

 const a=await e.DB.prepare(`
  SELECT id,email FROM users
  WHERE lower(email)=?
 `).bind(re).first();

 const f=await e.DB.prepare(`
  SELECT id,email FROM users
  WHERE lower(email)=?
 `).bind(rr).first();

 if(!a)return err("Referred user not found",404);
 if(!f)return err("Referrer user not found",404);

 const code=clean(b.referral_code).toUpperCase()||`ENG${f.id}`;
 const t=now();

 await e.DB.prepare(`
  INSERT INTO referral_links(
   referred_user_id,
   referred_email,
   referrer_id,
   referrer_email,
   referral_code,
   created_at,
   updated_at
  ) VALUES(?,?,?,?,?,?,?)
  ON CONFLICT(referred_user_id) DO UPDATE SET
   referred_email=excluded.referred_email,
   referrer_id=excluded.referrer_id,
   referrer_email=excluded.referrer_email,
   referral_code=excluded.referral_code,
   updated_at=excluded.updated_at
 `).bind(
  a.id,a.email,f.id,f.email,code,t,t
 ).run();

 return json({
  success:true,
  referred_user_id:+a.id,
  referrer_id:+f.id,
  referral_code:code
 });
}

