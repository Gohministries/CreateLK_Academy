const ADMIN="gateofheavensl1@gmail.com";
const SITE="https://createlk.com";
const COOKIE="pay_admin";

const GOOGLE_AUTH="https://accounts.google.com/o/oauth2/v2/auth";
const GOOGLE_TOKEN="https://oauth2.googleapis.com/token";
const GOOGLE_USERINFO="https://openidconnect.googleapis.com/v1/userinfo";

export default {
 async fetch(req,env){
  const u=new URL(req.url);

  try{

   if(req.method==="OPTIONS")
    return cors(new Response(null,{status:204}));

   if(u.pathname==="/api/health")
    return json({
     success:true,
     message:"Premium API is running",
     version:"PREMIUM-2026-10-05"
    });

   /* Google Admin Login */
   if(u.pathname==="/auth/google")
    return login(env);

   if(u.pathname==="/auth/callback")
    return callback(req,env);

   if(u.pathname==="/auth/logout")
    return logout();

   /* User */
   if(u.pathname==="/api/me")
    return me(req,env);

   /* Payments */
   if(
    u.pathname==="/api/payment/create" &&
    req.method==="POST"
   )
    return createPayment(req,env);

   if(u.pathname==="/api/payment/status")
    return paymentStatus(req,env);

   /* Admin */
   if(u.pathname==="/api/admin/me")
    return adminMe(req,env);

   if(u.pathname==="/api/admin/payments")
    return adminPayments(req,env);

   if(
    u.pathname==="/api/admin/approve" &&
    req.method==="POST"
   )
    return approve(req,env);

   if(
    u.pathname==="/api/admin/reject" &&
    req.method==="POST"
   )
    return reject(req,env);

   /* Internal premium check */
   if(
    u.pathname==="/internal/check" &&
    req.method==="POST"
   )
    return internalCheck(req,env);

   return json({
    success:false,
    error:"Not found"
   },404);

  }catch(e){

   console.error(e);

   return json({
    success:false,
    error:"Server error"
   },500);
  }
 }
};


/* =========================
   CORS
========================= */

function cors(r){

 const h=new Headers(r.headers);

 h.set(
  "Access-Control-Allow-Origin",
  SITE
 );

 h.set(
  "Access-Control-Allow-Credentials",
  "true"
 );

 h.set(
  "Access-Control-Allow-Headers",
  "Content-Type,Authorization"
 );

 h.set(
  "Access-Control-Allow-Methods",
  "GET,POST,OPTIONS"
 );

 return new Response(
  r.body,
  {
   status:r.status,
   headers:h
  }
 );
}


/* =========================
   JSON
========================= */

function json(x,s=200){

 return cors(
  new Response(
   JSON.stringify(x),
   {
    status:s,
    headers:{
     "Content-Type":"application/json"
    }
   }
  )
 );
}


/* =========================
   REDIRECT
========================= */

function redir(url){

 return new Response(
  null,
  {
   status:302,
   headers:{
    Location:url
   }
  }
 );
}


/* =========================
   GOOGLE LOGIN
========================= */

async function login(env){

 const state=crypto.randomUUID();

 const redirect=
  "https://pay.createlk.workers.dev/auth/callback";

 await env.DB.prepare(`
  INSERT INTO oauth_states
  (state,expires_at)
  VALUES(?,?)
 `)
 .bind(
  state,
  Math.floor(Date.now()/1000)+600
 )
 .run();

 const p=new URLSearchParams({
  client_id:env.GOOGLE_CLIENT_ID,
  redirect_uri:redirect,
  response_type:"code",
  scope:"openid email profile",
  state
 });

 return redir(
  `${GOOGLE_AUTH}?${p.toString()}`
 );
}


/* =========================
   GOOGLE CALLBACK
========================= */

async function callback(req,env){

 const u=new URL(req.url);

 const code=u.searchParams.get("code");
 const state=u.searchParams.get("state");

 if(!code||!state){

  return json({
   success:false,
   error:"Invalid login"
  },400);
 }


 /* Check OAuth state */

 const st=await env.DB.prepare(`
  SELECT state
  FROM oauth_states
  WHERE state=?
  AND expires_at>?
 `)
 .bind(
  state,
  Math.floor(Date.now()/1000)
 )
 .first();

 if(!st){

  return json({
   success:false,
   error:"Invalid or expired state"
  },400);
 }


 await env.DB.prepare(
  "DELETE FROM oauth_states WHERE state=?"
 )
 .bind(state)
 .run();


 /* Exchange code */

 const token=await fetch(
  GOOGLE_TOKEN,
  {
   method:"POST",

   headers:{
    "Content-Type":
     "application/x-www-form-urlencoded"
   },

   body:new URLSearchParams({
    code,
    client_id:env.GOOGLE_CLIENT_ID,
    client_secret:env.GOOGLE_CLIENT_SECRET,
    redirect_uri:
     "https://pay.createlk.workers.dev/auth/callback",
    grant_type:"authorization_code"
   })
  }
 );

 const td=await token.json();

 if(!td.access_token){

  console.error("Google token error",td);

  return json({
   success:false,
   error:"Google login failed"
  },400);
 }


 /* Get Google account */

 const gr=await fetch(
  GOOGLE_USERINFO,
  {
   headers:{
    Authorization:
     `Bearer ${td.access_token}`
   }
  }
 );

 const g=await gr.json();

 const email=
  String(g.email||"").toLowerCase();


 /* Admin email check */

 if(email!==ADMIN.toLowerCase()){

  return json({
   success:false,
   error:"Admin access only"
  },403);
 }


 /* Create admin session */

 const session=
  crypto.randomUUID();

 await env.DB.prepare(`
  INSERT OR REPLACE INTO admin_sessions
  (token_hash,expires_at)
  VALUES(?,?)
 `)
 .bind(
  await hash(session),
  new Date(
   Date.now()+86400000
  ).toISOString()
 )
 .run();


 /*
  IMPORTANT:
  After admin login,
  go to the main English admin page.
 */

 return new Response(
  null,
  {
   status:302,

   headers:{
    Location:
     `${SITE}/Eng/admin.html`,

    "Set-Cookie":
     `${COOKIE}=${session}; Path=/; HttpOnly; Secure; SameSite=Lax; Max-Age=86400`
   }
  }
 );
}


