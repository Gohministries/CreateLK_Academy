  method,
  reference,
  proof,
  now
 ).run();


 return json({
  success:true,
  payment_id:x.meta.last_row_id,
  status:"PENDING"
 });

}


/* =========================
   ACTIVATE PREMIUM
========================= */

async function activate(r,e){

 try{
  await requireAdmin(r,e);
 }catch(x){
  return err(
   x.message,
   x.status||401
  );
 }


 if(r.method!=="POST")
  return err("POST required",405);


 const a=
  await adminUser(r,e);

 const b=
  await body(r);


 if(!b)
  return err(
   "Invalid JSON",
   400
  );


 const paymentId=
  Number(b.payment_id||0);

 const userId=
  Number(b.user_id||0);

 const email=
  clean(b.email).toLowerCase();

 const name=
  clean(b.name);

 const days=
  Math.max(
   1,
   Number(
    b.days||DEFAULT_DAYS
   )
  );

 const amount=
  Number(b.amount||0);

 const method=
  clean(b.method)||"MANUAL";

 const reference=
  clean(b.reference);

 const referralCode=
  clean(b.referral_code)
   .toUpperCase();


 /* Find payment if supplied */

 let p=null;


 if(paymentId){

  p=await e.DB.prepare(`
   SELECT *
   FROM payments
   WHERE id=?
   LIMIT 1
  `).bind(
   paymentId
  ).first();


  if(!p)
   return err(
    "Payment not found",
    404
   );


  if(p.status==="APPROVED")
   return err(
    "Payment already approved",
    400
   );

 }


 /*
   IMPORTANT:

   Find the real user
   from the existing users table.
 */

 let uid=
  Number(
   p?.user_id||
   userId||
   0
  );


 let user=null;


 if(uid){

  user=await e.DB.prepare(`
   SELECT *
   FROM users
   WHERE id=?
   LIMIT 1
  `).bind(
   uid
  ).first();

 }


 if(!user&&email){

  user=await e.DB.prepare(`
   SELECT *
   FROM users
   WHERE lower(email)=?
   LIMIT 1
  `).bind(
   email
  ).first();

  if(user)
   uid=Number(user.id);

 }


 if(!user)
  return err(
   "User not found",
   404
  );


 const now=
  new Date().toISOString();


 /*
   Calculate expiry from existing
   membership expiry.

   If current Premium is still active,
   extend from that expiry.

   Otherwise start from now.
 */

 let oldExpiry=null;

 if(
  user.membership_expiry &&
  new Date(
   user.membership_expiry
  )>new Date()
 ){

  oldExpiry=
   new Date(
    user.membership_expiry
   );

 }else{

  oldExpiry=
   new Date();

 }


 const expiry=
  new Date(
   oldExpiry.getTime()+
   days*86400000
  ).toISOString();


 /*
   Update the REAL users table.
 */

 await e.DB.prepare(`
  UPDATE users
  SET
   membership_status='PREMIUM',
   membership_expiry=?
  WHERE id=?
 `).bind(
  expiry,
  uid
 ).run();


 /*
   Keep premium_users synchronized too.
 */

 await e.DB.prepare(`
  INSERT INTO premium_users(
   user_id,
   email,
   name,
   status,
   membership_expiry,
   updated_at
  )
  VALUES(
   ?,?,?, 'PREMIUM',?,?
  )
  ON CONFLICT(user_id)
  DO UPDATE SET
   email=excluded.email,
   name=excluded.name,
   status='PREMIUM',
   membership_expiry=excluded.membership_expiry,
   updated_at=excluded.updated_at
 `).bind(
  uid,
  user.email||email,
  user.name||name,
  expiry,
  now
 ).run();


 /*
   Create or approve payment.
 */

 let pid=
  paymentId;


 if(!pid){

  const z=await e.DB.prepare(`
   INSERT INTO payments(
    user_id,
    email,
    name,
    amount,
    method,
    reference,
    status,
    created_at,
    approved_at,
    approved_by
   )
   VALUES(
    ?,?,?,?,?,?,
    'APPROVED',
    ?,?,?
   )
  `).bind(
   uid,
   user.email||email,
   user.name||name,
   amount,
   method,
   reference,
   now,
   now,
   a.email
  ).run();


  pid=z.meta.last_row_id;

 }else{

  await e.DB.prepare(`
   UPDATE payments
   SET
    status='APPROVED',
    approved_at=?,
    approved_by=?,
    amount=
     CASE
      WHEN ? > 0
      THEN ?
      ELSE amount
     END
   WHERE id=?
  `).bind(
   now,
   a.email,
   amount,
   amount,
   pid
  ).run();

 }


 /*
   Referral commission
 */

 const rateRow=
  await e.DB.prepare(`
   SELECT value
   FROM settings
   WHERE key='commission_rate'
  `).first();


 const rate=
  Number(
   rateRow?.value||
   DEFAULT_COMMISSION
  );


 if(
  referralCode &&
  amount>0
 ){

  const m=
   referralCode.match(
    /^ENG(\d+)$/
   );


  if(m){

   const rid=
    Number(m[1]);


   if(
    rid &&
    rid!==uid
   ){

    /*
      Make sure referrer exists.
    */

    const referrer=
     await e.DB.prepare(`
      SELECT id
      FROM users
      WHERE id=?
      LIMIT 1
     `).bind(
      rid
     ).first();


    if(referrer){

     const exists=
      await e.DB.prepare(`
       SELECT id
       FROM referrals
       WHERE payment_id=?
       LIMIT 1
      `).bind(
       pid
      ).first();


     if(!exists){

      const commission=
       Math.round(
        amount*
        rate/
        100*
        100
       )/100;


      await e.DB.prepare(`
       INSERT INTO referrals(
        payment_id,
        referrer_id,
        referred_user_id,
        referral_code,
        commission_rate,
        commission_amount,
        status,
        created_at
       )
       VALUES(
        ?,?,?,?,?,?,
        'APPROVED',
        ?
       )
      `).bind(
       pid,
       rid,
       uid,
       referralCode,
       rate,
       commission,
       now
      ).run();

     }

    }

   }

  }

 }


 return json({

  success:true,

  payment_id:pid,

  user_id:uid,

  status:"PREMIUM",

  membership_expiry:expiry

 });

}


