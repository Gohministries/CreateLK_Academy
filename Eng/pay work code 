  clean(b.email).toLowerCase();

 const name=
  clean(b.name);

 const amount=
  Number(b.amount||0);

 const method=
  clean(b.method)||"MANUAL";

 const reference=
  clean(b.reference);

 const proof=
  clean(b.proof);


 if(!userId&&!email)
  return err(
   "User ID or email required",
   400
  );


 const now=
  new Date().toISOString();


 const x=await e.DB.prepare(`
  INSERT INTO payments(
   user_id,
   email,
