/* =========================
   SETTINGS
========================= */

async function settings(r,e){

 try{
  await requireAdmin(r,e);
 }catch(x){
  return err(
   x.message,
   x.status||401
  );
 }


 if(r.method==="GET"){

  const x=await e.DB.prepare(`
   SELECT value
   FROM settings
   WHERE key='commission_rate'
  `).first();


  return json({
   success:true,
   commission_rate:
    Number(
     x?.value||DEFAULT_COMMISSION
    )
  });

 }


 if(r.method!=="POST")
  return err("POST required",405);


 const b=await body(r);

 const rate=
  Number(b?.commission_rate);


 if(
  !Number.isFinite(rate)||
  rate<0||
  rate>100
 ){

  return err(
   "Commission must be between 0 and 100.",
   400
  );

 }


 await e.DB.prepare(`
  INSERT INTO settings(key,value)
  VALUES('commission_rate',?)
  ON CONFLICT(key)
  DO UPDATE SET value=excluded.value
 `).bind(
  String(rate)
 ).run();


 return json({
  success:true,
  commission_rate:rate
 });

}


