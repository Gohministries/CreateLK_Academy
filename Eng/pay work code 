async function settings(r,e){
 try{await requireAdmin(r,e)}catch(x){return err(x.message,x.status||401)}

 if(r.method==="GET"){
  const x=await e.DB.prepare(
   "SELECT value FROM settings WHERE key='commission_rate'"
  ).first();

  return json({
   success:true,
   commission_rate:Number(x?.value||DEFAULT_COMMISSION)
  });
 }

 const b=await body(r);
 const rate=Number(b?.commission_rate);

 if(!Number.isFinite(rate)||rate<0||rate>100)
  return err("Commission must be between 0 and 100.",400);

 await e.DB.prepare(
  "INSERT INTO settings(key,value) VALUES('commission_rate',?) ON CONFLICT(key) DO UPDATE SET value=excluded.value"
 ).bind(String(rate)).run();

 return json({
  success:true,
  commission_rate:rate
 });
}

async function addPayment(r,e){
 try{await requireAdmin(r,e)}catch(x){return err(x.message,x.status||401)}

 if(r.method!=="POST")return err("POST required",405);

 const a=await adminUser(r,e);
 const b=await body(r);

 if(!b)return err("Invalid JSON",400);

 const userId=Number(b.user_id);
 const email=clean(b.email).toLowerCase();
 const name=clean(b.name);
 const amount=Number(b.amount||0);
 const method=clean(b.method)||"MANUAL";
 const reference=clean(b.reference);
 const proof=clean(b.proof);

 if(!userId&&!email)return err("User ID or email required",400);

 const now=new Date().toISOString();

 const x=await e.DB.prepare(`
  INSERT INTO payments(
   user_id,email,name,amount,method,reference,proof,status,created_at
  ) VALUES(?,?,?,?,?,? ,?,'PENDING',?)
 `).bind(
  userId||0,
  email,
  name,
  amount,
  method,
  reference,
  proof,
  now
 ).run();

 return json({
  success:true,
  payment_id:x.meta.last_row_id,
  status:"PENDING"
 });
}

async function activate(r,e){
 try{await requireAdmin(r,e)}catch(x){return err(x.message,x.status||401)}

 if(r.method!=="POST")return err("POST required",405);

 const a=await adminUser(r,e);
 const b=await body(r);

 if(!b)return err("Invalid JSON",400);

 const paymentId=Number(b.payment_id);
 const userId=Number(b.user_id);
 const email=clean(b.email).toLowerCase();
 const name=clean(b.name);
 const days=Math.max(1,Number(b.days||DEFAULT_DAYS));
 const amount=Number(b.amount||0);
 const method=clean(b.method)||"MANUAL";
 const reference=clean(b.reference);

 let p=null;

 if(paymentId){
  p=await e.DB.prepare(
   "SELECT * FROM payments WHERE id=? LIMIT 1"
  ).bind(paymentId).first();

  if(!p)return err("Payment not found",404);

  if(p.status==="APPROVED")
   return err("Payment already approved",400);
 }

 let uid=Number(p?.user_id||userId);

 if(!uid&&email){
  const old=await e.DB.prepare(
   "SELECT user_id FROM premium_users WHERE lower(email)=? LIMIT 1"
  ).bind(email).first();
  uid=Number(old?.user_id||0);
 }

 if(!uid)return err("User not found",404);

 const old=await e.DB.prepare(
  "SELECT * FROM premium_users WHERE user_id=? LIMIT 1"
 ).bind(uid).first();

 const oldExpiry=old?.membership_expiry&&new Date(old.membership_expiry)>new Date()
  ?new Date(old.membership_expiry)
  :new Date();

 const expiry=new Date(oldExpiry.getTime()+days*86400000).toISOString();
 const now=new Date().toISOString();

 await e.DB.prepare(`
  INSERT INTO premium_users(user_id,email,name,status,membership_expiry,updated_at)
  VALUES(?,?,?,'PREMIUM',?,?)
  ON CONFLICT(user_id) DO UPDATE SET
   email=excluded.email,
   name=excluded.name,
   status='PREMIUM',
   membership_expiry=excluded.membership_expiry,
   updated_at=excluded.updated_at
 `).bind(
  uid,
  clean(p?.email||email),
  clean(p?.name||name),
  expiry,
  now
 ).run();

 let pid=paymentId;

 if(!pid){
  const z=await e.DB.prepare(`
   INSERT INTO payments(
    user_id,email,name,amount,method,reference,status,created_at
   ) VALUES(?,?,?,?,? ,?,'APPROVED',?)
  `).bind(
   uid,
   clean(email||old?.email),
   clean(name||old?.name),
   amount,
   method,
   reference,
   now
  ).run();

  pid=z.meta.last_row_id;
 }else{
  await e.DB.prepare(`
   UPDATE payments
   SET status='APPROVED',
       approved_at=?,
       approved_by=?,
       amount=CASE WHEN ? > 0 THEN ? ELSE amount END
   WHERE id=?
  `).bind(
   now,
   a.email,
   amount,
   amount,
   pid
  ).run();
 }

 const rateRow=await e.DB.prepare(
  "SELECT value FROM settings WHERE key='commission_rate'"
 ).first();

 const rate=Number(rateRow?.value||DEFAULT_COMMISSION);

 const referralCode=clean(b.referral_code).toUpperCase();

 if(referralCode&&amount>0){
  const m=referralCode.match(/^ENG(\d+)$/);

  if(m){
   const rid=Number(m[1]);

   if(rid&&rid!==uid){
    const exists=await e.DB.prepare(
     "SELECT id FROM referrals WHERE payment_id=? LIMIT 1"
    ).bind(pid).first();

    if(!exists){
     const commission=Math.round(amount*rate/100*100)/100;

     await e.DB.prepare(`
      INSERT INTO referrals(
       payment_id,
       referrer_id,
       referred_user_id,
       referral_code,
       commission_rate,
       commission_amount,
       status,
       created_at
      ) VALUES(?,?,?,?,?,?, 'APPROVED',?)
     `).bind(
      pid,
      rid,
      uid,
      referralCode,
      rate,
      commission,
      now
     ).run();
    }
   }
  }
 }

 return json({
  success:true,
  payment_id:pid,
  user_id:uid,
  status:"PREMIUM",
  membership_expiry:expiry
 });
}

async function logout(r,e){
 const s=cookies(r)[SESSION];

 if(s){
  await e.DB.prepare(
   "DELETE FROM admin_sessions WHERE token_hash=?"
  ).bind(await sha256(s)).run();
 }

 return new Response(null,{
  status:302,
  headers:{
   Location:`${SITE}/Eng/admin.html`,
   "Set-Cookie":`${SESSION}=;Path=/;HttpOnly;Secure;SameSite=None;Max-Age=0`
  }
 });
}

async function body(r){
 try{return await r.json()}catch{return null}
}

function token(n=32){
 const a=new Uint8Array(n);
 crypto.getRandomValues(a);
 return[...a].map(x=>x.toString(16).padStart(2,"0")).join("");
}

async function sha256(x){
 const h=await crypto.subtle.digest(
  "SHA-256",
  new TextEncoder().encode(x)
 );
 return[...new Uint8Array(h)]
  .map(x=>x.toString(16).padStart(2,"0"))
  .join("");
}

function cookies(r){
 const o={},h=r.headers.get("Cookie");
 if(!h)return o;

 for(const p of h.split(";")){
  const i=p.indexOf("=");
  if(i>=0)o[p.slice(0,i).trim()]=decodeURIComponent(
   p.slice(i+1).trim()
  );
 }

 return o;
}

function clean(x){
 return String(x||"").trim();
}

function json(x,status=200){
 return cors(new Response(
  JSON.stringify(x),
  {
   status,
   headers:{"Content-Type":"application/json;charset=UTF-8"}
  }
 ));
}

function err(error,status=400,extra={}){
 return json({success:false,error,...extra},status);
}

function cors(r){
 r.headers.set("Access-Control-Allow-Origin",SITE);
 r.headers.set("Access-Control-Allow-Credentials","true");
 r.headers.set("Access-Control-Allow-Headers","Content-Type");
 r.headers.set("Access-Control-Allow-Methods","GET,POST,OPTIONS");
 return r;
}