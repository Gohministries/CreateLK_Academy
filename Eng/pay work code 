/* =========================
   INTERNAL PREMIUM CHECK
========================= */

async function internalCheck(req,env){

 const auth=
  req.headers.get("Authorization")||"";

 if(
  auth!==`Bearer ${env.INTERNAL_SECRET}`
 ){

  return json({
   success:false,
   error:"Unauthorized"
  },401);
 }


 const b=
  await req.json();

 const id=
  Number(b.user_id);

 if(!id){

  return json({
   success:false,
   error:"Missing user_id"
  },400);
 }


 /*
  Check premium_users first.
 */

 const p=
  await env.DB.prepare(`
   SELECT
    membership_expiry,
    status
   FROM premium_users
   WHERE user_id=?
  `)
  .bind(id)
  .first();


 /*
  Also check users.
 */

 const u=
  await env.DB.prepare(`
   SELECT
    membership_status,
    membership_expiry
   FROM users
   WHERE id=?
  `)
  .bind(id)
  .first();


 const expiry=
  p?.membership_expiry||
  u?.membership_expiry||
  null;


 const premium=(
  (
   p?.status==="PREMIUM"||
   u?.membership_status==="PREMIUM"
  )&&
  expiry&&
  new Date(expiry).getTime()>Date.now()
 );


 /*
  Automatically downgrade expired user.
 */

 if(
  !premium&&
  u?.membership_status==="PREMIUM"
 ){

  await env.DB.prepare(`
   UPDATE users
   SET membership_status='FREE'
   WHERE id=?
  `)
  .bind(id)
  .run();


  await env.DB.prepare(`
   UPDATE premium_users
   SET
    status='FREE',
    updated_at=CURRENT_TIMESTAMP
   WHERE user_id=?
  `)
  .bind(id)
  .run();
 }


 return json({
  success:true,
  premium:!!premium,
  membership_status:
   premium?"PREMIUM":"FREE",
  membership_expiry:
   premium?expiry:null
 });
}


/* =========================
   USER ME
========================= */

async function me(req,env){

 const auth=
  req.headers.get("Authorization")||"";

 if(!auth.startsWith("Bearer ")){

  return json({
   success:false,
   error:"Unauthorized"
  },401);
 }


 const userId=
  Number(auth.slice(7));

 if(!userId){

  return json({
   success:false,
   error:"Invalid user"
  },401);
 }


 return internalCheck(
  new Request(
   "https://pay/internal/check",
   {
    method:"POST",

    headers:{
     Authorization:
      `Bearer ${env.INTERNAL_SECRET}`,

     "Content-Type":
      "application/json"
    },

    body:JSON.stringify({
     user_id:userId
    })
   }
  ),
  env
 );
}


/* =========================
   HASH
========================= */

async function hash(s){

 const b=
  await crypto.subtle.digest(
   "SHA-256",
   new TextEncoder().encode(s)
  );

 return [
  ...new Uint8Array(b)
 ]
 .map(
  x=>x.toString(16).padStart(2,"0")
 )
 .join("");
}