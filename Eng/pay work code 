const SITE="https://createlk.com";
const PREMIUM_PRICE_LKR=1000;
const PAYHERE_CHECKOUT="https://www.payhere.lk/pay/checkout";
const CURRENCY="LKR";
const PREMIUM_DAYS=30;
const COMMISSION_RATE=20;

export default{
async fetch(request,env){
try{
const url=new URL(request.url);
const path=url.pathname;

if(request.method==="OPTIONS")
return new Response(null,{status:204,headers:{
"Access-Control-Allow-Origin":"*",
"Access-Control-Allow-Methods":"GET,POST,OPTIONS",
"Access-Control-Allow-Headers":"Content-Type"
}});

if(path==="/health")
return json({
ok:true,
service:"CreateLK PayHere",
premium_price:PREMIUM_PRICE_LKR,
currency:CURRENCY,
premium_days:PREMIUM_DAYS
});

if(path==="/pay"&&request.method==="GET")return pay(request,env);
if(path==="/notify"&&(request.method==="POST"||request.method==="GET"))return notify(request,env);

if(path==="/return"||path==="/cancel")
return Response.redirect(${SITE}/Eng/,302);

if(path==="/")
return new Response("CreateLK Pay Worker",{status:200});

return new Response("Not Found",{status:404});

}catch(e){
console.error("WORKER ERROR",e);
return new Response("Payment Worker Error: "+String(e?.message||e),{
status:500,
headers:{"Content-Type":"text/plain;charset=UTF-8"}
});
}
}
};

/* PAYMENT */

async function pay(request,env){
try{
const url=new URL(request.url);
const paymentToken=url.searchParams.get("token");

if(!paymentToken)return new Response("Missing payment token.",{status:400});
if(!env.DB)return new Response("Payment configuration error: DB binding missing.",{status:500});
if(!env.PAYHERE_MERCHANT_ID)return new Response("Payment configuration error: merchant ID missing.",{status:500});
if(!env.PAYHERE_MERCHANT_SECRET)return new Response("Payment configuration error: merchant secret missing.",{status:500});

const tokenHash=await sha256(paymentToken);

const session=await env.DB.prepare(  SELECT   ps.id,ps.user_id,ps.lesson_id,ps.order_id,ps.amount,ps.currency,   ps.status,ps.expires_at,u.name,u.email,u.whatsapp_number   FROM payment_sessions ps   JOIN users u ON u.id=ps.user_id   WHERE ps.token_hash=?   LIMIT 1  ).bind(tokenHash).first();

if(!session)return new Response("Invalid or expired payment session.",{status:400});
if(String(session.status).toUpperCase()!=="PENDING")
return new Response("This payment session is no longer active.",{status:400});

if(!session.expires_at)
return new Response("Invalid payment session.",{status:400});

if(new Date(session.expires_at).getTime()<=Date.now()){
await env.DB.prepare(  UPDATE payment_sessions SET status='EXPIRED'   WHERE id=? AND status='PENDING'  ).bind(session.id).run();

return new Response("Payment session expired. Please start again.",{status:400});
}

const amount=Number(session.amount);
if(!Number.isFinite(amount)||amount<=0)
return new Response("Invalid payment amount.",{status:400});

const currency=String(session.currency||CURRENCY).toUpperCase();
if(currency!=="LKR")
return new Response("Invalid payment currency.",{status:400});

const merchantId=String(env.PAYHERE_MERCHANT_ID).trim();
const merchantSecret=String(env.PAYHERE_MERCHANT_SECRET);
const amountText=amount.toFixed(2);
const secretHash=(await md5(merchantSecret)).toUpperCase();

const hash=(await md5(
merchantId+
String(session.order_id)+
amountText+
currency+
secretHash
)).toUpperCase();

const firstName=cleanName(session.name)||"CreateLK";
const email=String(session.email||"").trim();
const phone=String(session.whatsapp_number||"").trim();

const fields={
merchant_id:merchantId,
return_url:${SITE}/Eng/,
cancel_url:${SITE}/Eng/,
notify_url:${url.origin}/notify,
first_name:firstName,
last_name:"",
email,
phone,
address:"Sri Lanka",
city:"",
country:"Sri Lanka",
order_id:String(session.order_id),
items:"CreateLK English Premium - 30 Days",
currency,
amount:amountText,
hash
};

const hidden=Object.entries(fields).map(([key,value])=>
<input type="hidden" name="${html(key)}" value="${html(value)}">
).join("");

const displayAmount=${currency} ${amount.toLocaleString("en-LK",{   minimumFractionDigits:2,   maximumFractionDigits:2   })};

return new Response(`<!DOCTYPE html>

<html lang="en">    
<head>    
<meta charset="UTF-8">    
<meta name="viewport" content="width=device-width,initial-scale=1">    
<meta name="theme-color" content="#0b1628">    
<title>CreateLK English Premium Payment</title>    
<style>    
*{box-sizing:border-box}    
body{    
margin:0;min-height:100vh;display:flex;align-items:center;    
justify-content:center;background:#0b1628;color:#fff;    
font-family:Arial,sans-serif;text-align:center;padding:20px    
}    
.box{    
width:100%;max-width:390px;padding:30px 24px;background:#13233b;    
border:1px solid #30435e;border-radius:18px;    
box-shadow:0 15px 45px rgba(0,0,0,.35)    
}    
.brand{    
font-size:14px;font-weight:700;letter-spacing:1px;color:#d9b85c;    
margin-bottom:10px;text-transform:uppercase    
}    
.amount{font-size:34px;font-weight:800;color:#d9b85c;margin-bottom:6px}    
.plan{font-size:16px;font-weight:600;margin-bottom:5px}    
.duration{font-size:14px;color:#b9c6d8;margin-bottom:24px}    
.spinner{    
width:38px;height:38px;margin:0 auto 16px;border:4px solid #30435e;    
border-top-color:#d9b85c;border-radius:50%;animation:spin 1s linear infinite    
}    
@keyframes spin{to{transform:rotate(360deg)}}    
h2{margin:0 0 8px;font-size:20px}    
.message{margin:0;color:#c8d2e2;font-size:14px;line-height:1.5}    
.secure{margin-top:18px;font-size:12px;color:#8291a7}    
</style>    
</head>    
<body>    
<div class="box">    
<div class="brand">CreateLK English</div>    
<div class="amount">${html(displayAmount)}</div>    
<div class="plan">Premium Access</div>    
<div class="duration">${PREMIUM_DAYS} Days</div>    
<div class="spinner"></div>    
<h2>Redirecting to PayHere...</h2>    
<p class="message">Please wait while we securely open the payment page.</p>    
<div class="secure">Secure payment powered by PayHere</div>    
<form id="payhere" method="POST" action="${PAYHERE_CHECKOUT}">    
${hidden}    
</form>    
</div>    
<script>document.getElementById("payhere").submit();</script>    
</body>    
</html>`,{    
status:200,    
headers:{    
"Content-Type":"text/html;charset=UTF-8",    
"Cache-Control":"no-store"    
}    
});  }catch(e){  
console.error("PAY ERROR",e);  
return new Response("Payment error: "+String(e?.message||e),{  
status:500,  
headers:{  
"Content-Type":"text/plain;charset=UTF-8",  
"Cache-Control":"no-store"  
}  
});  
}  
}  /* NOTIFY */

async function notify(request,env){
try{
if(!env.DB)return new Response("DB binding missing.",{status:500});
if(!env.PAYHERE_MERCHANT_ID||!env.PAYHERE_MERCHANT_SECRET)
return new Response("PayHere configuration missing.",{status:500});

let data={};

if(request.method==="POST"){
const type=request.headers.get("content-type")||"";

if(type.includes("application/x-www-form-urlencoded")){
const form=await request.formData();
for(const [key,value] of form.entries())data[key]=String(value);
}else{
try{
data=await request.json();
}catch{
data=parseForm(await request.text());
}
}
}else{
const url=new URL(request.url);
for(const [key,value] of url.searchParams.entries())data[key]=value;
}

const merchantId=String(data.merchant_id||"").trim();
const orderId=String(data.order_id||"").trim();
const amount=String(data.payhere_amount||"").trim();
const currency=String(data.payhere_currency||"").trim().toUpperCase();
const statusCode=String(data.status_code||"").trim();
const receivedHash=String(data.md5sig||"").trim().toUpperCase();

if(!merchantId||!orderId||!amount||!currency||!statusCode||!receivedHash)
return new Response("Invalid notification.",{status:400});

if(merchantId!==String(env.PAYHERE_MERCHANT_ID).trim())
return new Response("Invalid merchant.",{status:400});

const secretHash=(await md5(
String(env.PAYHERE_MERCHANT_SECRET)
)).toUpperCase();

const expectedHash=(await md5(
merchantId+
orderId+
amount+
currency+
statusCode+
secretHash
)).toUpperCase();

if(receivedHash!==expectedHash){
console.error("INVALID PAYHERE HASH",{orderId,receivedHash,expectedHash});
return new Response("Invalid hash.",{status:400});
}

const payment=await env.DB.prepare(  SELECT * FROM payments WHERE order_id=? LIMIT 1  ).bind(orderId).first();

if(!payment)return new Response("Payment not found.",{status:404});

if(statusCode!=="2"){
const status=paymentStatus(statusCode);

await env.DB.prepare(  UPDATE payments SET status=?   WHERE order_id=? AND status='PENDING'  ).bind(status,orderId).run();

await env.DB.prepare(  UPDATE payment_sessions SET status=?   WHERE order_id=? AND status='PENDING'  ).bind(status,orderId).run();

return new Response("OK",{status:200});
}

if(String(payment.status).toUpperCase()==="PAID")
return new Response("OK",{status:200});

const paidAmount=Number(amount);
const expectedAmount=Number(payment.amount);

if(!Number.isFinite(paidAmount)||paidAmount<=0)
return new Response("Invalid amount.",{status:400});

if(
!Number.isFinite(expectedAmount)||
Math.abs(expectedAmount-paidAmount)>0.01||
String(payment.currency||"LKR").toUpperCase()!==currency
){
console.error("PAYMENT AMOUNT/CURRENCY MISMATCH",{
orderId,expectedAmount,paidAmount,
expectedCurrency:payment.currency,currency
});
return new Response("Payment verification failed.",{status:400});
}

const user=await env.DB.prepare(  SELECT * FROM users WHERE id=? LIMIT 1  ).bind(payment.user_id).first();

if(!user)return new Response("User not found.",{status:404});

const now=new Date();
let start=now;

if(
String(user.membership_status||"").toUpperCase()==="PREMIUM"&&
user.membership_expiry
){
const oldExpiry=new Date(user.membership_expiry);
if(!Number.isNaN(oldExpiry.getTime())&&oldExpiry.getTime()>now.getTime())
start=oldExpiry;
}

const expiry=new Date(
start.getTime()+PREMIUM_DAYS2460601000
).toISOString();

const paymentUpdate=await env.DB.prepare(  UPDATE payments   SET status='PAID',paid_at=CURRENT_TIMESTAMP   WHERE order_id=? AND status='PENDING'  ).bind(orderId).run();

if(Number(paymentUpdate?.meta?.changes||0)===0)
return new Response("OK",{status:200});

await env.DB.prepare(  UPDATE payment_sessions SET status='PAID'   WHERE order_id=? AND status='PENDING'  ).bind(orderId).run();

await env.DB.prepare(  UPDATE users   SET membership_status='PREMIUM',membership_expiry=?   WHERE id=?  ).bind(expiry,payment.user_id).run();

const referral=await env.DB.prepare(  SELECT id,referrer_id,referred_user_id   FROM referrals   WHERE referred_user_id=?   LIMIT 1  ).bind(payment.user_id).first();

if(
referral&&
Number(referral.referrer_id)>0&&
Number(referral.referrer_id)!==Number(payment.user_id)
){
const commissionAmount=Math.round(
paidAmount*COMMISSION_RATE
)/100;

try{
await env.DB.prepare(  INSERT INTO affiliate_commissions   (payment_id,order_id,referrer_id,referred_user_id,   payment_amount,commission_rate,commission_amount,status)   VALUES(?,?,?,?,?,?,?,'AVAILABLE')  ).bind(
payment.id,
orderId,
referral.referrer_id,
payment.user_id,
paidAmount,
COMMISSION_RATE,
commissionAmount
).run();
}catch(e){
console.error("COMMISSION INSERT",e);
}
}

console.log("PAYMENT SUCCESS",{
orderId,
userId:payment.user_id,
amount:paidAmount,
premiumExpiry:expiry,
referralId:referral?.id||null
});

return new Response("OK",{status:200});

}catch(e){
console.error("NOTIFY ERROR",e);
return new Response(
"Notification error: "+String(e?.message||e),
{status:500}
);
}
}

/* HELPERS */

function paymentStatus(code){
const c=String(code);
if(c==="2")return"PAID";
if(c==="0")return"PENDING";
if(c==="-1")return"CANCELLED";
if(c==="-2")return"FAILED";
if(c==="-3")return"CHARGEDBACK";
return"FAILED";
}

function json(data,status=200){
return new Response(JSON.stringify(data),{
status,
headers:{
"Content-Type":"application/json;charset=UTF-8",
"Cache-Control":"no-store"
}
});
}

function html(v){
return String(v??"")
.replace(/&/g,"&")
.replace(/"/g,""")
.replace(/</g,"<")
.replace(/>/g,">");
}

function cleanName(v){
return String(v??"")
.replace(/[<>]/g,"")
.trim()
.slice(0,80);
}

function parseForm(text){
const out={};
const p=new URLSearchParams(text||"");
for(const [key,value] of p.entries())out[key]=value;
return out;
}

async function sha256(value){
const data=new TextEncoder().encode(String(value));
const hash=await crypto.subtle.digest("SHA-256",data);
return[...new Uint8Array(hash)]
.map(b=>b.toString(16).padStart(2,"0"))
.join("");
}

/* MD5 */

async function md5(input){
const msg=String(input);
const bytes=new TextEncoder().encode(msg);
const bitLen=bytes.length*8;
const newLen=((bytes.length+8)>>6<<6)+64;
const buffer=new Uint8Array(newLen);

buffer.set(bytes);
buffer[bytes.length]=0x80;

const view=new DataView(buffer.buffer);

view.setUint32(newLen-8,bitLen>>>0,true);
view.setUint32(
newLen-4,
Math.floor(bitLen/4294967296)>>>0,
true
);

let a0=0x67452301;
let b0=0xefcdab89;
let c0=0x98badcfe;
let d0=0x10325476;

const K=new Uint32Array(64);

for(let i=0;i<64;i++){
K[i]=Math.floor(
Math.abs(Math.sin(i+1))*4294967296
)>>>0;
}

const S=[
7,12,17,22,7,12,17,22,
7,12,17,22,7,12,17,22,
5,9,14,20,5,9,14,20,
5,9,14,20,5,9,14,20,
4,11,16,23,4,11,16,23,
4,11,16,23,4,11,16,23,
6,10,15,21,6,10,15,21,
6,10,15,21,6,10,15,21
];

for(let offset=0;offset<buffer.length;offset+=64){
const M=new Uint32Array(16);

for(let i=0;i<16;i++)
M[i]=view.getUint32(offset+i*4,true);

let A=a0,B=b0,C=c0,D=d0;

for(let i=0;i<64;i++){
let F,g;

if(i<16){
F=(B&C)|((~B)&D);
g=i;
}else if(i<32){
F=(D&B)|((~D)&C);
g=(5i+1)%16;
}else if(i<48){
F=B^C^D;
g=(3i+5)%16;
}else{
F=C^(B|(~D));
g=(7*i)%16;
}

F=(F+A+K[i]+M[g])>>>0;

A=D;
D=C;
C=B;
B=(B+leftRotate(F,S[i]))>>>0;
}

a0=(a0+A)>>>0;
b0=(b0+B)>>>0;
c0=(c0+C)>>>0;
d0=(d0+D)>>>0;
}

return[a0,b0,c0,d0].map(x=>
[...new Uint8Array(new Uint32Array([x]).buffer)]
.map(b=>b.toString(16).padStart(2,"0"))
.join("")
).join("");
}

function leftRotate(x,c){
return((x<<c)|(x>>>(32-c)))>>>0;
}