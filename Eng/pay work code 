/* =========================
   INTERNAL PREMIUM CHECK
========================= */

async function internalCheck(r,e){

 if(r.method!=="POST")
  return err("POST required",405);

 const auth=r.headers.get("Authorization")||"";

 if(auth!==`Bearer ${e.INTERNAL_SECRET}`)
  return err("Unauthorized",401);

 const b=await body(r);

 const id=Number(b?.user_id);

 if(!id)
  return err("Invalid user_id",400);


/*
   IMPORTANT:

   Use the existing English users table.
*/

 const u=await e.DB.prepare(`
  SELECT
   membership_status,
   membership_expiry
  FROM users
  WHERE id=?
  LIMIT 1
 `).bind(id).first();

 if(!u){

  return json({
   success:true,
   premium:false,
   membership_expiry:null
  });

 }

 const expiry=u.membership_expiry||null;

 const active=
  u.membership_status==="PREMIUM" &&
  expiry &&
  new Date(expiry)>new Date();

 return json({
  success:true,
  premium:!!active,
  membership_expiry:active?expiry:null
 });

}


/* =========================
   GOOGLE LOGIN
========================= */

async function googleLogin(r,e){

 const state=token(32);

 await e.DB.prepare(`
  INSERT INTO oauth_states(state,expires_at)
  VALUES(?,?)
 `).bind(
  state,
  Date.now()+600000
 ).run();

 const q=new URLSearchParams({
  client_id:e.GOOGLE_CLIENT_ID,

  redirect_uri:
   `https://pay.createlk.workers.dev/auth/callback`,

  response_type:"code",

  scope:"openid email profile",

  state,

  prompt:"select_account"
 });

 return new Response(null,{
  status:302,

  headers:{
   Location:`${GA}?${q}`,

   "Set-Cookie":
    `${STATE}=${state};Path=/;HttpOnly;Secure;SameSite=None;Max-Age=600`
  }
 });

}


/* =========================
   GOOGLE CALLBACK
========================= */

async function googleCallback(r,e){

 const url=new URL(r.url);

 const code=url.searchParams.get("code");
 const state=url.searchParams.get("state");

 if(!code||!state)
  return new Response(
   "Invalid login.",
   {status:400}
  );

 const valid=await e.DB.prepare(`
  SELECT state
  FROM oauth_states
  WHERE state=? AND expires_at>?
 `).bind(
  state,
  Date.now()
 ).first();

 if(!valid)
  return new Response(
   "Login expired.",
   {status:400}
  );

 await e.DB.prepare(`
  DELETE FROM oauth_states
  WHERE state=?
 `).bind(state).run();


 const tr=await fetch(GT,{
  method:"POST",

  headers:{
   "Content-Type":
    "application/x-www-form-urlencoded"
  },

  body:new URLSearchParams({
   client_id:e.GOOGLE_CLIENT_ID,
   client_secret:e.GOOGLE_CLIENT_SECRET,
   code,
   grant_type:"authorization_code",

   redirect_uri:
    `https://pay.createlk.workers.dev/auth/callback`
  })
 });

 const td=await tr.json();

 if(!td.access_token)
  return new Response(
   "Google authentication failed.",
   {status:400}
  );


 const gr=await fetch(GU,{
  headers:{
   Authorization:`Bearer ${td.access_token}`
  }
 });

 const g=await gr.json();

 const email=
  clean(g.email).toLowerCase();


 if(email!==ADMIN_EMAIL.toLowerCase()){

  return new Response(
   "Admin access denied.",
   {status:403}
  );

 }


 const session=token(48);


 await e.DB.prepare(`
  INSERT INTO admin_sessions(
   token_hash,
   email,
   expires_at
  )
  VALUES(?,?,?)
 `).bind(
  await sha256(session),
  email,
  new Date(
   Date.now()+SESSION_DAYS*86400000
  ).toISOString()
 ).run();


 return new Response(null,{
  status:302,

  headers:{
   Location:`${SITE}/Eng/admin.html`,

   "Set-Cookie":
    `${SESSION}=${session};Path=/;HttpOnly;Secure;SameSite=None;Max-Age=${SESSION_DAYS*86400}`
  }
 });

}


/* =========================
   ADMIN SESSION
========================= */

async function adminUser(r,e){

 const s=cookies(r)[SESSION];

 if(!s)
  return null;

 return e.DB.prepare(`
  SELECT email
  FROM admin_sessions
  WHERE token_hash=?
    AND expires_at>?
  LIMIT 1
 `).bind(
  await sha256(s),
  new Date().toISOString()
 ).first();

}


async function adminMe(r,e){

 const a=await adminUser(r,e);

 if(!a){

  return json({
   success:true,
   logged_in:false,
   admin:false
  });

 }

 return json({
  success:true,
  logged_in:true,
  admin:true,
  email:a.email
 });

}


async function requireAdmin(r,e){

 const a=await adminUser(r,e);

 if(!a)
  throw Object.assign(
   Error("Admin login required"),
   {status:401}
  );

 return a;

}


