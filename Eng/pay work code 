async function users(r,e){

 try{
  await requireAdmin(r,e);
 }catch(x){
  return err(
   x.message,
   x.status||401
  );
 }


 const q=
  new URL(r.url)
  .searchParams
  .get("q")||"";


 let x;


 if(q){

  x=await e.DB.prepare(`
   SELECT
    u.id AS user_id,
    u.email,
    u.name,
    u.membership_status AS status,
    u.membership_expiry,
    u.created_at
   FROM users u
   WHERE
    u.email LIKE ?
    OR u.name LIKE ?
    OR CAST(u.id AS TEXT)=?
   ORDER BY u.id DESC
   LIMIT 500
  `).bind(
   `%${q}%`,
   `%${q}%`,
