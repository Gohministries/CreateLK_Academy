async function settings(r,e){
 try{await auth(r,e)}
 catch(x){return err(x.message,401)}

 if(r.method==="GET"){
  const x=await e.DB.prepare(`
   SELECT value FROM settings
   WHERE key='commission_rate'
  `).first();

  return json({
   success:true,
   commission_rate:+(x?.value||COM)
  });
 }

 const b=await body(r);
 const v=Number(b?.commission_rate);

 if(!Number.isFinite(v)||v<0||v>100)
  return err("Invalid commission");

 await e.DB.prepare(`
  INSERT INTO settings VALUES('commission_rate',?)
  ON CONFLICT(key) DO UPDATE SET value=excluded.value
 `).bind(String(v)).run();

 return json({success:true,commission_rate:v});
}

async function payment(r,e){
 try{await auth(r,e)}
 catch(x){return err(x.message,401)}

 const b=await body(r);
 const uid=+b?.user_id;
 const email=clean(b?.email).toLowerCase();
 const amount=+b?.amount||0;

 if(!uid&&!email)return err("User required");

 const x=await e.DB.prepare(`
  INSERT INTO payments(
   user_id,email,name,amount,method,
   reference,status,created_at
  ) VALUES(?,?,?,?,?,?,?,?)
 `).bind(
  uid,
  email,
  clean(b.name),
  amount,
  clean(b.method)||"MANUAL",
  clean(b.reference),
  "PENDING",
  now()
 ).run();

 return json({
  success:true,
  payment_id:x.meta.last_row_id,
  status:"PENDING"
 });
}

async function activate(r,e){
 try{
  const a=await auth(r,e),b=await body(r);
  const pid=+b?.payment_id||0;
  const email=clean(b?.email).toLowerCase();
  const days=Math.max(1,+b?.days||DAYS);
  const inputAmount=+b?.amount||0;

  let p=pid
   ?await e.DB.prepare(`SELECT * FROM payments WHERE id=?`)
    .bind(pid).first()
   :null;

  if(pid&&!p)return err("Payment not found",404);
  if(p?.status==="APPROVED")return err("Payment already approved");

  let uid=+(p?.user_id||b?.user_id||0);

  let u=uid
   ?await e.DB.prepare(`SELECT * FROM users WHERE id=?`)
    .bind(uid).first()
   :null;

  if(!u&&email){
   u=await e.DB.prepare(`
    SELECT * FROM users WHERE lower(email)=?
   `).bind(email).first();

   if(u)uid=+u.id;
  }

  if(!u)return err("User not found",404);

  const amount=inputAmount||+(p?.amount||0);
  const t=now();

  const start=
   u.membership_expiry&&
   new Date(u.membership_expiry)>new Date()
   ?new Date(u.membership_expiry)
   :new Date();

  const expiry=new Date(
   start.getTime()+days*86400000
  ).toISOString();

  await e.DB.prepare(`
   UPDATE users
   SET membership_status='PREMIUM',
       membership_expiry=?
   WHERE id=?
  `).bind(expiry,uid).run();

  await e.DB.prepare(`
   INSERT INTO premium_users
   VALUES(?,?,?,?,?,?)
   ON CONFLICT(user_id) DO UPDATE SET
    email=excluded.email,
    name=excluded.name,
    status='PREMIUM',
    membership_expiry=excluded.membership_expiry,
    updated_at=excluded.updated_at
  `).bind(
   uid,u.email,u.name,"PREMIUM",expiry,t
  ).run();

  let id=pid;

  if(!id){
   const x=await e.DB.prepare(`
    INSERT INTO payments(
     user_id,email,name,amount,method,
     reference,status,created_at,
     approved_at,approved_by
    ) VALUES(?,?,?,?,?,?,?,?,?,?)
   `).bind(
    uid,u.email,u.name,amount,
    clean(b.method)||"MANUAL",
    clean(b.reference),
    "APPROVED",t,t,a.email
   ).run();

   id=x.meta.last_row_id;
  }else{
   await e.DB.prepare(`
    UPDATE payments
    SET status='APPROVED',
        approved_at=?,
        approved_by=?,
        amount=?
    WHERE id=?
   `).bind(t,a.email,amount,id).run();
  }

  const l=await e.DB.prepare(`
   SELECT referrer_id,referral_code
   FROM referral_links
   WHERE referred_user_id=?
   LIMIT 1
  `).bind(uid).first();

  let rid=+(l?.referrer_id||0);
  let code=clean(l?.referral_code).toUpperCase();

  if(!rid){
   const m=clean(b.referral_code)
    .toUpperCase()
    .match(/^ENG(\d+)$/);

   if(m){
    rid=+m[1];
    code=clean(b.referral_code).toUpperCase();
   }
  }

  let ref=null;

  if(rid&&rid!==uid&&amount>0){
   const old=await e.DB.prepare(`
    SELECT id FROM referrals
    WHERE payment_id=?
   `).bind(id).first();

   const rr=await e.DB.prepare(`
    SELECT id,email FROM users WHERE id=?
   `).bind(rid).first();

   if(!old&&rr){
    const s=await e.DB.prepare(`
     SELECT value FROM settings
     WHERE key='commission_rate'
    `).first();

    const rate=+(s?.value||COM);
    const commission=Math.round(amount*rate)/100;

    const x=await e.DB.prepare(`
     INSERT INTO referrals(
      payment_id,referrer_id,referred_user_id,
      referral_code,commission_rate,
      commission_amount,status,created_at
     ) VALUES(?,?,?,?,?,?,?,?)
    `).bind(
     id,rid,uid,code||`ENG${rid}`,
     rate,commission,"APPROVED",t
    ).run();

    ref={
     id:x.meta.last_row_id,
     referrer_id:rid,
     referrer_email:rr.email,
     commission_rate:rate,
     commission_amount:commission
    };
   }
  }

  return json({
   success:true,
   payment_id:id,
   user_id:uid,
   email:u.email,
   status:"PREMIUM",
   membership_expiry:expiry,
   referral_status:ref?"REFERRED":"DIRECT",
   referral:ref
  });

 }catch(x){
  return err(x.message||"Activation failed",500);
 }
}

async function logout(r,e){
 const s=cookies(r)[SES];

 if(s)
  await e.DB.prepare(`
   DELETE FROM admin_sessions
   WHERE token_hash=?
  `).bind(await hash(s)).run();

 return new Response(null,{
  status:302,
  headers:{
   Location:`${SITE}/Eng/admin.html`,
   "Set-Cookie":`${SES}=;Path=/;HttpOnly;Secure;SameSite=None;Max-Age=0`
  }
 });
}