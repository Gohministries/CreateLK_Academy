/* =========================
   CREATE PAYMENT
========================= */

async function createPayment(req,env){

 const b=
  await req.json();

 const userId=
  Number(b.user_id);

 const email=
  String(b.email||"");

 const name=
  String(b.name||"");

 const amount=
  Number(b.amount||1000);

 const days=
  Number(b.duration_days||30);

 if(
  !userId||
  !email||
  amount<=0||
  days<=0
 ){

  return json({
   success:false,
   error:"Invalid payment"
  },400);
 }


 const order=
  `CL${Date.now()}${Math.floor(Math.random()*1000)}`;


 await env.DB.prepare(`
  INSERT INTO payments
  (
   user_id,
   order_id,
   amount,
   currency,
   status,
   duration_days,
   email,
   name,
   created_at
  )
  VALUES(
   ?,?,?,?,?,?,?,?,CURRENT_TIMESTAMP
  )
 `)
 .bind(
  userId,
  order,
  amount,
  "LKR",
  "PENDING",
  days,
  email,
  name
 )
 .run();


 return json({
  success:true,
  order_id:order,
  amount,
  duration_days:days
 });
}


