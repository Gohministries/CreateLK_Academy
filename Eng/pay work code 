/* =========================
   ADMIN AUTH
========================= */

async function admin(req,env){

 const c=
  req.headers.get("Cookie")||"";

 const m=c.match(
  new RegExp(`${COOKIE}=([^;]+)`)
 );

 if(!m)
  return false;

 const token=m[1];

 const row=await env.DB.prepare(`
  SELECT token_hash
  FROM admin_sessions
  WHERE token_hash=?
  AND expires_at>?
 `)
 .bind(
  await hash(token),
  new Date().toISOString()
 )
 .first();

 return !!row;
}


