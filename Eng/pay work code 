const SITE="https://createlk.com",ADMIN="gateofheavensl1@gmail.com";
const SES="premium_admin_session",STATE="premium_admin_state";
const DAYS=30,COM=10;
const GA="https://accounts.google.com/o/oauth2/v2/auth";
const GT="https://oauth2.googleapis.com/token";
const GU="https://openidconnect.googleapis.com/v1/userinfo";

export default{async fetch(r,e){
 try{
  await db(e);
  if(r.method==="OPTIONS")return cors(new Response(null,{status:204}));
  const p=new URL(r.url).pathname;
  const f={
   "/api/health":health,"/internal/check":check,
   "/auth/google":login,"/auth/callback":callback,
   "/auth/logout":logout,"/api/admin/me":me,
   "/api/admin/stats":stats,"/api/admin/users":users,
   "/api/admin/payments":payments,
   "/api/admin/referrals":referrals,
   "/api/admin/referral/find":find,
   "/api/admin/referral":save,
   "/api/admin/activate":activate,
   "/api/admin/payment":payment,
   "/api/admin/settings":settings
  };
  return f[p]?f[p](r,e):err("Not found",404);
 }catch(x){return err(x.message||"Server error",500)}
}};

async function db(e){
 await e.DB.batch([
  e.DB.prepare(`CREATE TABLE IF NOT EXISTS premium_users(user_id INTEGER PRIMARY KEY,email TEXT,name TEXT,status TEXT DEFAULT 'FREE',membership_expiry TEXT,updated_at TEXT)`),
  e.DB.prepare(`CREATE TABLE IF NOT EXISTS payments(id INTEGER PRIMARY KEY AUTOINCREMENT,user_id INTEGER,email TEXT,name TEXT,amount REAL DEFAULT 0,method TEXT,reference TEXT,status TEXT DEFAULT 'PENDING',created_at TEXT,approved_at TEXT,approved_by TEXT)`),
  e.DB.prepare(`CREATE TABLE IF NOT EXISTS referrals(id INTEGER PRIMARY KEY AUTOINCREMENT,payment_id INTEGER,referrer_id INTEGER,referred_user_id INTEGER,referral_code TEXT,commission_rate REAL DEFAULT 10,commission_amount REAL DEFAULT 0,status TEXT DEFAULT 'PENDING',created_at TEXT,paid_at TEXT)`),
  e.DB.prepare(`CREATE TABLE IF NOT EXISTS settings(key TEXT PRIMARY KEY,value TEXT)`),
  e.DB.prepare(`CREATE TABLE IF NOT EXISTS admin_sessions(token_hash TEXT PRIMARY KEY,email TEXT,expires_at TEXT)`),
  e.DB.prepare(`CREATE TABLE IF NOT EXISTS oauth_states(state TEXT PRIMARY KEY,expires_at INTEGER)`),
  e.DB.prepare(`INSERT OR IGNORE INTO settings VALUES('commission_rate',?)`).bind(String(COM))
 ]);
}

const clean=x=>String(x||"").trim();
const now=()=>new Date().toISOString();

async function json(x,s=200){
 return cors(new Response(JSON.stringify(x),{
  status:s,
  headers:{"Content-Type":"application/json"}
 }));
}

const err=(x,s=400)=>json({success:false,error:x},s);

const body=async r=>{
 try{return await r.json()}catch{return null}
};

function cors(r){
 r.headers.set("Access-Control-Allow-Origin",SITE);
 r.headers.set("Access-Control-Allow-Credentials","true");
 r.headers.set("Access-Control-Allow-Headers","Content-Type,Authorization");
 r.headers.set("Access-Control-Allow-Methods","GET,POST,OPTIONS");
 return r;
}

function token(n=32){
 const a=new Uint8Array(n);
 crypto.getRandomValues(a);
 return [...a].map(x=>x.toString(16).padStart(2,"0")).join("");
}

async function hash(x){
 const h=await crypto.subtle.digest(
  "SHA-256",
  new TextEncoder().encode(x)
 );
 return [...new Uint8Array(h)]
  .map(x=>x.toString(16).padStart(2,"0"))
  .join("");
}

function cookies(r){
 const o={},h=r.headers.get("Cookie")||"";
 h.split(";").forEach(x=>{
  const i=x.indexOf("=");
  if(i>0)o[x.slice(0,i).trim()]=decodeURIComponent(x.slice(i+1).trim());
 });
 return o;
}

async function admin(r,e){
 const s=cookies(r)[SES];
 if(!s)return null;
 return e.DB.prepare(`
  SELECT email FROM admin_sessions
  WHERE token_hash=? AND expires_at>?
 `).bind(await hash(s),now()).first();
}

async function auth(r,e){
 const a=await admin(r,e);
 if(!a)throw Error("Admin login required");
 return a;
}

async function health(){
 return json({success:true,message:"Premium API is running"});
}

async function check(r,e){
 if(r.method!=="POST")return err("POST required",405);
 if(r.headers.get("Authorization")!==`Bearer ${e.INTERNAL_SECRET}`)
  return err("Unauthorized",401);

 const b=await body(r),id=Number(b?.user_id);
 if(!id)return err("Invalid user_id");

 const u=await e.DB.prepare(`
  SELECT membership_status,membership_expiry
  FROM users WHERE id=? LIMIT 1
 `).bind(id).first();

 const p=await e.DB.prepare(`
  SELECT status,membership_expiry
  FROM premium_users WHERE user_id=? LIMIT 1
 `).bind(id).first();

 let expiry=null;

 if(String(u?.membership_status||"").toUpperCase()==="PREMIUM")
  expiry=u?.membership_expiry||null;

 if(String(p?.status||"").toUpperCase()==="PREMIUM"&&p?.membership_expiry){
  if(!expiry||new Date(p.membership_expiry)>new Date(expiry))
   expiry=p.membership_expiry;
 }

 const active=!!expiry&&new Date(expiry)>new Date();

 return json({
  success:true,
  premium:active,
  membership_expiry:active?expiry:null
 });
}

async function login(r,e){
 const s=token();

 await e.DB.prepare(`
  INSERT INTO oauth_states VALUES(?,?)
 `).bind(s,Date.now()+600000).run();

 const q=new URLSearchParams({
  client_id:e.GOOGLE_CLIENT_ID,
  redirect_uri:"https://pay.createlk.workers.dev/auth/callback",
  response_type:"code",
  scope:"openid email profile",
  state:s
 });

 return new Response(null,{status:302,headers:{
  Location:`${GA}?${q}`,
  "Set-Cookie":`${STATE}=${s};Path=/;HttpOnly;Secure;SameSite=None;Max-Age=600`
 }});
}

async function callback(r,e){
 const u=new URL(r.url);
 const code=u.searchParams.get("code");
 const state=u.searchParams.get("state");

 if(!code||!state)
  return new Response("Invalid login",{status:400});

 const st=await e.DB.prepare(`
  SELECT state FROM oauth_states
  WHERE state=? AND expires_at>?
 `).bind(state,Date.now()).first();

 if(!st)
  return new Response("Login expired",{status:400});

 await e.DB.prepare(`
  DELETE FROM oauth_states WHERE state=?
 `).bind(state).run();

 const t=await fetch(GT,{
  method:"POST",
  headers:{"Content-Type":"application/x-www-form-urlencoded"},
  body:new URLSearchParams({
   client_id:e.GOOGLE_CLIENT_ID,
   client_secret:e.GOOGLE_CLIENT_SECRET,
   code,
   grant_type:"authorization_code",
   redirect_uri:"https://pay.createlk.workers.dev/auth/callback"
  })
 }).then(x=>x.json());

 if(!t.access_token)
  return new Response("Google authentication failed",{status:400});

 const g=await fetch(GU,{
  headers:{Authorization:`Bearer ${t.access_token}`}
 }).then(x=>x.json());

 const email=clean(g.email).toLowerCase();

 if(email!==ADMIN.toLowerCase())
  return new Response("Admin access denied",{status:403});

 const s=token(48);

 await e.DB.prepare(`
  INSERT INTO admin_sessions VALUES(?,?,?)
 `).bind(
  await hash(s),
  email,
  new Date(Date.now()+604800000).toISOString()
 ).run();

 return new Response(null,{status:302,headers:{
  Location:`${SITE}/Eng/admin.html`,
  "Set-Cookie":`${SES}=${s};Path=/;HttpOnly;Secure;SameSite=None;Max-Age=604800`
 }});
}

