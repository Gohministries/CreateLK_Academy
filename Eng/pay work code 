const SITE="https://createlk.com";
const ENGLISH="https://createlk.com/Eng/";
const ADMIN_EMAIL="gateofheavensl1@gmail.com";
const SESSION="premium_admin_session";
const STATE="premium_admin_state";
const SESSION_DAYS=7;
const DEFAULT_DAYS=30;
const DEFAULT_COMMISSION=10;
const GA="https://accounts.google.com/o/oauth2/v2/auth";
const GT="https://oauth2.googleapis.com/token";
const GU="https://openidconnect.googleapis.com/v1/userinfo";

export default{async fetch(r,e){
 try{
  await schema(e);
  const p=new URL(r.url).pathname;

  if(r.method==="OPTIONS")return cors(new Response(null,{status:204}));

  const f={
   "/api/health":health,
   "/internal/check":internalCheck,
   "/auth/google":googleLogin,
   "/auth/callback":googleCallback,
   "/auth/logout":logout,
   "/api/admin/me":adminMe,
   "/api/admin/stats":stats,
   "/api/admin/users":users,
   "/api/admin/payments":payments,
   "/api/admin/referrals":referrals,
   "/api/admin/activate":activate,
   "/api/admin/payment":addPayment,
   "/api/admin/settings":settings
  };

  if(f[p])return f[p](r,e);
  return err("Not found",404);
 }catch(x){
  console.error(x);
  return err("Server error",500,{detail:String(x?.message||x)});
 }
}};

async function schema(e){
 await e.DB.batch([
  e.DB.prepare(`CREATE TABLE IF NOT EXISTS premium_users(
   user_id INTEGER PRIMARY KEY,
   email TEXT,
   name TEXT,
   status TEXT DEFAULT 'FREE',
   membership_expiry TEXT,
   updated_at TEXT
  )`),
  e.DB.prepare(`CREATE TABLE IF NOT EXISTS payments(
   id INTEGER PRIMARY KEY AUTOINCREMENT,
   user_id INTEGER NOT NULL,
   email TEXT,
   name TEXT,
   amount REAL DEFAULT 0,
   method TEXT,
   reference TEXT,
   proof TEXT,
   status TEXT DEFAULT 'PENDING',
   created_at TEXT,
   approved_at TEXT,
   approved_by TEXT
  )`),
  e.DB.prepare(`CREATE TABLE IF NOT EXISTS referrals(
   id INTEGER PRIMARY KEY AUTOINCREMENT,
   payment_id INTEGER,
   referrer_id INTEGER,
   referred_user_id INTEGER,
   referral_code TEXT,
   commission_rate REAL DEFAULT 10,
   commission_amount REAL DEFAULT 0,
   status TEXT DEFAULT 'PENDING',
   created_at TEXT,
   paid_at TEXT
  )`),
  e.DB.prepare(`CREATE TABLE IF NOT EXISTS settings(
   key TEXT PRIMARY KEY,
   value TEXT
  )`),
  e.DB.prepare(`CREATE TABLE IF NOT EXISTS admin_sessions(
   token_hash TEXT PRIMARY KEY,
   email TEXT,
   expires_at TEXT
  )`),
  e.DB.prepare(`CREATE TABLE IF NOT EXISTS oauth_states(
   state TEXT PRIMARY KEY,
   expires_at INTEGER
  )`),
  e.DB.prepare(`INSERT OR IGNORE INTO settings(key,value) VALUES('commission_rate',?)`).bind(String(DEFAULT_COMMISSION))
 ]);
}

async function health(r,e){
 return json({
  success:true,
  message:"Premium API is running",
  version:"PREMIUM-2026-10-03-01"
 });
}

async function internalCheck(r,e){
 if(r.method!=="POST")return err("POST required",405);

 const auth=r.headers.get("Authorization")||"";
 if(auth!==`Bearer ${e.INTERNAL_SECRET}`)return err("Unauthorized",401);

 const b=await body(r);
 const id=Number(b?.user_id);
 if(!id)return err("Invalid user_id",400);

 const u=await e.DB.prepare(
  "SELECT status,membership_expiry FROM premium_users WHERE user_id=? LIMIT 1"
 ).bind(id).first();

 const expiry=u?.membership_expiry||null;
 const active=u?.status==="PREMIUM"&&expiry&&new Date(expiry)>new Date();

 return json({
  success:true,
  premium:!!active,
  membership_expiry:active?expiry:null
 });
}

async function googleLogin(r,e){
 const state=token(32);

 await e.DB.prepare(
  "INSERT INTO oauth_states(state,expires_at) VALUES(?,?)"
 ).bind(state,Date.now()+600000).run();

 const q=new URLSearchParams({
  client_id:e.GOOGLE_CLIENT_ID,
  redirect_uri:`https://pay.createlk.workers.dev/auth/callback`,
  response_type:"code",
  scope:"openid email profile",
  state,
  prompt:"select_account"
 });

 return new Response(null,{
  status:302,
  headers:{
   Location:`${GA}?${q}`,
   "Set-Cookie":`${STATE}=${state};Path=/;HttpOnly;Secure;SameSite=None;Max-Age=600`
  }
 });
}

async function googleCallback(r,e){
 const url=new URL(r.url);
 const code=url.searchParams.get("code");
 const state=url.searchParams.get("state");

 if(!code||!state)return new Response("Invalid login.",{status:400});

 const valid=await e.DB.prepare(
  "SELECT state FROM oauth_states WHERE state=? AND expires_at>?"
 ).bind(state,Date.now()).first();

 if(!valid)return new Response("Login expired.",{status:400});

 await e.DB.prepare("DELETE FROM oauth_states WHERE state=?").bind(state).run();

 const tr=await fetch(GT,{
  method:"POST",
  headers:{"Content-Type":"application/x-www-form-urlencoded"},
  body:new URLSearchParams({
   client_id:e.GOOGLE_CLIENT_ID,
   client_secret:e.GOOGLE_CLIENT_SECRET,
   code,
   grant_type:"authorization_code",
   redirect_uri:`https://pay.createlk.workers.dev/auth/callback`
  })
 });

 const td=await tr.json();
 if(!td.access_token)return new Response("Google authentication failed.",{status:400});

 const gr=await fetch(GU,{
  headers:{Authorization:`Bearer ${td.access_token}`}
 });

 const g=await gr.json();
 const email=clean(g.email).toLowerCase();

 if(email!==ADMIN_EMAIL.toLowerCase()){
  return new Response("Admin access denied.",{status:403});
 }

 const session=token(48);

 await e.DB.prepare(
  "INSERT INTO admin_sessions(token_hash,email,expires_at) VALUES(?,?,?)"
 ).bind(
  await sha256(session),
  email,
  new Date(Date.now()+SESSION_DAYS*86400000).toISOString()
 ).run();

 return new Response(null,{
  status:302,
  headers:{
   Location:`${SITE}/Eng/admin.html`,
   "Set-Cookie":`${SESSION}=${session};Path=/;HttpOnly;Secure;SameSite=None;Max-Age=${SESSION_DAYS*86400}`
  }
 });
}

async function adminUser(r,e){
 const s=cookies(r)[SESSION];
 if(!s)return null;

 return e.DB.prepare(
  "SELECT email FROM admin_sessions WHERE token_hash=? AND expires_at>? LIMIT 1"
 ).bind(
  await sha256(s),
  new Date().toISOString()
 ).first();
}

async function adminMe(r,e){
 const a=await adminUser(r,e);

 if(!a)return json({
  success:true,
  logged_in:false,
  admin:false
 });

 return json({
  success:true,
  logged_in:true,
  admin:true,
  email:a.email
 });
}

async function requireAdmin(r,e){
 const a=await adminUser(r,e);
 if(!a)throw Object.assign(Error("Admin login required"),{status:401});
 return a;
}

async function stats(r,e){
 try{await requireAdmin(r,e)}catch(x){return err(x.message,x.status||401)}

 const u=await e.DB.prepare(
  "SELECT COUNT(*) count FROM premium_users"
 ).first();

 const premium=await e.DB.prepare(
  "SELECT COUNT(*) count FROM premium_users WHERE status='PREMIUM' AND membership_expiry>?"
 ).bind(new Date().toISOString()).first();

 const pay=await e.DB.prepare(
  "SELECT COUNT(*) count,COALESCE(SUM(amount),0) total FROM payments WHERE status='APPROVED'"
 ).first();

 const ref=await e.DB.prepare(
  "SELECT COUNT(*) count,COALESCE(SUM(commission_amount),0) total FROM referrals WHERE status='APPROVED'"
 ).first();

 return json({
  success:true,
  users:Number(u?.count||0),
  premium:Number(premium?.count||0),
  free:Math.max(0,Number(u?.count||0)-Number(premium?.count||0)),
  payments:Number(pay?.count||0),
  payment_total:Number(pay?.total||0),
  referrals:Number(ref?.count||0),
  referral_commission:Number(ref?.total||0)
 });
}

async function users(r,e){
 try{await requireAdmin(r,e)}catch(x){return err(x.message,x.status||401)}

 const q=new URL(r.url).searchParams.get("q")||"";
 let x;

 if(q){
  x=await e.DB.prepare(`
   SELECT * FROM premium_users
   WHERE email LIKE ? OR name LIKE ? OR CAST(user_id AS TEXT)=?
   ORDER BY user_id DESC LIMIT 500
  `).bind(`%${q}%`,`%${q}%`,q).all();
 }else{
  x=await e.DB.prepare(
   "SELECT * FROM premium_users ORDER BY user_id DESC LIMIT 500"
  ).all();
 }

 return json({
  success:true,
  users:(x.results||[]).map(v=>({
   user_id:Number(v.user_id),
   email:v.email||"",
   name:v.name||"",
   status:v.status||"FREE",
   membership_expiry:v.membership_expiry||null,
   updated_at:v.updated_at||null
  }))
 });
}

