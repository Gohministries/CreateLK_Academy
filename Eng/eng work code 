/* CHECK ANSWER */

async function checkAnswer(
request,
env
){

if(request.method!=="POST")
return json({
success:false,
error:"POST required"
},405);

const user=
await currentUser(
request,
env
);

if(!user)
return json({
success:false,
error:"Login required"
},401);

let body;

try{

body=
await request.json();

}catch{

return json({
success:false,
error:"Invalid JSON"
},400);

}

const questionId=
Number(body.question_id);

const answer=
String(
body.answer||""
)
.trim()
.toLowerCase();

if(
!questionId||
!["a","b","c","d"].includes(answer)
)
return json({
success:false,
error:"Invalid answer"
},400);

const question=
await env.DB.prepare(`
SELECT
id,
lesson_id,
correct_answer,
option_a,
option_b,
option_c,
option_d
FROM questions
WHERE id=?
AND active=1
LIMIT 1
`)
.bind(questionId)
.first();

if(!question)
return json({
success:false,
error:"Question not found"
},404);

const lesson=
await env.DB.prepare(`
SELECT
id,
access_type
FROM lessons
WHERE id=?
AND active=1
LIMIT 1
`)
.bind(question.lesson_id)
.first();

if(!lesson)
return json({
success:false,
error:"Lesson not found"
},404);

const isPremium=
await premium(
env,
user.id
);

const isFree=
Number(question.lesson_id)===1||
String(
lesson.access_type||""
)
.toUpperCase()==="FREE";

if(
!isFree&&!isPremium
)
return json({
success:false,
error:"Premium required",
premium_required:true
},403);

const correctAnswer=
String(
question.correct_answer
)
.trim()
.toLowerCase();

const correct=
answer===correctAnswer;

if(correct){

return json({
success:true,
correct:true
});

}

const options={
a:question.option_a,
b:question.option_b,
c:question.option_c,
d:question.option_d
};

return json({
success:true,
correct:false,
correct_answer:
correctAnswer,
correct_text:
options[correctAnswer]||""
});
}


/* MONTH */

function monthRange(){

const now=
new Date();

const start=
new Date(
Date.UTC(
now.getUTCFullYear(),
now.getUTCMonth(),
1
)
).toISOString();

const end=
new Date(
Date.UTC(
now.getUTCFullYear(),
now.getUTCMonth()+1,
1
)
).toISOString();

return{
start,
end
};
}


