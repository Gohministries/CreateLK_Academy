/* ADD REWARDS */

async function addRewards(
env,
userId,
coins,
xp
){

const now=
new Date().toISOString();

await env.DB.prepare(`
INSERT OR IGNORE INTO user_rewards
(
user_id,
coins,
xp,
updated_at
)
VALUES
(?,?,?,?)
`)
.bind(
userId,
0,
0,
now
)
.run();

await env.DB.prepare(`
UPDATE user_rewards
SET
coins=COALESCE(coins,0)+?,
xp=COALESCE(xp,0)+?,
updated_at=?
WHERE user_id=?
`)
.bind(
Number(coins)||0,
Number(xp)||0,
now,
userId
)
.run();

return getRewards(
env,
userId
);
}


