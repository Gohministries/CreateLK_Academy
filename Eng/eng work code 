/* =========================
   USER
========================= */

async function currentUser(request, env) {
  const cookies =
    getCookies(
      request.headers.get("Cookie")
    );

  if (!cookies[SESSION]) {
    return null;
  }

  const hash =
    await sha256(cookies[SESSION]);

  const now =
    Math.floor(Date.now() / 1000);

  return await env.DB
    .prepare(`
      SELECT u.*
      FROM sessions s
      JOIN users u
        ON u.id = s.user_id
      WHERE s.token_hash = ?
        AND s.expires_at > ?
      LIMIT 1
    `)
    .bind(hash, now)
    .first();
}


/* =========================
   PREMIUM
========================= */

async function premium(env, userId) {
  const row =
    await env.DB
      .prepare(`
        SELECT status, expires_at
        FROM subscriptions
        WHERE user_id = ?
        ORDER BY id DESC
        LIMIT 1
      `)
      .bind(userId)
      .first();

  if (!row || row.status !== "active") {
    return false;
  }

  if (
    row.expires_at === null ||
    row.expires_at === undefined
  ) {
    return true;
  }

  return Number(row.expires_at) >
    Math.floor(Date.now() / 1000);
}


/* =========================
   REFERRAL CREATE
========================= */

async function createReferral(
  env,
  newUserId,
  code,
  ownCode,
  now
) {
  if (!code || code === ownCode) {
    return;
  }

  const owner =
    await env.DB
      .prepare(`
        SELECT id
        FROM users
        WHERE referral_code = ?
        LIMIT 1
      `)
      .bind(code)
      .first();

  if (!owner || owner.id === newUserId) {
    return;
  }

  await env.DB
    .prepare(`
      INSERT OR IGNORE INTO referrals
      (
        id,
        referrer_user_id,
        referred_user_id,
        code,
        created_at
      )
      VALUES (?, ?, ?, ?, ?)
    `)
    .bind(
      token(16),
      owner.id,
      newUserId,
      code,
      now
    )
    .run();

  await env.DB
    .prepare(`
      UPDATE users
      SET referred_by = ?
      WHERE id = ?
    `)
    .bind(
      owner.id,
      newUserId
    )
    .run();
}


/* =========================
   UNIQUE REFERRAL
========================= */

async function uniqueReferralCode(env) {
  for (let i = 0; i < 10; i++) {
    const code =
      randomReferralCode();

    const exists =
      await env.DB
        .prepare(`
          SELECT id
          FROM users
          WHERE referral_code = ?
          LIMIT 1
        `)
        .bind(code)
        .first();

    if (!exists) {
      return code;
    }
  }

  throw new Error(
    "Unable to create referral code."
  );
}


/* =========================
   RANDOM TOKEN
========================= */

function token(bytes = 32) {
  const data =
    new Uint8Array(bytes);

  crypto.getRandomValues(data);

  return [...data]
    .map(x =>
      x.toString(16).padStart(2, "0")
    )
    .join("");
}


/* =========================
   REFERRAL CODE
========================= */

function randomReferralCode() {
  const chars =
    "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";

  const data =
    new Uint8Array(8);

  crypto.getRandomValues(data);

  return [...data]
    .map(x =>
      chars[x % chars.length]
    )
    .join("");
}


/* =========================
   SHA256
========================= */

async function sha256(value) {
  const data =
    new TextEncoder().encode(value);

  const hash =
    await crypto.subtle.digest(
      "SHA-256",
      data
    );

  return [...new Uint8Array(hash)]
    .map(x =>
      x.toString(16).padStart(2, "0")
    )
    .join("");
}


/* =========================
   COOKIES
========================= */

function getCookies(header) {
  const result = {};

  if (!header) {
    return result;
  }

  for (const item of header.split(";")) {
    const i = item.indexOf("=");

    if (i < 0) continue;

    const key =
      item.slice(0, i).trim();

    const value =
      item.slice(i + 1).trim();

    try {
      result[key] =
        decodeURIComponent(value);
    } catch {
      result[key] = value;
    }
  }

  return result;
}


function makeCookie(
  name,
  value,
  maxAge
) {
  return [
    `${name}=${encodeURIComponent(value)}`,
    `Max-Age=${maxAge}`,
    "Path=/",
    "HttpOnly",
    "Secure",
    "SameSite=Lax"
  ].join("; ");
}


function deleteCookie(name) {
  return [
    `${name}=`,
    "Max-Age=0",
    "Path=/",
    "HttpOnly",
    "Secure",
    "SameSite=Lax"
  ].join("; ");
}


/* =========================
   CLEAN
========================= */

function clean(value, max) {
  return value
    ? String(value)
        .trim()
        .slice(0, max)
    : "";
}


/* =========================
   JSON
========================= */

function json(data, status, request) {
  return new Response(
    JSON.stringify(data),
    {
      status,
      headers: {
        "Content-Type":
          "application/json; charset=UTF-8",
        "Cache-Control":
          "no-store",
        ...cors(request)
      }
    }
  );
}


/* =========================
   CORS
========================= */

function cors(request) {
  const origin =
    request.headers.get("Origin");

  return {
    "Access-Control-Allow-Origin":
      origin === SITE ? SITE : SITE,

    "Access-Control-Allow-Credentials":
      "true",

    "Access-Control-Allow-Methods":
      "GET, POST, OPTIONS",

    "Access-Control-Allow-Headers":
      "Content-Type, Authorization"
  };
}