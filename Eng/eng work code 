async function check(r,e){
 const u=await user(r,e);
 if(!u)return json({
  success:false,error:"Login required"
 },r,401);

 const b=await r.json().catch(()=>({}));
 const aid=String(b.attempt_id||"");
 const qid=Number(b.question_id);
 const ans=Number(b.answer);

 const a=await e.DB.prepare(`
  SELECT * FROM quiz_attempts
  WHERE id=? AND user_id=? AND completed_at IS NULL
 `).bind(aid,u.id).first();

 if(!a)return json({
  success:false,error:"Invalid quiz attempt"
 },r,404);

 const q=await e.DB.prepare(`
  SELECT * FROM questions
  WHERE id=? AND lesson_id=? AND active=1
 `).bind(qid,a.lesson_id).first();

 if(!q)return json({
  success:false,error:"Question not found"
 },r,404);

 const old=await e.DB.prepare(`
  SELECT * FROM quiz_question_rewards
  WHERE attempt_id=? AND question_id=?
 `).bind(aid,qid).first();

 if(old)return json({
  success:true,
  already_answered:true,
  correct:Number(old.xp)>0,
  coins:Number(old.coins),
  xp:Number(old.xp)
 },r);

 const correct=ans===Number(q.correct_answer);
 const coins=correct?COINS:0;
 const xp=correct?XP:0;

 await e.DB.prepare(`
  INSERT INTO quiz_question_rewards
  (attempt_id,user_id,question_id,coins,xp,created_at)
  VALUES (?,?,?,?,?,?)
 `).bind(
  aid,u.id,qid,coins,xp,new Date().toISOString()
 ).run();

 await addRewards(e,u.id,coins,xp);

 return json({
  success:true,
  correct,
  coins,
  xp
 },r);
}

async function submit(r,e){
 const u=await user(r,e);
 if(!u)return json({
  success:false,error:"Login required"
 },r,401);

 const b=await r.json().catch(()=>({}));
 const aid=String(b.attempt_id||"");

 const a=await e.DB.prepare(`
  SELECT * FROM quiz_attempts
  WHERE id=? AND user_id=?
 `).bind(aid,u.id).first();

 if(!a)return json({
  success:false,error:"Quiz attempt not found"
 },r,404);

 const x=await e.DB.prepare(`
  SELECT
   COUNT(*) total,
   COALESCE(SUM(CASE WHEN xp>0 THEN 1 ELSE 0 END),0) score,
   COALESCE(SUM(coins),0) coins,
   COALESCE(SUM(xp),0) xp
  FROM quiz_question_rewards
  WHERE attempt_id=?
 `).bind(aid).first();

 const total=Number(x.total||0);
 const score=Number(x.score||0);
 const percentage=total?Math.round(score*100/total):0;
 const now=new Date().toISOString();

 await e.DB.prepare(`
  UPDATE quiz_attempts
  SET completed_at=?
  WHERE id=? AND user_id=?
 `).bind(now,aid,u.id).run();

 await e.DB.prepare(`
  INSERT INTO quiz_results
  (user_id,lesson_id,score,total,percentage,completed_at)
  VALUES (?,?,?,?,?,?)
 `).bind(
  u.id,a.lesson_id,score,total,percentage,now
 ).run();

 await scoreUpdate(e,u.id,score);

 return json({
  success:true,
  score,
  total,
  percentage,
  coins:Number(x.coins||0),
  xp:Number(x.xp||0)
 },r);
}


/* REWARDS */

async function rewards(e,id){
 let x=await e.DB.prepare(
  "SELECT coins,xp FROM user_rewards WHERE user_id=?"
 ).bind(id).first();

 if(!x){
  await e.DB.prepare(`
   INSERT INTO user_rewards(user_id,coins,xp,updated_at)
   VALUES (?,0,0,?)
  `).bind(id,new Date().toISOString()).run();

  return{coins:0,xp:0};
 }

 return{
  coins:Number(x.coins||0),
  xp:Number(x.xp||0)
 };
}

async function addRewards(e,id,coins,xp){
 await e.DB.prepare(`
  INSERT INTO user_rewards(user_id,coins,xp,updated_at)
  VALUES (?,?,?,?)
  ON CONFLICT(user_id)
  DO UPDATE SET
   coins=user_rewards.coins+excluded.coins,
   xp=user_rewards.xp+excluded.xp,
   updated_at=excluded.updated_at
 `).bind(
  id,coins,xp,new Date().toISOString()
 ).run();
}


/* PREMIUM */

async function premium(e,id){
 try{
  if(!e.PAY)return{premium:false,expiry:null};

  const r=await e.PAY.fetch(
   new Request(PAY_URL,{
    method:"POST",
    headers:{
     "Content-Type":"application/json",
     "Authorization":`Bearer ${e.INTERNAL_SECRET}`
    },
    body:JSON.stringify({user_id:Number(id)})
   })
  );

  const d=await r.json();
  const expiry=d.membership_expiry||null;

  const active=
   r.ok &&
   d.premium===true &&
   expiry &&
   new Date(expiry).getTime()>Date.now();

  return{
   premium:!!active,
   expiry:active?expiry:null
  };
 }catch(x){
  console.error(x);
  return{premium:false,expiry:null};
 }
}


/* LEADERBOARD */

async function leaderboard(r,e){
 const x=await e.DB.prepare(`
  SELECT
   u.id,u.name,u.picture,
   COALESCE(s.points,0) points,
   COALESCE(s.questions_answered,0) questions_answered,
   COALESCE(s.correct_answers,0) correct_answers
  FROM users u
  LEFT JOIN user_scores s
   ON s.user_id=CAST(u.id AS TEXT)
  ORDER BY points DESC
  LIMIT 100
 `).all();

 return json({
  success:true,
  leaderboard:x.results||[]
 },r);
}

async function leaderboardMe(r,e){
 const u=await user(r,e);
 if(!u)return json({
  success:false,error:"Login required"
 },r,401);

 const x=await e.DB.prepare(`
  SELECT * FROM user_scores
