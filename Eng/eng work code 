async function scoreUpdate(e,id,correct){
 await e.DB.prepare(`
  INSERT INTO user_scores
  (user_id,points,questions_answered,correct_answers,updated_at)
  VALUES (?,?,?,?,?)
  ON CONFLICT(user_id)
  DO UPDATE SET
   points=user_scores.points+excluded.points,
   questions_answered=user_scores.questions_answered+1,
   correct_answers=user_scores.correct_answers+excluded.correct_answers,
   updated_at=excluded.updated_at
 `).bind(
  String(id),
  correct,
  1,
  correct,
  Date.now()
 ).run();
}


