const SITE="https://createlk.com";
const SESSION="english_session";
const GA="https://accounts.google.com/o/oauth2/v2/auth";
const GT="https://oauth2.googleapis.com/token";
const GU="https://openidconnect.googleapis.com/v1/userinfo";
const COINS=5,XP=10,DAYS=30;

function json(data,status=200){
 return new Response(JSON.stringify(data),{
  status,
  headers:{
   "Content-Type":"application/json",
   "Access-Control-Allow-Origin":SITE,
   "Access-Control-Allow-Credentials":"true"
  }
 });
}

function cors(){
 return new Response(null,{status:204,headers:{
  "Access-Control-Allow-Origin":SITE,
  "Access-Control-Allow-Credentials":"true",
  "Access-Control-Allow-Methods":"GET,POST,OPTIONS",
  "Access-Control-Allow-Headers":"Content-Type,Authorization"
 }});
}

function cookie(n,v,m=86400){
 return `${n}=${v}; Path=/; HttpOnly; Secure; SameSite=Lax; Max-Age=${m}`;
}

async function hash(v){
 const b=await crypto.subtle.digest("SHA-256",new TextEncoder().encode(v));
 return [...new Uint8Array(b)].map(x=>x.toString(16).padStart(2,"0")).join("");
}

function randomToken(){
 const a=new Uint8Array(32);
 crypto.getRandomValues(a);
 return [...a].map(x=>x.toString(16).padStart(2,"0")).join("");
}

function getCookie(req,name){
 const c=req.headers.get("Cookie")||"";
 const m=c.match(new RegExp("(?:^|;\\s*)"+name+"=([^;]+)"));
 return m?decodeURIComponent(m[1]):null;
}

async function user(req,env){
 const t=getCookie(req,SESSION);
 if(!t)return null;
 return await env.DB.prepare(`
  SELECT u.* FROM sessions s
  JOIN users u ON u.id=s.user_id
  WHERE s.token_hash=? AND datetime(s.expires_at)>datetime('now')
  LIMIT 1
 `).bind(await hash(t)).first();
}

async function payFetch(env,path,options={}){
 if(!env.PAY)throw new Error("PAY Service Binding is missing");
 const headers=new Headers(options.headers||{});
 headers.set("Authorization",`Bearer ${env.INTERNAL_SECRET}`);
 if(options.body)headers.set("Content-Type","application/json");
 return env.PAY.fetch(new Request(`https://pay${path}`,{...options,headers}));
}

async function premium(env,id){
 try{
  const r=await payFetch(env,"/internal/check",{
   method:"POST",
   body:JSON.stringify({user_id:Number(id)})
  });
  const d=await r.json();
  const expiry=d.membership_expiry||null;
  const active=r.ok&&d.premium===true&&expiry&&new Date(expiry).getTime()>Date.now();
  return{premium:active,expiry:active?expiry:null};
 }catch(e){
  console.error("PAY PREMIUM ERROR",e);
  return{premium:false,expiry:null};
 }
}

async function rewards(env,id){
 const r=await env.DB.prepare(`
  SELECT COALESCE(SUM(coins),0) coins,
         COALESCE(SUM(xp),0) xp
  FROM user_rewards WHERE user_id=?
 `).bind(id).first();
 return{coins:Number(r?.coins||0),xp:Number(r?.xp||0)};
}

async function googleStart(env){
 const state=randomToken();
 await env.DB.prepare(`
  INSERT INTO oauth_states(state,created_at) VALUES(?,?)
 `).bind(state,new Date().toISOString()).run();

 const u=new URL(GA);
 u.searchParams.set("client_id",env.GOOGLE_CLIENT_ID);
 u.searchParams.set("redirect_uri","https://eng.createlk.workers.dev/auth/callback");
 u.searchParams.set("response_type","code");
 u.searchParams.set("scope","openid email profile");
 u.searchParams.set("state",state);
 return Response.redirect(u.toString(),302);
}

async function googleCallback(req,env){
 const u=new URL(req.url);
 const code=u.searchParams.get("code");
 const state=u.searchParams.get("state");

 if(!code||!state)return new Response("Google login failed",{status:400});

 const st=await env.DB.prepare(`
  SELECT state FROM oauth_states WHERE state=? LIMIT 1
 `).bind(state).first();

 if(!st)return new Response("Invalid login state",{status:400});

 await env.DB.prepare(`
  DELETE FROM oauth_states WHERE state=?
 `).bind(state).run();

 const redirect="https://eng.createlk.workers.dev/auth/callback";

 const tokenRes=await fetch(GT,{
  method:"POST",
  headers:{"Content-Type":"application/x-www-form-urlencoded"},
  body:new URLSearchParams({
   code,
   client_id:env.GOOGLE_CLIENT_ID,
   client_secret:env.GOOGLE_CLIENT_SECRET,
   redirect_uri:redirect,
   grant_type:"authorization_code"
  })
 });

 if(!tokenRes.ok)return new Response("Google token exchange failed",{status:400});

 const td=await tokenRes.json();

 const infoRes=await fetch(GU,{
  headers:{Authorization:`Bearer ${td.access_token}`}
 });

 if(!infoRes.ok)return new Response("Google profile failed",{status:400});

 const g=await infoRes.json();
 const googleId=g.sub;
 const email=g.email;
 const name=g.name||email;
 const picture=g.picture||"";

 let urow=await env.DB.prepare(`
  SELECT * FROM users WHERE google_id=? LIMIT 1
 `).bind(googleId).first();

 if(!urow){
  urow=await env.DB.prepare(`
   SELECT * FROM users WHERE email=? LIMIT 1
  `).bind(email).first();
 }

 if(urow){
  await env.DB.prepare(`
   UPDATE users
   SET google_id=?,name=?,picture=?,last_active_at=?
   WHERE id=?
  `).bind(googleId,name,picture,Date.now(),urow.id).run();
 }else{
  const ins=await env.DB.prepare(`
   INSERT INTO users(
    google_id,name,email,membership_status,
    created_at,auth_provider,picture,last_active_at
   ) VALUES(?,?,?,'FREE',?,?,?,?)
  `).bind(
   googleId,name,email,new Date().toISOString(),
   "google",picture,Date.now()
  ).run();

  urow=await env.DB.prepare(`
   SELECT * FROM users WHERE id=?
  `).bind(ins.meta.last_row_id).first();
 }

 const token=randomToken();

 await env.DB.prepare(`
  INSERT INTO sessions(user_id,token_hash,expires_at)
  VALUES(?,?,?)
 `).bind(
  urow.id,
  await hash(token),
  new Date(Date.now()+7*86400000).toISOString()
 ).run();

 return new Response(null,{
  status:302,
  headers:{
   Location:`${SITE}/Eng/`,
   "Set-Cookie":cookie(SESSION,token,7*86400)
  }
 });
}

async function logout(req,env){
 const token=getCookie(req,SESSION);
 if(token){
  await env.DB.prepare(`
   DELETE FROM sessions WHERE token_hash=?
  `).bind(await hash(token)).run();
 }

 return new Response(null,{
  status:302,
  headers:{
   Location:`${SITE}/Eng/`,
   "Set-Cookie":cookie(SESSION,"",0)
  }
 });
}

