async function checkQuiz(req,env){
 const u=await user(req,env);
 if(!u)return json({success:false,error:"Login required"},401);

 const b=await req.json().catch(()=>({}));

 const attemptId=Number(b.attempt_id);
 const questionId=Number(b.question_id);

 let answer=String(b.answer??"").trim().toLowerCase();

 const map={a:1,b:2,c:3,d:4};
 if(map[answer])answer=map[answer];

 const selected=Number(answer);

 if(!attemptId||!questionId||![1,2,3,4].includes(selected)){
  return json({success:false,error:"Invalid answer"},400);
 }

 const attempt=await env.DB.prepare(`
  SELECT * FROM quiz_attempts
  WHERE id=? AND user_id=? LIMIT 1
 `).bind(attemptId,u.id).first();

 if(!attempt)return json({success:false,error:"Quiz attempt not found"},404);

 if(attempt.completed_at){
  return json({success:false,error:"Quiz already completed"},400);
 }

 const q=await env.DB.prepare(`
  SELECT * FROM questions
  WHERE id=? AND lesson_id=? LIMIT 1
 `).bind(questionId,attempt.lesson_id).first();

 if(!q)return json({success:false,error:"Question not found"},404);

 const old=await env.DB.prepare(`
  SELECT * FROM quiz_question_rewards
  WHERE attempt_id=? AND question_id=? LIMIT 1
 `).bind(attemptId,questionId).first();

 if(old){
  const z=await rewards(env,u.id);
  return json({
   success:true,
   already_answered:true,
   selected_answer:old.selected_answer||selected,
   correct:Number(old.reward_coins||0)>0,
   correct_answer:Number(q.correct_answer),
   correct_text:q.explanation||"",
   reward_coins:0,
   reward_xp:0,
   total_coins:z.coins,
   total_xp:z.xp
  });
 }

 const correct=selected===Number(q.correct_answer);
 const rewardCoins=correct?COINS:0;
 const rewardXp=correct?XP:0;

 try{
  await env.DB.prepare(`
   INSERT INTO quiz_question_rewards(
    user_id,attempt_id,question_id,
    reward_coins,reward_xp,selected_answer,created_at
   ) VALUES(?,?,?,?,?,?,?)
  `).bind(
   u.id,attemptId,questionId,
   rewardCoins,rewardXp,selected,
   new Date().toISOString()
  ).run();
 }catch{
  await env.DB.prepare(`
   INSERT INTO quiz_question_rewards(
    user_id,attempt_id,question_id,
    reward_coins,reward_xp,created_at
   ) VALUES(?,?,?,?,?,?)
  `).bind(
   u.id,attemptId,questionId,
   rewardCoins,rewardXp,
   new Date().toISOString()
  ).run();
 }

 if(rewardCoins||rewardXp){
  await env.DB.prepare(`
   INSERT INTO user_rewards(
    user_id,coins,xp,created_at
   ) VALUES(?,?,?,?)
  `).bind(
   u.id,rewardCoins,rewardXp,
   new Date().toISOString()
  ).run();
 }

 const z=await rewards(env,u.id);

 return json({
  success:true,
  already_answered:false,
  selected_answer:selected,
  correct,
  correct_answer:Number(q.correct_answer),
  correct_text:q.explanation||"",
  reward_coins:rewardCoins,
  reward_xp:rewardXp,
  total_coins:z.coins,
  total_xp:z.xp
 });
}

async function submitQuiz(req,env){
 const u=await user(req,env);
 if(!u)return json({success:false,error:"Login required"},401);

