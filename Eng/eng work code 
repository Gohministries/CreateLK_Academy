export default{
 async fetch(req,env){

  if(req.method==="OPTIONS")return cors();

  const path=new URL(req.url).pathname;

  try{

   if(req.method==="GET"&&path==="/auth/google")
    return googleStart(env);

   if(req.method==="GET"&&path==="/auth/callback")
    return googleCallback(req,env);

   if(req.method==="GET"&&path==="/auth/logout")
    return logout(req,env);

   if(req.method==="GET"&&path==="/api/me")
    return me(req,env);

   if(req.method==="GET"&&path==="/api/titles")
    return titles(req,env);

   if(req.method==="GET"&&path==="/api/questions")
    return questions(req,env);

   if(req.method==="POST"&&path==="/api/quiz/start")
    return startQuiz(req,env);

   if(req.method==="POST"&&path==="/api/quiz/check")
    return checkQuiz(req,env);

   if(req.method==="POST"&&path==="/api/quiz/submit")
    return submitQuiz(req,env);

   if(req.method==="GET"&&path==="/api/leaderboard")
    return leaderboard(req,env);

   if(req.method==="GET"&&path==="/api/leaderboard/me")
    return leaderboardMe(req,env);

   if(req.method==="POST"&&path==="/api/payment/start")
    return paymentStart(req,env);

   if(req.method==="GET"&&path==="/api/health")
    return health();

   return json({
    success:false,
    error:"Not found"
   },404);

  }catch(e){

   console.error("WORKER ERROR",e);

   return json({
    success:false,
    error:"Server error"
   },500);
  }
 }
};