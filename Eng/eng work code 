/* REWARD BY ATTEMPT */

function rewardForAttempt(
attempt
){

if(attempt===1){

return{
coinsPerCorrect:5,
xpPerCorrect:10
};

}

if(attempt===2){

return{
coinsPerCorrect:3,
xpPerCorrect:5
};

}

if(attempt===3){

return{
coinsPerCorrect:1,
xpPerCorrect:2
};

}

return{
coinsPerCorrect:0,
xpPerCorrect:0
};
}


/* SUBMIT QUIZ */

async function submitQuiz(
request,
env
){

if(request.method!=="POST")
return json({
success:false,
error:"POST required"
},405);


const user=
await currentUser(
request,
env
);

if(!user)
return json({
success:false,
error:"Login required"
},401);


let body;

try{

body=
await request.json();

}catch{

return json({
success:false,
error:"Invalid JSON"
},400);

}


const lessonId=
Number(body.lesson_id);

const answers=
Array.isArray(body.answers)
?body.answers:[];


if(!lessonId)
return json({
success:false,
error:"Invalid lesson_id"
},400);


if(
!answers.length||
answers.length>50
)
return json({
success:false,
error:"Invalid answers"
},400);


/* LESSON */

const lesson=
await env.DB.prepare(`
SELECT
id,
title,
access_type
FROM lessons
WHERE id=?
AND active=1
LIMIT 1
`)
.bind(lessonId)
.first();


if(!lesson)
return json({
success:false,
error:"Lesson not found"
},404);


/* ACCESS */

const isPremium=
await premium(
env,
user.id
);

const isFree=
lessonId===1||
String(
lesson.access_type||""
).toUpperCase()==="FREE";


if(
!isFree&&!isPremium
)
return json({
success:false,
error:"Premium required",
premium_required:true
},403);


/* GET CORRECT ANSWERS FROM D1 */

const result=
await env.DB.prepare(`
SELECT
id,
correct_answer
FROM questions
WHERE lesson_id=?
AND active=1
ORDER BY id ASC
LIMIT 50
`)
.bind(lessonId)
.all();


const rows=
result.results||[];


if(!rows.length)
return json({
success:false,
error:"No questions found"
},404);


/* SUBMITTED ANSWERS */

const submitted=
new Map();

for(
const item of answers
){

const id=
Number(
item?.question_id
);

const answer=
String(
item?.answer||""
)
.trim()
.toLowerCase();

if(
id&&
["a","b","c","d"]
.includes(answer)
){

submitted.set(
id,
answer
);

}
}


/* SCORE */

let score=0;

for(
const q of rows
){

const submittedAnswer=
submitted.get(
Number(q.id)
);

const correctAnswer=
String(
q.correct_answer||""
)
.trim()
.toLowerCase();

if(
submittedAnswer===
correctAnswer
){

score++;

}
}


const total=
rows.length;


const percentage=
total?
Math.round(
score/total*100
):0;


/*
COUNT ATTEMPT
BEFORE SAVING RESULT
*/

const previousAttempts=
await monthlyAttempts(
env,
user.id,
lessonId
);

const attempt=
previousAttempts+1;


/* REWARD */

const reward=
rewardForAttempt(
attempt
);

const rewardCoins=
reward.coinsPerCorrect*
score;

const rewardXP=
reward.xpPerCorrect*
score;

const completedAt=
new Date().toISOString();


/*
IMPORTANT:

SAVE QUIZ RESULT AND
ADD COINS/XP TO D1.

The user_rewards row is created
automatically if it does not exist.
*/

await env.DB.batch([

env.DB.prepare(`
INSERT OR IGNORE INTO user_rewards
(
user_id,
coins,
xp,
updated_at
)
VALUES
(?,?,?,?)
`)
.bind(
user.id,
0,
0,
completedAt
),

env.DB.prepare(`
UPDATE user_rewards
SET
coins=COALESCE(coins,0)+?,
xp=COALESCE(xp,0)+?,
updated_at=?
WHERE user_id=?
`)
.bind(
rewardCoins,
rewardXP,
completedAt,
user.id
),

env.DB.prepare(`
INSERT INTO quiz_results
(
user_id,
lesson_id,
score,
total,
percentage,
completed_at
)
VALUES
(?,?,?,?,?,?)
`)
.bind(
user.id,
lessonId,
score,
total,
percentage,
completedAt
)

]);


/* READ NEW BALANCE FROM D1 */

const totals=
await getRewards(
env,
user.id
);


/* RESPONSE */

return json({

success:true,

lesson_id:
lessonId,

lesson_title:
lesson.title,

score,

total,

percentage,

attempt,

reward_coins:
rewardCoins,

reward_xp:
rewardXP,

total_coins:
totals.coins,

total_xp:
totals.xp,

rewarded:
attempt<=3,

next_attempt_reward:
rewardForAttempt(
attempt+1
),

completed_at:
completedAt

});
}


