  SELECT * FROM quiz_attempts
  WHERE id=? AND user_id=? LIMIT 1
 `).bind(attemptId,u.id).first();

 if(!attempt)return json({success:false,error:"Attempt not found"},404);

 if(attempt.completed_at){
  return json({success:false,error:"Quiz already completed"},400);
 }

 const totalRow=await env.DB.prepare(`
  SELECT COUNT(*) total
  FROM questions WHERE lesson_id=?
 `).bind(attempt.lesson_id).first();

 const answeredRow=await env.DB.prepare(`
  SELECT COUNT(*) total
  FROM quiz_question_rewards
  WHERE attempt_id=?
 `).bind(attemptId).first();

 const total=Number(totalRow?.total||0);
 const answered=Number(answeredRow?.total||0);

 if(!total)return json({success:false,error:"No questions found"},400);

 if(answered<total){
  return json({
   success:false,
   error:`Answer all questions first (${answered}/${total})`
  },400);
 }

 const r=await env.DB.prepare(`
  SELECT
   COALESCE(SUM(CASE WHEN reward_coins>0 THEN 1 ELSE 0 END),0) score,
   COALESCE(SUM(reward_coins),0) coins,
   COALESCE(SUM(reward_xp),0) xp
  FROM quiz_question_rewards
  WHERE attempt_id=?
 `).bind(attemptId).first();

 const score=Number(r?.score||0);
 const coins=Number(r?.coins||0);
 const xp=Number(r?.xp||0);
 const percentage=Math.round(score/total*100);
 const completedAt=new Date().toISOString();

 await env.DB.prepare(`
  UPDATE quiz_attempts
  SET completed_at=?,score=?,total=?
  WHERE id=?
 `).bind(
  completedAt,score,total,attemptId
 ).run();

 await env.DB.prepare(`
  INSERT INTO quiz_results(
   user_id,lesson_id,score,total,percentage,created_at
  ) VALUES(?,?,?,?,?,?)
 `).bind(
  u.id,attempt.lesson_id,score,
