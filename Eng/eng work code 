const SITE="https://createlk.com";
const SESSION="english_session";
const PAY_URL="https://pay/internal/check";

const GA="https://accounts.google.com/o/oauth2/v2/auth";
const GT="https://oauth2.googleapis.com/token";
const GU="https://openidconnect.googleapis.com/v1/userinfo";

const COINS=5,XP=10,DAYS=30;

export default{async fetch(r,e){
 try{
  const p=new URL(r.url).pathname;
  if(r.method==="OPTIONS")return cors(new Response(null,{status:204}),r);

  const f={
   "/auth/google":google,
   "/auth/callback":callback,
   "/auth/logout":logout,
   "/api/me":me,
   "/api/titles":titles,
   "/api/questions":questions,
   "/api/quiz/start":start,
   "/api/quiz/check":check,
   "/api/quiz/submit":submit,
   "/api/leaderboard":leaderboard,
   "/api/leaderboard/me":leaderboardMe,
   "/api/payment/start":paymentStart
  };

  if(f[p])return f[p](r,e);

  if(p==="/api/health")
   return json({
    success:true,
    message:"English API is running",
    version:"ENGLISH-2026-10-05"
   },r);

  return json({success:false,error:"Not found"},r,404);
 }catch(x){
  console.error(x);
  return json({
   success:false,
   error:"Server error",
   detail:String(x?.message||x)
  },r,500);
 }  
}};


/* AUTH */

async function google(r,e){
 const state=crypto.randomUUID();
 const q=new URLSearchParams({
  client_id:e.GOOGLE_CLIENT_ID,
  redirect_uri:`${SITE}/auth/callback`,
  response_type:"code",
  scope:"openid email profile",
  state
 });
 return new Response(null,{status:302,headers:{
  Location:`${GA}?${q}`,
  "Set-Cookie":cookie("google_state",state,600,false)
 }});
}

async function callback(r,e){
 const u=new URL(r.url),c=cookies(r.headers.get("Cookie")||"");
 const code=u.searchParams.get("code");
 const state=u.searchParams.get("state");

 if(!code||state!==c.google_state)
  return new Response("Invalid OAuth state",{status:403});

 const tr=await fetch(GT,{
  method:"POST",
  headers:{"Content-Type":"application/x-www-form-urlencoded"},
  body:new URLSearchParams({
   code,
   client_id:e.GOOGLE_CLIENT_ID,
   client_secret:e.GOOGLE_CLIENT_SECRET,
   redirect_uri:`${SITE}/auth/callback`,
   grant_type:"authorization_code"
  })
 });

 if(!tr.ok)return new Response("Google authentication failed",{status:500});

 const t=await tr.json();
 const ur=await fetch(GU,{
  headers:{Authorization:`Bearer ${t.access_token}`}
 });
 const g=await ur.json();

 const gid=String(g.sub||"");
 const email=String(g.email||"").trim().toLowerCase();
 const name=String(g.name||email.split("@")[0]);
 const picture=String(g.picture||"");

 if(!gid||!email)
  return new Response("Google account information missing",{status:400});

 let user=await e.DB.prepare(
  "SELECT * FROM users WHERE google_id=? OR email=? LIMIT 1"
 ).bind(gid,email).first();

 if(!user){
  await e.DB.prepare(`
   INSERT INTO users
   (google_id,name,email,membership_status,auth_provider,picture)
   VALUES (?,? ,?,'FREE','google',?)
  `).bind(gid,name,email,picture).run();

  user=await e.DB.prepare(
   "SELECT * FROM users WHERE email=?"
  ).bind(email).first();
 }else{
  await e.DB.prepare(`
   UPDATE users
   SET google_id=?,name=?,picture=?,last_active_at=?
   WHERE id=?
  `).bind(gid,name,picture,Date.now(),user.id).run();
 }

 const raw=crypto.randomUUID()+crypto.randomUUID();

 await e.DB.prepare(
  "DELETE FROM sessions WHERE user_id=?"
 ).bind(user.id).run();

 await e.DB.prepare(`
  INSERT INTO sessions(user_id,token_hash,expires_at)
  VALUES (?,?,?)
 `).bind(
  user.id,
  await sha(raw),
  new Date(Date.now()+DAYS*86400000).toISOString()
 ).run();

 return new Response(null,{status:302,headers:{
  Location:`${SITE}/Eng/`,
  "Set-Cookie":cookie(SESSION,raw,DAYS*86400,true)
 }});
}

async function logout(r,e){
 const c=cookies(r.headers.get("Cookie")||"");
 if(c[SESSION])
  await e.DB.prepare(
   "DELETE FROM sessions WHERE token_hash=?"
  ).bind(await sha(c[SESSION])).run();

 const x=json({success:true,logged_out:true},r);
 x.headers.append("Set-Cookie",cookie(SESSION,"",0,true));
 return x;
}


/* USER */

async function user(r,e){
 const c=cookies(r.headers.get("Cookie")||"");
 if(!c[SESSION])return null;

 return e.DB.prepare(`
  SELECT u.*
  FROM sessions s
  JOIN users u ON u.id=s.user_id
  WHERE s.token_hash=? AND s.expires_at>?
  LIMIT 1
 `).bind(
  await sha(c[SESSION]),
  new Date().toISOString()
 ).first();
}

async function me(r,e){
 const u=await user(r,e);

 if(!u)return json({
  success:true,
  logged_in:false,
  premium:false,
  membership_expiry:null,
  user:null
 },r);

 const z=await rewards(e,u.id);
 const p=await premium(e,u.id);

 return json({
  success:true,
  logged_in:true,
  premium:p.premium,
  membership_expiry:p.expiry,
  user:{
   id:u.id,
   name:u.name,
   email:u.email,
   picture:u.picture||"",
   membership_status:p.premium?"PREMIUM":"FREE",
   membership_expiry:p.expiry,
   coins:z.coins,
   xp:z.xp,
   is_premium:p.premium
  }
 },r);
}


/* LESSONS */

async function titles(r,e){
 const x=await e.DB.prepare(`
  SELECT id,title,access_type,active
  FROM lessons
  WHERE active=1
  ORDER BY id
 `).all();

 return json({
  success:true,
  lessons:x.results||[]
 },r);
}

async function questions(r,e){
 const id=Number(new URL(r.url).searchParams.get("lesson_id"));

 if(!id)return json({
  success:false,
  error:"lesson_id required"
 },r,400);

 const l=await e.DB.prepare(`
  SELECT * FROM lessons
  WHERE id=? AND active=1
 `).bind(id).first();

 if(!l)return json({
  success:false,
  error:"Lesson not found"
 },r,404);

 const u=await user(r,e);
 const p=u?await premium(e,u.id):{premium:false};

 if(String(l.access_type).toUpperCase()==="PREMIUM"&&!p.premium)
  return json({
   success:false,
   error:"Premium lesson",
   premium_required:true
  },r,403);

 const x=await e.DB.prepare(`
  SELECT id,lesson_id,question,
  option_a,option_b,option_c,option_d
  FROM questions
  WHERE lesson_id=? AND active=1
  ORDER BY id
 `).bind(id).all();

 return json({
  success:true,
  lesson:l,
  questions:x.results||[]
 },r);
}


/* QUIZ */

async function start(r,e){
 const u=await user(r,e);
 if(!u)return json({
  success:false,error:"Login required"
 },r,401);

 const b=await r.json().catch(()=>({}));
 const id=Number(b.lesson_id);

 const l=await e.DB.prepare(`
  SELECT * FROM lessons
  WHERE id=? AND active=1
 `).bind(id).first();

 if(!l)return json({
  success:false,error:"Lesson not found"
 },r,404);

 const p=await premium(e,u.id);

 if(String(l.access_type).toUpperCase()==="PREMIUM"&&!p.premium)
  return json({
   success:false,
   error:"Premium lesson",
   premium_required:true
  },r,403);

 const attempt=crypto.randomUUID();

 await e.DB.prepare(`
  INSERT INTO quiz_attempts
  (id,user_id,lesson_id,created_at)
  VALUES (?,?,?,?)
 `).bind(
  attempt,u.id,id,new Date().toISOString()
 ).run();

