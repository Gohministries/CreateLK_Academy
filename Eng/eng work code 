/* CREATE REFERRAL */

async function createReferral(
env,
referredUserId,
referralCode
){

const code=
clean(referralCode)
.toUpperCase();

if(
!code.startsWith("ENG")
)
return;

const referrerId=
Number(
code.substring(3)
);

if(
!Number.isInteger(referrerId)||
referrerId<1||
referrerId===referredUserId
)
return;

const referrer=
await env.DB.prepare(`
SELECT id
FROM users
WHERE id=?
LIMIT 1
`)
.bind(referrerId)
.first();

if(!referrer)
return;

const existing=
await env.DB.prepare(`
SELECT id
FROM referrals
WHERE referred_user_id=?
LIMIT 1
`)
.bind(referredUserId)
.first();

if(existing)
return;

await env.DB.prepare(`
INSERT INTO referrals
(
referrer_id,
referred_user_id,
referral_code
)
VALUES(?,?,?)
`)
.bind(
referrerId,
referredUserId,
code
)
.run();
}


/* LOGOUT */

async function logout(
request,
env
){

