const SITE="https://createlk.com";

const SESSION="english_session";
const STATE="google_state";

const GOOGLE_AUTH="https://accounts.google.com/o/oauth2/v2/auth";
const GOOGLE_TOKEN="https://oauth2.googleapis.com/token";
const GOOGLE_USER="https://openidconnect.googleapis.com/v1/userinfo";

const SESSION_DAYS=30;
const STATE_MINUTES=10;

export default{
async fetch(request,env){
try{

const url=new URL(request.url);

if(request.method==="OPTIONS")
return cors(new Response(null,{status:204}));

if(url.pathname==="/auth/google")
return googleLogin(request,env);

if(url.pathname==="/auth/callback")
return googleCallback(request,env);

if(url.pathname==="/auth/logout")
return logout(request,env);

if(url.pathname==="/api/me")
return me(request,env);

if(url.pathname==="/api/referral")
return referral(request,env);

if(url.pathname==="/api/titles")
return titles(request,env);

if(url.pathname==="/api/questions")
return questions(request,env);

if(url.pathname==="/api/quiz/check")
return checkAnswer(request,env);

if(url.pathname==="/api/quiz/submit")
return submitQuiz(request,env);

if(url.pathname==="/api/leaderboard")
return leaderboard(request,env);

if(url.pathname==="/api/leaderboard/me")
return leaderboardMe(request,env);

if(url.pathname==="/api/health")
return json({
success:true,
message:"English API is running"
},200);

return json({
success:false,
error:"Not found"
},404);

}catch(error){

console.error(error);

return json({
success:false,
error:"Server error"
},500);

}
}
};


/* GOOGLE LOGIN */

async function googleLogin(request,env){

const url=new URL(request.url);

const referral=clean(
url.searchParams.get("ref")
);

const state=token(32);

const stateData={
state,
referral:referral||"",
expires:Date.now()+STATE_MINUTES*60000
};

const params=new URLSearchParams({
client_id:env.GOOGLE_CLIENT_ID,
redirect_uri:env.GOOGLE_REDIRECT_URI,
response_type:"code",
scope:"openid email profile",
access_type:"offline",
prompt:"select_account",
state:btoa(JSON.stringify(stateData))
});

return new Response(null,{
status:302,
headers:{
Location:`${GOOGLE_AUTH}?${params}`,
"Set-Cookie":
`${STATE}=${encodeURIComponent(state)}; Path=/; HttpOnly; Secure; SameSite=None; Max-Age=600`
}
});
}


/* GOOGLE CALLBACK */

async function googleCallback(request,env){

const url=new URL(request.url);

const code=url.searchParams.get("code");
const stateParam=url.searchParams.get("state");

if(!code||!stateParam)
return new Response(
"Invalid Google login.",
{status:400}
);

let stateData;

try{

stateData=JSON.parse(
atob(stateParam)
);

}catch{

return new Response(
"Invalid state.",
{status:400}
);

}

if(
!stateData.state||
stateData.expires<Date.now()
)
return new Response(
"Login expired.",
{status:400}
);

const cookies=parseCookies(request);

if(
cookies[STATE]!==stateData.state
)
return new Response(
"Invalid login state.",
{status:400}
);


const tokenResponse=await fetch(
GOOGLE_TOKEN,
{
method:"POST",
headers:{
"Content-Type":
"application/x-www-form-urlencoded"
},
body:new URLSearchParams({
client_id:env.GOOGLE_CLIENT_ID,
client_secret:env.GOOGLE_CLIENT_SECRET,
code,
grant_type:"authorization_code",
redirect_uri:env.GOOGLE_REDIRECT_URI
})
}
);

const tokenData=
await tokenResponse.json();

if(!tokenData.access_token)
return new Response(
"Google authentication failed.",
{status:400}
);


const googleResponse=await fetch(
GOOGLE_USER,
{
headers:{
Authorization:
`Bearer ${tokenData.access_token}`
}
}
);

const googleUser=
await googleResponse.json();

if(
!googleUser.sub||
!googleUser.email
)
return new Response(
"Unable to get Google account.",
{status:400}
);


const googleId=
clean(googleUser.sub);

const email=
clean(googleUser.email);

const name=
clean(googleUser.name)||
email.split("@")[0];

const picture=
clean(googleUser.picture);


let user=
await env.DB.prepare(`
SELECT *
FROM users
WHERE google_id=?
OR email=?
LIMIT 1
`)
.bind(
googleId,
email
)
.first();


if(!user){

const result=
await env.DB.prepare(`
INSERT INTO users
(
google_id,
name,
email,
membership_status,
membership_expiry,
auth_provider,
picture,
last_active_at
)
VALUES
(
?,?,?,'FREE',NULL,
'google',?,?
)
`)
.bind(
googleId,
name,
email,
picture,
Date.now()
)
.run();

user=
await env.DB.prepare(`
SELECT *
FROM users
WHERE id=?
LIMIT 1
`)
.bind(
result.meta.last_row_id
)
.first();

}else{

await env.DB.prepare(`
UPDATE users
SET
google_id=?,
name=?,
email=?,
picture=?,
last_active_at=?
WHERE id=?
`)
.bind(
googleId,
name,
email,
picture,
Date.now(),
user.id
)
.run();

user=
await env.DB.prepare(`
SELECT *
FROM users
WHERE id=?
LIMIT 1
`)
.bind(user.id)
.first();

}


/* CREATE REWARD ACCOUNT */

await env.DB.prepare(`
INSERT OR IGNORE INTO user_rewards
(
user_id,
coins,
xp,
updated_at
)
VALUES
(?,?,?,?)
`)
.bind(
user.id,
0,
0,
new Date().toISOString()
)
.run();


if(stateData.referral)
await createReferral(
env,
user.id,
stateData.referral
);


const sessionToken=
token(48);

const sessionHash=
await sha256(sessionToken);

const expiresAt=
new Date(
Date.now()+
SESSION_DAYS*86400000
).toISOString();


await env.DB.prepare(`
INSERT INTO sessions
(user_id,token_hash,expires_at)
VALUES(?,?,?)
`)
.bind(
user.id,
sessionHash,
expiresAt
)
.run();


return new Response(null,{
status:302,
headers:{
Location:`${SITE}/Eng/`,
"Set-Cookie":
`${SESSION}=${sessionToken}; Path=/; HttpOnly; Secure; SameSite=None; Max-Age=${SESSION_DAYS*86400}`
}
});
}


/* CURRENT USER */

async function currentUser(request,env){

const cookies=
parseCookies(request);

const sessionToken=
cookies[SESSION];

if(!sessionToken)
return null;

const hash=
await sha256(sessionToken);

return await env.DB.prepare(`
SELECT u.*
FROM sessions s
JOIN users u
ON u.id=s.user_id
WHERE s.token_hash=?
AND s.expires_at>?
LIMIT 1
`)
.bind(
hash,
new Date().toISOString()
)
.first();
}


