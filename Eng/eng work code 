const SITE="https://createlk.com",SESSION="english_session",GA="https://accounts.google.com/o/oauth2/v2/auth",GT="https://oauth2.googleapis.com/token",GU="https://openidconnect.googleapis.com/v1/userinfo",COINS=5,XP=10,DAYS=30;
const H={"Content-Type":"application/json","Access-Control-Allow-Origin":SITE,"Access-Control-Allow-Credentials":"true","Access-Control-Allow-Headers":"Content-Type,Authorization","Access-Control-Allow-Methods":"GET,POST,OPTIONS"};
const J=(x,s=200)=>new Response(JSON.stringify(x),{status:s,headers:H});
const C=()=>new Response(null,{status:204,headers:H});
const CK=(n,v,m=86400)=>`${n}=${encodeURIComponent(v)}; Path=/; HttpOnly; Secure; SameSite=Lax; Max-Age=${m}`;
function GC(r,n){const c=r.headers.get("Cookie")||"",m=c.match(new RegExp("(?:^|;\\s*)"+n+"=([^;]+)"));return m?decodeURIComponent(m[1]):null}
async function hash(v){const b=await crypto.subtle.digest("SHA-256",new TextEncoder().encode(v));return [...new Uint8Array(b)].map(x=>x.toString(16).padStart(2,"0")).join("")}
function tok(){const a=new Uint8Array(32);crypto.getRandomValues(a);return [...a].map(x=>x.toString(16).padStart(2,"0")).join("")}
async function user(r,e){const t=GC(r,SESSION);if(!t)return null;return e.DB.prepare(`SELECT u.* FROM sessions s JOIN users u ON u.id=s.user_id WHERE s.token_hash=? AND datetime(s.expires_at)>datetime('now') LIMIT 1`).bind(await hash(t)).first()}
async function pay(e,path,o={}){if(!e.PAY)throw Error("PAY service binding missing");const h=new Headers(o.headers||{});h.set("Authorization",`Bearer ${e.INTERNAL_SECRET}`);if(o.body)h.set("Content-Type","application/json");return e.PAY.fetch(new Request(`https://pay${path}`,{...o,headers:h}))}
async function premium(e,id){try{const r=await pay(e,"/internal/check",{method:"POST",body:JSON.stringify({user_id:Number(id)})}),d=await r.json(),x=d.membership_expiry||null,a=r.ok&&d.premium===true&&x&&new Date(x).getTime()>Date.now();return{premium:!!a,expiry:a?x:null}}catch(x){console.error("PREMIUM",x);return{premium:false,expiry:null}}}
async function rewards(e,id){const r=await e.DB.prepare(`SELECT COALESCE(SUM(coins),0) coins,COALESCE(SUM(xp),0) xp FROM user_rewards WHERE user_id=?`).bind(id).first();return{coins:Number(r?.coins||0),xp:Number(r?.xp||0)}}
async function googleStart(e){const s=tok();await e.DB.prepare(`INSERT INTO oauth_states(state,created_at) VALUES(?,?)`).bind(s,new Date().toISOString()).run();const u=new URL(GA);u.searchParams.set("client_id",e.GOOGLE_CLIENT_ID);u.searchParams.set("redirect_uri","https://eng.createlk.workers.dev/auth/callback");u.searchParams.set("response_type","code");u.searchParams.set("scope","openid email profile");u.searchParams.set("state",s);return Response.redirect(u.toString(),302)}
async function googleCallback(r,e){const u=new URL(r.url),code=u.searchParams.get("code"),state=u.searchParams.get("state");if(!code||!state)return new Response("Google login failed",{status:400});const st=await e.DB.prepare(`SELECT state FROM oauth_states WHERE state=? LIMIT 1`).bind(state).first();if(!st)return new Response("Invalid login state",{status:400});await e.DB.prepare(`DELETE FROM oauth_states WHERE state=?`).bind(state).run();const redirect="https://eng.createlk.workers.dev/auth/callback";const tr=await fetch(GT,{method:"POST",headers:{"Content-Type":"application/x-www-form-urlencoded"},body:new URLSearchParams({code,client_id:e.GOOGLE_CLIENT_ID,client_secret:e.GOOGLE_CLIENT_SECRET,redirect_uri:redirect,grant_type:"authorization_code"})});if(!tr.ok)return new Response("Google token exchange failed",{status:400});const td=await tr.json(),ir=await fetch(GU,{headers:{Authorization:`Bearer ${td.access_token}`}});if(!ir.ok)return new Response("Google profile failed",{status:400});const g=await ir.json(),gid=g.sub,email=g.email,name=g.name||email,picture=g.picture||"";let urow=await e.DB.prepare(`SELECT * FROM users WHERE google_id=? LIMIT 1`).bind(gid).first();if(!urow)urow=await e.DB.prepare(`SELECT * FROM users WHERE email=? LIMIT 1`).bind(email).first();if(urow)await e.DB.prepare(`UPDATE users SET google_id=?,name=?,picture=?,last_active_at=? WHERE id=?`).bind(gid,name,picture,Date.now(),urow.id).run();else{const x=await e.DB.prepare(`INSERT INTO users(google_id,name,email,membership_status,created_at,auth_provider,picture,last_active_at) VALUES(?,?,?,'FREE',?,?,?,?)`).bind(gid,name,email,new Date().toISOString(),"google",picture,Date.now()).run();urow=await e.DB.prepare(`SELECT * FROM users WHERE id=?`).bind(x.meta.last_row_id).first()}const t=tok();await e.DB.prepare(`INSERT INTO sessions(user_id,token_hash,expires_at) VALUES(?,?,?)`).bind(urow.id,await hash(t),new Date(Date.now()+604800000).toISOString()).run();return new Response(null,{status:302,headers:{Location:`${SITE}/Eng/`,"Set-Cookie":CK(SESSION,t,604800)}})}
async function logout(r,e){const t=GC(r,SESSION);if(t)await e.DB.prepare(`DELETE FROM sessions WHERE token_hash=?`).bind(await hash(t)).run();return new Response(null,{status:302,headers:{Location:`${SITE}/Eng/`,"Set-Cookie":CK(SESSION,"",0)}})}
async function me(r,e){const u=await user(r,e);if(!u)return J({success:true,logged_in:false});const z=await rewards(e,u.id),p=await premium(e,u.id);return J({success:true,logged_in:true,premium:p.premium,membership_expiry:p.expiry,user:{id:u.id,name:u.name,email:u.email,picture:u.picture||"",membership_status:p.premium?"PREMIUM":"FREE",membership_expiry:p.expiry,coins:z.coins,xp:z.xp,is_premium:p.premium}})}
async function titles(r,e){try{const x=await e.DB.prepare(`SELECT id,title,description,lesson_number,is_premium FROM lessons ORDER BY lesson_number ASC,id ASC`).all();return J({success:true,premium:false,membership_expiry:null,titles:x.results||[]})}catch(x){console.error("TITLES ERROR",x);return J({success:false,error:"Unable to load lessons"},500)}}
async function questions(r,e){const u=await user(r,e);if(!u)return J({success:false,error:"Login required"},401);const id=Number(new URL(r.url).searchParams.get("lesson_id"));if(!id)return J({success:false,error:"Invalid lesson"},400);const l=await e.DB.prepare(`SELECT * FROM lessons WHERE id=? LIMIT 1`).bind(id).first();if(!l)return J({success:false,error:"Lesson not found"},404);const p=await premium(e,u.id);if(Number(l.is_premium)===1&&!p.premium)return J({success:false,error:"Premium membership required"},403);const x=await e.DB.prepare(`SELECT id,lesson_id,question,option_a,option_b,option_c,option_d,correct_answer,explanation FROM questions WHERE lesson_id=? ORDER BY id ASC`).bind(id).all();return J({success:true,lesson_id:id,lesson_title:l.title||"",questions:x.results||[]})}
async function startQuiz(r,e){const u=await user(r,e);if(!u)return J({success:false,error:"Login required"},401);const b=await r.json().catch(()=>({})),id=Number(b.lesson_id);if(!id)return J({success:false,error:"Invalid lesson"},400);const l=await e.DB.prepare(`SELECT * FROM lessons WHERE id=? LIMIT 1`).bind(id).first();if(!l)return J({success:false,error:"Lesson not found"},404);const p=await premium(e,u.id);if(Number(l.is_premium)===1&&!p.premium)return J({success:false,error:"Premium membership required"},403);const old=await e.DB.prepare(`SELECT id FROM quiz_attempts WHERE user_id=? AND lesson_id=? AND completed_at IS NULL ORDER BY created_at DESC LIMIT 1`).bind(u.id,id).first();if(old)return J({success:true,attempt_id:old.id,resumed:true});const x=await e.DB.prepare(`INSERT INTO quiz_attempts(user_id,lesson_id,created_at) VALUES(?,?,?)`).bind(u.id,id,new Date().toISOString()).run();return J({success:true,attempt_id:x.meta.last_row_id,resumed:false})}
async function checkQuiz(r,e){const u=await user(r,e);if(!u)return J({success:false,error:"Login required"},401);const b=await r.json().catch(()=>({})),aid=Number(b.attempt_id),qid=Number(b.question_id);let a=String(b.answer??"").trim().toLowerCase();const map={a:1,b:2,c:3,d:4};if(map[a])a=map[a];const selected=Number(a);if(!aid||!qid||![1,2,3,4].includes(selected))return J({success:false,error:"Invalid answer"},400);const at=await e.DB.prepare(`SELECT * FROM quiz_attempts WHERE id=? AND user_id=? LIMIT 1`).bind(aid,u.id).first();if(!at)return J({success:false,error:"Quiz attempt not found"},404);if(at.completed_at)return J({success:false,error:"Quiz already completed"},400);const q=await e.DB.prepare(`SELECT * FROM questions WHERE id=? AND lesson_id=? LIMIT 1`).bind(qid,at.lesson_id).first();if(!q)return J({success:false,error:"Question not found"},404);const old=await e.DB.prepare(`SELECT * FROM quiz_question_rewards WHERE attempt_id=? AND question_id=? LIMIT 1`).bind(aid,qid).first();if(old){const z=await rewards(e,u.id);return J({success:true,already_answered:true,selected_answer:old.selected_answer||selected,correct:Number(old.reward_coins||0)>0,correct_answer:Number(q.correct_answer),correct_text:q.explanation||"",reward_coins:0,reward_xp:0,total_coins:z.coins,total_xp:z.xp})}const ok=selected===Number(q.correct_answer),rc=ok?COINS:0,rx=ok?XP:0,now=new Date().toISOString();await e.DB.prepare(`INSERT INTO quiz_question_rewards(user_id,attempt_id,question_id,reward_coins,reward_xp,selected_answer,created_at) VALUES(?,?,?,?,?,?,?)`).bind(u.id,aid,qid,rc,rx,selected,now).run();if(rc||rx)await e.DB.prepare(`INSERT INTO user_rewards(user_id,coins,xp,created_at) VALUES(?,?,?,?)`).bind(u.id,rc,rx,now).run();const z=await rewards(e,u.id);return J({success:true,already_answered:false,selected_answer:selected,correct:ok,correct_answer:Number(q.correct_answer),correct_text:q.explanation||"",reward_coins:rc,reward_xp:rx,total_coins:z.coins,total_xp:z.xp})}
async function submitQuiz(r,e){const u=await user(r,e);if(!u)return J({success:false,error:"Login required"},401);const b=await r.json().catch(()=>({})),aid=Number(b.attempt_id);if(!aid)return J({success:false,error:"Invalid attempt"},400);const at=await e.DB.prepare(`SELECT * FROM quiz_attempts WHERE id=? AND user_id=? LIMIT 1`).bind(aid,u.id).first();if(!at)return J({success:false,error:"Attempt not found"},404);if(at.completed_at)return J({success:false,error:"Quiz already completed"},400);const t=await e.DB.prepare(`SELECT COUNT(*) total FROM questions WHERE lesson_id=?`).bind(at.lesson_id).first(),a=await e.DB.prepare(`SELECT COUNT(*) total FROM quiz_question_rewards WHERE attempt_id=?`).bind(aid).first(),total=Number(t?.total||0),answered=Number(a?.total||0);if(!total)return J({success:false,error:"No questions found"},400);if(answered<total)return J({success:false,error:`Answer all questions first (${answered}/${total})`},400);const x=await e.DB.prepare(`SELECT COALESCE(SUM(CASE WHEN reward_coins>0 THEN 1 ELSE 0 END),0) score,COALESCE(SUM(reward_coins),0) coins,COALESCE(SUM(reward_xp),0) xp FROM quiz_question_rewards WHERE attempt_id=?`).bind(aid).first(),score=Number(x?.score||0),coins=Number(x?.coins||0),xp=Number(x?.xp||0),percentage=Math.round(score/total*100),now=new Date().toISOString();await e.DB.prepare(`UPDATE quiz_attempts SET completed_at=?,score=?,total=? WHERE id=?`).bind(now,score,total,aid).run();await e.DB.prepare(`INSERT INTO quiz_results(user_id,lesson_id,score,total,percentage,created_at) VALUES(?,?,?,?,?,?)`).bind(u.id,at.lesson_id,score,total,percentage,now).run();try{await e.DB.prepare(`INSERT INTO user_scores(user_id,score,created_at) VALUES(?,?,?)`).bind(u.id,score,now).run()}catch{}const z=await rewards(e,u.id);return J({success:true,score,total,percentage,reward_coins:coins,reward_xp:xp,total_coins:z.coins,total_xp:z.xp})}
async function leaderboard(r,e){const x=await e.DB.prepare(`SELECT u.id,u.name,u.picture,COALESCE(SUM(s.score),0) score FROM user_scores s JOIN users u ON u.id=s.user_id GROUP BY u.id ORDER BY score DESC LIMIT 100`).all();return J({success:true,leaderboard:x.results||[]})}
async function leaderboardMe(r,e){const u=await user(r,e);if(!u)return J({success:false,error:"Login required"},401);const x=await e.DB.prepare(`SELECT COALESCE(SUM(score),0) score FROM user_scores WHERE user_id=?`).bind(u.id).first();return J({success:true,score:Number(x?.score||0)})}
async function paymentStart(r,e){const u=await user(r,e);if(!u)return J({success:false,error:"Login required"},401);const b=await r.json().catch(()=>({}));try{const x=await pay(e,"/api/payment/start",{method:"POST",body:JSON.stringify({user_id:Number(u.id),email:u.email,name:u.name,amount:Number(b.amount||1000),duration_days:Number(b.duration_days||DAYS)})});return J(await x.json(),x.status)}catch(x){console.error("PAYMENT",x);return J({success:false,error:"Payment service unavailable"},500)}}
async function health(){return J({success:true,message:"English API is running"})}
export default{async fetch(r,e){if(r.method==="OPTIONS")return C();const p=new URL(r.url).pathname;try{if(r.method==="GET"&&p==="/auth/google")return googleStart(e);if(r.method==="GET"&&p==="/auth/callback")return googleCallback(r,e);if(r.method==="GET"&&p==="/auth/logout")return logout(r,e);if(r.method==="GET"&&p==="/api/me")return me(r,e);if(r.method==="GET"&&p==="/api/titles")return titles(r,e);if(r.method==="GET"&&p==="/api/questions")return questions(r,e);if(r.method==="POST"&&p==="/api/quiz/start")return startQuiz(r,e);if(r.method==="POST"&&p==="/api/quiz/check")return checkQuiz(r,e);if(r.method==="POST"&&p==="/api/quiz/submit")return submitQuiz(r,e);if(r.method==="GET"&&p==="/api/leaderboard")return leaderboard(r,e);if(r.method==="GET"&&p==="/api/leaderboard/me")return leaderboardMe(r,e);if(r.method==="POST"&&p==="/api/payment/start")return paymentStart(r,e);if(r.method==="GET"&&p==="/api/health")return health();return J({success:false,error:"Not found"},404)}catch(x){console.error("WORKER ERROR",x);return J({success:false,error:"Server error"},500)}}};