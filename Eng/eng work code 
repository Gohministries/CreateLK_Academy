 ).run();

 try{
  await env.DB.prepare(`
   INSERT INTO user_scores(user_id,score,created_at)
   VALUES(?,?,?)
  `).bind(u.id,score,completedAt).run();
 }catch{}

 const z=await rewards(env,u.id);

 return json({
