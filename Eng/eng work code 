const SITE = "https://createlk.com";
const AUTH = "https://eng-api.createlk.workers.dev";

const SESSION = "english_session";
const REFERRAL = "english_referral";
const STATE = "google_state";

const GOOGLE_AUTH = "https://accounts.google.com/o/oauth2/v2/auth";
const GOOGLE_TOKEN = "https://oauth2.googleapis.com/token";
const GOOGLE_USER = "https://openidconnect.googleapis.com/v1/userinfo";

const SESSION_DAYS = 30;
const STATE_MINUTES = 10;

export default {
  async fetch(request, env) {
    try {
      const url = new URL(request.url);

      if (request.method === "OPTIONS") {
        return cors(new Response(null, { status: 204 }));
      }

      if (url.pathname === "/auth/google") {
        return googleLogin(request, env);
      }

      if (url.pathname === "/auth/callback") {
        return googleCallback(request, env);
      }

      if (url.pathname === "/auth/logout") {
        return logout(request, env);
      }

      if (url.pathname === "/api/me") {
        return me(request, env);
      }

      if (url.pathname === "/api/referral") {
        return referral(request, env);
      }

      if (url.pathname === "/api/titles") {
        return titles(request, env);
      }

      if (url.pathname === "/api/questions") {
        return questions(request, env);
      }

      if (url.pathname === "/api/health") {
        return json({
          success: true,
          message: "English API is running"
        }, 200, request);
      }

      return json({
        success: false,
        error: "Not found"
      }, 404, request);

    } catch (error) {
      console.error(error);

      return json({
        success: false,
        error: "Server error"
      }, 500, request);
    }
  }
};


/* =========================
   GOOGLE LOGIN
========================= */

async function googleLogin(request, env) {
  const url = new URL(request.url);

  const referralCode =
    clean(url.searchParams.get("ref"));

  const state = token(32);

  const stateData = {
    state,
    referral: referralCode || "",
    expires: Date.now() + STATE_MINUTES * 60 * 1000
  };

  const encodedState =
    btoa(JSON.stringify(stateData));

  const params = new URLSearchParams({
    client_id: env.GOOGLE_CLIENT_ID,
    redirect_uri: env.GOOGLE_REDIRECT_URI,
    response_type: "code",
    scope: "openid email profile",
    access_type: "offline",
    prompt: "select_account",
    state: encodedState
  });

  return new Response(null, {
    status: 302,
    headers: {
      Location: `${GOOGLE_AUTH}?${params.toString()}`,
      "Set-Cookie":
        `${STATE}=${encodeURIComponent(state)}; Path=/; HttpOnly; Secure; SameSite=Lax; Max-Age=600`
    }
  });
}


/* =========================
   GOOGLE CALLBACK
========================= */

async function googleCallback(request, env) {
  const url = new URL(request.url);

  const code = url.searchParams.get("code");
  const stateParam = url.searchParams.get("state");

  if (!code || !stateParam) {
    return new Response("Invalid Google login.", {
      status: 400
    });
  }

  let stateData;

  try {
    stateData = JSON.parse(
      atob(stateParam)
    );
  } catch {
    return new Response("Invalid state.", {
      status: 400
    });
  }

  if (
    !stateData.state ||
    stateData.expires < Date.now()
  ) {
    return new Response("Login expired.", {
      status: 400
    });
  }

  const cookies = parseCookies(request);

  if (
    !cookies[STATE] ||
    cookies[STATE] !== stateData.state
  ) {
    return new Response("Invalid login state.", {
      status: 400
    });
  }

  /* Exchange Google code */

  const tokenResponse = await fetch(
    GOOGLE_TOKEN,
    {
      method: "POST",
      headers: {
        "Content-Type":
          "application/x-www-form-urlencoded"
      },
      body: new URLSearchParams({
        client_id: env.GOOGLE_CLIENT_ID,
        client_secret: env.GOOGLE_CLIENT_SECRET,
        code,
        grant_type: "authorization_code",
        redirect_uri: env.GOOGLE_REDIRECT_URI
      })
    }
  );

  const tokenData =
    await tokenResponse.json();

  if (!tokenData.access_token) {
    console.error(tokenData);

    return new Response(
      "Google authentication failed.",
      { status: 400 }
    );
  }

  /* Get Google user */

  const googleResponse =
    await fetch(GOOGLE_USER, {
      headers: {
        Authorization:
          `Bearer ${tokenData.access_token}`
      }
    });

  const googleUser =
    await googleResponse.json();

  if (
    !googleUser.sub ||
    !googleUser.email
  ) {
    return new Response(
      "Unable to get Google account.",
      { status: 400 }
    );
  }

  const googleId = clean(googleUser.sub);
  const email = clean(googleUser.email);
  const name =
    clean(googleUser.name) ||
    email.split("@")[0];

  /* Find existing user */

  let user = await env.DB
    .prepare(`
      SELECT *
      FROM users
      WHERE google_id = ?
         OR email = ?
      LIMIT 1
    `)
    .bind(googleId, email)
    .first();

  if (!user) {

    const result = await env.DB
      .prepare(`
        INSERT INTO users
        (
          google_id,
          name,
          email,
          membership_status,
          membership_expiry,
          auth_provider
        )
        VALUES (?, ?, ?, 'FREE', NULL, 'google')
      `)
      .bind(
        googleId,
        name,
        email
      )
      .run();

    user = await env.DB
      .prepare(`
        SELECT *
        FROM users
        WHERE id = ?
        LIMIT 1
      `)
      .bind(result.meta.last_row_id)
      .first();

  } else {

    await env.DB
      .prepare(`
        UPDATE users
        SET
          google_id = ?,
          name = ?,
          email = ?,
          last_active_at = ?
        WHERE id = ?
      `)
      .bind(
        googleId,
        name,
        email,
        Date.now(),
        user.id
      )
      .run();

    user = await env.DB
      .prepare(`
        SELECT *
        FROM users
        WHERE id = ?
        LIMIT 1
      `)
      .bind(user.id)
      .first();
  }


  /* =========================
     REFERRAL
  ========================= */

  const referralCode =
    clean(stateData.referral);

  if (
    referralCode &&
    !referralCode.includes(" ") &&
    referralCode.length <= 100
  ) {
    await createReferral(
      env,
      user.id,
      referralCode
    );
  }


  /* =========================
     CREATE SESSION
  ========================= */

  const sessionToken =
    token(48);

  const sessionHash =
    await sha256(sessionToken);

  const expiresAt =
    new Date(
      Date.now() +
      SESSION_DAYS *
      24 *
      60 *
      60 *
      1000
    ).toISOString();

  await env.DB
    .prepare(`
      INSERT INTO sessions
      (
        user_id,
        token_hash,
        expires_at
      )
      VALUES (?, ?, ?)
    `)
    .bind(
      user.id,
      sessionHash,
      expiresAt
    )
    .run();


  return new Response(null, {
    status: 302,

    headers: {
      Location: `${SITE}/Eng/`,

      "Set-Cookie":
        `${SESSION}=${sessionToken}; Path=/; HttpOnly; Secure; SameSite=Lax; Max-Age=${SESSION_DAYS * 86400}`
    }
  });
}


/* =========================
   CURRENT USER
========================= */

async function currentUser(request, env) {

  const cookies =
    parseCookies(request);

  const sessionToken =
    cookies[SESSION];

  if (!sessionToken) {
    return null;
  }

  const sessionHash =
    await sha256(sessionToken);

  const user =
    await env.DB
      .prepare(`
        SELECT u.*
        FROM sessions s
        JOIN users u
          ON u.id = s.user_id
        WHERE s.token_hash = ?
          AND s.expires_at > ?
        LIMIT 1
      `)
      .bind(
        sessionHash,
        new Date().toISOString()
      )
      .first();

  return user || null;
}


/* =========================
   /api/me
========================= */

async function me(request, env) {

  const user =
    await currentUser(request, env);

  if (!user) {
    return json({
      success: true,
      logged_in: false,
      user: null
    }, 200, request);
  }

  const isPremium =
    await premium(env, user.id);

  return json({
    success: true,
    logged_in: true,

    user: {
      id: user.id,
      name: user.name,
      email: user.email,
      membership_status:
        user.membership_status,
      membership_expiry:
        user.membership_expiry
    },

    premium: isPremium
  }, 200, request);
}


/* =========================
   PREMIUM CHECK
========================= */

async function premium(env, userId) {

  const user =
    await env.DB
      .prepare(`
        SELECT
          membership_status,
          membership_expiry
        FROM users
        WHERE id = ?
        LIMIT 1
      `)
      .bind(userId)
      .first();

  if (!user) {
    return false;
  }

  if (
    String(user.membership_status)
      .toUpperCase() !== "PREMIUM"
  ) {
    return false;
  }

  if (!user.membership_expiry) {
    return true;
  }

  return (
    new Date(
      user.membership_expiry
    ).getTime() > Date.now()
  );
}


/* =========================
   LESSON TITLES
========================= */

async function titles(request, env) {

  const result =
    await env.DB
      .prepare(`
        SELECT
          id,
          title,
          access_type
        FROM lessons
        WHERE active = 1
        ORDER BY id ASC
      `)
      .all();

  return json({
    success: true,
    lessons:
      result.results || []
  }, 200, request);
}


/* =========================
   QUESTIONS
========================= */

async function questions(request, env) {

  const url =
    new URL(request.url);

  const lessonId =
    Number(
      url.searchParams.get(
        "lesson_id"
      )
    );

  if (!lessonId || lessonId < 1) {
    return json({
      success: false,
      error: "Invalid lesson_id"
    }, 400, request);
  }


  const lesson =
    await env.DB
      .prepare(`
        SELECT
          id,
          title,
          access_type
        FROM lessons
        WHERE id = ?
          AND active = 1
        LIMIT 1
      `)
      .bind(lessonId)
      .first();

  if (!lesson) {
    return json({
      success: false,
      error: "Lesson not found"
    }, 404, request);
  }


  const user =
    await currentUser(
      request,
      env
    );

  const isPremium =
    user
      ? await premium(
          env,
          user.id
        )
      : false;


  const isFree =
    lessonId === 1 ||
    String(
      lesson.access_type
    ).toUpperCase() === "FREE";


  if (!isFree && !isPremium) {

    return json({
      success: false,
      error: "Premium required",
      premium_required: true
    }, 403, request);
  }


  const result =
    await env.DB
      .prepare(`
        SELECT
          id,
          lesson_id,
          question,
          option_a,
          option_b,
          option_c,
          option_d,
          correct_answer
        FROM questions
        WHERE lesson_id = ?
          AND active = 1
        ORDER BY id ASC
        LIMIT 5
      `)
      .bind(lessonId)
      .all();


  return json({
    success: true,

    lesson: {
      id: lesson.id,
      title: lesson.title,
      access_type:
        lesson.access_type
    },

    questions:
      result.results || []
  }, 200, request);
}


/* =========================
   REFERRAL
========================= */

async function referral(request, env) {

  const user =
    await currentUser(
      request,
      env
    );

  if (!user) {
    return json({
      success: false,
      error: "Login required"
    }, 401, request);
  }

  const code =
    `ENG${user.id}`;

  return json({
    success: true,

    referral_code: code,

    referral_url:
      `${SITE}/Eng/?ref=${encodeURIComponent(code)}`
  }, 200, request);
}


/* =========================
   CREATE REFERRAL
========================= */

async function createReferral(
  env,
  referredUserId,
  referralCode
) {

  if (!referralCode) {
    return;
  }

  const code =
    referralCode
      .trim()
      .toUpperCase();

  if (!code.startsWith("ENG")) {
    return;
  }

  const referrerId =
    Number(
      code.substring(3)
    );

  if (
    !Number.isInteger(referrerId) ||
    referrerId < 1
  ) {
    return;
  }

  /* Prevent self referral */

  if (
    referrerId === referredUserId
  ) {
    return;
  }

  /* Confirm referrer exists */

  const referrer =
    await env.DB
      .prepare(`
        SELECT id
        FROM users
        WHERE id = ?
        LIMIT 1
      `)
      .bind(referrerId)
      .first();

  if (!referrer) {
    return;
  }

  /* Only first referral is stored */

  const existing =
    await env.DB
      .prepare(`
        SELECT id
        FROM referrals
        WHERE referred_user_id = ?
        LIMIT 1
      `)
      .bind(referredUserId)
      .first();

  if (existing) {
    return;
  }

  await env.DB
    .prepare(`
      INSERT INTO referrals
      (
        referrer_id,
        referred_user_id,
        referral_code
      )
      VALUES (?, ?, ?)
    `)
    .bind(
      referrerId,
      referredUserId,
      code
    )
    .run();
}


/* =========================
   LOGOUT
========================= */

async function logout(request, env) {

  const cookies =
    parseCookies(request);

  const sessionToken =
    cookies[SESSION];

  if (sessionToken) {

    const hash =
      await sha256(
        sessionToken
      );

    await env.DB
      .prepare(`
        DELETE FROM sessions
        WHERE token_hash = ?
      `)
      .bind(hash)
      .run();
  }

  return new Response(null, {
    status: 302,

    headers: {
      Location: `${SITE}/Eng/`,

      "Set-Cookie":
        `${SESSION}=; Path=/; HttpOnly; Secure; SameSite=Lax; Max-Age=0`
    }
  });
}


/* =========================
   HELPERS
========================= */

function token(length = 32) {

  const bytes =
    new Uint8Array(length);

  crypto.getRandomValues(bytes);

  let output = "";

  for (const byte of bytes) {
    output +=
      byte.toString(16)
        .padStart(2, "0");
  }

  return output;
}


async function sha256(value) {

  const data =
    new TextEncoder()
      .encode(value);

  const hash =
    await crypto.subtle.digest(
      "SHA-256",
      data
    );

  return Array.from(
    new Uint8Array(hash)
  )
    .map(
      b =>
        b.toString(16)
          .padStart(2, "0")
    )
    .join("");
}


function parseCookies(request) {

  const header =
    request.headers.get(
      "Cookie"
    );

  const cookies = {};

  if (!header) {
    return cookies;
  }

  for (
    const part of
    header.split(";")
  ) {

    const index =
      part.indexOf("=");

    if (index === -1) {
      continue;
    }

    const key =
      part
        .slice(0, index)
        .trim();

    const value =
      part
        .slice(index + 1)
        .trim();

    cookies[key] =
      decodeURIComponent(value);
  }

  return cookies;
}


function clean(value) {

  return String(
    value || ""
  ).trim();
}


function json(
  data,
  status = 200,
  request
) {

  return cors(
    new Response(
      JSON.stringify(data),
      {
        status,

        headers: {
          "Content-Type":
            "application/json"
        }
      }
    )
  );
}


function cors(response) {

  const headers =
    new Headers(
      response.headers
    );

  headers.set(
    "Access-Control-Allow-Origin",
    SITE
  );

  headers.set(
    "Access-Control-Allow-Credentials",
    "true"
  );

  headers.set(
    "Access-Control-Allow-Headers",
    "Content-Type"
  );

  headers.set(
    "Access-Control-Allow-Methods",
    "GET,POST,OPTIONS"
  );

  return new Response(
    response.body,
    {
      status: response.status,
      statusText:
        response.statusText,
      headers
    }
  );
}