const SITE="https://createlk.com";
const MERCHANT_ID="257692";
const CURRENCY="LKR";
const PRICE=999;
const DAYS=30;
const COMMISSION=20;
const MIN_REFERRALS=10;
const PAYHERE="https://www.payhere.lk/pay/checkout";

export default {
 async fetch(r,e){
  try{
   const p=new URL(r.url).pathname;

   if(r.method==="OPTIONS"){
    return new Response(null,{
     status:204,
     headers:cors()
    });
   }

   if(p==="/api/start"&&r.method==="POST")
    return start(r,e);

   if(p==="/api/checkout"&&r.method==="POST")
    return checkout(r,e);

   if(p==="/api/notify"&&r.method==="POST")
    return notify(r,e);

   if(p==="/api/status")
    return status(r,e);

   if(p==="/api/health")
    return health(e);

   return json({
    success:false,
    error:"Not found"
   },404);

  }catch(x){
   console.error(x);
   return json({
    success:false,
    error:String(x)
   },500);
  }
 }
};


/* START */

async function start(r,e){

 const x=await body(r);
 const uid=Number(x.user_id);

 if(!uid){
  return json({
   success:false,
   error:"user_id required"
  },400);
 }

 const u=await e.DB.prepare(`
  SELECT id,name,email
  FROM users
  WHERE id=?
  LIMIT 1
 `).bind(uid).first();

 if(!u){
  return json({
   success:false,
   error:"User not found"
  },404);
 }

 const active=await e.DB.prepare(`
  SELECT id,expires_at
  FROM subscriptions
  WHERE user_id=?
  AND status='active'
  AND (
   expires_at IS NULL
   OR expires_at>?
  )
  ORDER BY id DESC
  LIMIT 1
 `).bind(
  uid,
  new Date().toISOString()
 ).first();

 if(active){
  return json({
   success:false,
   alreadyActive:true,
   subscription:active
  },400);
 }

 const order_id=`ENG-${Date.now()}-${uid}`;

 await e.DB.prepare(`
  INSERT INTO payments
  (
   user_id,
   order_id,
   amount,
   currency,
   status,
   created_at
  )
  VALUES(?,?,?,?,?,?)
 `).bind(
  uid,
  order_id,
  PRICE,
  CURRENCY,
  "pending",
  new Date().toISOString()
 ).run();

 return json({
  success:true,
  order_id,
  amount:PRICE,
  currency:CURRENCY,
  days:DAYS,
  checkout_url:PAYHERE
 });
}


