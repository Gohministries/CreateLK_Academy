/* PAYHERE NOTIFICATION */

async function notify(r,e){

 const f=await r.formData();

 const merchant=String(
  f.get("merchant_id")||""
 );

 const order=String(
  f.get("order_id")||""
 );

 const paymentId=String(
  f.get("payment_id")||""
 );

 const amount=String(
  f.get("payhere_amount")||""
 );

 const currency=String(
  f.get("payhere_currency")||""
 );

 const code=String(
  f.get("status_code")||""
 );

 const sig=String(
  f.get("md5sig")||""
 );

 if(merchant!==MERCHANT_ID){
  return new Response(
   "Invalid merchant",
   {status:400}
  );
 }

 const p=await e.DB.prepare(`
  SELECT
   id,
   user_id,
   amount,
   status
  FROM payments
  WHERE order_id=?
  LIMIT 1
 `).bind(order).first();

 if(!p){
  return new Response(
   "Payment not found",
   {status:404}
  );
 }

 if(
  Number(p.amount).toFixed(2)!==
  Number(amount).toFixed(2)
 ){
  return new Response(
   "Amount mismatch",
   {status:400}
  );
 }

 if(currency!==CURRENCY){
  return new Response(
   "Currency mismatch",
   {status:400}
  );
 }

 const secretHash=(
  await md5(e.PAYHERE_MERCHANT_SECRET)
 ).toUpperCase();

 const expected=(
  await md5(
   merchant+
   order+
   amount+
   currency+
   code+
   secretHash
  )
 ).toUpperCase();

 if(expected!==sig.toUpperCase()){
  return new Response(
   "Invalid signature",
   {status:400}
  );
 }

 /* FAILED / CANCELLED */

 if(code!=="2"){

  await e.DB.prepare(`
   UPDATE payments
   SET
    status=?,
    payhere_payment_id=?
   WHERE id=?
  `).bind(
   paymentStatus(code),
   paymentId||null,
   p.id
  ).run();

  return new Response("OK");
 }

 /* ALREADY PROCESSED */

 if(p.status==="paid"){
  return new Response(
   "Already processed"
  );
 }

 const now=new Date();

 const started=now.toISOString();

 const expires=new Date(
  now.getTime()+
  DAYS*86400000
 ).toISOString();

 /* PAYMENT */

 await e.DB.prepare(`
  UPDATE payments
  SET
   status='paid',
   payhere_payment_id=?,
   paid_at=?
  WHERE id=?
 `).bind(
  paymentId||null,
  started,
  p.id
 ).run();

 /* SUBSCRIPTION */

 await e.DB.prepare(`
  INSERT INTO subscriptions
  (
   user_id,
   status,
   started_at,
   expires_at,
   payhere_reference
  )
  VALUES(?,?,?,?,?)
 `).bind(
  p.user_id,
  "active",
  started,
  expires,
  paymentId||order
 ).run();

 /* REFERRAL */

 const ref=await e.DB.prepare(`
  SELECT
   id,
   referrer_user_id,
   referred_user_id,
   status
  FROM referrals
  WHERE referred_user_id=?
  LIMIT 1
 `).bind(
  p.user_id
 ).first();

 if(ref){

  await e.DB.prepare(`
   UPDATE referrals
   SET
    status='converted',
    converted_at=?
   WHERE id=?
  `).bind(
   started,
   ref.id
  ).run();

  const exists=await e.DB.prepare(`
   SELECT id
   FROM referral_commissions
   WHERE referral_id=?
   LIMIT 1
  `).bind(
   ref.id
  ).first();

  if(!exists){

   const commissionAmount=Number(
    (PRICE*COMMISSION/100).toFixed(2)
   );

   await e.DB.prepare(`
    INSERT INTO referral_commissions
    (
     referral_id,
     referrer_user_id,
     referred_user_id,
     payment_id,
     payment_amount,
     commission_percent,
     commission_amount,
     status,
     created_at
    )
    VALUES(?,?,?,?,?,?,?,?,?)
   `).bind(
    ref.id,
    ref.referrer_user_id,
    ref.referred_user_id,
    p.id,
    PRICE,
    COMMISSION,
    commissionAmount,
    "pending",
    started
   ).run();
  }
 }

 return new Response(
  "Payment processed"
 );
}


/* STATUS */

async function status(r,e){

 const id=new URL(r.url)
  .searchParams
  .get("order_id");

 if(!id){
  return json({
   success:false,
   error:"order_id required"
  },400);
 }

 const p=await e.DB.prepare(`
  SELECT
   id,
   order_id,
   amount,
   currency,
   status,
   payhere_payment_id,
   created_at,
   paid_at
  FROM payments
  WHERE order_id=?
  LIMIT 1
 `).bind(id).first();

 if(!p){
  return json({
   success:false,
   error:"Payment not found"
  },404);
 }

 return json({
  success:true,
  payment:p
 });
}


/* HEALTH */

async function health(e){

 try{

  const t=await e.DB.prepare(`
   SELECT name
   FROM sqlite_master
   WHERE type='table'
   ORDER BY name
  `).all();

  return json({
   success:true,
   database:true,
   price:PRICE,
   days:DAYS,
   commission_percent:COMMISSION,
   commission_per_referral:
    Number(
     (PRICE*COMMISSION/100).toFixed(2)
    ),
   withdrawal_referrals:MIN_REFERRALS,
   tables:t.results||[]
  });

 }catch(x){

  console.error("HEALTH ERROR",x);

  return json({
   success:false,
   database:false,
   error:String(x)
  },500);
 }
}


/* HELPERS */

async function body(r){

 try{
  return await r.json();
 }catch{
  return {};
 }
}


function paymentStatus(c){

 return({
  "0":"pending",
  "-1":"cancelled",
  "-2":"failed",
  "-3":"chargedback"
 })[c]||"pending";
}


function json(x,s=200){

 return new Response(
  JSON.stringify(x),
  {
   status:s,
   headers:{
    ...cors(),
    "content-type":
     "application/json;charset=UTF-8"
   }
  }
 );
}


function cors(){

 return{
  "Access-Control-Allow-Origin":
   "https://createlk.com",

  "Access-Control-Allow-Credentials":
   "true",

  "Access-Control-Allow-Headers":
   "Content-Type",

  "Access-Control-Allow-Methods":
   "GET,POST,OPTIONS"
 };
}


/* MD5 - Cloudflare Workers */

async function md5(text){

 const data=new TextEncoder()
  .encode(text);

 const hash=await crypto.subtle.digest(
  "MD5",
  data
 );

 return Array.from(
  new Uint8Array(hash)
 )
 .map(b=>
  b.toString(16).padStart(2,"0")
 )
 .join("")
 .toUpperCase();
}