/* =========================
   QUESTIONS
========================= */

async function questions(r, e) {

  const id =
    Number(
      new URL(r.url)
        .searchParams
        .get("lesson")
    );

  if (!Number.isInteger(id) || id < 1) {
    return j({
      success: false,
      error: "Invalid lesson."
    }, 400);
  }

  const lesson =
    await e.DB.prepare(`
      SELECT
        id,
        title,
        sort_order
      FROM lessons
      WHERE id=?
      LIMIT 1
    `).bind(id).first();

  if (!lesson) {
    return j({
      success: false,
      error: "Lesson not found."
    }, 404);
  }

  const u =
    await auth(r, e);

  if (!u) {
    return j({
      success: false,
      requiresLogin: true,
      error: "Google login required."
    }, 401);
  }

  if (!await subscription(u.id, e)) {
    return j({
      success: false,
      requiresSubscription: true,
      error: "Active subscription required."
    }, 403);
  }

  const x =
    await e.DB.prepare(`
      SELECT
        id,
        lesson_id,
        question,
        option_a,
        option_b,
        option_c,
        option_d,
        answer,
        explanation,
        question_number
      FROM questions
      WHERE lesson_id=?
      ORDER BY question_number
    `).bind(id).all();

  return j({
    success: true,
    lesson,
    questions:
      (x.results || []).map(q => ({
        id: q.id,
        lesson_id: q.lesson_id,
        question: q.question,
        options: [
          q.option_a,
          q.option_b,
          q.option_c,
          q.option_d
        ],
        answer: +q.answer,
        explanation:
          q.explanation || "",
        question_number:
          +q.question_number
      }))
  });
}


/* =========================
   SUBSCRIPTION
========================= */

async function subscription(id, e) {

  return e.DB.prepare(`
    SELECT
      id,
      status,
      started_at,
      expires_at,
      payhere_reference
    FROM subscriptions
    WHERE user_id=?
      AND status='active'
      AND (
        expires_at IS NULL
        OR expires_at>?
      )
    ORDER BY id DESC
    LIMIT 1
  `).bind(
    id,
    new Date().toISOString()
  ).first();
}


/* =========================
   AUTH
========================= */

async function auth(r, e) {

  const c =
    cookies(
      r.headers.get("Cookie") || ""
    );

  const sessionToken =
    c[SC];

  if (!sessionToken) {
    return null;
  }

  return e.DB.prepare(`
    SELECT
      u.id,
      u.name,
      u.email,
      u.photo_url,
      u.referral_code,
      s.expires_at
    FROM sessions s
    JOIN users u
      ON u.id=s.user_id
    WHERE
      s.session_token_hash=?
      AND s.expires_at>?
    LIMIT 1
  `).bind(
    await sha(sessionToken),
    Math.floor(
      Date.now() / 1000
    )
  ).first();
}


/* =========================
   LOGOUT
========================= */

async function logout(r, e) {

  const c =
    cookies(
      r.headers.get("Cookie") || ""
    );

  if (c[SC]) {

    await e.DB.prepare(`
      DELETE FROM sessions
      WHERE session_token_hash=?
    `).bind(
      await sha(c[SC])
    ).run();
  }

  const h =
    new Headers(cors());

  h.append(
    "Set-Cookie",
    `${SC}=;Max-Age=0;Path=/;HttpOnly;Secure;SameSite=None`
  );

  return new Response(
    JSON.stringify({
      success: true
    }),
    {
      headers: {
        ...Object.fromEntries(h),
        "Content-Type":
          "application/json"
      }
    }
  );
}


/* =========================
   HELPERS
========================= */

function clean(v) {

  v = String(v || "")
    .trim()
    .toUpperCase();

  return /^CL[A-F0-9]{8}$/.test(v)
    ? v
    : null;
}


function token() {

  return (
    crypto.randomUUID()
      .replace(/-/g, "") +
    crypto.randomUUID()
      .replace(/-/g, "")
  );
}


async function sha(v) {

  const h =
    await crypto.subtle.digest(
      "SHA-256",
      new TextEncoder()
        .encode(v)
    );

  return [...new Uint8Array(h)]
    .map(x =>
      x.toString(16)
        .padStart(2, "0")
    )
    .join("");
}


function cookies(s) {

  return Object.fromEntries(
    s.split(";")
      .map(x =>
        x.trim()
          .split("=")
      )
      .filter(x =>
        x.length > 1
      )
      .map(([k, ...v]) => [
        k,
        decodeURIComponent(
          v.join("=")
        )
      ])
  );
}


function cors() {

  return {
    "Access-Control-Allow-Origin":
      SITE,

    "Access-Control-Allow-Credentials":
      "true",

    "Access-Control-Allow-Headers":
      "Content-Type",

    "Access-Control-Allow-Methods":
      "GET,POST,OPTIONS"
  };
}


function j(x, status = 200) {

  return new Response(
    JSON.stringify(x),
    {
      status,
      headers: {
        ...cors(),
        "Content-Type":
          "application/json"
      }
    }
  );
}


function bad(x) {

  const u =
    new URL(
      `${SITE}/Eng/login.html`
    );

  u.searchParams.set(
    "error",
    x
  );

  return Response.redirect(
    u.toString(),
    302
  );
}