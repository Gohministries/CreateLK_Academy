const SITE = "https://createlk.com";
const PAY = "https://eng-payment.createlk.workers.dev";

const GA = "https://accounts.google.com/o/oauth2/v2/auth";
const GT = "https://oauth2.googleapis.com/token";
const GU = "https://openidconnect.googleapis.com/v1/userinfo";

const SC = "english_session";
const GC = "google_state";
const RC = "english_referral";

const SESSION_DAYS = 30;

export default {
  async fetch(r, e) {
    try {
      const u = new URL(r.url);
      const p = u.pathname;

      if (r.method === "OPTIONS") {
        return new Response(null, {
          status: 204,
          headers: cors()
        });
      }

      const routes = {
        "/auth/google": login,
        "/auth/callback": callback,
        "/auth/logout": logout,
        "/api/me": me,
        "/api/referral": referral,
        "/api/payment-start": payment,
        "/api/payment-session": paymentSession,
        "/api/titles": titles,
        "/api/questions": questions,
        "/api/health": health
      };

      const fn = routes[p];

      if (!fn) {
        return j({
          success: false,
          error: "Not found"
        }, 404);
      }

      return await fn(r, e);

    } catch (err) {
      console.error("WORKER ERROR:", err);

      return j({
        success: false,
        error: "Server error"
      }, 500);
    }
  }
};


