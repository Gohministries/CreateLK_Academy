/* =========================
   GOOGLE LOGIN
========================= */

async function login(r, e) {

  if (!e.GOOGLE_CLIENT_ID || !e.GOOGLE_CLIENT_SECRET) {
    return new Response(
      "Google OAuth is not configured.",
      { status: 500 }
    );
  }

  const u = new URL(r.url);
  const state = token();

  const ref = clean(
    u.searchParams.get("ref")
  );

  const g = new URL(GA);

  [
    ["client_id", e.GOOGLE_CLIENT_ID],
    ["redirect_uri", `${u.origin}/auth/callback`],
    ["response_type", "code"],
    ["scope", "openid email profile"],
    ["state", state],
    ["access_type", "online"],
    ["prompt", "select_account"]
  ].forEach(([k, v]) => {
    g.searchParams.set(k, v);
  });

  const h = new Headers({
    Location: g.toString()
  });

  h.append(
    "Set-Cookie",
    `${GC}=${encodeURIComponent(state)};Max-Age=600;Path=/;HttpOnly;Secure;SameSite=Lax`
  );

  if (ref) {
    h.append(
      "Set-Cookie",
      `${RC}=${ref};Max-Age=600;Path=/;HttpOnly;Secure;SameSite=Lax`
    );
  }

  return new Response(null, {
    status: 302,
    headers: h
  });
}


/* =========================
   GOOGLE CALLBACK
========================= */

async function callback(r, e) {

  const u = new URL(r.url);
  const q = u.searchParams;

  if (!q.get("code") || !q.get("state")) {
    return bad("Invalid Google login request.");
  }

  const c = cookies(
    r.headers.get("Cookie") || ""
  );

  const savedState = c[GC];

  if (!savedState) {
    return bad("Login session expired.");
  }

  if (savedState !== q.get("state")) {
    return bad("Invalid login state.");
  }

  const tr = await fetch(GT, {
    method: "POST",
    headers: {
      "Content-Type":
        "application/x-www-form-urlencoded"
    },
    body: new URLSearchParams({
      client_id: e.GOOGLE_CLIENT_ID,
      client_secret: e.GOOGLE_CLIENT_SECRET,
      code: q.get("code"),
      grant_type: "authorization_code",
      redirect_uri:
        `${u.origin}/auth/callback`
    })
  });

  if (!tr.ok) {
    return bad("Google authentication failed.");
  }

  const t = await tr.json();

  if (!t.access_token) {
    return bad("Google access token missing.");
  }

  const ur = await fetch(GU, {
    headers: {
      Authorization:
        `Bearer ${t.access_token}`
    }
  });

  if (!ur.ok) {
    return bad(
      "Unable to retrieve Google account."
    );
  }

  const g = await ur.json();

  if (!g.sub || !g.email) {
    return bad(
      "Google account information is incomplete."
    );
  }

  let user = await e.DB.prepare(`
    SELECT *
    FROM users
    WHERE google_id=?
    LIMIT 1
  `).bind(g.sub).first();

  let fresh = false;

  if (user) {

    await e.DB.prepare(`
      UPDATE users
      SET name=?, email=?, photo_url=?
      WHERE google_id=?
    `).bind(
      g.name || "",
      g.email,
      g.picture || "",
      g.sub
    ).run();

  } else {

    user = await e.DB.prepare(`
      SELECT *
      FROM users
      WHERE email=?
      LIMIT 1
    `).bind(g.email).first();

    if (user) {

      await e.DB.prepare(`
        UPDATE users
        SET google_id=?, name=?, photo_url=?
        WHERE email=?
      `).bind(
        g.sub,
        g.name || "",
        g.picture || "",
        g.email
      ).run();

    } else {

      fresh = true;

      const referralCode =
        await newCode(e);

      await e.DB.prepare(`
        INSERT INTO users
        (
          google_id,
          name,
          email,
          photo_url,
          referral_code
        )
        VALUES (?,?,?,?,?)
      `).bind(
        g.sub,
        g.name || "",
        g.email,
        g.picture || "",
        referralCode
      ).run();
    }
  }

  user = await e.DB.prepare(`
    SELECT *
    FROM users
    WHERE google_id=?
    LIMIT 1
  `).bind(g.sub).first();

  if (!user) {
    return bad(
      "Unable to create your account."
    );
  }

  if (!user.referral_code) {

    const code =
      await newCode(e);

    await e.DB.prepare(`
      UPDATE users
      SET referral_code=?
      WHERE id=?
    `).bind(
      code,
      user.id
    ).run();

    user.referral_code = code;
  }

  const rc = clean(c[RC]);

  if (fresh && rc) {
    await addReferral(
      e,
      user.id,
      rc
    );
  }

  /* 30-DAY SESSION */

  const sessionToken = token();
  const sessionHash =
    await sha(sessionToken);

  const expires =
    Math.floor(Date.now() / 1000)
    + SESSION_DAYS * 86400;

  await e.DB.prepare(`
    DELETE FROM sessions
    WHERE user_id=?
  `).bind(user.id).run();

  await e.DB.prepare(`
    INSERT INTO sessions
    (
      session_token_hash,
      user_id,
      expires_at
    )
    VALUES (?,?,?)
  `).bind(
    sessionHash,
    user.id,
    expires
  ).run();

  const h = new Headers({
    Location:
      `${SITE}/Eng/quiz.html`
  });

  h.append(
    "Set-Cookie",
    `${SC}=${sessionToken};Max-Age=${SESSION_DAYS * 86400};Path=/;HttpOnly;Secure;SameSite=None`
  );

  h.append(
    "Set-Cookie",
    `${GC}=;Max-Age=0;Path=/;HttpOnly;Secure;SameSite=Lax`
  );

  h.append(
    "Set-Cookie",
    `${RC}=;Max-Age=0;Path=/;HttpOnly;Secure;SameSite=Lax`
  );

  return new Response(null, {
    status: 302,
    headers: h
  });
}


/* =========================
   REFERRAL
========================= */

async function addReferral(e, userId, code) {

  const referrer =
    await e.DB.prepare(`
      SELECT id
      FROM users
      WHERE referral_code=?
      LIMIT 1
    `).bind(code).first();

  if (!referrer) return;

  if (+referrer.id === +userId) {
    return;
  }

  const existing =
    await e.DB.prepare(`
      SELECT id
      FROM referrals
      WHERE referred_user_id=?
      LIMIT 1
    `).bind(userId).first();

  if (existing) return;

  await e.DB.prepare(`
    INSERT INTO referrals
    (
      referrer_user_id,
      referred_user_id,
      referral_code,
      status,
      created_at
    )
    VALUES (?,?,?,'registered',?)
  `).bind(
    referrer.id,
    userId,
    code,
    new Date().toISOString()
  ).run();
}


async function newCode(e) {

  for (let i = 0; i < 10; i++) {

    const code =
      "CL" +
      crypto.randomUUID()
        .replace(/-/g, "")
        .slice(0, 8)
        .toUpperCase();

    const exists =
      await e.DB.prepare(`
        SELECT id
        FROM users
        WHERE referral_code=?
        LIMIT 1
      `).bind(code).first();

    if (!exists) {
      return code;
    }
  }

  throw new Error(
    "Could not create referral code."
  );
}


async function referral(r, e) {

  const u = await auth(r, e);

  if (!u) {
    return j({
      success: false,
      error: "Login required."
    }, 401);
  }

  const user =
    await e.DB.prepare(`
      SELECT referral_code
      FROM users
      WHERE id=?
    `).bind(u.id).first();

  const count =
    await e.DB.prepare(`
      SELECT COUNT(*) total
      FROM referrals
      WHERE referrer_user_id=?
    `).bind(u.id).first();

  return j({
    success: true,
    referralCode:
      user?.referral_code || null,
    referralLink:
      user?.referral_code
        ? `${SITE}/Eng/login.html?ref=${user.referral_code}`
        : null,
    registered:
      +(count?.total || 0)
  });
}


/* =========================
   API ME
========================= */

async function me(r, e) {

  try {

    const u = await auth(r, e);

    if (!u) {
      return j({
        success: true,
        loggedIn: false,
        user: null,
        subscription: null
      });
    }

    const s =
      await subscription(
        u.id,
        e
      );

    return j({
      success: true,

      loggedIn: true,

      user: {
        id: u.id,
        name: u.name,
        email: u.email,
        photo_url: u.photo_url
      },

      subscription:
        s
          ? {
              active: true,
              expires_at:
                s.expires_at
            }
          : {
              active: false
            }
    });

  } catch (err) {

    console.error(
      "ME ERROR:",
      err
    );

    return j({
      success: false,
      error: String(err)
    }, 500);
  }
}


/* =========================
   PAYMENT START
========================= */

async function payment(r, e) {

  const u = await auth(r, e);

  if (!u) {
    return Response.redirect(
      `${SITE}/Eng/login.html?next=/Eng/quiz.html`,
      302
    );
  }

  if (await subscription(u.id, e)) {
    return Response.redirect(
      `${SITE}/Eng/quiz.html`,
      302
    );
  }

  const t = token();

  const now =
    new Date();

  const expires =
    new Date(
      now.getTime() + 10 * 60000
    );

  await e.DB.prepare(`
    INSERT INTO payment_handoffs
    (
      token,
      user_id,
      expires_at,
      created_at
    )
    VALUES (?,?,?,?)
  `).bind(
    t,
    u.id,
    expires.toISOString(),
    now.toISOString()
  ).run();

  const x =
    new URL(PAY);

  x.searchParams.set(
    "token",
    t
  );

  return Response.redirect(
    x.toString(),
    302
  );
}


/* =========================
   PAYMENT SESSION
========================= */

async function paymentSession(r, e) {

  const t =
    new URL(r.url)
      .searchParams
      .get("token");

  if (!t) {
    return j({
      success: false,
      error: "Missing payment token."
    }, 400);
  }

  const h =
    await e.DB.prepare(`
      SELECT user_id,expires_at
      FROM payment_handoffs
      WHERE token=?
      LIMIT 1
    `).bind(t).first();

  if (!h) {
    return j({
      success: false,
      error: "Invalid payment session."
    }, 401);
  }

  if (
    new Date(h.expires_at)
      <= new Date()
  ) {
    return j({
      success: false,
      error: "Payment session expired."
    }, 401);
  }

  const u =
    await e.DB.prepare(`
      SELECT
        id,
        name,
        email,
        photo_url
      FROM users
      WHERE id=?
      LIMIT 1
    `).bind(h.user_id).first();

  if (!u) {
    return j({
      success: false,
      error: "User not found."
    }, 404);
  }

  return j({
    success: true,
    user: u
  });
}


