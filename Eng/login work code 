const SITE="https://createlk.com";
const PAY="https://eng-payment.createlk.workers.dev";
const GA="https://accounts.google.com/o/oauth2/v2/auth";
const GT="https://oauth2.googleapis.com/token";
const GU="https://openidconnect.googleapis.com/v1/userinfo";
const SC="english_session",GC="google_state",RC="english_referral";

export default{async fetch(r,e){
 try{
  const u=new URL(r.url),p=u.pathname;
  if(r.method==="OPTIONS")
   return new Response(null,{status:204,headers:cors()});

  const f={
   "/auth/google":login,
   "/auth/callback":callback,
   "/auth/logout":logout,
   "/api/me":me,
   "/api/referral":referral,
   "/api/payment-start":payment,
   "/api/payment-session":paymentSession,
   "/api/titles":titles,
   "/api/questions":questions,
   "/api/health":()=>j({success:true,status:"online"})
  }[p];

  return f?await f(r,e):j({success:false,error:"Not found"},404);
 }catch(x){
  console.error(x);
  return j({success:false,error:"Server error"},500);
 }
}};

async function login(r,e){
 if(!e.GOOGLE_CLIENT_ID||!e.GOOGLE_CLIENT_SECRET)
  return new Response("Google OAuth is not configured.",{status:500});

 const u=new URL(r.url),s=token();
 const ref=clean(u.searchParams.get("ref"));

 const g=new URL(GA);

 [
  ["client_id",e.GOOGLE_CLIENT_ID],
  ["redirect_uri",`${u.origin}/auth/callback`],
  ["response_type","code"],
  ["scope","openid email profile"],
  ["state",s],
  ["access_type","online"],
  ["prompt","select_account"]
 ].forEach(x=>g.searchParams.set(...x));

 const h=new Headers({Location:g});

 h.append(
  "Set-Cookie",
  `${GC}=${encodeURIComponent(s)};Max-Age=600;Path=/;HttpOnly;Secure;SameSite=Lax`
 );

 if(ref)
  h.append(
   "Set-Cookie",
   `${RC}=${ref};Max-Age=600;Path=/;HttpOnly;Secure;SameSite=Lax`
  );

 return new Response(null,{status:302,headers:h});
}

async function callback(r,e){
 const u=new URL(r.url),q=u.searchParams;

 if(!q.get("code")||!q.get("state"))
  return bad("Invalid Google login request.");

 const c=cookies(r.headers.get("Cookie")||"");
 const st=c[GC];

 if(!st)
  return bad("Login session expired.");

 if(st!==q.get("state"))
  return bad("Invalid login state.");

 const tr=await fetch(GT,{
  method:"POST",
  headers:{"Content-Type":"application/x-www-form-urlencoded"},
  body:new URLSearchParams({
   client_id:e.GOOGLE_CLIENT_ID,
   client_secret:e.GOOGLE_CLIENT_SECRET,
   code:q.get("code"),
   grant_type:"authorization_code",
   redirect_uri:`${u.origin}/auth/callback`
  })
 });

 if(!tr.ok)
  return bad("Google authentication failed.");

 const t=await tr.json();

 if(!t.access_token)
  return bad("Google access token missing.");

 const ur=await fetch(GU,{
  headers:{Authorization:`Bearer ${t.access_token}`}
 });

 if(!ur.ok)
  return bad("Unable to retrieve Google account.");

 const g=await ur.json();

 if(!g.sub||!g.email)
  return bad("Google account information is incomplete.");

 let user=await e.DB.prepare(
  "SELECT * FROM users WHERE google_id=? LIMIT 1"
 ).bind(g.sub).first();

 let fresh=false;

 if(user){

  await e.DB.prepare(
   "UPDATE users SET name=?,email=?,photo_url=? WHERE google_id=?"
  ).bind(
   g.name||"",
   g.email,
   g.picture||"",
   g.sub
  ).run();

 }else{

  user=await e.DB.prepare(
   "SELECT * FROM users WHERE email=? LIMIT 1"
  ).bind(g.email).first();

  if(user){

   await e.DB.prepare(
    "UPDATE users SET google_id=?,name=?,photo_url=? WHERE email=?"
   ).bind(
    g.sub,
    g.name||"",
    g.picture||"",
    g.email
   ).run();

  }else{

   fresh=true;

   await e.DB.prepare(`
    INSERT INTO users
    (google_id,name,email,photo_url,referral_code)
    VALUES(?,?,?,?,?)
   `).bind(
    g.sub,
    g.name||"",
    g.email,
    g.picture||"",
    await newCode(e)
   ).run();
  }
 }

 user=await e.DB.prepare(
  "SELECT * FROM users WHERE google_id=? LIMIT 1"
 ).bind(g.sub).first();

 if(!user)
  return bad("Unable to create your account.");

 if(!user.referral_code){

  const code=await newCode(e);

  await e.DB.prepare(
   "UPDATE users SET referral_code=? WHERE id=?"
  ).bind(code,user.id).run();

  user.referral_code=code;
 }

 const rc=clean(c[RC]);

 if(fresh&&rc)
  await addReferral(e,user.id,rc);

 /*
  * 30-DAY LOGIN SESSION
  */
 const stoken=token();
 const hash=await sha(stoken);
 const days=30;

 await e.DB.prepare(
  "DELETE FROM sessions WHERE user_id=?"
 ).bind(user.id).run();

 await e.DB.prepare(`
  INSERT INTO sessions
  (session_token_hash,user_id,expires_at)
  VALUES(?,?,?)
 `).bind(
  hash,
  user.id,
  Math.floor(Date.now()/1000)+days*86400
 ).run();

 const h=new Headers({
  Location:`${SITE}/Eng/quiz.html`
 });

 h.append(
  "Set-Cookie",
  `${SC}=${stoken};Max-Age=${days*86400};Path=/;HttpOnly;Secure;SameSite=None`
 );

 h.append(
  "Set-Cookie",
  `${GC}=;Max-Age=0;Path=/;HttpOnly;Secure;SameSite=Lax`
 );

 h.append(
  "Set-Cookie",
  `${RC}=;Max-Age=0;Path=/;HttpOnly;Secure;SameSite=Lax`
 );

 return new Response(null,{status:302,headers:h});
}

async function addReferral(e,uid,code){

 const r=await e.DB.prepare(
  "SELECT id FROM users WHERE referral_code=? LIMIT 1"
 ).bind(code).first();

 if(!r||+r.id===+uid)
  return;

 const exists=await e.DB.prepare(
  "SELECT id FROM referrals WHERE referred_user_id=? LIMIT 1"
 ).bind(uid).first();

 if(exists)
  return;

 await e.DB.prepare(`
  INSERT INTO referrals
  (referrer_user_id,referred_user_id,referral_code,status,created_at)
  VALUES(?,?,?,'registered',?)
 `).bind(
  r.id,
  uid,
  code,
  new Date().toISOString()
 ).run();
}

async function newCode(e){

 for(let i=0;i<10;i++){

  const c=
   "CL"+
   crypto.randomUUID()
    .replace(/-/g,"")
    .slice(0,8)
    .toUpperCase();

  if(!await e.DB.prepare(
   "SELECT id FROM users WHERE referral_code=? LIMIT 1"
  ).bind(c).first())
   return c;
 }

 throw Error("Could not create referral code.");
}

async function referral(r,e){

 const u=await auth(r,e);

 if(!u)
  return j({
   success:false,
   error:"Login required."
  },401);

 const x=await e.DB.prepare(
  "SELECT referral_code FROM users WHERE id=?"
 ).bind(u.id).first();

 const n=await e.DB.prepare(
  "SELECT COUNT(*) total FROM referrals WHERE referrer_user_id=?"
 ).bind(u.id).first();

 return j({
  success:true,
  referralCode:x?.referral_code||null,
  referralLink:x?.referral_code
   ?`${SITE}/Eng/login.html?ref=${x.referral_code}`
   :null,
  registered:+(n?.total||0)
 });
}

async function me(r,e){

 const u=await auth(r,e);

 if(!u)
  return j({loggedIn:false});

 const s=await subscription(u.id,e);

 return j({
  loggedIn:true,
  user:{
   id:u.id,
   name:u.name,
   email:u.email,
   photo_url:u.photo_url
  },
  subscription:s
   ?{
     active:true,
     expires_at:s.expires_at
    }
   :{
     active:false
    }
 });
}

async function payment(r,e){

 const u=await auth(r,e);

 if(!u)
  return Response.redirect(
   `${SITE}/Eng/login.html?next=/Eng/quiz.html`,
   302
  );

 if(await subscription(u.id,e))
  return Response.redirect(
   `${SITE}/Eng/quiz.html`,
   302
  );

 const t=token();
 const now=new Date();
 const exp=new Date(
  now.getTime()+10*60000
 );

 await e.DB.prepare(`
  INSERT INTO payment_handoffs
  (token,user_id,expires_at,created_at)
  VALUES(?,?,?,?)
 `).bind(
  t,
  u.id,
  exp.toISOString(),
  now.toISOString()
 ).run();

 const x=new URL(PAY);
 x.searchParams.set("token",t);

 return Response.redirect(
  x.toString(),
  302
 );
}

async function paymentSession(r,e){

 const t=new URL(r.url)
  .searchParams
  .get("token");

 if(!t)
  return j({
   success:false,
   error:"Missing payment token."
  },400);

 const h=await e.DB.prepare(`
  SELECT user_id,expires_at
  FROM payment_handoffs
  WHERE token=?
  LIMIT 1
 `).bind(t).first();

 if(!h)
  return j({
   success:false,
   error:"Invalid payment session."
  },401);

 if(new Date(h.expires_at)<=new Date())
  return j({
   success:false,
   error:"Payment session expired."
  },401);

 const u=await e.DB.prepare(`
  SELECT id,name,email,photo_url
  FROM users
  WHERE id=?
  LIMIT 1
 `).bind(h.user_id).first();

 if(!u)
  return j({
   success:false,
   error:"User not found."
  },404);

 return j({
  success:true,
  user:u
 });
}

async function titles(e){

 const x=await e.DB.prepare(`
  SELECT id,title,sort_order
  FROM lessons
  ORDER BY sort_order
 `).all();

 return j({
  success:true,
  lessons:x.results||[]
 });
}

async function questions(r,e){

 const id=Number(
  new URL(r.url)
   .searchParams
   .get("lesson")
 );

 if(!Number.isInteger(id)||id<1)
  return j({
   success:false,
   error:"Invalid lesson."
  },400);

 const lesson=await e.DB.prepare(`
  SELECT id,title,sort_order
  FROM lessons
  WHERE id=?
  LIMIT 1
 `).bind(id).first();

 if(!lesson)
  return j({
   success:false,
   error:"Lesson not found."
  },404);

 const u=await auth(r,e);

 if(!u)
  return j({
   success:false,
   requiresLogin:true,
   error:"Google login required."
  },401);

 if(!await subscription(u.id,e))
  return j({
   success:false,
   requiresSubscription:true,
   error:"Active subscription required."
  },403);

 const x=await e.DB.prepare(`
  SELECT
   id,
   lesson_id,
   question,
   option_a,
   option_b,
   option_c,
   option_d,
   answer,
   explanation,
   question_number
  FROM questions
  WHERE lesson_id=?
  ORDER BY question_number
 `).bind(id).all();

 return j({
  success:true,
  lesson,
  questions:(x.results||[]).map(q=>({
   id:q.id,
   lesson_id:q.lesson_id,
   question:q.question,
   options:[
    q.option_a,
    q.option_b,
    q.option_c,
    q.option_d
   ],
   answer:+q.answer,
   explanation:q.explanation||"",
   question_number:+q.question_number
  }))
 });
}

async function subscription(id,e){

 return e.DB.prepare(`
  SELECT
   id,
   status,
   started_at,
   expires_at,
   payhere_reference
  FROM subscriptions
  WHERE user_id=?
   AND status='active'
   AND (
    expires_at IS NULL
    OR expires_at>?
   )
  ORDER BY id DESC
  LIMIT 1
 `).bind(
  id,
  new Date().toISOString()
 ).first();
}

async function auth(r,e){

 const c=cookies(
  r.headers.get("Cookie")||""
 );

 const t=c[SC];

 if(!t)
  return null;

 return e.DB.prepare(`
  SELECT
   u.id,
   u.name,
   u.email,
   u.photo_url,
   s.expires_at
  FROM sessions s
  JOIN users u
   ON u.id=s.user_id
  WHERE
   s.session_token_hash=?
   AND s.expires_at>?
  LIMIT 1
 `).bind(
  await sha(t),
  Math.floor(Date.now()/1000)
 ).first();
}

async function logout(r,e){

 const c=cookies(
  r.headers.get("Cookie")||""
 );

 if(c[SC])
  await e.DB.prepare(
   "DELETE FROM sessions WHERE session_token_hash=?"
  ).bind(
   await sha(c[SC])
  ).run();

 const h=new Headers(cors());

 h.append(
  "Set-Cookie",
  `${SC}=;Max-Age=0;Path=/;HttpOnly;Secure;SameSite=None`
 );

 return new Response(
  JSON.stringify({success:true}),
  {
   headers:{
    ...Object.fromEntries(h),
    "Content-Type":"application/json"
   }
  }
 );
}

function clean(v){

 v=String(v||"")
  .trim()
  .toUpperCase();

 return /^CL[A-F0-9]{8}$/.test(v)
  ?v
  :null;
}

function token(){

 return crypto.randomUUID()
  .replace(/-/g,"")+
  crypto.randomUUID()
  .replace(/-/g,"");
}

async function sha(v){

 const h=await crypto.subtle.digest(
  "SHA-256",
  new TextEncoder().encode(v)
 );

 return [...new Uint8Array(h)]
  .map(x=>x.toString(16).padStart(2,"0"))
  .join("");
}

function cookies(s){

 return Object.fromEntries(
  s.split(";")
   .map(x=>x.trim().split("="))
   .filter(x=>x.length>1)
   .map(([k,...v])=>[
    k,
    decodeURIComponent(v.join("="))
   ])
 );
}

function cors(){

 return {
  "Access-Control-Allow-Origin":SITE,
  "Access-Control-Allow-Credentials":"true",
  "Access-Control-Allow-Headers":"Content-Type",
  "Access-Control-Allow-Methods":"GET,POST,OPTIONS"
 };
}

function j(x,status=200){

 return new Response(
  JSON.stringify(x),
  {
   status,
   headers:{
    ...cors(),
    "Content-Type":"application/json"
   }
  }
 );
}

function bad(x){

 const u=new URL(
  `${SITE}/Eng/login.html`
 );

 u.searchParams.set("error",x);

 return Response.redirect(
  u.toString(),
  302
 );
}