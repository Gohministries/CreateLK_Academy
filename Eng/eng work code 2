async function ensureRewards(e,id){
await e.DB.prepare(
"INSERT OR IGNORE INTO user_rewards(user_id,coins,xp,updated_at)VALUES(?,?,?,?)"
).bind(id,0,0,new Date().toISOString()).run();
}

async function rewards(e,id){
await ensureRewards(e,id);
const x=await e.DB.prepare(
"SELECT coins,xp FROM user_rewards WHERE user_id=?"
).bind(id).first();
return{coins:Number(x?.coins||0),xp:Number(x?.xp||0)};
}

async function addRewards(e,id,coins,xp){
await ensureRewards(e,id);
await e.DB.prepare(
"UPDATE user_rewards SET coins=COALESCE(coins,0)+?,xp=COALESCE(xp,0)+?,updated_at=? WHERE user_id=?"
).bind(Number(coins)||0,Number(xp)||0,new Date().toISOString(),id).run();
return rewards(e,id);
}

async function titles(r,e){
const x=await e.DB.prepare(
"SELECT id,title,access_type FROM lessons WHERE active=1 ORDER BY id"
).all();
return json({success:true,lessons:x.results||[]});
}

async function lesson(e,id){
return e.DB.prepare(
"SELECT id,title,access_type FROM lessons WHERE id=? AND active=1 LIMIT 1"
).bind(id).first();
}

function free(id,l){
return id===1||String(l?.access_type||"").toUpperCase()==="FREE";
}

async function questions(r,e){
const id=Number(new URL(r.url).searchParams.get("lesson_id"));
if(!id)return json({success:false,error:"Invalid lesson_id"},400);

const l=await lesson(e,id);
if(!l)return json({success:false,error:"Lesson not found"},404);

const u=await currentUser(r,e);
const ok=free(id,l)||(u&&(await premium(e,u.id)).premium);

if(!ok)return json({
success:false,error:"Premium required",premium_required:true
},403);

const x=await e.DB.prepare(
"SELECT id,lesson_id,question,option_a,option_b,option_c,option_d FROM questions WHERE lesson_id=? AND active=1 ORDER BY id LIMIT 50"
).bind(id).all();

return json({success:true,lesson:l,questions:x.results||[]});
}

/* ONLY COMPLETED SUBMISSIONS COUNT */
async function attempts(e,uid,lid){
const since=new Date(Date.now()-ATTEMPT_DAYS*86400000).toISOString();

const x=await e.DB.prepare(
"SELECT COUNT(*) count FROM quiz_attempts WHERE user_id=? AND lesson_id=? AND completed_at IS NOT NULL AND completed_at>=?"
).bind(uid,lid,since).first();

const used=Number(x?.count||0);
let reset=null;

if(used>=MAX_ATTEMPTS){
const o=await e.DB.prepare(
"SELECT MIN(completed_at) completed_at FROM quiz_attempts WHERE user_id=? AND lesson_id=? AND completed_at IS NOT NULL AND completed_at>=?"
).bind(uid,lid,since).first();

if(o?.completed_at)
reset=new Date(new Date(o.completed_at).getTime()+ATTEMPT_DAYS*86400000).toISOString();
}

return{
used,
remaining:Math.max(0,MAX_ATTEMPTS-used),
reset_at:reset
};
}

/* ONE ACTIVE QUIZ ONLY */
async function startQuiz(r,e){
if(r.method!=="POST")return json({success:false,error:"POST required"},405);

const u=await currentUser(r,e),b=await body(r);

if(!u)return json({success:false,error:"Login required"},401);
if(!b)return json({success:false,error:"Invalid JSON"},400);

const lid=Number(b.lesson_id);
if(!lid)return json({success:false,error:"Invalid lesson_id"},400);

const l=await lesson(e,lid);
if(!l)return json({success:false,error:"Lesson not found"},404);

if(!free(lid,l)&&!(await premium(e,u.id)).premium)
return json({success:false,error:"Premium required",premium_required:true},403);

/* BLOCK RESTART */
const active=await e.DB.prepare(
"SELECT id,created_at FROM quiz_attempts WHERE user_id=? AND lesson_id=? AND completed_at IS NULL ORDER BY created_at DESC LIMIT 1"
).bind(u.id,lid).first();

if(active)return json({
success:false,
error:"You already started this quiz. Please complete and submit the current quiz before starting again.",
quiz_in_progress:true,
attempt_id:active.id,
started_at:active.created_at
},409);

/* 3 SUBMISSIONS / 30 DAYS */
const a=await attempts(e,u.id,lid);

if(a.used>=MAX_ATTEMPTS)return json({
success:false,
error:"You have reached the maximum of 3 quiz submissions. You can try again after the 30-day period.",
max_attempts:true,
attempts_used:a.used,
attempts_remaining:0,
reset_at:a.reset_at
},403);

const id=crypto.randomUUID();

await e.DB.prepare(
"INSERT INTO quiz_attempts(id,user_id,lesson_id,created_at)VALUES(?,?,?,?)"
).bind(id,u.id,lid,new Date().toISOString()).run();

return json({
success:true,
attempt_id:id,
lesson_id:lid,
attempt_number:a.used+1,
max_attempts:MAX_ATTEMPTS,
attempts_used:a.used,
attempts_remaining:MAX_ATTEMPTS-a.used
});
}

/* CHECK = NO REWARD */
async function checkAnswer(r,e){
if(r.method!=="POST")return json({success:false,error:"POST required"},405);

const u=await currentUser(r,e),b=await body(r);
if(!u)return json({success:false,error:"Login required"},401);
if(!b)return json({success:false,error:"Invalid JSON"},400);

const qid=Number(b.question_id),ans=normalize(b.answer),aid=clean(b.attempt_id);

if(!qid||!ans||!aid)return json({success:false,error:"Invalid answer"},400);

const a=await e.DB.prepare(
"SELECT id,lesson_id,completed_at FROM quiz_attempts WHERE id=? AND user_id=? LIMIT 1"
).bind(aid,u.id).first();

if(!a)return json({success:false,error:"Invalid quiz attempt"},403);
if(a.completed_at)return json({success:false,error:"Quiz already submitted"},400);

const q=await e.DB.prepare(
"SELECT id,lesson_id,correct_answer,option_a,option_b,option_c,option_d FROM questions WHERE id=? AND active=1 LIMIT 1"
).bind(qid).first();

if(!q)return json({success:false,error:"Question not found"},404);

if(Number(q.lesson_id)!==Number(a.lesson_id))
return json({success:false,error:"Question does not belong to this quiz."},400);

const l=await lesson(e,q.lesson_id);
if(!l)return json({success:false,error:"Lesson not found"},404);

if(!free(q.lesson_id,l)&&!(await premium(e,u.id)).premium)
return json({success:false,error:"Premium required",premium_required:true},403);

const ca=normalize(q.correct_answer),correct=ans===ca;
const options={a:q.option_a,b:q.option_b,c:q.option_c,d:q.option_d};

return json({
success:true,
correct,
question_id:qid,
answer:ans,
selected_answer:ans,
rewarded:false,
reward_coins:0,
reward_xp:0,
...(correct?{}:{
correct_answer:ca,
correct_text:options[ca]||""
})
});
}

/* SUBMIT = REWARD HERE */
async function submitQuiz(r,e){
if(r.method!=="POST")return json({success:false,error:"POST required"},405);

const u=await currentUser(r,e),b=await body(r);

if(!u)return json({success:false,error:"Login required"},401);
if(!b)return json({success:false,error:"Invalid JSON"},400);

const lid=Number(b.lesson_id),aid=clean(b.attempt_id);
const answers=Array.isArray(b.answers)?b.answers:[];

if(!lid||!aid||answers.length>50)
return json({success:false,error:"Invalid quiz data"},400);

const a=await e.DB.prepare(
"SELECT id,lesson_id,completed_at FROM quiz_attempts WHERE id=? AND user_id=? LIMIT 1"
).bind(aid,u.id).first();

if(!a)return json({success:false,error:"Quiz attempt not found"},404);

if(Number(a.lesson_id)!==lid)
return json({success:false,error:"Invalid lesson"},400);

if(a.completed_at)
return json({success:false,error:"Quiz already submitted"},400);

const l=await lesson(e,lid);
if(!l)return json({success:false,error:"Lesson not found"},404);

if(!free(lid,l)&&!(await premium(e,u.id)).premium)
return json({success:false,error:"Premium required",premium_required:true},403);

const x=await e.DB.prepare(
"SELECT id,correct_answer FROM questions WHERE lesson_id=? AND active=1 ORDER BY id LIMIT 50"
).bind(lid).all();

const rows=x.results||[];
if(!rows.length)return json({success:false,error:"No questions found"},404);

const map=new Map();

for(const v of answers){
const id=Number(v?.question_id),ans=normalize(v?.answer);
if(id&&ans)map.set(id,ans);
}

let score=0;

for(const q of rows){
if(map.get(Number(q.id))===normalize(q.correct_answer))score++;
}

const total=rows.length;
const pct=Math.round(score/total*100);
const rewardCoins=score*COINS;
const rewardXP=score*XP;
const now=new Date().toISOString();

/* SAVE RESULT FIRST */
await e.DB.prepare(
"INSERT INTO quiz_results(user_id,lesson_id,score,total,percentage,completed_at)VALUES(?,?,?,?,?,?)"
).bind(u.id,lid,score,total,pct,now).run();

/* MARK ATTEMPT COMPLETED */
await e.DB.prepare(
"UPDATE quiz_attempts SET completed_at=? WHERE id=? AND user_id=?"
).bind(now,aid,u.id).run();

/* ADD COINS + XP ONLY NOW */
const z=await addRewards(e,u.id,rewardCoins,rewardXP);
const a2=await attempts(e,u.id,lid);

return json({
success:true,
lesson_id:lid,
lesson_title:l.title,
score,
total,
percentage:pct,
reward_coins:rewardCoins,
reward_xp:rewardXP,
rewarded:true,
coins_per_correct:COINS,
xp_per_correct:XP,
total_coins:z.coins,
total_xp:z.xp,
attempts_used:a2.used,
attempts_remaining:a2.remaining,
attempts_reset_at:a2.remaining?null:a2.reset_at,
completed_at:now
});
}

