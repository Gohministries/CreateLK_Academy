const SITE="https://createlk.com",PREMIUM="https://premium.createlk.workers.dev",PAY="https://pay.createlk.workers.dev";
const SESSION="english_session",STATE="google_state",GA="https://accounts.google.com/o/oauth2/v2/auth",GT="https://oauth2.googleapis.com/token",GU="https://openidconnect.googleapis.com/v1/userinfo";
const DAYS=30,MAX=3,COINS=5,XP=10,API="ENGLISH-2026-10-03-14";

export default{async fetch(r,e){
try{
let p=new URL(r.url).pathname;
if(r.method==="OPTIONS")return cors(new Response(null,{status:204}));
let f={
"/auth/google":google,"/auth/callback":callback,"/auth/logout":logout,
"/api/me":me,"/api/referral":referral,"/api/titles":titles,
"/api/questions":questions,"/api/quiz/start":quizStart,
"/api/quiz/check":quizCheck,"/api/quiz/submit":quizSubmit,
"/api/leaderboard":leaderboard,"/api/leaderboard/me":leaderMe,
"/api/payment/start":payment
}[p];
if(f)return f(r,e);
if(p==="/api/health")return J({success:true,message:"English API is running",version:API});
return J({success:false,error:"Not found"},404);
}catch(x){
console.error(x);
return J({success:false,error:"Server error"},500);
}
}};

/* AUTH */
async function google(r,e){
let u=new URL(r.url),ref=s(u.searchParams.get("ref")),st=tok(32);
let d=btoa(JSON.stringify({state:st,referral:ref,exp:Date.now()+600000}));
let q=new URLSearchParams({
client_id:e.GOOGLE_CLIENT_ID,
redirect_uri:e.GOOGLE_REDIRECT_URI,
response_type:"code",
scope:"openid email profile",
state:d
});
return R(`${GA}?${q}`,`${STATE}=${st};Path=/;HttpOnly;Secure;SameSite=None;Max-Age=600`);
}

async function callback(r,e){
let u=new URL(r.url),code=u.searchParams.get("code"),raw=u.searchParams.get("state"),c=cookies(r);
if(!code||!raw)return new Response("Invalid login",{status:400});

let st;
try{st=JSON.parse(atob(raw))}
catch{return new Response("Invalid state",{status:400})}

if(!st.state||st.exp<Date.now()||c[STATE]!==st.state)
return new Response("Expired login",{status:400});

let t=await fetch(GT,{
method:"POST",
headers:{"Content-Type":"application/x-www-form-urlencoded"},
body:new URLSearchParams({
client_id:e.GOOGLE_CLIENT_ID,
client_secret:e.GOOGLE_CLIENT_SECRET,
code,
grant_type:"authorization_code",
redirect_uri:e.GOOGLE_REDIRECT_URI
})
});

let td=await t.json();
if(!td.access_token)return new Response("Google authentication failed",{status:400});

let g=await(await fetch(GU,{
headers:{Authorization:`Bearer ${td.access_token}`}
})).json();

if(!g.sub||!g.email)return new Response("Google account error",{status:400});

let gid=s(g.sub),email=s(g.email),name=s(g.name)||email.split("@")[0],pic=s(g.picture);

let u1=await e.DB.prepare(
"SELECT * FROM users WHERE google_id=? OR email=? LIMIT 1"
).bind(gid,email).first();

if(u1){
await e.DB.prepare(
"UPDATE users SET google_id=?,name=?,email=?,picture=?,last_active_at=? WHERE id=?"
).bind(gid,name,email,pic,Date.now(),u1.id).run();
}else{
let x=await e.DB.prepare(
"INSERT INTO users(google_id,name,email,membership_status,auth_provider,picture,last_active_at)VALUES(?,?,?,'FREE','google',?,?)"
).bind(gid,name,email,pic,Date.now()).run();

u1=await e.DB.prepare(
"SELECT * FROM users WHERE id=?"
).bind(x.meta.last_row_id).first();
}

await rewardInit(e,u1.id);

if(st.referral)await makeReferral(e,u1.id,st.referral);

let session=tok(48);

await e.DB.prepare(
"INSERT INTO sessions(user_id,token_hash,expires_at)VALUES(?,?,?)"
).bind(
u1.id,
await hash(session),
new Date(Date.now()+DAYS*864e5).toISOString()
).run();

return R(
`${SITE}/Eng/`,
`${SESSION}=${session};Path=/;HttpOnly;Secure;SameSite=None;Max-Age=${DAYS*86400}`
);
}

async function user(r,e){
let x=cookies(r)[SESSION];
return x?e.DB.prepare(
"SELECT u.* FROM sessions s JOIN users u ON u.id=s.user_id WHERE s.token_hash=? AND s.expires_at>?"
).bind(
await hash(x),
new Date().toISOString()
).first():null;
}

async function me(r,e){
let u=await user(r,e);

if(!u)return J({
success:true,
logged_in:false,
user:null,
premium:false
});

let [z,p]=await Promise.all([
rewards(e,u.id),
premium(e,u.id)
]);

return J({
success:true,
logged_in:true,
premium:p.premium,
membership_expiry:p.expiry,
user:{
id:u.id,
name:u.name,
email:u.email,
picture:u.picture||"",
is_premium:p.premium,
membership_expiry:p.expiry,
coins:z.coins,
xp:z.xp
}
});
}

async function logout(r,e){
let x=cookies(r)[SESSION];

if(x){
await e.DB.prepare(
"DELETE FROM sessions WHERE token_hash=?"
).bind(await hash(x)).run();
}

return R(
`${SITE}/Eng/`,
`${SESSION}=;Path=/;HttpOnly;Secure;SameSite=None;Max-Age=0`
);
}

