async function lesson(e,id){
return e.DB.prepare(
"SELECT id,title,access_type FROM lessons WHERE id=? AND active=1"
).bind(id).first();
}

function free(l){
return String(l?.access_type||"").toUpperCase()==="FREE";
}

async function access(e,u,l){
return free(l)||(u&&(await premium(e,u.id)).premium);
}

async function questions(r,e){
let id=+(new URL(r.url).searchParams.get("lesson_id")||0);
let l=await lesson(e,id);
let u=await user(r,e);

if(!id)return J({success:false,error:"Invalid lesson_id"},400);
if(!l)return J({success:false,error:"Lesson not found"},404);
if(!free(l)&&!u)return J({success:false,error:"Login required",login_required:true},401);
if(!await access(e,u,l))return J({success:false,error:"Premium required",premium_required:true},403);

let x=await e.DB.prepare(
"SELECT id,lesson_id,question,option_a,option_b,option_c,option_d FROM questions WHERE lesson_id=? AND active=1 ORDER BY id LIMIT 50"
).bind(id).all();

return J({
success:true,
lesson:l,
questions:x.results||[]
});
}

/* ATTEMPTS */
async function attempts(e,uid,lid){
let since=new Date(Date.now()-30*864e5).toISOString();

let x=await e.DB.prepare(
"SELECT COUNT(*) n FROM quiz_attempts WHERE user_id=? AND lesson_id=? AND created_at>=?"
).bind(uid,lid,since).first();

let used=+(x?.n||0),reset=null;

if(used>=MAX){
let o=await e.DB.prepare(
"SELECT MIN(created_at) d FROM quiz_attempts WHERE user_id=? AND lesson_id=? AND created_at>=?"
).bind(uid,lid,since).first();

if(o?.d)
reset=new Date(new Date(o.d).getTime()+30*864e5).toISOString();
}

return{
used,
left:Math.max(0,MAX-used),
reset
};
}

/* QUIZ START */
async function quizStart(r,e){
if(r.method!=="POST")
return J({success:false,error:"POST required"},405);

let u=await user(r,e),b=await B(r),lid=+(b?.lesson_id||0);

if(!u)
return J({success:false,error:"Login required"},401);

let l=await lesson(e,lid);

if(!lid)
return J({success:false,error:"Invalid lesson_id"},400);

if(!l)
return J({success:false,error:"Lesson not found"},404);

if(!await access(e,u,l))
return J({
success:false,
error:"Premium required",
premium_required:true
},403);

let a=await attempts(e,u.id,lid);

if(a.used>=MAX)
return J({
success:false,
error:"Maximum 3 quiz attempts reached.",
max_attempts:true,
attempts:a.used,
max_attempts_allowed:MAX,
attempts_remaining:0,
reset_at:a.reset
},403);

let id=crypto.randomUUID();
let now=new Date().toISOString();
let since=new Date(Date.now()-30*864e5).toISOString();

let x=await e.DB.prepare(
"INSERT INTO quiz_attempts(id,user_id,lesson_id,created_at)SELECT ?,?,?,? WHERE(SELECT COUNT(*) FROM quiz_attempts WHERE user_id=? AND lesson_id=? AND created_at>=?)<3"
).bind(
id,u.id,lid,now,u.id,lid,since
).run();

if(!x.meta.changes){
a=await attempts(e,u.id,lid);

return J({
success:false,
error:"Maximum 3 quiz attempts reached.",
max_attempts:true,
attempts_remaining:a.left,
reset_at:a.reset
},403);
}

return J({
success:true,
attempt_id:id,
lesson_id:lid,
attempt_number:a.used+1,
max_attempts:MAX,
attempts_used:a.used+1,
attempts_remaining:MAX-a.used-1
});
}

/* ANSWERS */
async function quizCheck(r,e){
if(r.method!=="POST")
return J({success:false,error:"POST required"},405);

let u=await user(r,e);
let b=await B(r);
let aid=s(b?.attempt_id);
let qid=+(b?.question_id||0);
let ans=n(b?.answer);

if(!u)
return J({success:false,error:"Login required"},401);

if(!aid||!qid||!ans)
return J({success:false,error:"Invalid answer"},400);

let a=await e.DB.prepare(
"SELECT * FROM quiz_attempts WHERE id=? AND user_id=?"
).bind(aid,u.id).first();

if(!a)
return J({success:false,error:"Invalid quiz attempt"},403);

if(a.completed_at)
return J({success:false,error:"Quiz already submitted"},400);

let q=await e.DB.prepare(
"SELECT id,lesson_id,correct_answer FROM questions WHERE id=? AND active=1"
).bind(qid).first();

if(!q||+q.lesson_id!==+a.lesson_id)
return J({success:false,error:"Invalid question"},400);

let l=await lesson(e,a.lesson_id);

if(!await access(e,u,l))
return J({
success:false,
error:"Premium required",
premium_required:true
},403);

let old=await e.DB.prepare(
"SELECT answer,correct FROM quiz_answers WHERE attempt_id=? AND question_id=?"
).bind(aid,qid).first();

if(old){
let oldCorrect=+old.correct===1;

return J({
success:true,
already_answered:true,
correct:oldCorrect,
question_id:qid,
answer:n(old.answer),
selected_answer:n(old.answer),
correct_answer:n(q.correct_answer),
reward_coins:oldCorrect?COINS:0,
reward_xp:oldCorrect?XP:0
});
}

let ca=n(q.correct_answer);
let ok=ans===ca;
let now=new Date().toISOString();

let sql=[
e.DB.prepare(
"INSERT INTO quiz_answers(attempt_id,user_id,question_id,answer,correct,created_at)VALUES(?,?,?,?,?,?)"
).bind(
aid,u.id,qid,ans,ok?1:0,now
)
];

if(ok){
sql.push(
e.DB.prepare(
"INSERT INTO quiz_question_rewards(attempt_id,user_id,question_id,coins,xp,created_at)VALUES(?,?,?,?,?,?)"
).bind(
aid,u.id,qid,COINS,XP,now
)
);
}

await e.DB.batch(sql);

return J({
success:true,
correct:ok,
question_id:qid,
answer:ans,
selected_answer:ans,
correct_answer:ca,
reward_coins:ok?COINS:0,
reward_xp:ok?XP:0
});
}

/* SUBMIT */
async function quizSubmit(r,e){
if(r.method!=="POST")
return J({success:false,error:"POST required"},405);

let u=await user(r,e);
let b=await B(r);
let aid=s(b?.attempt_id);
let lid=+(b?.lesson_id||0);

if(!u)
return J({success:false,error:"Login required"},401);

if(!aid||!lid)
return J({success:false,error:"Invalid quiz data"},400);

let a=await e.DB.prepare(
"SELECT * FROM quiz_attempts WHERE id=? AND user_id=?"
).bind(aid,u.id).first();

if(!a||+a.lesson_id!==lid)
return J({success:false,error:"Quiz attempt not found"},404);

let done=await e.DB.prepare(
"SELECT coins,xp FROM quiz_reward_commits WHERE attempt_id=?"
).bind(aid).first();

if(done)
return submitted(e,u.id,lid,done);

if(a.completed_at)
return J({success:false,error:"Quiz already submitted"},400);

let l=await lesson(e,lid);

if(!await access(e,u,l))
return J({
success:false,
error:"Premium required",
premium_required:true
},403);

let q=await e.DB.prepare(
"SELECT id,correct_answer FROM questions WHERE lesson_id=? AND active=1 ORDER BY id LIMIT 50"
).bind(lid).all();

let ar=await e.DB.prepare(
"SELECT question_id,answer FROM quiz_answers WHERE attempt_id=?"
).bind(aid).all();

let map=new Map(
(ar.results||[]).map(x=>[
+x.question_id,
n(x.answer)
])
);

let score=0;
let qs=q.results||[];

for(let x of qs){
if(map.get(+x.id)===n(x.correct_answer))
score++;
}

let p=await pending(e,aid);
let total=qs.length;
let pct=total?Math.round(score/total*100):0;
let now=new Date().toISOString();

await rewardInit(e,u.id);

try{
await e.DB.batch([
e.DB.prepare(
"INSERT INTO quiz_reward_commits(attempt_id,user_id,coins,xp,committed_at)VALUES(?,?,?,?,?)"
).bind(aid,u.id,p.coins,p.xp,now),

e.DB.prepare(
"UPDATE user_rewards SET coins=coins+?,xp=xp+?,updated_at=? WHERE user_id=?"
).bind(p.coins,p.xp,now,u.id),

e.DB.prepare(
"UPDATE quiz_attempts SET completed_at=? WHERE id=?"
).bind(now,aid),

e.DB.prepare(
"INSERT INTO quiz_results(user_id,lesson_id,score,total,percentage,completed_at)VALUES(?,?,?,?,?,?)"
).bind(u.id,lid,score,total,pct,now)
]);
}catch(x){
done=await e.DB.prepare(
"SELECT coins,xp FROM quiz_reward_commits WHERE attempt_id=?"
).bind(aid).first();

if(done)
return submitted(e,u.id,lid,done);

throw x;
}

let z=await rewards(e,u.id);
let a2=await attempts(e,u.id,lid);

return J({
success:true,
already_submitted:false,
score,
total,
percentage:pct,
answered:ar.results?.length||0,
reward_coins:p.coins,
reward_xp:p.xp,
total_coins:z.coins,
total_xp:z.xp,
attempts_used:a2.used,
attempts_remaining:a2.left,
attempts_reset_at:a2.left?null:a2.reset
});
}

async function submitted(e,uid,lid,d){
let z=await rewards(e,uid);
let a=await attempts(e,uid,lid);

return J({
success:true,
already_submitted:true,
reward_coins:+d.coins,
reward_xp:+d.xp,
total_coins:z.coins,
total_xp:z.xp,
attempts_used:a.used,
attempts_remaining:a.left,
attempts_reset_at:a.left?null:a.reset
});
}

async function pending(e,aid){
let x=await e.DB.prepare(
"SELECT COALESCE(SUM(r.coins),0) coins,COALESCE(SUM(r.xp),0) xp FROM quiz_question_rewards r LEFT JOIN quiz_reward_commits c ON c.attempt_id=r.attempt_id WHERE r.attempt_id=? AND c.id IS NULL"
).bind(aid).first();

return{
coins:+(x?.coins||0),
xp:+(x?.xp||0)
};
}

