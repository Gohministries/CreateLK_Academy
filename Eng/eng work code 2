async function makeReferral(e,uid,code){
code=s(code).toUpperCase();

if(!/^ENG\d+$/.test(code))
return;

let rid=+code.slice(3);

if(rid===uid||rid<1)
return;

if(!await e.DB.prepare(
"SELECT id FROM users WHERE id=?"
).bind(rid).first())
return;

if(await e.DB.prepare(
"SELECT id FROM referrals WHERE referred_user_id=?"
).bind(uid).first())
