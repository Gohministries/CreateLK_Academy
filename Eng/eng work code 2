const SITE="https://createlk.com";
const PAYMENT_WORKER="https://pay.createlk.workers.dev";
const SESSION="english_session";
const STATE="google_state";
const GOOGLE_AUTH="https://accounts.google.com/o/oauth2/v2/auth";
const GOOGLE_TOKEN="https://oauth2.googleapis.com/token";
const GOOGLE_USER="https://openidconnect.googleapis.com/v1/userinfo";
const SESSION_DAYS=30;
const STATE_MINUTES=10;
const COINS_PER_CORRECT=5;
const XP_PER_CORRECT=10;
const PREMIUM_PRICE_LKR=1000;
const PREMIUM_DAYS=30;

export default{async fetch(request,env){
try{
const url=new URL(request.url);
if(request.method==="OPTIONS")return cors(new Response(null,{status:204}));
const routes={
"/auth/google":googleLogin,
"/auth/callback":googleCallback,
"/auth/logout":logout,
"/api/me":me,
"/api/referral":referral,
"/api/titles":titles,
"/api/questions":questions,
"/api/quiz/start":startQuiz,
"/api/quiz/check":checkAnswer,
"/api/quiz/submit":submitQuiz,
"/api/leaderboard":leaderboard,
"/api/leaderboard/me":leaderboardMe,
"/api/payment/start":paymentStart
};
if(routes[url.pathname])return routes[url.pathname](request,env);
if(url.pathname==="/api/health")return json({success:true,message:"English API is running"});
return json({success:false,error:"Not found"},404);
}catch(e){
console.error(e);
return json({success:false,error:"Server error"},500);
}
}};

/* AUTH */
async function googleLogin(request,env){
const url=new URL(request.url);
const referral=clean(url.searchParams.get("ref"));
const state=token(32);
const data={state,referral,expires:Date.now()+STATE_MINUTES*60000};
const params=new URLSearchParams({
client_id:env.GOOGLE_CLIENT_ID,
redirect_uri:env.GOOGLE_REDIRECT_URI,
response_type:"code",
scope:"openid email profile",
access_type:"offline",
prompt:"select_account",
state:btoa(JSON.stringify(data))
});
return new Response(null,{status:302,headers:{
Location:`${GOOGLE_AUTH}?${params}`,
"Set-Cookie":`${STATE}=${encodeURIComponent(state)}; Path=/; HttpOnly; Secure; SameSite=None; Max-Age=600`
}});
}

async function googleCallback(request,env){
const url=new URL(request.url);
const code=url.searchParams.get("code");
const stateParam=url.searchParams.get("state");
if(!code||!stateParam)return new Response("Invalid Google login.",{status:400});
let state;
try{state=JSON.parse(atob(stateParam));}catch{return new Response("Invalid state.",{status:400});}
if(!state.state||state.expires<Date.now())return new Response("Login expired.",{status:400});
if(parseCookies(request)[STATE]!==state.state)return new Response("Invalid login state.",{status:400});

const tr=await fetch(GOOGLE_TOKEN,{method:"POST",headers:{"Content-Type":"application/x-www-form-urlencoded"},body:new URLSearchParams({
client_id:env.GOOGLE_CLIENT_ID,
client_secret:env.GOOGLE_CLIENT_SECRET,
code,
grant_type:"authorization_code",
redirect_uri:env.GOOGLE_REDIRECT_URI
})});
const td=await tr.json();
if(!td.access_token)return new Response("Google authentication failed.",{status:400});

const gr=await fetch(GOOGLE_USER,{headers:{Authorization:`Bearer ${td.access_token}`}});
const g=await gr.json();
if(!g.sub||!g.email)return new Response("Unable to get Google account.",{status:400});

const googleId=clean(g.sub);
const email=clean(g.email);
const name=clean(g.name)||email.split("@")[0];
const picture=clean(g.picture);

let user=await env.DB.prepare(`SELECT * FROM users WHERE google_id=? OR email=? LIMIT 1`).bind(googleId,email).first();

if(!user){
const r=await env.DB.prepare(`
INSERT INTO users(google_id,name,email,membership_status,membership_expiry,auth_provider,picture,last_active_at)
VALUES(?,?,?,'FREE',NULL,'google',?,?)`).bind(
googleId,name,email,picture,Date.now()
).run();
user=await env.DB.prepare(`SELECT * FROM users WHERE id=? LIMIT 1`).bind(r.meta.last_row_id).first();
}else{
await env.DB.prepare(`
UPDATE users SET google_id=?,name=?,email=?,picture=?,last_active_at=? WHERE id=?`).bind(
googleId,name,email,picture,Date.now(),user.id
).run();
}

await ensureRewards(env,user.id);
if(state.referral)await createReferral(env,user.id,state.referral);

const session=token(48);
const hash=await sha256(session);
const expiry=new Date(Date.now()+SESSION_DAYS*86400000).toISOString();

await env.DB.prepare(`INSERT INTO sessions(user_id,token_hash,expires_at)VALUES(?,?,?)`).bind(
user.id,hash,expiry
).run();

return new Response(null,{status:302,headers:{
Location:`${SITE}/Eng/`,
"Set-Cookie":`${SESSION}=${session}; Path=/; HttpOnly; Secure; SameSite=None; Max-Age=${SESSION_DAYS*86400}`
}});
}

/* USER */
async function currentUser(request,env){
const session=parseCookies(request)[SESSION];
if(!session)return null;
return env.DB.prepare(`
SELECT u.* FROM sessions s JOIN users u ON u.id=s.user_id
WHERE s.token_hash=? AND s.expires_at>? LIMIT 1`).bind(
await sha256(session),new Date().toISOString()
).first();
}

async function me(request,env){
const user=await currentUser(request,env);
if(!user)return json({success:true,logged_in:false,user:null,premium:false});
const rewards=await getRewards(env,user.id);
return json({
success:true,
logged_in:true,
user:{
id:user.id,
name:user.name,
email:user.email,
picture:user.picture||"",
membership_status:user.membership_status,
membership_expiry:user.membership_expiry,
coins:rewards.coins,
xp:rewards.xp
},
premium:await premium(env,user.id)
});
}

/* REWARDS */
async function ensureRewards(env,userId){
await env.DB.prepare(`
INSERT OR IGNORE INTO user_rewards(user_id,coins,xp,updated_at)
VALUES(?,?,?,?)`).bind(
userId,0,0,new Date().toISOString()
).run();
}

async function getRewards(env,userId){
await ensureRewards(env,userId);
const r=await env.DB.prepare(`SELECT coins,xp FROM user_rewards WHERE user_id=? LIMIT 1`).bind(userId).first();
return{coins:Number(r?.coins||0),xp:Number(r?.xp||0)};
}

async function addRewards(env,userId,coins,xp){
await ensureRewards(env,userId);
await env.DB.prepare(`
UPDATE user_rewards
SET coins=COALESCE(coins,0)+?,xp=COALESCE(xp,0)+?,updated_at=?
WHERE user_id=?`).bind(
Number(coins)||0,Number(xp)||0,new Date().toISOString(),userId
).run();
return getRewards(env,userId);
}

/* PREMIUM */
async function premium(env,userId){
const u=await env.DB.prepare(`
SELECT membership_status,membership_expiry FROM users WHERE id=? LIMIT 1
`).bind(userId).first();
if(!u||String(u.membership_status).toUpperCase()!=="PREMIUM")return false;
return !u.membership_expiry||new Date(u.membership_expiry).getTime()>Date.now();
}

