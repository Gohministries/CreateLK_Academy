/* HELPERS */
function s(x){
return String(x??"").trim();
}

function n(x){
return s(x).toLowerCase();
}

async function B(r){
try{
return await r.json();
}catch{
return null;
}
}

async function hash(x){
let b=await crypto.subtle.digest(
"SHA-256",
new TextEncoder().encode(x)
);

return[...new Uint8Array(b)]
.map(x=>x.toString(16).padStart(2,"0"))
.join("");
}

function tok(n=32){
let a=new Uint8Array(n);
crypto.getRandomValues(a);

return[...a]
.map(x=>x.toString(16).padStart(2,"0"))
.join("");
}

function cookies(r){
let o={};

for(let x of(r.headers.get("Cookie")||"").split(";")){
let i=x.indexOf("=");

if(i>0)
o[x.slice(0,i).trim()]=x.slice(i+1).trim();
}

return o;
}

function J(x,status=200){
return cors(new Response(
JSON.stringify(x),
{
status,
headers:{
"Content-Type":"application/json"
}
}
));
}

function R(url,cookie){
return new Response(null,{
status:302,
headers:{
Location:url,
"Set-Cookie":cookie
}
});
}

/* CORS */
function cors(r){
const o=r.headers.get("Origin");

if(o==="https://createlk.com"||o==="https://www.createlk.com"){
r.headers.set("Access-Control-Allow-Origin",o);
r.headers.set("Access-Control-Allow-Credentials","true");
r.headers.set("Access-Control-Allow-Headers","Content-Type,Authorization");
r.headers.set("Access-Control-Allow-Methods","GET,POST,OPTIONS");
r.headers.set("Vary","Origin");
}

return r;
}