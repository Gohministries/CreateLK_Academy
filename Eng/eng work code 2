async function createReferral(e,uid,code){
code=clean(code).toUpperCase();

if(!/^ENG\d+$/.test(code))return;

const rid=Number(code.slice(3));

if(!Number.isInteger(rid)||rid<1||rid===uid)return;

if(!await e.DB.prepare("SELECT id FROM users WHERE id=?").bind(rid).first())return;

if(await e.DB.prepare("SELECT id FROM referrals WHERE referred_user_id=?").bind(uid).first())return;

await e.DB.prepare(
"INSERT INTO referrals(referrer_id,referred_user_id,referral_code)VALUES(?,?,?)"
).bind(rid,uid,code).run();
}

async function paymentStart(r,e){
if(r.method!=="POST")return json({success:false,error:"POST required"},405);

const u=await currentUser(r,e),b=await body(r);

if(!u)return json({success:false,error:"Login required"},401);
if(!b)return json({success:false,error:"Invalid JSON"},400);

const lid=Number(b.lesson_id);

if(!lid)return json({success:false,error:"Invalid lesson_id"},400);

const l=await lesson(e,lid);
if(!l)return json({success:false,error:"Lesson not found"},404);

if(free(lid,l))return json({success:false,error:"This lesson is free"},400);

if((await premium(e,u.id)).premium)
return json({success:false,error:"You already have premium access"},400);

try{
const x=await fetch(`${PAY}/internal/start`,{
method:"POST",
headers:{
"Content-Type":"application/json",
"Authorization":`Bearer ${e.INTERNAL_SECRET}`
},
body:JSON.stringify({
user_id:Number(u.id),
email:u.email||"",
name:u.name||"",
lesson_id:lid,
source:"english"
})
});

const d=await x.json();

if(!x.ok||!d.success)
return json({success:false,error:d.error||"Payment failed"},x.status||500);

return json({
success:true,
order_id:d.order_id||null,
amount:d.amount||null,
currency:d.currency||"LKR",
payment_url:d.payment_url||null
});
}catch(x){
console.error("PAYMENT ERROR",x);
return json({success:false,error:"Payment connection failed"},502);
}
}

async function logout(r,e){
const x=cookies(r)[SESSION];

if(x)
await e.DB.prepare("DELETE FROM sessions WHERE token_hash=?")
.bind(await sha256(x)).run();

return new Response(null,{
status:302,
headers:{
Location:`${SITE}/Eng/`,
"Set-Cookie":`${SESSION}=; Path=/; HttpOnly; Secure; SameSite=None; Max-Age=0`
}
});
}

async function body(r){
try{return await r.json()}catch{return null}
}

function normalize(x){
const v=String(x??"").trim().toLowerCase().replace(/[.)]$/,"");

return({
"1":"a","2":"b","3":"c","4":"d",
"a":"a","b":"b","c":"c","d":"d",
"option_a":"a","option_b":"b","option_c":"c","option_d":"d",
"answer_a":"a","answer_b":"b","answer_c":"c","answer_d":"d"
})[v]||null;
}

function token(n=32){
const a=new Uint8Array(n);
crypto.getRandomValues(a);
return[...a].map(x=>x.toString(16).padStart(2,"0")).join("");
}

async function sha256(x){
const h=await crypto.subtle.digest(
"SHA-256",
new TextEncoder().encode(x)
);
return[...new Uint8Array(h)].map(x=>x.toString(16).padStart(2,"0")).join("");
}

function cookies(r){
const o={},h=r.headers.get("Cookie");
if(!h)return o;

for(const p of h.split(";")){
const i=p.indexOf("=");
if(i>=0)o[p.slice(0,i).trim()]=decodeURIComponent(p.slice(i+1).trim());
}

return o;
}

function clean(x){
return String(x||"").trim();
}

function json(x,status=200){
return cors(new Response(
JSON.stringify(x),
{
status,
headers:{
"Content-Type":"application/json; charset=UTF-8"
}
}
));
}

function cors(r){
r.headers.set("Access-Control-Allow-Origin",SITE);
r.headers.set("Access-Control-Allow-Credentials","true");
r.headers.set("Access-Control-Allow-Headers","Content-Type");
r.headers.set("Access-Control-Allow-Methods","GET,POST,OPTIONS");
return r;
}