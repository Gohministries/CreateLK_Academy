const SITE="https://createlk.com",PREMIUM="https://premium.createlk.workers.dev",PAY="https://pay.createlk.workers.dev";
const SESSION="english_session",STATE="google_state";
const GA="https://accounts.google.com/o/oauth2/v2/auth",GT="https://oauth2.googleapis.com/token",GU="https://openidconnect.googleapis.com/v1/userinfo";
const SESSION_DAYS=30,STATE_MINUTES=10,COINS=5,XP=10,MAX_ATTEMPTS=3,ATTEMPT_DAYS=30;

export default{async fetch(r,e){
try{
const u=new URL(r.url);
if(r.method==="OPTIONS")return cors(new Response(null,{status:204}));
const routes={
"/auth/google":googleLogin,"/auth/callback":googleCallback,"/auth/logout":logout,
"/api/me":me,"/api/referral":referral,"/api/titles":titles,"/api/questions":questions,
"/api/quiz/start":startQuiz,"/api/quiz/check":checkAnswer,"/api/quiz/submit":submitQuiz,
"/api/leaderboard":leaderboard,"/api/leaderboard/me":leaderboardMe,
"/api/payment/start":paymentStart
};
if(routes[u.pathname])return routes[u.pathname](r,e);
if(u.pathname==="/api/health")return json({success:true,message:"English API is running"});
return json({success:false,error:"Not found"},404);
}catch(x){console.error(x);return json({success:false,error:"Server error"},500)}
}};

async function googleLogin(r,e){
const u=new URL(r.url),ref=clean(u.searchParams.get("ref")),st=token(32);
const data={state:st,referral:ref,expires:Date.now()+STATE_MINUTES*60000};
const q=new URLSearchParams({
client_id:e.GOOGLE_CLIENT_ID,redirect_uri:e.GOOGLE_REDIRECT_URI,
response_type:"code",scope:"openid email profile",access_type:"offline",
prompt:"select_account",state:btoa(JSON.stringify(data))
});
return new Response(null,{status:302,headers:{
Location:`${GA}?${q}`,
"Set-Cookie":`${STATE}=${encodeURIComponent(st)}; Path=/; HttpOnly; Secure; SameSite=None; Max-Age=600`
}});
}

async function googleCallback(r,e){
const u=new URL(r.url),code=u.searchParams.get("code"),raw=u.searchParams.get("state");
if(!code||!raw)return new Response("Invalid Google login.",{status:400});
let st;
try{st=JSON.parse(atob(raw))}catch{return new Response("Invalid state.",{status:400})}
if(!st.state||st.expires<Date.now()||cookies(r)[STATE]!==st.state)
return new Response("Login expired.",{status:400});

const tr=await fetch(GT,{
method:"POST",
headers:{"Content-Type":"application/x-www-form-urlencoded"},
body:new URLSearchParams({
client_id:e.GOOGLE_CLIENT_ID,client_secret:e.GOOGLE_CLIENT_SECRET,
code,grant_type:"authorization_code",redirect_uri:e.GOOGLE_REDIRECT_URI
})
});
const td=await tr.json();
if(!td.access_token)return new Response("Google authentication failed.",{status:400});

const g=await(await fetch(GU,{headers:{Authorization:`Bearer ${td.access_token}`}})).json();
if(!g.sub||!g.email)return new Response("Unable to get Google account.",{status:400});

const gid=clean(g.sub),email=clean(g.email),name=clean(g.name)||email.split("@")[0],pic=clean(g.picture);
let user=await e.DB.prepare(
"SELECT * FROM users WHERE google_id=? OR email=? LIMIT 1"
).bind(gid,email).first();

if(!user){
const x=await e.DB.prepare(
"INSERT INTO users(google_id,name,email,membership_status,membership_expiry,auth_provider,picture,last_active_at)VALUES(?,?,?,'FREE',NULL,'google',?,?)"
).bind(gid,name,email,pic,Date.now()).run();
user=await e.DB.prepare("SELECT * FROM users WHERE id=?").bind(x.meta.last_row_id).first();
}else{
await e.DB.prepare(
"UPDATE users SET google_id=?,name=?,email=?,picture=?,last_active_at=? WHERE id=?"
).bind(gid,name,email,pic,Date.now(),user.id).run();
}

await ensureRewards(e,user.id);
if(st.referral)await createReferral(e,user.id,st.referral);

const session=token(48);
await e.DB.prepare(
"INSERT INTO sessions(user_id,token_hash,expires_at)VALUES(?,?,?)"
).bind(user.id,await sha256(session),new Date(Date.now()+SESSION_DAYS*86400000).toISOString()).run();

return new Response(null,{status:302,headers:{
Location:`${SITE}/Eng/`,
"Set-Cookie":`${SESSION}=${session}; Path=/; HttpOnly; Secure; SameSite=None; Max-Age=${SESSION_DAYS*86400}`
}});
}

async function currentUser(r,e){
const x=cookies(r)[SESSION];
return x?e.DB.prepare(
"SELECT u.* FROM sessions s JOIN users u ON u.id=s.user_id WHERE s.token_hash=? AND s.expires_at>? LIMIT 1"
).bind(await sha256(x),new Date().toISOString()).first():null;
}

async function me(r,e){
const u=await currentUser(r,e);
if(!u)return json({success:true,logged_in:false,user:null,premium:false,membership_expiry:null});

const z=await rewards(e,u.id),p=await premium(e,u.id);

return json({
success:true,
logged_in:true,
premium:p.premium,
membership_expiry:p.expiry,
user:{
id:u.id,name:u.name,email:u.email,picture:u.picture||"",
membership_status:u.membership_status,
membership_expiry:p.expiry,
coins:z.coins,xp:z.xp,is_premium:p.premium
}
});
}

async function premium(e,id){
try{
const r=await fetch(`${PREMIUM}/internal/check`,{
method:"POST",
headers:{
"Content-Type":"application/json",
"Authorization":`Bearer ${e.INTERNAL_SECRET}`
},
body:JSON.stringify({user_id:Number(id)})
});
const d=await r.json();
return{premium:r.ok&&d.premium===true,expiry:d.membership_expiry||null};
}catch{
return{premium:false,expiry:null};
