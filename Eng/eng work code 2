async function createReferral(env,userId,code){
code=clean(code).toUpperCase();
if(!code.startsWith("ENG"))return;

const referrerId=Number(code.slice(3));

if(!Number.isInteger(referrerId)||referrerId<1||referrerId===userId)return;

const referrer=await env.DB.prepare(`
SELECT id FROM users WHERE id=? LIMIT 1
`).bind(referrerId).first();

if(!referrer)return;

const exists=await env.DB.prepare(`
SELECT id FROM referrals WHERE referred_user_id=? LIMIT 1
`).bind(userId).first();

if(exists)return;

await env.DB.prepare(`
INSERT INTO referrals(referrer_id,referred_user_id,referral_code)
VALUES(?,?,?)`).bind(
referrerId,userId,code
).run();
}

/* LOGOUT */
async function logout(request,env){
const session=parseCookies(request)[SESSION];

if(session){
await env.DB.prepare(`
DELETE FROM sessions WHERE token_hash=?
`).bind(await sha256(session)).run();
}

return new Response(null,{status:302,headers:{
Location:`${SITE}/Eng/`,
"Set-Cookie":`${SESSION}=; Path=/; HttpOnly; Secure; SameSite=None; Max-Age=0`
