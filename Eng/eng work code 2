/* QUESTIONS */
async function questions(request,env){
const id=Number(new URL(request.url).searchParams.get("lesson_id"));
if(!id)return json({success:false,error:"Invalid lesson_id"},400);

const lesson=await getLesson(env,id);
if(!lesson)return json({success:false,error:"Lesson not found"},404);

const user=await currentUser(request,env);
const isPremium=user?await premium(env,user.id):false;

if(!isFreeLesson(id,lesson)&&!isPremium)return json({
success:false,error:"Premium required",premium_required:true
},403);

const r=await env.DB.prepare(`
SELECT id,lesson_id,question,option_a,option_b,option_c,option_d
FROM questions WHERE lesson_id=? AND active=1 ORDER BY id LIMIT 50
`).bind(id).all();

return json({success:true,lesson,questions:r.results||[]});
}

/* START QUIZ */
async function startQuiz(request,env){
if(request.method!=="POST")return json({success:false,error:"POST required"},405);
const user=await currentUser(request,env);
if(!user)return json({success:false,error:"Login required"},401);

const body=await bodyJSON(request);
if(!body)return json({success:false,error:"Invalid JSON"},400);

const lessonId=Number(body.lesson_id);
if(!lessonId)return json({success:false,error:"Invalid lesson_id"},400);

const lesson=await getLesson(env,lessonId);
if(!lesson)return json({success:false,error:"Lesson not found"},404);

if(!isFreeLesson(lessonId,lesson)&&!(await premium(env,user.id)))
return json({success:false,error:"Premium required",premium_required:true},403);

const id=crypto.randomUUID();

await env.DB.prepare(`
INSERT INTO quiz_attempts(id,user_id,lesson_id,created_at)
VALUES(?,?,?,?)`).bind(
id,user.id,lessonId,new Date().toISOString()
).run();

return json({success:true,attempt_id:id,lesson_id:lessonId});
}

/* CHECK ANSWER */
async function checkAnswer(request,env){
if(request.method!=="POST")return json({success:false,error:"POST required"},405);

const user=await currentUser(request,env);
if(!user)return json({success:false,error:"Login required"},401);

const body=await bodyJSON(request);
if(!body)return json({success:false,error:"Invalid JSON"},400);

const questionId=Number(body.question_id);
const answer=normalizeAnswer(body.answer);
const attemptId=clean(body.attempt_id);

if(!questionId||!answer||!attemptId)return json({
success:false,error:"Invalid answer"
},400);

const attempt=await env.DB.prepare(`
SELECT id,lesson_id FROM quiz_attempts
WHERE id=? AND user_id=? LIMIT 1
`).bind(attemptId,user.id).first();

if(!attempt)return json({success:false,error:"Invalid quiz attempt"},403);

const q=await env.DB.prepare(`
SELECT id,lesson_id,correct_answer,option_a,option_b,option_c,option_d
FROM questions WHERE id=? AND active=1 LIMIT 1
`).bind(questionId).first();

if(!q)return json({success:false,error:"Question not found"},404);

if(Number(q.lesson_id)!==Number(attempt.lesson_id))
return json({success:false,error:"Question does not belong to this quiz."},400);

const lesson=await getLesson(env,q.lesson_id);
if(!lesson)return json({success:false,error:"Lesson not found"},404);

if(!isFreeLesson(q.lesson_id,lesson)&&!(await premium(env,user.id)))
return json({success:false,error:"Premium required",premium_required:true},403);

const correctAnswer=normalizeAnswer(q.correct_answer);
const correct=answer===correctAnswer;

let rewarded=false;
let rewardCoins=0;
let rewardXP=0;
let totals=await getRewards(env,user.id);

if(correct){
const exists=await env.DB.prepare(`
SELECT 1 FROM quiz_question_rewards
WHERE attempt_id=? AND question_id=? LIMIT 1
`).bind(attemptId,questionId).first();

if(!exists){
try{
await env.DB.prepare(`
INSERT INTO quiz_question_rewards
(attempt_id,user_id,question_id,coins,xp,created_at)
VALUES(?,?,?,?,?,?)`).bind(
attemptId,user.id,questionId,
COINS_PER_CORRECT,XP_PER_CORRECT,
new Date().toISOString()
).run();

totals=await addRewards(
env,user.id,
COINS_PER_CORRECT,
XP_PER_CORRECT
);

rewarded=true;
rewardCoins=COINS_PER_CORRECT;
rewardXP=XP_PER_CORRECT;
}catch(e){
console.error("REWARD ERROR",e);
}
}
}

const options={
a:q.option_a,
b:q.option_b,
c:q.option_c,
d:q.option_d
};

return json({
success:true,
correct,
question_id:questionId,
answer,
rewarded,
reward_coins:rewardCoins,
reward_xp:rewardXP,
total_coins:totals.coins,
total_xp:totals.xp,
...(correct?{}:{
correct_answer:correctAnswer,
correct_text:options[correctAnswer]||""
})
});
}

/* SUBMIT QUIZ */
async function submitQuiz(request,env){
if(request.method!=="POST")return json({success:false,error:"POST required"},405);

const user=await currentUser(request,env);
if(!user)return json({success:false,error:"Login required"},401);

const body=await bodyJSON(request);
if(!body)return json({success:false,error:"Invalid JSON"},400);

const lessonId=Number(body.lesson_id);
const attemptId=clean(body.attempt_id);
const answers=Array.isArray(body.answers)?body.answers:[];

if(!lessonId||!attemptId||!answers.length||answers.length>50)
return json({success:false,error:"Invalid quiz data"},400);

const attempt=await env.DB.prepare(`
SELECT id,lesson_id,completed_at FROM quiz_attempts
WHERE id=? AND user_id=? LIMIT 1
`).bind(attemptId,user.id).first();

if(!attempt)return json({success:false,error:"Quiz attempt not found"},404);

if(Number(attempt.lesson_id)!==lessonId)
return json({success:false,error:"Invalid lesson"},400);

const lesson=await getLesson(env,lessonId);
if(!lesson)return json({success:false,error:"Lesson not found"},404);

if(!isFreeLesson(lessonId,lesson)&&!(await premium(env,user.id)))
return json({success:false,error:"Premium required",premium_required:true},403);

const r=await env.DB.prepare(`
SELECT id,correct_answer FROM questions
WHERE lesson_id=? AND active=1 ORDER BY id LIMIT 50
`).bind(lessonId).all();

const rows=r.results||[];
if(!rows.length)return json({success:false,error:"No questions found"},404);

const submitted=new Map();

for(const a of answers){
const id=Number(a?.question_id);
const answer=normalizeAnswer(a?.answer);
if(id&&answer)submitted.set(id,answer);
}

let score=0;

for(const q of rows){
if(submitted.get(Number(q.id))===normalizeAnswer(q.correct_answer))score++;
}

const total=rows.length;
const percentage=Math.round(score/total*100);
const completedAt=new Date().toISOString();

await env.DB.prepare(`
INSERT INTO quiz_results
(user_id,lesson_id,score,total,percentage,completed_at)
VALUES(?,?,?,?,?,?)`).bind(
user.id,lessonId,score,total,percentage,completedAt
).run();

await env.DB.prepare(`
UPDATE quiz_attempts SET completed_at=?
WHERE id=? AND user_id=?`).bind(
completedAt,attemptId,user.id
).run();

const totals=await getRewards(env,user.id);

return json({
success:true,
lesson_id:lessonId,
lesson_title:lesson.title,
score,
total,
percentage,
reward_coins:0,
reward_xp:0,
rewarded:false,
coins_per_correct:COINS_PER_CORRECT,
xp_per_correct:XP_PER_CORRECT,
total_coins:totals.coins,
total_xp:totals.xp,
completed_at:completedAt
});
}

/* LEADERBOARD */
async function leaderboard(request,env){
const r=await env.DB.prepare(`
SELECT u.id,u.name,u.picture,
COALESCE(ur.coins,0) coins,
COALESCE(ur.xp,0) xp
FROM users u
LEFT JOIN user_rewards ur ON ur.user_id=u.id
WHERE COALESCE(ur.coins,0)>0
ORDER BY coins DESC,xp DESC,u.id
LIMIT 100
`).all();

return json({
success:true,
leaderboard:(r.results||[]).map((x,i)=>({
rank:i+1,
id:x.id,
name:x.name,
picture:x.picture||"",
coins:Number(x.coins||0),
xp:Number(x.xp||0)
}))
});
}

async function leaderboardMe(request,env){
const user=await currentUser(request,env);
if(!user)return json({success:false,error:"Login required"},401);

const r=await env.DB.prepare(`
SELECT u.id,u.name,u.picture,
COALESCE(ur.coins,0) coins,
COALESCE(ur.xp,0) xp
FROM users u
LEFT JOIN user_rewards ur ON ur.user_id=u.id
ORDER BY coins DESC,xp DESC,u.id
`).all();

const rows=r.results||[];
const i=rows.findIndex(x=>Number(x.id)===Number(user.id));

if(i<0)return json({success:true,rank:null,user:null});

const x=rows[i];

return json({
success:true,
rank:i+1,
user:{
id:x.id,
name:x.name,
picture:x.picture||"",
coins:Number(x.coins||0),
xp:Number(x.xp||0)
}
});
}

