/* =========================
   GOOGLE LOGIN
========================= */

async function login(r,e){

 if(
  !e.GOOGLE_CLIENT_ID||
  !e.GOOGLE_CLIENT_SECRET
 )
  return json({
   success:false,
   error:"Google OAuth secrets are not configured"
  },500);

 const s=token(32);

 await e.DB.prepare(`
  INSERT INTO oauth_states(state,expires_at)
  VALUES(?,?)
 `).bind(
  s,
  Date.now()+600000
 ).run();

 const redirect=
  "https://affiliate.createlk.workers.dev/auth/callback";

 const q=new URLSearchParams({

  client_id:e.GOOGLE_CLIENT_ID,

  redirect_uri:redirect,

  response_type:"code",

  scope:"openid email profile",

  state:s,

  access_type:"offline",

  prompt:"select_account"
 });

 return new Response(null,{
  status:302,
  headers:{
   Location:`${GA}?${q}`,

   "Set-Cookie":
    `${STATE}=${s};Path=/;HttpOnly;Secure;SameSite=None;Max-Age=600`
  }
 });
}


/* =========================
   GOOGLE CALLBACK
========================= */

async function callback(r,e){

 const u=new URL(r.url);

 const code=u.searchParams.get("code");
 const state=u.searchParams.get("state");

 if(!code||!state)
  return new Response(
   "Invalid login.",
   {status:400}
  );

 const cookie=cookies(r)[STATE];

 if(!cookie||cookie!==state)
  return new Response(
   "Invalid login state.",
   {status:400}
  );

 const st=await e.DB.prepare(`
  SELECT state
  FROM oauth_states
  WHERE state=?
  AND expires_at>?
 `).bind(
  state,
  Date.now()
 ).first();

 if(!st)
  return new Response(
   "Login expired.",
   {status:400}
  );

 await e.DB.prepare(`
  DELETE FROM oauth_states
  WHERE state=?
 `).bind(state).run();


 /* Exchange code */

 const t=await fetch(GT,{
  method:"POST",

  headers:{
   "Content-Type":
    "application/x-www-form-urlencoded"
  },

  body:new URLSearchParams({

   client_id:e.GOOGLE_CLIENT_ID,

   client_secret:e.GOOGLE_CLIENT_SECRET,

   code,

   grant_type:"authorization_code",

   redirect_uri:
    "https://affiliate.createlk.workers.dev/auth/callback"
  })

 }).then(x=>x.json());


 if(!t.access_token)
  return new Response(
   "Google authentication failed.",
   {status:400}
  );


 /* Get Google account */

 const g=await fetch(GU,{
  headers:{
   Authorization:`Bearer ${t.access_token}`
  }
 }).then(x=>x.json());


 const googleId=clean(g.sub);

 const email=
  clean(g.email).toLowerCase();

 const name=
  clean(g.name)||
  email.split("@")[0];

 const picture=
  clean(g.picture);


 if(!googleId||!email)
  return new Response(
   "Unable to get Google account.",
   {status:400}
  );


 /* Existing affiliate */

 let a=await e.DB.prepare(`
  SELECT *
  FROM affiliates
  WHERE google_id=?
  LIMIT 1
 `).bind(googleId).first();


 /* Existing account by email */

 if(!a){

  a=await e.DB.prepare(`
   SELECT *
   FROM affiliates
   WHERE lower(email)=?
   LIMIT 1
  `).bind(email).first();
 }


 /* Create affiliate */

 if(!a){

  let referralCode;

  for(let i=0;i<10;i++){

   referralCode=
    "CLK"+
    token(4)
     .toUpperCase()
     .replace(/[^A-Z0-9]/g,"")
     .slice(0,8);

   const exists=
    await e.DB.prepare(`
     SELECT id
     FROM affiliates
     WHERE referral_code=?
    `).bind(referralCode).first();

   if(!exists)break;

   referralCode=null;
  }

  if(!referralCode)
   return new Response(
    "Unable to create referral code.",
    {status:500}
   );

  const x=await e.DB.prepare(`
   INSERT INTO affiliates(
    google_id,
    email,
    name,
    picture,
    referral_code,
    status,
    created_at,
    last_active_at
   )
   VALUES(?,?,?,?,?,'ACTIVE',?,?)
  `).bind(
   googleId,
   email,
   name,
   picture,
   referralCode,
   now(),
   now()
  ).run();

  a=await e.DB.prepare(`
   SELECT *
   FROM affiliates
   WHERE id=?
  `).bind(
   x.meta.last_row_id
  ).first();

 }else{

  if(a.status!=="ACTIVE")
   return new Response(
    "Affiliate account is disabled.",
    {status:403}
   );

  await e.DB.prepare(`
   UPDATE affiliates
   SET google_id=?,
       name=?,
       email=?,
       picture=?,
       last_active_at=?
   WHERE id=?
  `).bind(
   googleId,
   name,
   email,
   picture,
   now(),
   a.id
  ).run();

 }


 /* Create session */

 const session=token(48);

 await e.DB.prepare(`
  INSERT INTO affiliate_sessions(
   token_hash,
   affiliate_id,
   expires_at
  )
  VALUES(?,?,?)
 `).bind(
  await hash(session),
  a.id,
  new Date(
   Date.now()+
   SESSION_DAYS*86400000
  ).toISOString()
 ).run();


 return new Response(null,{
  status:302,

  headers:{
   Location:AFFILIATE_HOME,

   "Set-Cookie":
    `${SES}=${session};Path=/;HttpOnly;Secure;SameSite=None;Max-Age=${SESSION_DAYS*86400}`
  }
 });
}


/* =========================
   CURRENT AFFILIATE
========================= */

async function currentUser(r,e){

 const s=cookies(r)[SES];

 if(!s)return null;

 const a=await e.DB.prepare(`
  SELECT
   a.*
  FROM affiliate_sessions s
  JOIN affiliates a
   ON a.id=s.affiliate_id
  WHERE s.token_hash=?
  AND s.expires_at>?
  LIMIT 1
 `).bind(
  await hash(s),
  now()
 ).first();

 if(!a)return null;

 if(a.status!=="ACTIVE")
  return null;

 await e.DB.prepare(`
  UPDATE affiliates
  SET last_active_at=?
  WHERE id=?
 `).bind(
  now(),
  a.id
 ).run();

 return a;
}


