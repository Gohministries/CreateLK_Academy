const SITE="https://createlk.com";
const AFFILIATE_HOME="https://createlk.com/Affiliate/";
const MIN_WITHDRAW=2000;
const COMMISSION=20;

const GA="https://accounts.google.com/o/oauth2/v2/auth";
const GT="https://oauth2.googleapis.com/token";
const GU="https://openidconnect.googleapis.com/v1/userinfo";

const SES="affiliate_session";
const STATE="affiliate_state";
const SESSION_DAYS=30;

export default{
 async fetch(r,e){
  try{

   if(r.method==="OPTIONS")
    return new Response(null,{
     status:204,
     headers:cors()
    });

   await db(e);

   const p=new URL(r.url).pathname;

   const f={
    "/api/health":health,

    "/auth/google":login,
    "/auth/callback":callback,
    "/auth/logout":logout,

    "/api/me":me,
    "/api/affiliate":dashboard,

    "/api/click":click,

    "/api/withdrawal":withdrawal,

    "/internal/commission":internalCommission
   };

   return f[p]
    ?f[p](r,e)
    :json({
      success:false,
      error:"Not found"
     },404);

  }catch(x){

   console.error(x);

   return json({
    success:false,
    error:x.message||"Server error"
   },500);
  }
 }
};


/* =========================
   DATABASE
========================= */

async function db(e){

 if(!e.DB)
  throw Error("D1 binding DB is missing");

 await e.DB.batch([

  e.DB.prepare(`
   CREATE TABLE IF NOT EXISTS affiliates(
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    google_id TEXT UNIQUE,
    email TEXT UNIQUE NOT NULL,
    name TEXT,
    picture TEXT,
    referral_code TEXT UNIQUE NOT NULL,
    status TEXT DEFAULT 'ACTIVE',
    created_at TEXT,
    last_active_at TEXT
   )
  `),

  e.DB.prepare(`
   CREATE TABLE IF NOT EXISTS affiliate_sessions(
    token_hash TEXT PRIMARY KEY,
    affiliate_id INTEGER NOT NULL,
    expires_at TEXT
   )
  `),

  e.DB.prepare(`
   CREATE TABLE IF NOT EXISTS affiliate_clicks(
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    affiliate_id INTEGER NOT NULL,
    referral_code TEXT NOT NULL,
    created_at TEXT
   )
  `),

  e.DB.prepare(`
   CREATE TABLE IF NOT EXISTS affiliate_referrals(
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    affiliate_id INTEGER NOT NULL,
    customer_email TEXT,
    referral_code TEXT NOT NULL,
    created_at TEXT
   )
  `),

  e.DB.prepare(`
   CREATE TABLE IF NOT EXISTS affiliate_commissions(
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    payment_id INTEGER UNIQUE NOT NULL,
    affiliate_id INTEGER NOT NULL,
    customer_email TEXT,
    referral_code TEXT NOT NULL,
    payment_amount REAL DEFAULT 0,
    commission_rate REAL DEFAULT 20,
    commission_amount REAL DEFAULT 0,
    status TEXT DEFAULT 'APPROVED',
    created_at TEXT,
    paid_at TEXT
   )
  `),

  e.DB.prepare(`
   CREATE TABLE IF NOT EXISTS affiliate_withdrawals(
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    affiliate_id INTEGER NOT NULL,
    email TEXT,
    customer_name TEXT,
    bank TEXT,
    branch TEXT,
    account_number TEXT,
    amount REAL,
    status TEXT DEFAULT 'PENDING',
    created_at TEXT,
    processed_at TEXT
   )
  `),

  e.DB.prepare(`
   CREATE TABLE IF NOT EXISTS settings(
    key TEXT PRIMARY KEY,
    value TEXT
   )
  `),

  e.DB.prepare(`
   CREATE TABLE IF NOT EXISTS oauth_states(
    state TEXT PRIMARY KEY,
    expires_at INTEGER
   )
  `),

  e.DB.prepare(`
   INSERT OR IGNORE INTO settings(key,value)
   VALUES('commission_rate',?)
  `).bind(String(COMMISSION))

 ]);
}


/* =========================
   HELPERS
========================= */

const clean=x=>String(x??"").trim();

const now=()=>new Date().toISOString();

async function body(r){
 try{
  return await r.json();
 }catch{
  return null;
 }
}

function cors(){

 return{
  "Access-Control-Allow-Origin":SITE,
  "Access-Control-Allow-Credentials":"true",
  "Access-Control-Allow-Headers":"Content-Type,Authorization",
  "Access-Control-Allow-Methods":"GET,POST,OPTIONS"
 };
}

function json(x,s=200){

 return new Response(
  JSON.stringify(x),
  {
   status:s,
   headers:{
    "Content-Type":"application/json",
    ...cors()
   }
  }
 );
}

function token(n=32){

 const a=new Uint8Array(n);

 crypto.getRandomValues(a);

 return [...a]
  .map(x=>x.toString(16).padStart(2,"0"))
  .join("");
}

async function hash(x){

 const h=await crypto.subtle.digest(
  "SHA-256",
  new TextEncoder().encode(x)
 );

 return [...new Uint8Array(h)]
  .map(x=>x.toString(16).padStart(2,"0"))
  .join("");
}

function cookies(r){

 const o={};

 const h=r.headers.get("Cookie")||"";

 h.split(";").forEach(x=>{

  const i=x.indexOf("=");

  if(i>0){

   o[x.slice(0,i).trim()]=
    decodeURIComponent(
     x.slice(i+1).trim()
    );
  }
 });

 return o;
}


