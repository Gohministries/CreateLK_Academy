const SITE="https://createlk.com";
const URL="https://affiliate.createlk.workers.dev";
const ADMIN="gateofheavensl1@gmail.com";

export default{
 async fetch(r,e){
  const p=new URL(r.url).pathname;

  if(p==="/api/health")
   return j({success:true,message:"Affiliate API is running"});

  if(p==="/auth/google")return login(e);
  if(p==="/auth/callback")return callback(r,e);
  if(p==="/auth/logout")return logout(r,e);

  const a=await auth(r,e);

  if(p==="/api/me")
   return j({success:true,logged_in:!!a,affiliate:a||null});

  if(p==="/api/dashboard"){
   if(!a)return j({error:"Login required"},401);
   return dashboard(a,e);
  }

  if(p==="/api/click")
   return click(r,e);

  if(p==="/api/withdraw"){
   if(!a)return j({error:"Login required"},401);
   return withdraw(r,e,a);
  }

  if(p==="/api/withdrawals"){
   if(!a)return j({error:"Login required"},401);
   return withdrawals(e,a);
  }

  if(p==="/internal/referral")
   return referral(r,e);

  if(p==="/internal/commission")
   return commission(r,e);

  return j({error:"Not found"},404);
 }
};


/* LOGIN */

async function login(e){
 const state=crypto.randomUUID();

 return new Response(null,{
  status:302,
  headers:{
   Location:"https://accounts.google.com/o/oauth2/v2/auth?"+
   new URLSearchParams({
    client_id:e.GOOGLE_CLIENT_ID,
    redirect_uri:URL+"/auth/callback",
    response_type:"code",
    scope:"openid email profile",
    state
   }),
   "Set-Cookie":`oauth_state=${state}; Path=/; HttpOnly; Secure; Max-Age=600`
  }
 });
}


/* CALLBACK */

async function callback(r,e){
 const u=new URL(r.url);
 const code=u.searchParams.get("code");
 const state=u.searchParams.get("state");

 if(!code||!state)return j({error:"Invalid login"},400);

 const c=r.headers.get("Cookie")||"";
 if(cookie(c,"oauth_state")!==state)
  return j({error:"Invalid state"},400);

 const t=await fetch("https://oauth2.googleapis.com/token",{
  method:"POST",
  headers:{"Content-Type":"application/x-www-form-urlencoded"},
  body:new URLSearchParams({
   client_id:e.GOOGLE_CLIENT_ID,
   client_secret:e.GOOGLE_CLIENT_SECRET,
   code,
   grant_type:"authorization_code",
   redirect_uri:URL+"/auth/callback"
  })
 });

 const token=await t.json();

 const g=await fetch(
  "https://openidconnect.googleapis.com/v1/userinfo",
  {headers:{Authorization:`Bearer ${token.access_token}`}}
 );

 const x=await g.json();

 let a=await e.DB.prepare(
  "SELECT * FROM affiliates WHERE email=?"
 ).bind(x.email.toLowerCase()).first();

 if(!a){
  const code=await newCode(e);

  await e.DB.prepare(`
   INSERT INTO affiliates
   (google_id,email,name,picture,referral_code,status,created_at,last_active_at)
   VALUES(?,?,?,?,?,'ACTIVE',CURRENT_TIMESTAMP,CURRENT_TIMESTAMP)
  `).bind(
   x.sub,x.email.toLowerCase(),x.name||"",x.picture||"",code
  ).run();

  a=await e.DB.prepare(
   "SELECT * FROM affiliates WHERE email=?"
  ).bind(x.email.toLowerCase()).first();
 }

 const raw=crypto.randomUUID()+crypto.randomUUID();
 const hash=await sha(raw);

 await e.DB.prepare(`
  INSERT INTO affiliate_sessions(token_hash,affiliate_id,expires_at)
  VALUES(?,?,datetime('now','+30 days'))
 `).bind(hash,a.id).run();

 return new Response(null,{
  status:302,
  headers:{
   Location:SITE+"/affiliate",
   "Set-Cookie":
    `affiliate_session=${raw}; Path=/; HttpOnly; Secure; SameSite=Lax; Max-Age=2592000`
  }
 });
}


/* AUTH */

async function auth(r,e){
 const c=r.headers.get("Cookie")||"";
 const raw=cookie(c,"affiliate_session");
 if(!raw)return null;

 return e.DB.prepare(`
  SELECT a.*
  FROM affiliate_sessions s
  JOIN affiliates a ON a.id=s.affiliate_id
  WHERE s.token_hash=?
  AND s.expires_at>datetime('now')
  AND a.status='ACTIVE'
 `).bind(await sha(raw)).first();
}


async function logout(r,e){
 const c=r.headers.get("Cookie")||"";
 const raw=cookie(c,"affiliate_session");

 if(raw)
  await e.DB.prepare(
   "DELETE FROM affiliate_sessions WHERE token_hash=?"
  ).bind(await sha(raw)).run();

 return new Response(null,{
  status:302,
  headers:{
   Location:SITE,
   "Set-Cookie":
    "affiliate_session=; Path=/; Max-Age=0"
  }
 });
}


/* DASHBOARD */

async function dashboard(a,e){
 const c=await e.DB.prepare(`
  SELECT COUNT(*) n FROM affiliate_clicks
  WHERE affiliate_id=?
 `).bind(a.id).first();

 const r=await e.DB.prepare(`
  SELECT COUNT(*) n FROM affiliate_referrals
  WHERE referrer_id=?
 `).bind(a.id).first();

 const m=await e.DB.prepare(`
  SELECT COALESCE(SUM(commission_amount),0) n
  FROM affiliate_commissions
  WHERE referrer_id=? AND status='AVAILABLE'
 `).bind(a.id).first();

 return j({
  success:true,
  affiliate:{
   id:a.id,
   name:a.name,
   email:a.email,
   picture:a.picture||"",
   referral_code:a.referral_code,
   referral_link:
    `${SITE}/?ref=${a.referral_code}`
  },
  stats:{
   clicks:Number(c.n||0),
   referrals:Number(r.n||0),
   commission:Number(m.n||0)
  }
 });
}


/* CLICK */

async function click(r,e){
 const code=new URL(r.url).searchParams.get("ref");
 if(!code)return j({error:"Missing referral code"},400);

 const a=await e.DB.prepare(
  "SELECT id FROM affiliates WHERE referral_code=? AND status='ACTIVE'"
 ).bind(code).first();

 if(!a)return j({error:"Invalid referral code"},404);

 await e.DB.prepare(`
  INSERT INTO affiliate_clicks
  (affiliate_id,referral_code,created_at)
  VALUES(?,?,CURRENT_TIMESTAMP)
 `).bind(a.id,code).run();

 return j({success:true});
}


/* INTERNAL REFERRAL */

async function referral(r,e){
 if(!secure(r,e))return j({error:"Unauthorized"},401);

 const b=await r.json();
 const a=await e.DB.prepare(
  "SELECT id FROM affiliates WHERE referral_code=? AND status='ACTIVE'"
 ).bind(b.referral_code).first();

 if(!a)return j({error:"Invalid referral"},404);

 const old=await e.DB.prepare(
  "SELECT id FROM affiliate_referrals WHERE referred_user_id=?"
 ).bind(b.user_id).first();

 if(old)return j({success:true});

 await e.DB.prepare(`
  INSERT INTO affiliate_referrals
  (referrer_id,referred_user_id,referral_code)
  VALUES(?,?,?)
 `).bind(
  a.id,b.user_id,b.referral_code
 ).run();

 return j({success:true});
}


/* INTERNAL COMMISSION */

async function commission(r,e){
 if(!secure(r,e))return j({error:"Unauthorized"},401);

 const b=await r.json();

 const ref=await e.DB.prepare(`
  SELECT referrer_id FROM affiliate_referrals
  WHERE referred_user_id=?
 `).bind(b.referred_user_id).first();

 if(!ref)return j({success:true,commission_created:false});

 const old=await e.DB.prepare(
  "SELECT id FROM affiliate_commissions WHERE payment_id=?"
 ).bind(b.payment_id).first();

 if(old)return j({success:true,commission_created:false});

 const amount=
  Math.round(Number(b.payment_amount)*.20*100)/100;

 await e.DB.prepare(`
  INSERT INTO affiliate_commissions
  (payment_id,order_id,referrer_id,referred_user_id,
   payment_amount,commission_rate,commission_amount,status)
  VALUES(?,?,?,?,?,?,?,'AVAILABLE')
 `).bind(
  b.payment_id,
  b.order_id,
  ref.referrer_id,
  b.referred_user_id,
  b.payment_amount,
  20,
  amount
 ).run();

 return j({
  success:true,
  commission_created:true,
  commission_amount:amount
 });
}


/* WITHDRAW */

async function withdraw(r,e,a){
 const b=await r.json();

 const m=await e.DB.prepare(`
  SELECT COALESCE(SUM(commission_amount),0) n
  FROM affiliate_commissions
  WHERE referrer_id=? AND status='AVAILABLE'
 `).bind(a.id).first();

 const amount=Number(b.amount||0);

 if(amount<=0||amount>Number(m.n||0))
  return j({error:"Insufficient balance"},400);

 if(!b.bank||!b.branch||!b.account_number)
  return j({error:"Bank details required"},400);

 await e.DB.prepare(`
  INSERT INTO affiliate_withdrawals
  (user_id,email,customer_name,bank,branch,account_number,amount)
  VALUES(?,?,?,?,?,?,?)
 `).bind(
  a.id,a.email,a.name,b.bank,b.branch,b.account_number,amount
 ).run();

 return j({
  success:true,
  message:"Withdrawal request submitted"
 });
}


/* WITHDRAWALS */

async function withdrawals(e,a){
 const x=await e.DB.prepare(`
  SELECT id,amount,status,created_at,processed_at
  FROM affiliate_withdrawals
  WHERE user_id=?
  ORDER BY id DESC
 `).bind(a.id).all();

 return j({
  success:true,
  withdrawals:x.results||[]
 });
}


/* HELPERS */

async function newCode(e){
 for(let i=0;i<10;i++){
  const c="CL"+Math.random().toString(36).slice(2,8).toUpperCase();

  const x=await e.DB.prepare(
   "SELECT id FROM affiliates WHERE referral_code=?"
  ).bind(c).first();

  if(!x)return c;
 }

 return "CL"+Date.now().toString(36).toUpperCase();
}

async function sha(x){
 const b=await crypto.subtle.digest(
  "SHA-256",
  new TextEncoder().encode(x)
 );
 return [...new Uint8Array(b)]
  .map(x=>x.toString(16).padStart(2,"0")).join("");
}

function cookie(s,n){
 const x=s.split(";").find(x=>x.trim().startsWith(n+"="));
 return x?x.trim().slice(n.length+1):null;
}

function secure(r,e){
 return r.headers.get("Authorization")===
  `Bearer ${e.INTERNAL_SECRET}`;
}

function j(x,status=200){
 return new Response(JSON.stringify(x),{
  status,
  headers:{
   "Content-Type":"application/json",
   "Access-Control-Allow-Origin":SITE,
   "Access-Control-Allow-Credentials":"true"
  }
 });
}