const SITE = "https://createlk.com";
const AFFILIATE_URL = "https://affiliate.createlk.workers.dev";
const ADMIN = "gateofheavensl1@gmail.com";

export default {
  async fetch(r, e) {
    const p = new URL(r.url).pathname;

    try {
      if (r.method === "OPTIONS") {
        return new Response(null, {
          status: 204,
          headers: cors()
        });
      }

      if (p === "/api/health") {
        return json({
          success: true,
          message: "Affiliate API is running"
        }, r);
      }

      if (p === "/auth/google") {
        return googleLogin(e);
      }

      if (p === "/auth/callback") {
        return googleCallback(r, e);
      }

      if (p === "/auth/logout") {
        return logout(r, e);
      }

      if (p === "/api/me") {
        const a = await affiliate(r, e);

        if (!a) {
          return json({
            success: true,
            logged_in: false
          }, r);
        }

        return json({
          success: true,
          logged_in: true,
          affiliate: a
        }, r);
      }

      if (p === "/api/dashboard") {
        return dashboard(r, e);
      }

      if (p === "/api/click") {
        return click(r, e);
      }

      if (p === "/api/withdraw") {
        return withdraw(r, e);
      }

      if (p === "/api/withdrawals") {
        return withdrawals(r, e);
      }

      if (p === "/internal/referral") {
        return internalReferral(r, e);
      }

      if (p === "/internal/commission") {
        return internalCommission(r, e);
      }

      return json({
        success: false,
        error: "Not found"
      }, r, 404);

    } catch (err) {
      console.error("AFFILIATE ERROR:", err);

      return json({
        success: false,
        error: "Server error",
        message: String(err?.message || err)
      }, r, 500);
    }
  }
};


/* =========================
   CORS
========================= */

function cors() {
  return {
    "Access-Control-Allow-Origin": SITE,
    "Access-Control-Allow-Headers":
      "Content-Type, Authorization",
    "Access-Control-Allow-Methods":
      "GET,POST,OPTIONS",
    "Access-Control-Allow-Credentials": "true"
  };
}


/* =========================
   JSON
========================= */

function json(data, r, status = 200) {
  return new Response(
    JSON.stringify(data),
    {
      status,
      headers: {
        "Content-Type": "application/json",
        ...cors()
      }
    }
  );
}


/* =========================
   GOOGLE LOGIN
========================= */

function googleLogin(e) {
  const u = new URL(
    "https://accounts.google.com/o/oauth2/v2/auth"
  );

  u.searchParams.set(
    "client_id",
    e.GOOGLE_CLIENT_ID
  );

  u.searchParams.set(
    "redirect_uri",
    AFFILIATE_URL + "/auth/callback"
  );

  u.searchParams.set(
    "response_type",
    "code"
  );

  u.searchParams.set(
    "scope",
    "openid email profile"
  );

  u.searchParams.set(
    "access_type",
    "online"
  );

  return Response.redirect(u.toString(), 302);
}


/* =========================
   GOOGLE CALLBACK
========================= */

async function googleCallback(r, e) {
  const u = new URL(r.url);
  const code = u.searchParams.get("code");

  if (!code) {
    return new Response(
      "Google login failed: missing code",
      { status: 400 }
    );
  }

  const tokenRes = await fetch(
    "https://oauth2.googleapis.com/token",
    {
      method: "POST",
      headers: {
        "Content-Type":
          "application/x-www-form-urlencoded"
      },
      body: new URLSearchParams({
        code,
        client_id: e.GOOGLE_CLIENT_ID,
        client_secret: e.GOOGLE_CLIENT_SECRET,
        redirect_uri:
          AFFILIATE_URL + "/auth/callback",
        grant_type: "authorization_code"
      })
    }
  );

  const token = await tokenRes.json();

  if (!token.access_token) {
    console.error("GOOGLE TOKEN ERROR", token);

    return new Response(
      "Google authentication failed",
      { status: 401 }
    );
  }

  const userRes = await fetch(
    "https://openidconnect.googleapis.com/v1/userinfo",
    {
      headers: {
        Authorization:
          `Bearer ${token.access_token}`
      }
    }
  );

  const g = await userRes.json();

  if (!g.email) {
    return new Response(
      "Google account email unavailable",
      { status: 400 }
    );
  }

  let a = await e.DB.prepare(`
    SELECT *
    FROM affiliates
    WHERE google_id = ? OR email = ?
    LIMIT 1
  `)
    .bind(g.sub, g.email)
    .first();

  const now = new Date().toISOString();

  if (!a) {
    const code = await createReferralCode(e);

    const result = await e.DB.prepare(`
      INSERT INTO affiliates
      (
        google_id,
        email,
        name,
        picture,
        referral_code,
        status,
        created_at,
        last_active_at
      )
      VALUES (?, ?, ?, ?, ?, 'ACTIVE', ?, ?)
    `)
      .bind(
        g.sub,
        g.email,
        g.name || "",
        g.picture || "",
        code,
        now,
        now
      )
      .run();

    a = await e.DB.prepare(`
      SELECT *
      FROM affiliates
      WHERE id = ?
    `)
      .bind(result.meta.last_row_id)
      .first();

  } else {

    await e.DB.prepare(`
      UPDATE affiliates
      SET
        google_id = ?,
        name = ?,
        picture = ?,
        last_active_at = ?
      WHERE id = ?
    `)
      .bind(
        g.sub,
        g.name || "",
        g.picture || "",
        now,
        a.id
      )
      .run();

    a = await e.DB.prepare(`
      SELECT *
      FROM affiliates
      WHERE id = ?
    `)
      .bind(a.id)
      .first();
  }

  if (a.status !== "ACTIVE") {
    return new Response(
      "Affiliate account is not active",
      { status: 403 }
    );
  }

  const rawToken = crypto.randomUUID() +
    crypto.randomUUID();

  const tokenHash =
    await sha256(rawToken);

  const expires =
    new Date(Date.now() + 30 * 24 * 60 * 60 * 1000)
      .toISOString();

  await e.DB.prepare(`
    INSERT OR REPLACE INTO affiliate_sessions
    (
      token_hash,
      affiliate_id,
      expires_at
    )
    VALUES (?, ?, ?)
  `)
    .bind(
      tokenHash,
      a.id,
      expires
    )
    .run();

  return new Response(null, {
    status: 302,
    headers: {
      Location: SITE + "/affiliate",
      "Set-Cookie":
        `affiliate_session=${rawToken}; Path=/; HttpOnly; Secure; SameSite=Lax; Max-Age=2592000`,
      ...cors()
    }
  });
}


/* =========================
   LOGOUT
========================= */

async function logout(r, e) {
  const token = getCookie(
    r,
    "affiliate_session"
  );

  if (token) {
    const hash =
      await sha256(token);

    await e.DB.prepare(`
      DELETE FROM affiliate_sessions
      WHERE token_hash = ?
    `)
      .bind(hash)
      .run();
  }

  return new Response(null, {
    status: 302,
    headers: {
      Location: SITE + "/",
      "Set-Cookie":
        "affiliate_session=; Path=/; HttpOnly; Secure; SameSite=Lax; Max-Age=0",
      ...cors()
    }
  });
}


/* =========================
   AFFILIATE AUTH
========================= */

async function affiliate(r, e) {
  const token = getCookie(
    r,
    "affiliate_session"
  );

  if (!token) return null;

  const hash =
    await sha256(token);

  const row = await e.DB.prepare(`
    SELECT
      a.*
    FROM affiliate_sessions s
    JOIN affiliates a
      ON a.id = s.affiliate_id
    WHERE s.token_hash = ?
      AND s.expires_at > ?
      AND a.status = 'ACTIVE'
    LIMIT 1
  `)
    .bind(
      hash,
      new Date().toISOString()
    )
    .first();

  return row || null;
}


