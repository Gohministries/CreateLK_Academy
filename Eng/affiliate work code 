/* =========================
   INTERNAL REFERRAL
   Called by ENG
========================= */

async function internalReferral(r, e) {
  if (!authorized(r, e)) {
    return json({
      success: false,
      error: "Unauthorized"
    }, r, 401);
  }

  const b =
    await r.json().catch(() => ({}));

  const userId =
    Number(b.user_id || 0);

  const code =
    String(b.referral_code || "").trim();

  if (!userId || !code) {
    return json({
      success: false,
      error: "user_id and referral_code required"
    }, r, 400);
  }

  const a =
    await e.DB.prepare(`
      SELECT id
      FROM affiliates
      WHERE referral_code = ?
        AND status = 'ACTIVE'
      LIMIT 1
    `)
      .bind(code)
      .first();

  if (!a) {
    return json({
      success: false,
      error: "Invalid referral code"
    }, r, 404);
  }

  if (Number(a.id) === userId) {
    return json({
      success: false,
      error: "Self referral not allowed"
    }, r, 400);
  }

  const existing =
    await e.DB.prepare(`
      SELECT id
      FROM affiliate_referrals
      WHERE referred_user_id = ?
      LIMIT 1
    `)
      .bind(userId)
      .first();

  if (existing) {
    return json({
      success: true,
      already_exists: true
    }, r);
  }

  await e.DB.prepare(`
    INSERT INTO affiliate_referrals
    (
      referrer_id,
      referred_user_id,
      referral_code,
      created_at
    )
    VALUES (?, ?, ?, ?)
  `)
    .bind(
      a.id,
      userId,
      code,
      new Date().toISOString()
    )
    .run();

  return json({
    success: true
  }, r);
}


/* =========================
   INTERNAL COMMISSION
   Called by PAY
========================= */

async function internalCommission(r, e) {
  if (!authorized(r, e)) {
    return json({
      success: false,
      error: "Unauthorized"
    }, r, 401);
  }

  const b =
    await r.json().catch(() => ({}));

  const paymentId =
    Number(b.payment_id || 0);

  const orderId =
    String(b.order_id || "").trim();

  const referredUserId =
    Number(b.referred_user_id || 0);

  const paymentAmount =
    Number(b.payment_amount || 0);

  if (
    !paymentId ||
    !orderId ||
    !referredUserId ||
    !paymentAmount
  ) {
    return json({
      success: false,
      error: "Missing payment details"
    }, r, 400);
  }

  const referral =
    await e.DB.prepare(`
      SELECT *
      FROM affiliate_referrals
      WHERE referred_user_id = ?
      LIMIT 1
    `)
      .bind(referredUserId)
      .first();

  if (!referral) {
    return json({
      success: true,
      commission_created: false,
      reason: "No referral"
    }, r);
  }

  const existing =
    await e.DB.prepare(`
      SELECT id
      FROM affiliate_commissions
      WHERE payment_id = ?
      LIMIT 1
    `)
      .bind(paymentId)
      .first();

  if (existing) {
    return json({
      success: true,
      commission_created: false,
      already_exists: true
    }, r);
  }

  const rate = 20;
  const commission =
    Math.round(
      paymentAmount * rate / 100 * 100
    ) / 100;

  await e.DB.prepare(`
    INSERT INTO affiliate_commissions
    (
      payment_id,
      order_id,
      referrer_id,
      referred_user_id,
      payment_amount,
      commission_rate,
      commission_amount,
      status,
      created_at
    )
    VALUES (?, ?, ?, ?, ?, ?, ?, 'AVAILABLE', ?)
  `)
    .bind(
      paymentId,
      orderId,
      referral.referrer_id,
      referredUserId,
      paymentAmount,
      rate,
      commission,
      new Date().toISOString()
    )
    .run();

  return json({
    success: true,
    commission_created: true,
    commission_amount: commission
  }, r);
}


/* =========================
   WITHDRAW
========================= */

async function withdraw(r, e) {
  const a = await affiliate(r, e);

  if (!a) {
    return json({
      success: false,
      error: "Login required"
    }, r, 401);
  }

  const b =
    await r.json().catch(() => ({}));

  const amount =
    Number(b.amount || 0);

  const bank =
    String(b.bank || "").trim();

  const branch =
    String(b.branch || "").trim();

  const accountNumber =
    String(b.account_number || "").trim();

  if (
    amount <= 0 ||
    !bank ||
    !branch ||
    !accountNumber
  ) {
    return json({
      success: false,
      error:
        "Amount, bank, branch and account number are required"
    }, r, 400);
  }

  const available =
    await e.DB.prepare(`
      SELECT
        COALESCE(SUM(commission_amount), 0) AS total
      FROM affiliate_commissions
      WHERE referrer_id = ?
        AND status = 'AVAILABLE'
    `)
      .bind(a.id)
      .first();

  const balance =
    Number(available?.total || 0);

  if (amount > balance) {
    return json({
      success: false,
      error: "Insufficient balance",
      balance
    }, r, 400);
  }

  await e.DB.prepare(`
    INSERT INTO affiliate_withdrawals
    (
      user_id,
      email,
      customer_name,
      bank,
      branch,
      account_number,
      amount,
      status,
      created_at
    )
    VALUES (?, ?, ?, ?, ?, ?, ?, 'PENDING', ?)
  `)
    .bind(
      a.id,
      a.email,
      a.name,
      bank,
      branch,
      accountNumber,
      amount,
      new Date().toISOString()
    )
    .run();

  return json({
    success: true,
    status: "PENDING",
    amount
  }, r);
}


