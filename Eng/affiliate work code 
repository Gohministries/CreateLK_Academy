async function commissionRate(e){

 const x=await e.DB.prepare(`
  SELECT value
  FROM settings
  WHERE key='commission_rate'
 `).first();

 return Number(
  x?.value||
  COMMISSION
 );
}


/* =========================
   CLICK TRACKING
========================= */

async function click(r,e){

 const b=await body(r);

 const code=
  clean(b?.referral_code)
   .toUpperCase();

 if(!code)
  return json({
   success:false,
   error:"Referral code required"
  },400);


 const a=await e.DB.prepare(`
  SELECT id,status
  FROM affiliates
  WHERE referral_code=?
  LIMIT 1
 `).bind(code).first();


 if(!a||a.status!=="ACTIVE")
  return json({
   success:false,
   error:"Invalid referral code"
  },404);


 await e.DB.prepare(`
  INSERT INTO affiliate_clicks(
   affiliate_id,
   referral_code,
   created_at
  )
  VALUES(?,?,?)
 `).bind(
  a.id,
  code,
  now()
 ).run();


 return json({
  success:true
 });
}


/* =========================
   INTERNAL COMMISSION
   PAY WORKER ONLY
========================= */

async function internalCommission(r,e){

 if(r.method!=="POST")
  return err("POST required",405);


 const secret=
  e.AFFILIATE_INTERNAL_SECRET;

 if(!secret)
  return err(
   "Affiliate internal secret is not configured",
   500
  );


 if(
  r.headers.get("Authorization")!==
  `Bearer ${secret}`
 )
  return err("Unauthorized",401);


 const b=await body(r);

 const paymentId=
  Number(b?.payment_id||0);

 const code=
  clean(b?.referral_code)
   .toUpperCase();

 const customerEmail=
  clean(b?.customer_email)
   .toLowerCase();

 const amount=
  Number(b?.amount||0);


 if(!paymentId)
  return err("Invalid payment_id",400);

 if(!code)
  return err("Referral code required",400);

 if(!Number.isFinite(amount)||amount<=0)
  return err("Invalid payment amount",400);


 /* Prevent duplicate commission */

 const existing=
  await e.DB.prepare(`
   SELECT *
   FROM affiliate_commissions
   WHERE payment_id=?
   LIMIT 1
  `).bind(paymentId).first();


 if(existing){

  return json({
   success:true,
   duplicate:true,
   commission_id:existing.id,
   commission_amount:
    Number(existing.commission_amount||0),
   message:"Commission already exists"
  });
 }


 /* Find affiliate */

 const a=await e.DB.prepare(`
  SELECT id,email,name,status
  FROM affiliates
  WHERE referral_code=?
  LIMIT 1
 `).bind(code).first();


 if(!a)
  return err(
   "Affiliate not found",
   404
  );


 if(a.status!=="ACTIVE")
  return err(
   "Affiliate account is not active",
   400
  );


 /* Server-side commission calculation */

 const rate=
  await commissionRate(e);

 const commission=
  Math.round(
   amount*
   rate
  )/100;


 const x=await e.DB.prepare(`
  INSERT INTO affiliate_commissions(
   payment_id,
   affiliate_id,
   customer_email,
   referral_code,
   payment_amount,
   commission_rate,
   commission_amount,
   status,
   created_at
  )
  VALUES(?,?,?,?,?,?,?,?,?)
 `).bind(
  paymentId,
  a.id,
  customerEmail,
  code,
  amount,
  rate,
  commission,
  "APPROVED",
  now()
 ).run();


 return json({

  success:true,

  duplicate:false,

  commission_id:
   x.meta.last_row_id,

  affiliate_id:
   a.id,

  referral_code:
   code,

  payment_id:
   paymentId,

  payment_amount:
   amount,

  commission_rate:
   rate,

  commission_amount:
   commission,

  status:
   "APPROVED"
 });
}


/* =========================
   WITHDRAWAL
========================= */

async function withdrawal(r,e){

 const a=await currentUser(r,e);

 if(!a)
  return json({
   success:false,
   error:"Login required"
  },401);


 const b=await body(r);

 const bank=
  clean(b?.bank);

 const branch=
  clean(b?.branch);

 const account=
  clean(b?.account);

 const amount=
  Number(b?.amount||0);


 if(!bank||!branch||!account)
  return err(
   "Bank details required",
   400
  );


 if(
  !Number.isFinite(amount)||
  amount<MIN_WITHDRAW
 )
  return err(
   `Minimum withdrawal is Rs. ${MIN_WITHDRAW}`,
   400
  );


 const commissions=await e.DB.prepare(`
  SELECT
   COALESCE(
    SUM(
     CASE
      WHEN status='APPROVED'
      THEN commission_amount
      ELSE 0
     END
    ),0
   ) total
  FROM affiliate_commissions
  WHERE affiliate_id=?
 `).bind(a.id).first();


 const paid=await e.DB.prepare(`
  SELECT
   COALESCE(SUM(amount),0) total
  FROM affiliate_withdrawals
  WHERE affiliate_id=?
  AND status IN ('APPROVED','PAID')
 `).bind(a.id).first();


 const pending=await e.DB.prepare(`
  SELECT
   COALESCE(SUM(amount),0) total
  FROM affiliate_withdrawals
  WHERE affiliate_id=?
  AND status='PENDING'
 `).bind(a.id).first();


 const available=Math.max(
  0,
  Number(commissions?.total||0)-
  Number(paid?.total||0)-
  Number(pending?.total||0)
 );


 if(amount>available)
  return err(
   "Insufficient available balance",
   400
  );


 const x=await e.DB.prepare(`
  INSERT INTO affiliate_withdrawals(
   affiliate_id,
   email,
   customer_name,
   bank,
   branch,
   account_number,
   amount,
   status,
   created_at
  )
  VALUES(?,?,?,?,?,?,?,?,?)
 `).bind(
  a.id,
  a.email,
  a.name||"",
  bank,
  branch,
  account,
  amount,
  "PENDING",
  now()
 ).run();


 return json({

  success:true,

  withdrawal_id:
   x.meta.last_row_id,

  status:
   "PENDING",

  amount
 });
}


/* =========================
   LOGOUT
========================= */

async function logout(r,e){

 const s=cookies(r)[SES];

 if(s){

  await e.DB.prepare(`
   DELETE FROM affiliate_sessions
   WHERE token_hash=?
  `).bind(
   await hash(s)
  ).run();
 }


 return new Response(null,{
  status:302,

  headers:{
   Location:AFFILIATE_HOME,

   "Set-Cookie":
    `${SES}=;Path=/;HttpOnly;Secure;SameSite=None;Max-Age=0`
  }
 });
}