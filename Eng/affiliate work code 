/* =========================
   AFFILIATE DASHBOARD
========================= */

async function dashboard(r,e){

 const a=await currentUser(r,e);

 if(!a)
  return json({
   success:false,
   error:"Login required"
  },401);


 const clicks=await e.DB.prepare(`
  SELECT COUNT(*) n
  FROM affiliate_clicks
  WHERE affiliate_id=?
 `).bind(a.id).first();


 const referred=await e.DB.prepare(`
  SELECT COUNT(*) n
  FROM affiliate_referrals
  WHERE affiliate_id=?
 `).bind(a.id).first();


 const commissions=await e.DB.prepare(`
  SELECT
   COALESCE(
    SUM(
     CASE
      WHEN status='APPROVED'
      THEN commission_amount
      ELSE 0
     END
    ),0
   ) total
  FROM affiliate_commissions
  WHERE affiliate_id=?
 `).bind(a.id).first();


 const paid=await e.DB.prepare(`
  SELECT
   COALESCE(SUM(amount),0) total
  FROM affiliate_withdrawals
  WHERE affiliate_id=?
  AND status IN ('APPROVED','PAID')
 `).bind(a.id).first();


 const pending=await e.DB.prepare(`
  SELECT
   COALESCE(SUM(amount),0) total
  FROM affiliate_withdrawals
  WHERE affiliate_id=?
  AND status='PENDING'
 `).bind(a.id).first();


 const rows=await e.DB.prepare(`
  SELECT
   id,
   customer_email,
   referral_code,
   payment_amount,
   commission_rate,
   commission_amount,
   status,
   created_at
  FROM affiliate_commissions
  WHERE affiliate_id=?
  ORDER BY id DESC
  LIMIT 100
 `).bind(a.id).all();


 const total=
  Number(commissions?.total||0);

 const paidAmount=
  Number(paid?.total||0);

 const pendingAmount=
  Number(pending?.total||0);

 const balance=Math.max(
  0,
  total-
  paidAmount-
  pendingAmount
 );


 return json({

  success:true,

  user_id:a.id,

  name:a.name||"",

  email:a.email,

  picture:a.picture||"",

  referral_code:a.referral_code,

  affiliate_link:
   `${SITE}/Eng/?ref=${encodeURIComponent(a.referral_code)}`,

  clicks:
   Number(clicks?.n||0),

  referred_users:
   Number(referred?.n||0),

  total_commission:
   total,

  paid:
   paidAmount,

  pending_withdrawal:
   pendingAmount,

  available_balance:
   balance,

  commission_rate:
   await commissionRate(e),

  minimum_withdrawal:
   MIN_WITHDRAW,

  commissions:
   rows.results||[]
 });
}


