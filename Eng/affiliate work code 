/* =========================
   REFERRAL CODE
========================= */

async function createReferralCode(e) {
  for (let i = 0; i < 10; i++) {
    const code =
      "CL" +
      crypto.randomUUID()
        .replace(/-/g, "")
        .slice(0, 8)
        .toUpperCase();

    const exists =
      await e.DB.prepare(`
        SELECT id
        FROM affiliates
        WHERE referral_code = ?
        LIMIT 1
      `)
        .bind(code)
        .first();

    if (!exists) return code;
  }

  throw new Error(
    "Could not create referral code"
  );
}


/* =========================
   INTERNAL AUTH
========================= */

function authorized(r, e) {
  const auth =
    r.headers.get("Authorization") || "";

  return auth ===
    `Bearer ${e.INTERNAL_SECRET}`;
}


/* =========================
   COOKIE
========================= */

function getCookie(r, name) {
  const header =
    r.headers.get("Cookie") || "";

  const parts =
    header.split(";");

  for (const part of parts) {
    const [k, ...v] =
      part.trim().split("=");

    if (k === name) {
      return decodeURIComponent(
        v.join("=")
      );
    }
  }

  return null;
}


/* =========================
   SHA256
========================= */

async function sha256(value) {
  const data =
    new TextEncoder().encode(value);

  const hash =
    await crypto.subtle.digest(
      "SHA-256",
      data
    );

  return [...new Uint8Array(hash)]
    .map(
      x => x.toString(16).padStart(2, "0")
    )
    .join("");
}