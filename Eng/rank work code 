const RESET_TABLE="leaderboard_monthly_resets";
const COINS=5,XP=10;

export default{
 async fetch(r,e){
  try{
   if(r.method==="OPTIONS")
    return new Response(null,{
     status:204,
     headers:corsHeaders()
    });

   const p=new URL(r.url).pathname;

   if(p==="/api/health")
    return json({
     success:true,
     message:"Leaderboard Reset API is running"
    });

   if(p==="/api/leaderboard"&&r.method==="GET")
    return leaderboard(e);

   if(p==="/api/reset"&&r.method==="POST"){
    const secret=r.headers.get("Authorization");

    if(secret!==`Bearer ${e.RESET_SECRET}`)
     return json({
      success:false,
      error:"Unauthorized"
     },401);

    return reset(e);
   }

   return json({
    success:false,
    error:"Not found"
   },404);

  }catch(x){
   return json({
    success:false,
    error:x.message||"Server error"
   },500);
  }
 },

 async scheduled(event,e,ctx){
  ctx.waitUntil(reset(e));
 }
};

function corsHeaders(){
 return{
  "Access-Control-Allow-Origin":"https://createlk.com",
  "Access-Control-Allow-Headers":"Content-Type,Authorization",
  "Access-Control-Allow-Methods":"GET,POST,OPTIONS"
 };
}

function json(x,s=200){
 return new Response(JSON.stringify(x),{
  status:s,
  headers:{
   "Content-Type":"application/json",
   ...corsHeaders()
  }
 });
}

function period(){
 const d=new Date();
 const y=d.getUTCFullYear();
 const m=d.getUTCMonth();

 const start=new Date(
  Date.UTC(y,m,1)
 ).toISOString();

 const end=new Date(
  Date.UTC(y,m+1,1)
 ).toISOString();

 const name=new Date(
  Date.UTC(y,m,1)
 ).toLocaleString(
  "en-US",
  {
   month:"long",
   year:"numeric",
   timeZone:"UTC"
  }
 );

 return{start,end,name};
}

async function leaderboard(e){
 if(!e.DB)
  throw Error("D1 binding DB is missing");

 const p=period();

 const x=await e.DB.prepare(`
  SELECT
   u.id user_id,
   u.name,
   u.picture,
   COALESCE(SUM(q.score*?),0) points
  FROM users u
  JOIN quiz_results q
   ON q.user_id=u.id
  WHERE u.membership_status='PREMIUM'
    AND u.membership_expiry IS NOT NULL
    AND datetime(u.membership_expiry)>datetime('now')
    AND q.completed_at>=?
    AND q.completed_at<?
  GROUP BY
   u.id,
   u.name,
   u.picture
  ORDER BY
   points DESC,
   u.name ASC
  LIMIT 100
 `).bind(
  COINS,
  p.start,
  p.end
 ).all();

 return json({
  success:true,
  month:p.name,
  leaderboard:(x.results||[]).map((v,i)=>({
   rank:i+1,
   user_id:v.user_id,
   name:v.name,
   picture:v.picture||"",
   points:Number(v.points||0)
  }))
 });
}

async function reset(e){
 if(!e.DB)
  throw Error("D1 binding DB is missing");

 await e.DB.prepare(`
  CREATE TABLE IF NOT EXISTS ${RESET_TABLE}(
   id INTEGER PRIMARY KEY AUTOINCREMENT,
   month TEXT UNIQUE,
   reset_at TEXT
  )
 `).run();

 const now=new Date();

 const year=now.getUTCFullYear();
 const month=String(
  now.getUTCMonth()+1
 ).padStart(2,"0");

 const key=`${year}-${month}`;

 const old=await e.DB.prepare(`
  SELECT id
  FROM ${RESET_TABLE}
  WHERE month=?
 `).bind(key).first();

 if(old)
  return json({
   success:true,
   reset:false,
   month:key,
   message:"Monthly leaderboard already initialized"
  });

 const archivedAt=now.toISOString();

 await e.DB.prepare(`
  INSERT INTO ${RESET_TABLE}(
   month,
   reset_at
  )
  VALUES(?,?)
 `).bind(
  key,
  archivedAt
 ).run();

 return json({
  success:true,
  reset:true,
  month:key,
  reset_at:archivedAt
 });
}