<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>CreateLK AI English | Learn English with AI</title>

<meta name="description"
content="CreateLK AI English - Learn English with AI, practice MCQs, improve grammar, vocabulary and English skills.">

<meta name="theme-color" content="#2563eb">

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:Arial,Helvetica,sans-serif;
    background:#f5f7fb;
    color:#172033;
    line-height:1.6;
}

a{
    text-decoration:none;
    color:inherit;
}

button{
    font-family:inherit;
}

/* NAVBAR */

.navbar{
    position:sticky;
    top:0;
    z-index:1000;
    background:rgba(255,255,255,.96);
    backdrop-filter:blur(10px);
    border-bottom:1px solid #e5e7eb;
}

.nav-container{
    max-width:1150px;
    margin:auto;
    padding:14px 20px;
    display:flex;
    align-items:center;
    justify-content:space-between;
}

.logo{
    font-size:22px;
    font-weight:800;
    color:#2563eb;
}

.logo span{
    color:#111827;
}

.nav-links{
    display:flex;
    align-items:center;
    gap:20px;
}

.nav-links a{
    font-size:14px;
    font-weight:600;
    color:#374151;
}

.nav-links a:hover{
    color:#2563eb;
}

.login-btn{
    background:#2563eb;
    color:white !important;
    padding:9px 17px;
    border-radius:9px;
}

.menu-btn{
    display:none;
    border:0;
    background:none;
    font-size:25px;
    cursor:pointer;
}

/* HERO */

.hero{
    background:linear-gradient(135deg,#eff6ff,#ffffff);
    padding:75px 20px 70px;
}

.hero-container{
    max-width:1150px;
    margin:auto;
    display:grid;
    grid-template-columns:1.1fr .9fr;
    gap:50px;
    align-items:center;
}

.badge{
    display:inline-block;
    background:#dbeafe;
    color:#1d4ed8;
    padding:7px 13px;
    border-radius:30px;
    font-size:13px;
    font-weight:700;
    margin-bottom:18px;
}

.hero h1{
    font-size:52px;
    line-height:1.1;
    margin-bottom:20px;
}

.hero h1 span{
    color:#2563eb;
}

.hero p{
    color:#5b6473;
    font-size:18px;
    max-width:650px;
    margin-bottom:28px;
}

.hero-buttons{
    display:flex;
    gap:12px;
    flex-wrap:wrap;
}

.primary-btn,
.secondary-btn{
    display:inline-block;
    padding:13px 22px;
    border-radius:10px;
    font-weight:700;
    border:0;
    cursor:pointer;
}

.primary-btn{
    background:#2563eb;
    color:white;
}

.primary-btn:hover{
    background:#1d4ed8;
}

.secondary-btn{
    background:white;
    color:#2563eb;
    border:1px solid #bfdbfe;
}

.hero-card{
    background:white;
    border-radius:22px;
    padding:25px;
    box-shadow:0 15px 45px rgba(37,99,235,.12);
    border:1px solid #e5e7eb;
}

.ai-header{
    display:flex;
    align-items:center;
    gap:12px;
    margin-bottom:20px;
}

.ai-icon{
    width:48px;
    height:48px;
    border-radius:14px;
    background:#2563eb;
    color:white;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:23px;
}

.ai-header h3{
    font-size:19px;
}

.ai-header small{
    color:#6b7280;
}

.question{
    background:#f8fafc;
    border-radius:14px;
    padding:18px;
    margin-bottom:14px;
}

.question strong{
    display:block;
    margin-bottom:12px;
}

.option{
    padding:10px 12px;
    background:white;
    border:1px solid #e5e7eb;
    border-radius:8px;
    margin-top:8px;
    font-size:14px;
}

.option.correct{
    border-color:#22c55e;
    background:#f0fdf4;
}

/* SECTION */

section{
    padding:65px 20px;
}

.container{
    max-width:1150px;
    margin:auto;
}

.section-title{
    text-align:center;
    margin-bottom:38px;
}

.section-title h2{
    font-size:34px;
    margin-bottom:8px;
}

.section-title p{
    color:#6b7280;
}

/* FEATURES */

.features{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:20px;
}

.feature{
    background:white;
    padding:27px;
    border-radius:16px;
    border:1px solid #e5e7eb;
    transition:.2s;
}

.feature:hover{
    transform:translateY(-4px);
    box-shadow:0 10px 30px rgba(0,0,0,.06);
}

.feature-icon{
    width:48px;
    height:48px;
    display:flex;
    align-items:center;
    justify-content:center;
    background:#eff6ff;
    border-radius:12px;
    font-size:23px;
    margin-bottom:16px;
}

.feature h3{
    margin-bottom:8px;
}

.feature p{
    color:#6b7280;
    font-size:14px;
}

/* COURSES */

.courses{
    background:#eef4ff;
}

.course-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:20px;
}

.course{
    background:white;
    border-radius:17px;
    overflow:hidden;
    border:1px solid #e5e7eb;
}

.course-top{
    padding:25px;
    background:#2563eb;
    color:white;
}

.course:nth-child(2) .course-top{
    background:#7c3aed;
}

.course:nth-child(3) .course-top{
    background:#059669;
}

.course-top h3{
    font-size:21px;
    margin-bottom:5px;
}

.course-body{
    padding:22px;
}

.course-body p{
    color:#6b7280;
    font-size:14px;
    margin-bottom:17px;
}

.course-body a{
    color:#2563eb;
    font-weight:700;
}

/* AI */

.ai-section{
    background:#111827;
    color:white;
}

.ai-content{
    max-width:900px;
    margin:auto;
    text-align:center;
}

.ai-content h2{
    font-size:38px;
    margin-bottom:14px;
}

.ai-content p{
    color:#cbd5e1;
    margin-bottom:25px;
}

/* PREMIUM */

.premium-card{
    max-width:650px;
    margin:auto;
    background:white;
    border-radius:22px;
    padding:35px;
    text-align:center;
    border:1px solid #dbeafe;
    box-shadow:0 15px 40px rgba(37,99,235,.1);
}

.price{
    font-size:42px;
    font-weight:800;
    color:#2563eb;
    margin:12px 0;
}

.price small{
    font-size:15px;
    color:#6b7280;
    font-weight:normal;
}

.premium-list{
    list-style:none;
    text-align:left;
    max-width:400px;
    margin:22px auto;
}

.premium-list li{
    padding:8px 0;
}

.premium-list li::before{
    content:"✓";
    color:#16a34a;
    font-weight:bold;
    margin-right:9px;
}

/* CTA */

.cta{
    background:#2563eb;
    color:white;
    text-align:center;
}

.cta h2{
    font-size:34px;
    margin-bottom:10px;
}

.cta p{
    color:#dbeafe;
    margin-bottom:23px;
}

.cta .primary-btn{
    background:white;
    color:#2563eb;
}

/* FOOTER */

footer{
    background:#111827;
    color:#cbd5e1;
    padding:35px 20px;
}

.footer-container{
    max-width:1150px;
    margin:auto;
    display:grid;
    grid-template-columns:2fr 1fr 1fr;
    gap:35px;
}

.footer-logo{
    color:white;
    font-size:21px;
    font-weight:800;
    margin-bottom:10px;
}

footer p{
    font-size:14px;
    color:#9ca3af;
}

footer h4{
    color:white;
    margin-bottom:10px;
}

.footer-links a{
    display:block;
    font-size:14px;
    margin:7px 0;
    color:#cbd5e1;
}

.copyright{
    max-width:1150px;
    margin:30px auto 0;
    padding-top:20px;
    border-top:1px solid #374151;
    text-align:center;
    font-size:13px;
    color:#9ca3af;
}

/* MOBILE */

@media(max-width:800px){

    .nav-links{
        position:absolute;
        top:62px;
        left:0;
        right:0;
        background:white;
        display:none;
        flex-direction:column;
        padding:20px;
        border-bottom:1px solid #e5e7eb;
    }

    .nav-links.active{
        display:flex;
    }

    .menu-btn{
        display:block;
    }

    .hero{
        padding:50px 20px;
    }

    .hero-container{
        grid-template-columns:1fr;
        gap:35px;
    }

    .hero h1{
        font-size:38px;
    }

    .hero p{
        font-size:16px;
    }

    .features,
    .course-grid{
        grid-template-columns:1fr;
    }

    .footer-container{
        grid-template-columns:1fr;
    }

    .section-title h2,
    .ai-content h2,
    .cta h2{
        font-size:28px;
    }
}

@media(max-width:450px){

    .hero h1{
        font-size:34px;
    }

    .hero-buttons{
        flex-direction:column;
    }

    .primary-btn,
    .secondary-btn{
        text-align:center;
        width:100%;
    }

    .premium-card{
        padding:25px 18px;
    }
}
</style>
</head>

