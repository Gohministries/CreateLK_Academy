```html
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#101d3a">
  <title>CreateLK Academy | English Grammar Practice</title>
  <meta name="description" content="Improve your English grammar with interactive multiple-choice questions at CreateLK Academy.">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://accounts.google.com/gsi/client" async defer></script>

  <style>
    :root {
      --navy: #101d3a;
      --blue: #2458a6;
      --blue-light: #eaf1ff;
      --gold: #e7b84b;
      --white: #ffffff;
      --text: #243047;
      --muted: #6d7890;
      --background: #f5f7fc;
      --border: #e5eaf3;
      --green: #16845b;
      --red: #c63d46;
      --shadow: 0 12px 35px rgba(16,29,58,.08);
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }

    body {
      margin: 0;
      font-family: Inter, Arial, sans-serif;
      background: var(--background);
      color: var(--text);
      line-height: 1.6;
    }

    button, input { font: inherit; }
    button { cursor: pointer; }
    a { color: inherit; text-decoration: none; }

    .container {
      width: min(1160px, calc(100% - 40px));
      margin: auto;
    }

    header {
      background: var(--navy);
      color: white;
      position: sticky;
      top: 0;
      z-index: 20;
      box-shadow: 0 4px 20px rgba(0,0,0,.12);
    }

    .navbar {
      min-height: 78px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      position: relative;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: 19px;
      font-weight: 800;
      flex-shrink: 0;
    }

    .brand img {
      width: 48px;
      height: 48px;
      object-fit: contain;
      background: white;
      border-radius: 10px;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 23px;
      font-size: 14px;
      font-weight: 600;
    }

    .nav-links a:hover { color: var(--gold); }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-shrink: 0;
    }

    .membership {
      padding: 6px 11px;
      border-radius: 20px;
      background: rgba(255,255,255,.12);
      color: white;
      font-size: 12px;
      font-weight: 700;
      white-space: nowrap;
    }

    .membership.premium {
      background: rgba(231,184,75,.2);
      color: var(--gold);
    }

    .btn {
      border: 0;
      border-radius: 9px;
      padding: 12px 19px;
      font-weight: 700;
      transition: .2s;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }

    .btn:hover { transform: translateY(-2px); }
    .btn-gold { background: var(--gold); color: var(--navy); }
    .btn-blue { background: var(--blue); color: white; }
    .btn-outline { border: 1px solid rgba(255,255,255,.45); color: white; background: transparent; }
    .btn-light { background: var(--blue-light); color: var(--blue); }

    .btn:disabled {
      opacity: .55;
      cursor: not-allowed;
      transform: none;
    }

    /* Menu button - top right beside sign-in */

    .menu-toggle {
      display: none;
      width: 40px;
      height: 40px;
      border: 1px solid rgba(255,255,255,.4);
      border-radius: 8px;
      background: transparent;
      padding: 9px;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      flex-shrink: 0;
    }

    .menu-toggle span {
      display: block;
      width: 100%;
      height: 2px;
      background: white;
      border-radius: 3px;
      transition: .2s;
    }

    .hero {
      background: linear-gradient(125deg, #101d3a, #1d4684);
      color: white;
      padding: 90px 0;
      overflow: hidden;
    }

    .hero-content { max-width: 760px; }

    .eyebrow {
      color: var(--gold);
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 2px;
      text-transform: uppercase;
    }

    .hero h1 {
      font-size: clamp(36px, 6vw, 60px);
      line-height: 1.13;
      margin: 16px 0;
    }

    .hero h1 span { color: var(--gold); }

    .hero p {
      color: #dce6f8;
      font-size: 17px;
      max-width: 620px;
      margin-bottom: 28px;
    }

    .hero-buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
    }

    .stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
      margin-top: 45px;
      max-width: 650px;
    }

    .stat {
      border-left: 3px solid var(--gold);
      padding-left: 15px;
    }

    .stat strong {
      display: block;
      font-size: 27px;
      color: white;
    }

    .stat span {
      font-size: 12px;
      color: #cbd8ed;
    }

    section { padding: 75px 0; }

    .section-heading {
      text-align: center;
      margin-bottom: 38px;
    }

    .section-heading h2 {
      color: var(--navy);
      font-size: clamp(27px, 4vw, 36px);
      margin: 8px 0;
    }

    .section-heading p {
      color: var(--muted);
      max-width: 620px;
      margin: auto;
    }

    .category-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 18px;
    }

    .category-card {
      background: white;
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 22px;
      box-shadow: var(--shadow);
      transition: .2s;
      display: flex;
      flex-direction: column;
      min-height: 205px;
    }

    .category-card:hover {
      transform: translateY(-4px);
      border-color: #b7c9ed;
    }

    .category-number {
      color: var(--blue);
      background: var(--blue-light);
      width: 38px;
      height: 38px;
      border-radius: 10px;
      display: grid;
      place-items: center;
      font-weight: 800;
    }

    .category-card h3 {
      font-size: 16px;
      color: var(--navy);
      margin: 15px 0 5px;
    }

    .category-card p {
      font-size: 13px;
      color: var(--muted);
      margin: 0 0 15px;
      flex: 1;
    }

    .category-card .card-bottom {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      font-size: 12px;
    }

    .lock-label {
      color: #a87512;
      font-weight: 700;
    }

    .free-label {
      color: var(--green);
      font-weight: 700;
    }

    .category-card button {
      border: 0;
      background: var(--blue);
      color: white;
      padding: 8px 12px;
      border-radius: 7px;
      font-size: 12px;
      font-weight: 700;
    }

    .category-card button.locked { background: #b48b36; }

    .how-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 22px;
    }

    .how-card {
      background: white;
      padding: 28px;
      border-radius: 14px;
      border: 1px solid var(--border);
    }

    .how-card .number {
      color: var(--gold);
      font-size: 30px;
      font-weight: 800;
    }

    .how-card h3 { color: var(--navy); }

    .premium-section {
      background: var(--navy);
      color: white;
    }

    .premium-box {
      max-width: 760px;
      margin: auto;
      text-align: center;
    }

    .premium-box h2 {
      font-size: 36px;
      margin: 10px 0;
    }

    .premium-box p { color: #d5dfef; }

    .premium-features {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 18px;
      margin: 28px 0;
      color: #f5dfaa;
      font-size: 14px;
    }

    .contact-box {
      text-align: center;
      background: white;
      padding: 35px;
      border: 1px solid var(--border);
      border-radius: 15px;
    }

    footer {
      background: #0b1429;
      color: #d5deee;
      padding: 38px 0;
      font-size: 13px;
    }

    .footer-inner {
      display: flex;
      justify-content: space-between;
      gap: 25px;
      flex-wrap: wrap;
    }

    .footer-links {
      display: flex;
      gap: 17px;
      flex-wrap: wrap;
    }

    .footer-links a:hover { color: var(--gold); }

    /* One floating WhatsApp button only */

    .whatsapp {
      position: fixed;
      right: 20px;
      bottom: 20px;
      width: 58px;
      height: 58px;
      display: grid;
      place-items: center;
      border-radius: 50%;
      background: #25D366;
      color: white;
      box-shadow: 0 5px 18px rgba(0,0,0,.2);
      z-index: 30;
      transition: .2s;
    }

    .whatsapp:hover {
      transform: scale(1.08);
      background: #1ebc59;
    }

    /* Modals */

    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(5,13,30,.72);
      z-index: 100;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 18px;
      overflow-y: auto;
    }

    .modal-overlay.show { display: flex; }

    .modal {
      background: white;
      border-radius: 16px;
      width: min(620px, 100%);
      max-height: 90vh;
      overflow-y: auto;
      padding: 28px;
      position: relative;
    }

    .modal h2 { color: var(--navy); margin-top: 0; }

    .close-modal {
      position: absolute;
      right: 15px;
      top: 12px;
      border: 0;
      background: #eef1f7;
      border-radius: 50%;
      width: 34px;
      height: 34px;
      font-size: 20px;
    }

    .google-area {
      display: flex;
      justify-content: center;
      min-height: 48px;
      margin: 25px 0;
    }

    .question-meta {
      color: var(--muted);
      font-size: 13px;
      margin-bottom: 12px;
    }

    .question-text {
      font-size: 19px;
      font-weight: 700;
      color: var(--navy);
      margin: 18px 0;
    }

    .option {
      display: block;
      width: 100%;
      text-align: left;
      padding: 14px;
      border: 1px solid var(--border);
      background: white;
      border-radius: 9px;
      margin: 9px 0;
      color: var(--text);
    }

    .option:hover:not(:disabled) {
      border-color: var(--blue);
      background: var(--blue-light);
    }

    .option.correct {
      border-color: var(--green);
      background: #e8f7ef;
    }

    .option.incorrect {
      border-color: var(--red);
      background: #fff0f0;
    }

    .feedback {
      border-radius: 10px;
      padding: 14px;
      margin-top: 15px;
      display: none;
      font-size: 14px;
    }

    .feedback.show { display: block; }
    .feedback.success { background: #e8f7ef; color: #116b48; }
    .feedback.error { background: #fff0f0; color: #a92e38; }

    .question-actions {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      margin-top: 20px;
      flex-wrap: wrap;
    }

    .notice {
      background: #fff7e5;
      border: 1px solid #f0d99d;
      color: #755316;
      padding: 13px;
      border-radius: 9px;
      font-size: 13px;
      margin: 15px 0;
    }

    .hidden { display: none !important; }

    #toast {
      position: fixed;
      bottom: 90px;
      left: 50%;
      transform: translateX(-50%);
      background: var(--navy);
      color: white;
      padding: 12px 18px;
      border-radius: 9px;
      z-index: 200;
      display: none;
      max-width: calc(100% - 30px);
      font-size: 13px;
      text-align: center;
    }

    #toast.show { display: block; }

    /* Responsive design */

    @media(max-width: 900px) {
      .category-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .navbar {
        position: relative;
      }

      .nav-actions {
        margin-left: auto;
        gap: 8px;
      }

      .menu-toggle {
        display: flex;
      }

      .nav-links {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: var(--navy);
        padding: 12px 22px 18px;
        flex-direction: column;
        align-items: stretch;
        gap: 0;
        box-shadow: 0 10px 20px rgba(0,0,0,.2);
      }

      .nav-links.open {
        display: flex;
      }

      .nav-links a {
        display: block;
        padding: 13px 5px;
        border-bottom: 1px solid rgba(255,255,255,.12);
      }
    }

    @media(max-width: 600px) {
      .container {
        width: min(100% - 28px, 1160px);
      }

      .navbar {
        min-height: 68px;
        gap: 8px;
      }

      .brand {
        font-size: 14px;
        gap: 7px;
      }

      .brand img {
        width: 38px;
        height: 38px;
      }

      .membership {
        display: none;
      }

      .nav-actions {
        gap: 6px;
      }

      .nav-actions .btn {
        padding: 9px 11px;
        font-size: 12px;
      }

      .menu-toggle {
        width: 36px;
        height: 36px;
      }

      .hero { padding: 65px 0; }
      .stats { gap: 10px; }
      .stat strong { font-size: 22px; }

      .category-grid { grid-template-columns: 1fr; }
      .how-grid { grid-template-columns: 1fr; }

      section { padding: 55px 0; }
      .modal { padding: 24px 18px; }
      .premium-box h2 { font-size: 29px; }

      .whatsapp {
        width: 55px;
        height: 55px;
        right: 15px;
        bottom: 15px;
      }
    }
  </style>
</head>

<body>

<header>
  <div class="container navbar">

    <a href="#home" class="brand">
      <img src="https://assets.createlk.com/CreateLK%20Academy%20Logo.png" alt="CreateLK Academy Logo">
      <span>CreateLK Academy</span>
    </a>

    <nav class="nav-links" id="mainNavigation">
      <a href="#home">Home</a>
      <a href="#categories">Categories</a>
      <a href="#how-it-works">How It Works</a>
      <a href="#premium">Premium</a>
      <a href="#contact">Contact</a>
    </nav>

    <div class="nav-actions">

      <span id="membershipStatus" class="membership">Guest</span>

      <button class="btn btn-gold" id="signInButton" onclick="openGoogleModal()">
        Sign in
      </button>

      <button class="btn btn-outline hidden" id="signOutButton" onclick="signOut()">
        Sign out
      </button>

      <!-- Menu is immediately beside Sign in / Sign out -->
      <button
        class="menu-toggle"
        id="menuToggle"
        type="button"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mainNavigation"
        onclick="toggleMenu()">
        <span></span>
        <span></span>
        <span></span>
      </button>

    </div>
  </div>
</header>

<main>

  <section class="hero" id="home">
    <div class="container">
      <div class="hero-content">

        <div class="eyebrow">Learn • Practise • Improve</div>

        <h1>
          Build Your English Grammar Skills with
          <span>Confidence.</span>
        </h1>

        <p>
          Practise English grammar through interactive multiple-choice questions.
          Improve your knowledge step by step with CreateLK Academy.
        </p>

        <div class="hero-buttons">

          <button class="btn btn-gold" onclick="startLearning()">
            Start Learning
          </button>

          <button
            class="btn btn-outline"
            id="heroSignInButton"
            onclick="openGoogleModal()">
            Sign in with Google
          </button>

        </div>

        <div class="stats">

          <div class="stat">
            <strong>20</strong>
            <span>Grammar Categories</span>
          </div>

          <div class="stat">
            <strong>1,000</strong>
            <span>Practice Questions</span>
          </div>

          <div class="stat">
            <strong id="completedMcqProgress">0 / 1000</strong>
            <span>Completed MCQs</span>
          </div>

        </div>
      </div>
    </div>
  </section>

  <section id="categories">
    <div class="container">

      <div class="section-heading">
        <div class="eyebrow">Your learning journey</div>
        <h2>English Grammar Categories</h2>
        <p>Choose a category and test your English grammar knowledge.</p>
      </div>

      <div id="categoryMessage" class="notice hidden"></div>

      <div id="categoryGrid" class="category-grid">
        <div class="category-card">
          <div class="category-number">01</div>
          <h3>Loading categories...</h3>
          <p>Please wait while we connect to the academy.</p>
        </div>
      </div>

    </div>
  </section>

  <section id="how-it-works" style="background:#eef2fa;">
    <div class="container">

      <div class="section-heading">
        <div class="eyebrow">Simple learning</div>
        <h2>How It Works</h2>
        <p>Start practising in just a few simple steps.</p>
      </div>

      <div class="how-grid">

        <div class="how-card">
          <div class="number">01</div>
          <h3>Sign in</h3>
          <p>Use your Google account to access your learning dashboard.</p>
        </div>

        <div class="how-card">
          <div class="number">02</div>
          <h3>Choose a Category</h3>
          <p>Select a grammar topic and answer the available questions.</p>
        </div>

        <div class="how-card">
          <div class="number">03</div>
          <h3>Check Your Answers</h3>
          <p>Receive instant feedback and explanations to improve your knowledge.</p>
        </div>

      </div>
    </div>
  </section>

  <section class="premium-section" id="premium">
    <div class="container">

      <div class="premium-box">
        <div class="eyebrow">Unlock your learning</div>

        <h2>Explore Premium Membership</h2>

        <p>
          Get access to all grammar categories and continue developing
          your English grammar skills.
        </p>

        <div class="premium-features">
          <span>✓ All 20 categories</span>
          <span>✓ 1,000 practice questions</span>
          <span>✓ Instant answer feedback</span>
          <span>✓ Question explanations</span>
        </div>

        <button class="btn btn-gold" onclick="openPayment()">
          Get Premium Access
        </button>

        <p style="font-size:13px;margin-top:18px;">
          Payments are processed through PayHere. Premium access is activated
          after payment verification.
        </p>
      </div>

    </div>
  </section>

  <section id="contact">
    <div class="container">

      <div class="contact-box">
        <div class="eyebrow">We are here to help</div>

        <h2 style="color:var(--navy);">
          Contact CreateLK Academy
        </h2>

        <p>
          Need assistance with your account, membership or learning experience?
        </p>

        <p>
          <strong>Email:</strong>
          <a href="mailto:createlksupport@gmail.com">
            createlksupport@gmail.com
          </a>
        </p>

      </div>

    </div>
  </section>

</main>

<footer>
  <div class="container footer-inner">

    <div>
      <strong style="color:white;">CreateLK Academy</strong>
      <p>Learn English grammar with confidence.</p>
      <p>© <span id="year"></span> CreateLK Academy. All rights reserved.</p>
    </div>

    <div class="footer-links">
      <a href="legal/privacy.html">Privacy Policy</a>
      <a href="legal/terms.html">Terms & Conditions</a>
      <a href="legal/refund.html">Refund Policy</a>
      <a href="legal/payment.html">Payment Policy</a>
    </div>

  </div>
</footer>

<!-- ONLY ONE FLOATING WHATSAPP BUTTON -->
<a
  class="whatsapp"
  aria-label="WhatsApp support"
  href="https://wa.me/94771190395?text=Hello%20CreateLK%20Academy%2C%20I%20need%20support."
  target="_blank"
  rel="noopener noreferrer">

  <svg
    viewBox="0 0 32 32"
    width="32"
    height="32"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true">

    <path
      fill="currentColor"
      d="M16 2.5A13.4 13.4 0 0 0 4.4 22.6L2.5 29.5l7.1-1.9A13.5 13.5 0 1 0 16 2.5Zm0 24.5a11 11 0 0 1-5.6-1.5l-.4-.2-4.2 1.1 1.1-4.1-.3-.5A11 11 0 1 1 16 27Zm6-8.2c-.3-.2-1.9-.9-2.2-1s-.5-.2-.7.2-.8 1-1 1.2-.4.2-.7.1a9 9 0 0 1-2.6-1.6 9.8 9.8 0 0 1-1.8-2.2c-.2-.3 0-.5.1-.6l.5-.6.3-.5c.1-.2 0-.4 0-.6s-.7-1.8-.9-2.1c-.2-.5-.5-.4-.7-.4h-.6c-.2 0-.6.1-.9.4s-1.2 1.2-1.2 2.9 1.2 3.3 1.4 3.5c.2.2 2.4 3.7 5.9 5.1.8.3 1.5.6 2 .7.8.2 1.6.2 2.2.1.7-.1 1.9-.8 2.1-1.6.3-.8.3-1.5.2-1.6-.1-.1-.3-.2-.6-.4Z"/>

  </svg>
</a>

<!-- GOOGLE LOGIN MODAL -->
<div class="modal-overlay" id="googleModal">

  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="googleTitle">

    <button class="close-modal" onclick="closeGoogleModal()" aria-label="Close">
      ×
    </button>

    <h2 id="googleTitle">Sign in to CreateLK Academy</h2>

    <p>Use your Google account to access your learning account.</p>

    <div class="google-area">
      <div id="googleButton"></div>
    </div>

    <p id="googleMessage" style="font-size:13px;color:var(--muted);text-align:center;"></p>

  </div>
</div>

<!-- QUESTION MODAL -->
<div class="modal-overlay" id="questionModal">

  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="questionTitle">

    <button class="close-modal" onclick="closeQuestionModal()" aria-label="Close">
      ×
    </button>

    <h2 id="questionTitle">Practice Questions</h2>

    <div id="questionContent">
      <p>Loading questions...</p>
    </div>

  </div>
</div>

<!-- PAYMENT INFORMATION MODAL -->
<div class="modal-overlay" id="paymentModal">

  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="paymentTitle">

    <button class="close-modal" onclick="closePaymentModal()" aria-label="Close">
      ×
    </button>

    <h2 id="paymentTitle">Premium Membership</h2>

    <p>Continue to the official PayHere payment page.</p>

    <div class="notice">
      <strong>Important:</strong> Please make your payment using the same
      Google account email you use on CreateLK Academy. After completing
      payment, contact support with your payment receipt so your membership
      can be verified and activated.
    </div>

    <button class="btn btn-gold" style="width:100%;" onclick="continueToPayHere()">
      Continue to PayHere
    </button>

    <p style="font-size:12px;color:var(--muted);margin-top:15px;">
      Premium access is not activated automatically by returning from the payment page.
    </p>

  </div>
</div>

<div id="toast" role="status" aria-live="polite"></div>

<script>
  // --------------------------------------------------
  // CONFIGURATION
  // --------------------------------------------------

  const API_BASE = "https://eg-academy.createlk.workers.dev";

  const GOOGLE_CLIENT_ID =
    "582157960266-3r4k503a5a3oomo9nrau7l61aifavbqh.apps.googleusercontent.com";

  const PAYHERE_DIRECT_LINK = "https://payhere.lk/pay/o1719226a";

  const TOKEN_KEY = "createlk_academy_token";
  const PAYMENT_PENDING_KEY = "createlk_payment_pending";

  // --------------------------------------------------
  // ELEMENTS
  // --------------------------------------------------

  const $ = id => document.getElementById(id);

  const googleModal = $("googleModal");
  const questionModal = $("questionModal");
  const paymentModal = $("paymentModal");

  // --------------------------------------------------
  // STATE
  // --------------------------------------------------

  let currentUser = null;
  let categories = [];
  let questions = [];
  let currentCategory = null;
  let currentQuestionIndex = 0;
  let answerSubmitted = false;
  let googleInitialized = false;
  let toastTimer = null;

  // --------------------------------------------------
  // MCQ PROGRESS
  // --------------------------------------------------

  const MCQ_PROGRESS_LIMIT = 1000;
  const MCQ_PROGRESS_PREFIX = "createlk_completed_mcqs_";

  function getProgressStorageKey() {
    if (!currentUser) {
      return MCQ_PROGRESS_PREFIX + "guest";
    }

    const accountIdentifier =
      currentUser.id ||
      currentUser.email ||
      "default";

    return MCQ_PROGRESS_PREFIX + String(accountIdentifier);
  }

  function getCompletedMcqs() {
    try {
      const saved = Number(
        localStorage.getItem(getProgressStorageKey())
      );

      if (!Number.isFinite(saved) || saved < 0) {
        return 0;
      }

      return Math.min(Math.floor(saved), MCQ_PROGRESS_LIMIT);

    } catch (error) {
      console.error("Could not read MCQ progress:", error);
      return 0;
    }
  }

  function updateMcqProgressDisplay() {
    const progressElement = $("completedMcqProgress");

    if (!progressElement) return;

    progressElement.textContent =
      getCompletedMcqs() + " / " + MCQ_PROGRESS_LIMIT;
  }

  function recordCompletedMcq() {
    const currentProgress = getCompletedMcqs();

    if (currentProgress >= MCQ_PROGRESS_LIMIT) {
      updateMcqProgressDisplay();
      return;
    }

    const newProgress = currentProgress + 1;

    try {
      localStorage.setItem(
        getProgressStorageKey(),
        String(newProgress)
      );

      updateMcqProgressDisplay();

    } catch (error) {
      console.error("Could not save MCQ progress:", error);

      showToast(
        "Your answer was submitted, but progress could not be saved in this browser."
      );
    }
  }

  // --------------------------------------------------
  // HELPERS
  // --------------------------------------------------

  function showToast(message) {
    const toast = $("toast");

    toast.textContent = message;
    toast.classList.add("show");

    clearTimeout(toastTimer);

    toastTimer = setTimeout(() => {
      toast.classList.remove("show");
    }, 3500);
  }

  function getToken() {
    return localStorage.getItem(TOKEN_KEY);
  }

  function saveToken(token) {
    localStorage.setItem(TOKEN_KEY, token);
  }

  function clearToken() {
    localStorage.removeItem(TOKEN_KEY);
  }

  function escapeHTML(value) {
    return String(value ?? "").replace(/[&<>"']/g, char => ({
      "&": "&amp;",
      "<": "&lt;",
      ">": "&gt;",
      '"': "&quot;",
      "'": "&#039;"
    })[char]);
  }

  async function apiRequest(path, options = {}) {
    const headers = {
      ...(options.headers || {})
    };

    if (getToken()) {
      headers.Authorization = "Bearer " + getToken();
    }

    if (options.body && !headers["Content-Type"]) {
      headers["Content-Type"] = "application/json";
    }

    let result;

    try {
      result = await fetch(API_BASE + path, {
        ...options,
        headers
      });

    } catch (error) {
      throw new Error(
        "Unable to connect to the academy server. Please try again."
      );
    }

    let data;

    try {
      data = await result.json();
    } catch {
      data = {};
    }

    if (!result.ok) {
      if (result.status === 401) {
        clearToken();
        currentUser = null;
        updateMembershipStatus();
      }

      throw new Error(
        data.error || "Something went wrong. Please try again."
      );
    }

    return data;
  }

  // --------------------------------------------------
  // MOBILE NAVIGATION
  // --------------------------------------------------

  function toggleMenu() {
    const menu = $("mainNavigation");
    const button = $("menuToggle");

    if (!menu || !button) return;

    const isOpen = menu.classList.toggle("open");

    button.setAttribute("aria-expanded", String(isOpen));

    button.setAttribute(
      "aria-label",
      isOpen ? "Close navigation menu" : "Open navigation menu"
    );
  }

  function closeMobileMenu() {
    const menu = $("mainNavigation");
    const button = $("menuToggle");

    if (menu) {
      menu.classList.remove("open");
    }

    if (button) {
      button.setAttribute("aria-expanded", "false");
      button.setAttribute("aria-label", "Open navigation menu");
    }
  }

  document.querySelectorAll("#mainNavigation a").forEach(link => {
    link.addEventListener("click", closeMobileMenu);
  });

  // --------------------------------------------------
  // MEMBERSHIP
  // --------------------------------------------------

  function updateMembershipStatus() {
    const status = $("membershipStatus");
    const signIn = $("signInButton");
    const signOutButton = $("signOutButton");
    const heroSignIn = $("heroSignInButton");

    status.classList.remove("premium");

    if (!currentUser) {
      status.textContent = "Guest";

      signIn.classList.remove("hidden");
      signOutButton.classList.add("hidden");

      if (heroSignIn) {
        heroSignIn.classList.remove("hidden");
      }

      updateMcqProgressDisplay();
      return;
    }

    if (currentUser.premium === true) {
      status.textContent = "Premium";
      status.classList.add("premium");
    } else {
      status.textContent = "Free";
    }

    signIn.classList.add("hidden");
    signOutButton.classList.remove("hidden");

    if (heroSignIn) {
      heroSignIn.classList.add("hidden");
    }

    updateMcqProgressDisplay();
  }

  async function refreshCurrentUser() {
    const data = await apiRequest("/api/me");

    currentUser = data.user;

    updateMembershipStatus();

    return currentUser;
  }

  // --------------------------------------------------
  // GOOGLE SIGN-IN
  // --------------------------------------------------

  function openGoogleModal() {
    googleModal.classList.add("show");

    initializeGoogle();

    if (currentUser) {
      $("googleMessage").textContent =
        "You are signed in as " + currentUser.email;
    }
  }

  function closeGoogleModal() {
    googleModal.classList.remove("show");
  }

  function initializeGoogle() {
    if (googleInitialized) return;

    if (!window.google || !google.accounts || !google.accounts.id) {
      $("googleMessage").textContent =
        "Google sign-in is loading. Please wait a moment and try again.";

      setTimeout(initializeGoogle, 800);
      return;
    }

    google.accounts.id.initialize({
      client_id: GOOGLE_CLIENT_ID,
      callback: handleGoogleCredential
    });

    google.accounts.id.renderButton(
      $("googleButton"),
      {
        theme: "outline",
        size: "large",
        shape: "rectangular",
        text: "signin_with",
        width: 260
      }
    );

    googleInitialized = true;
  }

  async function handleGoogleCredential(response) {
    $("googleMessage").textContent = "Signing in...";

    try {
      const result = await fetch(API_BASE + "/api/auth/google", {
        method: "POST",
        headers: {
          "Content-Type": "application/json"
        },
        body: JSON.stringify({
          credential: response.credential
        })
      });

      const data = await result.json();

      if (!result.ok) {
        throw new Error(data.error || "Google sign-in failed.");
      }

      saveToken(data.token);

      currentUser = data.user;

      updateMembershipStatus();

      closeGoogleModal();

      showToast("Welcome to CreateLK Academy!");

      await loadCategories();
      await checkPendingPayment();

    } catch (error) {
      $("googleMessage").textContent = error.message;
    }
  }

  async function signOut() {
    clearToken();

    currentUser = null;

    updateMembershipStatus();

    categories = [];

    renderCategories();

    showToast("You have signed out.");
  }

  // --------------------------------------------------
  // RESTORE SESSION
  // --------------------------------------------------

  async function restoreSession() {
    if (!getToken()) {
      currentUser = null;

      updateMembershipStatus();
      renderCategories();

      return;
    }

    try {
      await refreshCurrentUser();

      await loadCategories();
      await checkPendingPayment();

    } catch (error) {
      console.error("Session restoration:", error);

      currentUser = null;

      updateMembershipStatus();
      renderCategories();
    }
  }

  // --------------------------------------------------
  // CATEGORIES
  // --------------------------------------------------

  async function loadCategories() {
    if (!getToken()) {
      renderCategories();
      return;
    }

    const grid = $("categoryGrid");

    grid.innerHTML = `
      <div class="category-card">
        <div class="category-number">...</div>
        <h3>Loading categories</h3>
        <p>Please wait...</p>
      </div>
    `;

    try {
      const data = await apiRequest("/api/categories");

      categories = data.categories || [];

      renderCategories();

    } catch (error) {
      grid.innerHTML = "";

      $("categoryMessage").textContent = error.message;
      $("categoryMessage").classList.remove("hidden");
    }
  }

  function renderCategories() {
    const grid = $("categoryGrid");
    const message = $("categoryMessage");

    message.classList.add("hidden");

    if (!getToken()) {
      grid.innerHTML = `
        <div class="category-card">
          <div class="category-number">01</div>
          <h3>Sign in to begin</h3>
          <p>Sign in with Google to view and practise grammar categories.</p>

          <div class="card-bottom">
            <span class="free-label">Free account</span>
            <button onclick="openGoogleModal()">Sign in</button>
          </div>
        </div>
      `;

      return;
    }

    if (!categories.length) {
      grid.innerHTML = `
        <div class="category-card">
          <div class="category-number">!</div>
          <h3>No categories available</h3>
          <p>Please try again later.</p>

          <div class="card-bottom">
            <span></span>
            <button onclick="loadCategories()">Retry</button>
          </div>
        </div>
      `;

      return;
    }

    grid.innerHTML = categories.map(category => {
      const id = Number(category.id);
      const locked = Boolean(category.locked);
      const count = Number(category.question_count || 0);

      return `
        <article class="category-card" data-category-id="${id}">

          <div class="category-number">
            ${String(id).padStart(2, "0")}
          </div>

          <h3>${escapeHTML(category.title)}</h3>

          <p>
            ${escapeHTML(category.description || "Practise this grammar topic.")}
          </p>

          <div class="card-bottom">
            <span>${count} questions</span>

            <span class="${locked ? "lock-label" : "free-label"}">
              ${locked ? "🔒 Premium" : (id === 1 ? "Free" : "Unlocked")}
            </span>
          </div>

          <div style="margin-top:12px;">
            <button
              class="${locked ? "locked" : ""}"
              onclick="openCategory(${id})">
              ${locked ? "Unlock Category" : "Start Practice"}
            </button>
          </div>

        </article>
      `;
    }).join("");
  }

  // --------------------------------------------------
  // OPEN CATEGORY
  // --------------------------------------------------

  async function openCategory(categoryId) {
    if (!getToken()) {
      openGoogleModal();

      showToast("Please sign in before practising.");

      return;
    }

    const category = categories.find(
      item => Number(item.id) === Number(categoryId)
    );

    if (category && category.locked) {
      openPayment();
      return;
    }

    await openQuestions(categoryId);
  }

  // --------------------------------------------------
  // QUESTIONS
  // --------------------------------------------------

  async function openQuestions(categoryId) {
    questionModal.classList.add("show");

    $("questionContent").innerHTML = "<p>Loading questions...</p>";

    currentCategory = categories.find(
      item => Number(item.id) === Number(categoryId)
    );

    currentQuestionIndex = 0;
    answerSubmitted = false;
    questions = [];

    try {
      const data = await apiRequest(
        "/api/questions?category_id=" +
        encodeURIComponent(categoryId) +
        "&limit=50&offset=0"
      );

      questions = data.questions || [];

      if (!questions.length) {
        $("questionContent").innerHTML =
          "<p>No questions are available in this category yet.</p>";

        return;
      }

      renderQuestion();

    } catch (error) {
      if (error.message.includes("Premium")) {
        closeQuestionModal();
        openPayment();
        return;
      }

      $("questionContent").innerHTML =
        `<div class="notice">${escapeHTML(error.message)}</div>`;
    }
  }

  function renderQuestion() {
    const question = questions[currentQuestionIndex];

    if (!question) return;

    answerSubmitted = false;

    const total = questions.length;
    const current = currentQuestionIndex + 1;

    $("questionTitle").textContent =
      currentCategory?.title || "Grammar Practice";

    $("questionContent").innerHTML = `
      <div class="question-meta">
        Question ${current} of ${total}
      </div>

      <div style="height:6px;background:#e9edf5;border-radius:10px;overflow:hidden;">
        <div style="height:100%;width:${(current / total) * 100}%;background:#2458a6;"></div>
      </div>

      <div class="question-text">
        ${escapeHTML(question.question)}
      </div>

      <div id="options">
        ${["A", "B", "C", "D"].map(letter => {
          const key = "option_" + letter.toLowerCase();

          return `
            <button
              class="option"
              data-option="${letter}"
              onclick="selectAnswer('${letter}')">

              <strong>${letter}.</strong>
              ${escapeHTML(question[key])}

            </button>
          `;
        }).join("")}
      </div>

      <div id="answerFeedback" class="feedback"></div>

      <div class="question-actions">

        <button
          class="btn btn-light"
          onclick="previousQuestion()"
          ${currentQuestionIndex === 0 ? "disabled" : ""}>
          Previous
        </button>

        <button
          class="btn btn-blue"
          id="nextQuestionButton"
          onclick="nextQuestion()"
          disabled>
          ${current === total ? "Finish" : "Next Question"}
        </button>

      </div>
    `;
  }

  // --------------------------------------------------
  // ANSWERS
  // --------------------------------------------------

  async function selectAnswer(selectedOption) {
    if (answerSubmitted) return;

    const question = questions[currentQuestionIndex];

    if (!question) return;

    const buttons = document.querySelectorAll("#options .option");

    buttons.forEach(button => {
      button.disabled = true;
    });

    answerSubmitted = true;

    try {
      const result = await apiRequest("/api/answers", {
        method: "POST",

        body: JSON.stringify({
          question_id: Number(question.id),
          selected_option: selectedOption
        })
      });

      // Count after a successful server response.
      // Correct and incorrect submitted answers both count.
      recordCompletedMcq();

      buttons.forEach(button => {
        const option = button.dataset.option;

        if (option === result.correct_option) {
          button.classList.add("correct");
        }

        if (option === selectedOption && !result.correct) {
          button.classList.add("incorrect");
        }
      });

      const feedback = $("answerFeedback");

      feedback.className =
        "feedback show " + (result.correct ? "success" : "error");

      feedback.innerHTML = `
        <strong>
          ${result.correct ? "✓ Correct answer!" : "✗ Incorrect answer"}
        </strong>

        <p style="margin:6px 0 0;">
          Correct answer:
          <strong>${escapeHTML(result.correct_option)}</strong>
        </p>

        <p style="margin:6px 0 0;">
          ${escapeHTML(result.explanation || "Keep practising to improve your knowledge.")}
        </p>
      `;

      $("nextQuestionButton").disabled = false;

    } catch (error) {
      answerSubmitted = false;

      buttons.forEach(button => {
        button.disabled = false;
      });

      showToast(error.message);
    }
  }

  function nextQuestion() {
    if (!answerSubmitted) return;

    if (currentQuestionIndex < questions.length - 1) {
      currentQuestionIndex++;

      renderQuestion();

    } else {
      $("questionContent").innerHTML = `
        <div style="text-align:center;padding:25px 5px;">

          <div style="font-size:45px;">🎉</div>

          <h3 style="color:var(--navy);">
            Practice Completed!
          </h3>

          <p>
            You have completed all questions in this category.
          </p>

          <button
            class="btn btn-blue"
            onclick="closeQuestionModal()">
            Back to Categories
          </button>

        </div>
      `;
    }
  }

  function previousQuestion() {
    if (currentQuestionIndex <= 0) return;

    currentQuestionIndex--;

    renderQuestion();
  }

  function closeQuestionModal() {
    questionModal.classList.remove("show");
  }

  // --------------------------------------------------
  // PAYHERE
  // --------------------------------------------------

  function openPayment() {
    if (!getToken()) {
      openGoogleModal();

      showToast("Please sign in before continuing.");

      return;
    }

    if (currentUser?.premium === true) {
      showToast("Your account already has Premium access.");
      return;
    }

    paymentModal.classList.add("show");
  }

  function closePaymentModal() {
    paymentModal.classList.remove("show");
  }

  function continueToPayHere() {
    if (!getToken()) {
      closePaymentModal();
      openGoogleModal();
      return;
    }

    // This marker does not grant membership.
    sessionStorage.setItem(PAYMENT_PENDING_KEY, "1");

    closePaymentModal();

    window.location.href = PAYHERE_DIRECT_LINK;
  }

  async function checkPendingPayment() {
    if (sessionStorage.getItem(PAYMENT_PENDING_KEY) !== "1") {
      return;
    }

    sessionStorage.removeItem(PAYMENT_PENDING_KEY);

    try {
      await refreshCurrentUser();

      if (currentUser?.premium === true) {
        showToast("Premium access is active on your account.");

        await loadCategories();

      } else {
        showToast(
          "Payment verification may still be pending. Contact support with your receipt."
        );
      }

    } catch (error) {
      showToast("Please sign in again to check your membership.");
    }
  }

  // --------------------------------------------------
  // NAVIGATION
  // --------------------------------------------------

  function startLearning() {
    closeMobileMenu();

    $("categories").scrollIntoView({
      behavior: "smooth"
    });

    if (!getToken()) {
      setTimeout(openGoogleModal, 500);
    }
  }

  // --------------------------------------------------
  // MODAL EVENTS
  // --------------------------------------------------

  [googleModal, questionModal, paymentModal].forEach(modal => {
    modal.addEventListener("click", event => {
      if (event.target !== modal) return;

      modal.classList.remove("show");
    });
  });

  document.addEventListener("keydown", event => {
    if (event.key === "Escape") {
      googleModal.classList.remove("show");
      questionModal.classList.remove("show");
      paymentModal.classList.remove("show");

      closeMobileMenu();
    }
  });

  // --------------------------------------------------
  // STARTUP
  // --------------------------------------------------

  $("year").textContent = new Date().getFullYear();

  updateMembershipStatus();
  updateMcqProgressDisplay();
  renderCategories();

  restoreSession();
</script>

</body>
</html>
```
