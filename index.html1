
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#101a35">
<title>CreateLK Academy</title>
<meta name="description" content="Learn English grammar with 20 lessons and 1,000 MCQs.">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
:root {
  --navy:#101a35;
  --navy2:#1d2d53;
  --gold:#e5b84b;
  --gold2:#f7dfa0;
  --bg:#f4f6fb;
  --muted:#778198;
  --border:#e5e9f1;
  --green:#16875d;
  --red:#c94040;
}
* {box-sizing:border-box}
body {
  margin:0;
  font-family:Inter,Arial,sans-serif;
  color:var(--navy);
  background:var(--bg);
}
button {font:inherit;cursor:pointer}
button:disabled {opacity:.5;cursor:not-allowed}
.hidden {display:none!important}
.navbar {
  background:var(--navy);
  color:white;
  padding:12px 5%;
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:15px;
  position:sticky;
  top:0;
  z-index:10;
  box-shadow:0 3px 15px #0002;
}
.brand {display:flex;align-items:center;gap:12px}
.brand img {
  width:45px;height:45px;object-fit:contain;
  background:white;border-radius:9px;
}
.brand-name {font-weight:800;font-size:18px}
.brand-sub {font-size:11px;color:var(--gold2);margin-top:3px}
.nav-actions {display:flex;gap:8px}
.container {width:min(1100px,92%);margin:28px auto 60px}
.btn {
  border:0;border-radius:10px;padding:12px 17px;
  font-weight:700;display:inline-flex;align-items:center;
  justify-content:center;gap:7px;
}
.btn-gold {background:var(--gold);color:var(--navy)}
.btn-dark {background:var(--navy);color:white}
.btn-outline {background:white;border:1px solid var(--border);color:var(--navy)}
.btn:hover {filter:brightness(.97)}
.hero {
  background:linear-gradient(120deg,var(--navy),#293d70);
  color:white;padding:42px;border-radius:20px;
  display:grid;grid-template-columns:1.5fr 1fr;
  align-items:center;gap:20px;
}
.hero h1 {font-size:clamp(28px,4vw,44px);line-height:1.15;margin:0 0 15px}
.hero p {line-height:1.7;color:#dce3f3;margin:0 0 22px}
.gold-text {color:var(--gold2)}
.hero-art {font-size:95px;text-align:center}
.section-title {font-size:23px;margin:32px 0 16px}
.stats {display:grid;grid-template-columns:repeat(4,1fr);gap:13px;margin-top:20px}
.stat,.card {
  background:white;border:1px solid var(--border);
  border-radius:15px;padding:19px;
  box-shadow:0 6px 25px #101a350a;
}
.stat-number {font-size:26px;font-weight:800}
.stat-label {font-size:12px;color:var(--muted);margin-top:5px}
.dashboard-header {
  display:flex;justify-content:space-between;
  align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:16px;
}
.dashboard-header h2 {margin:0}
.user-info {font-size:13px;color:var(--muted);margin-top:5px}
.progress-track {height:9px;background:#e9edf5;border-radius:20px;overflow:hidden}
.progress-fill {height:100%;width:0;background:var(--gold);transition:width .3s}
.lessons-grid {display:grid;grid-template-columns:repeat(2,1fr);gap:13px}
.lesson-card {
  background:white;border:1px solid var(--border);border-radius:15px;
  padding:17px;display:flex;align-items:center;gap:13px;
  box-shadow:0 6px 25px #101a350a;min-width:0;
}
.lesson-number {
  flex:0 0 43px;height:43px;border-radius:11px;
  background:#eff2f8;display:grid;place-items:center;font-weight:800;
}
.lesson-details {flex:1;min-width:0}
.lesson-details h3 {font-size:14px;margin:0 0 6px}
.lesson-details p {font-size:11px;color:var(--muted);margin:0}
.tag {display:inline-block;padding:5px 8px;border-radius:20px;font-size:10px;font-weight:700;margin-top:8px}
.tag-free,.tag-done {background:#e5f6ed;color:var(--green)}
.tag-premium {background:#fff3d2;color:#936b12}
.premium-banner {
  background:linear-gradient(110deg,#172548,#293e70);
  color:white;padding:24px;border-radius:17px;margin-top:22px;
  display:flex;align-items:center;justify-content:space-between;
  flex-wrap:wrap;gap:15px;
}
.premium-banner h3 {margin:0 0 8px}
.premium-banner p {font-size:13px;line-height:1.6;color:#dce3f3;margin:0}
.lesson-view {
  background:white;border:1px solid var(--border);
  border-radius:17px;padding:25px;
}
.question-top {
  display:flex;justify-content:space-between;gap:10px;
  flex-wrap:wrap;font-size:13px;color:var(--muted);margin-bottom:20px;
}
.question-text {font-size:20px;font-weight:700;line-height:1.5;margin-bottom:20px}
.options {display:grid;gap:10px}
.option {
  width:100%;padding:14px;text-align:left;
  display:flex;align-items:center;gap:12px;
  background:white;border:1px solid var(--border);
  border-radius:11px;color:var(--navy);
}
.option.selected {border:2px solid var(--gold);background:#fffaf0}
.option.correct {border-color:var(--green);background:#effaf5}
.option.wrong {border-color:var(--red);background:#fff1f1}
.option:disabled {opacity:1;cursor:default}
.option-letter {
  width:27px;height:27px;flex-shrink:0;
  border-radius:8px;background:#eef1f7;
  display:grid;place-items:center;font-weight:800;font-size:12px;
}
.feedback {padding:14px;border-radius:10px;margin-top:17px;font-size:14px;line-height:1.6}
.feedback.good {background:#eaf8f1;color:#126b49}
.feedback.bad {background:#fff0f0;color:#a72e2e}
.question-controls {
  display:flex;justify-content:space-between;
  gap:10px;flex-wrap:wrap;margin-top:23px;
}
.message {padding:13px 15px;border-radius:10px;margin:14px 0;font-size:13px;line-height:1.6}
.message.error {background:#fff0f0;color:#a72e2e}
.message.success {background:#eaf8f1;color:#126b49}
.message.info {background:#eef3ff;color:#244477}
.loading {text-align:center;padding:35px;color:var(--muted)}
.spinner {
  width:25px;height:25px;border:3px solid #e5e9f2;
  border-top-color:var(--gold);border-radius:50%;
  animation:spin .8s linear infinite;margin:0 auto 12px;
}
@keyframes spin {to{transform:rotate(360deg)}}
.footer {text-align:center;padding:28px;color:var(--muted);font-size:12px}
.modal-backdrop {
  position:fixed;inset:0;z-index:50;background:#071127bb;
  display:grid;place-items:center;padding:18px;
}
.modal {
  width:min(430px,100%);background:white;
  padding:26px;border-radius:17px;
}
.modal h2 {margin-top:0}
@media(max-width:700px) {
  .hero {grid-template-columns:1fr;padding:27px 22px}
  .hero-art {display:none}
  .stats {grid-template-columns:repeat(2,1fr)}
  .lessons-grid {grid-template-columns:1fr}
  .brand-name {font-size:15px}
  .brand img {width:39px;height:39px}
  .navbar {padding:11px 4%}
  .container {margin-top:18px}
  .lesson-view {padding:18px}
  .question-text {font-size:18px}
  .lesson-card {padding:13px}
  .lesson-action .btn {padding:9px 10px;font-size:12px}
}
</style>
</head>

<body>

<header class="navbar">
  <div class="brand">
    <img src="https://assets.createlk.com/CreateLK%20Academy%20Logo.png"
         alt="CreateLK Academy"
         onerror="this.hidden=true">
    <div>
      <div class="brand-name">CreateLK Academy</div>
      <div class="brand-sub">Learn • Practice • Improve</div>
    </div>
  </div>

  <div class="nav-actions">
    <button class="btn btn-gold" id="loginButton">Sign in</button>
    <button class="btn btn-outline hidden" id="logoutButton">Logout</button>
  </div>
</header>

<main class="container">

  <section class="hero" id="hero">
    <div>
      <h1>Improve Your <span class="gold-text">English Grammar</span></h1>
      <p>
        Learn English grammar with structured lessons,
        1,000 multiple-choice questions and explanations.
      </p>
      <button class="btn btn-gold" id="heroLoginButton">
        Continue with Google
      </button>
    </div>
    <div class="hero-art">📚</div>
  </section>

  <section id="dashboard" class="hidden">
    <div class="dashboard-header">
      <div>
        <h2>Student Dashboard</h2>
        <div class="user-info" id="studentName">Welcome!</div>
      </div>
      <div id="subscriptionStatus"></div>
    </div>

    <div class="stats">
      <div class="stat">
        <div class="stat-number" id="statLessons">0/20</div>
        <div class="stat-label">Lessons completed</div>
      </div>
      <div class="stat">
        <div class="stat-number" id="statQuestions">0</div>
        <div class="stat-label">Questions answered</div>
      </div>
      <div class="stat">
        <div class="stat-number" id="statCorrect">0</div>
        <div class="stat-label">Correct answers</div>
      </div>
      <div class="stat">
        <div class="stat-number" id="statPercent">0%</div>
        <div class="stat-label">Accuracy</div>
      </div>
    </div>

    <div class="card" style="margin-top:15px">
      <strong>Overall learning progress</strong>
      <div style="display:flex;justify-content:space-between;margin:12px 0 8px">
        <span style="font-size:12px;color:#778198">Completed lessons</span>
        <strong id="progressLabel">0%</strong>
      </div>
      <div class="progress-track">
        <div class="progress-fill" id="overallProgress"></div>
      </div>
    </div>

    <div class="premium-banner" id="premiumBanner">
      <div>
        <h3>⭐ Unlock All 20 Lessons</h3>
        <p>1,000 English grammar MCQs<br>Premium: LKR 999 for 30 days</p>
      </div>
      <button class="btn btn-gold" id="premiumButton">Get Premium</button>
    </div>

    <h2 class="section-title">Your Lessons</h2>
    <div class="lessons-grid" id="lessonsGrid"></div>
  </section>

  <section id="lessonSection" class="hidden">
    <button class="btn btn-outline" id="backButton">← Dashboard</button>
    <div class="lesson-view" style="margin-top:15px">
      <div class="question-top">
        <span id="lessonHeading">Lesson</span>
        <span id="questionCounter">Question 1</span>
      </div>
      <div class="progress-track" style="margin-bottom:24px">
        <div class="progress-fill" id="questionProgress"></div>
      </div>
      <div id="questionArea">
        <div class="loading">Loading questions...</div>
      </div>
    </div>
  </section>

  <div id="globalMessage" aria-live="polite"></div>
</main>

<footer class="footer">
  © <span id="year"></span> CreateLK Academy. All rights reserved.
</footer>

<div class="modal-backdrop hidden" id="paymentModal">
  <div class="modal">
    <h2>⭐ CreateLK Academy Premium</h2>
    <p>Unlock all 20 lessons and 1,000 MCQs.</p>
    <h2 style="color:#b48720">LKR 999</h2>
    <p style="font-size:13px;color:#778198">30 days of premium access.</p>
    <div id="paymentMessage"></div>
    <button class="btn btn-gold" style="width:100%" id="payButton">
      Continue to PayHere
    </button>
    <button class="btn btn-outline" style="width:100%;margin-top:10px" id="closePaymentButton">
      Cancel
    </button>
  </div>
</div>

<script>
"use strict";

/* =========================================
   CONFIGURATION
========================================= */

const API = "https://eg-academy.createlk.workers.dev";

const LESSONS = [
  "Basic English Grammar",
  "Parts of Speech",
  "Nouns and Pronouns",
  "Verbs and Tenses",
  "Present Tense",
  "Past Tense",
  "Future Tense",
  "Articles",
  "Prepositions",
  "Conjunctions",
  "Adjectives",
  "Adverbs",
  "Subject-Verb Agreement",
  "Active and Passive Voice",
  "Direct and Indirect Speech",
  "Question Tags",
  "Conditional Sentences",
  "Sentence Structure",
  "Punctuation and Capitalization",
  "Advanced Grammar"
];

let currentUser = null;
let currentProgress = {};
let currentLessonId = 0;
let currentQuestions = [];
let currentQuestionIndex = 0;
let selectedAnswer = null;
let answerSubmitted = false;
let busy = false;

document.getElementById("year").textContent =
  new Date().getFullYear();


/* =========================================
   EVENT LISTENERS
   All buttons are connected here.
========================================= */

document.addEventListener("click", function(event) {
  const button = event.target.closest("button[data-action], button[id]");
  if (!button) return;

  const action = button.dataset.action || button.id;

  const actions = {
    loginButton: login,
    heroLoginButton: login,
    logoutButton: logout,
    premiumButton: openPayment,
    payButton: startPayment,
    closePaymentButton: closePayment,
    backButton: backToDashboard,
    checkAnswerButton: submitAnswer,
    nextQuestionButton: nextQuestion,
    previousQuestionButton: previousQuestion
  };

  if (actions[action]) {
    event.preventDefault();
    actions[action]();
    return;
  }

  if (button.dataset.lesson) {
    event.preventDefault();
    openLesson(Number(button.dataset.lesson));
    return;
  }

  if (button.dataset.option !== undefined) {
    event.preventDefault();
    selectOption(Number(button.dataset.option));
  }
});


/* =========================================
   API HELPER
========================================= */

async function api(path, options = {}) {
  const config = {
    method: options.method || "GET",
    credentials: "include",
    headers: {}
  };

  if (options.body !== undefined) {
    config.headers["Content-Type"] = "application/json";
    config.body = JSON.stringify(options.body);
  }

  let response;

  try {
    response = await fetch(API + path, config);
  } catch (error) {
    throw new Error(
      "Cannot connect to the Academy server. Check the Worker CORS configuration."
    );
  }

  const raw = await response.text();
  let data = {};

  try {
    data = raw ? JSON.parse(raw) : {};
  } catch {
    data = { error: raw || "Invalid server response" };
  }

  if (!response.ok) {
    throw new Error(
      data.error || data.message || "Server error: " + response.status
    );
  }

  return data;
}


/* =========================================
   GOOGLE LOGIN
========================================= */

async function login() {
  if (busy) return;
  busy = true;

  const buttons = [
    document.getElementById("loginButton"),
    document.getElementById("heroLoginButton")
  ];

  buttons.forEach(button => {
    button.disabled = true;
    button.textContent = "Connecting...";
  });

  try {
    const data = await api("/auth/google");

    if (!data.url) {
      throw new Error("Google authorization URL was not returned.");
    }

    window.location.assign(data.url);

  } catch (error) {
    showMessage(error.message, "error");
    buttons.forEach(button => {
      button.disabled = false;
      button.textContent = button.id === "heroLoginButton"
        ? "Continue with Google"
        : "Sign in";
    });
    busy = false;
  }
}


/* =========================================
   LOGOUT
========================================= */

async function logout() {
  try {
    await api("/auth/logout", { method: "POST" });
  } catch (error) {
    console.error(error);
  }

  currentUser = null;
  currentProgress = {};

  showGuest();
  showMessage("You have signed out.", "success");
}


/* =========================================
   SESSION
========================================= */

async function initialize() {
  try {
    const data = await api("/student/me");

    if (
      data.authenticated === false ||
      data.logged_in === false ||
      data.user === null
    ) {
      showGuest();
      return;
    }

    currentUser = data.user || data.student || data;

    if (!currentUser || Object.keys(currentUser).length === 0) {
      showGuest();
      return;
    }

    showDashboard();
    await loadProgress();

  } catch (error) {
    console.error("Session check:", error);
    showGuest();
  }
}


function showGuest() {
  document.getElementById("hero").classList.remove("hidden");
  document.getElementById("dashboard").classList.add("hidden");
  document.getElementById("lessonSection").classList.add("hidden");
  document.getElementById("loginButton").classList.remove("hidden");
  document.getElementById("logoutButton").classList.add("hidden");
}


function showDashboard() {
  document.getElementById("hero").classList.add("hidden");
  document.getElementById("dashboard").classList.remove("hidden");
  document.getElementById("lessonSection").classList.add("hidden");
  document.getElementById("loginButton").classList.add("hidden");
  document.getElementById("logoutButton").classList.remove("hidden");

  document.getElementById("studentName").textContent =
    "Welcome, " +
    (currentUser.name || currentUser.full_name || currentUser.email || "Student");
}


/* =========================================
   PREMIUM STATUS
========================================= */

function isPremium() {
  if (!currentUser) return false;

  if (
    currentUser.is_premium === true ||
    currentUser.premium === true ||
    currentUser.subscription_active === true
  ) return true;

  const status = String(
    currentUser.subscription_status ||
    currentUser.subscription ||
    ""
  ).toLowerCase();

  if (status === "active" || status === "premium") return true;

  const expiry =
    currentUser.subscription_expires_at ||
    currentUser.premium_until ||
    currentUser.expires_at;

  if (expiry) {
    const date = new Date(expiry);
    if (!isNaN(date.getTime()) && date > new Date()) return true;
  }

  return false;
}


/* =========================================
   PROGRESS
========================================= */

async function loadProgress() {
  try {
    const data = await api("/student/progress");
    currentProgress = data.progress || data;

  } catch (error) {
    console.error("Progress loading:", error);
    currentProgress = {};
    showMessage("Could not load progress: " + error.message, "error");
  }

  updateStats();
  renderLessons();
}


function progressNumber(...keys) {
  for (const key of keys) {
    if (currentProgress[key] !== undefined) {
      return Number(currentProgress[key]) || 0;
    }
  }
  return 0;
}


function updateStats() {
  const completed = progressNumber(
    "completed_lessons", "lessons_completed"
  );

  const answered = progressNumber(
    "answered", "questions_answered", "total_answered"
  );

  const correct = progressNumber(
    "correct", "correct_answers", "total_correct"
  );

  const accuracy = answered
    ? Math.round(correct / answered * 100)
    : 0;

  const overall = Math.min(100, Math.round(completed / 20 * 100));

  document.getElementById("statLessons").textContent =
    completed + "/20";

  document.getElementById("statQuestions").textContent = answered;
  document.getElementById("statCorrect").textContent = correct;
  document.getElementById("statPercent").textContent = accuracy + "%";
  document.getElementById("progressLabel").textContent = overall + "%";
  document.getElementById("overallProgress").style.width = overall + "%";

  document.getElementById("subscriptionStatus").innerHTML =
    isPremium()
      ? '<span class="tag tag-done">✓ PREMIUM ACTIVE</span>'
      : '<span class="tag tag-premium">FREE ACCOUNT</span>';

  document.getElementById("premiumBanner").classList.toggle(
    "hidden", isPremium()
  );
}


/* =========================================
   LESSON LIST
========================================= */

function lessonCompleted(id) {
  const list =
    currentProgress.completed_lesson_ids ||
    currentProgress.completed_lessons_ids ||
    [];

  if (Array.isArray(list)) {
    return list.includes(id) || list.includes(String(id));
  }

  const lessons = currentProgress.lessons || {};

  return Boolean(
    lessons[id]?.completed ||
    lessons[String(id)]?.completed
  );
}


function renderLessons() {
  const grid = document.getElementById("lessonsGrid");
  const premium = isPremium();

  grid.innerHTML = LESSONS.map((name, index) => {
    const id = index + 1;
    const locked = id !== 1 && !premium;
    const completed = lessonCompleted(id);

    let tags = id === 1
      ? '<span class="tag tag-free">FREE LESSON</span>'
      : '<span class="tag tag-premium">PREMIUM</span>';

    if (completed) {
      tags += ' <span class="tag tag-done">COMPLETED</span>';
    }

    const action = locked
      ? `<button class="btn btn-outline" data-action="openPayment">🔒 Unlock</button>`
      : `<button class="btn btn-dark" data-lesson="${id}">${completed ? "Review" : "Start"} →</button>`;

    return `
      <article class="lesson-card">
        <div class="lesson-number">${String(id).padStart(2, "0")}</div>
        <div class="lesson-details">
          <h3>${escapeHTML(name)}</h3>
          <p>50 multiple-choice questions</p>
          ${tags}
        </div>
        <div class="lesson-action">${action}</div>
      </article>
    `;
  }).join("");
}


/* =========================================
   LESSON QUESTIONS
========================================= */

async function openLesson(id) {
  if (id !== 1 && !isPremium()) {
    openPayment();
    return;
  }

  currentLessonId = id;
  currentQuestionIndex = 0;
  currentQuestions = [];

  document.getElementById("dashboard").classList.add("hidden");
  document.getElementById("lessonSection").classList.remove("hidden");

  document.getElementById("lessonHeading").textContent =
    "Lesson " + id + " — " + LESSONS[id - 1];

  document.getElementById("questionArea").innerHTML =
    '<div class="loading"><div class="spinner"></div>Loading questions...</div>';

  window.scrollTo({ top: 0, behavior: "smooth" });

  try {
    const data = await api("/lessons/" + id + "/questions");

    currentQuestions = Array.isArray(data)
      ? data
      : data.questions || data.items || [];

    if (!currentQuestions.length) {
      throw new Error("No questions were returned for this lesson.");
    }

    renderQuestion();

  } catch (error) {
    document.getElementById("questionArea").innerHTML =
      `<div class="message error">${escapeHTML(error.message)}</div>`;
  }
}


function questionOptions(question) {
  let options =
    question.options ||
    question.choices ||
    question.answers ||
    question.options_json ||
    [];

  if (typeof options === "string") {
    try { options = JSON.parse(options); }
    catch { options = []; }
  }

  if (!Array.isArray(options)) {
    options = Object.values(options || {});
  }

  return options;
}


function renderQuestion() {
  const question = currentQuestions[currentQuestionIndex];

  if (!question) {
    finishLesson();
    return;
  }

  selectedAnswer = null;
  answerSubmitted = false;

  const total = currentQuestions.length;
  const number = currentQuestionIndex + 1;
  const options = questionOptions(question);

  document.getElementById("questionCounter").textContent =
    `Question ${number} of ${total}`;

  document.getElementById("questionProgress").style.width =
    (number / total * 100) + "%";

  document.getElementById("questionArea").innerHTML = `
    <div class="question-text">
      ${escapeHTML(question.question || question.question_text || question.text || "Question")}
    </div>

    <div class="options">
      ${options.map((option, index) => `
        <button class="option" data-option="${index}">
          <span class="option-letter">${String.fromCharCode(65 + index)}</span>
          <span>${escapeHTML(typeof option === "object" ? (option.text || option.label || "") : String(option))}</span>
        </button>
      `).join("")}
    </div>

    <div id="answerFeedback"></div>

    <div class="question-controls">
      <button class="btn btn-outline" id="previousQuestionButton"
        ${currentQuestionIndex === 0 ? "disabled" : ""}>
        ← Previous
      </button>

      <button class="btn btn-gold" id="checkAnswerButton" disabled>
        Check Answer
      </button>

      <button class="btn btn-dark hidden" id="nextQuestionButton">
        Next →
      </button>
    </div>
  `;
}


function selectOption(index) {
  if (answerSubmitted) return;

  selectedAnswer = index;

  document.querySelectorAll(".option").forEach((button, i) => {
    button.classList.toggle("selected", i === index);
  });

  document.getElementById("checkAnswerButton").disabled = false;
}


/* =========================================
   ANSWER SUBMISSION
========================================= */

async function submitAnswer() {
  if (selectedAnswer === null || answerSubmitted) return;

  const question = currentQuestions[currentQuestionIndex];

  const questionId = question.id || question.question_id;

  const button = document.getElementById("checkAnswerButton");
  button.disabled = true;
  button.textContent = "Checking...";

  try {
    const data = await api("/answers", {
      method: "POST",
      body: {
        question_id: questionId,
        selected_answer: selectedAnswer
      }
    });

    answerSubmitted = true;

    const correct = data.correct === true || data.is_correct === true;

    const correctAnswer =
      data.correct_answer ?? question.correct_answer;

    document.querySelectorAll(".option").forEach((option, index) => {
      option.disabled = true;

      if (
        correctAnswer !== undefined &&
        index === Number(correctAnswer)
      ) {
        option.classList.add("correct");
      }

      if (index === selectedAnswer && !correct) {
        option.classList.add("wrong");
      }
    });

    const explanation = data.explanation || question.explanation || "";

    document.getElementById("answerFeedback").innerHTML = `
      <div class="feedback ${correct ? "good" : "bad"}">
        <strong>${correct ? "✓ Correct answer!" : "✗ Incorrect answer"}</strong>
        ${explanation ? `<div style="margin-top:8px">${escapeHTML(explanation)}</div>` : ""}
      </div>
    `;

    button.classList.add("hidden");
    document.getElementById("nextQuestionButton").classList.remove("hidden");

  } catch (error) {
    button.disabled = false;
    button.textContent = "Check Answer";
    showMessage(error.message, "error");
  }
}


function nextQuestion() {
  if (currentQuestionIndex < currentQuestions.length - 1) {
    currentQuestionIndex++;
    renderQuestion();
  } else {
    finishLesson();
  }
}


function previousQuestion() {
  if (currentQuestionIndex > 0) {
    currentQuestionIndex--;
    renderQuestion();
  }
}


function finishLesson() {
  document.getElementById("questionArea").innerHTML = `
    <div style="text-align:center;padding:35px 10px">
      <div style="font-size:55px">🎉</div>
      <h2>Lesson Completed!</h2>
      <p style="color:#778198;line-height:1.7">
        You have reached the end of this lesson.
        Your submitted answers have been saved.
      </p>
      <button class="btn btn-gold" id="backButton">Return to Dashboard</button>
    </div>
  `;

  document.getElementById("questionCounter").textContent = "Completed";
  document.getElementById("questionProgress").style.width = "100%";

  loadProgress();
}


function backToDashboard() {
  document.getElementById("lessonSection").classList.add("hidden");
  document.getElementById("dashboard").classList.remove("hidden");

  loadProgress();
  window.scrollTo({ top: 0, behavior: "smooth" });
}


/* =========================================
   PAYHERE
========================================= */

function openPayment() {
  if (!currentUser) {
    login();
    return;
  }

  document.getElementById("paymentModal").classList.remove("hidden");
  document.getElementById("paymentMessage").innerHTML = "";
}


function closePayment() {
  document.getElementById("paymentModal").classList.add("hidden");
}


async function startPayment() {
  if (busy) return;

  busy = true;

  const button = document.getElementById("payButton");
  const message = document.getElementById("paymentMessage");

  button.disabled = true;
  button.textContent = "Preparing checkout...";

  try {
    const data = await api("/payments/create", {
      method: "POST",
      body: {}
    });

    const checkoutUrl =
      data.checkout_url || data.url || data.action;

    const fields =
      data.fields || data.payment || data;

    if (!checkoutUrl || typeof fields !== "object") {
      throw new Error("Invalid PayHere checkout response from Worker.");
    }

    const form = document.createElement("form");
    form.method = "POST";
    form.action = checkoutUrl;
    form.style.display = "none";

    Object.entries(fields).forEach(([key, value]) => {
      if (value === null || value === undefined || typeof value === "object") {
        return;
      }

      const input = document.createElement("input");
      input.type = "hidden";
      input.name = key;
      input.value = String(value);
      form.appendChild(input);
    });

    document.body.appendChild(form);
    form.submit();

  } catch (error) {
    message.innerHTML =
      `<div class="message error">${escapeHTML(error.message)}</div>`;

    button.disabled = false;
    button.textContent = "Try Again";

  } finally {
    busy = false;
  }
}


/* =========================================
   MESSAGES
========================================= */

function showMessage(message, type = "info") {
  const area = document.getElementById("globalMessage");

  area.innerHTML =
    `<div class="message ${type}">${escapeHTML(message)}</div>`;

  clearTimeout(showMessage.timer);

  showMessage.timer = setTimeout(() => {
    area.innerHTML = "";
  }, 8000);
}


function escapeHTML(value) {
  return String(value ?? "").replace(/[&<>"']/g, char => ({
    "&": "&amp;",
    "<": "&lt;",
    ">": "&gt;",
    '"': "&quot;",
    "'": "&#039;"
  })[char]);
}


/* =========================================
   START
========================================= */

window.addEventListener("DOMContentLoaded", async () => {
  console.log("CreateLK Academy frontend loaded.");

  await initialize();
});
</script>

</body>
</html>
