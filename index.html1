<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#0b1628">
<title>CreateLK English</title>
<meta name="description" content="Practice English MCQ questions with CreateLK English.">

<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial;background:#0b1628;color:#dbe4f0}
button{font:inherit;cursor:pointer}
header{position:sticky;top:0;z-index:20;background:#0a1527f5;border-bottom:1px solid #243753}
nav,main{max-width:1000px;margin:auto}
nav{height:58px;padding:7px 15px;display:flex;align-items:center;gap:9px}
.brand{display:flex;align-items:center;gap:8px;margin-right:auto;color:#fff;text-decoration:none}
.logo-img{width:38px;height:38px;object-fit:contain}
.logo{font-size:19px;font-weight:900}.logo span,.gold{color:#d9b85c}
.btn{border:0;border-radius:8px;padding:10px 14px;background:#c5a64b;color:#101b2c;font-weight:800}
.light{background:#172942;color:#dbe4f0;border:1px solid #30435e}
.avatar{display:none;width:38px;height:38px;border-radius:50%;object-fit:cover;border:2px solid #c5a64b}
.menu-wrap{position:relative}
.menu-btn{width:40px;height:40px;border:1px solid #30435e;border-radius:8px;background:#172942;color:#fff;font-size:20px}
.menu{display:none;position:absolute;right:0;top:46px;width:225px;background:#13233b;border:1px solid #30435e;border-radius:10px;padding:6px;box-shadow:0 12px 30px #0008}
.menu.show{display:block}.menu a{display:block;padding:9px;color:#dbe4f0;text-decoration:none;border-radius:6px}
.menu a:hover{background:#1c304a}.menu-title{padding:8px 9px 3px;color:#c5a64b;font-size:10px;font-weight:bold}
main{padding:18px 15px 40px}
.hero,.card,.question-card{background:#13233b;border:1px solid #243753;border-radius:14px}
.hero{max-width:900px;margin:auto;text-align:center;padding:28px 18px;border-radius:17px}
.hero h1{font-size:clamp(28px,6vw,42px);margin:6px 0}
.hero p{max-width:650px;margin:auto;color:#aab8cc;line-height:1.6}
.stats{display:flex;justify-content:center;flex-wrap:wrap;gap:8px;margin:18px 0}
.stat{min-width:95px;padding:8px 12px;background:#172942;border:1px solid #2b405c;border-radius:8px}
.stat strong{display:block;color:#d9b85c}.stat small{color:#8497af;font-size:9px}
.account{display:none;margin-top:5px;padding:8px 13px;background:#172942;border:1px solid #30435e;border-radius:20px;font-size:12px;font-weight:bold}
.rank{display:inline-block;margin-top:10px;padding:9px 13px;background:#172942;border:1px solid #30435e;border-radius:8px;color:#fff;text-decoration:none;font-weight:bold}
.notice{display:none;max-width:900px;margin:10px auto;padding:10px;text-align:center;background:#3b252a;border:1px solid #71434a;border-radius:8px;color:#edb9bf}
.notice.show{display:block}
.section-title{max-width:900px;margin:25px auto 12px}.section-title h2{margin:0}.section-title p{margin:5px 0;color:#8497af;font-size:13px}
.grid{max-width:900px;margin:auto;display:grid;grid-template-columns:repeat(auto-fill,minmax(235px,1fr));gap:13px}
.card{overflow:hidden}.card-top{height:5px;background:#bda451}.card-body{padding:15px}
.card h3{margin:7px 0}.card p{color:#9eacc2;line-height:1.5;font-size:13px}
.badge{display:inline-block;padding:4px 8px;border-radius:12px;font-size:10px;font-weight:bold}
.free{background:#193b32;color:#a9dfc9}.pro{background:#493e20;color:#ead797}.card .btn{width:100%;margin-top:10px}
.quiz{display:none;max-width:900px;margin:auto}
.quiz-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}
.quiz-title{font-size:20px;font-weight:900}.progress{font-size:12px;color:#8497af;margin-top:3px}
.gamebar{display:grid;grid-template-columns:1fr auto auto;gap:7px;margin-bottom:12px}
.meter{height:8px;background:#1b2b42;border-radius:20px;overflow:hidden}.meter div{height:100%;background:#c5a64b}
.game-stat{padding:7px 9px;background:#172942;border:1px solid #30435e;border-radius:8px;font-size:12px;font-weight:bold}
.game-stat span{color:#d9b85c}
.question-card{padding:19px}.question{font-size:19px;font-weight:800;line-height:1.5;margin-bottom:13px}
.option{display:block;width:100%;padding:12px;margin:6px 0;text-align:left;background:#172942;color:#dbe4f0;border:1px solid #30435e;border-radius:8px}
.option:hover{border-color:#c5a64b}.option.correct{background:#193b32;border-color:#4f9b7b;color:#b8e4d1}
.option.wrong{background:#3b252a;border-color:#8d555d;color:#edb9bf}
.feedback{display:none;margin-top:10px;padding:10px;border-radius:8px;font-weight:bold}
.feedback.show{display:block}.feedback.correct{background:#193b32;color:#b8e4d1}.feedback.wrong{background:#3b252a;color:#edb9bf}
.actions{display:flex;justify-content:space-between;gap:8px;margin-top:13px}
.result{text-align:center;padding:25px}.score{font-size:55px;font-weight:900;color:#d9b85c}
.reward{display:flex;justify-content:center;flex-wrap:wrap;gap:8px;margin:15px 0}
.reward div{padding:9px 15px;background:#172942;border:1px solid #30435e;border-radius:8px}
.reward strong{display:block;color:#d9b85c}
footer{border-top:1px solid #243753;padding:25px 15px;text-align:center;color:#74869e;font-size:11px}
footer a{color:#aab8cc;text-decoration:none;margin:0 5px}
@media(max-width:600px){
.logo{font-size:16px}.hero{padding:22px 13px}.gamebar{grid-template-columns:1fr auto}
.meter{grid-column:1/-1;grid-row:2}.question{font-size:17px}
}
</style>
</head>

<body>
<header><nav>
<a class="brand" href="/Eng/">
<img class="logo-img" src="https://assets.createlk.com/file_00000000f97082119cf85b0ae761f096.png" alt="CreateLK">
<div class="logo">CreateLK <span>English</span></div>
</a>
<button class="btn" id="loginBtn" onclick="login()">Sign in</button>
<img id="avatar" class="avatar" alt="Profile">
<div class="menu-wrap">
<button class="menu-btn" onclick="toggleMenu()">☰</button>
<div class="menu" id="menu">
<a href="/Eng/">📚 Lessons</a>
<a href="/Eng/rank.html">🏆 Leaderboard</a>
<a href="/Eng/aff.html">💰 Affiliate Dashboard</a>
<a href="/Eng/about.html">ℹ️ About Us</a>
<a href="/Eng/contact.html">📩 Contact Us</a>
<div class="menu-title">POLICIES</div>
<a href="/Eng/terms.html">Terms & Conditions</a>
<a href="/Eng/privacy.html">Privacy Policy</a>
<a href="/Eng/refund.html">Refund & Cancellation</a>
<a href="/Eng/payment.html">Payment Policy</a>
<a href="/Eng/disclaimer.html">Disclaimer</a>
<a id="logoutMenu" href="#" onclick="logout();return false" style="display:none">🚪 Logout</a>
</div></div>
</nav></header>

<main>
<section class="hero" id="hero">
<div class="gold">CREATE LK ACADEMY</div>
<h1>CreateLK English</h1>
<p>Learn English with confidence. Practice English MCQ questions and improve your English step by step.</p>
<div class="stats">
<div class="stat"><strong>1,000+</strong><small>QUESTIONS</small></div>
<div class="stat"><strong id="xp">0</strong><small>XP</small></div>
<div class="stat"><strong id="coins">0</strong><small>COINS</small></div>
</div>
<div class="account" id="account"></div><br>
<a class="rank" href="/Eng/rank.html">🏆 View Leaderboard</a>
</section>

<div class="notice" id="notice"></div>

<div class="section-title" id="lessonTitle">
<h2>📚 English Lessons</h2>
<p>Choose a lesson and start practicing.</p>
</div>

<section class="grid" id="lessons"></section>

<section class="quiz" id="quiz">
<div class="quiz-head">
<div><div class="quiz-title" id="quizTitle"></div><div class="progress" id="progress"></div></div>
<button class="btn light" onclick="backLessons()">✕</button>
</div>

<div class="gamebar">
<div class="meter"><div id="meter"></div></div>
<div class="game-stat">🪙 <span id="qCoins">0</span></div>
<div class="game-stat">⚡ <span id="qXp">0</span></div>
</div>

<div class="question-card">
<div class="question" id="question"></div>
<div id="options"></div>
<div class="feedback" id="feedback"></div>
<div class="actions">
<button class="btn light" id="prevBtn" onclick="previousQuestion()">Previous</button>
<button class="btn" id="nextBtn" onclick="nextQuestion()">Next</button>
</div>
</div>
</section>
</main>

<footer>
<div>© <span id="year"></span> CreateLK English</div>
<div style="margin-top:8px">
<a href="/Eng/terms.html">Terms</a>
<a href="/Eng/privacy.html">Privacy</a>
<a href="/Eng/refund.html">Refund</a>
<a href="/Eng/contact.html">Contact</a>
</div>
</footer>

<script>
const API="https://eng.createlk.workers.dev",PAY_URL="https://pay.createlk.workers.dev",$=id=>document.getElementById(id);
let user=null,lessons=[],qs=[],answers={},results={},lessonId=0,lessonTitle="",attemptId="",n=0,coins=0,xp=0,submitting=false,audio;

async function api(path,opt={}){
 const r=await fetch(API+path,{credentials:"include",...opt});
 let d={};try{d=await r.json()}catch{}
 if(!r.ok)throw Error(d.error||"Request failed.");
 return d;
}
const post=(p,b)=>api(p,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(b)});
const esc=v=>String(v??"").replace(/[&<>"']/g,x=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[x]));
function notice(x){$("notice").textContent=x;$("notice").classList.add("show");clearTimeout(window.nt);window.nt=setTimeout(()=>$("notice").classList.remove("show"),3500)}
function toggleMenu(){$("menu").classList.toggle("show")}
document.addEventListener("click",e=>{if(!e.target.closest(".menu-wrap"))$("menu").classList.remove("show")});
function login(){location.href=API+"/auth/google"}
async function logout(){try{await api("/auth/logout")}catch{}location.reload()}

function premium(l){
 if(String(l.access_type||"").toUpperCase()=="FREE"||l.is_free===true||l.free===true||l.premium===false)return false;
 return Number(l.id||l.lesson_id)!==1;
}

async function loadMe(){
 try{
  const d=await api("/api/me");user=d.user||null;
  if(!user){$("loginBtn").style.display="block";$("avatar").style.display="none";$("logoutMenu").style.display="none";$("account").style.display="none";return}
  coins=+user.coins||0;xp=+user.xp||0;
  $("loginBtn").style.display="none";$("avatar").style.display="block";$("logoutMenu").style.display="block";
  if(user.picture)$("avatar").src=user.picture;
  $("account").style.display="inline-block";
  $("account").textContent=`🪙 ${coins} Coins · ⚡ ${xp} XP`;
  $("coins").textContent=coins;$("xp").textContent=xp;
 }catch{}
}

async function loadLessons(){
 try{
  const d=await api("/api/titles");
  lessons=Array.isArray(d)?d:(d.lessons||d.titles||[]);
  $("lessons").innerHTML=lessons.map((l,i)=>{
   const id=+(l.id||l.lesson_id||i+1),pro=premium(l);
   return `<article class="card"><div class="card-top"></div><div class="card-body">
   <span class="badge ${pro?"pro":"free"}">${pro?"⭐ PREMIUM":"✓ FREE"}</span>
   <h3>${esc(l.title||l.name||`Lesson ${id}`)}</h3>
   <p>${esc(l.description||"Practice English questions and improve your skills.")}</p>
   <button class="btn" onclick="openLesson(${i})">${pro?"🔒 Start Premium":"▶ Start Lesson"}</button>
   </div></article>`;
  }).join("");
 }catch(e){notice(e.message)}
}

async function openLesson(i){
 const l=lessons[i];if(!l)return;
 lessonId=+(l.id||l.lesson_id||i+1);
 lessonTitle=l.title||l.name||`Lesson ${lessonId}`;
 if(!premium(l))return loadQuiz();
 if(!user)return notice("Please sign in to access this premium lesson.");
 try{
  const d=await api("/api/me");
  if(d.premium===true||d.user?.premium===true)return loadQuiz();
  location.href=PAY_URL;
 }catch{notice("Please sign in again.")}
}

async function loadQuiz(){
 if(!user)return notice("Please sign in to start the quiz.");
 $("hero").style.display=$("lessonTitle").style.display=$("lessons").style.display="none";
 $("quiz").style.display="block";$("quizTitle").textContent=lessonTitle;$("question").textContent="Loading...";
 try{
  const s=await post("/api/quiz/start",{lesson_id:lessonId});
  attemptId=s.attempt_id||s.id||s.attempt?.id;
  if(!attemptId)throw Error("Unable to start quiz.");
  const d=await api("/api/questions?lesson_id="+encodeURIComponent(lessonId));
  if(d.premium_required)return location.href=PAY_URL;
  qs=Array.isArray(d)?d:(d.questions||[]);
  if(!qs.length)throw Error("No questions available.");
  answers={};results={};n=0;submitting=false;render();
 }catch(e){backLessons();notice(e.message)}
}

function norm(v){
 v=String(v??"").trim().toLowerCase().replace(/[.)]$/,"");
 return({1:"a",2:"b",3:"c",4:"d",a:"a",b:"b",c:"c",d:"d",option_a:"a",option_b:"b",option_c:"c",option_d:"d",answer_a:"a",answer_b:"b",answer_c:"c",answer_d:"d"})[v]||null;
}
function text(q){return q.question||q.question_text||q.text||q.title||"Question"}
function opts(q){return{a:q.a||q.option_a||q.answer_a||"",b:q.b||q.option_b||q.answer_b||"",c:q.c||q.option_c||q.answer_c||"",d:q.d||q.option_d||q.answer_d||""}}

function render(){
 const q=qs[n];if(!q)return;
 const id=q.id||q.question_id||n,r=results[id],sel=answers[id],o=opts(q),total=qs.length;
 $("progress").textContent=`Question ${n+1} of ${total}`;
 $("meter").style.width=(n+1)/total*100+"%";
 $("question").textContent=text(q);
 $("options").innerHTML=["a","b","c","d"].map(x=>`<button class="option ${sel===x?(r?.correct?"correct":"wrong"):""}" ${r?"disabled":""} onclick="answer('${x}')"><b>${x.toUpperCase()}.</b> ${esc(o[x])}</button>`).join("");
 const f=$("feedback");
 if(r){f.className="feedback show "+(r.correct?"correct":"wrong");f.innerHTML=r.correct?"✓ Correct!":`✗ Incorrect. Correct answer: <b>${esc(r.correctAnswer||"")}</b>`}
 else{f.className="feedback";f.innerHTML=""}
 $("prevBtn").disabled=n==0;$("nextBtn").textContent=n==total-1?"Finish":"Next";
 $("qCoins").textContent=coins;$("qXp").textContent=xp;
}

async function answer(a){
 const q=qs[n],id=q.id||q.question_id||n;if(results[id])return;
 answers[id]=a;render();
 try{
  const d=await post("/api/quiz/check",{attempt_id:attemptId,question_id:q.id||q.question_id,answer:a});
  const correct=d.correct??d.is_correct??d.result?.correct;
  const ca=norm(d.correct_answer??d.correctAnswer??d.result?.correct_answer)||"";
  const o=opts(q);
  results[id]={correct:correct===true||correct===1||String(correct).toLowerCase()=="true",correctAnswer:o[ca]||ca.toUpperCase()};
  if(d.total_coins!==undefined)coins=+d.total_coins;
  if(d.total_xp!==undefined)xp=+d.total_xp;
  $("coins").textContent=coins;$("xp").textContent=xp;render();sound(results[id].correct);
 }catch(e){delete answers[id];render();notice(e.message)}
}

function previousQuestion(){if(n>0){n--;render()}}
async function nextQuestion(){
 const id=qs[n].id||qs[n].question_id||n;
 if(!results[id])return notice("Please answer the question first.");
 if(n<qs.length-1){n++;render()}else await submitQuiz();
}

async function submitQuiz(){
 if(submitting)return;submitting=true;$("nextBtn").disabled=true;
 try{
  const d=await post("/api/quiz/submit",{attempt_id:attemptId});
  const score=Object.values(results).filter(x=>x.correct).length,total=qs.length;
  const rc=Number(d.coins_earned??d.reward?.coins??d.coinsEarned??0);
  const rx=Number(d.xp_earned??d.reward?.xp??d.xpEarned??0);
  await loadMe();
  $("quiz").innerHTML=`<div class="question-card result">
  <div class="gold">QUIZ COMPLETED</div>
  <div class="score">${score}/${total}</div>
  <p>You answered ${score} out of ${total} questions correctly.</p>
  <div class="reward">
  <div><strong>🪙 ${rc}</strong>Coins Earned</div>
  <div><strong>⚡ ${rx}</strong>XP Earned</div>
  </div>
  <button class="btn" onclick="backLessons()">Back to Lessons</button>
  </div>`;
 }catch(e){submitting=false;$("nextBtn").disabled=false;notice(e.message)}
}

function backLessons(){
 $("quiz").style.display="none";$("hero").style.display="block";$("lessonTitle").style.display="block";$("lessons").style.display="grid";
 $("quiz").innerHTML=`<div class="quiz-head"><div><div class="quiz-title" id="quizTitle"></div><div class="progress" id="progress"></div></div><button class="btn light" onclick="backLessons()">✕</button></div>
 <div class="gamebar"><div class="meter"><div id="meter"></div></div><div class="game-stat">🪙 <span id="qCoins">0</span></div><div class="game-stat">⚡ <span id="qXp">0</span></div></div>
 <div class="question-card"><div class="question" id="question"></div><div id="options"></div><div class="feedback" id="feedback"></div>
 <div class="actions"><button class="btn light" id="prevBtn" onclick="previousQuestion()">Previous</button><button class="btn" id="nextBtn" onclick="nextQuestion()">Next</button></div></div>`;
 loadMe();
}

function sound(win){
 try{
  audio||(audio=new(window.AudioContext||window.webkitAudioContext)());
  const o=audio.createOscillator(),g=audio.createGain();
  o.frequency.value=win?700:220;g.gain.value=.035;o.connect(g);g.connect(audio.destination);o.start();o.stop(audio.currentTime+.12);
 }catch{}
}

$("year").textContent=new Date().getFullYear();
(async()=>{await loadMe();await loadLessons()})();
</script>
</body>
</html>