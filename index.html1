
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="CreateLK Academy - Learn and practise English grammar with 1,000 MCQs across 20 categories.">
  <meta name="theme-color" content="#101b3d">
  <title>CreateLK Academy | English Grammar Practice</title>

  <script
    src="https://accounts.google.com/gsi/client"
    async
    defer
    onload="onGoogleLibraryLoaded()"
  ></script>

  <style>
    :root {
      --primary: #172554;
      --secondary: #2563eb;
      --accent: #f5b82e;
      --light: #f5f7fc;
      --dark: #14213d;
      --muted: #64748b;
      --green: #16a34a;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: var(--light);
      color: var(--dark);
      line-height: 1.6;
    }

    a {
      text-decoration: none;
    }

    .container {
      width: min(1150px, 92%);
      margin: auto;
    }

    /* HEADER AND NAVIGATION */

    header {
      background: var(--primary);
      position: sticky;
      top: 0;
      z-index: 1000;
      box-shadow: 0 3px 15px rgba(0,0,0,0.12);
    }

    .navbar {
      min-height: 76px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 10px;
      color: white;
      font-weight: bold;
      font-size: 19px;
      white-space: nowrap;
    }

    .logo img {
      width: 48px;
      height: 48px;
      object-fit: contain;
      background: white;
      border-radius: 9px;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .nav-links a {
      color: white;
      font-size: 13px;
      font-weight: 600;
      transition: 0.2s;
      white-space: nowrap;
    }

    .nav-links a:hover {
      color: var(--accent);
    }

    .nav-login {
      background: var(--accent);
      color: var(--primary) !important;
      padding: 10px 17px;
      border-radius: 7px;
    }

    .menu-toggle {
      display: none;
      border: none;
      background: transparent;
      color: white;
      font-size: 28px;
      cursor: pointer;
    }

    /* HERO */

    .hero {
      background: linear-gradient(120deg, #101b3d, #1d4ed8);
      color: white;
      padding: 85px 0;
    }

    .hero-content {
      display: grid;
      grid-template-columns: 1fr;
      align-items: center;
      gap: 45px;
    }

    .hero h1 {
      font-size: clamp(34px, 5vw, 55px);
      line-height: 1.15;
      margin-bottom: 22px;
    }

    .hero h1 span {
      color: var(--accent);
    }

    .hero p {
      color: #dbeafe;
      font-size: 17px;
      margin-bottom: 28px;
      max-width: 600px;
    }

    .hero-buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
    }

    .btn {
      display: inline-block;
      padding: 13px 23px;
      border-radius: 8px;
      font-weight: bold;
      transition: 0.2s;
      border: 2px solid transparent;
      cursor: pointer;
    }

    .btn:hover {
      transform: translateY(-2px);
    }

    .btn-primary {
      background: var(--accent);
      color: var(--primary);
    }

    .btn-outline {
      border-color: white;
      color: white;
    }

    /* STATISTICS */

    .stats {
      margin-top: -35px;
      position: relative;
      z-index: 2;
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }

    .stat-card {
      background: white;
      padding: 25px 15px;
      text-align: center;
      border-radius: 12px;
      box-shadow: 0 5px 25px rgba(15,23,42,0.08);
    }

    .stat-card h2 {
      color: var(--secondary);
      font-size: 30px;
    }

    .stat-card p {
      color: var(--muted);
      font-size: 14px;
    }

    /* GENERAL SECTIONS */

    section {
      padding: 75px 0;
    }

    .section-heading {
      text-align: center;
      margin-bottom: 40px;
    }

    .section-heading h2 {
      color: var(--primary);
      font-size: clamp(27px, 4vw, 36px);
      margin-bottom: 10px;
    }

    .section-heading p {
      color: var(--muted);
      max-width: 650px;
      margin: auto;
    }

    /* CATEGORIES */

    .categories-section {
      padding-top: 85px;
    }

    .category-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
    }

    .category-card {
      background: white;
      border-radius: 12px;
      padding: 23px 20px;
      border: 1px solid #e2e8f0;
      box-shadow: 0 4px 15px rgba(15,23,42,0.04);
      transition: 0.25s;
      display: flex;
      flex-direction: column;
      min-height: 205px;
      cursor: pointer;
    }

    .category-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 10px 25px rgba(15,23,42,0.09);
      border-color: #93c5fd;
    }

    .category-number {
      width: 38px;
      height: 38px;
      border-radius: 9px;
      background: #dbeafe;
      color: var(--secondary);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: bold;
      margin-bottom: 15px;
    }

    .category-card h3 {
      font-size: 17px;
      color: var(--primary);
      margin-bottom: 8px;
    }

    .category-card p {
      font-size: 13px;
      color: var(--muted);
      margin-bottom: 15px;
    }

    .category-footer {
      margin-top: auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
    }

    .category-count {
      color: var(--muted);
      font-size: 12px;
    }

    .category-status {
      font-size: 11px;
      font-weight: bold;
      padding: 5px 9px;
      border-radius: 20px;
      background: #dcfce7;
      color: #166534;
    }

    .premium-status {
      background: #fef3c7;
      color: #92400e;
    }

    .loading-message,
    .error-message {
      grid-column: 1 / -1;
      text-align: center;
      padding: 30px;
      background: white;
      border-radius: 12px;
      color: var(--muted);
    }

    .error-message {
      color: #b91c1c;
    }

    .retry-btn {
      display: inline-block;
      margin-top: 12px;
      padding: 9px 16px;
      border: none;
      border-radius: 6px;
      background: var(--secondary);
      color: white;
      cursor: pointer;
    }

    /* HOW IT WORKS */

    .how-section {
      background: white;
    }

    .how-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 25px;
    }

    .how-card {
      text-align: center;
      padding: 30px 22px;
      border-radius: 12px;
      background: var(--light);
    }

    .how-icon {
      width: 65px;
      height: 65px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #dbeafe;
      color: var(--secondary);
      font-size: 28px;
      margin: 0 auto 18px;
    }

    .how-card h3 {
      color: var(--primary);
      margin-bottom: 10px;
    }

    .how-card p {
      color: var(--muted);
      font-size: 14px;
    }

    /* PREMIUM */

    .premium-section {
      background: linear-gradient(120deg, #172554, #1e40af);
      color: white;
    }

    .premium-content {
      max-width: 800px;
      margin: auto;
      text-align: center;
    }

    .premium-content h2 {
      font-size: clamp(28px, 4vw, 38px);
      margin-bottom: 15px;
    }

    .premium-content > p {
      color: #dbeafe;
      margin-bottom: 25px;
    }

    .price-card {
      background: white;
      color: var(--dark);
      border-radius: 16px;
      padding: 32px;
      max-width: 420px;
      margin: 30px auto;
      box-shadow: 0 15px 35px rgba(0,0,0,0.2);
    }

    .price-card h3 {
      color: var(--primary);
      font-size: 21px;
    }

    .price {
      font-size: 39px;
      font-weight: bold;
      color: var(--secondary);
      margin: 12px 0;
    }

    .price-card p {
      color: var(--muted);
      font-size: 14px;
    }

    .price-features {
      list-style: none;
      text-align: left;
      margin: 22px 0;
    }

    .price-features li {
      padding: 7px 0;
      color: #334155;
      font-size: 14px;
    }

    .price-features li::before {
      content: "✓";
      color: var(--green);
      font-weight: bold;
      margin-right: 9px;
    }

    .premium-note {
      font-size: 12px !important;
      color: var(--muted) !important;
      margin-top: 12px;
    }

    /* CONTACT */

    .contact-section {
      background: white;
    }

    .contact-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
      max-width: 750px;
      margin: auto;
    }

    .contact-card {
      padding: 25px;
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      text-align: center;
    }

    .contact-card h3 {
      color: var(--primary);
      margin-bottom: 8px;
    }

    .contact-card p {
      color: var(--muted);
      font-size: 14px;
    }

    .contact-card a {
      color: var(--secondary);
      font-weight: bold;
      overflow-wrap: anywhere;
    }

    /* FOOTER */

    footer {
      background: #0b1531;
      color: white;
      padding: 45px 0 20px;
    }

    .footer-grid {
      display: grid;
      grid-template-columns: 1.3fr 1fr 1fr;
      gap: 35px;
      margin-bottom: 35px;
    }

    .footer-brand h3 {
      margin-bottom: 10px;
    }

    .footer-brand p,
    .footer-links a {
      color: #cbd5e1;
      font-size: 13px;
    }

    .footer-links h4 {
      margin-bottom: 13px;
    }

    .footer-links a {
      display: block;
      margin-bottom: 9px;
    }

    .footer-links a:hover {
      color: var(--accent);
    }

    .copyright {
      text-align: center;
      border-top: 1px solid #334155;
      padding-top: 18px;
      color: #94a3b8;
      font-size: 12px;
    }

    /* FLOATING WHATSAPP */

    .whatsapp-float {
      position: fixed;
      width: 60px;
      height: 60px;
      right: 22px;
      bottom: 22px;
      background: #25D366;
      color: white;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 14px rgba(0,0,0,0.25);
      z-index: 99999;
      transition: transform 0.2s ease;
    }

    .whatsapp-float:hover {
      transform: scale(1.1);
    }

    .whatsapp-float svg {
      width: 36px;
      height: 36px;
    }

    .whatsapp-tooltip {
      position: absolute;
      right: 72px;
      background: #172554;
      color: white;
      padding: 8px 12px;
      border-radius: 7px;
      font-size: 12px;
      white-space: nowrap;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s;
    }

    .whatsapp-float:hover .whatsapp-tooltip {
      opacity: 1;
    }

    /* GOOGLE SIGN-IN MODAL */

    .google-modal {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 100000;
      background: rgba(0, 0, 0, 0.65);
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .google-modal.active {
      display: flex;
    }

    .google-modal-content {
      background: white;
      width: 100%;
      max-width: 390px;
      padding: 35px 24px 30px;
      border-radius: 14px;
      text-align: center;
      position: relative;
      box-shadow: 0 15px 45px rgba(0,0,0,0.25);
      animation: googleModalAppear 0.2s ease-out;
    }

    @keyframes googleModalAppear {
      from {
        opacity: 0;
        transform: translateY(12px) scale(0.98);
      }
      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    .google-modal-content h2 {
      color: #172554;
      margin-bottom: 8px;
      font-size: 23px;
    }

    .google-modal-content p {
      color: #64748b;
      font-size: 14px;
      margin-bottom: 24px;
    }

    .google-modal-close {
      position: absolute;
      top: 10px;
      right: 14px;
      border: none;
      background: transparent;
      font-size: 27px;
      color: #64748b;
      cursor: pointer;
      line-height: 1;
      padding: 4px;
    }

    .google-modal-close:hover {
      color: #172554;
    }

    #googleButtonContainer {
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 45px;
      width: 100%;
    }

    .google-loading {
      font-size: 13px;
      color: #64748b;
      margin-top: 12px;
      min-height: 20px;
    }

    .google-spinner {
      display: inline-block;
      width: 17px;
      height: 17px;
      border: 2px solid #dbeafe;
      border-top-color: #2563eb;
      border-radius: 50%;
      animation: googleSpin 0.7s linear infinite;
      vertical-align: middle;
      margin-right: 7px;
    }

    @keyframes googleSpin {
      to {
        transform: rotate(360deg);
      }
    }

    .google-error {
      color: #b91c1c;
    }

    .google-success {
      color: #15803d;
    }

    body.modal-open {
      overflow: hidden;
    }

    /* RESPONSIVE */

    @media (max-width: 1100px) {
      .nav-links {
        gap: 10px;
      }

      .nav-links a {
        font-size: 11px;
      }
    }

    @media (max-width: 760px) {
      .menu-toggle {
        display: block;
      }

      .nav-links {
        display: none;
        position: absolute;
        top: 76px;
        left: 0;
        right: 0;
        background: var(--primary);
        padding: 20px 5%;
        flex-direction: column;
        align-items: stretch;
        gap: 14px;
        max-height: calc(100vh - 76px);
        overflow-y: auto;
      }

      .nav-links.active {
        display: flex;
      }

      .nav-links a {
        padding: 5px 0;
        font-size: 15px;
      }

      .nav-login {
        text-align: center;
      }

      .hero {
        padding: 60px 0;
      }

      .hero-content {
        grid-template-columns: 1fr;
        text-align: center;
      }

      .hero p {
        margin-left: auto;
        margin-right: auto;
      }

      .hero-buttons {
        justify-content: center;
      }

      .category-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
      }

      .category-card {
        padding: 17px 14px;
        min-height: 210px;
      }

      .category-card h3 {
        font-size: 15px;
      }

      .how-grid {
        grid-template-columns: 1fr;
      }

      .footer-grid {
        grid-template-columns: 1fr 1fr;
      }

      .footer-brand {
        grid-column: 1 / -1;
      }
    }

    @media (max-width: 450px) {
      .stats-grid {
        gap: 8px;
      }

      .stat-card {
        padding: 17px 8px;
      }

      .stat-card h2 {
        font-size: 23px;
      }

      .stat-card p {
        font-size: 11px;
      }

      .category-grid {
        grid-template-columns: 1fr 1fr;
      }

      .category-count {
        font-size: 10px;
      }

      .category-status {
        font-size: 9px;
        padding: 4px 6px;
      }

      .contact-grid {
        grid-template-columns: 1fr;
      }

      .footer-grid {
        grid-template-columns: 1fr;
      }

      .footer-brand {
        grid-column: auto;
      }

      .whatsapp-float {
        width: 55px;
        height: 55px;
        right: 16px;
        bottom: 16px;
      }
    }
  </style>
</head>

<body>

  <!-- HEADER -->
  <header>
    <div class="container navbar">

      <a href="index.html" class="logo">
        <img
          src="https://assets.createlk.com/CreateLK%20Academy%20Logo.png"
          alt="CreateLK Academy Logo"
        >
        <span>CreateLK Academy</span>
      </a>

      <button
        class="menu-toggle"
        id="menuToggle"
        aria-label="Open navigation menu"
        aria-expanded="false"
      >☰</button>

      <nav class="nav-links" id="navLinks">
        <a href="index.html">Home</a>
        <a href="#categories">Categories</a>
        <a href="#how-it-works">How It Works</a>
        <a href="#premium">Premium</a>
        <a href="#contact">Contact</a>

        <a href="legal/privacy.html">Privacy Policy</a>
        <a href="legal/terms.html">Terms &amp; Conditions</a>
        <a href="legal/refund.html">Refund Policy</a>
        <a href="legal/payment.html">Payment Policy</a>

        <a href="#" class="nav-login google-signin-trigger" role="button">Sign In</a>
      </nav>

    </div>
  </header>

  <main>

    <!-- HERO -->
    <section class="hero" id="home">
      <div class="container hero-content">
        <div>
          <h1>
            Improve Your <span>English Grammar</span> With Confidence
          </h1>

          <p>
            Learn, practise and improve your English grammar through
            interactive multiple-choice questions. Build your knowledge
            one question at a time with CreateLK Academy.
          </p>

          <div class="hero-buttons">
            <a href="#categories" class="btn btn-primary">
              Start Practising
            </a>

            <a href="#" class="btn btn-outline google-signin-trigger" role="button">
              Sign In
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- STATISTICS -->
    <div class="container stats">
      <div class="stats-grid">
        <div class="stat-card">
          <h2>20</h2>
          <p>Grammar Categories</p>
        </div>

        <div class="stat-card">
          <h2>1,000</h2>
          <p>Practice Questions</p>
        </div>

        <div class="stat-card">
          <h2>24/7</h2>
          <p>Online Learning Access</p>
        </div>
      </div>
    </div>

    <!-- CATEGORIES -->
    <section class="categories-section" id="categories">
      <div class="container">
        <div class="section-heading">
          <h2>Explore Grammar Categories</h2>
          <p>
            Choose a category and test your English grammar knowledge
            with carefully organised multiple-choice questions.
          </p>
        </div>

        <div class="category-grid" id="categoryGrid">
          <div class="loading-message">
            Loading grammar categories...
          </div>
        </div>
      </div>
    </section>

    <!-- HOW IT WORKS -->
    <section class="how-section" id="how-it-works">
      <div class="container">
        <div class="section-heading">
          <h2>How CreateLK Academy Works</h2>
          <p>
            Follow these simple steps to improve your English grammar.
          </p>
        </div>

        <div class="how-grid">
          <div class="how-card">
            <div class="how-icon">👤</div>
            <h3>1. Sign In</h3>
            <p>
              Sign in using your Google account to access
              your learning experience.
            </p>
          </div>

          <div class="how-card">
            <div class="how-icon">📚</div>
            <h3>2. Choose a Category</h3>
            <p>
              Select a grammar topic and answer multiple-choice
              questions to practise.
            </p>
          </div>

          <div class="how-card">
            <div class="how-icon">🏆</div>
            <h3>3. Improve Your Skills</h3>
            <p>
              Check your answers, understand explanations and
              continue improving your grammar.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- PREMIUM -->
    <section class="premium-section" id="premium">
      <div class="container premium-content">
        <h2>Unlock All Grammar Categories</h2>

        <p>
          Get access to all 20 grammar categories and improve your
          English with the complete CreateLK Academy question collection.
        </p>

        <div class="price-card">
          <h3>Premium Membership</h3>
          <div class="price">LKR 999.00</div>
          <p>30 days of premium access</p>

          <ul class="price-features">
            <li>Access to all 20 grammar categories</li>
            <li>Access to premium MCQ questions</li>
            <li>Practise English grammar topics</li>
            <li>View answers and explanations</li>
            <li>30 days of membership access</li>
          </ul>

          <a href="premium.html" class="btn btn-primary">
            Get Premium Access
          </a>

          <p class="premium-note">
            One-time payment. No automatic renewal.
            Payments are processed through PayHere.
          </p>
        </div>
      </div>
    </section>

    <!-- CONTACT -->
    <section class="contact-section" id="contact">
      <div class="container">
        <div class="section-heading">
          <h2>Contact CreateLK Academy</h2>
          <p>
            Need assistance with your account, payments or practice?
            Contact our support team.
          </p>
        </div>

        <div class="contact-grid">
          <div class="contact-card">
            <h3>📧 Email Support</h3>
            <p>Send us your questions by email.</p>
            <a href="mailto:createlksupport@gmail.com">
              createlksupport@gmail.com
            </a>
          </div>

          <div class="contact-card">
            <h3>💬 WhatsApp Support</h3>
            <p>Chat with our support team.</p>
            <a
              href="https://wa.me/94771190395"
              target="_blank"
              rel="noopener noreferrer"
            >
              +94 77 119 0395
            </a>
          </div>
        </div>
      </div>
    </section>

  </main>

  <!-- FOOTER -->
  <footer>
    <div class="container">
      <div class="footer-grid">

        <div class="footer-brand">
          <h3>CreateLK Academy</h3>
          <p>
            Your online platform for learning and practising
            English grammar through interactive MCQs.
          </p>
        </div>

        <div class="footer-links">
          <h4>Quick Links</h4>
          <a href="index.html">Home</a>
          <a href="#categories">Grammar Categories</a>
          <a href="#" class="google-signin-trigger" role="button">Sign In</a>
          <a href="premium.html">Premium Membership</a>
        </div>

        <div class="footer-links">
          <h4>Legal Information</h4>
          <a href="legal/privacy.html">Privacy Policy</a>
          <a href="legal/terms.html">Terms &amp; Conditions</a>
          <a href="legal/refund.html">Refund Policy</a>
          <a href="legal/payment.html">Payment Policy</a>
          <a href="mailto:createlksupport@gmail.com">Contact Support</a>
        </div>

      </div>

      <div class="copyright">
        <p>
          &copy; <span id="currentYear"></span> CreateLK Academy.
          All Rights Reserved.
        </p>
      </div>
    </div>
  </footer>

  <!-- FLOATING WHATSAPP BUTTON -->
  <a
    href="https://wa.me/94771190395?text=Hello%20CreateLK%20Academy%2C%20I%20need%20support."
    class="whatsapp-float"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Contact CreateLK Academy on WhatsApp"
  >
    <span class="whatsapp-tooltip">Chat with us on WhatsApp</span>

    <svg viewBox="0 0 32 32" aria-hidden="true">
      <path
        fill="currentColor"
        d="M16.04 2.67A13.25 13.25 0 0 0 4.62 22.64L2.67 29.33l6.86-1.8a13.3 13.3 0 1 0 6.51-24.86Zm0 23.96c-1.98 0-3.92-.53-5.62-1.54l-.4-.24-4.07 1.07 1.09-3.97-.26-.41a10.65 10.65 0 1 1 9.26 5.09Zm5.85-7.98c-.32-.16-1.91-.94-2.2-1.05-.3-.11-.51-.16-.73.16-.21.32-.83 1.05-1.02 1.27-.19.21-.37.24-.69.08-.32-.16-1.36-.5-2.59-1.59-.96-.85-1.6-1.9-1.79-2.22-.19-.32-.02-.49.14-.65.14-.14.32-.37.48-.56.16-.19.21-.32.32-.53.1-.21.05-.4-.03-.56-.08-.16-.73-1.75-1-2.4-.26-.63-.53-.54-.73-.55h-.62c-.21 0-.56.08-.85.4-.3.32-1.11 1.08-1.11 2.65s1.14 3.08 1.3 3.29c.16.21 2.24 3.42 5.43 4.79.76.33 1.35.53 1.81.68.76.24 1.45.21 2 .13.61-.09 1.91-.78 2.18-1.53.27-.75.27-1.4.19-1.53-.08-.13-.29-.21-.61-.37Z"
      />
    </svg>
  </a>

  <!-- GOOGLE SIGN-IN MODAL -->
  <div
    class="google-modal"
    id="googleModal"
    aria-hidden="true"
  >
    <div
      class="google-modal-content"
      role="dialog"
      aria-modal="true"
      aria-labelledby="googleModalTitle"
    >
      <button
        class="google-modal-close"
        id="closeGoogleModal"
        type="button"
        aria-label="Close sign-in window"
      >&times;</button>

      <h2 id="googleModalTitle">Welcome to CreateLK Academy</h2>

      <p>Sign in with your Google account to continue.</p>

      <div id="googleButtonContainer"></div>

      <div
        class="google-loading"
        id="googleLoading"
        role="status"
        aria-live="polite"
      >
        <span class="google-spinner"></span>
        Loading Google Sign-In...
      </div>
    </div>
  </div>

  <script>
    // --------------------------------------------------
    // CONFIGURATION
    // --------------------------------------------------

    const API_BASE_URL = "https://eg-academy.createlk.workers.dev";

    const GOOGLE_CLIENT_ID =
      "582157960266-3r4k503a5a3oomo9nrau7l61aifavbqh.apps.googleusercontent.com";

    const AUTH_TOKEN_KEY = "createlk_academy_token";

    let googleInitialized = false;
    let googleButtonRendered = false;
    let googleLibraryReady = false;
    let loginInProgress = false;

    const googleModal = document.getElementById("googleModal");
    const googleButtonContainer =
      document.getElementById("googleButtonContainer");
    const googleLoading = document.getElementById("googleLoading");

    // --------------------------------------------------
    // MOBILE NAVIGATION
    // --------------------------------------------------

    const menuToggle = document.getElementById("menuToggle");
    const navLinks = document.getElementById("navLinks");

    menuToggle.addEventListener("click", () => {
      const isOpen = navLinks.classList.toggle("active");

      menuToggle.setAttribute("aria-expanded", String(isOpen));
      menuToggle.textContent = isOpen ? "✕" : "☰";
    });

    navLinks.querySelectorAll("a").forEach(link => {
      link.addEventListener("click", () => {
        navLinks.classList.remove("active");
        menuToggle.setAttribute("aria-expanded", "false");
        menuToggle.textContent = "☰";
      });
    });

    // --------------------------------------------------
    // CURRENT YEAR
    // --------------------------------------------------

    document.getElementById("currentYear").textContent =
      new Date().getFullYear();

    // --------------------------------------------------
    // AUTHENTICATION HELPERS
    // --------------------------------------------------

    function getAuthToken() {
      return localStorage.getItem(AUTH_TOKEN_KEY) || "";
    }

    function updateSignInLabels(signedIn) {
      document.querySelectorAll(".google-signin-trigger").forEach(link => {
        link.textContent = signedIn ? "Signed In" : "Sign In";

        link.setAttribute(
          "aria-label",
          signedIn ? "Signed in with Google" : "Sign in with Google"
        );
      });
    }

    function setGoogleMessage(message, type = "") {
      googleLoading.className = "google-loading";

      if (type) {
        googleLoading.classList.add(type);
      }

      googleLoading.textContent = message;
    }

    function setGoogleLoading(message) {
      googleLoading.className = "google-loading";

      googleLoading.innerHTML = `
        <span class="google-spinner"></span>
        ${escapeHTML(message)}
      `;
    }

    // --------------------------------------------------
    // OPEN AND CLOSE GOOGLE MODAL
    // --------------------------------------------------

    function openGoogleModal(event) {
      if (event) event.preventDefault();

      if (getAuthToken()) {
        restoreSession();
        return;
      }

      googleModal.classList.add("active");
      googleModal.setAttribute("aria-hidden", "false");

      document.body.classList.add("modal-open");

      setGoogleLoading("Loading Google Sign-In...");

      initializeGoogleSignIn();
    }

    function closeGoogleModal() {
      if (loginInProgress) return;

      googleModal.classList.remove("active");
      googleModal.setAttribute("aria-hidden", "true");

      document.body.classList.remove("modal-open");
    }

    document
      .getElementById("closeGoogleModal")
      .addEventListener("click", closeGoogleModal);

    googleModal.addEventListener("click", event => {
      if (event.target === googleModal) {
        closeGoogleModal();
      }
    });

    document.addEventListener("keydown", event => {
      if (
        event.key === "Escape" &&
        googleModal.classList.contains("active")
      ) {
        closeGoogleModal();
      }
    });

    document.querySelectorAll(".google-signin-trigger").forEach(link => {
      link.addEventListener("click", openGoogleModal);
    });

    // --------------------------------------------------
    // GOOGLE LIBRARY LOADED
    // --------------------------------------------------

    function onGoogleLibraryLoaded() {
      googleLibraryReady = true;

      if (googleModal.classList.contains("active")) {
        initializeGoogleSignIn();
      }
    }

    // --------------------------------------------------
    // INITIALIZE GOOGLE SIGN-IN BUTTON
    // --------------------------------------------------

    function initializeGoogleSignIn() {
      if (!googleLibraryReady) {
        if (
          window.google &&
          window.google.accounts &&
          window.google.accounts.id
        ) {
          googleLibraryReady = true;
        } else {
          setGoogleLoading("Waiting for Google Sign-In to load...");
          return;
        }
      }

      if (
        !window.google ||
        !google.accounts ||
        !google.accounts.id
      ) {
        setGoogleMessage(
          "Google Sign-In could not load. Please refresh and try again.",
          "google-error"
        );
        return;
      }

      if (googleInitialized && googleButtonRendered) {
        setGoogleMessage("Choose your Google account to continue.");
        return;
      }

      try {
        if (!googleInitialized) {
          google.accounts.id.initialize({
            client_id: GOOGLE_CLIENT_ID,
            callback: handleGoogleCredential,
            auto_select: false,
            cancel_on_tap_outside: true
          });

          googleInitialized = true;
        }

        if (!googleButtonRendered) {
          googleButtonContainer.innerHTML = "";

          google.accounts.id.renderButton(
            googleButtonContainer,
            {
              type: "standard",
              theme: "outline",
              size: "large",
              text: "signin_with",
              shape: "rectangular",
              width: 280,
              logo_alignment: "left"
            }
          );

          googleButtonRendered = true;
        }

        setGoogleMessage(
          "Choose your Google account to continue."
        );

      } catch (error) {
        console.error("Google initialization error:", error);

        setGoogleMessage(
          "Unable to load the Google button. Please refresh and try again.",
          "google-error"
        );

        googleButtonRendered = false;
      }
    }

    // --------------------------------------------------
    // GOOGLE LOGIN CALLBACK
    // --------------------------------------------------

    async function handleGoogleCredential(googleResponse) {
      if (loginInProgress) return;

      if (!googleResponse || !googleResponse.credential) {
        setGoogleMessage(
          "Google did not return a valid login credential. Please try again.",
          "google-error"
        );
        return;
      }

      loginInProgress = true;

      setGoogleLoading("Signing you in. Please wait...");

      try {
        const response = await fetch(
          `${API_BASE_URL}/api/auth/google`,
          {
            method: "POST",
            headers: {
              "Content-Type": "application/json"
            },
            body: JSON.stringify({
              credential: googleResponse.credential
            })
          }
        );

        let result;

        try {
          result = await response.json();
        } catch {
          throw new Error(
            "The server returned an invalid response. Please try again."
          );
        }

        if (
          !response.ok ||
          !result.success ||
          !result.token
        ) {
          throw new Error(
            result.error || "Google sign-in failed."
          );
        }

        // Save the authentication token.
        localStorage.setItem(
          AUTH_TOKEN_KEY,
          result.token
        );

        updateSignInLabels(true);

        setGoogleMessage(
          "Sign-in successful! Loading your account...",
          "google-success"
        );

        // Close modal.
        googleModal.classList.remove("active");
        googleModal.setAttribute("aria-hidden", "true");
        document.body.classList.remove("modal-open");

        // Load categories.
        await loadCategories();

        const studentName =
          result.user?.name || "Student";

        alert(
          `Welcome to CreateLK Academy, ${studentName}!`
        );

      } catch (error) {
        console.error("Google login error:", error);

        setGoogleMessage(
          error.message || "Unable to sign in. Please try again.",
          "google-error"
        );

      } finally {
        loginInProgress = false;
      }
    }

    // --------------------------------------------------
    // ESCAPE HTML
    // --------------------------------------------------

    function escapeHTML(value) {
      return String(value).replace(/[&<>"']/g, character => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#039;"
      })[character]);
    }

    // --------------------------------------------------
    // LOAD CATEGORIES
    // --------------------------------------------------

    async function loadCategories() {
      const categoryGrid =
        document.getElementById("categoryGrid");

      const token = getAuthToken();

      if (!token) {
        categoryGrid.innerHTML = `
          <div class="loading-message">
            Please sign in with Google to view and access the grammar categories.
          </div>`;
        return;
      }

      categoryGrid.innerHTML = `
        <div class="loading-message">
          Loading grammar categories...
        </div>`;

      try {
        const response = await fetch(
          `${API_BASE_URL}/api/categories`,
          {
            headers: {
              "Authorization": `Bearer ${token}`
            }
          }
        );

        if (response.status === 401) {
          localStorage.removeItem(AUTH_TOKEN_KEY);
          updateSignInLabels(false);

          throw new Error(
            "Your session has expired. Please sign in again."
          );
        }

        if (!response.ok) {
          throw new Error(
            "Unable to load categories."
          );
        }

        const result = await response.json();

        const categories = Array.isArray(result)
          ? result
          : result.categories;

        if (
          !Array.isArray(categories) ||
          categories.length === 0
        ) {
          throw new Error(
            "No grammar categories are available."
          );
        }

        categoryGrid.innerHTML = "";

        categories.forEach((category, index) => {
          const isFree =
            category.is_free === 1 ||
            category.is_free === true ||
            category.is_free === "1";

          const categoryId = Number(category.id);

          const title = escapeHTML(
            category.title || "Grammar Category"
          );

          const description = escapeHTML(
            category.description ||
            "Practise English grammar."
          );

          const count = Number(category.question_count);

          const questionText =
            Number.isFinite(count) && count > 0
              ? `${count} Questions`
              : "Practice MCQs";

          const card = document.createElement("article");

          card.className = "category-card";

          card.innerHTML = `
            <div class="category-number">${index + 1}</div>

            <h3>${title}</h3>

            <p>${description}</p>

            <div class="category-footer">
              <span class="category-count">
                ${questionText}
              </span>

              <span class="category-status ${isFree ? "" : "premium-status"}">
                ${isFree ? "FREE" : "PREMIUM"}
              </span>
            </div>
          `;

          card.addEventListener("click", () => {
            if (
              !Number.isInteger(categoryId) ||
              categoryId < 1
            ) {
              return;
            }

            window.location.href = isFree
              ? `practice.html?category_id=${encodeURIComponent(categoryId)}`
              : `premium.html?category_id=${encodeURIComponent(categoryId)}`;
          });

          categoryGrid.appendChild(card);
        });

      } catch (error) {
        console.error(
          "Category loading error:",
          error
        );

        categoryGrid.innerHTML = `
          <div class="error-message">
            <strong>
              ${escapeHTML(
                error.message ||
                "Unable to load grammar categories."
              )}
            </strong>

            <p>
              Please sign in or check your internet connection,
              then try again.
            </p>

            <button
              class="retry-btn"
              onclick="loadCategories()"
            >
              Try Again
            </button>
          </div>
        `;
      }
    }

    // --------------------------------------------------
    // RESTORE LOGIN SESSION
    // --------------------------------------------------

    async function restoreSession() {
      const token = getAuthToken();

      if (!token) {
        updateSignInLabels(false);
        await loadCategories();
        return;
      }

      try {
        const response = await fetch(
          `${API_BASE_URL}/api/me`,
          {
            headers: {
              "Authorization": `Bearer ${token}`
            }
          }
        );

        if (!response.ok) {
          throw new Error("Session expired");
        }

        updateSignInLabels(true);

        await loadCategories();

      } catch (error) {
        console.error(
          "Session restoration error:",
          error
        );

        localStorage.removeItem(AUTH_TOKEN_KEY);

        updateSignInLabels(false);

        await loadCategories();
      }
    }

    // --------------------------------------------------
    // STARTUP
    // --------------------------------------------------

    updateSignInLabels(Boolean(getAuthToken()));

    restoreSession();

    // Handle cases where Google loaded before the onload
    // callback was registered.
    if (
      window.google &&
      window.google.accounts &&
      window.google.accounts.id
    ) {
      onGoogleLibraryLoaded();
    }
  </script>

</body>
</html>
