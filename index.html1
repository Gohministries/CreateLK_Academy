<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#102a56">
<title>CreateLK Shop | Find Products in Sri Lanka</title>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial,sans-serif;background:#f5f6f8;color:#222}
button,input,textarea{font:inherit}button{cursor:pointer}
.header{background:#102a56;color:#fff;position:sticky;top:0;z-index:50;box-shadow:0 2px 8px #0002}
.header-inner,.container{max-width:1200px;margin:auto}
.header-inner{padding:10px 12px}
.topbar{display:flex;align-items:center;justify-content:space-between;gap:10px}
.brand{display:flex;align-items:center;gap:8px;color:#fff;text-decoration:none;font-size:18px;font-weight:700}
.logo{width:42px;height:42px;object-fit:contain;background:#fff;border-radius:6px}
.cart-btn{border:0;background:#fff;color:#102a56;border-radius:6px;padding:9px 13px;font-weight:700}
.search{width:100%;margin-top:10px;padding:11px 13px;border:0;border-radius:6px;outline:none}
.container{padding:15px 12px}
.hero{background:linear-gradient(135deg,#102a56,#173c78);color:#fff;border-radius:10px;padding:24px 18px;margin-bottom:15px}
.hero h1{margin:0 0 7px;font-size:27px}.hero p{margin:0;opacity:.9}
.categories{display:flex;gap:8px;overflow-x:auto;padding:2px 0 14px;scrollbar-width:none}
.categories::-webkit-scrollbar{display:none}
.category{flex:0 0 auto;border:1px solid #ddd;background:#fff;color:#333;border-radius:20px;padding:8px 13px;white-space:nowrap}
.category.active{background:#102a56;color:#fff;border-color:#102a56}
.status{display:none;margin:12px 0;padding:12px;border-radius:7px;font-weight:600}
.status.success{display:block;background:#e8f7ed;color:#176b32}
.status.error{display:block;background:#fdeaea;color:#a32121}
.products{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.product{background:#fff;border-radius:9px;overflow:hidden;box-shadow:0 1px 5px #0001;display:flex;flex-direction:column}
.gallery{position:relative;aspect-ratio:1;background:#fff;overflow:hidden;touch-action:pan-y}
.gallery img{width:100%;height:100%;object-fit:contain;display:block}
.gbtn{position:absolute;top:50%;transform:translateY(-50%);width:30px;height:30px;border:0;border-radius:50%;background:#102a56cc;color:#fff;font-size:22px;padding:0;z-index:2}
.gprev{left:7px}.gnext{right:7px}
.gcount{position:absolute;bottom:7px;left:50%;transform:translateX(-50%);background:#0009;color:#fff;font-size:11px;padding:4px 8px;border-radius:12px}
.nopic{height:100%;display:flex;align-items:center;justify-content:center;color:#999}
.product-body{padding:11px;display:flex;flex-direction:column;flex:1}
.product-name{font-size:15px;font-weight:700;line-height:1.3;margin-bottom:7px}
.price{font-size:18px;font-weight:700;color:#102a56}
.old-price{color:#888;text-decoration:line-through;font-size:13px;margin-left:5px}
.stock{margin-top:5px;font-size:12px}.in-stock{color:#17813a}.out-stock{color:#b32222}
.add-btn{margin-top:auto;padding:10px;border:0;border-radius:6px;background:#102a56;color:#fff;font-weight:700}
.add-btn:disabled{background:#aaa;cursor:not-allowed}
.empty{text-align:center;padding:35px 10px;color:#666;grid-column:1/-1}
.cart-overlay{position:fixed;inset:0;background:#0006;z-index:100;opacity:0;visibility:hidden;transition:.25s}
.cart-overlay.show{opacity:1;visibility:visible}
.cart-drawer{position:fixed;top:0;right:0;width:min(440px,100%);height:100%;background:#fff;z-index:101;transform:translateX(100%);transition:.3s;display:flex;flex-direction:column;box-shadow:-5px 0 20px #0003}
.cart-drawer.show{transform:translateX(0)}
.cart-header{background:#102a56;color:#fff;padding:16px;display:flex;align-items:center;justify-content:space-between}
.cart-title{font-size:20px;font-weight:700}
.close-cart{border:0;background:#ffffff22;color:#fff;width:36px;height:36px;border-radius:50%;font-size:22px}
.cart-content{flex:1;overflow-y:auto;padding:16px}
.cart-item{display:flex;gap:10px;align-items:center;padding:10px 0;border-bottom:1px solid #eee}
.cart-item img{width:65px;height:65px;object-fit:contain;border:1px solid #eee;border-radius:6px}
.cart-info{flex:1;min-width:0}.cart-name{font-weight:700;font-size:14px}.cart-price{margin-top:4px;font-size:13px;color:#555}
.qty{display:flex;align-items:center;gap:6px}.qty button{width:30px;height:30px;border:1px solid #ddd;background:#fff;border-radius:5px}
.remove{border:0;background:none;color:#c22;font-size:12px;padding:5px 0}
.summary{margin-top:15px;border-top:1px solid #ddd;padding-top:12px}
.row{display:flex;justify-content:space-between;margin:7px 0}
.total{font-size:20px;font-weight:700;color:#102a56}
.form{margin-top:18px;display:grid;gap:10px}
.form input,.form textarea{width:100%;padding:11px;border:1px solid #ccc;border-radius:6px;outline:none}
.form textarea{min-height:80px;resize:vertical}
.checkout-btn{border:0;background:#102a56;color:#fff;padding:13px;border-radius:7px;font-weight:700;width:100%}
.checkout-btn:disabled{opacity:.6}
.cart-empty{text-align:center;padding:35px 10px;color:#777}

.whatsapp-float{
position:fixed;right:16px;bottom:16px;z-index:200;
width:54px;height:54px;
display:flex;align-items:center;justify-content:center;
background:#25D366;border-radius:50%;
box-shadow:0 4px 14px #0004;
transition:.2s;
}
.whatsapp-float:hover{transform:scale(1.08)}
.whatsapp-icon{
width:48px;height:48px;
display:block;
position:relative;
left:0;top:0;
}

.footer{margin-top:30px;background:#102a56;color:#fff;padding:25px 15px;text-align:center}
.footer a{color:#fff;text-decoration:none;margin:0 7px;font-size:13px}
.footer p{font-size:12px;opacity:.8}

@media(max-width:900px){
.products{grid-template-columns:repeat(3,1fr)}
}
@media(max-width:600px){
.products{grid-template-columns:repeat(2,1fr);gap:9px}
.hero h1{font-size:23px}
.product-body{padding:9px}
.product-name{font-size:14px}
.price{font-size:16px}
.cart-drawer{
top:auto;bottom:0;width:100%;height:min(88vh,700px);
transform:translateY(100%);border-radius:16px 16px 0 0
}
.cart-drawer.show{transform:translateY(0)}
.whatsapp-float{
right:12px;bottom:12px;
width:50px;height:50px
}
.whatsapp-icon{width:44px;height:44px}
}
@media(max-width:380px){
.products{grid-template-columns:1fr}
}
</style>
</head>
<body>

<header class="header">
<div class="header-inner">
<div class="topbar">
<a href="/shop/" class="brand">
<img class="logo" src="https://media.gohministries.org/file_00000000689081f5b99939c76193c97d.png" alt="CreateLK Shop">
<span>CreateLK <span style="color:#f5b041">Shop</span></span>
</a>
<button class="cart-btn" onclick="toggleCart()">Cart (<span id="cartCount">0</span>)</button>
</div>
<input id="search" class="search" type="search" placeholder="Search products..." autocomplete="off">
</div>
</header>

<main class="container">
<section class="hero">
<h1>Shop Online in Sri Lanka 🇱🇰</h1>
<p>Quality products with Cash on Delivery.</p>
</section>
<div id="categories" class="categories"></div>
<div id="status" class="status"></div>
<section id="products" class="products">
<div class="empty">Loading products...</div>
</section>
</main>

<div id="cartOverlay" class="cart-overlay" onclick="closeCart()"></div>

<aside id="cartDrawer" class="cart-drawer">
<div class="cart-header">
<div class="cart-title">Your Cart</div>
<button class="close-cart" onclick="closeCart()">×</button>
</div>
<div class="cart-content">
<div id="cartItems"></div>
<div class="summary">
<div class="row"><span>Subtotal</span><strong id="subtotal">LKR 0</strong></div>
<div class="row"><span>Delivery</span><strong>LKR 400</strong></div>
<div class="row total"><span>Total</span><strong id="total">LKR 400</strong></div>
</div>
<div class="form">
<input id="customerName" placeholder="Full Name *" autocomplete="name">
<input id="district" placeholder="District">
<input id="city" placeholder="City / Town *" autocomplete="address-level2">
<textarea id="address" placeholder="Delivery Address *"></textarea>
<input id="mobile1" type="tel" placeholder="Mobile 1 *" autocomplete="tel">
<input id="mobile2" type="tel" placeholder="Mobile 2 (Optional)" autocomplete="tel">
<button id="checkoutBtn" class="checkout-btn" onclick="placeOrder()">Place COD Order</button>
</div>
</div>
</aside>

<a class="whatsapp-float"
href="https://wa.me/94771190395?text=Hello%20CreateLK%20Shop%2C%20I%20would%20like%20to%20get%20more%20information%20about%20a%20product."
target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">
<svg class="whatsapp-icon" viewBox="0 0 32 32" aria-hidden="true">
<path fill="#fff" d="M19.11 17.22c-.27-.14-1.58-.78-1.83-.87-.25-.09-.43-.14-.61.14-.18.27-.7.87-.86 1.05-.16.18-.32.2-.59.07-.27-.14-1.12-.41-2.13-1.31-.79-.7-1.32-1.56-1.48-1.83-.16-.27-.02-.42.12-.56.12-.12.27-.32.41-.48.14-.16.18-.27.27-.45.09-.18.05-.34-.02-.48-.07-.14-.61-1.46-.84-2-.22-.52-.45-.45-.61-.46h-.52c-.18 0-.48.07-.73.34-.25.27-.95.93-.95 2.27s.98 2.63 1.11 2.81c.14.18 1.93 2.95 4.68 4.14.65.28 1.16.45 1.56.58.65.21 1.24.18 1.7.11.52-.08 1.58-.65 1.8-1.27.23-.62.23-1.15.16-1.27-.07-.11-.25-.18-.52-.32z"/>
<path fill="#fff" d="M16.01 3.2c-7.07 0-12.8 5.73-12.8 12.8 0 2.26.59 4.39 1.63 6.24L3.2 28.8l6.72-1.76a12.75 12.75 0 0 0 6.09 1.56h.01c7.07 0 12.8-5.73 12.8-12.8S23.08 3.2 16.01 3.2zm0 23.08h-.01a10.27 10.27 0 0 1-5.24-1.43l-.38-.23-3.99 1.04 1.07-3.89-.25-.4a10.27 10.27 0 1 1 8.8 4.91z"/>
</svg>
</a>

<footer class="footer">
<div>
<a href="/shop/terms.html">Terms</a>
<a href="/shop/privacy.html">Privacy</a>
<a href="/shop/refund.html">Refund & Returns</a>
</div>
<p>© 2026 CreateLK Shop. All rights reserved.</p>
</footer>

<script>
const API="https://shop-api.createlk.workers.dev",DELIVERY=400;
let cart=[],currentCategory="",searchTimer;
const $=id=>document.getElementById(id),money=n=>Number(n||0).toLocaleString("en-LK");

function escapeHtml(v){
return String(v??"").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&#039;")
}

function showMessage(t,type="info"){
$("status").textContent=t;
$("status").className="status "+type
}

function clearMessage(){$("status").className="status"}

async function api(url,options={}){
let r;
try{
r=await fetch(url,{...options,headers:{"Accept":"application/json",...(options.headers||{})}})
}catch(e){
throw Error("Network error. Please check your internet connection.")
}
let d={};
try{d=await r.json()}catch(e){}
if(!r.ok)throw Error(d.error||d.message||`Server error (${r.status})`);
return d
}

function loadCart(){
try{
cart=JSON.parse(localStorage.getItem("createlk_cart")||"[]");
if(!Array.isArray(cart))cart=[]
}catch(e){cart=[]}
}

function saveCart(){
try{localStorage.setItem("createlk_cart",JSON.stringify(cart))}catch(e){}
}

function updateCartCount(){
$("cartCount").textContent=cart.reduce((a,x)=>a+Number(x.qty||0),0)
}

function toggleCart(){
let d=$("cartDrawer");
if(d.classList.contains("show"))closeCart();
else{
renderCart();
d.classList.add("show");
$("cartOverlay").classList.add("show");
document.body.style.overflow="hidden"
}
}

function closeCart(){
$("cartDrawer").classList.remove("show");
$("cartOverlay").classList.remove("show");
document.body.style.overflow=""
}

document.addEventListener("keydown",e=>{
if(e.key==="Escape")closeCart()
});

async function loadCategories(){
let box=$("categories");
box.innerHTML="";
let all=document.createElement("button");
all.className="category active";
all.textContent="All";
all.onclick=()=>{
currentCategory="";
setActive(all);
loadProducts()
};
box.appendChild(all);

try{
let data=await api(API+"/api/categories");
data.filter(c=>{
let n=String(c.name||"").trim().toLowerCase();
return n!=="all"&&n!=="all categories"
}).forEach(c=>{
let b=document.createElement("button");
b.className="category";
b.textContent=c.name;
b.onclick=()=>{
currentCategory=String(c.id);
setActive(b);
loadProducts()
};
box.appendChild(b)
})
}catch(e){console.error("Categories:",e)}
}

function setActive(btn){
document.querySelectorAll(".category").forEach(x=>x.classList.remove("active"));
btn.classList.add("active")
}

function getImages(p){
let a=Array.isArray(p.images)?p.images.map(x=>typeof x==="string"?x:(x?.image_key||x?.key||x?.url||"")).filter(Boolean):[];
if(!a.length&&p.image_key)a=[p.image_key];
return[...new Set(a)]
}

async function loadProducts(){
let box=$("products");
box.innerHTML='<div class="empty">Loading products...</div>';
let q=$("search").value.trim(),params=new URLSearchParams();
if(currentCategory)params.set("category",currentCategory);
if(q)params.set("search",q);

try{
let data=await api(API+"/api/products?"+params);
renderProducts(Array.isArray(data)?data:[])
}catch(e){
box.innerHTML=`<div class="empty">${escapeHtml(e.message)}<br><br><button onclick="loadProducts()" style="padding:9px 14px;border:0;border-radius:6px;background:#102a56;color:#fff">Try Again</button></div>`
}
}

function galleryHTML(images,name){
if(!images.length)return'<div class="nopic">No Image</div>';
return`<img src="${API}/images/${encodeURIComponent(images[0])}" alt="${escapeHtml(name)}" loading="lazy" draggable="false">${images.length>1?'<button class="gbtn gprev" type="button">‹</button><button class="gbtn gnext" type="button">›</button><div class="gcount">1 / '+images.length+"</div>":""}`
}

function renderProducts(products){
let box=$("products");

if(!products.length){
let q=$("search").value.trim();
box.innerHTML=`<div class="empty">${q?`No products found for "${escapeHtml(q)}".`:"No products available."}</div>`;
return
}

box.innerHTML="";

products.forEach(p=>{
let price=Number(p.price||0);
let sale=p.sale_price!==null&&Number(p.sale_price)>0&&Number(p.sale_price)<price?Number(p.sale_price):null;
let finalPrice=sale??price;
let stock=Number(p.stock||0);
let images=getImages(p);
let card=document.createElement("div");
card.className="product";

let gallery=document.createElement("div");
gallery.className="gallery";
gallery.innerHTML=galleryHTML(images,p.name);
card.appendChild(gallery);

let body=document.createElement("div");
body.className="product-body";
body.innerHTML=`<div class="product-name">${escapeHtml(p.name)}</div><div class="price">LKR ${money(finalPrice)}${sale!==null?`<span class="old-price">LKR ${money(price)}</span>`:""}</div><div class="stock ${stock?"in-stock":"out-stock"}">${stock?stock+" available":"Out of stock"}</div><button class="add-btn" ${stock?"":"disabled"}>${stock?"Add to Cart":"Out of Stock"}</button>`;

body.querySelector(".add-btn").onclick=()=>stock&&addToCart(Number(p.id));
card.appendChild(body);
box.appendChild(card);

if(images.length>1){
let index=0;
let img=gallery.querySelector("img");
let count=gallery.querySelector(".gcount");

function changeImage(n){
index=(index+n+images.length)%images.length;
img.src=API+"/images/"+encodeURIComponent(images[index]);
count.textContent=`${index+1} / ${images.length}`
}

gallery.querySelector(".gprev").onclick=e=>{
e.stopPropagation();
changeImage(-1)
};

gallery.querySelector(".gnext").onclick=e=>{
e.stopPropagation();
changeImage(1)
};

let startX=0;

gallery.addEventListener("touchstart",e=>{
startX=e.touches[0].clientX
},{passive:true});

gallery.addEventListener("touchend",e=>{
let dx=e.changedTouches[0].clientX-startX;
if(Math.abs(dx)>45)changeImage(dx<0?1:-1)
},{passive:true})
}
})
}

async function addToCart(id){
try{
let p=await api(API+"/api/products/"+id);
if(!p?.id)throw Error("Product not found.");

let stock=Number(p.stock||0);
if(stock<1)return showMessage("This product is out of stock.","error");

let existing=cart.find(x=>Number(x.id)===Number(p.id));

if(existing){
if(Number(existing.qty)+1>stock)return showMessage(`Only ${stock} item(s) are available.`,"error");
existing.qty++
}else{
let images=getImages(p);
let price=p.sale_price!==null&&Number(p.sale_price)>0&&Number(p.sale_price)<Number(p.price)?Number(p.sale_price):Number(p.price);
cart.push({
id:Number(p.id),
name:p.name,
price,
image:images[0]||p.image_key||"",
qty:1
})
}

saveCart();
updateCartCount();
renderCart();
showMessage("Product added to cart.","success")
}catch(e){
showMessage(e.message||"Unable to add product.","error")
}
}

function renderCart(){
let box=$("cartItems");

if(!cart.length){
box.innerHTML='<div class="cart-empty">Your cart is empty.</div>';
$("subtotal").textContent="LKR 0";
$("total").textContent="LKR 400";
updateCartCount();
return
}

let subtotal=0;
box.innerHTML="";

cart.forEach((item,i)=>{
let qty=Number(item.qty||0);
let price=Number(item.price||0);
subtotal+=price*qty;

let row=document.createElement("div");
row.className="cart-item";

row.innerHTML=`${item.image?`<img src="${API}/images/${encodeURIComponent(item.image)}" alt="${escapeHtml(item.name)}" onerror="this.style.display='none'">`:""}<div class="cart-info"><div class="cart-name">${escapeHtml(item.name)}</div><div class="cart-price">LKR ${money(price)} × ${qty}</div><button class="remove" onclick="removeCart(${i})">Remove</button></div><div class="qty"><button onclick="changeQty(${i},-1)">−</button><strong>${qty}</strong><button onclick="changeQty(${i},1)">+</button></div>`;

box.appendChild(row)
});

$("subtotal").textContent="LKR "+money(subtotal);
$("total").textContent="LKR "+money(subtotal+DELIVERY);
updateCartCount()
}

function changeQty(i,n){
if(!cart[i])return;
cart[i].qty=Number(cart[i].qty)+n;
if(cart[i].qty<1)cart.splice(i,1);
saveCart();
renderCart()
}

function removeCart(i){
if(!cart[i])return;
cart.splice(i,1);
saveCart();
renderCart()
}

async function placeOrder(){
clearMessage();

if(!cart.length)return showMessage("Your cart is empty.","error");

let customer={
name:$("customerName").value.trim(),
district:$("district").value.trim(),
city:$("city").value.trim(),
address:$("address").value.trim(),
mobile1:$("mobile1").value.trim(),
mobile2:$("mobile2").value.trim()
};

if(!customer.name)return showMessage("Please enter your full name.","error");
if(!customer.city)return showMessage("Please enter your city or town.","error");
if(!customer.address)return showMessage("Please enter your delivery address.","error");
if(!customer.mobile1)return showMessage("Please enter your mobile number 1.","error");

let btn=$("checkoutBtn");
btn.disabled=true;
btn.textContent="Processing...";

try{
let data=await api(API+"/api/orders",{
method:"POST",
headers:{"Content-Type":"application/json"},
body:JSON.stringify({
customer:{
name:customer.name,
district:customer.district,
city:customer.city,
address:customer.address,
mobile_1:customer.mobile1,
mobile_2:customer.mobile2
},
items:cart.map(x=>({
product_id:Number(x.id),
quantity:Number(x.qty)
}))
})
});

if(!data.success)throw Error(data.error||"Order was not completed.");

let id=data.order_id;
cart=[];
saveCart();
renderCart();

document.querySelectorAll(".form input,.form textarea").forEach(x=>x.value="");

showMessage(
id?`Order placed successfully! Order #${id}. Thank you for shopping with CreateLK Shop.`:"Order placed successfully. Thank you!",
"success"
);

closeCart()
}catch(e){
showMessage(e.message||"Unable to place your order. Please try again.","error")
}finally{
btn.disabled=false;
btn.textContent="Place COD Order"
}
}

$("search").addEventListener("input",()=>{
clearTimeout(searchTimer);
searchTimer=setTimeout(loadProducts,400)
});

loadCart();
updateCartCount();
renderCart();
loadCategories();
loadProducts();
</script>
</body>
</html>