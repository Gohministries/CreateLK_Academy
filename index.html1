<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="description" content="CreateLK Academy - Learn English every day with our 365-day English learning journey.">
<meta name="theme-color" content="#155eef">

<link rel="manifest" href="manifest.json">
<link rel="apple-touch-icon" href="icon-192.png">

<title>CreateLK Academy | Learn English Every Day</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}

:root{
--blue:#155eef;
--purple:#7c3aed;
--pink:#ec4899;
--orange:#f97316;
--green:#10b981;
--cyan:#06b6d4;
--yellow:#f59e0b;
--dark:#172033;
--muted:#667085;
--bg:#f5f7ff;
--white:#fff;
--line:#e5e7eb
}

html{scroll-behavior:smooth}

body{
font-family:Arial,Helvetica,sans-serif;
background:var(--bg);
color:var(--dark);
line-height:1.6
}

a{text-decoration:none;color:inherit}

.container{
max-width:1100px;
margin:auto;
padding:0 18px
}

/* HEADER */

header{
position:sticky;
top:0;
z-index:100;
background:#ffffffee;
backdrop-filter:blur(12px);
border-bottom:1px solid #e5e7eb
}

.nav{
height:68px;
display:flex;
align-items:center;
justify-content:space-between
}

.logo{
font-size:21px;
font-weight:900;
color:var(--blue)
}

.logo span{color:var(--purple)}

.navlinks{
display:flex;
align-items:center;
gap:20px
}

.navlinks a{
font-size:14px;
font-weight:700
}

/* BUTTONS */

.btn{
display:inline-block;
border:0;
cursor:pointer;
padding:12px 21px;
border-radius:12px;
background:linear-gradient(135deg,var(--blue),var(--purple));
color:#fff;
font-weight:800;
box-shadow:0 8px 20px #155eef25;
transition:.2s;
font-family:inherit
}

.btn:hover{
transform:translateY(-2px);
box-shadow:0 12px 25px #155eef35
}

.btn.secondary{
background:#eef4ff;
color:var(--blue);
box-shadow:none
}

.install-btn{
display:none
}

.install-btn.show{
display:inline-block
}

/* HERO */

.hero{
position:relative;
overflow:hidden;
padding:80px 18px 65px;
text-align:center;
background:
radial-gradient(circle at 10% 20%,#c7d7ff 0,transparent 25%),
radial-gradient(circle at 90% 20%,#fbcfe8 0,transparent 25%),
radial-gradient(circle at 50% 100%,#cffafe 0,transparent 30%),
#fff
}

.hero h1{
max-width:800px;
margin:auto;
font-size:50px;
line-height:1.08;
letter-spacing:-2px
}

.hero h1 span{
background:linear-gradient(90deg,var(--blue),var(--purple),var(--pink));
-webkit-background-clip:text;
color:transparent
}

.hero p{
max-width:680px;
margin:20px auto;
color:var(--muted);
font-size:17px
}

.badge{
display:inline-block;
padding:8px 15px;
border-radius:30px;
background:#fff;
color:var(--purple);
border:1px solid #ddd6fe;
font-size:13px;
font-weight:800;
margin-bottom:18px;
box-shadow:0 5px 20px #7c3aed15
}

.actions{
display:flex;
justify-content:center;
gap:12px;
flex-wrap:wrap;
margin-top:26px
}

/* STATS */

.stats{
display:grid;
grid-template-columns:repeat(4,1fr);
gap:15px;
max-width:900px;
margin:40px auto 0
}

.stat{
padding:23px 10px;
border-radius:18px;
background:#fff;
box-shadow:0 10px 30px #1018280c;
border:1px solid #fff
}

.stat:nth-child(1){border-top:5px solid var(--blue)}
.stat:nth-child(2){border-top:5px solid var(--purple)}
.stat:nth-child(3){border-top:5px solid var(--orange)}
.stat:nth-child(4){border-top:5px solid var(--green)}

.stat strong{
display:block;
font-size:28px
}

.stat small{color:var(--muted)}

/* SECTIONS */

section{padding:70px 0}

.title{
text-align:center;
margin-bottom:38px
}

.title h2{
font-size:31px;
margin-bottom:8px
}

.title p{color:var(--muted)}

/* FEATURE CARDS */

.grid{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:20px
}

.card{
position:relative;
overflow:hidden;
min-height:190px;
padding:28px;
border-radius:22px;
color:#172033;
background:#fff;
border:1px solid #fff;
box-shadow:0 12px 35px #1018280d;
transition:.25s
}

.card:hover{
transform:translateY(-6px);
box-shadow:0 18px 40px #10182818
}

.card:after{
content:"";
position:absolute;
width:100px;
height:100px;
right:-40px;
bottom:-40px;
border-radius:50%;
opacity:.15
}

.card:nth-child(1){
background:linear-gradient(145deg,#eef4ff,#fff)
}

.card:nth-child(1):after{background:var(--blue)}

.card:nth-child(2){
background:linear-gradient(145deg,#f5f0ff,#fff)
}

.card:nth-child(2):after{background:var(--purple)}

.card:nth-child(3){
background:linear-gradient(145deg,#fff0f7,#fff)
}

.card:nth-child(3):after{background:var(--pink)}

.card:nth-child(4){
background:linear-gradient(145deg,#fff7ed,#fff)
}

.card:nth-child(4):after{background:var(--orange)}

.card:nth-child(5){
background:linear-gradient(145deg,#ecfeff,#fff)
}

.card:nth-child(5):after{background:var(--cyan)}

.card:nth-child(6){
background:linear-gradient(145deg,#ecfdf5,#fff)
}

.card:nth-child(6):after{background:var(--green)}

.icon{
width:55px;
height:55px;
display:flex;
align-items:center;
justify-content:center;
border-radius:16px;
font-size:28px;
margin-bottom:15px;
background:#fff;
box-shadow:0 6px 18px #10182812
}

.card h3{
margin-bottom:7px;
font-size:19px
}

.card p{
color:var(--muted);
font-size:14px
}

/* JOURNEY */

.journey{
background:linear-gradient(135deg,#eef4ff,#faf5ff,#fff)
}

.days{
display:grid;
grid-template-columns:repeat(7,1fr);
gap:9px;
max-width:760px;
margin:30px auto
}

.day{
padding:11px 4px;
text-align:center;
font-size:12px;
font-weight:800;
border-radius:10px;
background:#fff;
color:#667085;
box-shadow:0 4px 12px #10182808
}

.day.active{
background:linear-gradient(135deg,var(--blue),var(--purple));
color:#fff
}

.progress{
max-width:760px;
height:14px;
background:#e4e7ec;
border-radius:20px;
overflow:hidden;
margin:20px auto 10px
}

.progress div{
width:12%;
height:100%;
background:linear-gradient(90deg,var(--blue),var(--purple),var(--pink));
border-radius:20px
}

.progress-text{
text-align:center;
color:var(--muted);
font-size:14px
}

/* LESSON */

.lesson{
max-width:730px;
margin:auto;
padding:30px;
border-radius:24px;
background:linear-gradient(145deg,#fff,#f7f5ff);
border:1px solid #ddd6fe;
box-shadow:0 15px 45px #7c3aed12
}

.lesson-top{
display:flex;
justify-content:space-between;
gap:15px;
margin-bottom:20px
}

.lesson-top small{
color:var(--blue);
font-weight:800
}

.lock{
background:#fff7ed;
color:#c2410c;
padding:7px 11px;
border-radius:9px;
font-size:12px;
font-weight:800;
height:max-content
}

.question{
margin-top:20px;
padding:20px;
border-radius:16px;
background:#fff;
border:1px solid var(--line)
}

.option{
padding:11px;
margin-top:8px;
border:1px solid var(--line);
border-radius:10px;
color:var(--muted);
transition:.2s
}

.option:hover{
background:#eef4ff;
border-color:#b9ccff;
color:var(--blue)
}

/* PRICE */

.price{
max-width:470px;
margin:auto;
padding:35px;
text-align:center;
border-radius:25px;
background:linear-gradient(145deg,#ffffff,#f5f3ff);
border:2px solid #8b5cf6;
box-shadow:0 20px 50px #7c3aed20
}

.price .amount{
font-size:40px;
font-weight:900;
color:var(--purple);
margin:10px 0
}

.price .amount small{
font-size:14px;
color:var(--muted);
font-weight:400
}

.features{
text-align:left;
margin:25px 0
}

.features div{
padding:8px 0;
font-size:14px
}

.features div:before{
content:"✓";
color:var(--green);
font-weight:900;
margin-right:10px
}

/* COMPARISON */

.compare-wrap{
overflow-x:auto;
border-radius:18px;
box-shadow:0 10px 30px #1018280d
}

.compare{
width:100%;
min-width:500px;
border-collapse:collapse;
background:#fff
}

.compare th,
.compare td{
padding:15px;
border-bottom:1px solid var(--line);
text-align:center;
font-size:14px
}

.compare th:first-child,
.compare td:first-child{
text-align:left
}

.compare th{
background:linear-gradient(90deg,#eef4ff,#f5f0ff);
color:var(--dark)
}

.yes{
color:var(--green);
font-weight:900
}

.no{color:#98a2b3}

/* FAQ */

.faq{
max-width:760px;
margin:auto
}

details{
background:#fff;
border:1px solid var(--line);
border-radius:14px;
margin-bottom:10px;
padding:17px 18px;
box-shadow:0 5px 15px #10182807
}

summary{
cursor:pointer;
font-weight:800
}

details p{
color:var(--muted);
font-size:14px;
margin-top:10px
}

/* CTA */

.cta{
padding:65px 20px;
text-align:center;
color:#fff;
background:
radial-gradient(circle at 20% 30%,#ffffff25 0,transparent 25%),
radial-gradient(circle at 80% 70%,#ffffff20 0,transparent 25%),
linear-gradient(135deg,var(--blue),var(--purple),var(--pink))
}

.cta h2{font-size:32px}

.cta p{
max-width:600px;
margin:10px auto 23px;
opacity:.92
}

.cta .btn{
background:#fff;
color:var(--purple)
}

/* FOOTER */

footer{
background:#101828;
color:#fff;
padding:38px 20px;
text-align:center
}

.footer-logo{
font-size:21px;
font-weight:900;
color:#fff;
margin-bottom:7px
}

footer p{
color:#98a2b3;
font-size:13px;
margin-bottom:17px
}

.footer-links{
display:flex;
justify-content:center;
gap:18px;
flex-wrap:wrap
}

.footer-links a{
color:#d0d5dd;
font-size:13px
}

.footer-links a:hover{color:#fff}

/* WHATSAPP */

.whatsapp{
position:fixed;
right:18px;
bottom:18px;
z-index:999;
width:58px;
height:58px;
border-radius:50%;
display:flex;
align-items:center;
justify-content:center;
background:#25d366;
color:#fff;
font-size:30px;
box-shadow:0 8px 25px #0003;
transition:.2s
}

.whatsapp:hover{
transform:scale(1.08)
}

.whatsapp-label{
position:fixed;
right:86px;
bottom:29px;
z-index:998;
background:#172033;
color:#fff;
padding:7px 12px;
border-radius:8px;
font-size:12px;
font-weight:700;
opacity:0;
pointer-events:none;
transition:.2s
}

.whatsapp:hover + .whatsapp-label{
opacity:1
}

/* MOBILE */

@media(max-width:700px){

.navlinks a:not(.btn){
display:none
}

.hero{
padding:60px 18px 50px
}

.hero h1{
font-size:37px;
letter-spacing:-1px
}

.hero p{
font-size:15px
}

section{
padding:52px 0
}

.title h2{
font-size:26px
}

.stats{
grid-template-columns:repeat(2,1fr)
}

.grid{
grid-template-columns:1fr
}

.days{
grid-template-columns:repeat(4,1fr)
}

.lesson{
padding:22px
}

.lesson-top{
flex-direction:column
}

.price{
margin:0 5px;
padding:28px 22px
}

.price .amount{
font-size:34px
}

.whatsapp{
right:15px;
bottom:15px;
width:56px;
height:56px
}

.whatsapp-label{
display:none
}

}
</style>
</head>

