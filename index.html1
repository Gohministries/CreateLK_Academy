<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>CreateLK — Learn. Create. Grow.</title>
<meta name="description" content="CreateLK AI — Learn, create and grow with AI.">

<style>
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:Arial,sans-serif;background:#f7f9fc;color:#111827;line-height:1.6}
header{position:sticky;top:0;z-index:50;background:#fff;border-bottom:1px solid #e5e7eb}
.nav{max-width:1200px;margin:auto;min-height:70px;padding:0 20px;display:flex;align-items:center;justify-content:space-between;gap:20px}
.logo{display:flex;align-items:center;gap:10px;text-decoration:none;color:#111827;font-size:23px;font-weight:800}
.logo img{width:42px;height:42px;border-radius:10px;object-fit:cover}
.navlinks{display:flex;gap:20px}
.navlinks a{text-decoration:none;color:#374151;font-weight:600}
.actions{display:flex;align-items:center;gap:8px}
.user-area{display:none;align-items:center;gap:8px}
button,.btn{border:0;cursor:pointer;border-radius:9px;padding:10px 16px;font-weight:700;text-decoration:none;display:inline-block}
.btn-primary{background:#111827;color:#fff}
.btn-light{background:#eef2f7;color:#111827}
.btn-premium{background:#f59e0b;color:#fff}
.hero{min-height:650px;display:flex;align-items:center;padding:80px 20px;background:linear-gradient(rgba(255,255,255,.88),rgba(255,255,255,.94)),url("https://assets.createlk.com/file_000000003e448207b8c6a7ecc4a7e1d4.png") center/cover}
.hero-inner,.container{width:100%;max-width:1200px;margin:auto}
.hero h1{max-width:800px;font-size:clamp(45px,7vw,78px);line-height:1.05;margin-bottom:22px}
.hero h1 span{color:#2563eb}
.hero p{max-width:700px;font-size:20px;color:#4b5563;margin-bottom:30px}
.hero-buttons{display:flex;gap:12px;flex-wrap:wrap}
section{padding:80px 20px}
.section-title{text-align:center;margin-bottom:45px}
.section-title h2{font-size:38px;margin-bottom:10px}
.section-title p{color:#6b7280}
.ai-box{max-width:950px;margin:auto;padding:30px;background:#fff;border-radius:20px;box-shadow:0 10px 40px #0001}
.language-row{display:grid;grid-template-columns:1fr 1fr;gap:15px}
label{display:block;margin-bottom:7px;font-weight:700}
select,input,textarea{width:100%;padding:13px;margin-bottom:17px;border:1px solid #d1d5db;border-radius:9px;font:inherit}
textarea{min-height:150px;resize:vertical}
.ai-answer{display:none;margin-top:25px;padding:20px;border-radius:12px;background:#f3f4f6;white-space:pre-wrap}
.features{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:20px}
.feature{background:#fff;padding:28px;border-radius:16px;box-shadow:0 5px 20px #0001}
.feature h3{margin-bottom:10px}
footer{padding:50px 20px;text-align:center;background:#111827;color:#fff}
.modal{display:none;position:fixed;inset:0;z-index:100;align-items:center;justify-content:center;padding:20px;background:#0009}
.modal-box{width:100%;max-width:430px;padding:30px;background:#fff;border-radius:18px;position:relative}
.close{position:absolute;top:10px;right:15px;padding:0;background:transparent;font-size:28px}
.status{display:none;padding:10px;margin-bottom:15px;border-radius:8px;background:#f3f4f6}
.whatsapp{position:fixed;right:18px;bottom:18px;z-index:99;padding:12px 17px;border-radius:30px;background:#25D366;color:#fff;text-decoration:none;font-weight:bold}
.premium-box{max-width:700px;margin:auto;padding:35px;text-align:center;background:#fff;border-radius:20px;box-shadow:0 10px 40px #0001}
.premium-box h2{font-size:38px;margin-bottom:15px}
.premium-box p{color:#6b7280;margin-bottom:20px}

@media(max-width:850px){
.navlinks{display:none}
.language-row{grid-template-columns:1fr}
.hero{min-height:570px}
.hero h1{font-size:50px}
}
</style>
</head>

<body>

<header>
<div class="nav">

<a class="logo" href="#home">
<img src="https://assets.createlk.com/file_000000003e448207b8c6a7ecc4a7e1d4.png" alt="CreateLK">
CreateLK
</a>

<nav class="navlinks">
<a href="#home">Home</a>
<a href="#ai">AI Tutor</a>
<a href="#features">Features</a>
<a href="#contact">Contact</a>
</nav>

<div class="actions">

<div id="loggedOut">
<button class="btn-light" onclick="openModal('loginModal')">Login</button>
<button class="btn-primary" onclick="openModal('registerModal')">Register</button>
</div>

<div id="loggedIn" class="user-area">
<span id="userName"></span>
<button class="btn-premium" onclick="premium()">Premium</button>
<button class="btn-light" onclick="logout()">Logout</button>
</div>

</div>
</div>
</header>


<section class="hero" id="home">
<div class="hero-inner">

<h1>Learn. <span>Create.</span> Grow.</h1>

<p>
CreateLK is an AI-powered learning and creator platform.
Learn new skills, create better content and grow your digital future.
</p>

<div class="hero-buttons">
<a href="#ai" class="btn btn-primary">Ask CreateLK AI</a>
<button class="btn btn-light" onclick="openModal('registerModal')">
Create Free Account
</button>
</div>

</div>
</section>


<section id="ai">
<div class="container">

<div class="section-title">
<h2>CreateLK AI Tutor</h2>
<p>
Ask questions about education, technology, YouTube, Facebook,
TikTok, Instagram, business and more.
</p>
</div>

<div class="ai-box">

<div id="aiStatus" class="status"></div>

<div class="language-row">

<div>
<label>Language</label>
<select id="language">
<option value="English">English</option>
<option value="Sinhala">සිංහල</option>
<option value="Tamil">தமிழ்</option>
</select>
</div>

<div>
<label>Category</label>
<select id="category">
<option value="">Loading categories...</option>
</select>
</div>

</div>

<label>Your question</label>

<textarea
id="question"
placeholder="Ask CreateLK AI anything..."></textarea>

<button class="btn btn-primary" onclick="askAI()">
Ask CreateLK AI
</button>

<div id="answer" class="ai-answer"></div>

</div>
</div>
</section>


<section id="features">
<div class="container">

<div class="section-title">
<h2>Everything in CreateLK</h2>
<p>One platform for learning, creating and growing.</p>
</div>

<div class="features">

<div class="feature">
<h3>🤖 AI Tutor</h3>
<p>Learn with AI in English, Sinhala or Tamil.</p>
</div>

<div class="feature">
<h3>📚 Education</h3>
<p>Learn subjects and prepare for exams.</p>
</div>

<div class="feature">
<h3>▶️ YouTube</h3>
<p>Learn content, growth, SEO and monetization.</p>
</div>

<div class="feature">
<h3>📘 Facebook</h3>
<p>Learn Pages, Reels, growth and monetization.</p>
</div>

<div class="feature">
<h3>📱 Social Media</h3>
<p>Learn TikTok, Instagram and content creation.</p>
</div>

<div class="feature">
<h3>💻 Digital Skills</h3>
<p>Learn Canva, editing, websites and SEO.</p>
</div>

<div class="feature">
<h3>💰 Online Income</h3>
<p>Learn freelancing, affiliate marketing and digital products.</p>
</div>

<div class="feature">
<h3>🎰 Gambling Awareness</h3>
<p>Learn probability, risks, scams and responsible gambling.</p>
</div>

</div>
</div>
</section>


<section>
<div class="container">

<div class="premium-box">
<h2>CreateLK Premium</h2>
<p>Get unlimited AI learning and creator assistance.</p>
<button class="btn btn-premium" onclick="premium()">
Get Premium
</button>
</div>

</div>
</section>


<section id="contact">
<div class="container">

<div class="section-title">
<h2>Contact CreateLK</h2>
<p>Need help? Contact CreateLK support through WhatsApp.</p>
</div>

</div>
</section>


<footer>
<p><strong>CreateLK</strong></p>
<p>Learn. Create. Grow.</p>
<p style="margin-top:10px">© 2026 CreateLK. All rights reserved.</p>
</footer>


<a
class="whatsapp"
href="https://wa.me/94771190395"
target="_blank"
rel="noopener">
WhatsApp
</a>


<!-- LOGIN -->

<div id="loginModal" class="modal">
<div class="modal-box">

<button class="close" onclick="closeModal('loginModal')">×</button>

<h2>Login</h2>
<br>

<div id="loginStatus" class="status"></div>

<input id="loginEmail" type="email" placeholder="Email" autocomplete="email">

<input id="loginPassword" type="password" placeholder="Password" autocomplete="current-password">

<button class="btn btn-primary" style="width:100%" onclick="login()">
Login
</button>

</div>
</div>


<!-- REGISTER -->

<div id="registerModal" class="modal">
<div class="modal-box">

<button class="close" onclick="closeModal('registerModal')">×</button>

<h2>Create Account</h2>
<br>

<div id="registerStatus" class="status"></div>

<input id="registerName" type="text" placeholder="Your name" autocomplete="name">

<input id="registerEmail" type="email" placeholder="Email" autocomplete="email">

<input id="registerPassword" type="password" placeholder="Password — minimum 6 characters" autocomplete="new-password">

<button class="btn btn-primary" style="width:100%" onclick="register()">
Create Account
</button>

</div>
</div>


<script>

const AUTH_API="https://createlk-digital-shop.createlk.workers.dev";
const AI_API="https://createlk-ai.createlk.workers.dev";

let authToken=localStorage.getItem("createlk_token")||"";
let currentUser=null;

const categoryEmoji={
"AI & Technology":"🤖",
"YouTube":"▶️",
"Facebook":"📘",
"TikTok":"🎵",
"Instagram":"📸",
"Creator & Social Media":"🎨",
"Online Income":"💰",
"Business":"💼",
"Digital Skills":"💻",
"Education":"📚",
"Casino & Gambling Awareness":"🎰"
};

async function api(base,path,options={}){

const headers={
"Content-Type":"application/json",
...(options.headers||{})
};

if(authToken)
headers.Authorization="Bearer "+authToken;

const res=await fetch(base+path,{
...options,
headers
});

const text=await res.text();

try{
return JSON.parse(text);
}catch{
return{
success:false,
error:"Invalid response from Cloudflare."
};
}
}

function openModal(id){
document.getElementById(id).style.display="flex";
}

function closeModal(id){
document.getElementById(id).style.display="none";
}

function showStatus(id,message){
const el=document.getElementById(id);
el.textContent=message;
el.style.display="block";
}


async function register(){

const fullName=document.getElementById("registerName").value.trim();
const email=document.getElementById("registerEmail").value.trim();
const password=document.getElementById("registerPassword").value;

if(!fullName||!email||!password){
showStatus("registerStatus","Please fill all fields.");
return;
}

if(password.length<6){
showStatus("registerStatus","Password must be at least 6 characters.");
return;
}

const parts=fullName.split(/\s+/);
const first_name=parts.shift();
const last_name=parts.join(" ");

showStatus("registerStatus","Creating account...");

try{

const result=await api(
AUTH_API,
"/auth/register",
{
method:"POST",
body:JSON.stringify({
first_name,
last_name,
email,
phone:"",
password
})
}
);

if(!result.success||!result.token){
showStatus(
"registerStatus",
result.error||"Registration failed."
);
return;
}

authToken=result.token;
localStorage.setItem("createlk_token",authToken);

currentUser=result.customer;

closeModal("registerModal");
updateUserUI();

alert("Account created successfully.");

}catch(error){

console.error(error);

showStatus(
"registerStatus",
"Unable to connect to Cloudflare."
);
}
}


async function login(){

const email=document.getElementById("loginEmail").value.trim();
const password=document.getElementById("loginPassword").value;

if(!email||!password){
showStatus("loginStatus","Enter your email and password.");
return;
}

showStatus("loginStatus","Logging in...");

try{

const result=await api(
AUTH_API,
"/auth/login",
{
method:"POST",
body:JSON.stringify({
email,
password
})
}
);

if(!result.success||!result.token){
showStatus(
"loginStatus",
result.error||"Login failed."
);
return;
}

authToken=result.token;
localStorage.setItem("createlk_token",authToken);

currentUser=result.customer;

closeModal("loginModal");
updateUserUI();

alert(
"Welcome "+
(
currentUser.first_name||
currentUser.email
)+
"!"
);

}catch(error){

console.error(error);

showStatus(
"loginStatus",
"Unable to connect to Cloudflare."
);
}
}


function logout(){

authToken="";
currentUser=null;

localStorage.removeItem("createlk_token");

updateUserUI();
}


async function loadUser(){

if(!authToken){
updateUserUI();
return;
}

try{

const result=await api(
AUTH_API,
"/auth/me"
);

if(result.success&&result.customer){

currentUser=result.customer;

}else{

authToken="";
currentUser=null;

localStorage.removeItem("createlk_token");
}

updateUserUI();

}catch(error){

console.error(error);
}
}


function updateUserUI(){

const loggedOut=document.getElementById("loggedOut");
const loggedIn=document.getElementById("loggedIn");
const userName=document.getElementById("userName");

if(currentUser){

loggedOut.style.display="none";
loggedIn.style.display="flex";

userName.textContent=
currentUser.first_name||
currentUser.email||
"Account";

}else{

loggedOut.style.display="block";
loggedIn.style.display="none";
userName.textContent="";
}
}


async function loadCategories(){

const select=document.getElementById("category");

try{

const result=await api(
AI_API,
"/api/categories"
);

if(!result.success&&!result.ok){

select.innerHTML=
'<option value="">Unable to load categories</option>';

return;
}

const categories=result.categories||[];

select.innerHTML=
'<option value="">Select a category</option>';

const grouped={};

categories.forEach(c=>{

const group=c.group_name||"Other";

if(!grouped[group])
grouped[group]=[];

grouped[group].push(c);
});

Object.keys(grouped)
.sort()
.forEach(groupName=>{

const emoji=
categoryEmoji[groupName]||"📂";

const optgroup=
document.createElement("optgroup");

optgroup.label=
emoji+" "+groupName;

grouped[groupName]
.sort((a,b)=>a.name.localeCompare(b.name))
.forEach(c=>{

const option=
document.createElement("option");

option.value=c.name;
option.textContent=c.name;

optgroup.appendChild(option);

});

select.appendChild(optgroup);

});

}catch(error){

console.error(error);

select.innerHTML=
'<option value="">Unable to connect to Cloudflare</option>';
}
}


async function askAI(){

if(!currentUser){

openModal("loginModal");
showStatus(
"loginStatus",
"Please login to use CreateLK AI."
);

return;
}

const question=
document.getElementById("question").value.trim();

const category=
document.getElementById("category").value;

const language=
document.getElementById("language").value;

const answer=
document.getElementById("answer");

if(!question){

showStatus(
"aiStatus",
"Please enter your question."
);

return;
}

answer.style.display="block";
answer.textContent="CreateLK AI is thinking...";

try{

const result=await api(
AI_API,
"/api/ai",
{
method:"POST",
body:JSON.stringify({
question,
category,
language
})
}
);

if(!result.success&&!result.ok){

answer.textContent=
result.error||
"AI request failed.";

return;
}

answer.textContent=
result.answer||
result.response||
"No answer received.";

}catch(error){

console.error(error);

answer.textContent=
"Unable to connect to CreateLK AI.";
}
}


async function premium(){

if(!currentUser){

openModal("loginModal");
return;
}

try{

const result=await api(
AI_API,
"/api/premium",
{
method:"POST"
}
);

if(!result.success&&!result.ok){

alert(
result.error||
"Premium order could not be created."
);

return;
}

alert(
"Premium order created: "+
(result.order_id||"Please continue with payment.")
);

}catch(error){

console.error(error);

alert(
"Unable to connect to Cloudflare."
);
}
}


document.addEventListener("click",e=>{

if(e.target.classList.contains("modal")){
e.target.style.display="none";
}

});


document.addEventListener("DOMContentLoaded",()=>{

loadUser();
loadCategories();

});

</script>

</body>
</html>