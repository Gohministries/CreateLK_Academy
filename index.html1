<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#0b1628">
<meta name="description" content="Learn with CreateLK Academy in English, Tamil and Sinhala through free and premium online lessons.">
<title>CreateLK Academy — Online Learning</title>
<style>
*{box-sizing:border-box}
body{margin:0;font:15px Arial,sans-serif;background:#0b1628;color:#dbe4f0}
button,select,input{font:inherit}
button{cursor:pointer;border:0}
.btn{padding:11px 14px;border-radius:8px;background:#c5a64b;color:#101b2c;font-weight:bold}
header{position:sticky;top:0;background:#0a1527;z-index:5;border-bottom:1px solid #243753}
nav{max-width:950px;margin:auto;min-height:62px;padding:8px 14px;display:flex;align-items:center;gap:10px}
.brand{display:flex;align-items:center;gap:8px;margin-right:auto;color:white;text-decoration:none;font-weight:bold;font-size:17px}
.brand img{width:36px;height:36px;object-fit:contain}
.gold{color:#d9b85c}
.menu-wrap{position:relative}
.menu-btn{padding:10px;border-radius:8px;background:#172942;color:white}
.menu{display:none;position:absolute;right:0;top:43px;width:210px;max-height:75vh;overflow:auto;background:#13233b;border:1px solid #30435e;border-radius:9px;padding:7px}
.menu.show{display:block}
.menu a{display:block;padding:10px;color:#dbe4f0;text-decoration:none}
main{max-width:950px;margin:auto;padding:12px}
section{background:#13233b;border:1px solid #243753;border-radius:12px}
.hero{text-align:center;padding:24px 14px}
.hero h1{font-size:clamp(29px,5vw,42px);margin:12px 0}
.hero h2{color:#d9b85c;font-size:20px}
.hero p,.muted{color:#aab8cc;line-height:1.6}
.stats{display:flex;gap:6px;margin:15px 0}
.stat{flex:1;min-width:0;background:#172942;padding:10px 4px;border-radius:8px}
.stat strong,.stat small{display:block}
.stat strong{color:#d9b85c;overflow:hidden;text-overflow:ellipsis}
.stat small{font-size:9px;color:#9eacc2;margin-top:4px}
.account{display:none;margin:8px}
.link{display:block;max-width:350px;margin:8px auto;padding:11px;border-radius:8px;text-decoration:none;font-weight:bold}
.affiliate{background:#c5a64b;color:#101b2c}
.panel,.lesson{padding:16px;margin-top:13px}
.panel h2{margin-top:0}
.field{margin:15px 0}
label{display:block;margin-bottom:7px;font-weight:bold}
select,input[type=search]{width:100%;padding:12px;border:1px solid #30435e;border-radius:8px;background:#172942;color:white}
select:disabled{opacity:.5}
#loadBtn{width:100%;margin-top:8px}
.notice{display:none;padding:12px;margin:10px 0;background:#49262b;border-radius:8px;line-height:1.5}
.notice.show{display:block}
.search-result{display:block;width:100%;text-align:left;padding:12px;margin-top:6px;border-radius:8px;background:#172942;color:#dbe4f0;border:1px solid #30435e}
.badge{display:inline-block;padding:5px 8px;border-radius:5px;font-size:11px;background:#193b32;color:#b8e4d1}
.premium{background:#2b3444;color:#d9b85c}
.language-box{margin:14px 0;padding:13px;background:#172942;border:1px solid #30435e;border-radius:10px}
.language-box h3{margin:0 0 10px;color:#d9b85c;font-size:16px}
#lessonPhoto{display:none;width:100%;max-height:360px;object-fit:contain;border-radius:9px;margin:0 0 16px;background:#0b1628}
#lessonTitle{margin-top:14px}
.content{line-height:1.8;overflow-wrap:anywhere}
.content img{max-width:100%;height:auto}
.content table{max-width:100%;border-collapse:collapse}
.content td,.content th{border:1px solid #52627a;padding:7px}
footer{text-align:center;padding:20px;color:#8292a7;font-size:11px;border-top:1px solid #243753;margin-top:25px}
footer a{color:#aab8cc;margin:5px;text-decoration:none}
@media(max-width:500px){.brand{font-size:15px}.brand img{width:32px;height:32px}.hero{padding:20px 10px}.stat strong{font-size:14px}}
</style>
</head>
<body>

<header>
<nav>
<a class="brand" href="/v2/">
<img src="https://assets.createlk.com/file_00000000f97082119cf85b0ae761f096.png" alt="CreateLK Academy">
<span>CreateLK <span class="gold">Academy</span></span>
</a>
<button class="btn" id="loginBtn" onclick="login()">Sign in</button>
<img id="avatar" width="35" height="35" hidden style="border-radius:50%;object-fit:cover" alt="Profile">
<div class="menu-wrap">
<button class="menu-btn" aria-label="Open menu" onclick="$('menu').classList.toggle('show')">☰</button>
<div class="menu" id="menu">
<a href="/v2/">📚 Academy Home</a>
<a href="#" onclick="affiliate();return false">💰 Affiliate Program</a>
<a href="/v2/about.html">About Us</a>
<a href="/v2/contact.html">Contact Us</a>
<a href="/v2/terms.html">Terms</a>
<a href="/v2/privacy.html">Privacy</a>
<a href="/v2/refund.html">Refund</a>
<a href="/v2/payment.html">Payment Policy</a>
<a href="/v2/disclaimer.html">Disclaimer</a>
<a id="logout" hidden href="#" onclick="location.href=API+'/auth/logout';return false">Logout</a>
</div>
</div>
</nav>
</header>

<main>
<section class="hero">
<div class="gold">🇱🇰 FOR SRI LANKAN LEARNERS</div>
<h1>CreateLK Academy</h1>
<h2>Learn. Practise. Achieve.</h2>
<p>Explore courses, develop new skills and learn at your own pace.</p>
<p>📚 Step-by-step lessons<br>🌐 English, Tamil and Sinhala<br>🎯 Beginner-friendly learning<br>🔓 Free and Premium lessons</p>
<p><strong>Choose a course and start learning today.</strong></p>

<div class="stats">
<div class="stat"><strong id="subjectCount">0</strong><small>COURSES</small></div>
<div class="stat"><strong id="lessonCount">—</strong><small>LESSONS</small></div>
<div class="stat"><strong id="membership">GUEST</strong><small>MEMBERSHIP</small></div>
</div>

<div id="account" class="account"></div>
<a class="link affiliate" href="#" onclick="affiliate();return false">💰 Affiliate Program</a>
</section>

<div class="notice" id="notice"></div>

<section class="panel">
<h2>🔎 Search Courses and Lessons</h2>
<input id="searchInput" type="search" placeholder="Search any course or lesson..." autocomplete="off">
<div id="searchResults"></div>
</section>

<section class="panel">
<h2>📚 Explore Courses and Lessons</h2>
<p class="muted">Choose a course, select a lesson, and press Load Lesson.</p>

<div class="field">
<label for="subjectSelect">Course</label>
<select id="subjectSelect"><option value="">Loading courses...</option></select>
</div>

<div class="field">
<label for="lessonSelect">Select Lesson</label>
<select id="lessonSelect" disabled><option value="">Choose course first</option></select>
</div>

<div id="lessonInfo" class="muted"></div>
<button id="loadBtn" class="btn" disabled>Load Lesson →</button>
</section>

<section id="lessonView" class="lesson" style="display:none">
<!-- Photo always appears at the top -->
<img id="lessonPhoto" alt="Lesson image">

<!-- Language navigation appears below the photo -->
<div id="languageBox" class="language-box">
<h3>🌐 Lesson Language / மொழி / භාෂාව</h3>
<select id="languageSelect" aria-label="Select lesson language"></select>
<p id="languageMessage" class="muted" style="margin-bottom:0"></p>
</div>

<div id="lessonBadge"></div>
<h2 id="lessonTitle"></h2>
<p id="lessonDescription" class="muted"></p>
<div id="lessonContent" class="content"></div>
</section>
</main>

<footer>
© <span id="year"></span> CreateLK Academy — Online Learning<br><br>
<a href="/v2/terms.html">Terms</a>
<a href="/v2/privacy.html">Privacy</a>
<a href="/v2/refund.html">Refund</a>
<a href="/v2/contact.html">Contact</a>
</footer>

<script>
"use strict";

const API="https://createlk-english-v2.createlk.workers.dev";
const TRANSLATION_API="https://update-v2.createlk.workers.dev";
const $=id=>document.getElementById(id);

let referral="",subjects=[],lessons=[],userData=null,requestNo=0;
let searchIndex=[],originalLesson=null,originalContent="";

function note(message){
$("notice").textContent=message;
$("notice").classList.add("show");
}

function clearNote(){
$("notice").textContent="";
$("notice").classList.remove("show");
}

function login(){
location.href=API+"/auth/google"+(referral?"?ref="+encodeURIComponent(referral):"");
}

function affiliate(){
$("menu").classList.remove("show");
if(!userData)login();
else location.href="/v2/aff.html";
}

document.addEventListener("click",e=>{
if(!e.target.closest(".menu-wrap"))$("menu").classList.remove("show");
});

async function get(path){
const r=await fetch(API+path,{
credentials:"include",
cache:"no-store"
});
let d={};
try{d=await r.json()}catch{}
return{r,d};
}

function getFree(l){
return l.is_free===true||Number(l.is_free)===1;
}

async function loadUser(){
try{
const {r,d}=await get("/api/me");

if(!r.ok||!d.logged_in){
userData=null;
$("membership").textContent="GUEST";
$("account").style.display="none";
$("avatar").hidden=true;
$("loginBtn").hidden=false;
$("logout").hidden=true;
return;
}

userData=d.user||{};
$("membership").textContent=String(userData.membership||"FREE").toUpperCase();
$("account").textContent="👤 "+(userData.name||userData.email||"Account");
$("account").style.display="inline-block";
$("loginBtn").hidden=true;
$("logout").hidden=false;

if(userData.avatar_url){
$("avatar").src=userData.avatar_url;
$("avatar").hidden=false;
}else{
$("avatar").hidden=true;
}
}catch(e){
console.error(e);
}
}

async function loadSubjects(){
const {r,d}=await get("/api/subjects");

if(!r.ok||d.success===false)
throw Error(d.error||"Unable to load courses.");

subjects=Array.isArray(d)?d:(d.subjects||d.data||d.results||[]);
$("subjectCount").textContent=subjects.length;
$("subjectSelect").innerHTML='<option value="">-- Select Course --</option>';

subjects.forEach((s,i)=>{
const o=document.createElement("option");
o.value=i;
o.textContent=s.name||s.title||s.slug||"Course "+(i+1);
$("subjectSelect").appendChild(o);
});

if(!subjects.length){
$("subjectSelect").innerHTML='<option value="">No courses available</option>';
note("No courses are currently available. Please try again later.");
return;
}

await buildSearchIndex();
}

async function fetchLessons(s){
const {r,d}=await get("/api/lessons?subject="+encodeURIComponent(s.slug||s.id));

if(!r.ok||d.success===false)return[];

return Array.isArray(d)?d:(d.lessons||d.data||d.results||[]);
}

async function buildSearchIndex(){
const results=await Promise.allSettled(subjects.map(async(s,si)=>{
const rows=await fetchLessons(s);
return rows.map(lesson=>({
subjectIndex:si,
subjectTitle:s.name||s.title||s.slug||"Course",
lesson,
lessonTitle:lesson.title||"Lesson"
}));
}));

searchIndex=results.flatMap(x=>x.status==="fulfilled"?x.value:[]);
renderSearch();
}

function renderSearch(){
const q=$("searchInput").value.trim().toLowerCase();
const box=$("searchResults");
box.replaceChildren();

if(!q)return;

const matches=searchIndex.filter(x=>
String(x.lessonTitle).toLowerCase().includes(q)||
String(x.subjectTitle).toLowerCase().includes(q)
).slice(0,30);

matches.forEach(x=>{
const b=document.createElement("button");
b.className="search-result";
b.textContent="📚 "+x.subjectTitle+" — "+x.lessonTitle;

b.onclick=async()=>{
$("subjectSelect").value=String(x.subjectIndex);
await subjectChanged();

const i=lessons.findIndex(l=>String(l.id)===String(x.lesson.id));

if(i>=0){
$("lessonSelect").value=String(i);
lessonChanged();
$("loadBtn").scrollIntoView({behavior:"smooth",block:"center"});
}
};

box.appendChild(b);
});

if(!matches.length){
const p=document.createElement("p");
p.className="muted";
p.textContent="No matching courses or lessons found.";
box.appendChild(p);
}
}

$("searchInput").addEventListener("input",renderSearch);

async function subjectChanged(){
const i=$("subjectSelect").value;
const select=$("lessonSelect");

lessons=[];
$("lessonView").style.display="none";
$("lessonInfo").textContent="";
$("loadBtn").disabled=true;

if(i===""){
select.innerHTML='<option value="">Choose course first</option>';
select.disabled=true;
$("lessonCount").textContent="—";
return;
}

select.disabled=true;
select.innerHTML='<option value="">Loading lessons...</option>';

try{
lessons=await fetchLessons(subjects[Number(i)]);
$("lessonCount").textContent=lessons.length;
select.innerHTML='<option value="">-- Select Lesson --</option>';

lessons.forEach((l,i)=>{
const o=document.createElement("option");
o.value=i;
o.textContent=(getFree(l)?"🟢 FREE · ":"🔒 PREMIUM · ")+(l.title||"Lesson "+(i+1));
select.appendChild(o);
});

select.disabled=!lessons.length;

if(!lessons.length)note("No published lessons found for this course.");
else clearNote();

}catch(e){
select.innerHTML='<option value="">Unable to load lessons</option>';
select.disabled=true;
note(e.message||"Unable to load lessons.");
}
}

function lessonChanged(){
const i=$("lessonSelect").value;
const l=i===""?null:lessons[Number(i)];

$("lessonView").style.display="none";
$("loadBtn").disabled=!l;

$("lessonInfo").textContent=l?
(getFree(l)?"🟢 This lesson is FREE.":"🔒 This lesson is PREMIUM."):"";
}

$("subjectSelect").addEventListener("change",subjectChanged);
$("lessonSelect").addEventListener("change",lessonChanged);
$("loadBtn").addEventListener("click",loadSelectedLesson);

async function getLessonContent(id){
for(const path of [
"/api/notes/"+encodeURIComponent(id),
"/api/lesson-content?lesson="+encodeURIComponent(id),
"/api/lessons/"+encodeURIComponent(id)
]){
try{
const url=path+(path.includes("?")?"&":"?")+"_="+Date.now();
const {r,d}=await get(url);

if(!r.ok||d.success===false)continue;

for(const x of [d,d.data,d.lesson,d.notes,d.result,d.data?.lesson,d.data?.notes]){
if(typeof x==="string"&&x.trim())
return{lesson:null,content:x};

if(x&&typeof x==="object"){
const content=x.content??x.notes??x.explanation??x.lesson_content??x.html??x.body??"";

if(typeof content==="string"&&content.trim())
return{lesson:x,content};
}
}
}catch(e){
console.warn(e);
}
}
return{lesson:null,content:""};
}

/* All lesson translations come from update-v2 only. */
async function loadLanguages(id){
const box=$("languageBox");
const select=$("languageSelect");
const message=$("languageMessage");

box.style.display="block";
select.replaceChildren();
select._translations=[];
message.textContent="Loading available translations...";

const names={
en:"🇬🇧 English",
ta:"🇱🇰 தமிழ் (Tamil)",
si:"🇱🇰 සිංහල (Sinhala)"
};

let valid=[];

try{
const r=await fetch(
TRANSLATION_API+"/api/public/translations/lesson/"+encodeURIComponent(id),
{credentials:"include",cache:"no-store"}
);

if(r.ok){
const d=await r.json();
const rows=Array.isArray(d)?d:(d.translations||d.data?.translations||[]);

valid=rows.filter(t=>
["en","ta","si"].includes(String(t.language||"").toLowerCase())
);
}else{
message.textContent=r.status===401||r.status===403
?"Some translations require the appropriate account access."
:"Translations could not be loaded. Showing the default lesson.";
}
}catch(e){
console.warn("Translations unavailable",e);
message.textContent="Translations could not be loaded. Showing the default lesson.";
}

const translations={};

valid.forEach(t=>{
translations[String(t.language).toLowerCase()]=t;
});

select._translations=valid;

["en","ta","si"].forEach(lang=>{
const o=document.createElement("option");
o.value=lang;
o.textContent=names[lang]+(translations[lang]?"":" · Not available");
o.disabled=!translations[lang];
select.appendChild(o);
});

const firstAvailable=["en","ta","si"].find(lang=>translations[lang]);

if(firstAvailable){
select.value=translations.en?"en":firstAvailable;
message.textContent="Choose an available language to switch the lesson.";
}else{
select.value="en";
message.textContent="No saved translations found. Showing the default lesson.";
}

select.onchange=applyLanguage;
applyLanguage();
}

/* Change title, description and content without reloading the page. */
function applyLanguage(){
const lang=$("languageSelect").value;

const t=($("languageSelect")._translations||[]).find(
x=>String(x.language).toLowerCase()===lang
);

$("lessonTitle").textContent=
t?.title||originalLesson?.title||"Lesson";

$("lessonDescription").textContent=
t?.description||originalLesson?.description||"";

const content=t?.content||(
lang==="en"?originalContent:""
);

$("lessonContent").innerHTML=content||
"<p class='muted'>Content for this language has not been added yet.</p>";
}

/* Lesson photo is retrieved from update-v2 and displayed above everything else. */
async function loadLessonPhoto(id){
const img=$("lessonPhoto");

img.style.display="none";
img.removeAttribute("src");
img.alt="Lesson image";

try{
const r=await fetch(
TRANSLATION_API+"/api/public/lessons/"+encodeURIComponent(id),
{credentials:"include",cache:"no-store"}
);

if(!r.ok)return;

const d=await r.json();
const l=d.lesson||d.data?.lesson||d;
const url=l.image_url||l.photo_url||l.image||l.photo||"";

if(!url)return;

img.onload=()=>{img.style.display="block"};
img.onerror=()=>{img.style.display="none"};
img.src=url;

}catch(e){
console.warn("Photo unavailable",e);
}
}

async function loadSelectedLesson(){
clearNote();

const i=$("lessonSelect").value;
const l=i===""?null:lessons[Number(i)];

if(!l)return note("Please select a lesson first.");

if(!userData){
login();
return;
}

if(!getFree(l)&&l.accessible!==true){
location.href="/v2/pay.html";
return;
}

const current=++requestNo;
const btn=$("loadBtn");

btn.disabled=true;
btn.textContent="Loading lesson...";
$("lessonView").style.display="none";

try{
let lesson=l;
let content=l.content||l.notes||l.explanation||l.lesson_content||"";

if(!content){
const result=await getLessonContent(l.id);
if(current!==requestNo)return;

if(result.lesson)lesson={...l,...result.lesson};
content=result.content;
}

if(current!==requestNo)return;

originalLesson={
title:lesson.title||l.title||"Lesson",
description:lesson.description||l.description||""
};

originalContent=content;

$("lessonTitle").textContent=originalLesson.title;
$("lessonDescription").textContent=originalLesson.description;

$("lessonContent").innerHTML=content||
"<p class='muted'>Lesson content not found. Check your saved lesson content.</p>";

$("lessonBadge").innerHTML=
'<span class="badge '+(getFree(l)?"":"premium")+'">'+
(getFree(l)?"FREE LESSON":"PREMIUM LESSON")+
'</span>';

$("lessonPhoto").style.display="none";
$("lessonView").style.display="block";

/* Load the photo and translations using update-v2. */
await Promise.all([
loadLessonPhoto(l.id),
loadLanguages(l.id)
]);

if(current===requestNo){
$("lessonView").scrollIntoView({behavior:"smooth",block:"start"});
}

}catch(e){
note(e.message||"Unable to load lesson.");
}finally{
if(current===requestNo){
btn.disabled=false;
btn.textContent="Load Lesson →";
}
}
}

$("year").textContent=new Date().getFullYear();

referral=(new URLSearchParams(location.search).get("ref")||"").trim().toUpperCase();

async function init(){
await loadUser();

try{
await loadSubjects();

if(subjects.length===1){
$("subjectSelect").value="0";
await subjectChanged();
}
}catch(e){
note("Unable to load courses. Check your API connection.");
console.error(e);
}
}

init();
</script>
</body>
</html>