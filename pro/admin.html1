<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>CreateLK Pro Admin</title>

<style>
*{box-sizing:border-box}
body{
  margin:0;
  font-family:Inter,Arial,sans-serif;
  background:#f5f7fb;
  color:#111827
}
button,input,textarea,select{font:inherit}
button{cursor:pointer}

.login{
  min-height:100vh;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:20px
}

.login-box{
  width:100%;
  max-width:420px;
  background:#fff;
  padding:35px;
  border-radius:20px;
  box-shadow:0 10px 40px #0001;
  text-align:center
}

.login-box h1{margin:0 0 8px}
.login-box p{color:#6b7280}

.google{
  width:100%;
  padding:13px;
  border:0;
  border-radius:10px;
  background:#111827;
  color:#fff;
  font-weight:600
}

.app{display:none}

header{
  background:#111827;
  color:#fff;
  padding:15px 20px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:15px
}

.brand{font-size:20px;font-weight:800}

.admin{
  display:flex;
  align-items:center;
  gap:10px
}

.admin img{
  width:38px;
  height:38px;
  border-radius:50%
}

.logout{
  background:#374151;
  color:#fff;
  border:0;
  padding:9px 13px;
  border-radius:8px
}

nav{
  background:#fff;
  padding:10px 20px;
  display:flex;
  gap:8px;
  overflow:auto;
  border-bottom:1px solid #e5e7eb
}

nav button{
  border:0;
  background:#f3f4f6;
  padding:10px 16px;
  border-radius:9px;
  white-space:nowrap
}

nav button.active{
  background:#111827;
  color:#fff
}

main{
  max-width:1200px;
  margin:auto;
  padding:20px
}

.tab{display:none}
.tab.active{display:block}

.card{
  background:#fff;
  padding:20px;
  border-radius:15px;
  margin-bottom:20px;
  box-shadow:0 3px 15px #0000000a
}

.grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
  gap:15px
}

input,textarea,select{
  width:100%;
  border:1px solid #d1d5db;
  border-radius:9px;
  padding:11px;
  margin-top:6px
}

textarea{min-height:130px;resize:vertical}

label{
  display:block;
  font-size:14px;
  font-weight:600;
  margin-bottom:12px
}

.primary{
  background:#111827;
  color:#fff;
  border:0;
  padding:11px 17px;
  border-radius:9px
}

.danger{
  background:#dc2626;
  color:#fff;
  border:0;
  padding:8px 12px;
  border-radius:8px
}

.success{
  background:#059669;
  color:#fff;
  border:0;
  padding:8px 12px;
  border-radius:8px
}

.secondary{
  background:#e5e7eb;
  color:#111827;
  border:0;
  padding:8px 12px;
  border-radius:8px
}

.list{
  display:grid;
  gap:12px
}

.item{
  border:1px solid #e5e7eb;
  border-radius:12px;
  padding:15px
}

.item h3{
  margin:0 0 6px
}

.item p{
  margin:5px 0;
  color:#6b7280
}

.badge{
  display:inline-block;
  padding:4px 8px;
  border-radius:20px;
  background:#fef3c7;
  color:#92400e;
  font-size:12px;
  font-weight:700
}

.active-badge{
  background:#d1fae5;
  color:#065f46
}

.inactive-badge{
  background:#fee2e2;
  color:#991b1b
}

.actions{
  display:flex;
  gap:7px;
  flex-wrap:wrap;
  margin-top:12px
}

.preview{
  max-width:180px;
  max-height:120px;
  border-radius:8px;
  margin-top:8px
}

.price{
  font-weight:800;
  font-size:22px
}

.total{
  padding:10px;
  background:#f3f4f6;
  border-radius:9px;
  margin-bottom:12px
}

.empty{
  color:#6b7280;
  text-align:center;
  padding:20px
}

@media(max-width:600px){
  header{align-items:flex-start}
  .admin span{display:none}
  main{padding:12px}
  .card{padding:15px}
}
</style>
</head>

<body>

<!-- LOGIN -->

<div id="login" class="login">
  <div class="login-box">
    <h1>CreateLK Pro</h1>
    <p>Administrator Dashboard</p>

    <button class="google" onclick="login()">
      Continue with Google
    </button>
  </div>
</div>


<!-- APP -->

<div id="app" class="app">

<header>
  <div class="brand">CreateLK Pro Admin</div>

  <div class="admin">
    <img id="adminPhoto" src="" alt="">
    <span id="adminName"></span>
    <button class="logout" onclick="logout()">Logout</button>
  </div>
</header>


<nav>
  <button class="active" onclick="tab('prompts',this)">
    Prompts
  </button>

  <button onclick="tab('categories',this)">
    Categories
  </button>

  <button onclick="tab('packages',this)">
    Packages
  </button>

  <button onclick="tab('deposits',this)">
    Deposits
  </button>
</nav>


<main>

<!-- PROMPTS -->

<section id="prompts" class="tab active">

<div class="card">

<h2>Add Prompt</h2>

<form id="promptForm">

<div class="grid">

<label>
Title
<input id="promptTitle" required>
</label>

<label>
Category
<select id="promptCategory">
<option value="">No category</option>
</select>
</label>

</div>

<label>
Description
<input id="promptDescription">
</label>

<label>
Prompt
<textarea id="promptText"></textarea>
</label>

<label>
Image
<input
  id="promptImage"
  type="file"
  accept="image/png,image/jpeg,image/webp"
>
</label>

<button class="primary">
Add Prompt
</button>

</form>

</div>


<div class="card">
<h2>Prompts</h2>
<div id="promptList" class="list"></div>
</div>

</section>


<!-- CATEGORIES -->

<section id="categories" class="tab">

<div class="card">

<h2>Categories</h2>

<form id="categoryForm">

<label>
Category name
<input id="categoryName" required>
</label>

<button class="primary">
Add Category
</button>

</form>

</div>

<div class="card">
<div id="categoryList" class="list"></div>
</div>

</section>


<!-- PACKAGES -->

<section id="packages" class="tab">

<div class="card">

<h2>Add Package</h2>

<form id="packageForm">

<div class="grid">

<label>
Package name
<input id="packageName" required>
</label>

<label>
Paid coins
<input
  id="packageCredits"
  type="number"
  min="100"
  value="100"
  required
>
</label>

<label>
Price LKR
<input id="packagePrice" readonly>
</label>

<label>
Bonus coins
<input
  id="packageBonus"
  type="number"
  min="0"
  value="0"
>
</label>

</div>

<div class="total">
Total coins: <b id="packageTotal">100</b>
</div>

<label>
<input id="packagePopular" type="checkbox">
 Popular package
</label>

<label>
<input id="packageActive" type="checkbox" checked>
 Active
</label>

<button class="primary">
Add Package
</button>

</form>

</div>


<div class="card">

<h2>Packages</h2>

<div id="packageList" class="list"></div>

</div>

</section>


<!-- DEPOSITS -->

<section id="deposits" class="tab">

<div class="card">

<h2>Deposits</h2>

<div id="depositList" class="list"></div>

</div>

</section>

</main>
</div>


<script>

/* =========================================================
   API
========================================================= */

const USER_API =
  "https://pro.createlk.workers.dev";

const ADMIN_API =
  "https://pro-admin.createlk.workers.dev";


/* =========================================================
   HELPERS
========================================================= */

const $=id=>document.getElementById(id);

async function api(url,options={}){
  options.credentials="include";

  const r=await fetch(url,options);

  let data={};

  try{
    data=await r.json();
  }catch{}

  if(!r.ok)
    throw new Error(data.error||"Request failed");

  return data;
}

function login(){
  location.href=ADMIN_API+"/auth/google";
}

function logout(){
  location.href=ADMIN_API+"/auth/logout";
}

function tab(id,btn){

  document.querySelectorAll(".tab")
    .forEach(x=>x.classList.remove("active"));

  document.querySelectorAll("nav button")
    .forEach(x=>x.classList.remove("active"));

  $(id).classList.add("active");
  btn.classList.add("active");

  if(id==="prompts") loadPrompts();
  if(id==="categories") loadCategories();
  if(id==="packages") loadPackages();
  if(id==="deposits") loadDeposits();
}


/* =========================================================
   ME
========================================================= */

async function loadMe(){

  try{

    const d=await api(ADMIN_API+"/api/me");

    if(!d.user){
      $("login").style.display="flex";
      $("app").style.display="none";
      return;
    }

    $("login").style.display="none";
    $("app").style.display="block";

    $("adminName").textContent=d.user.name||d.user.email;

    if(d.user.photo_url)
      $("adminPhoto").src=d.user.photo_url;

    loadCategories();
    loadPrompts();
    loadPackages();
    loadDeposits();

  }catch(e){

    console.error(e);

    $("login").style.display="flex";
    $("app").style.display="none";
  }
}


/* =========================================================
   CATEGORIES
========================================================= */

async function loadCategories(){

  try{

    /*
      Categories are loaded from your existing
      user Worker.
    */

    const d=await api(
      USER_API+"/api/pro/categories"
    );

    const categories=d.categories||[];

    $("promptCategory").innerHTML=
      `<option value="">No category</option>`+
      categories.map(c=>
        `<option value="${c.id}">
          ${escapeHtml(c.name)}
        </option>`
      ).join("");

    $("categoryList").innerHTML=
      categories.length
      ?categories.map(c=>`
        <div class="item">
          <b>${escapeHtml(c.name)}</b>
        </div>
      `).join("")
      :`<div class="empty">No categories</div>`;

  }catch(e){

    $("categoryList").innerHTML=
      `<div class="empty">${escapeHtml(e.message)}</div>`;
  }
}


$("categoryForm").onsubmit=async e=>{

  e.preventDefault();

  try{

    /*
      Add category through the Admin Worker.
      It uses the same PRO_DB.
    */

    await api(
      ADMIN_API+"/api/pro/admin/categories",
      {
        method:"POST",
        headers:{
          "Content-Type":"application/json"
        },
        body:JSON.stringify({
          name:$("categoryName").value.trim()
        })
      }
    );

    $("categoryName").value="";

    await loadCategories();

    alert("Category added");

  }catch(e){
    alert(e.message);
  }
};


/* =========================================================
   PROMPTS
========================================================= */

$("promptForm").onsubmit=async e=>{

  e.preventDefault();

  try{

    let image="";

    const file=$("promptImage").files[0];

    if(file){

      image=await new Promise((resolve,reject)=>{

        const reader=new FileReader();

        reader.onload=()=>resolve(reader.result);
        reader.onerror=reject;

        reader.readAsDataURL(file);
      });
    }

    await api(
      ADMIN_API+"/api/pro/admin/prompts",
      {
        method:"POST",
        headers:{
          "Content-Type":"application/json"
        },
        body:JSON.stringify({
          title:$("promptTitle").value.trim(),
          description:$("promptDescription").value.trim(),
          prompt:$("promptText").value.trim(),
          category_id:$("promptCategory").value||null,
          image
        })
      }
    );

    $("promptForm").reset();

    loadPrompts();

    alert("Prompt added");

  }catch(e){
    alert(e.message);
  }
};


async function loadPrompts(){

  try{

    const d=await api(
      ADMIN_API+"/api/pro/admin/prompts"
    );

    const list=d.prompts||[];

    $("promptList").innerHTML=
      list.length
      ?list.map(p=>`

        <div class="item">

          <h3>${escapeHtml(p.title||"Untitled")}</h3>

          <p>
            ${escapeHtml(p.description||"")}
          </p>

          <p>
            Category:
            ${escapeHtml(p.category_name||"None")}
          </p>

          ${
            p.image_url
            ?`<img class="preview"
                src="${p.image_url}">`
            :""
          }

        </div>

      `).join("")
      :`<div class="empty">No prompts</div>`;

  }catch(e){

    $("promptList").innerHTML=
      `<div class="empty">${escapeHtml(e.message)}</div>`;
  }
}


/* =========================================================
   PACKAGES
========================================================= */

function updatePackageTotal(){

  const credits=
    Number($("packageCredits").value)||0;

  const bonus=
    Number($("packageBonus").value)||0;

  $("packagePrice").value=credits;
  $("packageTotal").textContent=credits+bonus;
}

$("packageCredits").oninput=updatePackageTotal;
$("packageBonus").oninput=updatePackageTotal;

updatePackageTotal();


$("packageForm").onsubmit=async e=>{

  e.preventDefault();

  const credits=
    Number($("packageCredits").value);

  const bonus=
    Number($("packageBonus").value)||0;

  if(credits<100){
    alert("Minimum package is 100 coins");
    return;
  }

  try{

    await api(
      ADMIN_API+"/api/pro/admin/packages",
      {
        method:"POST",
        headers:{
          "Content-Type":"application/json"
        },
        body:JSON.stringify({
          name:$("packageName").value.trim(),
          credits,
          bonus,
          popular:$("packagePopular").checked,
          active:$("packageActive").checked
        })
      }
    );

    $("packageForm").reset();

    $("packageCredits").value=100;
    $("packageBonus").value=0;
    $("packageActive").checked=true;

    updatePackageTotal();
    loadPackages();

    alert("Package added");

  }catch(e){
    alert(e.message);
  }
};


async function loadPackages(){

  try{

    const d=await api(
      ADMIN_API+"/api/pro/admin/packages"
    );

    const list=d.packages||[];

    $("packageList").innerHTML=
      list.length
      ?list.map(p=>`

        <div class="item">

          <h3>
            ${escapeHtml(p.name)}

            ${
              p.popular
              ?` <span class="badge">POPULAR</span>`
              :""
            }
          </h3>

          <p>
            Paid coins:
            <b>${p.credits}</b>
          </p>

          <p>
            Bonus:
            <b>${p.bonus}</b>
          </p>

          <p>
            Total:
            <b>${Number(p.credits)+Number(p.bonus)}</b>
          </p>

          <p class="price">
            LKR ${p.price}
          </p>

          ${
            p.active
            ?`<span class="badge active-badge">ACTIVE</span>`
            :`<span class="badge inactive-badge">INACTIVE</span>`
          }

          <div class="actions">

            <button
              class="secondary"
              onclick="editPackage(${p.id})">
              Edit
            </button>

            <button
              class="danger"
              onclick="deletePackage(${p.id})">
              Delete
            </button>

          </div>

        </div>

      `).join("")
      :`<div class="empty">No packages</div>`;

  }catch(e){

    $("packageList").innerHTML=
      `<div class="empty">${escapeHtml(e.message)}</div>`;
  }
}


async function editPackage(id){

  const name=prompt("Package name:");
  if(name===null)return;

  const credits=Number(
    prompt("Paid coins:","100")
  );

  if(!Number.isInteger(credits)||credits<100){
    alert("Minimum is 100 coins");
    return;
  }

  const bonus=Number(
    prompt("Bonus coins:","0")
  );

  if(!Number.isInteger(bonus)||bonus<0){
    alert("Invalid bonus");
    return;
  }

  const popular=confirm(
    "Make this the Popular package?"
  );

  const active=confirm(
    "Keep this package active?"
  );

  try{

    await api(
      ADMIN_API+"/api/pro/admin/packages/"+id,
      {
        method:"PUT",
        headers:{
          "Content-Type":"application/json"
        },
        body:JSON.stringify({
          name,
          credits,
          bonus,
          popular,
          active
        })
      }
    );

    loadPackages();

  }catch(e){
    alert(e.message);
  }
}


async function deletePackage(id){

  if(!confirm("Delete this package?"))
    return;

  try{

    await api(
      ADMIN_API+"/api/pro/admin/packages/"+id,
      {
        method:"DELETE"
      }
    );

    loadPackages();

  }catch(e){
    alert(e.message);
  }
}


/* =========================================================
   DEPOSITS
========================================================= */

async function loadDeposits(){

  try{

    const d=await api(
      ADMIN_API+"/api/pro/admin/deposits"
    );

    const list=d.deposits||[];

    $("depositList").innerHTML=
      list.length
      ?list.map(x=>`

        <div class="item">

          <h3>
            Deposit #${x.id}
          </h3>

          <p>
            User:
            ${escapeHtml(x.name||"")}
          </p>

          <p>
            Email:
            ${escapeHtml(x.email||"")}
          </p>

          <p>
            Amount:
            <b>
              LKR ${x.amount??x.credits??0}
            </b>
          </p>

          <p>
            Status:
            <b>${escapeHtml(x.status||"")}</b>
          </p>

          ${
            x.receipt_url
            ?`
              <p>
                <a
                  href="${x.receipt_url}"
                  target="_blank">
                  View Receipt
                </a>
              </p>
            `
            :""
          }

          ${
            x.status==="pending"
            ?`
              <div class="actions">

                <button
                  class="success"
                  onclick="depositAction(${x.id},'approve')">
                  Approve
                </button>

                <button
                  class="danger"
                  onclick="depositAction(${x.id},'reject')">
                  Reject
                </button>

              </div>
            `
            :""
          }

        </div>

      `).join("")
      :`<div class="empty">No deposits</div>`;

  }catch(e){

    $("depositList").innerHTML=
      `<div class="empty">${escapeHtml(e.message)}</div>`;
  }
}


async function depositAction(id,action){

  if(!confirm(
    action==="approve"
    ?"Approve this deposit?"
    :"Reject this deposit?"
  ))return;

  try{

    await api(
      ADMIN_API+"/api/pro/admin/deposits/"+id,
      {
        method:"POST",
        headers:{
          "Content-Type":"application/json"
        },
        body:JSON.stringify({action})
      }
    );

    loadDeposits();

  }catch(e){
    alert(e.message);
  }
}


/* =========================================================
   SECURITY
========================================================= */

function escapeHtml(x){

  return String(x??"")
    .replace(/&/g,"&amp;")
    .replace(/</g,"&lt;")
    .replace(/>/g,"&gt;")
    .replace(/"/g,"&quot;")
    .replace(/'/g,"&#039;");
}


/* START */

loadMe();

</script>

</body>
</html>