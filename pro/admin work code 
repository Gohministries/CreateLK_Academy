const SITE = "https://createlk.com";
const ADMIN = "gateofheavensl1@gmail.com";
const COOKIE = "admin_session";

const CORS = {
  "Access-Control-Allow-Origin": SITE,
  "Access-Control-Allow-Credentials": "true",
  "Access-Control-Allow-Headers": "Content-Type",
  "Access-Control-Allow-Methods": "GET,POST,PUT,DELETE,OPTIONS"
};

const json = (x, s = 200) =>
  new Response(JSON.stringify(x), {
    status: s,
    headers: {
      "Content-Type": "application/json",
      ...CORS
    }
  });

/* SESSION COOKIE
   SameSite=None is required because
   createlk.com and workers.dev are different sites.
*/
const cookie = (v, age = 2592000) =>
  `${COOKIE}=${encodeURIComponent(v)}; Path=/; HttpOnly; Secure; SameSite=None; Max-Age=${age}`;

function getCookie(r) {
  const m = (r.headers.get("Cookie") || "").match(
    new RegExp(`${COOKIE}=([^;]+)`)
  );

  return m ? decodeURIComponent(m[1]) : null;
}

async function hash(x) {
  const b = await crypto.subtle.digest(
    "SHA-256",
    new TextEncoder().encode(x)
  );

  return [...new Uint8Array(b)]
    .map(x => x.toString(16).padStart(2, "0"))
    .join("");
}

/* =========================
   ADMIN SESSION
========================= */

async function admin(r, e) {
  const token = getCookie(r);

  if (!token) return null;

  const row = await e.PRO_DB.prepare(`
    SELECT
      s.*,
      u.email,
      u.name,
      u.photo_url
    FROM admin_sessions s
    JOIN users u
      ON u.id = s.user_id
    WHERE s.id = ?
      AND s.expires_at > datetime('now')
    LIMIT 1
  `).bind(
    await hash(token)
  ).first();

  if (!row) return null;

  return String(row.email || "").toLowerCase() === ADMIN
    ? row
    : null;
}

async function auth(r, e) {
  const a = await admin(r, e);

  return a || json({
    error: "Admin login required"
  }, 401);
}

/* =========================
   GOOGLE LOGIN
========================= */

function login(r, e) {

  if (!e.GOOGLE_CLIENT_ID) {
    return json({
      error: "GOOGLE_CLIENT_ID secret is missing"
    }, 500);
  }

  const u = new URL(
    "https://accounts.google.com/o/oauth2/v2/auth"
  );

  u.searchParams.set(
    "client_id",
    e.GOOGLE_CLIENT_ID
  );

  u.searchParams.set(
    "redirect_uri",
    new URL(
      "/auth/callback",
      r.url
    ).toString()
  );

  u.searchParams.set(
    "response_type",
    "code"
  );

  u.searchParams.set(
    "scope",
    "openid email profile"
  );

  u.searchParams.set(
    "prompt",
    "select_account"
  );

  return Response.redirect(u, 302);
}

/* =========================
   GOOGLE CALLBACK
========================= */

async function callback(r, e) {

  try {

    if (!e.GOOGLE_CLIENT_ID) {
      return json({
        error: "GOOGLE_CLIENT_ID secret is missing"
      }, 500);
    }

    if (!e.GOOGLE_CLIENT_SECRET) {
      return json({
        error: "GOOGLE_CLIENT_SECRET secret is missing"
      }, 500);
    }

    const code =
      new URL(r.url).searchParams.get("code");

    if (!code) {
      return new Response(
        "Missing code",
        { status: 400 }
      );
    }

    const redirectUri =
      new URL(
        "/auth/callback",
        r.url
      ).toString();

    /* EXCHANGE GOOGLE CODE */

    const tr = await fetch(
      "https://oauth2.googleapis.com/token",
      {
        method: "POST",
        headers: {
          "Content-Type":
            "application/x-www-form-urlencoded"
        },
        body: new URLSearchParams({
          code,
          client_id: e.GOOGLE_CLIENT_ID,
          client_secret: e.GOOGLE_CLIENT_SECRET,
          redirect_uri: redirectUri,
          grant_type: "authorization_code"
        })
      }
    );

    const token = await tr.json();

    if (!tr.ok || !token.access_token) {

      console.error(
        "Google token error:",
        JSON.stringify(token)
      );

      return json({
        error: "Google login failed",
        details:
          token.error_description ||
          token.error ||
          "Token exchange failed"
      }, 400);
    }

    /* GET GOOGLE USER */

    const ur = await fetch(
      "https://openidconnect.googleapis.com/v1/userinfo",
      {
        headers: {
          Authorization:
            `Bearer ${token.access_token}`
        }
      }
    );

    const g = await ur.json();

    if (!ur.ok) {

      console.error(
        "Google userinfo error:",
        JSON.stringify(g)
      );

      return json({
        error: "Could not read Google account"
      }, 400);
    }

    const email =
      String(g.email || "")
        .trim()
        .toLowerCase();

    if (!email) {
      return json({
        error: "Google account email not found"
      }, 400);
    }

    /* ADMIN EMAIL CHECK */

    if (email !== ADMIN) {

      return new Response(
        "Access denied. Admin account required.",
        { status: 403 }
      );
    }

    /* =========================
       FIND EXISTING USER
    ========================= */

    let u = await e.PRO_DB.prepare(`
      SELECT *
      FROM users
      WHERE lower(email) = ?
      LIMIT 1
    `).bind(email).first();

    /* =========================
       CREATE OR UPDATE USER
    ========================= */

    if (u) {

      /*
        Make sure the existing user has an ID.
        Your users.id is TEXT PRIMARY KEY.
      */

      if (!u.id) {

        const newId =
          "admin-" +
          crypto.randomUUID();

        await e.PRO_DB.prepare(`
          UPDATE users
          SET
            id = ?,
            name = ?,
            photo_url = ?
          WHERE lower(email) = ?
        `).bind(
          newId,
          g.name || "",
          g.picture || "",
          email
        ).run();

      } else {

        await e.PRO_DB.prepare(`
          UPDATE users
          SET
            name = ?,
            photo_url = ?
          WHERE id = ?
        `).bind(
          g.name || "",
          g.picture || "",
          u.id
        ).run();
      }

      u = await e.PRO_DB.prepare(`
        SELECT *
        FROM users
        WHERE lower(email) = ?
        LIMIT 1
      `).bind(email).first();

    } else {

      /*
        users.id is TEXT PRIMARY KEY,
        therefore create an ID explicitly.
      */

      const newId =
        "admin-" +
        crypto.randomUUID();

      await e.PRO_DB.prepare(`
        INSERT INTO users
        (
          id,
          google_id,
          email,
          name,
          picture,
          photo_url
        )
        VALUES (?, ?, ?, ?, ?, ?)
      `).bind(
        newId,
        String(g.sub || ""),
        email,
        g.name || "",
        g.picture || "",
        g.picture || ""
      ).run();

      u = await e.PRO_DB.prepare(`
        SELECT *
        FROM users
        WHERE lower(email) = ?
        LIMIT 1
      `).bind(email).first();
    }

    if (!u) {
      return json({
        error: "Admin user could not be loaded"
      }, 500);
    }

    if (!u.id) {
      return json({
        error: "Admin user has no valid ID"
      }, 500);
    }

    /* =========================
       CREATE ADMIN SESSION
    ========================= */

    const raw =
      crypto.randomUUID() +
      crypto.randomUUID();

    const sessionId =
      await hash(raw);

    await e.PRO_DB.prepare(`
      INSERT INTO admin_sessions
      (
        id,
        user_id,
        expires_at
      )
      VALUES (
        ?,
        ?,
        datetime('now', '+30 days')
      )
    `).bind(
      sessionId,
      u.id
    ).run();

    /* =========================
       LOGIN SUCCESS
    ========================= */

    return new Response(null, {
      status: 302,
      headers: {
        Location:
          SITE + "/pro/admin.html",

        "Set-Cookie":
          cookie(raw)
      }
    });

  } catch (err) {

    console.error(
      "ADMIN CALLBACK ERROR:",
      err
    );

    return json({
      error:
        err?.message ||
        "Admin callback failed"
    }, 500);
  }
}

/* =========================
   LOGOUT
========================= */

async function logout(r, e) {

  const token = getCookie(r);

  if (token) {

    await e.PRO_DB.prepare(`
      DELETE FROM admin_sessions
      WHERE id = ?
    `).bind(
      await hash(token)
    ).run();
  }

  return new Response(null, {
    status: 302,
    headers: {
      Location:
        SITE + "/pro/admin.html",

      "Set-Cookie":
        cookie("", 0)
    }
  });
}

