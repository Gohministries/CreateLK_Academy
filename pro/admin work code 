const SITE="https://createlk.com";
const ADMIN="gateofheavensl1@gmail.com";
const COOKIE="admin_session";

const CLIENT_ID="YOUR_GOOGLE_CLIENT_ID";
const CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET";

const CORS={
  "Access-Control-Allow-Origin":SITE,
  "Access-Control-Allow-Credentials":"true",
  "Access-Control-Allow-Headers":"Content-Type",
  "Access-Control-Allow-Methods":"GET,POST,PUT,DELETE,OPTIONS"
};

const json=(x,s=200)=>new Response(JSON.stringify(x),{
  status:s,headers:{"Content-Type":"application/json",...CORS}
});

const cookie=(v,age=2592000)=>
  `${COOKIE}=${encodeURIComponent(v)}; Path=/; HttpOnly; Secure; SameSite=Lax; Max-Age=${age}`;

function getCookie(r){
  const m=(r.headers.get("Cookie")||"").match(
    new RegExp(`${COOKIE}=([^;]+)`)
  );
  return m?decodeURIComponent(m[1]):null;
}

async function hash(x){
  const b=await crypto.subtle.digest(
    "SHA-256",new TextEncoder().encode(x)
  );
  return [...new Uint8Array(b)]
    .map(x=>x.toString(16).padStart(2,"0")).join("");
}

async function admin(r,e){
  const token=getCookie(r);
  if(!token)return null;

  const row=await e.PRO_DB.prepare(`
    SELECT s.*,u.email,u.name,u.photo_url
    FROM admin_sessions s
    JOIN users u ON u.id=s.user_id
    WHERE s.id=? AND s.expires_at>datetime('now')
    LIMIT 1
  `).bind(await hash(token)).first();

  return row&&row.email.toLowerCase()===ADMIN?row:null;
}

async function auth(r,e){
  const a=await admin(r,e);
  return a||json({error:"Admin login required"},401);
}

/* LOGIN */

function login(r){
  const u=new URL(
    "https://accounts.google.com/o/oauth2/v2/auth"
  );

  u.searchParams.set("client_id",CLIENT_ID);
  u.searchParams.set(
    "redirect_uri",
    new URL("/auth/callback",r.url)
  );
  u.searchParams.set("response_type","code");
  u.searchParams.set("scope","openid email profile");
  u.searchParams.set("prompt","select_account");

  return Response.redirect(u,302);
}

async function callback(r,e){
  const code=new URL(r.url).searchParams.get("code");
  if(!code)return new Response("Missing code",{status:400});

  const redirectUri=new URL("/auth/callback",r.url).toString();

  const tr=await fetch(
    "https://oauth2.googleapis.com/token",
    {
      method:"POST",
      headers:{
        "Content-Type":
          "application/x-www-form-urlencoded"
      },
      body:new URLSearchParams({
        code,
        client_id:CLIENT_ID,
        client_secret:CLIENT_SECRET,
        redirect_uri:redirectUri,
        grant_type:"authorization_code"
      })
    }
  );

  const token=await tr.json();
  if(!token.access_token)
    return json({error:"Google login failed"},400);

  const ur=await fetch(
    "https://openidconnect.googleapis.com/v1/userinfo",
    {
      headers:{
        Authorization:`Bearer ${token.access_token}`
      }
    }
  );

  const g=await ur.json();
  const email=String(g.email||"").toLowerCase();

  if(email!==ADMIN)
    return new Response(
      "Access denied. Admin account required.",
      {status:403}
    );

  await e.PRO_DB.prepare(`
    INSERT INTO users(email,name,photo_url)
    VALUES(?,?,?)
    ON CONFLICT(email) DO UPDATE SET
    name=excluded.name,
    photo_url=excluded.photo_url
  `).bind(
    email,
    g.name||"",
    g.picture||""
  ).run();

  const u=await e.PRO_DB.prepare(`
    SELECT * FROM users WHERE email=? LIMIT 1
  `).bind(email).first();

  const raw=crypto.randomUUID()+crypto.randomUUID();

  await e.PRO_DB.prepare(`
    INSERT INTO admin_sessions(id,user_id,expires_at)
    VALUES(?,?,datetime('now','+30 days'))
  `).bind(
    await hash(raw),
    u.id
  ).run();

  return new Response(null,{
    status:302,
    headers:{
      Location:SITE+"/pro/admin.html",
      "Set-Cookie":cookie(raw)
    }
  });
}

/* LOGOUT */

async function logout(r,e){
  const t=getCookie(r);

  if(t){
    await e.PRO_DB.prepare(`
      DELETE FROM admin_sessions WHERE id=?
    `).bind(await hash(t)).run();
  }

  return new Response(null,{
    status:302,
    headers:{
      Location:SITE+"/pro/admin.html",
      "Set-Cookie":cookie("",0)
    }
  });
}

/* ME */

async function me(r,e){
  const a=await admin(r,e);

  if(!a)return json({user:null});

  return json({
    user:{
      id:a.user_id,
      email:a.email,
      name:a.name,
      photo_url:a.photo_url
    }
  });
}

/* CATEGORIES */

async function categories(r,e){
  const a=await auth(r,e);
  if(a instanceof Response)return a;

  const {results}=await e.PRO_DB.prepare(`
    SELECT * FROM categories ORDER BY name
  `).all();

  return json({categories:results||[]});
}

async function addCategory(r,e){
  const a=await auth(r,e);
  if(a instanceof Response)return a;

  const {name}=await r.json();
  if(!String(name||"").trim())
    return json({error:"Category name required"},400);

  await e.PRO_DB.prepare(`
    INSERT INTO categories(name) VALUES(?)
  `).bind(String(name).trim()).run();

  return json({ok:true});
}

/* PROMPTS */

async function prompts(r,e){
  const a=await auth(r,e);
  if(a instanceof Response)return a;

  const {results}=await e.PRO_DB.prepare(`
    SELECT p.*,c.name category_name
    FROM prompts p
    LEFT JOIN categories c ON c.id=p.category_id
    ORDER BY p.id DESC
  `).all();

  return json({
    prompts:(results||[]).map(p=>({
      ...p,
      image_url:p.image_key
        ?new URL(
          "/api/pro/images/"+encodeURIComponent(p.image_key),
          r.url
        ).toString()
        :null
    }))
  });
}

async function addPrompt(r,e){
  const a=await auth(r,e);
  if(a instanceof Response)return a;

  const b=await r.json();

  const title=String(b.title||"").trim();
  const description=String(b.description||"").trim();
  const prompt=String(b.prompt||"").trim();
  const category_id=b.category_id||null;
  const image=String(b.image||"");

  if(!title)
    return json({error:"Title required"},400);

  if(!prompt&&!image)
    return json({error:"Prompt or image required"},400);

  let image_key=null;

  if(image){
    const m=image.match(
      /^data:(image\/(?:png|jpeg|webp));base64,(.+)$/
    );

    if(!m)
      return json({error:"Invalid image"},400);

    const type=m[1];
    const bytes=Uint8Array.from(
      atob(m[2]),c=>c.charCodeAt(0)
    );

    const ext=
      type==="image/png"?"png":
      type==="image/webp"?"webp":"jpg";

    image_key=`prompts/${crypto.randomUUID()}.${ext}`;

    await e.PRO_IMAGES.put(image_key,bytes,{
      httpMetadata:{contentType:type}
    });
  }

  await e.PRO_DB.prepare(`
    INSERT INTO prompts
    (title,description,prompt,category_id,image_key)
    VALUES(?,?,?,?,?)
  `).bind(
    title,
    description,
    prompt,
    category_id,
    image_key
  ).run();

  return json({ok:true});
}

/* IMAGES */

async function image(r,e,key){
  const o=await e.PRO_IMAGES.get(key);

  if(!o)return new Response("Not found",{status:404});

  const h=new Headers();
  o.writeHttpMetadata(h);
  h.set("Cache-Control","public,max-age=31536000");

  return new Response(o.body,{headers:h});
}

/* PACKAGES */

async function packages(r,e){
  const a=await auth(r,e);
  if(a instanceof Response)return a;

  const {results}=await e.PRO_DB.prepare(`
    SELECT * FROM credit_packages ORDER BY id
  `).all();

  return json({packages:results||[]});
}

async function addPackage(r,e){
  const a=await auth(r,e);
  if(a instanceof Response)return a;

  const b=await r.json();

  const name=String(b.name||"").trim();
  const credits=Number(b.credits);
  const bonus=Number(b.bonus||0);
  const popular=b.popular?1:0;
  const active=b.active===false?0:1;

  if(!name)
    return json({error:"Package name required"},400);

  if(!Number.isInteger(credits)||credits<100)
    return json({error:"Minimum is 100 coins"},400);

  if(!Number.isInteger(bonus)||bonus<0)
    return json({error:"Invalid bonus"},400);

  await e.PRO_DB.prepare(`
    INSERT INTO credit_packages
    (name,credits,price,bonus,popular,active)
    VALUES(?,?,?,?,?,?)
  `).bind(
    name,
    credits,
    credits,
    bonus,
    popular,
    active
  ).run();

  return json({ok:true});
}

async function updatePackage(r,e,id){
  const a=await auth(r,e);
  if(a instanceof Response)return a;

  const b=await r.json();

  const name=String(b.name||"").trim();
  const credits=Number(b.credits);
  const bonus=Number(b.bonus||0);
  const popular=b.popular?1:0;
  const active=b.active?1:0;

  if(!name||!Number.isInteger(credits)||credits<100)
    return json({error:"Invalid package"},400);

  if(!Number.isInteger(bonus)||bonus<0)
    return json({error:"Invalid bonus"},400);

  await e.PRO_DB.prepare(`
    UPDATE credit_packages
    SET name=?,credits=?,price=?,bonus=?,popular=?,active=?
    WHERE id=?
  `).bind(
    name,
    credits,
    credits,
    bonus,
    popular,
    active,
    id
  ).run();

  return json({ok:true});
}

async function deletePackage(r,e,id){
  const a=await auth(r,e);
  if(a instanceof Response)return a;

  await e.PRO_DB.prepare(`
    DELETE FROM credit_packages WHERE id=?
  `).bind(id).run();

  return json({ok:true});
}

/* DEPOSITS */

async function deposits(r,e){
  const a=await auth(r,e);
  if(a instanceof Response)return a;

  const {results}=await e.PRO_DB.prepare(`
    SELECT d.*,u.name,u.email
    FROM deposits d
    LEFT JOIN users u ON u.id=d.user_id
    ORDER BY d.id DESC
  `).all();

  return json({deposits:results||[]});
}

async function depositAction(r,e,id){
  const a=await auth(r,e);
  if(a instanceof Response)return a;

  const {action}=await r.json();

  if(!["approve","reject"].includes(action))
    return json({error:"Invalid action"},400);

  const d=await e.PRO_DB.prepare(`
    SELECT * FROM deposits WHERE id=? LIMIT 1
  `).bind(id).first();

  if(!d)return json({error:"Deposit not found"},404);

  if(d.status!=="pending")
    return json({error:"Already processed"},400);

  if(action==="reject"){
    await e.PRO_DB.prepare(`
      UPDATE deposits SET status='rejected'
      WHERE id=? AND status='pending'
    `).bind(id).run();

    return json({ok:true});
  }

  const amount=Number(d.amount??d.credits??0);

  if(!Number.isInteger(amount)||amount<=0)
    return json({error:"Invalid amount"},400);

  const result=await e.PRO_DB.prepare(`
    UPDATE deposits SET status='approved'
    WHERE id=? AND status='pending'
  `).bind(id).run();

  if(!result.meta.changes)
    return json({error:"Already processed"},400);

  await e.PRO_DB.prepare(`
    UPDATE users
    SET credits=COALESCE(credits,0)+?
    WHERE id=?
  `).bind(amount,d.user_id).run();

  await e.PRO_DB.prepare(`
    INSERT INTO credit_transactions
    (user_id,amount,type,description)
    VALUES(?,?,?,?)
  `).bind(
    d.user_id,
    amount,
    "deposit",
    `Deposit #${id} approved`
  ).run();

  return json({ok:true});
}

/* ROUTER */

export default{
  async fetch(r,e){

    if(r.method==="OPTIONS")
      return new Response(null,{headers:CORS});

    const p=new URL(r.url).pathname;

    try{

      if(p==="/auth/google")
        return login(r);

      if(p==="/auth/callback")
        return callback(r,e);

      if(p==="/auth/logout")
        return logout(r,e);

      if(p==="/api/health")
        return json({ok:true});

      if(p==="/api/me")
        return me(r,e);

      if(p==="/api/pro/admin/categories"){
        if(r.method==="GET")
          return categories(r,e);
        if(r.method==="POST")
          return addCategory(r,e);
      }

      if(p==="/api/pro/admin/prompts"){
        if(r.method==="GET")
          return prompts(r,e);
        if(r.method==="POST")
          return addPrompt(r,e);
      }

      const im=p.match(
        /^\/api\/pro\/images\/(.+)$/
      );

      if(im)
        return image(
          r,e,decodeURIComponent(im[1])
        );

      if(p==="/api/pro/admin/packages"){
        if(r.method==="GET")
          return packages(r,e);
        if(r.method==="POST")
          return addPackage(r,e);
      }

      const pm=p.match(
        /^\/api\/pro\/admin\/packages\/(\d+)$/
      );

      if(pm){
        if(r.method==="PUT")
          return updatePackage(r,e,pm[1]);
        if(r.method==="DELETE")
          return deletePackage(r,e,pm[1]);
      }

      if(p==="/api/pro/admin/deposits"&&r.method==="GET")
        return deposits(r,e);

      const dm=p.match(
        /^\/api\/pro\/admin\/deposits\/(\d+)$/
      );

      if(dm&&r.method==="POST")
        return depositAction(r,e,dm[1]);

      return json({error:"Not found"},404);

    }catch(err){
      console.error(err);
      return json({
        error:err.message||"Server error"
      },500);
    }
  }
};