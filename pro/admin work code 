/* =========================
   PROMPTS
========================= */

async function prompts(r, e) {

  const a = await auth(r, e);

  if (a instanceof Response)
    return a;

  const { results } =
    await e.PRO_DB.prepare(`
      SELECT
        p.*,
        c.name AS category_name
      FROM pro_prompts p
      LEFT JOIN pro_categories c
        ON c.id = p.category_id
      ORDER BY p.id DESC
    `).all();

  return json({
    prompts: (results || []).map(p => ({
      ...p,

      image_url: p.image_key
        ? new URL(
            "/api/pro/images/" +
            encodeURIComponent(p.image_key),
            r.url
          ).toString()
        : null
    }))
  });
}

async function addPrompt(r, e) {

  const a = await auth(r, e);

  if (a instanceof Response)
    return a;

  const b = await r.json();

  const title =
    String(b.title || "").trim();

  const description =
    String(b.description || "").trim();

  const prompt =
    String(b.prompt || "").trim();

  const category_id =
    b.category_id || null;

  const image =
    String(b.image || "");

  if (!title) {
    return json({
      error: "Title required"
    }, 400);
  }

  if (!prompt && !image) {
    return json({
      error: "Prompt or image required"
    }, 400);
  }

  let image_key = null;

  /* UPLOAD IMAGE */

  if (image) {

    const m = image.match(
      /^data:(image\/(?:png|jpeg|webp));base64,(.+)$/
    );

    if (!m) {
      return json({
        error: "Invalid image"
      }, 400);
    }

    const type = m[1];

    const bytes =
      Uint8Array.from(
        atob(m[2]),
        c => c.charCodeAt(0)
      );

    const ext =
      type === "image/png"
        ? "png"
        : type === "image/webp"
          ? "webp"
          : "jpg";

    image_key =
      `prompts/${crypto.randomUUID()}.${ext}`;

    await e.PRO_IMAGES.put(
      image_key,
      bytes,
      {
        httpMetadata: {
          contentType: type
        }
      }
    );
  }

  /* INSERT PROMPT */

  await e.PRO_DB.prepare(`
    INSERT INTO pro_prompts
    (
      title,
      description,
      prompt,
      category_id,
      image_key
    )
    VALUES (?, ?, ?, ?, ?)
  `).bind(
    title,
    description,
    prompt,
    category_id,
    image_key
  ).run();

  return json({
    ok: true
  });
}

/* =========================
   IMAGES
========================= */

async function image(r, e, key) {

  const o =
    await e.PRO_IMAGES.get(key);

  if (!o) {
    return new Response(
      "Not found",
      { status: 404 }
    );
  }

  const h = new Headers();

  o.writeHttpMetadata(h);

  h.set(
    "Cache-Control",
    "public,max-age=31536000"
  );

  return new Response(
    o.body,
    {
      headers: h
    }
  );
}

/* =========================
   PACKAGES
========================= */

async function packages(r, e) {

  const a = await auth(r, e);

  if (a instanceof Response)
    return a;

  const { results } =
    await e.PRO_DB.prepare(`
      SELECT *
      FROM credit_packages
      ORDER BY id
    `).all();

  return json({
    packages: results || []
  });
}

async function addPackage(r, e) {

  const a = await auth(r, e);

  if (a instanceof Response)
    return a;

  const b = await r.json();

  const name =
    String(b.name || "").trim();

  const credits =
    Number(b.credits);

  const bonus =
    Number(b.bonus || 0);

  const popular =
    b.popular ? 1 : 0;

  const active =
    b.active === false ? 0 : 1;

  if (!name) {
    return json({
      error: "Package name required"
    }, 400);
  }

  if (
    !Number.isInteger(credits) ||
    credits < 100
  ) {
    return json({
      error: "Minimum is 100 coins"
    }, 400);
  }

  if (
    !Number.isInteger(bonus) ||
    bonus < 0
  ) {
    return json({
      error: "Invalid bonus"
    }, 400);
  }

  /*
    1 coin = LKR 1
    Therefore price is always equal to credits.
  */

  await e.PRO_DB.prepare(`
    INSERT INTO credit_packages
    (
      name,
      credits,
      price,
      bonus,
      popular,
      active
    )
    VALUES (?, ?, ?, ?, ?, ?)
  `).bind(
    name,
    credits,
    credits,
    bonus,
    popular,
    active
  ).run();

  return json({
    ok: true
  });
}

async function updatePackage(r, e, id) {

  const a = await auth(r, e);

  if (a instanceof Response)
    return a;

  const b = await r.json();

  const name =
    String(b.name || "").trim();

  const credits =
    Number(b.credits);

  const bonus =
    Number(b.bonus || 0);

  const popular =
    b.popular ? 1 : 0;

  const active =
    b.active ? 1 : 0;

  if (
    !name ||
    !Number.isInteger(credits) ||
    credits < 100
  ) {
    return json({
      error: "Invalid package"
    }, 400);
  }

  if (
    !Number.isInteger(bonus) ||
    bonus < 0
  ) {
    return json({
      error: "Invalid bonus"
    }, 400);
  }

  await e.PRO_DB.prepare(`
    UPDATE credit_packages
    SET
      name = ?,
      credits = ?,
      price = ?,
      bonus = ?,
      popular = ?,
      active = ?
    WHERE id = ?
  `).bind(
    name,
    credits,
    credits,
    bonus,
    popular,
    active,
    id
  ).run();

  return json({
    ok: true
  });
}

async function deletePackage(r, e, id) {

  const a = await auth(r, e);

  if (a instanceof Response)
    return a;

  await e.PRO_DB.prepare(`
    DELETE FROM credit_packages
    WHERE id = ?
  `).bind(id).run();

  return json({
    ok: true
  });
}

/* =========================
   DEPOSITS
========================= */

async function deposits(r, e) {

  const a = await auth(r, e);

  if (a instanceof Response)
    return a;

  const { results } =
    await e.PRO_DB.prepare(`
      SELECT
        d.*,
        u.name,
        u.email
      FROM pro_deposits d
      LEFT JOIN users u
        ON u.id = d.user_id
      ORDER BY d.id DESC
    `).all();

  return json({
    deposits: results || []
  });
}

async function depositAction(r, e, id) {

  const a = await auth(r, e);

  if (a instanceof Response)
    return a;

  const b = await r.json();

  const action = b.action;

  if (
    !["approve", "reject"].includes(action)
  ) {
    return json({
      error: "Invalid action"
    }, 400);
  }

  const d =
    await e.PRO_DB.prepare(`
      SELECT *
      FROM pro_deposits
      WHERE id = ?
      LIMIT 1
    `).bind(id).first();

  if (!d) {
    return json({
      error: "Deposit not found"
    }, 404);
  }

  if (d.status !== "pending") {
    return json({
      error: "Already processed"
    }, 400);
  }

  /* REJECT */

  if (action === "reject") {

    await e.PRO_DB.prepare(`
      UPDATE pro_deposits
      SET status = 'rejected'
      WHERE id = ?
        AND status = 'pending'
    `).bind(id).run();

    return json({
      ok: true
    });
  }

  /* APPROVE */

  const amount =
    Number(
      d.amount ??
      d.credits ??
      0
    );

  if (
    !Number.isInteger(amount) ||
    amount <= 0
  ) {
    return json({
      error: "Invalid deposit amount"
    }, 400);
  }

  const result =
    await e.PRO_DB.prepare(`
      UPDATE pro_deposits
      SET status = 'approved'
      WHERE id = ?
        AND status = 'pending'
    `).bind(id).run();

  if (!result.meta.changes) {
    return json({
      error: "Already processed"
    }, 400);
  }

  /*
    IMPORTANT:
    Your current users schema may not contain
    a credits column.

    This update is kept from your original Worker.
    If your users table does not contain credits,
    remove this UPDATE and use your actual
    pro_credits schema instead.
  */

  await e.PRO_DB.prepare(`
    UPDATE users
    SET credits = COALESCE(credits, 0) + ?
    WHERE id = ?
  `).bind(
    amount,
    d.user_id
  ).run();

  return json({
    ok: true
  });
}

/* =========================
   ROUTER
========================= */

export default {

  async fetch(r, e) {

    /* CORS PREFLIGHT */

    if (r.method === "OPTIONS") {
      return new Response(
        null,
        {
          headers: CORS
        }
      );
    }

    const p =
      new URL(r.url).pathname;

    try {

      /* GOOGLE */

      if (p === "/auth/google")
        return login(r, e);

      if (p === "/auth/callback")
        return callback(r, e);

      if (p === "/auth/logout")
        return logout(r, e);

      /* HEALTH */

      if (p === "/api/health")
        return json({
          ok: true
        });

      /* ME */

      if (p === "/api/me")
        return me(r, e);

      /* CATEGORIES */

      if (
        p === "/api/pro/admin/categories"
      ) {

        if (r.method === "GET")
          return categories(r, e);

        if (r.method === "POST")
          return addCategory(r, e);
      }

      /* PROMPTS */

      if (
        p === "/api/pro/admin/prompts"
      ) {

        if (r.method === "GET")
          return prompts(r, e);

        if (r.method === "POST")
          return addPrompt(r, e);
      }

      /* IMAGES */

      const im =
        p.match(
          /^\/api\/pro\/images\/(.+)$/
        );

      if (im) {
        return image(
          r,
          e,
          decodeURIComponent(im[1])
        );
      }

      /* PACKAGES */

      if (
        p === "/api/pro/admin/packages"
      ) {

        if (r.method === "GET")
          return packages(r, e);

        if (r.method === "POST")
          return addPackage(r, e);
      }

      const pm =
        p.match(
          /^\/api\/pro\/admin\/packages\/(\d+)$/
        );

      if (pm) {

        if (r.method === "PUT") {
          return updatePackage(
            r,
            e,
            pm[1]
          );
        }

        if (r.method === "DELETE") {
          return deletePackage(
            r,
            e,
            pm[1]
          );
        }
      }

      /* DEPOSITS */

      if (
        p === "/api/pro/admin/deposits" &&
        r.method === "GET"
      ) {
        return deposits(r, e);
      }

      const dm =
        p.match(
          /^\/api\/pro\/admin\/deposits\/(\d+)$/
        );

      if (
        dm &&
        r.method === "POST"
      ) {
        return depositAction(
          r,
          e,
          dm[1]
        );
      }

      /* NOT FOUND */

      return json({
        error: "Not found"
      }, 404);

    } catch (err) {

      console.error(
        "WORKER ERROR:",
        err
      );

      return json({
        error:
          err?.message ||
          "Server error"
      }, 500);
    }
  }
};