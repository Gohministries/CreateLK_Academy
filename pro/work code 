const SITE="https://createlk.com";
const COST=10;
const MIN=100;
const DAYS=30;

export default{async fetch(req,env){
 const u=new URL(req.url),p=u.pathname;

 if(req.method==="OPTIONS")
  return cors(new Response(null,{status:204}));

 try{
  if(p==="/api/health")
   return out({ok:true,service:"CreateLK Pro"});

  if(p==="/auth/google")
   return login(u,env);

  if(p==="/auth/callback")
   return callback(req,u,env);

  if(p==="/auth/logout")
   return logout(req,env);

  if(p==="/api/me")
   return me(req,env);

  if(p==="/api/pro/categories")
   return cats(env);

  if(p==="/api/pro/prompts")
   return prompts(u,env);

  let m=p.match(/^\/api\/pro\/prompts\/(\d+)$/);

  if(m)
   return detail(+m[1],env);

  m=p.match(/^\/api\/pro\/prompts\/(\d+)\/copy$/);

  if(m&&req.method==="POST")
   return copy(req,env,+m[1]);

  if(p==="/api/pro/credits/balance")
   return balance(req,env);

  if(p==="/api/pro/credits/deposit"&&req.method==="POST")
   return deposit(req,env);

  if(p==="/api/pro/credits/deposits")
   return deposits(req,env);

  if(p==="/api/pro/credits/transactions")
   return transactions(req,env);

  if(p==="/api/pro/deposit/receipt")
   return receipt(req,u,env);

  if(p.startsWith("/api/pro/admin/"))
   return admin(req,u,env);

  if(p.startsWith("/pro/images/"))
   return image(p,env);

  return out({error:"Not found"},404);

 }catch(e){
  console.error(e);
  return out({error:"Server error"},500);
 }
}};

/* BASIC */

function cors(r){
 const h=new Headers(r.headers);

 h.set("Access-Control-Allow-Origin",SITE);
 h.set("Access-Control-Allow-Credentials","true");
 h.set(
  "Access-Control-Allow-Methods",
  "GET,POST,PUT,DELETE,OPTIONS"
 );
 h.set(
  "Access-Control-Allow-Headers",
  "Content-Type"
 );

 return new Response(r.body,{
  status:r.status,
  headers:h
 });
}

function out(d,s=200){
 return cors(new Response(
  JSON.stringify(d),
  {
   status:s,
   headers:{
    "Content-Type":"application/json",
    "Cache-Control":"no-store"
   }
  }
 ));
}

function ck(req,n){
 const x=(req.headers.get("Cookie")||"")
  .split(";")
  .find(x=>x.trim().startsWith(n+"="));

 return x
  ?x.split("=").slice(1).join("=").trim()
  :null;
}

function setck(n,v,a){
 return `${n}=${v}; Path=/; HttpOnly; Secure; SameSite=None; Max-Age=${a}`;
}

function delck(n){
 return setck(n,"",0);
}

async function hash(v){
 const b=await crypto.subtle.digest(
  "SHA-256",
  new TextEncoder().encode(v)
 );

 return [...new Uint8Array(b)]
  .map(x=>x.toString(16).padStart(2,"0"))
  .join("");
}

function rnd(n=32){
 const b=new Uint8Array(n);
 crypto.getRandomValues(b);

 return [...b]
  .map(x=>x.toString(16).padStart(2,"0"))
  .join("");
}

/* GOOGLE LOGIN */

function login(u,env){
 const state=rnd(16);

 const g=new URL(
  "https://accounts.google.com/o/oauth2/v2/auth"
 );

 g.searchParams.set(
  "client_id",
  env.GOOGLE_CLIENT_ID
 );

 g.searchParams.set(
  "redirect_uri",
  u.origin+"/auth/callback"
 );

 g.searchParams.set(
  "response_type",
  "code"
 );

 g.searchParams.set(
  "scope",
  "openid email profile"
 );

 g.searchParams.set(
  "state",
  state
 );

 const r=new Response(null,{
  status:302,
  headers:{
   Location:g.toString()
  }
 });

 r.headers.append(
  "Set-Cookie",
  setck("pro_oauth_state",state,600)
 );

 return cors(r);
}

async function callback(req,u,env){
 const code=u.searchParams.get("code");
 const state=u.searchParams.get("state");

 if(
  !code||
  state!==ck(req,"pro_oauth_state")
 )
  return out({
   error:"Invalid Google login"
  },400);

 const redirect=
  u.origin+"/auth/callback";

 const tr=await fetch(
  "https://oauth2.googleapis.com/token",
  {
   method:"POST",
   headers:{
    "Content-Type":
     "application/x-www-form-urlencoded"
   },
   body:new URLSearchParams({
    client_id:env.GOOGLE_CLIENT_ID,
    client_secret:env.GOOGLE_CLIENT_SECRET,
    code,
    redirect_uri:redirect,
    grant_type:"authorization_code"
   })
  }
 );

 const token=await tr.json();

 if(!token.access_token)
  return out({
   error:"Google token failed"
  },400);

 const gr=await fetch(
  "https://openidconnect.googleapis.com/v1/userinfo",
  {
   headers:{
    Authorization:
     `Bearer ${token.access_token}`
   }
  }
 );

 const g=await gr.json();

 if(!g.email)
  return out({
   error:"Google account unavailable"
  },400);

 const email=g.email.toLowerCase();

 let user=await env.PRO_DB.prepare(`
  SELECT *
  FROM users
  WHERE google_id=? OR email=?
  LIMIT 1
 `).bind(
  String(g.sub),
  email
 ).first();

 if(!user){
  const ref=
   "CLP"+
   rnd(5).slice(0,8).toUpperCase();

  const r=await env.PRO_DB.prepare(`
   INSERT INTO users
   (google_id,name,email,photo_url,referral_code)
   VALUES (?,?,?,?,?)
  `).bind(
   String(g.sub),
   g.name||email.split("@")[0],
   email,
   g.picture||null,
   ref
  ).run();

  user=await env.PRO_DB.prepare(`
   SELECT *
   FROM users
   WHERE id=?
  `).bind(
   r.meta.last_row_id
  ).first();

 }else{

  await env.PRO_DB.prepare(`
   UPDATE users
   SET google_id=?,name=?,photo_url=?
   WHERE id=?
  `).bind(
   String(g.sub),
   g.name||user.name,
   g.picture||user.photo_url,
   user.id
  ).run();
 }

 await env.PRO_DB.prepare(`
  INSERT OR IGNORE INTO pro_credits
  (user_id,credits)
  VALUES (?,0)
 `).bind(user.id).run();

 const session=rnd(32);

 const expires=new Date(
  Date.now()+DAYS*86400000
 ).toISOString();

 await env.PRO_DB.prepare(`
  INSERT INTO sessions
  (session_token_hash,user_id,expires_at)
  VALUES (?,?,?)
 `).bind(
  await hash(session),
  user.id,
  expires
 ).run();

 const r=new Response(null,{
  status:302,
  headers:{
   Location:SITE+"/pro/"
  }
 });

 r.headers.append(
  "Set-Cookie",
  setck(
   "pro_session",
   session,
   DAYS*86400
  )
 );

 r.headers.append(
  "Set-Cookie",
  delck("pro_oauth_state")
 );

 return cors(r);
}

/* USER */

async function user(req,env){
 const s=ck(req,"pro_session");

 if(!s)
  return null;

 return env.PRO_DB.prepare(`
  SELECT u.*
  FROM sessions s
  JOIN users u
   ON u.id=s.user_id
  WHERE s.session_token_hash=?
  AND s.expires_at>CURRENT_TIMESTAMP
  LIMIT 1
 `).bind(
  await hash(s)
 ).first();
}

async function me(req,env){
 const u=await user(req,env);

 if(!u)
  return out({
   logged_in:false,
   user:null,
   credits:0
  });

 const c=await env.PRO_DB.prepare(`
  SELECT credits
  FROM pro_credits
  WHERE user_id=?
 `).bind(u.id).first();

 return out({
  logged_in:true,
  user:{
   id:u.id,
   name:u.name,
   email:u.email,
   photo_url:u.photo_url,
   referral_code:u.referral_code
  },
  credits:Number(c?.credits||0)
 });
}

async function logout(req,env){
 const s=ck(req,"pro_session");

 if(s){
  await env.PRO_DB.prepare(`
   DELETE FROM sessions
   WHERE session_token_hash=?
  `).bind(
   await hash(s)
  ).run();
 }

 const r=out({ok:true});

 r.headers.append(
  "Set-Cookie",
  delck("pro_session")
 );

 return r;
}

