const SITE="https://createlk.com";
const COST=10,MIN=100,DAYS=30;

function json(x,s=200){
  return new Response(JSON.stringify(x),{
    status:s,
    headers:{"Content-Type":"application/json"}
  });
}

function cors(r){
  const h=new Headers(r.headers);
  h.set("Access-Control-Allow-Origin",SITE);
  h.set("Access-Control-Allow-Credentials","true");
  h.set("Access-Control-Allow-Methods","GET,POST,PUT,DELETE,OPTIONS");
  h.set("Access-Control-Allow-Headers","Content-Type,Authorization");
  return new Response(r.body,{status:r.status,headers:h});
}

function out(x,s=200){return cors(json(x,s));}

function rnd(n=16){
  const a=new Uint8Array(n);
  crypto.getRandomValues(a);
  return [...a].map(x=>x.toString(16).padStart(2,"0")).join("");
}

async function hash(x){
  const b=await crypto.subtle.digest(
    "SHA-256",
    new TextEncoder().encode(x)
  );
  return [...new Uint8Array(b)]
    .map(x=>x.toString(16).padStart(2,"0"))
    .join("");
}

function cookie(n,v,max){
  return `${n}=${encodeURIComponent(v)}; Path=/; HttpOnly; Secure; SameSite=None; Max-Age=${max}`;
}

function delcookie(n){
  return `${n}=; Path=/; HttpOnly; Secure; SameSite=None; Max-Age=0`;
}

function ck(req,n){
  const c=req.headers.get("Cookie")||"";
  const x=c.split(";").find(x=>x.trim().startsWith(n+"="));
  return x?decodeURIComponent(x.trim().slice(n.length+1)):null;
}

async function getUser(req,env){
  const s=ck(req,"pro_session");
  if(!s)return null;

  return await env.PRO_DB.prepare(`
    SELECT u.*
    FROM sessions s
    JOIN users u ON u.id=s.user_id
    WHERE s.session_token_hash=?
      AND s.expires_at>datetime('now')
    LIMIT 1
  `).bind(await hash(s)).first();
}

/* GOOGLE LOGIN */

function googleLogin(u,env){
  const state=rnd(16);

  const g=new URL(
    "https://accounts.google.com/o/oauth2/v2/auth"
  );

  g.searchParams.set(
    "client_id",
    String(env.GOOGLE_CLIENT_ID||"")
  );

  g.searchParams.set(
    "redirect_uri",
    u.origin+"/auth/callback"
  );

  g.searchParams.set("response_type","code");

  g.searchParams.set(
    "scope",
    "openid email profile"
  );

  g.searchParams.set("state",state);

  const r=new Response(null,{
    status:302,
    headers:{Location:g.toString()}
  });

  r.headers.append(
    "Set-Cookie",
    cookie("pro_oauth_state",state,600)
  );

  return cors(r);
}

/* GOOGLE CALLBACK */

async function googleCallback(req,u,env){
  const code=u.searchParams.get("code");
  const state=u.searchParams.get("state");

  if(!code||state!==ck(req,"pro_oauth_state"))
    return out({error:"Invalid Google login"},400);

  const clientId=String(env.GOOGLE_CLIENT_ID||"");
  const clientSecret=String(env.GOOGLE_CLIENT_SECRET||"");
  const redirect=u.origin+"/auth/callback";

  if(!clientId||!clientSecret){
    return out({
      error:"Google OAuth configuration missing",
      client_id_present:!!clientId,
      client_secret_present:!!clientSecret
    },500);
  }

  const tr=await fetch(
    "https://oauth2.googleapis.com/token",
    {
      method:"POST",
      headers:{
        "Content-Type":
          "application/x-www-form-urlencoded"
      },
      body:new URLSearchParams({
        client_id:clientId,
        client_secret:clientSecret,
        code,
        redirect_uri:redirect,
        grant_type:"authorization_code"
      })
    }
  );

  const token=await tr.json();

  if(!tr.ok||!token.access_token){
    console.error("GOOGLE TOKEN ERROR",token);

    return out({
      error:"Google token failed",
      google_error:token.error||null,
      google_description:
        token.error_description||null
    },400);
  }

  const gr=await fetch(
    "https://openidconnect.googleapis.com/v1/userinfo",
    {
      headers:{
        Authorization:
          `Bearer ${token.access_token}`
      }
    }
  );

  const g=await gr.json();

  if(!gr.ok||!g.email){
    console.error("GOOGLE USER ERROR",g);

    return out({
      error:"Google account unavailable",
      google_error:g.error||null
    },400);
  }

  const email=g.email.toLowerCase();

  let usr=await env.PRO_DB.prepare(`
    SELECT *
    FROM users
    WHERE google_id=? OR email=?
    LIMIT 1
  `).bind(
    String(g.sub),
    email
  ).first();

  /*
    NEW USER
    users.id is TEXT, so we generate the ID ourselves.
  */

  if(!usr){

    const userId=crypto.randomUUID();

    const ref=
      "CLP"+rnd(5).slice(0,8).toUpperCase();

    await env.PRO_DB.prepare(`
      INSERT INTO users
      (id,google_id,name,email,photo_url,referral_code)
      VALUES (?,?,?,?,?,?)
    `).bind(
      userId,
      String(g.sub),
      g.name||email.split("@")[0],
      email,
      g.picture||null,
      ref
    ).run();

    usr=await env.PRO_DB.prepare(`
      SELECT *
      FROM users
      WHERE id=?
      LIMIT 1
    `).bind(userId).first();

  }else{

    await env.PRO_DB.prepare(`
      UPDATE users
      SET google_id=?,name=?,photo_url=?
      WHERE id=?
    `).bind(
      String(g.sub),
      g.name||usr.name,
      g.picture||usr.photo_url,
      usr.id
    ).run();

  }

  if(!usr){
    return out({
      error:"User creation failed"
    },500);
  }

  await env.PRO_DB.prepare(`
    INSERT OR IGNORE INTO pro_credits
    (user_id,credits)
    VALUES (?,0)
  `).bind(usr.id).run();

  const session=rnd(32);

  const expires=new Date(
    Date.now()+DAYS*86400000
  ).toISOString();

  await env.PRO_DB.prepare(`
    INSERT INTO sessions
    (session_token_hash,user_id,expires_at)
    VALUES (?,?,?)
  `).bind(
    await hash(session),
    usr.id,
    expires
  ).run();

  const r=new Response(null,{
    status:302,
    headers:{
      Location:SITE+"/pro/"
    }
  });

  r.headers.append(
    "Set-Cookie",
    cookie(
      "pro_session",
      session,
      DAYS*86400
    )
  );

  r.headers.append(
    "Set-Cookie",
    delcookie("pro_oauth_state")
  );

  return cors(r);
}

