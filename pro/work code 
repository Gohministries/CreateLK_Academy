/* ADMIN PROMPTS */

async function adminPrompts(req,env){
  const u=await getUser(req,env);

  if(!isAdmin(u,env))
    return out({error:"Forbidden"},403);

  if(req.method==="GET"){
    const r=await env.PRO_DB.prepare(`
      SELECT p.*,c.name category_name
      FROM pro_prompts p
      LEFT JOIN pro_categories c
        ON c.id=p.category_id
      ORDER BY p.id DESC
    `).all();

    return out({
      prompts:(r.results||[]).map(p=>({
        ...p,
        image_url:imageUrl(p.image_key)
      }))
    });
  }

  const d=await req.json();

  const title=String(d.title||"").trim();
  const description=String(d.description||"").trim();
  const prompt=String(d.prompt||"").trim();
  const image=String(d.image||"");
  const category=d.category_id
    ? Number(d.category_id)
    : null;

  if(!title)
    return out({error:"Title is required"},400);

  if(!prompt&&!image)
    return out({
      error:"Add prompt text or image"
    },400);

  let key=null;

  if(image){
    const m=image.match(
      /^data:(image\/(?:png|jpeg|jpg|webp));base64,(.+)$/i
    );

    if(!m)
      return out({
        error:"Invalid prompt image"
      },400);

    const type=m[1].replace("image/jpg","image/jpeg");
    const raw=atob(m[2]);
    const bytes=new Uint8Array(raw.length);

    for(let i=0;i<raw.length;i++)
      bytes[i]=raw.charCodeAt(i);

    const ext=
      type==="image/png"?"png":
      type==="image/webp"?"webp":"jpg";

    key=`prompts/${rnd(16)}.${ext}`;

    await env.PRO_IMAGES.put(key,bytes,{
      httpMetadata:{contentType:type}
    });
  }

  const r=await env.PRO_DB.prepare(`
    INSERT INTO pro_prompts
    (category_id,title,description,prompt,image_key)
    VALUES (?,?,?,?,?)
  `).bind(
    category,
    title,
    description,
    prompt||null,
    key
  ).run();

  return out({
    ok:true,
    id:r.meta.last_row_id,
    image_url:imageUrl(key)
  });
}


