/* ADMIN APPROVE / REJECT */

async function adminDepositAction(req,id,env){
  const u=await getUser(req,env);

  if(!isAdmin(u,env))
    return out({error:"Forbidden"},403);

  const d=await req.json();
  const action=String(d.action||"").toLowerCase();

  if(!["approve","reject"].includes(action))
    return out({
      error:"Action must be approve or reject"
    },400);

  const dep=await env.PRO_DB.prepare(`
    SELECT * FROM pro_deposits
    WHERE id=? LIMIT 1
  `).bind(id).first();

  if(!dep)
    return out({error:"Deposit not found"},404);

  if(dep.status!=="pending")
    return out({
      error:"Deposit already processed"
    },400);

  if(action==="reject"){

    await env.PRO_DB.prepare(`
      UPDATE pro_deposits
      SET status='rejected'
      WHERE id=?
    `).bind(id).run();

    return out({
      ok:true,
      status:"rejected"
    });
  }

  await env.PRO_DB.prepare(`
    INSERT OR IGNORE INTO pro_credits
    (user_id,credits)
    VALUES (?,0)
  `).bind(dep.user_id).run();

  await env.PRO_DB.prepare(`
    UPDATE pro_credits
    SET
      credits=credits+?,
      updated_at=CURRENT_TIMESTAMP
    WHERE user_id=?
  `).bind(
    dep.amount,
    dep.user_id
  ).run();

  await env.PRO_DB.prepare(`
    UPDATE pro_deposits
    SET status='approved'
    WHERE id=?
  `).bind(id).run();

  await env.PRO_DB.prepare(`
    INSERT INTO pro_transactions
    (user_id,type,amount,description)
    VALUES (?,?,?,?)
  `).bind(
    dep.user_id,
    "credit",
    dep.amount,
    `Deposit #${id} approved`
  ).run();

  return out({
    ok:true,
    status:"approved",
    credited:dep.amount
  });
}


/* ROUTER */

export default{
  async fetch(req,env){

    try{

      if(req.method==="OPTIONS")
        return cors(
          new Response(null,{status:204})
        );

      const url=new URL(req.url);
      const p=url.pathname.replace(/\/+$/,"")||"/";

      if(p==="/api/health")
        return out({
          ok:true,
          service:"CreateLK Pro"
        });

      if(p==="/auth/google")
        return googleLogin(url,env);

      if(p==="/auth/callback")
        return googleCallback(req,url,env);

      if(p==="/auth/logout"){

        const s=getCookie(req,"pro_session");

        if(s)
          await env.PRO_DB.prepare(`
            DELETE FROM sessions
            WHERE session_token_hash=?
          `).bind(await hash(s)).run();

        const r=new Response(null,{
          status:302,
          headers:{Location:SITE+"/pro/"}
        });

        r.headers.append(
          "Set-Cookie",
          delCookie("pro_session")
        );

        return cors(r);
      }

      if(p==="/api/me")
        return me(req,env);

      if(p==="/api/pro/categories")
        return categories(env);

      if(p==="/api/pro/prompts")
        return prompts(req,env);

      let m=p.match(
        /^\/api\/pro\/prompts\/(\d+)$/
      );

      if(m)
        return getPrompt(m[1],env);

      m=p.match(
        /^\/api\/pro\/prompts\/(\d+)\/copy$/
      );

      if(m&&req.method==="POST")
        return copyPrompt(req,m[1],env);

      if(p==="/api/pro/credits/balance")
        return balance(req,env);

      if(p==="/api/pro/credits/deposit")
        return createDeposit(req,env);

      if(p==="/api/pro/credits/deposits")
        return userDeposits(req,env);

      if(p==="/api/pro/credits/transactions")
        return transactions(req,env);

      if(p==="/api/pro/deposit/receipt")
        return uploadReceipt(req,env);

      if(p.startsWith("/api/pro/images/"))
        return imageRoute(
          env,
          decodeURIComponent(
            p.slice("/api/pro/images/".length)
          )
        );

      if(p==="/api/pro/admin/categories")
        return adminCategories(req,env);

      if(p==="/api/pro/admin/prompts")
        return adminPrompts(req,env);

      if(
        p==="/api/pro/admin/deposits" &&
        req.method==="GET"
      )
        return adminDeposits(req,env);

      m=p.match(
        /^\/api\/pro\/admin\/deposits\/(\d+)$/
      );

      if(m&&req.method==="POST")
        return adminDepositAction(
          req,
          m[1],
          env
        );

      return out({error:"Not found"},404);

    }catch(e){

      console.error(e);

      return out({
        error:"Server error",
        message:e?.message||String(e)
      },500);
    }
  }
};