const SITE = "https://createlk.com";
const COPY_COST = 10;
const MIN_DEPOSIT = 100;
const COOKIE = "pro_session";
const SESSION_DAYS = 30;

export default {
  async fetch(request, env) {
    const url = new URL(request.url);
    const path = url.pathname;

    if (request.method === "OPTIONS")
      return cors(new Response(null, { status: 204 }));

    try {
      if (path === "/auth/google")
        return googleLogin(url, env);

      if (path === "/auth/callback")
        return await googleCallback(url, env);

      if (path === "/auth/logout")
        return await logout(request, env);

      if (path === "/api/me")
        return await me(request, env);

      if (path === "/api/pro/categories")
        return await categories(env);

      if (path === "/api/pro/prompts")
        return await prompts(url, env);

      const copy = path.match(
        /^\/api\/pro\/prompts\/(\d+)\/copy$/
      );
      if (copy)
        return await copyPrompt(request, env, Number(copy[1]));

      if (path.match(/^\/api\/pro\/prompts\/\d+$/))
        return await promptDetails(path, env);

      if (path === "/api/pro/credits/balance")
        return await balance(request, env);

      if (path === "/api/pro/credits/deposit")
        return await createDeposit(request, env);

      if (path === "/api/pro/credits/deposits")
        return await deposits(request, env);

      if (path === "/api/pro/credits/transactions")
        return await transactions(request, env);

      if (path === "/api/pro/deposit/receipt")
        return await receipt(request, url, env);

      if (path.startsWith("/api/pro/admin/"))
        return await admin(request, url, env);

      if (path.startsWith("/pro/images/"))
        return await image(request, path, env);

      return json({ error: "Not found" }, 404);

    } catch (e) {
      return json({ error: e.message }, 500);
    }
  }
};

/* LOGIN */

function googleLogin(url, env) {
  const state = crypto.randomUUID();

  const q = new URLSearchParams({
    client_id: env.GOOGLE_CLIENT_ID,
    redirect_uri: `${url.origin}/auth/callback`,
    response_type: "code",
    scope: "openid email profile",
    state,
    prompt: "select_account"
  });

  return Response.redirect(
    "https://accounts.google.com/o/oauth2/v2/auth?" + q,
    302
  );
}

async function googleCallback(url, env) {
  const code = url.searchParams.get("code");
  if (!code) return json({ error: "Missing code" }, 400);

  const r = await fetch(
    "https://oauth2.googleapis.com/token",
    {
      method: "POST",
      headers: {
        "Content-Type":
          "application/x-www-form-urlencoded"
      },
      body: new URLSearchParams({
        code,
        client_id: env.GOOGLE_CLIENT_ID,
        client_secret: env.GOOGLE_CLIENT_SECRET,
        redirect_uri: `${url.origin}/auth/callback`,
        grant_type: "authorization_code"
      })
    }
  );

  const token = await r.json();

  if (!token.access_token)
    return json({ error: "Google login failed" }, 400);

  const g = await (
    await fetch(
      "https://openidconnect.googleapis.com/v1/userinfo",
      {
        headers: {
          Authorization:
            `Bearer ${token.access_token}`
        }
      }
    )
  ).json();

  if (!g.sub || !g.email)
    return json({ error: "Invalid Google account" }, 400);

  let user = await env.PRO_DB.prepare(
    `SELECT * FROM users
     WHERE google_id = ? OR email = ?
     LIMIT 1`
  ).bind(g.sub, g.email).first();

  if (!user) {
    const referral =
      "PRO" +
      crypto.randomUUID()
        .replace(/-/g, "")
        .slice(0, 8)
        .toUpperCase();

    const x = await env.PRO_DB.prepare(
      `INSERT INTO users
       (google_id,name,email,photo_url,referral_code)
       VALUES (?,?,?,?,?)`
    ).bind(
      g.sub,
      g.name || "",
      g.email,
      g.picture || "",
      referral
    ).run();

    user = await env.PRO_DB.prepare(
      `SELECT * FROM users WHERE id = ?`
    ).bind(x.meta.last_row_id).first();

  } else {
    await env.PRO_DB.prepare(
      `UPDATE users
       SET google_id=?,name=?,photo_url=?
       WHERE id=?`
    ).bind(
      g.sub,
      g.name || user.name || "",
      g.picture || user.photo_url || "",
      user.id
    ).run();
  }

  await env.PRO_DB.prepare(
    `INSERT OR IGNORE INTO pro_credits
     (user_id,credits) VALUES (?,0)`
  ).bind(user.id).run();

  const session =
    crypto.randomUUID() + crypto.randomUUID();

  const hash = await sha256(session);

  const expires = new Date(
    Date.now() + SESSION_DAYS * 86400000
  ).toISOString();

  await env.PRO_DB.prepare(
    `INSERT INTO sessions
     (session_token_hash,user_id,expires_at)
     VALUES (?,?,?)`
  ).bind(hash, user.id, expires).run();

  return new Response(null, {
    status: 302,
    headers: {
      Location: `${SITE}/pro/`,
      "Set-Cookie":
        `${COOKIE}=${session}; Path=/; HttpOnly; Secure; SameSite=None; Max-Age=${SESSION_DAYS * 86400}`
    }
  });
}

async function logout(request, env) {
  const token = cookie(request, COOKIE);

  if (token) {
    await env.PRO_DB.prepare(
      `DELETE FROM sessions
       WHERE session_token_hash=?`
    ).bind(await sha256(token)).run();
  }

  return new Response(null, {
    status: 302,
    headers: {
      Location: `${SITE}/pro/`,
      "Set-Cookie":
        `${COOKIE}=; Path=/; HttpOnly; Secure; SameSite=None; Max-Age=0`
    }
  });
}

/* USER */

async function me(request, env) {
  const user = await auth(request, env);

  if (!user)
    return json({ logged_in: false });

  const c = await env.PRO_DB.prepare(
    `SELECT credits FROM pro_credits WHERE user_id=?`
  ).bind(user.id).first();

  return json({
    logged_in: true,
    user,
    credits: c?.credits || 0
  });
}

/* CATEGORIES */

async function categories(env) {
  const r = await env.PRO_DB.prepare(
    `SELECT c.id,c.name,
     COUNT(p.id) prompt_count
     FROM pro_categories c
     LEFT JOIN pro_prompts p
     ON p.category_id=c.id AND p.active=1
     WHERE c.active=1
     GROUP BY c.id
     ORDER BY c.id`
  ).all();

  return json(r.results);
}

/* PROMPTS */

async function prompts(url, env) {
  const category = url.searchParams.get("category");
  const search = url.searchParams.get("search") || "";

  const limit = Math.min(
    Math.max(Number(url.searchParams.get("limit") || 24), 1),
    100
  );

  const offset = Math.max(
    Number(url.searchParams.get("offset") || 0),
    0
  );

  let sql = `
    SELECT p.id,p.category_id,
    c.name category_name,
    p.title,p.description,p.image_url,p.created_at
    FROM pro_prompts p
    LEFT JOIN pro_categories c
    ON c.id=p.category_id
    WHERE p.active=1
  `;

  const v = [];

  if (category) {
    sql += ` AND p.category_id=?`;
    v.push(category);
  }

  if (search) {
    sql += `
      AND (
        p.title LIKE ?
        OR p.description LIKE ?
        OR c.name LIKE ?
      )
    `;
    const s = `%${search}%`;
    v.push(s, s, s);
  }

  sql += ` ORDER BY p.id DESC LIMIT ? OFFSET ?`;
  v.push(limit, offset);

  const r = await env.PRO_DB
    .prepare(sql)
    .bind(...v)
    .all();

  return json(r.results);
}

async function promptDetails(path, env) {
  const id = path.match(/\d+$/)[0];

  const p = await env.PRO_DB.prepare(
    `SELECT p.id,p.category_id,
     c.name category_name,
     p.title,p.description,p.image_url,p.created_at
     FROM pro_prompts p
     LEFT JOIN pro_categories c
     ON c.id=p.category_id
     WHERE p.id=? AND p.active=1`
  ).bind(id).first();

  return p
    ? json(p)
    : json({ error: "Prompt not found" }, 404);
}

/* COPY */

async function copyPrompt(request, env, id) {
  const user = await auth(request, env);

  if (!user)
    return json({ error: "Login required" }, 401);

  const p = await env.PRO_DB.prepare(
    `SELECT id,title,prompt
     FROM pro_prompts
     WHERE id=? AND active=1`
  ).bind(id).first();

  if (!p)
    return json({ error: "Prompt not found" }, 404);

  const c = await env.PRO_DB.prepare(
    `SELECT credits FROM pro_credits WHERE user_id=?`
  ).bind(user.id).first();

  const balance = c?.credits || 0;

  if (balance < COPY_COST)
    return json({
      error: "Insufficient credits",
      required: COPY_COST,
      balance
    }, 400);

  const n = balance - COPY_COST;

  await env.PRO_DB.prepare(
    `UPDATE pro_credits
     SET credits=?,updated_at=CURRENT_TIMESTAMP
     WHERE user_id=?`
  ).bind(n, user.id).run();

  await env.PRO_DB.prepare(
    `INSERT INTO pro_transactions
     (user_id,type,credits,reference)
     VALUES (?,?,?,?)`
  ).bind(
    user.id,
    "copy",
    -COPY_COST,
    `prompt:${id}`
  ).run();

  await env.PRO_DB.prepare(
    `INSERT INTO pro_copy_logs
     (user_id,prompt_id,credits)
     VALUES (?,?,?)`
  ).bind(user.id, id, COPY_COST).run();

  return json({
    success: true,
    title: p.title,
    prompt: p.prompt,
    credits_used: COPY_COST,
    balance: n
  });
}

/* CREDITS */

async function balance(request, env) {
  const user = await auth(request, env);

  if (!user)
    return json({ error: "Login required" }, 401);

  const c = await env.PRO_DB.prepare(
    `SELECT credits FROM pro_credits WHERE user_id=?`
  ).bind(user.id).first();

  return json({ credits: c?.credits || 0 });
}

async function createDeposit(request, env) {
  const user = await auth(request, env);

  if (!user)
    return json({ error: "Login required" }, 401);

  const b = await request.json();
  const amount = Number(b.amount);
  const reference = String(b.reference || "").trim();

  if (!Number.isInteger(amount) || amount < MIN_DEPOSIT)
    return json({
      error: `Minimum deposit is Rs.${MIN_DEPOSIT}`
    }, 400);

  const r = await env.PRO_DB.prepare(
    `INSERT INTO pro_deposits
     (user_id,amount,reference,status)
     VALUES (?,?,?,'pending')`
  ).bind(
    user.id,
    amount,
    reference
  ).run();

  return json({
    success: true,
    deposit_id: r.meta.last_row_id,
    status: "pending"
  });
}

async function deposits(request, env) {
  const user = await auth(request, env);

  if (!user)
    return json({ error: "Login required" }, 401);

  const r = await env.PRO_DB.prepare(
    `SELECT id,amount,reference,status,
     receipt_key,created_at,approved_at
     FROM pro_deposits
     WHERE user_id=?
     ORDER BY id DESC`
  ).bind(user.id).all();

  return json(r.results);
}

async function transactions(request, env) {
  const user = await auth(request, env);

  if (!user)
    return json({ error: "Login required" }, 401);

  const r = await env.PRO_DB.prepare(
    `SELECT id,type,credits,reference,created_at
     FROM pro_transactions
     WHERE user_id=?
     ORDER BY id DESC
     LIMIT 100`
  ).bind(user.id).all();

  return json(r.results);
}

/* RECEIPT */

async function receipt(request, url, env) {
  const user = await auth(request, env);

  if (!user)
    return json({ error: "Login required" }, 401);

  const id = url.searchParams.get("deposit_id");

  if (!id)
    return json({ error: "Missing deposit_id" }, 400);

  const d = await env.PRO_DB.prepare(
    `SELECT id FROM pro_deposits
     WHERE id=? AND user_id=?`
  ).bind(id, user.id).first();

  if (!d)
    return json({ error: "Deposit not found" }, 404);

  const type =
    request.headers.get("content-type") || "";

  if (!type.startsWith("image/"))
    return json({ error: "Image required" }, 400);

  const key =
    `receipts/${user.id}/${id}-${crypto.randomUUID()}`;

  await env.PRO_IMAGES.put(
    key,
    request.body,
    {
      httpMetadata: {
        contentType: type
      }
    }
  );

  await env.PRO_DB.prepare(
    `UPDATE pro_deposits
     SET receipt_key=?
     WHERE id=? AND user_id=?`
  ).bind(key, id, user.id).run();

  return json({
    success: true,
    receipt_key: key
  });
}

/* ADMIN */

async function admin(request, url, env) {
  const user = await auth(request, env);

  if (!user)
    return json({ error: "Login required" }, 401);

  const admins = String(
    env.PRO_ADMIN_EMAILS || ""
  ).split(",")
   .map(x => x.trim().toLowerCase());

  if (!admins.includes(
    String(user.email).toLowerCase()
  ))
    return json({ error: "Admin access required" }, 403);

  const path = url.pathname;

  if (
    path === "/api/pro/admin/categories" &&
    request.method === "GET"
  ) {
    const r = await env.PRO_DB.prepare(
      `SELECT c.id,c.name,c.active,
       COUNT(p.id) prompt_count
       FROM pro_categories c
       LEFT JOIN pro_prompts p
       ON p.category_id=c.id
       GROUP BY c.id
       ORDER BY c.id`
    ).all();

    return json(r.results);
  }

  if (
    path === "/api/pro/admin/categories" &&
    request.method === "POST"
  ) {
    const b = await request.json();

    await env.PRO_DB.prepare(
      `INSERT INTO pro_categories(name)
       VALUES (?)`
    ).bind(String(b.name || "").trim()).run();

    return json({ success: true });
  }

  if (
    path === "/api/pro/admin/prompts" &&
    request.method === "POST"
  ) {
    const b = await request.json();

    if (!b.title || !b.prompt)
      return json({
        error: "Title and prompt required"
      }, 400);

    await env.PRO_DB.prepare(
      `INSERT INTO pro_prompts
       (category_id,title,description,prompt,image_url)
       VALUES (?,?,?,?,?)`
    ).bind(
      b.category_id || null,
      b.title,
      b.description || "",
      b.prompt,
      b.image_url || ""
    ).run();

    return json({ success: true });
  }

  if (
    path === "/api/pro/admin/deposits" &&
    request.method === "GET"
  ) {
    const r = await env.PRO_DB.prepare(
      `SELECT d.*,u.name,u.email
       FROM pro_deposits d
       JOIN users u ON u.id=d.user_id
       ORDER BY d.id DESC`
    ).all();

    return json(r.results);
  }

  const approve =
    path.match(
      /^\/api\/pro\/admin\/deposits\/(\d+)\/approve$/
    );

  if (approve && request.method === "POST")
    return await approveDeposit(
      env,
      Number(approve[1])
    );

  const reject =
    path.match(
      /^\/api\/pro\/admin\/deposits\/(\d+)\/reject$/
    );

  if (reject && request.method === "POST") {
    await env.PRO_DB.prepare(
      `UPDATE pro_deposits
       SET status='rejected'
       WHERE id=? AND status='pending'`
    ).bind(Number(reject[1])).run();

    return json({ success: true });
  }

  return json({ error: "Admin endpoint not found" }, 404);
}

async function approveDeposit(env, id) {
  const d = await env.PRO_DB.prepare(
    `SELECT * FROM pro_deposits
     WHERE id=? AND status='pending'`
  ).bind(id).first();

  if (!d)
    return json({
      error: "Pending deposit not found"
    }, 404);

  await env.PRO_DB.prepare(
    `INSERT OR IGNORE INTO pro_credits
     (user_id,credits) VALUES (?,0)`
  ).bind(d.user_id).run();

  await env.PRO_DB.prepare(
    `UPDATE pro_credits
     SET credits=credits+?,
         updated_at=CURRENT_TIMESTAMP
     WHERE user_id=?`
  ).bind(d.amount, d.user_id).run();

  await env.PRO_DB.prepare(
    `INSERT INTO pro_transactions
     (user_id,type,credits,reference)
     VALUES (?,?,?,?)`
  ).bind(
    d.user_id,
    "deposit",
    d.amount,
    `deposit:${id}`
  ).run();

  await env.PRO_DB.prepare(
    `UPDATE pro_deposits
     SET status='approved',
         approved_at=CURRENT_TIMESTAMP
     WHERE id=?`
  ).bind(id).run();

  return json({
    success: true,
    credits_added: d.amount
  });
}

/* IMAGE */

async function image(request, path, env) {
  const key = decodeURIComponent(
    path.replace("/pro/images/", "")
  );

  const obj = await env.PRO_IMAGES.get(key);

  if (!obj)
    return new Response("Not found", { status: 404 });

  const h = new Headers();
  obj.writeHttpMetadata(h);
  h.set(
    "Cache-Control",
    "public,max-age=31536000"
  );

  return new Response(obj.body, { headers: h });
}

/* AUTH */

async function auth(request, env) {
  const token = cookie(request, COOKIE);

  if (!token) return null;

  return await env.PRO_DB.prepare(
    `SELECT u.id,u.google_id,u.name,u.email,
     u.photo_url,u.referral_code
     FROM sessions s
     JOIN users u ON u.id=s.user_id
     WHERE s.session_token_hash=?
     AND s.expires_at>CURRENT_TIMESTAMP
     LIMIT 1`
  ).bind(await sha256(token)).first();
}

/* HELPERS */

async function sha256(value) {
  const data = new TextEncoder().encode(value);
  const hash = await crypto.subtle.digest(
    "SHA-256",
    data
  );

  return [...new Uint8Array(hash)]
    .map(x => x.toString(16).padStart(2, "0"))
    .join("");
}

function cookie(request, name) {
  const h = request.headers.get("Cookie") || "";

  for (const x of h.split(";")) {
    const [k, ...v] = x.trim().split("=");

    if (k === name)
      return v.join("=");
  }

  return null;
}

function json(data, status = 200) {
  return cors(new Response(
    JSON.stringify(data),
    {
      status,
      headers: {
        "Content-Type": "application/json"
      }
    }
  ));
}

function cors(response) {
  const h = new Headers(response.headers);

  h.set(
    "Access-Control-Allow-Origin",
    SITE
  );
  h.set(
    "Access-Control-Allow-Credentials",
    "true"
  );
  h.set(
    "Access-Control-Allow-Headers",
    "Content-Type"
  );
  h.set(
    "Access-Control-Allow-Methods",
    "GET,POST,PUT,DELETE,OPTIONS"
  );

  return new Response(response.body, {
    status: response.status,
    headers: h
  });
}