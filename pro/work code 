/* RECEIPT */

async function receipt(req,url,env){
 const u=await user(req,env);

 if(!u)
  return out({
   error:"Login required"
  },401);

 const id=Number(
  url.searchParams.get("deposit_id")
 );

 if(!Number.isInteger(id))
  return out({
   error:"Invalid deposit ID"
  },400);

 const d=await env.PRO_DB.prepare(`
  SELECT id,status
  FROM pro_deposits
  WHERE id=? AND user_id=?
 `).bind(
  id,
  u.id
 ).first();

 if(!d)
  return out({
   error:"Deposit not found"
  },404);

 if(d.status!=="pending")
  return out({
   error:"Deposit already processed"
  },400);

 const type=
  req.headers.get("Content-Type")||"";

 if(!type.startsWith("image/"))
  return out({
   error:"Receipt must be an image"
  },400);

 const ext=
  type.includes("png")
   ?"png"
   :type.includes("webp")
    ?"webp"
    :"jpg";

 const key=
  `receipts/${u.id}/${id}-${Date.now()}.${ext}`;

 await env.PRO_IMAGES.put(
  key,
  await req.arrayBuffer(),
  {
   httpMetadata:{
    contentType:type
   }
  }
 );

 await env.PRO_DB.prepare(`
  UPDATE pro_deposits
  SET receipt_key=?
  WHERE id=? AND user_id=?
 `).bind(
  key,
  id,
  u.id
 ).run();

 return out({
  ok:true,
  receipt_key:key
 });
}

/* ADMIN */

async function isAdmin(req,env){
 const u=await user(req,env);

 if(!u)
  return null;

 const list=String(
  env.PRO_ADMIN_EMAILS||""
 )
 .split(",")
 .map(x=>x.trim().toLowerCase())
 .filter(Boolean);

 return list.includes(
  u.email.toLowerCase()
 )
  ?u
  :null;
}

async function admin(req,url,env){
 const u=await isAdmin(req,env);

 if(!u)
  return out({
   error:"Admin access denied"
  },403);

 const p=url.pathname;

 /* CATEGORIES */

 if(p==="/api/pro/admin/categories"){

  if(req.method==="GET"){

   const r=await env.PRO_DB.prepare(`
    SELECT *
    FROM pro_categories
    ORDER BY name COLLATE NOCASE
   `).all();

   return out({
    categories:r.results||[]
   });
  }

  if(req.method==="POST"){

   const b=await req.json();

   const name=String(
    b.name||""
   ).trim();

   if(!name)
    return out({
     error:"Category name required"
    },400);

   try{

    const r=await env.PRO_DB.prepare(`
     INSERT INTO pro_categories
     (name,active)
     VALUES (?,1)
    `).bind(name).run();

    return out({
     ok:true,
     id:r.meta.last_row_id
    });

   }catch{

    return out({
     error:"Category already exists"
    },409);
   }
  }
 }

 /* PROMPTS */

 if(p==="/api/pro/admin/prompts"){

  if(req.method==="GET"){

   const r=await env.PRO_DB.prepare(`
    SELECT
     p.*,
     c.name category_name
    FROM pro_prompts p
    LEFT JOIN pro_categories c
     ON c.id=p.category_id
    ORDER BY p.id DESC
    LIMIT 500
   `).all();

   return out({
    prompts:r.results||[]
   });
  }

  if(req.method==="POST"){

   const b=await req.json();

   const category=
    Number(b.category_id);

   const title=
    String(b.title||"").trim();

   const description=
    String(b.description||"").trim();

   const prompt=
    String(b.prompt||"").trim();

   const imageKey=
    String(b.image_key||"").trim();

   const imageUrl=
    String(b.image_url||"").trim();

   if(!Number.isInteger(category))
    return out({
     error:"Invalid category"
    },400);

   if(!title||!prompt)
    return out({
     error:"Title and prompt required"
    },400);

   const r=await env.PRO_DB.prepare(`
    INSERT INTO pro_prompts
    (
     category_id,
     title,
     description,
     prompt,
     image_key,
     image_url,
     active
    )
    VALUES (?,?,?,?,?,?,1)
   `).bind(
    category,
    title,
    description,
    prompt,
    imageKey||null,
    imageUrl||null
   ).run();

   return out({
    ok:true,
    id:r.meta.last_row_id
   });
  }
 }

 /* DEPOSITS */

 if(p==="/api/pro/admin/deposits"){

  const r=await env.PRO_DB.prepare(`
   SELECT
    d.*,
    u.name,
    u.email
   FROM pro_deposits d
   JOIN users u
    ON u.id=d.user_id
   ORDER BY d.id DESC
   LIMIT 500
  `).all();

  return out({
   deposits:r.results||[]
  });
 }

 /* APPROVE */

 let m=p.match(
  /^\/api\/pro\/admin\/deposits\/(\d+)\/approve$/
 );

 if(
  m&&
  req.method==="POST"
 )
  return approve(+m[1],env);

 /* REJECT */

 m=p.match(
  /^\/api\/pro\/admin\/deposits\/(\d+)\/reject$/
 );

 if(
  m&&
  req.method==="POST"
 )
  return reject(+m[1],env);

 return out({
  error:"Admin endpoint not found"
 },404);
}

/* APPROVE */

async function approve(id,env){

 const d=await env.PRO_DB.prepare(`
  SELECT
   id,
   user_id,
   amount,
   status
  FROM pro_deposits
  WHERE id=?
 `).bind(id).first();

 if(!d)
  return out({
   error:"Deposit not found"
  },404);

 if(d.status!=="pending")
  return out({
   error:"Deposit already processed"
  },400);

 const claim=await env.PRO_DB.prepare(`
  UPDATE pro_deposits
  SET
   status='approved',
   approved_at=CURRENT_TIMESTAMP
  WHERE id=? AND status='pending'
 `).bind(id).run();

 if(claim.meta.changes!==1)
  return out({
   error:"Deposit already processed"
  },409);

 try{

  await env.PRO_DB.prepare(`
   INSERT OR IGNORE INTO pro_credits
   (user_id,credits)
   VALUES (?,0)
  `).bind(d.user_id).run();

  await env.PRO_DB.batch([

   env.PRO_DB.prepare(`
    UPDATE pro_credits
    SET
     credits=credits+?,
     updated_at=CURRENT_TIMESTAMP
    WHERE user_id=?
   `).bind(
    d.amount,
    d.user_id
   ),

   env.PRO_DB.prepare(`
    INSERT INTO pro_transactions
    (user_id,type,credits,reference)
    VALUES (?,'deposit',?,?)
   `).bind(
    d.user_id,
    d.amount,
    `deposit:${id}`
   )

  ]);

  return out({
   ok:true,
   deposit_id:id,
   credits_added:d.amount
  });

 }catch(e){

  await env.PRO_DB.prepare(`
   UPDATE pro_deposits
   SET
    status='pending',
    approved_at=NULL
   WHERE id=? AND status='approved'
  `).bind(id).run();

  throw e;
 }
}

