/* DEPOSIT */

async function deposit(req,env){
  const usr=await getUser(req,env);

  if(!usr)
    return out({
      error:"Unauthorized"
    },401);

  const d=await req.json();

  const amount=Number(d.amount);
  const reference=String(d.reference||"").trim();

  if(!Number.isFinite(amount)||amount<MIN)
    return out({
      error:`Minimum deposit is ${MIN}`
    },400);

  if(!reference)
    return out({
      error:"Reference is required"
    },400);

  const r=await env.PRO_DB.prepare(`
    INSERT INTO pro_deposits
    (user_id,amount,reference,status)
    VALUES (?,?,?,'pending')
  `).bind(
    usr.id,
    amount,
    reference
  ).run();

  return out({
    ok:true,
    deposit_id:r.meta.last_row_id
  });
}

