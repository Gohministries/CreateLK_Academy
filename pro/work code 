/* PROMPTS */

function imageUrl(key){
  return key
    ? SITE+"/api/pro/images/"+encodeURIComponent(key)
    : null;
}

async function prompts(req,env){
  const u=new URL(req.url);
  const category=u.searchParams.get("category");
  const search=u.searchParams.get("search");

  let sql=`
    SELECT p.*,c.name category_name
    FROM pro_prompts p
    LEFT JOIN pro_categories c ON c.id=p.category_id
    WHERE 1=1
  `;

  const a=[];

  if(category){
    sql+=" AND p.category_id=?";
    a.push(category);
  }

  if(search){
    sql+=`
      AND (
        p.title LIKE ?
        OR p.description LIKE ?
        OR p.prompt LIKE ?
      )
    `;
    const s=`%${search}%`;
    a.push(s,s,s);
  }

  sql+=" ORDER BY p.id DESC";

  const r=await env.PRO_DB.prepare(sql).bind(...a).all();

  return out({
    prompts:(r.results||[]).map(p=>({
      ...p,
      image_url:imageUrl(p.image_key)
    }))
  });
}

async function getPrompt(id,env){
  const p=await env.PRO_DB.prepare(`
    SELECT p.*,c.name category_name
    FROM pro_prompts p
    LEFT JOIN pro_categories c ON c.id=p.category_id
    WHERE p.id=? LIMIT 1
  `).bind(id).first();

  if(!p)return out({error:"Prompt not found"},404);

  return out({
    prompt:{
      ...p,
      image_url:imageUrl(p.image_key)
    }
  });
}


/* COPY */

async function copyPrompt(req,id,env){
  const u=await getUser(req,env);
  if(!u)return out({error:"Please login first"},401);

  const p=await env.PRO_DB.prepare(
    "SELECT * FROM pro_prompts WHERE id=? LIMIT 1"
  ).bind(id).first();

  if(!p)return out({error:"Prompt not found"},404);

  const c=await env.PRO_DB.prepare(
    "SELECT credits FROM pro_credits WHERE user_id=?"
  ).bind(u.id).first();

  const credits=Number(c?.credits||0);

  if(credits<COST)
    return out({
      error:"Insufficient credits",
      required:COST,
      credits
    },402);

  await env.PRO_DB.prepare(`
    UPDATE pro_credits
    SET credits=credits-?,
        updated_at=CURRENT_TIMESTAMP
    WHERE user_id=?
  `).bind(COST,u.id).run();

  await env.PRO_DB.prepare(`
    INSERT INTO pro_transactions
    (user_id,type,amount,description)
    VALUES (?,?,?,?)
  `).bind(
    u.id,
    "debit",
    COST,
    `Copied prompt #${id}`
  ).run();

  await env.PRO_DB.prepare(`
    INSERT INTO pro_copy_logs
    (user_id,prompt_id,credits)
    VALUES (?,?,?)
  `).bind(u.id,id,COST).run();

  return out({
    ok:true,
    prompt:p.prompt||"",
    image_url:imageUrl(p.image_key),
    credits:credits-COST
  });
}


