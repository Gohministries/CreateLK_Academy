/* RECEIPT */

async function receipt(req,env){
  const usr=await getUser(req,env);

  if(!usr)
    return out({
      error:"Unauthorized"
    },401);

  const d=await req.json();

  const id=Number(d.deposit_id);
  const image=String(d.image||"");

  if(!id||!image)
    return out({
      error:"Deposit ID and image are required"
    },400);

  const dep=await env.PRO_DB.prepare(`
    SELECT *
    FROM pro_deposits
    WHERE id=? AND user_id=?
    LIMIT 1
  `).bind(
    id,
    usr.id
  ).first();

  if(!dep)
    return out({
      error:"Deposit not found"
    },404);

  const m=image.match(
    /^data:(image\/(?:png|jpeg|jpg|webp));base64,(.+)$/i
  );

  if(!m)
    return out({
      error:"Invalid image format"
    },400);

  const type=m[1].replace(
    "image/jpg",
    "image/jpeg"
  );

  const raw=atob(m[2]);
  const bytes=new Uint8Array(raw.length);

  for(let i=0;i<raw.length;i++)
    bytes[i]=raw.charCodeAt(i);

  const ext=
    type==="image/png"
      ?"png":
    type==="image/webp"
      ?"webp":
    "jpg";

  const key=
    `deposits/${usr.id}/${id}-${rnd(8)}.${ext}`;

  await env.PRO_IMAGES.put(
    key,
    bytes,
    {
      httpMetadata:{
        contentType:type
      }
    }
  );

  await env.PRO_DB.prepare(`
    UPDATE pro_deposits
    SET receipt_key=?
    WHERE id=? AND user_id=?
  `).bind(
    key,
    id,
    usr.id
  ).run();

  return out({
    ok:true
  });
}

/* IMAGE */

async function imageRoute(req,env,key){
  const obj=await env.PRO_IMAGES.get(key);

  if(!obj)
    return new Response(
      "Not found",
      {status:404}
    );

  const h=new Headers();

  obj.writeHttpMetadata(h);

  h.set(
    "Cache-Control",
    "public,max-age=86400"
  );

  return cors(
    new Response(
      obj.body,
      {headers:h}
    )
  );
}

/* ADMIN */

function admin(usr,env){
  if(!usr)return false;

  const list=String(
    env.PRO_ADMIN_EMAILS||""
  ).split(",")
   .map(x=>x.trim().toLowerCase())
   .filter(Boolean);

  return list.includes(
    String(usr.email||"").toLowerCase()
  );
}

async function adminCategories(req,env){
  const usr=await getUser(req,env);

  if(!admin(usr,env))
    return out({
      error:"Forbidden"
    },403);

  if(req.method==="GET")
    return categories(env);

  const d=await req.json();
  const name=String(d.name||"").trim();

  if(!name)
    return out({
      error:"Category name required"
    },400);

  const r=await env.PRO_DB.prepare(`
    INSERT INTO pro_categories(name)
    VALUES (?)
  `).bind(name).run();

  return out({
    ok:true,
    id:r.meta.last_row_id
  });
}

async function adminPrompts(req,env){
  const usr=await getUser(req,env);

  if(!admin(usr,env))
    return out({
      error:"Forbidden"
    },403);

  if(req.method==="GET"){
    const r=await env.PRO_DB.prepare(`
      SELECT p.*,c.name AS category_name
      FROM pro_prompts p
      LEFT JOIN pro_categories c
        ON c.id=p.category_id
      ORDER BY p.id DESC
    `).all();

    return out({
      prompts:r.results||[]
    });
  }

  const d=await req.json();

  const title=String(d.title||"").trim();
  const description=String(d.description||"").trim();
  const promptText=String(d.prompt||"").trim();

  const category=d.category_id?
    Number(d.category_id):
    null;

  if(!title||!promptText)
    return out({
      error:"Title and prompt are required"
    },400);

  const r=await env.PRO_DB.prepare(`
    INSERT INTO pro_prompts
    (category_id,title,description,prompt)
    VALUES (?,?,?,?)
  `).bind(
    category,
    title,
    description,
    promptText
  ).run();

  return out({
    ok:true,
    id:r.meta.last_row_id
  });
}

