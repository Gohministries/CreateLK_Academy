/* IMAGES */

async function image(path,env){

 const key=path.replace(
  "/pro/images/",
  ""
 );

 if(!key.startsWith("prompts/"))
  return new Response(
   "Not found",
   {status:404}
  );

 const o=await env.PRO_IMAGES.get(key);

 if(!o)
  return new Response(
   "Not found",
   {status:404}
  );

 return new Response(
  o.body,
  {
