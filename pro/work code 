/* COPY PROMPT */

async function copy(req,env,id){
 const u=await user(req,env);

 if(!u)
  return out({
   error:"Login required"
  },401);

 const p=await env.PRO_DB.prepare(`
  SELECT id,title,prompt
  FROM pro_prompts
  WHERE id=? AND active=1
 `).bind(id).first();

 if(!p)
  return out({
   error:"Prompt not found"
  },404);

 await env.PRO_DB.prepare(`
  INSERT OR IGNORE INTO pro_credits
  (user_id,credits)
  VALUES (?,0)
 `).bind(u.id).run();

 const r=await env.PRO_DB.prepare(`
  UPDATE pro_credits
  SET credits=credits-?,
      updated_at=CURRENT_TIMESTAMP
  WHERE user_id=? AND credits>=?
 `).bind(
  COST,
  u.id,
  COST
 ).run();

 if(r.meta.changes!==1){

  const c=await env.PRO_DB.prepare(`
   SELECT credits
   FROM pro_credits
   WHERE user_id=?
  `).bind(u.id).first();

  return out({
   error:"Insufficient credits",
   code:"INSUFFICIENT_CREDITS",
   credits:Number(c?.credits||0),
   required:COST
  },402);
 }

 try{

  await env.PRO_DB.batch([

   env.PRO_DB.prepare(`
    INSERT INTO pro_transactions
    (user_id,type,credits,reference)
    VALUES (?,'copy',?,?)
   `).bind(
    u.id,
    -COST,
    `prompt:${id}`
   ),

   env.PRO_DB.prepare(`
    INSERT INTO pro_copy_logs
    (user_id,prompt_id,credits)
    VALUES (?,?,?)
   `).bind(
    u.id,
    id,
    COST
   )

  ]);

 }catch(e){

  await env.PRO_DB.prepare(`
   UPDATE pro_credits
   SET credits=credits+?,
       updated_at=CURRENT_TIMESTAMP
   WHERE user_id=?
  `).bind(
   COST,
   u.id
  ).run();

  throw e;
 }

 const c=await env.PRO_DB.prepare(`
  SELECT credits
  FROM pro_credits
  WHERE user_id=?
 `).bind(u.id).first();

 return out({
  ok:true,
  prompt:{
   id:p.id,
   title:p.title,
   prompt:p.prompt
  },
  credits:Number(c?.credits||0)
 });
}

