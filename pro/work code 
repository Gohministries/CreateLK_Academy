/* PROMPTS */

async function prompts(req,env){
  const u=new URL(req.url);
  const category=u.searchParams.get("category");
  const search=u.searchParams.get("search");

  let sql=`
    SELECT p.*,c.name AS category_name
    FROM pro_prompts p
    LEFT JOIN pro_categories c
      ON c.id=p.category_id
    WHERE 1=1
  `;

  const a=[];

  if(category){
    sql+=" AND p.category_id=?";
    a.push(category);
  }

  if(search){
    sql+=`
      AND (
        p.title LIKE ?
        OR p.description LIKE ?
        OR p.prompt LIKE ?
      )
    `;

    const s=`%${search}%`;

    a.push(s,s,s);
  }

  sql+=" ORDER BY p.id DESC";

  const r=await env.PRO_DB
    .prepare(sql)
    .bind(...a)
    .all();

  return out({
    prompts:r.results||[]
  });
}

async function prompt(id,env){
  const r=await env.PRO_DB.prepare(`
    SELECT p.*,c.name AS category_name
    FROM pro_prompts p
    LEFT JOIN pro_categories c
      ON c.id=p.category_id
    WHERE p.id=?
    LIMIT 1
  `).bind(id).first();

  if(!r)
    return out({
      error:"Prompt not found"
    },404);

  return out({
    prompt:r
  });
}

/* COPY */

async function copyPrompt(req,id,env){
  const usr=await getUser(req,env);

  if(!usr)
    return out({
      error:"Please login first"
    },401);

  const p=await env.PRO_DB.prepare(`
    SELECT *
    FROM pro_prompts
    WHERE id=?
    LIMIT 1
  `).bind(id).first();

  if(!p)
    return out({
      error:"Prompt not found"
    },404);

  const c=await env.PRO_DB.prepare(`
    SELECT credits
    FROM pro_credits
    WHERE user_id=?
    LIMIT 1
  `).bind(usr.id).first();

  const credits=Number(c?.credits||0);

  if(credits<COST){
    return out({
      error:"Insufficient credits",
      required:COST,
      credits
    },402);
  }

  await env.PRO_DB.prepare(`
    UPDATE pro_credits
    SET credits=credits-?
    WHERE user_id=?
  `).bind(
    COST,
    usr.id
  ).run();

  await env.PRO_DB.prepare(`
    INSERT INTO pro_transactions
    (user_id,type,amount,description)
    VALUES (?,?,?,?)
  `).bind(
    usr.id,
    "debit",
    COST,
    `Copied prompt #${id}`
  ).run();

  await env.PRO_DB.prepare(`
    INSERT INTO pro_copy_logs
    (user_id,prompt_id,credits)
    VALUES (?,?,?)
  `).bind(
    usr.id,
    id,
    COST
  ).run();

  return out({
    ok:true,
    prompt:p.prompt,
    credits:credits-COST
  });
}

