const SITE="https://createlk.com";
const COST=10,MIN=100,DAYS=30;

const json=(x,s=200)=>new Response(JSON.stringify(x),{
  status:s,
  headers:{"Content-Type":"application/json"}
});

function cors(r){
  const h=new Headers(r.headers);
  h.set("Access-Control-Allow-Origin",SITE);
  h.set("Access-Control-Allow-Credentials","true");
  h.set("Access-Control-Allow-Methods","GET,POST,OPTIONS");
  h.set("Access-Control-Allow-Headers","Content-Type,Authorization");
  return new Response(r.body,{status:r.status,headers:h});
}

const out=(x,s=200)=>cors(json(x,s));

function rnd(n=16){
  const b=new Uint8Array(n);
  crypto.getRandomValues(b);
  return [...b].map(x=>x.toString(16).padStart(2,"0")).join("");
}

async function hash(x){
  const b=await crypto.subtle.digest(
    "SHA-256",
    new TextEncoder().encode(x)
  );
  return [...new Uint8Array(b)]
    .map(x=>x.toString(16).padStart(2,"0")).join("");
}

function cookie(n,v,max){
  return `${n}=${encodeURIComponent(v)}; Path=/; HttpOnly; Secure; SameSite=None; Max-Age=${max}`;
}

function delCookie(n){
  return `${n}=; Path=/; HttpOnly; Secure; SameSite=None; Max-Age=0`;
}

function getCookie(req,n){
  const c=req.headers.get("Cookie")||"";
  const x=c.split(";").find(x=>x.trim().startsWith(n+"="));
  return x?decodeURIComponent(x.trim().slice(n.length+1)):null;
}

async function getUser(req,env){
  const s=getCookie(req,"pro_session");
  if(!s)return null;

  return env.PRO_DB.prepare(`
    SELECT u.* FROM sessions s
    JOIN users u ON u.id=s.user_id
    WHERE s.session_token_hash=?
    AND s.expires_at>datetime('now')
    LIMIT 1
  `).bind(await hash(s)).first();
}

function isAdmin(u,env){
  if(!u)return false;
  return String(env.PRO_ADMIN_EMAILS||"")
    .split(",")
    .map(x=>x.trim().toLowerCase())
    .includes(String(u.email||"").toLowerCase());
}


/* GOOGLE */

function googleLogin(url,env){
  const state=rnd(16);
  const g=new URL("https://accounts.google.com/o/oauth2/v2/auth");

  g.searchParams.set("client_id",env.GOOGLE_CLIENT_ID||"");
  g.searchParams.set("redirect_uri",url.origin+"/auth/callback");
  g.searchParams.set("response_type","code");
  g.searchParams.set("scope","openid email profile");
  g.searchParams.set("state",state);

  const r=new Response(null,{
    status:302,
    headers:{Location:g.toString()}
  });

  r.headers.append(
    "Set-Cookie",
    cookie("pro_oauth_state",state,600)
  );

  return cors(r);
}

async function googleCallback(req,url,env){
  const code=url.searchParams.get("code");
  const state=url.searchParams.get("state");

  if(!code||state!==getCookie(req,"pro_oauth_state"))
    return out({error:"Invalid Google login"},400);

  const redirect=url.origin+"/auth/callback";

  const tr=await fetch(
    "https://oauth2.googleapis.com/token",
    {
      method:"POST",
      headers:{"Content-Type":"application/x-www-form-urlencoded"},
      body:new URLSearchParams({
        client_id:env.GOOGLE_CLIENT_ID||"",
        client_secret:env.GOOGLE_CLIENT_SECRET||"",
        code,
        redirect_uri:redirect,
        grant_type:"authorization_code"
      })
    }
  );

  const token=await tr.json();

  if(!tr.ok||!token.access_token)
    return out({
      error:"Google token failed",
      google_error:token.error||null,
      google_description:token.error_description||null
    },400);

  const gr=await fetch(
    "https://openidconnect.googleapis.com/v1/userinfo",
    {headers:{Authorization:`Bearer ${token.access_token}`}}
  );

  const g=await gr.json();

  if(!gr.ok||!g.email)
    return out({error:"Google account unavailable"},400);

  const email=g.email.toLowerCase();

  let u=await env.PRO_DB.prepare(`
    SELECT * FROM users
    WHERE google_id=? OR email=?
    LIMIT 1
  `).bind(String(g.sub),email).first();

  if(!u){
    const id=crypto.randomUUID();
    const ref="CLP"+rnd(5).slice(0,8).toUpperCase();

    await env.PRO_DB.prepare(`
      INSERT INTO users
      (id,google_id,name,email,photo_url,referral_code)
      VALUES (?,?,?,?,?,?)
    `).bind(
      id,
      String(g.sub),
      g.name||email.split("@")[0],
      email,
      g.picture||null,
      ref
    ).run();

    u=await env.PRO_DB.prepare(
      "SELECT * FROM users WHERE id=?"
    ).bind(id).first();

  }else{

    await env.PRO_DB.prepare(`
      UPDATE users
      SET google_id=?,name=?,photo_url=?
      WHERE id=?
    `).bind(
      String(g.sub),
      g.name||u.name,
      g.picture||u.photo_url,
      u.id
    ).run();

    u=await env.PRO_DB.prepare(
      "SELECT * FROM users WHERE id=?"
    ).bind(u.id).first();
  }

  if(!u?.id)
    return out({error:"User creation failed"},500);

  await env.PRO_DB.prepare(`
    INSERT OR IGNORE INTO pro_credits(user_id,credits)
    VALUES (?,0)
  `).bind(u.id).run();

  const session=rnd(32);
  const expires=new Date(
    Date.now()+DAYS*86400000
  ).toISOString();

  await env.PRO_DB.prepare(`
    INSERT INTO sessions
    (id,session_token_hash,user_id,expires_at)
    VALUES (?,?,?,?)
  `).bind(
    crypto.randomUUID(),
    await hash(session),
    u.id,
    expires
  ).run();

  const r=new Response(null,{
    status:302,
    headers:{Location:SITE+"/pro/"}
  });

  r.headers.append(
    "Set-Cookie",
    cookie("pro_session",session,DAYS*86400)
  );

  r.headers.append(
    "Set-Cookie",
    delCookie("pro_oauth_state")
  );

  return cors(r);
}


