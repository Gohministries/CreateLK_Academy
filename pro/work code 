/* PROMPTS */

async function prompts(u,env){
 const cat=
  u.searchParams.get("category_id")||
  u.searchParams.get("category");

 const search=
  u.searchParams.get("search")||"";

 const limit=Math.min(
  Math.max(
   Number(u.searchParams.get("limit"))||30,
   1
  ),
  100
 );

 const offset=Math.max(
  Number(u.searchParams.get("offset"))||0,
  0
 );

 let sql=`
  SELECT
   p.id,
   p.category_id,
   c.name category_name,
   p.title,
   p.description,
   p.image_key,
   p.image_url,
   p.created_at
  FROM pro_prompts p
  LEFT JOIN pro_categories c
   ON c.id=p.category_id
  WHERE p.active=1
 `;

 const a=[];

 if(
  cat&&
  Number.isInteger(+cat)
 ){
  sql+=" AND p.category_id=?";
  a.push(+cat);
 }

 if(search.trim()){
  sql+=`
   AND(
    p.title LIKE ?
    OR p.description LIKE ?
    OR c.name LIKE ?
   )
  `;

  const x=`%${search.trim()}%`;

  a.push(x,x,x);
 }

 sql+=`
  ORDER BY p.id DESC
  LIMIT ? OFFSET ?
 `;

 a.push(limit,offset);

 const r=await env.PRO_DB.prepare(sql)
  .bind(...a)
  .all();

 return out({
  prompts:r.results||[],
  limit,
  offset
 });
}

