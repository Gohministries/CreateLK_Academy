<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Dashboard | CreateLK Jobs</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:Arial,sans-serif;background:#f4f7fb;color:#17233d;line-height:1.5}
a{text-decoration:none;color:inherit}button{font:inherit;cursor:pointer}

header{background:#102a56;color:#fff;position:sticky;top:0;z-index:10}
.nav{max-width:1050px;margin:auto;padding:9px 14px;display:flex;align-items:center;gap:8px}
.logo{width:38px;height:38px;object-fit:contain;background:#fff;border-radius:8px;padding:3px}
.brand{font-weight:700;font-size:17px;flex:1}
.user{font-size:12px}
.home,.logout{padding:7px 10px;border-radius:7px;font-size:12px;font-weight:700}
.home{background:#fff;color:#102a56}
.logout{border:1px solid #ffffff55;background:transparent;color:#fff}

main{max-width:1050px;margin:auto;padding:18px 14px 30px}
h1{font-size:24px;margin-bottom:2px}
.sub{font-size:12px;color:#718096;margin-bottom:13px}

.quick{display:flex;gap:8px;margin-bottom:13px}
.quick button{flex:1;border:0;border-radius:8px;padding:10px;font-size:13px;font-weight:700}
.post{background:#102a56;color:#fff}
.ads{background:#d7a536;color:#17233d}

.card{background:#fff;border:1px solid #e3e8ef;border-radius:9px;padding:13px;margin-bottom:12px}
.card h2{font-size:16px;margin-bottom:9px}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:9px}
.full{grid-column:1/-1}
label{font-size:11px;font-weight:700;display:block;margin-bottom:3px}
input,select,textarea{width:100%;padding:8px;border:1px solid #d5dce7;border-radius:6px;font-size:12px}
textarea{min-height:75px;resize:vertical}

.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin-bottom:10px}
.stat{text-align:center;background:#f5f7fb;padding:8px;border-radius:7px}
.stat b{display:block;font-size:18px;color:#102a56}
.stat span{font-size:10px;color:#718096}

.types{display:grid;grid-template-columns:repeat(4,1fr);gap:6px}
.type{border:1px solid #d5dce7;border-radius:6px;padding:7px;text-align:center;font-size:11px}
.type input{display:none}
.type:has(input:checked){border-color:#d7a536;background:#fff8e8}

.price{margin-top:8px;padding:8px;background:#f5f7fb;border-radius:6px;font-size:12px}
.bank{margin-top:8px;padding:9px;background:#fff8e8;border:1px solid #ead39a;border-radius:7px;font-size:11px}
.bank button{float:right;background:#102a56;color:#fff;border:0;border-radius:4px;padding:3px 6px;font-size:9px}

.actions{display:flex;gap:7px;margin-top:10px}
.primary,.secondary{border:0;border-radius:6px;padding:8px 13px;font-size:12px;font-weight:700}
.primary{background:#102a56;color:#fff}
.secondary{background:#e8edf4;color:#27364f}
.msg{font-size:11px;margin-top:7px}

.item{border:1px solid #e3e8ef;border-radius:7px;padding:8px;margin-top:7px}
.item b{font-size:13px}
.meta{font-size:10px;color:#718096}
.badge{display:inline-block;background:#eef2f7;border-radius:4px;padding:2px 5px;font-size:9px;font-weight:700;margin-top:3px}
.empty{font-size:11px;color:#7b8798}
.free{background:#f2faf5;border-color:#cfe8d7}
.free h2{color:#237443}

@media(max-width:600px){
.user{display:none}
.grid{grid-template-columns:1fr}
.full{grid-column:auto}
.types{grid-template-columns:repeat(2,1fr)}
}
</style>
</head>

<body>

<header>
<div class="nav">
<img class="logo" src="https://jobs.createlk.com/file_00000000f05482118c11cccfc653fd0f.png" alt="CreateLK Jobs">
<div class="brand">CreateLK Jobs</div>
<span class="user" id="userName"></span>
<a class="home" href="https://createlk.com/index.html">Home</a>
<button class="logout" id="logout">Sign Out</button>
</div>
</header>

<main>

<h1>My Dashboard</h1>
<p class="sub">Manage your ads and applications.</p>

<div class="quick">
<button class="post" id="postButton">＋ Post an Ad</button>
<button class="ads" id="myAdsButton">▣ My Ads</button>
</div>

<section class="card">
<h2>Account</h2>
<div id="accountInfo" class="empty">Loading...</div>
</section>

<section class="card" id="postCard" style="display:none">
<h2>Post an Ad</h2>

<form id="postForm">
<div class="grid">

<div class="full">
<label>Job Title</label>
<input id="title" required placeholder="Example: Sales Assistant">
</div>

<div class="full">
<label>Description</label>
<textarea id="description" required placeholder="Describe the job..."></textarea>
</div>

<div>
<label>WhatsApp Number</label>
<input id="whatsapp" required placeholder="0771234567">
</div>

<div>
<label>Call Number</label>
<input id="call" required placeholder="0771234567">
</div>

<div>
<label>Province</label>
<select id="province" required><option value="">Select Province</option></select>
</div>

<div>
<label>District</label>
<select id="district" required disabled><option value="">Select District</option></select>
</div>

<div>
<label>City</label>
<select id="city" required disabled><option value="">Select City</option></select>
</div>

<div>
<label>Category</label>
<select id="category" required><option value="">Select Category</option></select>
</div>

<div class="full">
<label>Ad Type</label>
<div class="types">
<label class="type"><input type="radio" name="adType" value="free" checked>Free<br>Rs. 0</label>
<label class="type"><input type="radio" name="adType" value="featured">Featured<br>Rs. 500</label>
<label class="type"><input type="radio" name="adType" value="urgent">Urgent<br>Rs. 500</label>
<label class="type"><input type="radio" name="adType" value="top">Top<br>Rs. 500</label>
<label class="type"><input type="radio" name="adType" value="featured_urgent_top">All 3<br>Rs. 1,500</label>
</div>
<div class="price" id="priceBox">Free Ad — Rs. 0</div>
</div>

<div class="full" id="paymentBox" style="display:none">
<div class="bank">
<b>Bank Deposit</b><br>
People's Bank — Udapussellawa<br>
Account Name: Thinarathnam Saththiyanadan<br>
Account No.: 292200280023178
<button type="button" id="copy">Copy</button>
</div>

<div class="grid" style="margin-top:8px">
<div>
<label>Depositor Name</label>
<input id="depositor">
</div>
<div>
<label>Deposit Date</label>
<input id="depositDate" type="date">
</div>
<div>
<label>Reference Number</label>
<input id="reference">
</div>
<div>
<label>Payment Slip</label>
<input id="paymentSlip" type="file" accept=".jpg,.jpeg,.png,.webp,.pdf">
</div>
</div>
</div>

<div class="full">
<label>Job Photo</label>
<input id="jobPhoto" type="file" accept=".jpg,.jpeg,.png,.webp">
</div>

</div>

<div class="actions">
<button class="primary">Submit Ad</button>
<button type="button" class="secondary" id="cancelButton">Cancel</button>
</div>
<div class="msg" id="formMessage"></div>
</form>
</section>

<section class="card" id="adsCard">
<h2>My Ads</h2>
<div class="stats">
<div class="stat"><b id="totalAds">0</b><span>Total</span></div>
<div class="stat"><b id="approvedAds">0</b><span>Approved</span></div>
<div class="stat"><b id="pendingAds">0</b><span>Pending</span></div>
</div>
<div id="adsList" class="empty">Loading...</div>
</section>

<section class="card free">
<h2>Free Ad</h2>
<p style="font-size:11px">Post a free job advertisement for 30 days.</p>
</section>

<section class="card">
<h2>Applications</h2>
<div id="applications" class="empty">Loading...</div>
</section>

</main>

<script>
const API="/jobs-api", $=id=>document.getElementById(id);

function token(){
return localStorage.getItem("createlk_session_token")||
sessionStorage.getItem("createlk_session_token")||
"";
}

function headers(){
let t=token();
return t?{Authorization:"Bearer "+t}:{};
}

async function api(path,opt={}){
let r=await fetch(API+path,{...opt,headers:{...headers(),...(opt.headers||{})}});
if(r.status===401){
localStorage.removeItem("createlk_session_token");
sessionStorage.removeItem("createlk_session_token");
location.href="https://createlk.com/LK/login.html";
return;
}
let d={};try{d=await r.json()}catch(e){}
if(!r.ok)throw Error(d.message||d.error||"Request failed");
return d;
}

function esc(v){
return String(v??"").replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[m]));
}

async function account(){
try{
let d=await api("/api/me"),u=d.user||d;
$("userName").textContent=u.name||u.full_name||u.email||"";
$("accountInfo").innerHTML=`<b>${esc(u.name||u.full_name||"User")}</b>${u.email?`<br>${esc(u.email)}`:""}`;
}catch(e){$("accountInfo").textContent="Unable to load account."}
}

async function ads(){
try{
let d=await api("/api/my-ads"),a=Array.isArray(d)?d:d.ads||d.data||[];
$("totalAds").textContent=a.length;
$("approvedAds").textContent=a.filter(x=>x.status==="approved").length;
$("pendingAds").textContent=a.filter(x=>x.status==="pending").length;
$("adsList").innerHTML=a.length?a.map(x=>`
<div class="item">
<b>${esc(x.title||"Untitled Ad")}</b>
<div class="meta">${esc([x.city,x.district,x.province].filter(Boolean).join(", "))}</div>
<span class="badge">${esc(String(x.status||"pending").toUpperCase())}</span>
${x.ad_type?`<span class="badge">${esc(String(x.ad_type).replaceAll("_"," ").toUpperCase())}</span>`:""}
</div>`).join(""):`<div class="empty">You have not posted any ads yet.</div>`;
}catch(e){$("adsList").textContent="Unable to load your ads."}
}

async function applications(){
try{
let d=await api("/api/my-applications"),a=Array.isArray(d)?d:d.applications||d.data||[];
$("applications").innerHTML=a.length?a.map(x=>`
<div class="item"><b>${esc(x.job_title||x.title||"Job Application")}</b>
${x.status?`<div class="meta">Status: ${esc(x.status)}</div>`:""}</div>`).join(""):"No applications yet.";
}catch(e){$("applications").textContent="Unable to load applications."}
}

async function locations(url,select,key){
try{
let d=await api(url),a=d[key]||d||[];
select.innerHTML='<option value="">Select</option>'+a.map(x=>{
let v=typeof x==="string"?x:x.name||x[key.slice(0,-1)]||"";
return `<option value="${esc(v)}">${esc(v)}</option>`;
}).join("");
select.disabled=false;
}catch(e){}
}

$("province").onchange=()=>{
$("district").disabled=true;$("city").disabled=true;
locations("/api/locations?province="+encodeURIComponent($("province").value),$("district"),"districts");
};

$("district").onchange=()=>{
$("city").disabled=true;
locations("/api/locations?province="+encodeURIComponent($("province").value)+"&district="+encodeURIComponent($("district").value),$("city"),"cities");
};

async function initLocations(){
try{
let d=await api("/api/locations"),a=d.provinces||d||[];
$("province").innerHTML='<option value="">Select Province</option>'+a.map(x=>{
let v=typeof x==="string"?x:x.name||x.province||"";
return `<option value="${esc(v)}">${esc(v)}</option>`;
}).join("");
}catch(e){}
}

async function categories(){
try{
let d=await api("/api/categories"),a=d.categories||d||[];
$("category").innerHTML='<option value="">Select Category</option>'+a.map(x=>{
let v=typeof x==="string"?x:x.name||x.title||"";
let id=typeof x==="object"&&x.id!=null?x.id:v;
return `<option value="${esc(id)}">${esc(v)}</option>`;
}).join("");
}catch(e){}
}

function price(){
let t=document.querySelector("[name=adType]:checked").value;
let p={free:"Free Ad — Rs. 0",featured:"Featured Ad — Rs. 500",urgent:"Urgent Ad — Rs. 500",top:"Top Ad — Rs. 500",featured_urgent_top:"Featured + Urgent + Top — Rs. 1,500"};
$("priceBox").textContent=p[t];
$("paymentBox").style.display=t==="free"?"none":"block";
}

document.querySelectorAll("[name=adType]").forEach(x=>x.onchange=price);

$("copy").onclick=()=>{
navigator.clipboard.writeText("292200280023178");
$("copy").textContent="Copied";
setTimeout(()=>$("copy").textContent="Copy",1000);
};

$("postButton").onclick=()=>{
let x=$("postCard"),open=x.style.display==="none";
x.style.display=open?"block":"none";
$("postButton").textContent=open?"✕ Close Post Ad":"＋ Post an Ad";
if(open)x.scrollIntoView({behavior:"smooth"});
};

$("myAdsButton").onclick=()=>$("adsCard").scrollIntoView({behavior:"smooth"});

$("cancelButton").onclick=()=>{
$("postCard").style.display="none";
$("postButton").textContent="＋ Post an Ad";
$("postForm").reset();price();
};

$("postForm").onsubmit=async e=>{
e.preventDefault();
if(!token()){location.href="https://createlk.com/LK/login.html";return}

let m=$("formMessage"),f=new FormData(),t=document.querySelector("[name=adType]:checked").value;
m.textContent="Submitting...";

f.append("title",$("title").value.trim());
f.append("description",$("description").value.trim());
f.append("whatsapp_no",$("whatsapp").value.trim());
f.append("call_no",$("call").value.trim());
f.append("province",$("province").value);
f.append("district",$("district").value);
f.append("city",$("city").value);
f.append("category_id",$("category").value);
f.append("ad_type",t);

if($("jobPhoto").files[0])f.append("photo",$("jobPhoto").files[0]);

if(t!=="free"){
f.append("depositor_name",$("depositor").value.trim());
f.append("deposit_date",$("depositDate").value);
f.append("reference_number",$("reference").value.trim());
if($("paymentSlip").files[0])f.append("payment_slip",$("paymentSlip").files[0]);
}

try{
let r=await fetch(API+"/api/create-ad",{method:"POST",headers:headers(),body:f});
let d={};try{d=await r.json()}catch(e){}
if(!r.ok)throw Error(d.message||d.error||"Unable to create ad");
m.style.color="#237443";m.textContent="Ad submitted successfully.";
$("postForm").reset();price();await ads();
}catch(e){
m.style.color="#b42318";m.textContent=e.message;
}
};

$("logout").onclick=async()=>{
try{await fetch(API+"/jobs-auth/api/logout",{method:"POST",headers:headers()})}catch(e){}
localStorage.removeItem("createlk_session_token");
sessionStorage.removeItem("createlk_session_token");
location.href="https://createlk.com/LK/login.html";
};

if(!token())location.href="https://createlk.com/LK/login.html";
else{
price();
account();
ads();
applications();
initLocations();
categories();
}
</script>

</body>
</html>

