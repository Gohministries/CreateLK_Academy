<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#2563eb">
<title>CreateLK Academy</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
--blue:#2563eb;--purple:#7c3aed;--green:#10b981;
--orange:#f59e0b;--dark:#0f172a;--muted:#64748b;
--line:#e2e8f0;--bg:#f8fafc
}
body{
font-family:system-ui,-apple-system,sans-serif;
background:var(--bg);color:var(--dark)
}
header{
position:sticky;top:0;z-index:10;
background:#fff;border-bottom:1px solid var(--line)
}
.nav{
max-width:720px;margin:auto;padding:10px 12px;
display:flex;align-items:center;justify-content:space-between
}
.logo{
color:var(--blue);font-weight:800;
text-decoration:none;font-size:16px
}
.logo span{color:var(--purple)}
.logout{
height:36px;padding:0 12px;border:1px solid var(--line);
border-radius:8px;background:#fff;font-size:12px;
font-weight:700;cursor:pointer
}
main{max-width:720px;margin:auto;padding:10px}
.card{
background:#fff;border:1px solid var(--line);
border-radius:13px;padding:14px;margin-bottom:10px
}
.hero{
color:#fff;border:0;
background:linear-gradient(135deg,var(--blue),var(--purple))
}
.hero small{font-size:9px;font-weight:800}
.hero h1{font-size:21px;margin:4px 0}
.hero p{font-size:11px;opacity:.9}
.hero-row{
display:flex;align-items:end;gap:12px;margin-top:15px
}
.hero-progress{flex:1}
.hero-top{
display:flex;justify-content:space-between;
font-size:9px;margin-bottom:5px
}
.track,.progress{
height:7px;border-radius:20px;overflow:hidden
}
.track{background:#ffffff35}
.track div,.progress div{
height:100%;width:0;border-radius:20px
}
.track div{background:#fff}
.progress{background:#f1f5f9}
.progress div{
background:linear-gradient(90deg,var(--blue),var(--purple))
}
.hero-day{text-align:right}
.hero-day b{display:block;font-size:20px;line-height:1}
.hero-day small{font-size:7px}
.stats{
display:grid;grid-template-columns:repeat(3,1fr);
gap:7px;margin-bottom:10px
}
.stat{
padding:9px 3px;text-align:center;
background:#fff;border:1px solid var(--line);
border-radius:10px
}
.stat small{
display:block;color:var(--muted);
font-size:7px;font-weight:800
}
.stat b{font-size:13px}
.title{font-size:13px;font-weight:800;margin-bottom:6px}
.muted{font-size:10px;color:var(--muted);line-height:1.5}
.info{
display:flex;justify-content:space-between;
font-size:9px;font-weight:700;margin-bottom:5px
}
.lesson{
background:linear-gradient(135deg,#fff,#faf8ff);
border-color:#ddd6fe
}
.day{
display:inline-block;padding:3px 7px;
border-radius:5px;background:#eff6ff;
color:var(--blue);font-size:7px;font-weight:800
}
.lesson h2{font-size:18px;margin:6px 0 3px}
.vocab{
display:flex;flex-wrap:wrap;gap:4px;margin-top:8px
}
.vocab span{
padding:4px 7px;border:1px solid var(--line);
border-radius:6px;background:#fff;font-size:8px
}
.content{
display:none;margin-top:8px;padding:10px;
background:#f8fafc;border:1px solid var(--line);
border-radius:8px;font-size:10px;line-height:1.6
}

/* BUTTONS */
.btn{
width:100%;height:42px;margin-top:10px;
border:0;border-radius:9px;
display:flex;align-items:center;justify-content:center;
gap:6px;font-size:11px;font-weight:750;
cursor:pointer
}
.btn:disabled{opacity:.6;cursor:not-allowed}
.dark{background:var(--dark);color:#fff}
.pay{
color:#fff;
background:linear-gradient(135deg,var(--blue),var(--purple))
}
.share{background:var(--green);color:#fff}

.price{
font-size:21px;font-weight:800;
color:var(--purple);margin:4px 0
}
.price span{font-size:9px;color:var(--muted);font-weight:500}
.active{
display:none;margin-top:9px;padding:9px;
border:1px solid #bbf7d0;border-radius:8px;
background:#f0fdf4;color:#166534;
font-size:10px;font-weight:700;text-align:center
}

/* REFERRAL */
.referral{
background:linear-gradient(135deg,#fff,#fffbeb);
border-color:#fde68a
}
.refbox{display:flex;gap:5px;margin-top:8px}
.refbox input{
flex:1;min-width:0;height:38px;
border:1px solid #cbd5e1;border-radius:8px;
padding:0 8px;font-size:9px
}
.copy{
height:38px;padding:0 12px;
border:0;border-radius:8px;
background:var(--orange);color:#fff;
font-size:10px;font-weight:700
}
.earnings{
display:grid;grid-template-columns:repeat(3,1fr);
gap:5px;margin-top:8px
}
.earn{
padding:7px 2px;text-align:center;
border:1px solid #fef3c7;
border-radius:8px;background:#fff
}
.earn small{
display:block;color:var(--muted);
font-size:6px;font-weight:800
}
.earn b{font-size:10px}
.account{
display:grid;grid-template-columns:1fr 1fr;gap:6px
}
.account div{
padding:7px;border-radius:7px;
background:#f8fafc;border:1px solid var(--line)
}
.account small{
display:block;color:var(--muted);
font-size:6px;font-weight:800
}
.account b{
font-size:9px;overflow-wrap:anywhere
}
.message{
display:none;position:fixed;bottom:15px;left:50%;
transform:translateX(-50%);z-index:50;
max-width:90%;padding:9px 13px;
border-radius:8px;background:var(--dark);
color:#fff;font-size:10px;text-align:center
}
footer{
padding:2px 0 15px;text-align:center;
color:var(--muted);font-size:8px
}
@media(max-width:360px){
.account{grid-template-columns:1fr}
}
</style>
</head>

<body>

<header>
<div class="nav">
<a class="logo" href="index.html">
📚 CreateLK <span>Academy</span>
</a>
<button class="logout" onclick="logout()">Logout</button>
</div>
</header>

<main>

<!-- HERO -->
<section class="card hero">
<small>365-DAY ENGLISH JOURNEY</small>
<h1 id="welcome">Welcome 👋</h1>
<p>Learn English one day at a time.</p>

<div class="hero-row">
<div class="hero-progress">
<div class="hero-top">
<span>Course Progress</span>
<span id="heroPercent">0%</span>
</div>
<div class="track"><div id="heroBar"></div></div>
</div>

<div class="hero-day">
<b id="heroDay">1</b>
<small>Current Day</small>
</div>
</div>
</section>


<!-- STATS -->
<div class="stats">
<div class="stat">
<small>STUDENT ID</small>
<b id="studentId">-</b>
</div>
<div class="stat">
<small>LESSONS</small>
<b id="completed">0</b>
</div>
<div class="stat">
<small>MEMBERSHIP</small>
<b id="membership">Free</b>
</div>
</div>


<!-- PROGRESS -->
<section class="card">
<div class="title">🎓 Learning Progress</div>

<div class="info">
<span>Day <span id="progressDay">0</span> / 365</span>
<span id="percent">0%</span>
</div>

<div class="progress">
<div id="bar"></div>
</div>
</section>


<!-- LESSON -->
<section class="card lesson">

<div class="title">📖 Today's Lesson</div>

<div class="day">
DAY <span id="lessonDay">1</span>
</div>

<h2 id="lessonTitle">Loading lesson...</h2>

<p class="muted" id="lessonText">
Loading today's lesson...
</p>

<div class="vocab" id="vocab"></div>

<button
class="btn dark"
id="lessonButton"
onclick="loadLesson()">
📝 Open Today's Lesson
</button>

<div class="content" id="lessonContent"></div>

</section>


<!-- PREMIUM -->
<section class="card">

<div class="title">⭐ Premium Membership</div>

<p class="muted">
Complete 365-day English curriculum.
</p>

<div class="price">
LKR 1,500 <span>/ 30 days</span>
</div>

<button
class="btn pay"
id="upgradeButton"
onclick="checkout()">
⭐ Upgrade to Premium
</button>

<div class="active" id="activeBox">
✅ Premium membership is active.
</div>

</section>


<!-- REFERRAL -->
<section class="card referral">

<div class="title">💰 Referral Program</div>

<p class="muted">
Earn 20% commission from verified Premium payments.
</p>

<div class="refbox">

<input
id="referralLink"
readonly
placeholder="Your referral link">

<button class="copy" onclick="copyLink()">
Copy
</button>

</div>

<button
class="btn share"
onclick="shareLink()">
📤 Share via WhatsApp
</button>

<div class="earnings">

<div class="earn">
<small>REFERRALS</small>
<b id="referrals">0</b>
</div>

<div class="earn">
<small>PENDING</small>
<b id="pending">LKR 0</b>
</div>

<div class="earn">
<small>PAID</small>
<b id="paid">LKR 0</b>
</div>

</div>

</section>


<!-- ACCOUNT -->
<section class="card">

<div class="title">👤 Account</div>

<div class="account">

<div>
<small>NAME</small>
<b id="name">-</b>
</div>

<div>
<small>EMAIL</small>
<b id="email">-</b>
</div>

<div>
<small>PHONE</small>
<b id="phone">-</b>
</div>

<div>
<small>EXPIRY</small>
<b id="expiry">Not active</b>
</div>

</div>

</section>

</main>

<footer>© 2026 CreateLK Academy</footer>

<div class="message" id="message"></div>


<script>

const CHECKOUT_API=
"https://createlk-premium-payments.createlk.workers.dev";

const REFERRAL_API=
"https://createlk-referrals.createlk.workers.dev";

const LESSON_API=
"https://createlk-course-lessons.createlk.workers.dev";


let student={};

try{
student=JSON.parse(
localStorage.getItem("createlk_student")||"{}"
);
}catch{}


function id(){
return Number(
student.id||
student.database_id||
student.student_id_number||
0
);
}

function code(){
return student.student_id||
student.studentId||
"";
}

function membership(){
return String(
student.membership_status||
student.membershipStatus||
"FREE"
).toUpperCase();
}

function done(){
return Math.min(
365,
Math.max(
0,
Number(
student.completed_lessons||
student.completedLessons||
0
)
)
);
}


/* DASHBOARD */

function loadDashboard(){

const name=
`${student.first_name||""} ${student.last_name||""}`
.trim()||"Student";

const d=done();
const day=Math.min(365,d+1);
const pct=Math.round(d/365*100);
const premium=membership()==="PREMIUM";

document.getElementById("welcome").textContent=
`Welcome, ${name} 👋`;

document.getElementById("name").textContent=name;
document.getElementById("email").textContent=
student.email||"-";
document.getElementById("phone").textContent=
student.phone||"-";

document.getElementById("studentId").textContent=
code()||"-";

document.getElementById("completed").textContent=d;
document.getElementById("membership").textContent=
premium?"Premium":"Free";

document.getElementById("progressDay").textContent=d;
document.getElementById("lessonDay").textContent=day;
document.getElementById("heroDay").textContent=day;

document.getElementById("percent").textContent=
pct+"%";
document.getElementById("heroPercent").textContent=
pct+"%";

document.getElementById("bar").style.width=pct+"%";
document.getElementById("heroBar").style.width=pct+"%";

document.getElementById("expiry").textContent=
student.membership_expiry||
student.membershipExpiry||
"Not active";

document.getElementById("upgradeButton").style.display=
premium?"none":"flex";

document.getElementById("activeBox").style.display=
premium?"block":"none";


if(code()){

document.getElementById("referralLink").value=
`${location.origin}/register.html?ref=${encodeURIComponent(code())}`;

loadEarnings();

}

loadLessonPreview();

}


/* LESSON PREVIEW */

async function loadLessonPreview(){

try{

const r=await fetch(
`${LESSON_API}/api/lesson?day=${Math.min(365,done()+1)}`
);

const d=await r.json();

if(r.ok&&d.success){

const l=d.lesson||d;

document.getElementById("lessonTitle").textContent=
l.title||"Today's English Lesson";

document.getElementById("lessonText").textContent=
l.description||l.text||"Continue today's lesson.";

}

}catch{}

}


/* LESSON */

async function loadLesson(){

const btn=
document.getElementById("lessonButton");

btn.disabled=true;
btn.textContent="⏳ Loading Lesson...";

try{

const r=await fetch(
`${LESSON_API}/api/lesson?day=${Math.min(365,done()+1)}`
);

const d=await r.json();

if(!r.ok||!d.success)
throw new Error(
d.message||"Unable to load lesson."
);

const l=d.lesson||d;

document.getElementById("lessonTitle").textContent=
l.title||"Today's English Lesson";

document.getElementById("lessonText").textContent=
l.description||l.text||"";

const vocab=document.getElementById("vocab");
vocab.innerHTML="";

let words=l.vocabulary||l.vocab||[];

if(typeof words==="string"){

try{
words=JSON.parse(words);
}catch{
words=words.split(",")
.map(x=>x.trim())
.filter(Boolean);
}

}

if(Array.isArray(words)){

words.slice(0,10).forEach(w=>{

const span=document.createElement("span");

span.textContent=
typeof w==="object"
?(w.word||w.term||w.text||"")
:String(w);

if(span.textContent)
vocab.appendChild(span);

});

}

const content=
document.getElementById("lessonContent");

if(l.content){

content.innerHTML=
"<b>Lesson Material</b><br>"+l.content;

content.style.display="block";

}

btn.disabled=false;
btn.textContent="✓ Lesson Loaded";

show("Today's lesson loaded.");

}catch(e){

btn.disabled=false;
btn.textContent="📝 Open Today's Lesson";

show(e.message||"Lesson could not be loaded.");

}

}


/* PAYHERE
   ONLY STUDENT ID
*/

async function checkout(){

const studentId=id();

if(!studentId)
return show("Please login again before payment.");

const btn=
document.getElementById("upgradeButton");

btn.disabled=true;
btn.textContent="⏳ Opening PayHere...";

try{

const r=await fetch(
`${CHECKOUT_API}/api/checkout`,
{
method:"POST",
headers:{
"Content-Type":"application/json"
},
body:JSON.stringify({
student_id:studentId
})
}
);

const raw=await r.text();

if(!r.ok)
throw new Error("Unable to open PayHere.");

if(
raw.includes("<form")||
raw.toLowerCase().includes("payhere")
){

document.open();
document.write(raw);
document.close();
return;

}

const data=JSON.parse(raw);

if(data.url||data.checkout_url){

location.href=
data.url||data.checkout_url;

return;

}

throw new Error(
data.message||"Invalid checkout response."
);

}catch(e){

console.error(e);

show(
e.message||"Payment could not be started."
);

btn.disabled=false;
btn.textContent="⭐ Upgrade to Premium";

}

}


/* REFERRAL */

async function loadEarnings(){

if(!id())return;

try{

const r=await fetch(
`${REFERRAL_API}/api/earnings?student_id=${id()}`
);

const d=await r.json();

if(r.ok&&d.success){

document.getElementById("referrals").textContent=
Number(d.referrals||0).toLocaleString();

document.getElementById("pending").textContent=
"LKR "+Number(d.pending||0).toLocaleString();

document.getElementById("paid").textContent=
"LKR "+Number(d.paid||0).toLocaleString();

}

}catch{}

}


/* COPY */

async function copyLink(){

const input=
document.getElementById("referralLink");

if(!input.value)
return show("Referral link unavailable.");

try{
await navigator.clipboard.writeText(input.value);
}catch{
input.select();
document.execCommand("copy");
}

show("Referral link copied!");

}


/* SHARE */

async function shareLink(){

const link=
document.getElementById("referralLink").value;

if(!link)
return show("Referral link unavailable.");

const text=
"Join CreateLK Academy and start your 365-day English learning journey!";

if(navigator.share){

try{

await navigator.share({
title:"CreateLK Academy",
text,
url:link
});

return;

}catch{}

}

window.open(
"https://wa.me/?text="+
encodeURIComponent(text+"\n"+link),
"_blank"
);

}


/* MESSAGE */

function show(text){

const box=
document.getElementById("message");

box.textContent=text;
box.style.display="block";

clearTimeout(window.msg);

window.msg=setTimeout(
()=>box.style.display="none",
3000
);

}


/* LOGOUT */

function logout(){

localStorage.removeItem("createlk_student");
localStorage.removeItem("createlk_user");

location.href="login.html";

}


loadDashboard();

</script>

</body>
</html>