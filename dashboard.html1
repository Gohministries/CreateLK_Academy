<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#2563eb">
<title>CreateLK Academy</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{--b:#2563eb;--p:#7c3aed;--g:#059669;--d:#0f172a;--m:#64748b;--l:#e2e8f0;--bg:#f6f8fc}
body{font-family:system-ui,sans-serif;background:var(--bg);color:var(--d)}
header{background:#fff;border-bottom:1px solid var(--l);position:sticky;top:0;z-index:10}
.nav,main{max-width:720px;margin:auto}
.nav{padding:10px 12px;display:flex;justify-content:space-between;align-items:center}
.logo{color:var(--b);font-weight:800;text-decoration:none;font-size:15px}
.logo span{color:var(--p)}
.logout{border:1px solid var(--l);background:#fff;border-radius:8px;padding:7px 11px;font-weight:700;cursor:pointer}
main{padding:10px}
.card{background:#fff;border:1px solid var(--l);border-radius:13px;padding:14px;margin-bottom:10px}
.hero{background:linear-gradient(135deg,var(--b),var(--p));color:#fff;border:0}
.hero small{font-size:8px;font-weight:800}
.hero h1{font-size:20px;margin:4px 0}
.hero p{font-size:11px}
.progressTop,.progressTop2{display:flex;justify-content:space-between;font-size:9px}
.progressTop{margin-top:15px;margin-bottom:5px}
.track,.progress{height:7px;border-radius:20px;overflow:hidden}
.track{background:#ffffff35}
.track div{height:100%;background:#fff;width:0;transition:.4s}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin-bottom:10px}
.stat{background:#fff;border:1px solid var(--l);border-radius:9px;padding:9px 5px;text-align:center}
.stat small{display:block;color:var(--m);font-size:7px;font-weight:800}
.stat b{display:block;margin-top:2px;font-size:11px}
.title{font-size:13px;font-weight:800;margin-bottom:6px}
.progressTop2{margin-bottom:5px}
.progress{background:#eaf0f7}
.progress div{height:100%;background:linear-gradient(90deg,var(--b),var(--p));width:0}
.muted{font-size:10px;color:var(--m)}
.menu{margin-top:4px}
.menuCard{display:flex;align-items:center;gap:12px;padding:14px;border-radius:13px;margin-bottom:8px;text-decoration:none;background:#fff;border:1px solid var(--l)}
.icon{width:44px;height:44px;border-radius:11px;display:flex;align-items:center;justify-content:center;font-size:21px;flex-shrink:0}
.menuText{flex:1}
.menuText b{display:block;font-size:13px;margin-bottom:2px}
.menuText span{display:block;font-size:9px;color:var(--m)}
.arrow{font-size:20px;font-weight:700}
.lessonCard{border-left:4px solid var(--b)}
.lessonCard .icon{background:#eff6ff}
.lessonCard .arrow{color:var(--b)}
.statusCard{border-left:4px solid var(--p)}
.statusCard .icon{background:#f5f3ff}
.statusCard .arrow{color:var(--p)}
.affiliateCard{border-left:4px solid var(--g)}
.affiliateCard .icon{background:#ecfdf5}
.affiliateCard .arrow{color:var(--g)}
.msg{display:none;position:fixed;bottom:15px;left:50%;transform:translateX(-50%);background:var(--d);color:#fff;padding:9px 13px;border-radius:8px;font-size:10px;z-index:50}
footer{text-align:center;color:var(--m);font-size:8px;padding:5px 0 15px}
@media(max-width:400px){
.hero h1{font-size:18px}
.menuCard{padding:12px}
.icon{width:40px;height:40px}
}
</style>
</head>

<body>

<header>
<div class="nav">
<a class="logo" href="index.html">📚 CreateLK <span>Academy</span></a>
<button class="logout" onclick="logout()">Logout</button>
</div>
</header>

<main>

<section class="card hero">
<small>365-DAY ENGLISH JOURNEY</small>
<h1 id="welcome">Welcome 👋</h1>
<p>Learn English one day at a time.</p>

<div class="progressTop">
<span>Course Progress</span>
<span id="heroPct">0%</span>
</div>

<div class="track">
<div id="heroBar"></div>
</div>
</section>

<div class="stats">

<div class="stat">
<small>NEXT DAY</small>
<b id="nextDay">1</b>
</div>

<div class="stat">
<small>STUDENT ID</small>
<b id="sid">-</b>
</div>

<div class="stat">
<small>MEMBERSHIP</small>
<b id="member">Checking...</b>
</div>

</div>

<section class="card">

<div class="title">🎓 Learning Progress</div>

<div class="progressTop2">
<span>Day <b id="completed">0</b> / 365</span>
<span id="pct">0%</span>
</div>

<div class="progress">
<div id="bar"></div>
</div>

<p class="muted" style="margin-top:6px">
Complete one lesson and 5 questions each day.
</p>

</section>

<section class="menu">

<a class="menuCard lessonCard" href="daily-lesson.html">
<div class="icon">📖</div>
<div class="menuText">
<b>Daily Lesson</b>
<span>Learn today's lesson and complete 5 questions.</span>
</div>
<div class="arrow">›</div>
</a>

<a class="menuCard statusCard" href="student-status.html">
<div class="icon">👤</div>
<div class="menuText">
<b>Student Status</b>
<span>View progress, membership and certificate status.</span>
</div>
<div class="arrow">›</div>
</a>

<a class="menuCard affiliateCard" href="affiliate.html">
<div class="icon">💰</div>
<div class="menuText">
<b>Affiliate & Balance</b>
<span>Check referrals, commission and available balance.</span>
</div>
<div class="arrow">›</div>
</a>

</section>

<footer>© 2026 CreateLK Academy</footer>

</main>

<div class="msg" id="msg"></div>

<script>

const COURSE_API =
"https://createlk-course-lessons.createlk.workers.dev";

const ACCOUNT_API =
"https://createlk-auth.createlk.workers.dev";

let student={};
let completed=0;


/* =========================
LOAD LOCAL STUDENT
========================= */

try{

student=
JSON.parse(
localStorage.getItem("createlk_student")||"{}"
);

}catch(e){

student={};

}


/* =========================
STUDENT ID
========================= */

function studentId(){

return Number(
student.id||
student.database_id||
student.student_id_number||
0
);

}


/* =========================
REFRESH STUDENT FROM CLOUD
========================= */

async function refreshStudent(){

const id=studentId();

if(!id)return;


/*
IMPORTANT:
This endpoint must return the
latest student record from D1.
*/

try{

const response=
await fetch(
ACCOUNT_API+
"/api/student?id="+
encodeURIComponent(id),
{
cache:"no-store"
}
);

if(!response.ok){

console.warn(
"Student refresh failed:",
response.status
);

return;

}

const data=
await response.json();

console.log(
"Latest student:",
data
);

if(
data.success &&
data.student
){

student={
...student,
...data.student
};

localStorage.setItem(
"createlk_student",
JSON.stringify(student)
);

}

}catch(error){

console.error(
"Student refresh error:",
error
);

}

}


/* =========================
PROGRESS
========================= */

async function getProgress(){

const id=studentId();

if(!id)return 0;

try{

const response=
await fetch(
COURSE_API+
"/api/progress?student_id="+
encodeURIComponent(id),
{
cache:"no-store"
}
);

const data=
await response.json();

if(
response.ok &&
data.success
){

completed=
Math.min(
365,
Number(
data.completed_lessons||0
)
);

student.completed_lessons=
completed;

localStorage.setItem(
"createlk_student",
JSON.stringify(student)
);

return completed;

}

}catch(error){

console.error(
"Progress error:",
error
);

}

return Number(
student.completed_lessons||0
);

}


/* =========================
DASHBOARD
========================= */

function updateDashboard(){

const first=
student.first_name||"";

const last=
student.last_name||"";

const name=
`${first} ${last}`.trim()||
student.name||
"Student";

const percent=
Math.round(
completed/365*100
);

const next=
Math.min(
365,
completed+1
);

document.getElementById(
"welcome"
).textContent=
`Welcome, ${name} 👋`;

document.getElementById(
"sid"
).textContent=
student.student_id||
student.studentId||
studentId()||
"-";

const status=
String(
student.membership_status||
student.membershipStatus||
"FREE"
).toUpperCase();

document.getElementById(
"member"
).textContent=
status==="PREMIUM"
?"✓ Premium"
:"Free";

document.getElementById(
"completed"
).textContent=
completed;

document.getElementById(
"nextDay"
).textContent=
next;

document.getElementById(
"pct"
).textContent=
percent+"%";

document.getElementById(
"heroPct"
).textContent=
percent+"%";

document.getElementById(
"bar"
).style.width=
percent+"%";

document.getElementById(
"heroBar"
).style.width=
percent+"%";

}


/* =========================
LOGOUT
========================= */

function logout(){

localStorage.removeItem(
"createlk_student"
);

localStorage.removeItem(
"createlk_user"
);

location.href="login.html";

}


/* =========================
START
========================= */

async function start(){

if(!studentId()){

show(
"Please login again."
);

setTimeout(
()=>{
location.href="login.html";
},
1200
);

return;

}


/*
FIRST:
Get latest Premium status
from Cloudflare.
*/

await refreshStudent();


/*
SECOND:
Get latest learning progress.
*/

completed=
await getProgress();


/*
THIRD:
Display everything.
*/

updateDashboard();

}


function show(message){

const el=
document.getElementById("msg");

el.textContent=
message;

el.style.display=
"block";

clearTimeout(
window.msgTimer
);

window.msgTimer=
setTimeout(
()=>{
el.style.display="none";
},
2500
);

}

start();

</script>

</body>
</html>