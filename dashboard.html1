<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#2563eb">
<title>CreateLK Academy</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}

:root{
 --blue:#2563eb;
 --purple:#7c3aed;
 --green:#059669;
 --dark:#0f172a;
 --muted:#64748b;
 --line:#e2e8f0;
 --bg:#f6f8fc
}

body{
 font-family:system-ui,sans-serif;
 background:var(--bg);
 color:var(--dark)
}

header{
 background:#fff;
 border-bottom:1px solid var(--line);
 position:sticky;
 top:0;
 z-index:10
}

.nav{
 max-width:720px;
 margin:auto;
 padding:10px 12px;
 display:flex;
 justify-content:space-between;
 align-items:center
}

.logo{
 color:var(--blue);
 font-weight:800;
 text-decoration:none;
 font-size:15px
}

.logo span{color:var(--purple)}

.logout{
 border:1px solid var(--line);
 background:#fff;
 border-radius:8px;
 padding:7px 11px;
 font-weight:700;
 cursor:pointer
}

main{
 max-width:720px;
 margin:auto;
 padding:10px
}

.card{
 background:#fff;
 border:1px solid var(--line);
 border-radius:13px;
 padding:14px;
 margin-bottom:10px
}

/* HERO */
.hero{
 background:linear-gradient(135deg,#2563eb,#7c3aed);
 color:#fff;
 border:0
}

.hero small{
 font-size:8px;
 font-weight:800;
 letter-spacing:.4px
}

.hero h1{
 font-size:20px;
 margin:4px 0
}

.hero p{
 font-size:11px;
 opacity:.9
}

.progressTop{
 display:flex;
 justify-content:space-between;
 font-size:9px;
 margin-top:15px;
 margin-bottom:5px
}

.track{
 height:7px;
 background:#ffffff35;
 border-radius:20px;
 overflow:hidden
}

.track div{
 height:100%;
 width:0;
 background:#fff;
 border-radius:20px;
 transition:.4s
}

/* STATS */
.stats{
 display:grid;
 grid-template-columns:repeat(3,1fr);
 gap:6px;
 margin-bottom:10px
}

.stat{
 background:#fff;
 border:1px solid var(--line);
 border-radius:9px;
 padding:9px 5px;
 text-align:center
}

.stat small{
 display:block;
 color:var(--muted);
 font-size:7px;
 font-weight:800
}

.stat b{
 display:block;
 margin-top:2px;
 font-size:11px
}

/* PROGRESS */
.title{
 font-size:13px;
 font-weight:800;
 margin-bottom:6px
}

.progressTop2{
 display:flex;
 justify-content:space-between;
 font-size:9px;
 margin-bottom:5px
}

.progress{
 height:7px;
 background:#eaf0f7;
 border-radius:20px;
 overflow:hidden
}

.progress div{
 height:100%;
 width:0;
 background:linear-gradient(90deg,var(--blue),var(--purple));
 border-radius:20px
}

.muted{
 font-size:10px;
 color:var(--muted)
}

/* NAVIGATION */
.menu{
 margin-top:4px
}

.menuCard{
 display:flex;
 align-items:center;
 gap:12px;
 padding:14px;
 border-radius:13px;
 margin-bottom:8px;
 text-decoration:none;
 background:#fff;
 border:1px solid var(--line);
 transition:.15s
}

.menuCard:active{
 transform:scale(.98)
}

.icon{
 width:44px;
 height:44px;
 border-radius:11px;
 display:flex;
 align-items:center;
 justify-content:center;
 font-size:21px;
 flex-shrink:0
}

.menuText{
 flex:1
}

.menuText b{
 display:block;
 font-size:13px;
 margin-bottom:2px
}

.menuText span{
 display:block;
 font-size:9px;
 color:var(--muted)
}

.arrow{
 font-size:20px;
 font-weight:700
}

/* BLUE */
.lessonCard{
 border-left:4px solid var(--blue)
}

.lessonCard .icon{
 background:#eff6ff
}

.lessonCard .arrow{
 color:var(--blue)
}

/* PURPLE */
.statusCard{
 border-left:4px solid var(--purple)
}

.statusCard .icon{
 background:#f5f3ff
}

.statusCard .arrow{
 color:var(--purple)
}

/* GREEN */
.affiliateCard{
 border-left:4px solid var(--green)
}

.affiliateCard .icon{
 background:#ecfdf5
}

.affiliateCard .arrow{
 color:var(--green)
}

/* MESSAGE */
.msg{
 display:none;
 position:fixed;
 bottom:15px;
 left:50%;
 transform:translateX(-50%);
 background:var(--dark);
 color:#fff;
 padding:9px 13px;
 border-radius:8px;
 font-size:10px;
 z-index:50
}

footer{
 text-align:center;
 color:var(--muted);
 font-size:8px;
 padding:5px 0 15px
}

@media(max-width:400px){
 .hero h1{font-size:18px}
 .menuCard{padding:12px}
 .icon{width:40px;height:40px}
}
</style>
</head>

<body>

<header>
 <div class="nav">
  <a class="logo" href="index.html">
   📚 CreateLK <span>Academy</span>
  </a>

  <button class="logout" onclick="logout()">Logout</button>
 </div>
</header>

<main>

<!-- HERO -->
<section class="card hero">

 <small>365-DAY ENGLISH JOURNEY</small>

 <h1 id="welcome">Welcome 👋</h1>

 <p>Learn English one day at a time.</p>

 <div class="progressTop">
  <span>Course Progress</span>
  <span id="heroPct">0%</span>
 </div>

 <div class="track">
  <div id="heroBar"></div>
 </div>

</section>


<!-- QUICK STATS -->
<div class="stats">

 <div class="stat">
  <small>NEXT DAY</small>
  <b id="nextDay">1</b>
 </div>

 <div class="stat">
  <small>STUDENT ID</small>
  <b id="sid">-</b>
 </div>

 <div class="stat">
  <small>MEMBERSHIP</small>
  <b id="member">Free</b>
 </div>

</div>


<!-- PROGRESS -->
<section class="card">

 <div class="title">🎓 Learning Progress</div>

 <div class="progressTop2">
  <span>Day <b id="completed">0</b> / 365</span>
  <span id="pct">0%</span>
 </div>

 <div class="progress">
  <div id="bar"></div>
 </div>

 <p class="muted" style="margin-top:6px">
  Complete one lesson and 5 questions each day.
 </p>

</section>


<!-- THREE MAIN SECTIONS -->
<section class="menu">

 <a class="menuCard lessonCard" href="daily-lesson.html">

  <div class="icon">📖</div>

  <div class="menuText">
   <b>Daily Lesson</b>
   <span>
    Learn today's lesson and complete 5 questions.
   </span>
  </div>

  <div class="arrow">›</div>

 </a>


 <a class="menuCard statusCard" href="student-status.html">

  <div class="icon">👤</div>

  <div class="menuText">
   <b>Student Status</b>
   <span>
    View progress, membership and certificate status.
   </span>
  </div>

  <div class="arrow">›</div>

 </a>


 <a class="menuCard affiliateCard" href="affiliate.html">

  <div class="icon">💰</div>

  <div class="menuText">
   <b>Affiliate & Balance</b>
   <span>
    Check referrals, commission and available balance.
   </span>
  </div>

  <div class="arrow">›</div>

 </a>

</section>


<footer>
 © 2026 CreateLK Academy
</footer>

</main>

<div class="msg" id="msg"></div>


<script>

const COURSE=
"https://createlk-course-lessons.createlk.workers.dev";

let student={};
let completed=0;


/* LOAD LOGIN DATA */
try{
 student=JSON.parse(
  localStorage.getItem("createlk_student")||"{}"
 );
}catch(e){
 student={}
}


/* STUDENT ID */
function studentId(){
 return Number(
  student.id||
  student.database_id||
  student.student_id_number||
  0
 );
}


/* LOCAL PROGRESS */
function localCompleted(){
 return Math.max(
  0,
  Number(
   student.completed_lessons||
   student.completedLessons||
   0
  )
 );
}


/* PREMIUM */
function premium(){

 const status=String(
  student.membership_status||
  student.membershipStatus||
  "FREE"
 ).toUpperCase();

 return status==="PREMIUM";
}


/* TEXT */
function text(id,value){
 const el=document.getElementById(id);
 if(el)el.textContent=value;
}


/* MESSAGE */
function show(value){

 const m=document.getElementById("msg");

 m.textContent=value;
 m.style.display="block";

 clearTimeout(window.msgTimer);

 window.msgTimer=setTimeout(()=>{
  m.style.display="none";
 },2500);

}


/* GET REAL CLOUDFLARE PROGRESS */
async function getProgress(){

 const id=studentId();

 if(!id)
  return localCompleted();

 try{

  const r=await fetch(
   `${COURSE}/api/progress?student_id=${id}`
  );

  const d=await r.json();

  if(r.ok&&d.success){

   completed=Math.min(
    365,
    Number(d.completed_lessons||0)
   );

   student.completed_lessons=completed;

   localStorage.setItem(
    "createlk_student",
    JSON.stringify(student)
   );

   return completed;
  }

 }catch(e){}

 return localCompleted();

}


/* UPDATE DASHBOARD */
function dashboard(){

 const first=student.first_name||"";
 const last=student.last_name||"";

 const full=
  `${first} ${last}`.trim()||
  student.name||
  "Student";

 const pct=Math.round(
  completed/365*100
 );

 const next=Math.min(
  365,
  completed+1
 );


 text(
  "welcome",
  `Welcome, ${full} 👋`
 );

 text(
  "sid",
  student.student_id||
  student.studentId||
  studentId()||
  "-"
 );

 text(
  "member",
  premium()?"Premium":"Free"
 );

 text(
  "completed",
  completed
 );

 text(
  "nextDay",
  next
 );

 text(
  "pct",
  pct+"%"
 );

 text(
  "heroPct",
  pct+"%"
 );

 document.getElementById(
  "bar"
 ).style.width=pct+"%";

 document.getElementById(
  "heroBar"
 ).style.width=pct+"%";

}


/* LOGOUT */
function logout(){

 localStorage.removeItem(
  "createlk_student"
 );

 localStorage.removeItem(
  "createlk_user"
 );

 location.href="login.html";

}


/* START */
async function start(){

 if(!studentId()){

  show("Please login again.");

  setTimeout(()=>{
   location.href="login.html";
  },1200);

  return;
 }

 completed=await getProgress();

 dashboard();

}


start();

</script>

</body>
</html>