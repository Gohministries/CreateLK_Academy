<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#2563eb">
<title>CreateLK Academy</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{--b:#2563eb;--p:#7c3aed;--g:#10b981;--d:#0f172a;--m:#64748b;--l:#e2e8f0}
body{font-family:system-ui,sans-serif;background:#f6f8fc;color:var(--d)}
header{position:sticky;top:0;z-index:10;background:#fff;border-bottom:1px solid var(--l)}
.nav,main{max-width:720px;margin:auto}
.nav{padding:10px 12px;display:flex;justify-content:space-between;align-items:center}
.logo{color:var(--b);font-weight:800;text-decoration:none}.logo span{color:var(--p)}
.logout{padding:7px 11px;border:1px solid var(--l);border-radius:8px;background:#fff;font-weight:700}
main{padding:10px}
.card{background:#fff;border:1px solid var(--l);border-radius:13px;padding:14px;margin-bottom:10px}
.hero{background:linear-gradient(135deg,var(--b),var(--p));color:#fff;border:0}
.hero small{font-size:8px;font-weight:800}.hero h1{font-size:20px;margin:3px 0}.hero p{font-size:11px}
.row{display:flex;align-items:end;gap:12px;margin-top:14px}.grow{flex:1}
.top{display:flex;justify-content:space-between;font-size:9px;margin-bottom:5px}
.track,.progress{height:7px;border-radius:20px;overflow:hidden;background:#eaf0f7}
.track{background:#ffffff35}.track div{height:100%;background:#fff;width:0}
.progress div{height:100%;background:linear-gradient(90deg,var(--b),var(--p));width:0}
.daynum{text-align:right}.daynum b{display:block;font-size:20px}.daynum small{font-size:7px}
.stats,.earnings{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin-bottom:10px}
.stat,.earn{background:#fff;border:1px solid var(--l);border-radius:9px;padding:8px;text-align:center}
.stat small,.earn small,.account small{display:block;color:var(--m);font-size:7px;font-weight:800}
.stat b,.earn b{font-size:11px}
.title{font-size:13px;font-weight:800;margin-bottom:6px}
.muted{font-size:10px;color:var(--m)}
.next{background:linear-gradient(135deg,#eff6ff,#f5f3ff);border-color:#c7d2fe}
.nextday{font-size:24px;font-weight:800;color:var(--b);margin:5px 0}
.btn{width:100%;height:42px;border:0;border-radius:9px;margin-top:10px;font-size:11px;font-weight:800;cursor:pointer}
.dark{background:var(--d);color:#fff}
.pay{background:linear-gradient(135deg,var(--b),var(--p));color:#fff}
.share{background:var(--g);color:#fff}
.price{font-size:21px;font-weight:800;color:var(--p);margin:5px 0}
.price small{font-size:9px;color:var(--m)}
.success{margin-top:9px;padding:10px;border-radius:8px;text-align:center;font-size:10px;font-weight:700;background:#f0fdf4;border:1px solid #bbf7d0;color:#166534}
.refbox{display:flex;gap:5px;margin-top:7px}
.refbox input{flex:1;min-width:0;padding:9px;border:1px solid var(--l);border-radius:8px;font-size:9px}
.copy{border:0;background:#f59e0b;color:#fff;border-radius:8px;padding:0 11px;font-weight:800}
.account{display:grid;grid-template-columns:1fr 1fr;gap:6px}
.account div{padding:7px;background:#f8fafc;border:1px solid var(--l);border-radius:7px}
.account b{font-size:9px;overflow-wrap:anywhere}
.msg{display:none;position:fixed;bottom:15px;left:50%;transform:translateX(-50%);background:var(--d);color:#fff;padding:9px 13px;border-radius:8px;font-size:10px;z-index:50}
footer{text-align:center;color:var(--m);font-size:8px;padding:3px 0 15px}
@media(max-width:400px){.account{grid-template-columns:1fr}}
</style>
</head>

<body>

<header>
<div class="nav">
<a class="logo" href="dashboard.html">📚 CreateLK <span>Academy</span></a>
<button class="logout" onclick="logout()">Logout</button>
</div>
</header>

<main>

<section class="card hero">
<small>365-DAY ENGLISH JOURNEY</small>
<h1 id="welcome">Welcome 👋</h1>
<p>Learn English one day at a time.</p>

<div class="row">
<div class="grow">
<div class="top">
<span>Course Progress</span>
<span id="heroPct">0%</span>
</div>
<div class="track"><div id="heroBar"></div></div>
</div>

<div class="daynum">
<b id="currentDay">1</b>
<small>NEXT DAY</small>
</div>
</div>
</section>

<div class="stats">
<div class="stat">
<small>STUDENT ID</small>
<b id="sid">-</b>
</div>

<div class="stat">
<small>LESSONS</small>
<b id="done">0</b>
</div>

<div class="stat">
<small>MEMBERSHIP</small>
<b id="member">Free</b>
</div>
</div>

<section class="card">
<div class="title">🎓 Learning Progress</div>

<div class="top">
<span>Day <span id="progressDay">0</span> / 365</span>
<span id="pct">0%</span>
</div>

<div class="progress">
<div id="bar"></div>
</div>

<p class="muted" style="margin-top:6px">
Complete one lesson and 5 questions each day.
</p>
</section>

<section class="card next">
<div class="title">📖 Today's Learning</div>
<div class="nextday">DAY <span id="nextDay">1</span></div>
<p class="muted">Open Daily Lesson to continue.</p>

<button class="btn dark" onclick="openLesson()">
📝 Go to Daily Lesson & Questions
</button>
</section>

<section class="card">
<div class="title">⭐ Premium Membership</div>
<p class="muted">
Complete access to the 365-day English curriculum.
</p>

<div class="price">
LKR 1,500 <small>/ 30 days</small>
</div>

<button class="btn pay" id="pay" onclick="checkout()">
💳 Pay LKR 1,500 with PayHere
</button>

<div id="active" class="success" style="display:none">
✅ Premium membership is active.
</div>
</section>

<section class="card">
<div class="title">💰 Referral Program</div>

<p class="muted">
Earn 20% commission from verified Premium payments.
</p>

<div class="refbox">
<input id="ref" readonly>
<button class="copy" onclick="copyRef()">Copy</button>
</div>

<button class="btn share" onclick="shareRef()">
📤 Share via WhatsApp
</button>

<div class="earnings">
<div class="earn">
<small>REFERRALS</small>
<b id="refs">0</b>
</div>

<div class="earn">
<small>PENDING</small>
<b id="pending">LKR 0</b>
</div>

<div class="earn">
<small>PAID</small>
<b id="paid">LKR 0</b>
</div>
</div>
</section>

<section class="card">
<div class="title">👤 Account</div>

<div class="account">
<div>
<small>NAME</small>
<b id="name">-</b>
</div>

<div>
<small>EMAIL</small>
<b id="email">-</b>
</div>

<div>
<small>PHONE</small>
<b id="phone">-</b>
</div>

<div>
<small>PREMIUM EXPIRY</small>
<b id="expiry">Not active</b>
</div>
</div>
</section>

<footer>© 2026 CreateLK Academy</footer>

</main>

<div class="msg" id="msg"></div>

<script>
const COURSE="https://createlk-course-lessons.createlk.workers.dev";
const PAY="https://createlk-premium-payments.createlk.workers.dev";
const REF="https://createlk-referrals.createlk.workers.dev";

let student={};
let completed=0;

try{
 student=JSON.parse(
  localStorage.getItem("createlk_student")||"{}"
 );
}catch{}

function id(){
 return Number(
  student.id||
  student.database_id||
  student.student_id_number||
  0
 );
}

function localProgress(){
 return Math.max(
  0,
  Number(
   student.completed_lessons||
   student.completedLessons||
   0
  )
 );
}

function isPremium(){
 return String(
  student.membership_status||
  student.membershipStatus||
  "FREE"
 ).toUpperCase()==="PREMIUM";
}

function text(x,v){
 const e=document.getElementById(x);
 if(e)e.textContent=v;
}

function show(v){
 const m=document.getElementById("msg");
 m.textContent=v;
 m.style.display="block";
 clearTimeout(window.msgTimer);
 window.msgTimer=setTimeout(
  ()=>m.style.display="none",2500
 );
}

async function getProgress(){
 if(!id())return localProgress();

 try{
  const r=await fetch(
   `${COURSE}/api/progress?student_id=${id()}`
  );

  const d=await r.json();

  if(r.ok&&d.success){
   completed=Math.min(
    365,
    Number(d.completed_lessons||0)
   );

   student.completed_lessons=completed;

   localStorage.setItem(
    "createlk_student",
    JSON.stringify(student)
   );

   return completed;
  }
 }catch(e){}

 return localProgress();
}

function render(){
 const full=(
  `${student.first_name||""} ${student.last_name||""}`
 ).trim()||student.name||"Student";

 const next=Math.min(365,completed+1);
 const pct=Math.round(completed/365*100);

 text("welcome",`Welcome, ${full} 👋`);
 text("sid",
  student.student_id||
  student.studentId||
  id()||
  "-"
 );
 text("done",completed);
 text("member",isPremium()?"Premium":"Free");

 text("progressDay",completed);
 text("nextDay",next);
 text("currentDay",next);

 text("pct",pct+"%");
 text("heroPct",pct+"%");

 document.getElementById("bar").style.width=pct+"%";
 document.getElementById("heroBar").style.width=pct+"%";

 text("name",full);
 text("email",student.email||"-");
 text("phone",student.phone||"-");
 text(
  "expiry",
  student.membership_expiry||
  student.membershipExpiry||
  "Not active"
 );

 document.getElementById("pay").style.display=
  isPremium()?"none":"block";

 document.getElementById("active").style.display=
  isPremium()?"block":"none";

 document.getElementById("ref").value=
  `${location.origin}/register.html?ref=${id()}`;
}

function openLesson(){
 location.href="daily-lesson.html";
}

async function checkout(){
 if(!id())return show("Please login again.");

 const btn=document.getElementById("pay");

 btn.disabled=true;
 btn.textContent="Opening PayHere...";

 try{
  const r=await fetch(
   `${PAY}/api/checkout`,
   {
    method:"POST",
    headers:{"Content-Type":"application/json"},
    body:JSON.stringify({student_id:id()})
   }
  );

  const raw=await r.text();

  if(!r.ok)throw Error("Unable to open PayHere.");

  if(raw.includes("<form")){
   document.open();
   document.write(raw);
   document.close();
   return;
  }

  const d=JSON.parse(raw);

  if(d.url||d.checkout_url){
   location.href=d.url||d.checkout_url;
   return;
  }

  throw Error(
   d.message||"Invalid payment response."
  );

 }catch(e){
  show(e.message);
  btn.disabled=false;
  btn.textContent="💳 Pay LKR 1,500 with PayHere";
 }
}

async function earnings(){
 try{
  const r=await fetch(
   `${REF}/api/earnings?student_id=${id()}`
  );

  const d=await r.json();

  if(d.success){
   text("refs",d.referrals||0);
   text(
    "pending",
    "LKR "+Number(d.pending||0).toLocaleString()
   );
   text(
    "paid",
    "LKR "+Number(d.paid||0).toLocaleString()
   );
  }
 }catch(e){}
}

async function copyRef(){
 const x=document.getElementById("ref");

 try{
  await navigator.clipboard.writeText(x.value);
 }catch{
  x.select();
  document.execCommand("copy");
 }

 show("Referral link copied!");
}

function shareRef(){
 const link=document.getElementById("ref").value;

 window.open(
  "https://wa.me/?text="+
  encodeURIComponent(
   "Join CreateLK Academy!\n"+link
  ),
  "_blank"
 );
}

function logout(){
 localStorage.removeItem("createlk_student");
 localStorage.removeItem("createlk_user");
 location.href="login.html";
}

async function start(){
 if(!id()){
  location.href="login.html";
  return;
 }

 completed=await getProgress();
 render();
 earnings();
}

start();
</script>

</body>
</html>