<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Student Dashboard | CreateLK Academy</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}
body{
font-family:Arial,sans-serif;
background:linear-gradient(135deg,#eef4ff,#fff0f8);
color:#172033
}
header{
background:#fff;
padding:14px 18px;
border-bottom:1px solid #e5e7eb;
display:flex;
justify-content:space-between;
align-items:center;
position:sticky;
top:0;
z-index:10
}
.logo{font-weight:900;color:#155eef}
.logo span{color:#7c3aed}
.logout{
border:1px solid #fecdd3;
background:#fff1f2;
color:#be123c;
padding:8px 13px;
border-radius:9px;
font-weight:800
}
.app{max-width:700px;margin:auto;padding:18px 14px 30px}
.welcome{margin-bottom:16px}
.welcome h1{font-size:24px;margin-bottom:5px}
.welcome p{font-size:13px;color:#667085}

.card{
background:#fff;
border-radius:18px;
padding:18px;
margin-bottom:14px;
box-shadow:0 8px 25px #10182812
}

.grid{
display:grid;
grid-template-columns:1fr 1fr;
gap:10px
}
.info{
background:#f8fafc;
padding:11px;
border-radius:10px
}
.info small{
display:block;
color:#667085;
font-size:11px;
margin-bottom:4px
}
.info strong{font-size:13px;word-break:break-word}

.premium{
color:#fff;
background:linear-gradient(135deg,#7c3aed,#155eef,#ec4899);
border-radius:18px;
padding:20px;
position:relative;
overflow:hidden
}
.premium h2{font-size:19px}
.premium p{font-size:13px;margin-top:5px;opacity:.9}
.status{
display:inline-block;
margin-top:12px;
padding:5px 10px;
border-radius:20px;
background:#ffffff25;
font-size:11px;
font-weight:900
}
.upgrade{
width:100%;
margin-top:14px;
padding:12px;
border:0;
border-radius:10px;
background:#fff;
color:#7c3aed;
font-weight:900;
font-size:14px
}

.progress-title{
display:flex;
justify-content:space-between;
font-size:14px;
font-weight:800
}
.bar{
height:9px;
background:#edf0f5;
border-radius:20px;
margin-top:10px;
overflow:hidden
}
.fill{
height:100%;
background:linear-gradient(90deg,#155eef,#7c3aed,#ec4899);
width:0%
}
.note{
font-size:11px;
color:#667085;
margin-top:7px
}

.day{
display:inline-block;
background:#eef4ff;
color:#155eef;
padding:5px 9px;
border-radius:8px;
font-size:11px;
font-weight:900
}
.lesson h2{font-size:21px;margin:10px 0 4px}
.level{font-size:12px;color:#667085}
.content{
font-size:14px;
line-height:1.6;
margin-top:12px;
white-space:pre-line
}
.section{margin-top:15px}
.section h3{font-size:14px;margin-bottom:5px}
.section p{
font-size:13px;
line-height:1.6;
white-space:pre-line;
color:#475467
}

.question{
background:#f8fafc;
border:1px solid #edf0f5;
padding:14px;
border-radius:12px;
margin-top:10px
}
.question b{
font-size:13px;
line-height:1.5
}
.option{
display:block;
width:100%;
text-align:left;
margin-top:6px;
padding:9px;
border:1px solid #d0d5dd;
border-radius:8px;
background:#fff;
font-size:12px
}
.option.selected{
background:#eef4ff;
border-color:#155eef;
color:#155eef;
font-weight:800
}
.option.correct{
background:#ecfdf3;
border-color:#10b981
}
.option.wrong{
background:#fff1f2;
border-color:#f43f5e
}
.submit{
width:100%;
margin-top:12px;
padding:12px;
border:0;
border-radius:10px;
background:linear-gradient(135deg,#155eef,#7c3aed);
color:#fff;
font-weight:900
}
.message{
padding:15px;
text-align:center;
background:#f8fafc;
border-radius:12px;
font-size:13px;
color:#667085
}
footer{text-align:center;color:#98a2b3;font-size:11px;padding:15px}

@media(max-width:450px){
.grid{grid-template-columns:1fr 1fr}
.welcome h1{font-size:22px}
}
</style>
</head>

<body>

<header>
<div class="logo">📚 CreateLK <span>Academy</span></div>
<button class="logout" id="logout">Logout</button>
</header>

<div class="app">

<div class="welcome">
<h1 id="welcome">Welcome 👋</h1>
<p>Continue your 365-day English learning journey.</p>
</div>

<div class="card">
<div class="grid">
<div class="info">
<small>Student ID</small>
<strong id="studentId">-</strong>
</div>

<div class="info">
<small>Email</small>
<strong id="email">-</strong>
</div>

<div class="info">
<small>Phone</small>
<strong id="phone">-</strong>
</div>

<div class="info">
<small>Account</small>
<strong>Active</strong>
</div>
</div>
</div>

<div class="premium card">
<h2 id="membership">🎓 Free Member</h2>
<p id="membershipText">
Days 1–7 are free. Upgrade to unlock Days 8–365.
</p>

<div class="status" id="status">FREE</div>

<button class="upgrade" id="upgrade">
⭐ Upgrade Premium — LKR 1,500
</button>
</div>

<div class="card">
<div class="progress-title">
<span>🎓 Certificate Progress</span>
<span id="progress">1 / 365</span>
</div>

<div class="bar">
<div class="fill" id="fill"></div>
</div>

<div class="note">
Complete all 365 daily lessons to unlock your certificate.
</div>
</div>

<div class="card">

<span class="day" id="day">DAY 1</span>

<h2 id="title">Loading lesson...</h2>

<div class="level" id="level"></div>

<div class="content" id="lesson">
Loading...
</div>

<div class="section" id="vocabBox" style="display:none">
<h3>🧠 Vocabulary</h3>
<p id="vocab"></p>
</div>

<div class="section" id="examplesBox" style="display:none">
<h3>💬 Examples</h3>
<p id="examples"></p>
</div>

<div class="section" id="speakingBox" style="display:none">
<h3>🗣️ Speaking Practice</h3>
<p id="speaking"></p>
</div>

</div>

<div class="card">

<h2>📝 Daily Quiz — 5 Questions</h2>

<div id="quiz">
<div class="message">Loading questions...</div>
</div>

</div>

<footer>© 2026 CreateLK Academy</footer>

</div>

<script>

/* ==============================
   CONFIG
============================== */

const LESSON_API =
"https://createlk-course-lessons.createlk.workers.dev";

const PAYHERE_URL =
"https://createlk-payhere-checkout.createlk.workers.dev";

const STUDENT_KEY =
"createlk_student";


/* ==============================
   STUDENT
============================== */

function getStudent(){

let data =
localStorage.getItem(STUDENT_KEY) ||
sessionStorage.getItem(STUDENT_KEY);

try{
return data ? JSON.parse(data) : null;
}catch{
return null;
}

}

const student = getStudent();

if(!student){
location.href="login.html";
}


/* ==============================
   DISPLAY STUDENT
============================== */

if(student){

const name =
student.name ||
(
(student.first_name || "") +
" " +
(student.last_name || "")
).trim() ||
"Student";

document.getElementById("welcome").textContent =
"Welcome, " + name + " 👋";

let id =
student.student_id ||
student.id ||
"";

id =
String(id).replace(/\D/g,"");

document.getElementById("studentId").textContent =
id ? "CLA-" + id.padStart(6,"0") : "-";

document.getElementById("email").textContent =
student.email || "-";

document.getElementById("phone").textContent =
student.phone || "-";


const status =
String(student.membership_status || "FREE")
.toUpperCase();

if(status==="PREMIUM" || status==="ACTIVE"){

document.getElementById("membership").textContent =
"⭐ Premium Member";

document.getElementById("membershipText").textContent =
"Premium access is active.";

document.getElementById("status").textContent =
"PREMIUM";

document.getElementById("upgrade").style.display =
"none";

}

}


/* ==============================
   DAY
============================== */

let day =
Number(localStorage.getItem("createlk_completed_days") || 1);

if(day<1) day=1;
if(day>365) day=365;

document.getElementById("day").textContent =
"DAY " + day;

document.getElementById("progress").textContent =
day + " / 365";

document.getElementById("fill").style.width =
((day/365)*100) + "%";


/* ==============================
   PREMIUM
============================== */

function premium(){

const status =
String(student?.membership_status || "FREE")
.toUpperCase();

return status==="PREMIUM" || status==="ACTIVE";

}


/* ==============================
   PAYHERE
============================== */

document.getElementById("upgrade").onclick =
function(){

/*
 Directly opens your PayHere checkout Worker.
 Student ID and email are passed to it.
*/

const id =
student.student_id ||
student.id ||
"";

const email =
student.email ||
"";

const url =
PAYHERE_URL +
"?student_id=" +
encodeURIComponent(id) +
"&email=" +
encodeURIComponent(email);

window.location.href = url;

};


/* ==============================
   LOAD LESSON
============================== */

async function loadLesson(){

if(day>7 && !premium()){

document.getElementById("title").textContent =
"⭐ Premium Lesson";

document.getElementById("level").textContent =
"Days 8–365";

document.getElementById("lesson").textContent =
"Upgrade Premium to continue your English course.";

document.getElementById("quiz").innerHTML =
'<div class="message">🔒 Premium quiz. Upgrade to unlock.</div>';

return;

}

try{

const res =
await fetch(
LESSON_API +
"/api/daily-lesson?day=" +
day
);

const data =
await res.json();

if(!res.ok)
throw new Error(data.message || "Lesson unavailable");

const lesson =
data.lesson ||
data.data ||
data;

if(!lesson.title)
throw new Error("Lesson unavailable");


document.getElementById("title").textContent =
lesson.title;

document.getElementById("level").textContent =
lesson.level || "English Lesson";

document.getElementById("lesson").textContent =
lesson.lesson_text || lesson.lesson || "";

if(lesson.vocabulary){

document.getElementById("vocab").textContent =
lesson.vocabulary;

document.getElementById("vocabBox").style.display =
"block";

}

if(lesson.examples){

document.getElementById("examples").textContent =
lesson.examples;

document.getElementById("examplesBox").style.display =
"block";

}

if(lesson.speaking){

document.getElementById("speaking").textContent =
lesson.speaking;

document.getElementById("speakingBox").style.display =
"block";

}

loadQuestions();

}catch(e){

document.getElementById("lesson").textContent =
"⚠️ " + e.message;

document.getElementById("quiz").innerHTML =
'<div class="message">Questions are not available yet.</div>';

}

}


/* ==============================
   QUESTIONS
============================== */

async function loadQuestions(){

try{

const res =
await fetch(
LESSON_API +
"/api/daily-questions?day=" +
day
);

const data =
await res.json();

if(!res.ok)
throw new Error("Questions unavailable");

const questions =
(
data.questions ||
data.data ||
data
).slice(0,5);

if(!questions.length)
throw new Error("No questions");


const quiz =
document.getElementById("quiz");

quiz.innerHTML = "";

questions.forEach((q,i)=>{

const box =
document.createElement("div");

box.className="question";

box.dataset.answer =
String(q.correct_answer)
.toUpperCase();

box.innerHTML = `
<b>${i+1}. ${escapeHTML(q.question)}</b>

<button class="option" data-a="A">
A. ${escapeHTML(q.option_a)}
</button>

<button class="option" data-a="B">
B. ${escapeHTML(q.option_b)}
</button>

<button class="option" data-a="C">
C. ${escapeHTML(q.option_c)}
</button>

<button class="option" data-a="D">
D. ${escapeHTML(q.option_d)}
</button>
`;

quiz.appendChild(box);

});

document
.querySelectorAll(".option")
.forEach(btn=>{

btn.onclick=function(){

const parent =
btn.parentElement;

parent
.querySelectorAll(".option")
.forEach(x=>
x.classList.remove("selected")
);

btn.classList.add("selected");

};

});

const submit =
document.createElement("button");

submit.className="submit";
submit.textContent="Submit Quiz";

submit.onclick=checkQuiz;

quiz.appendChild(submit);

}catch(e){

document.getElementById("quiz").innerHTML =
'<div class="message">📝 Today\'s questions are not available yet.</div>';

}

}


/* ==============================
   QUIZ CHECK
============================== */

function checkQuiz(){

let score=0;
let answered=0;

document
.querySelectorAll(".question")
.forEach(q=>{

const selected =
q.querySelector(".selected");

if(!selected)return;

answered++;

const correct =
q.dataset.answer;

if(selected.dataset.a===correct){

score++;

selected.classList.add("correct");

}else{

selected.classList.add("wrong");

const right =
q.querySelector(
'[data-a="'+correct+'"]'
);

if(right)
right.classList.add("correct");

}

});

if(answered<5){

alert("Please answer all 5 questions.");

return;

}

alert(
"Quiz complete! Score: " +
score +
"/5"
);

}


/* ==============================
   ESCAPE HTML
============================== */

function escapeHTML(value){

return String(value || "")
.replace(/&/g,"&amp;")
.replace(/</g,"&lt;")
.replace(/>/g,"&gt;")
.replace(/"/g,"&quot;")
.replace(/'/g,"&#039;");

}


/* ==============================
   LOGOUT
============================== */

document.getElementById("logout").onclick =
function(){

localStorage.removeItem(STUDENT_KEY);
localStorage.removeItem("createlk_logged_in");

sessionStorage.removeItem(STUDENT_KEY);
sessionStorage.removeItem("createlk_logged_in");

location.href="login.html";

};


/* START */

loadLesson();

</script>

</body>
</html>