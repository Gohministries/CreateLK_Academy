
const COOKIE="english_v2_session",DAYS=7,AFFILIATE_TOKEN_MINUTES=2;

const cors=r=>({
  "Access-Control-Allow-Origin":r.headers.get("Origin")||"*",
  "Access-Control-Allow-Credentials":"true",
  "Access-Control-Allow-Methods":"GET,POST,OPTIONS",
  "Access-Control-Allow-Headers":"Content-Type,Authorization",
  "Vary":"Origin"
});

const json=(d,s=200,r)=>new Response(JSON.stringify(d),{
  status:s,
  headers:{"Content-Type":"application/json; charset=utf-8",
    "Cache-Control":"no-store",...cors(r)}
});

const ck=(r,n)=>{
  const x=(r.headers.get("Cookie")||"").match(
    new RegExp("(?:^|;\\s*)"+n+"=([^;]*)"));
  return x?decodeURIComponent(x[1]):null;
};

const rnd=(n=32)=>{
  const a=new Uint8Array(n);
  crypto.getRandomValues(a);
  return [...a].map(x=>x.toString(16).padStart(2,"0")).join("");
};

const prem=u=>String(u?.membership||"").trim().toLowerCase()==="premium";

async function me(r,e){
  const t=ck(r,COOKIE);
  if(!t)return null;
  return e.DB.prepare(`
    SELECT u.id,u.google_id,u.email,u.name,u.avatar_url,
      u.membership,u.affiliate_code,u.referred_by
    FROM users u JOIN sessions s ON s.user_id=u.id
    WHERE s.token=? AND s.expires_at>? LIMIT 1
  `).bind(t,new Date().toISOString()).first();
}

async function setup(e){
  await e.DB.prepare(`
    CREATE TABLE IF NOT EXISTS sessions(
      token TEXT PRIMARY KEY,
      user_id TEXT,
      expires_at TEXT,
      created_at TEXT DEFAULT CURRENT_TIMESTAMP
    )
  `).run();

  await e.DB.prepare(`
    CREATE TABLE IF NOT EXISTS referrals(
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      referrer_id TEXT,
      referred_user_id TEXT UNIQUE,
      affiliate_code TEXT,
      created_at TEXT DEFAULT CURRENT_TIMESTAMP
    )
  `).run();

  await e.DB.prepare(`
    CREATE TABLE IF NOT EXISTS lesson_notes(
      lesson_id INTEGER PRIMARY KEY,
      content TEXT NOT NULL DEFAULT '',
      updated_at TEXT DEFAULT CURRENT_TIMESTAMP
    )
  `).run();

  await e.DB.prepare(`
    CREATE TABLE IF NOT EXISTS lesson_subtitles(
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      lesson_id INTEGER NOT NULL,
      language TEXT NOT NULL,
      title TEXT NOT NULL DEFAULT '',
      content TEXT NOT NULL DEFAULT '',
      sort_order INTEGER NOT NULL DEFAULT 1,
      created_at TEXT DEFAULT CURRENT_TIMESTAMP,
      updated_at TEXT DEFAULT CURRENT_TIMESTAMP
    )
  `).run();

  await e.DB.prepare(`
    CREATE INDEX IF NOT EXISTS idx_subtitles_lesson
    ON lesson_subtitles(lesson_id,sort_order,id)
  `).run();
}

async function session(e,id){
  const t=rnd();
  const expiry=new Date(Date.now()+DAYS*86400000).toISOString();
  await e.DB.prepare(`
    INSERT INTO sessions(token,user_id,expires_at) VALUES(?,?,?)
  `).bind(t,id,expiry).run();
  return t;
}

function b64(a){
  return btoa(String.fromCharCode(...new Uint8Array(a)))
    .replace(/\+/g,"-").replace(/\//g,"_").replace(/=+$/,"");
}

async function affToken(id,secret){
  const p=b64(new TextEncoder().encode(JSON.stringify({
    user_id:id,exp:Date.now()+AFFILIATE_TOKEN_MINUTES*60000
  })));
  const k=await crypto.subtle.importKey(
    "raw",new TextEncoder().encode(secret),
    {name:"HMAC",hash:"SHA-256"},false,["sign"]);
  const sig=await crypto.subtle.sign(
    "HMAC",k,new TextEncoder().encode(p));
  return p+"."+b64(sig);
}

async function gtoken(e,code,uri){
  const r=await fetch("https://oauth2.googleapis.com/token",{
    method:"POST",
    headers:{"Content-Type":"application/x-www-form-urlencoded"},
    body:new URLSearchParams({
      client_id:e.GOOGLE_CLIENT_ID,
      client_secret:e.GOOGLE_CLIENT_SECRET,
      code,grant_type:"authorization_code",redirect_uri:uri
    })
  });
  if(!r.ok)throw Error("Google token failed");
  return r.json();
}

async function guser(t){
  const r=await fetch("https://www.googleapis.com/oauth2/v3/userinfo",{
    headers:{Authorization:`Bearer ${t}`}
  });
  if(!r.ok)throw Error("Google user failed");
  return r.json();
}

async function lessonAccess(id,r,e){
  const lesson=await e.DB.prepare(`
    SELECT id,title,description,is_free,status
    FROM lessons WHERE id=?
  `).bind(id).first();

  if(!lesson)return {error:"Lesson not found",status:404};

  const student=await me(r,e);

  if(Number(lesson.is_free)!==1&&!prem(student)){
    return {
      error:student?"Premium membership required":"Login required",
      status:student?403:401
    };
  }

  return {lesson,student};
}

export default {
  async fetch(r,e){
    const u=new URL(r.url);

    if(r.method==="OPTIONS"){
      return new Response(null,{status:204,headers:cors(r)});
    }

    try{
      if(!e.DB)return json({success:false,error:"D1 DB missing"},500,r);
      await setup(e);

      if(u.pathname==="/"){
        return new Response("CreateLK Academy Student API");
      }

      if(u.pathname==="/api/health"){
        return json({success:true,database:true},200,r);
      }

      /* GOOGLE LOGIN */
      if(u.pathname==="/auth/google"){
        const ref=(u.searchParams.get("ref")||"").trim().toUpperCase();
        const safe=/^[A-Z0-9_-]{3,100}$/.test(ref)?ref:"";
        const state=rnd()+(safe?"."+safe:"");
        const redirect=`${u.origin}/auth/google/callback`;
        const g=new URL("https://accounts.google.com/o/oauth2/v2/auth");

        Object.entries({
          client_id:e.GOOGLE_CLIENT_ID,
          redirect_uri:redirect,
          response_type:"code",
          scope:"openid email profile",
          access_type:"online",
          prompt:"select_account",
          state
        }).forEach(([k,v])=>g.searchParams.set(k,v));

        return new Response(null,{
          status:302,
          headers:{
            Location:g.toString(),
            "Set-Cookie":
              `oauth_state=${encodeURIComponent(state)};Path=/auth/google;Max-Age=600;HttpOnly;Secure;SameSite=Lax`
          }
        });
      }

      /* GOOGLE CALLBACK */
      if(u.pathname==="/auth/google/callback"){
        const code=u.searchParams.get("code");
        const state=u.searchParams.get("state")||"";

        if(!code||state!==ck(r,"oauth_state")){
          return json({success:false,error:"Invalid login"},400,r);
        }

        const ref=state.includes(".")
          ?state.split(".").slice(1).join(".").toUpperCase():"";
        const safe=/^[A-Z0-9_-]{3,100}$/.test(ref)?ref:"";

        const gt=await gtoken(e,code,`${u.origin}/auth/google/callback`);
        const g=await guser(gt.access_token);
        const gid=String(g.sub||"");
        const email=String(g.email||"").toLowerCase();

        if(!gid||!email)throw Error("Google account details missing");

        let user=await e.DB.prepare(`
          SELECT * FROM users WHERE google_id=? OR email=? LIMIT 1
        `).bind(gid,email).first();

        let id=user?.id;

        if(!user){
          id=crypto.randomUUID();
          const affiliateCode=rnd(6).toUpperCase();
          let referred=null,refid=null;

          if(safe){
            const a=await e.DB.prepare(`
              SELECT id,affiliate_code,email FROM users
              WHERE UPPER(affiliate_code)=? LIMIT 1
            `).bind(safe).first();

            if(a&&String(a.email).toLowerCase()!==email){
              referred=a.affiliate_code;
              refid=a.id;
            }
          }

          await e.DB.prepare(`
            INSERT INTO users(
              id,google_id,email,name,avatar_url,membership,
              xp,coins,correct_answers,questions_answered,
              lessons_completed,affiliate_code,referred_by
            ) VALUES(?,?,?,?,?,'free',0,0,0,0,0,?,?)
          `).bind(
            id,gid,email,g.name||email.split("@")[0],
            g.picture||null,affiliateCode,referred
          ).run();

          if(refid){
            await e.DB.prepare(`
              INSERT OR IGNORE INTO referrals(
                referrer_id,referred_user_id,affiliate_code
              ) VALUES(?,?,?)
            `).bind(refid,id,referred).run();
          }
        }else{
          id=user.id;
          await e.DB.prepare(`
            UPDATE users SET google_id=?,name=?,avatar_url=? WHERE id=?
          `).bind(gid,g.name||user.name,g.picture||user.avatar_url,id).run();

          if(safe&&!String(user.referred_by||"").trim()){
            const a=await e.DB.prepare(`
              SELECT id,affiliate_code,email FROM users
              WHERE UPPER(affiliate_code)=? LIMIT 1
            `).bind(safe).first();

            if(a&&String(a.id)!==String(id)&&
              String(a.email).toLowerCase()!==email){
              await e.DB.prepare(`
                UPDATE users SET referred_by=? WHERE id=?
              `).bind(a.affiliate_code,id).run();

              await e.DB.prepare(`
                INSERT OR IGNORE INTO referrals(
                  referrer_id,referred_user_id,affiliate_code
                ) VALUES(?,?,?)
              `).bind(a.id,id,a.affiliate_code).run();
            }
          }
        }

        const t=await session(e,id);
        const z=new Response(null,{
          status:302,
          headers:{Location:"https://createlk.com/v2/index.html"}
        });

        z.headers.append("Set-Cookie",
          `${COOKIE}=${t};Path=/;Max-Age=${DAYS*86400};HttpOnly;Secure;SameSite=None`);
        z.headers.append("Set-Cookie",
          "oauth_state=;Path=/auth/google;Max-Age=0;HttpOnly;Secure;SameSite=Lax");
        return z;
      }

      /* CURRENT STUDENT */
      if(u.pathname==="/api/me"){
        const x=await me(r,e);
        if(!x)return json({success:true,logged_in:false,user:null},200,r);

        const ref=await e.DB.prepare(`
          SELECT COUNT(*) n FROM referrals WHERE referrer_id=?
        `).bind(x.id).first();

        return json({
          success:true,
          logged_in:true,
          user:x,
          referral:{
            code:x.affiliate_code,
            referred_by:x.referred_by||null,
            count:Number(ref?.n)||0,
            link:`https://createlk.com/v2/?ref=${x.affiliate_code}`
          }
        },200,r);
      }

      /* AFFILIATE TOKEN */
      if(u.pathname==="/api/affiliate/token"){
        const x=await me(r,e);
        if(!x)return json({success:false,error:"Login required"},401,r);
        if(!e.AFFILIATE_SECRET){
          return json({success:false,error:"AFFILIATE_SECRET missing"},500,r);
        }
        return json({
          success:true,token:await affToken(x.id,e.AFFILIATE_SECRET)
        },200,r);
      }

      /* SUBJECT LIST */
      if(u.pathname==="/api/subjects"&&r.method==="GET"){
        const a=await e.DB.prepare(`
          SELECT s.id,s.name,s.slug,s.description,s.icon,s.display_order,
            COUNT(m.lesson_id) lesson_count
          FROM subjects s
          LEFT JOIN subject_lesson_map m ON m.subject_id=s.id
          WHERE s.is_active=1
          GROUP BY s.id,s.name,s.slug,s.description,s.icon,s.display_order
          ORDER BY s.display_order,s.id
        `).all();

        return json({
          success:true,
          subjects:(a.results||[]).map(s=>({
            ...s,lesson_count:Number(s.lesson_count)||0
          }))
        },200,r);
      }

      /* LESSON LIST */
      if(u.pathname==="/api/lessons"&&r.method==="GET"){
        const x=await me(r,e);
        const slug=(u.searchParams.get("subject")||"").trim();
        let a,subject=null;

        if(slug){
          subject=await e.DB.prepare(`
            SELECT id,name,slug,description,icon FROM subjects
            WHERE slug=? AND is_active=1 LIMIT 1
          `).bind(slug).first();

          if(!subject){
            return json({
              success:false,error:"Subject not found",lessons:[]
            },404,r);
          }

          a=await e.DB.prepare(`
            SELECT l.id,l.title,l.description,l.sort_order,
              l.is_free,l.status,m.display_order
            FROM subject_lesson_map m
            JOIN lessons l ON l.id=m.lesson_id
            JOIN subjects s ON s.id=m.subject_id
            WHERE s.slug=? AND s.is_active=1
            ORDER BY m.display_order,l.id
          `).bind(slug).all();
        }else{
          a=await e.DB.prepare(`
            SELECT l.id,l.title,l.description,l.sort_order,l.is_free,
              l.status,m.subject_id,m.display_order
            FROM lessons l
            LEFT JOIN subject_lesson_map m ON m.lesson_id=l.id
            ORDER BY COALESCE(m.display_order,l.sort_order),l.id
          `).all();
        }

        return json({
          success:true,
          membership:x?String(x.membership||"").toLowerCase():"guest",
          subject,
          lessons:(a.results||[]).map(l=>({
            ...l,
            is_free:Number(l.is_free)===1?1:0,
            accessible:Number(l.is_free)===1||prem(x)
          }))
        },200,r);
      }

      /* LESSON EXPLANATION */
      let m=u.pathname.match(/^\/api\/notes\/(\d+)$/);
      if(m&&r.method==="GET"){
        const id=+m[1];
        const access=await lessonAccess(id,r,e);

        if(access.error){
          return json({
            success:false,error:access.error
          },access.status,r);
        }

        const n=await e.DB.prepare(`
          SELECT content FROM lesson_notes WHERE lesson_id=?
        `).bind(id).first();

        return json({
          success:true,
          lesson:access.lesson,
          content:n?.content||""
        },200,r);
      }

      /* SUBTITLES FOR A LESSON */
      m=u.pathname.match(/^\/api\/lesson-subtitles\/lesson\/(\d+)$/);
      if(m&&r.method==="GET"){
        const id=+m[1];
        const access=await lessonAccess(id,r,e);

        if(access.error){
          return json({
            success:false,error:access.error
          },access.status,r);
        }

        const a=await e.DB.prepare(`
          SELECT id,lesson_id,language,title,content,sort_order
          FROM lesson_subtitles
          WHERE lesson_id=?
          ORDER BY sort_order,id
        `).bind(id).all();

        return json({
          success:true,subtitles:a.results||[]
        },200,r);
      }

      /* GET ONE SUBTITLE */
      m=u.pathname.match(/^\/api\/lesson-subtitles\/(\d+)$/);
      if(m&&r.method==="GET"){
        const id=+m[1];
        const s=await e.DB.prepare(`
          SELECT id,lesson_id,language,title,content,sort_order
          FROM lesson_subtitles WHERE id=?
        `).bind(id).first();

        if(!s){
          return json({success:false,error:"Subtitle not found"},404,r);
        }

        const access=await lessonAccess(s.lesson_id,r,e);
        if(access.error){
          return json({success:false,error:access.error},access.status,r);
        }

        return json({success:true,subtitle:s},200,r);
      }

      /* LOGOUT */
      if(u.pathname==="/auth/logout"){
        const t=ck(r,COOKIE);
        if(t){
          await e.DB.prepare("DELETE FROM sessions WHERE token=?")
            .bind(t).run();
        }

        const z=new Response(null,{
          status:302,
          headers:{Location:"https://createlk.com/v2/index.html"}
        });

        z.headers.set("Set-Cookie",
          `${COOKIE}=;Path=/;Max-Age=0;HttpOnly;Secure;SameSite=None`);
        return z;
      }

      return json({success:false,error:"Not found"},404,r);

    }catch(err){
      return json({
        success:false,error:err.message||"Server error"
      },500,r);
    }
  }
};
