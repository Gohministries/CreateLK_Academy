
const ADMIN_EMAIL = "gateofheavensl1@gmail.com";
const GOOGLE_CLIENT_ID = "582157960266-mvlpmqne90d9q7ja5vuhi3g1aspvtp86.apps.googleusercontent.com";
const LANGUAGES = ["en", "ta", "si"];

const HEADERS = {
  "Access-Control-Allow-Methods": "GET,POST,PUT,DELETE,OPTIONS",
  "Access-Control-Allow-Headers": "Content-Type,Authorization"
};

function json(data, status = 200, origin = "*") {
  return new Response(JSON.stringify(data), {
    status,
    headers: {
      ...HEADERS,
      "Access-Control-Allow-Origin": origin,
      "Content-Type": "application/json; charset=utf-8"
    }
  });
}

function fail(message, status = 400) {
  const e = new Error(message);
  e.status = status;
  return e;
}

async function ensureTables(db) {
  const sql = [
    `CREATE TABLE IF NOT EXISTS subjects (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      title TEXT NOT NULL,
      description TEXT DEFAULT '',
      sort_order INTEGER DEFAULT 0,
      created_at TEXT DEFAULT CURRENT_TIMESTAMP
    )`,
    `CREATE TABLE IF NOT EXISTS lessons (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      title TEXT NOT NULL,
      description TEXT DEFAULT '',
      sort_order INTEGER DEFAULT 0,
      is_free INTEGER DEFAULT 0,
      subject_id INTEGER,
      created_at TEXT DEFAULT CURRENT_TIMESTAMP
    )`,
    `CREATE TABLE IF NOT EXISTS subject_lesson_map (
      subject_id INTEGER NOT NULL,
      lesson_id INTEGER NOT NULL,
      sort_order INTEGER DEFAULT 0,
      PRIMARY KEY(subject_id, lesson_id)
    )`,
    `CREATE TABLE IF NOT EXISTS subject_courses (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      subject_id INTEGER,
      title TEXT DEFAULT '',
      description TEXT DEFAULT '',
      sort_order INTEGER DEFAULT 0
    )`,
    `CREATE TABLE IF NOT EXISTS lesson_notes (
      lesson_id INTEGER PRIMARY KEY,
      content TEXT DEFAULT '',
      updated_at TEXT DEFAULT CURRENT_TIMESTAMP
    )`,
    `CREATE TABLE IF NOT EXISTS lesson_subtitles (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      lesson_id INTEGER NOT NULL,
      language TEXT DEFAULT 'en',
      title TEXT DEFAULT '',
      content TEXT DEFAULT '',
      sort_order INTEGER DEFAULT 0,
      updated_at TEXT DEFAULT CURRENT_TIMESTAMP
    )`,
    `CREATE TABLE IF NOT EXISTS lesson_translations (
      lesson_id INTEGER NOT NULL,
      language TEXT NOT NULL,
      title TEXT DEFAULT '',
      description TEXT DEFAULT '',
      introduction TEXT DEFAULT '',
      explanation TEXT DEFAULT '',
      content TEXT DEFAULT '',
      updated_at TEXT DEFAULT CURRENT_TIMESTAMP,
      PRIMARY KEY (lesson_id, language)
    )`
  ];

  for (const statement of sql) {
    await db.prepare(statement).run();
  }
}

async function authenticate(request) {
  const header = request.headers.get("Authorization") || "";
  const token = header.replace(/^Bearer\s+/i, "").trim();

  if (!token) throw fail("Please sign in with the administrator Google account.", 401);

  let result;
  try {
    const response = await fetch(
      "https://oauth2.googleapis.com/tokeninfo?id_token=" +
      encodeURIComponent(token)
    );
    result = await response.json();
    if (!response.ok) throw new Error("Invalid token");
  } catch {
    throw fail("Google authentication failed.", 401);
  }

  if (
    result.aud !== GOOGLE_CLIENT_ID ||
    result.email !== ADMIN_EMAIL ||
    result.email_verified !== "true" ||
    Number(result.exp) <= Math.floor(Date.now() / 1000)
  ) {
    throw fail("Administrator access denied.", 403);
  }
}

export default {
  async fetch(request, env) {
    const url = new URL(request.url);
    const path = url.pathname.replace(/\/+$/, "") || "/";
    const method = request.method;
    const origin = request.headers.get("Origin") || "*";

    if (method === "OPTIONS") {
      return new Response(null, {
        status: 204,
        headers: {
          ...HEADERS,
          "Access-Control-Allow-Origin": origin
        }
      });
    }

    if (method === "GET" && path.startsWith("/images/")) {
      const key = decodeURIComponent(path.slice("/images/".length));
      const object = await env.FILES.get(key);
      if (!object) return new Response("Image not found", { status: 404 });

      const headers = new Headers({
        "Content-Type": object.httpMetadata?.contentType || "application/octet-stream",
        "Cache-Control": "public, max-age=86400",
        "Access-Control-Allow-Origin": origin
      });
      return new Response(object.body, { headers });
    }

    try {
      await authenticate(request);
      await ensureTables(env.DB);

      if (method === "GET" && path === "/api/bootstrap") {
        const subjects = await env.DB.prepare(
          "SELECT * FROM subjects ORDER BY sort_order,id"
        ).all();
        const lessons = await env.DB.prepare(
          "SELECT * FROM lessons ORDER BY sort_order,id"
        ).all();

        return json({
          ok: true,
          subjects: subjects.results,
          lessons: lessons.results
        }, 200, origin);
      }

      if (method === "GET" && path === "/api/subjects") {
        const rows = await env.DB.prepare(
          "SELECT * FROM subjects ORDER BY sort_order,id"
        ).all();
        return json({ ok: true, subjects: rows.results }, 200, origin);
      }

      if (method === "POST" && path === "/api/subjects") {
        const data = await request.json();
        if (!String(data.title || "").trim()) throw fail("Subject title is required.");

        const result = await env.DB.prepare(
          "INSERT INTO subjects(title,description,sort_order) VALUES(?,?,?)"
        ).bind(
          String(data.title).trim(),
          data.description || "",
          Number(data.sort_order || 0)
        ).run();

        return json({ ok: true, id: result.meta.last_row_id }, 201, origin);
      }

      const subjectMatch = path.match(/^\/api\/subjects\/(\d+)$/);

      if (subjectMatch && method === "PUT") {
        const id = Number(subjectMatch[1]);
        const data = await request.json();
        const old = await env.DB.prepare(
          "SELECT * FROM subjects WHERE id=?"
        ).bind(id).first();

        if (!old) throw fail("Subject not found.", 404);

        await env.DB.prepare(
          "UPDATE subjects SET title=?,description=?,sort_order=? WHERE id=?"
        ).bind(
          data.title ?? old.title,
          data.description ?? old.description,
          data.sort_order === undefined ? old.sort_order : Number(data.sort_order),
          id
        ).run();

        return json({ ok: true }, 200, origin);
      }

      if (subjectMatch && method === "DELETE") {
        const id = Number(subjectMatch[1]);
        await env.DB.prepare("DELETE FROM subject_lesson_map WHERE subject_id=?").bind(id).run();
        await env.DB.prepare("DELETE FROM subject_courses WHERE subject_id=?").bind(id).run();
        await env.DB.prepare("DELETE FROM subjects WHERE id=?").bind(id).run();
        return json({ ok: true }, 200, origin);
      }

      if (method === "POST" && path === "/api/lessons") {
        const data = await request.json();
        const title = String(data.title || "").trim();
        if (!title) throw fail("Lesson title is required.");

        const result = await env.DB.prepare(
          `INSERT INTO lessons(title,description,sort_order,is_free,subject_id)
           VALUES(?,?,?,?,?)`
        ).bind(
          title,
          data.description || "",
          Number(data.sort_order || 0),
          data.is_free ? 1 : 0,
          data.subject_id ? Number(data.subject_id) : null
        ).run();

        const id = result.meta.last_row_id;
        const content = data.content || "";

        await env.DB.prepare(
          "INSERT OR REPLACE INTO lesson_notes(lesson_id,content) VALUES(?,?)"
        ).bind(id, content).run();

        await env.DB.prepare(
          `INSERT OR REPLACE INTO lesson_translations
           (lesson_id,language,title,description,introduction,explanation,content)
           VALUES(?,?,?,?,?,?,?)`
        ).bind(
          id, "en", title, data.description || "",
          data.introduction || "", data.explanation || "", content
        ).run();

        if (data.subject_id) {
          await env.DB.prepare(
            `INSERT OR REPLACE INTO subject_lesson_map
             (subject_id,lesson_id,sort_order) VALUES(?,?,?)`
          ).bind(Number(data.subject_id), id, Number(data.sort_order || 0)).run();
        }

        return json({ ok: true, id }, 201, origin);
      }

      const lessonMatch = path.match(/^\/api\/lessons\/(\d+)$/);

      if (lessonMatch && method === "PUT") {
        const id = Number(lessonMatch[1]);
        const data = await request.json();
        const old = await env.DB.prepare(
          "SELECT * FROM lessons WHERE id=?"
        ).bind(id).first();

        if (!old) throw fail("Lesson not found.", 404);

        await env.DB.prepare(
          `UPDATE lessons SET title=?,description=?,sort_order=?,is_free=?,subject_id=?
           WHERE id=?`
        ).bind(
          data.title ?? old.title,
          data.description ?? old.description,
          data.sort_order === undefined ? old.sort_order : Number(data.sort_order),
          data.is_free === undefined ? old.is_free : (data.is_free ? 1 : 0),
          data.subject_id === undefined ? old.subject_id : (data.subject_id ? Number(data.subject_id) : null),
          id
        ).run();

        if (data.content !== undefined) {
          await env.DB.prepare(
            `INSERT INTO lesson_notes(lesson_id,content) VALUES(?,?)
             ON CONFLICT(lesson_id) DO UPDATE SET content=excluded.content,
             updated_at=CURRENT_TIMESTAMP`
          ).bind(id, data.content).run();
        }

        return json({ ok: true }, 200, origin);
      }

      if (lessonMatch && method === "DELETE") {
        const id = Number(lessonMatch[1]);

        await env.DB.prepare("DELETE FROM lesson_translations WHERE lesson_id=?").bind(id).run();
        await env.DB.prepare("DELETE FROM lesson_notes WHERE lesson_id=?").bind(id).run();
        await env.DB.prepare("DELETE FROM lesson_subtitles WHERE lesson_id=?").bind(id).run();
        await env.DB.prepare("DELETE FROM subject_lesson_map WHERE lesson_id=?").bind(id).run();
        await env.DB.prepare("DELETE FROM lessons WHERE id=?").bind(id).run();

        return json({ ok: true }, 200, origin);
      }

      const translationsMatch = path.match(/^\/api\/lessons\/(\d+)\/translations$/);

      if (translationsMatch && method === "GET") {
        const id = Number(translationsMatch[1]);
        const rows = await env.DB.prepare(
          "SELECT * FROM lesson_translations WHERE lesson_id=? ORDER BY language"
        ).bind(id).all();

        return json({ ok: true, translations: rows.results }, 200, origin);
      }

      const translationMatch = path.match(
        /^\/api\/lessons\/(\d+)\/translations\/([a-z]{2})$/
      );

      if (translationMatch && method === "PUT") {
        const id = Number(translationMatch[1]);
        const language = translationMatch[2];

        if (!LANGUAGES.includes(language)) {
          throw fail("Language must be en, ta or si.");
        }

        const data = await request.json();
        const lesson = await env.DB.prepare(
          "SELECT id FROM lessons WHERE id=?"
        ).bind(id).first();

        if (!lesson) throw fail("Lesson not found.", 404);

        const fields = ["title", "description", "introduction", "explanation", "content"];
        const values = fields.map(key => String(data[key] ?? ""));

        await env.DB.prepare(
          `INSERT INTO lesson_translations
           (lesson_id,language,title,description,introduction,explanation,content)
           VALUES(?,?,?,?,?,?,?)
           ON CONFLICT(lesson_id,language) DO UPDATE SET
           title=excluded.title,description=excluded.description,
           introduction=excluded.introduction,explanation=excluded.explanation,
           content=excluded.content,updated_at=CURRENT_TIMESTAMP`
        ).bind(id, language, ...values).run();

        if (language === "en") {
          await env.DB.prepare(
            "UPDATE lessons SET title=?,description=? WHERE id=?"
          ).bind(values[0], values[1], id).run();

          await env.DB.prepare(
            `INSERT INTO lesson_notes(lesson_id,content) VALUES(?,?)
             ON CONFLICT(lesson_id) DO UPDATE SET content=excluded.content,
             updated_at=CURRENT_TIMESTAMP`
          ).bind(id, values[4]).run();
        }

        return json({ ok: true, lesson_id: id, language }, 200, origin);
      }

      if (method === "GET" && path.startsWith("/api/notes/")) {
        const id = Number(path.split("/").pop());
        const note = await env.DB.prepare(
          "SELECT * FROM lesson_notes WHERE lesson_id=?"
        ).bind(id).first();

        return json({ ok: true, note: note || { lesson_id: id, content: "" } }, 200, origin);
      }

      const noteMatch = path.match(/^\/api\/notes\/(\d+)$/);

      if (noteMatch && method === "PUT") {
        const id = Number(noteMatch[1]);
        const data = await request.json();

        await env.DB.prepare(
          `INSERT INTO lesson_notes(lesson_id,content) VALUES(?,?)
           ON CONFLICT(lesson_id) DO UPDATE SET content=excluded.content,
           updated_at=CURRENT_TIMESTAMP`
        ).bind(id, data.content || "").run();

        return json({ ok: true }, 200, origin);
      }

      if (method === "POST" && path === "/api/lesson-images") {
        const form = await request.formData();
        const file = form.get("file");
        const lessonId = Number(form.get("lesson_id"));

        if (!file || typeof file.arrayBuffer !== "function") {
          throw fail("Please select an image.");
        }
        if (!lessonId) throw fail("Lesson ID is required.");
        if (!file.type.startsWith("image/")) throw fail("Only image files are allowed.");
        if (file.size > 10 * 1024 * 1024) throw fail("Maximum image size is 10 MB.");

        const key = `lessons/${lessonId}/${Date.now()}-${file.name.replace(/[^a-zA-Z0-9._-]/g, "_")}`;

        await env.FILES.put(key, await file.arrayBuffer(), {
          httpMetadata: { contentType: file.type }
        });

        const imageHtml = `<img src="/images/${encodeURIComponent(key)}" alt="" style="max-width:100%;height:auto">`;
        const old = await env.DB.prepare(
          "SELECT content FROM lesson_notes WHERE lesson_id=?"
        ).bind(lessonId).first();

        await env.DB.prepare(
          `INSERT INTO lesson_notes(lesson_id,content) VALUES(?,?)
           ON CONFLICT(lesson_id) DO UPDATE SET content=excluded.content,
           updated_at=CURRENT_TIMESTAMP`
        ).bind(lessonId, `${old?.content || ""}\n${imageHtml}`).run();

        return json({ ok: true, key, url: `/images/${encodeURIComponent(key)}` }, 201, origin);
      }

      if (method === "GET" && path.startsWith("/api/lesson-subtitles/lesson/")) {
        const id = Number(path.split("/").pop());
        const rows = await env.DB.prepare(
          "SELECT * FROM lesson_subtitles WHERE lesson_id=? ORDER BY sort_order,id"
        ).bind(id).all();

        return json({ ok: true, subtitles: rows.results }, 200, origin);
      }

      if (method === "POST" && path === "/api/lesson-subtitles") {
        const data = await request.json();
        if (!data.lesson_id) throw fail("Lesson ID is required.");

        const result = await env.DB.prepare(
          `INSERT INTO lesson_subtitles(lesson_id,language,title,content,sort_order)
           VALUES(?,?,?,?,?)`
        ).bind(
          Number(data.lesson_id),
          data.language || "en",
          data.title || "",
          data.content || "",
          Number(data.sort_order || 0)
        ).run();

        return json({ ok: true, id: result.meta.last_row_id }, 201, origin);
      }

      const subtitleMatch = path.match(/^\/api\/lesson-subtitles\/(\d+)$/);

      if (subtitleMatch && method === "PUT") {
        const id = Number(subtitleMatch[1]);
        const data = await request.json();
        const old = await env.DB.prepare(
          "SELECT * FROM lesson_subtitles WHERE id=?"
        ).bind(id).first();

        if (!old) throw fail("Subtitle not found.", 404);

        await env.DB.prepare(
          `UPDATE lesson_subtitles SET language=?,title=?,content=?,sort_order=?,
           updated_at=CURRENT_TIMESTAMP WHERE id=?`
        ).bind(
          data.language ?? old.language,
          data.title ?? old.title,
          data.content ?? old.content,
          data.sort_order === undefined ? old.sort_order : Number(data.sort_order),
          id
        ).run();

        return json({ ok: true }, 200, origin);
      }

      if (subtitleMatch && method === "DELETE") {
        await env.DB.prepare(
          "DELETE FROM lesson_subtitles WHERE id=?"
        ).bind(Number(subtitleMatch[1])).run();

        return json({ ok: true }, 200, origin);
      }

      return json({ error: "Endpoint not found." }, 404, origin);

    } catch (error) {
      return json({
        error: error.message || "Server error."
      }, error.status || 500, origin);
    }
  }
};
