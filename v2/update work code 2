
const ORIGIN = "https://createlk.com";
const GOOGLE_TOKENINFO = "https://oauth2.googleapis.com/tokeninfo";

function json(data, status = 200, origin = ORIGIN) {
  return new Response(JSON.stringify(data), {
    status,
    headers: {
      "Content-Type": "application/json; charset=utf-8",
      "Access-Control-Allow-Origin": origin,
      "Access-Control-Allow-Credentials": "true",
      "Access-Control-Allow-Methods": "GET,POST,PUT,DELETE,OPTIONS",
      "Access-Control-Allow-Headers": "Content-Type,Authorization",
      "Vary": "Origin"
    }
  });
}

function cors(req) {
  const origin = req.headers.get("Origin") || "";
  if (origin !== ORIGIN) {
    return new Response("Origin not allowed", { status: 403 });
  }
  return null;
}

async function body(req) {
  try {
    return await req.json();
  } catch {
    throw new Error("Invalid JSON body.");
  }
}

async function ensureTables(db) {
  await db.prepare(`
    CREATE TABLE IF NOT EXISTS academy_categories (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      name TEXT NOT NULL,
      parent_id INTEGER DEFAULT NULL,
      created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
    )
  `).run();

  await db.prepare(`
    CREATE TABLE IF NOT EXISTS academy_category_contents (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      category_id INTEGER NOT NULL,
      title TEXT NOT NULL,
      description TEXT DEFAULT '',
      explanation TEXT DEFAULT '',
      image_url TEXT DEFAULT '',
      created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
      updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
    )
  `).run();
}

async function authorize(req, env) {
  const header = req.headers.get("Authorization") || "";
  const token = header.startsWith("Bearer ") ? header.slice(7) : "";
  if (!token) throw new Error("Please sign in with the authorized Google account.");

  const response = await fetch(
    GOOGLE_TOKENINFO + "?id_token=" + encodeURIComponent(token)
  );
  if (!response.ok) throw new Error("Google login expired. Please sign in again.");

  const p = await response.json();
  const expectedClient = env.GOOGLE_CLIENT_ID;
  const expectedEmail = (env.ADMIN_EMAIL || "").toLowerCase();

  if (
    p.aud !== expectedClient ||
    p.email_verified !== "true" ||
    (p.email || "").toLowerCase() !== expectedEmail ||
    Number(p.exp) * 1000 <= Date.now()
  ) {
    throw new Error("Access denied. Use the authorized administrator account.");
  }
}

async function getCategories(db) {
  const result = await db.prepare(`
    SELECT c.id, c.name, c.parent_id, c.created_at,
      (SELECT COUNT(*) FROM academy_category_contents x
       WHERE x.category_id = c.id) AS content_count
    FROM academy_categories c
    ORDER BY COALESCE(c.parent_id, 0), c.name COLLATE NOCASE
  `).all();
  return result.results || [];
}

async function categoryDepth(db, id) {
  let depth = 0;
  let current = id;
  const seen = new Set();

  while (current) {
    if (seen.has(Number(current))) throw new Error("Invalid category hierarchy.");
    seen.add(Number(current));

    const row = await db.prepare(
      "SELECT id,parent_id FROM academy_categories WHERE id=?"
    ).bind(current).first();

    if (!row) throw new Error("Category not found.");
    if (row.parent_id == null) return depth;

    depth++;
    if (depth > 1) throw new Error("Only Main Category → Subcategory is allowed.");
    current = row.parent_id;
  }
  return depth;
}

async function saveCategory(db, data, id = null) {
  const name = String(data.name || "").trim();
  const parentId = data.parent_id ? Number(data.parent_id) : null;

  if (!name) throw new Error("Category name is required.");
  if (name.length > 120) throw new Error("Category name is too long.");

  if (parentId !== null) {
    if (id && Number(id) === parentId) throw new Error("A category cannot be its own parent.");
    const parent = await db.prepare(
      "SELECT id,parent_id FROM academy_categories WHERE id=?"
    ).bind(parentId).first();

    if (!parent) throw new Error("Select an existing main category.");
    if (parent.parent_id != null) {
      throw new Error("Only two levels are allowed: Main Category → Subcategory.");
    }
    if (id) {
      const children = await db.prepare(
        "SELECT id FROM academy_categories WHERE parent_id=? LIMIT 1"
      ).bind(id).first();
      if (children) throw new Error("A category with subcategories cannot become a subcategory.");
    }
  } else if (id) {
    const parent = await db.prepare(
      "SELECT parent_id FROM academy_categories WHERE id=?"
    ).bind(id).first();
    if (parent && parent.parent_id != null) {
      const children = await db.prepare(
        "SELECT id FROM academy_categories WHERE parent_id=? LIMIT 1"
      ).bind(id).first();
      if (children) throw new Error("Move or delete its subcategories first.");
    }
  }

  if (id) {
    await db.prepare(
      "UPDATE academy_categories SET name=?,parent_id=? WHERE id=?"
    ).bind(name, parentId, id).run();
  } else {
    await db.prepare(
      "INSERT INTO academy_categories(name,parent_id) VALUES(?,?)"
    ).bind(name, parentId).run();
  }
}

async function handle(req, env) {
  const blocked = cors(req);
  if (blocked) return blocked;

  if (req.method === "OPTIONS") {
    return new Response(null, {
      status: 204,
      headers: {
        "Access-Control-Allow-Origin": ORIGIN,
        "Access-Control-Allow-Credentials": "true",
        "Access-Control-Allow-Methods": "GET,POST,PUT,DELETE,OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type,Authorization",
        "Vary": "Origin"
      }
    });
  }

  const url = new URL(req.url);
  const path = url.pathname;

  // Public image delivery; upload endpoints remain administrator-only.
  if (req.method === "GET" && path.startsWith("/images/")) {
    const key = decodeURIComponent(path.slice("/images/".length));
    if (!key || key.includes("..")) return json({ error: "Invalid image path." }, 400);
    const object = await env.FILES.get(key);
    if (!object) return json({ error: "Image not found." }, 404);

    const headers = new Headers();
    object.writeHttpMetadata(headers);
    headers.set("ETag", object.httpEtag);
    headers.set("Cache-Control", "public, max-age=31536000, immutable");
    return new Response(object.body, { headers });
  }

  try {
    await authorize(req, env);
    await ensureTables(env.DB);

    if (req.method === "GET" && path === "/api/bootstrap") {
      return json({ ok: true, categories: await getCategories(env.DB) });
    }

    if (req.method === "GET" && path === "/api/categories") {
      return json({ categories: await getCategories(env.DB) });
    }

    if (req.method === "POST" && path === "/api/categories") {
      await saveCategory(env.DB, await body(req));
      return json({ ok: true, categories: await getCategories(env.DB) });
    }

    const categoryMatch = path.match(/^\/api\/categories\/(\d+)$/);
    if (categoryMatch && req.method === "PUT") {
      await saveCategory(env.DB, await body(req), Number(categoryMatch[1]));
      return json({ ok: true, categories: await getCategories(env.DB) });
    }

    if (categoryMatch && req.method === "DELETE") {
      const id = Number(categoryMatch[1]);
      const content = await env.DB.prepare(
        "SELECT id FROM academy_category_contents WHERE category_id=? LIMIT 1"
      ).bind(id).first();
      if (content) return json({ error: "This category has content. Delete or move its content first." }, 409);

      const child = await env.DB.prepare(
        "SELECT id FROM academy_categories WHERE parent_id=? LIMIT 1"
      ).bind(id).first();
      if (child) return json({ error: "Delete its subcategories first." }, 409);

      await env.DB.prepare("DELETE FROM academy_categories WHERE id=?").bind(id).run();
      return json({ ok: true, categories: await getCategories(env.DB) });
    }

    if (req.method === "GET" && path === "/api/contents") {
      const result = await env.DB.prepare(`
        SELECT x.*, c.name AS category_name, c.parent_id
        FROM academy_category_contents x
        JOIN academy_categories c ON c.id=x.category_id
        ORDER BY x.updated_at DESC, x.id DESC
      `).all();
      return json({ contents: result.results || [] });
    }

    if (req.method === "POST" && path === "/api/contents") {
      const data = await body(req);
      const categoryId = Number(data.category_id);
      const category = await env.DB.prepare(
        "SELECT id,name FROM academy_categories WHERE id=?"
      ).bind(categoryId).first();

      if (!category) return json({ error: "Please select a valid category." }, 400);

      await env.DB.prepare(`
        INSERT INTO academy_category_contents
          (category_id,title,description,explanation,image_url)
        VALUES(?,?,?,?,?)
      `).bind(
        categoryId,
        category.name,
        String(data.description || "").trim(),
        String(data.explanation || "").trim(),
        String(data.image_url || "").trim()
      ).run();

      return json({ ok: true });
    }

    const contentMatch = path.match(/^\/api\/contents\/(\d+)$/);
    if (contentMatch && req.method === "PUT") {
      const id = Number(contentMatch[1]);
      const data = await body(req);
      const categoryId = Number(data.category_id);
      const category = await env.DB.prepare(
        "SELECT id,name FROM academy_categories WHERE id=?"
      ).bind(categoryId).first();
      if (!category) return json({ error: "Please select a valid category." }, 400);

      await env.DB.prepare(`
        UPDATE academy_category_contents
        SET category_id=?, title=?, description=?, explanation=?, image_url=?,
            updated_at=CURRENT_TIMESTAMP
        WHERE id=?
      `).bind(
        categoryId,
        category.name,
        String(data.description || "").trim(),
        String(data.explanation || "").trim(),
        String(data.image_url || "").trim(),
        id
      ).run();
      return json({ ok: true });
    }

    if (contentMatch && req.method === "DELETE") {
      await env.DB.prepare(
        "DELETE FROM academy_category_contents WHERE id=?"
      ).bind(Number(contentMatch[1])).run();
      return json({ ok: true });
    }

    if (req.method === "POST" && path === "/api/content-images") {
      if (!env.FILES) throw new Error("R2 binding FILES is not configured.");

      const form = await req.formData();
      const file = form.get("image");
      if (!file || typeof file.arrayBuffer !== "function") {
        return json({ error: "Choose an image to upload." }, 400);
      }
      if (file.size > 10 * 1024 * 1024) {
        return json({ error: "Image must be 10 MB or smaller." }, 400);
      }

      const allowed = {
        "image/jpeg": "jpg",
        "image/png": "png",
        "image/webp": "webp",
        "image/gif": "gif"
      };
      const ext = allowed[file.type];
      if (!ext) return json({ error: "Use JPG, PNG, WEBP, or GIF." }, 400);

      const key = `category-content/${crypto.randomUUID()}.${ext}`;
      await env.FILES.put(key, await file.arrayBuffer(), {
        httpMetadata: { contentType: file.type }
      });
      return json({ ok: true, image_url: `${url.origin}/images/${key}` });
    }

    return json({ error: "Endpoint not found." }, 404);
  } catch (error) {
    const message = error?.message || "Unexpected server error.";
    const status = /sign in|login expired|access denied|authorized administrator/i.test(message)
      ? 401 : 400;
    return json({ error: message }, status);
  }
}

export default {
  async fetch(req, env) {
    return handle(req, env);
  }
};
