const ADMIN = "gateofheavensl1@gmail.com";
const CLIENT_ID = "582157960266-mvlpmqne90d9q7ja5vuhi3g1aspvtp86.apps.googleusercontent.com";
const ORIGINS = ["https://createlk.com", "https://www.createlk.com"];

function reply(data, status, origin) {
  return Response.json(data, {
    status,
    headers: {
      "Access-Control-Allow-Origin": ORIGINS.includes(origin) ? origin : ORIGINS[0],
      "Access-Control-Allow-Methods": "GET,POST,PUT,DELETE,OPTIONS",
      "Access-Control-Allow-Headers": "Authorization,Content-Type",
      "Cache-Control": "no-store"
    }
  });
}

function error(message, status = 400) {
  return Object.assign(new Error(message), { status });
}

async function auth(request) {
  const token = (request.headers.get("Authorization") || "").replace(/^Bearer\s+/i, "");
  if (!token) throw error("Google login required", 401);

  const response = await fetch(
    "https://oauth2.googleapis.com/tokeninfo?id_token=" + encodeURIComponent(token)
  );

  if (!response.ok) throw error("Please sign in again", 401);

  const user = await response.json();
  if (
    user.aud !== CLIENT_ID ||
    user.email_verified !== "true" ||
    user.email?.toLowerCase() !== ADMIN.toLowerCase() ||
    Number(user.exp) <= Math.floor(Date.now() / 1000)
  ) throw error("Admin access denied", 403);
}

const slug = s => String(s || "").trim().toLowerCase()
  .replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "") || "subject";

export default {
  async fetch(request, env) {
    const origin = request.headers.get("Origin") || "";
    const url = new URL(request.url);
    const path = url.pathname.replace(/\/+$/, "") || "/";
    const method = request.method.toUpperCase();

    if (method === "OPTIONS")
      return new Response(null, { status: 204, headers: {
        "Access-Control-Allow-Origin": ORIGINS.includes(origin) ? origin : ORIGINS[0],
        "Access-Control-Allow-Methods": "GET,POST,PUT,DELETE,OPTIONS",
        "Access-Control-Allow-Headers": "Authorization,Content-Type"
      }});

    if (path === "/api/health" && method === "GET")
      return reply({ ok: true }, 200, origin);

    try {
      if (!env.DB) throw error("D1 binding DB is missing", 500);
      await auth(request);

      const db = env.DB;

      if (path === "/api/subjects" && method === "GET") {
        const result = await db.prepare(
          "SELECT * FROM subjects ORDER BY display_order,id"
        ).all();

        return reply({
          ok: true,
          subjects: (result.results || []).map(s => ({
            ...s,
            title: s.name || s.title || "",
            name: s.name || s.title || "",
            slug: s.slug || slug(s.name || s.title),
            sort_order: Number(s.display_order ?? 0)
          }))
        }, 200, origin);
      }

      if (path === "/api/subjects" && method === "POST") {
        const d = await request.json();
        const name = String(d.name || d.title || "").trim();
        if (!name) throw error("Subject name is required");

        const result = await db.prepare(`
          INSERT INTO subjects (name,slug,description,icon,display_order)
          VALUES (?,?,?,?,?)
        `).bind(
          name, slug(d.slug || name), String(d.description || ""),
          String(d.icon || "📚"),
          Number(d.sort_order ?? d.display_order ?? 0)
        ).run();

        return reply({ ok: true, id: result.meta.last_row_id, name, title: name }, 201, origin);
      }

      const match = path.match(/^\/api\/subjects\/(\d+)$/);

      if (match && method === "PUT") {
        const id = Number(match[1]);
        const d = await request.json();
        const name = String(d.name || d.title || "").trim();
        if (!name) throw error("Subject name is required");

        const existing = await db.prepare(
          "SELECT id FROM subjects WHERE id=?"
        ).bind(id).first();

        if (!existing) throw error("Subject not found", 404);

        await db.prepare(`
          UPDATE subjects
          SET name=?,slug=?,description=?,display_order=?
          WHERE id=?
        `).bind(
          name, slug(d.slug || name), String(d.description || ""),
          Number(d.sort_order ?? d.display_order ?? 0), id
        ).run();

        return reply({ ok: true, id, name, title: name }, 200, origin);
      }

      if (match && method === "DELETE") {
        const id = Number(match[1]);

        const existing = await db.prepare(
          "SELECT id FROM subjects WHERE id=?"
        ).bind(id).first();

        if (!existing) throw error("Subject not found", 404);

        const linked = await db.prepare(`
          SELECT
            (SELECT COUNT(*) FROM subject_lesson_map WHERE subject_id=?) AS lessons,
            (SELECT COUNT(*) FROM subject_courses WHERE subject_id=?) AS courses
        `).bind(id, id).first();

        if (Number(linked.lessons) || Number(linked.courses))
          throw error("Move or remove linked lessons and courses before deleting this subject", 409);

        await db.prepare("DELETE FROM subjects WHERE id=?").bind(id).run();
        return reply({ ok: true, id }, 200, origin);
      }

      return reply({ ok: false, error: "Endpoint not found" }, 404, origin);
    } catch (e) {
      return reply({
        ok: false,
        error: e.message || "Server error"
      }, e.status || 500, origin);
    }
  }
};