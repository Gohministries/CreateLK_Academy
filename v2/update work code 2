
const ORIGIN="https://createlk.com";
const CORS={"Access-Control-Allow-Origin":ORIGIN,"Access-Control-Allow-Credentials":"true","Access-Control-Allow-Methods":"GET,POST,PUT,DELETE,OPTIONS","Access-Control-Allow-Headers":"Content-Type,Authorization","Vary":"Origin"};
const json=(d,s=200)=>new Response(JSON.stringify(d),{status:s,headers:{...CORS,"Content-Type":"application/json"}});
const fail=(e,s=400)=>json({error:e},s);
const slug=s=>String(s||"").toLowerCase().trim().replace(/[^a-z0-9]+/g,"-").replace(/^-|-$/g,"");
const pick=(c,n)=>n.find(x=>c.includes(x))||null;
async function cols(db,t){return(await db.prepare(`PRAGMA table_info("${t}")`).all()).results.map(x=>x.name)}
async function exists(db,t){return!!await db.prepare("SELECT name FROM sqlite_master WHERE type='table' AND name=?").bind(t).first()}
async function admin(req,env){
 const token=(req.headers.get("Authorization")||"").replace(/^Bearer\s+/i,"");
 if(!token)throw Error("Please sign in with Google.");
 if(!env.GOOGLE_CLIENT_ID||!env.ADMIN_EMAIL)throw Error("Admin settings missing.");
 const r=await fetch("https://oauth2.googleapis.com/tokeninfo?id_token="+encodeURIComponent(token));
 if(!r.ok)throw Error("Google login expired. Sign in again.");
 const u=await r.json();
 if(u.aud!==env.GOOGLE_CLIENT_ID||u.email_verified!=="true"||String(u.email||"").toLowerCase()!==String(env.ADMIN_EMAIL).toLowerCase()||Number(u.exp)*1000<=Date.now())throw Error("Administrator access denied.");
}
function published(r,c){return c.includes("status")?String(r.status||"PUBLISHED").toUpperCase()==="PUBLISHED":c.includes("is_active")?Number(r.is_active)===1:true}
async function setup(db){
 if(!await exists(db,"subjects")||!await exists(db,"lessons"))throw Error("Required subjects or lessons table missing.");
 await db.prepare("CREATE TABLE IF NOT EXISTS lesson_translations(id INTEGER PRIMARY KEY AUTOINCREMENT,lesson_id INTEGER NOT NULL,language TEXT NOT NULL,title TEXT DEFAULT '',description TEXT DEFAULT '',content TEXT DEFAULT '',UNIQUE(lesson_id,language))").run();
 await db.prepare("CREATE TABLE IF NOT EXISTS lesson_notes(id INTEGER PRIMARY KEY AUTOINCREMENT,lesson_id INTEGER NOT NULL UNIQUE,content TEXT DEFAULT '')").run();
 await db.prepare("CREATE TABLE IF NOT EXISTS subject_lesson_map(lesson_id INTEGER PRIMARY KEY,subject_id INTEGER NOT NULL,display_order INTEGER NOT NULL DEFAULT 1)").run();
 let c=await cols(db,"subjects"),had=c.includes("status");
 for(const [n,d] of [["subtitle","TEXT DEFAULT ''"],["image_url","TEXT DEFAULT ''"],["content","TEXT DEFAULT ''"],["status","TEXT DEFAULT 'PUBLISHED'"]])if(!c.includes(n)){await db.prepare(`ALTER TABLE subjects ADD COLUMN "${n}" ${d}`).run();c=await cols(db,"subjects")}
 if(!had&&c.includes("is_active"))await db.prepare("UPDATE subjects SET status=CASE WHEN is_active=0 THEN 'DRAFT' ELSE 'PUBLISHED' END").run();
 c=await cols(db,"lessons");
 if(!pick(c,["image_url","photo_url","image","photo"]))await db.prepare("ALTER TABLE lessons ADD COLUMN image_url TEXT DEFAULT ''").run();
 c=await cols(db,"lessons");
 for(const n of ["main_title","subtitle","content"])if(!c.includes(n))await db.prepare(`ALTER TABLE lessons ADD COLUMN "${n}" TEXT DEFAULT ''`).run();
 const mc=await cols(db,"subject_lesson_map");
 if(mc.includes("subject_id"))await db.prepare("INSERT OR IGNORE INTO subject_lesson_map(lesson_id,subject_id,display_order) SELECT id,subject_id,COALESCE(display_order,sort_order,1) FROM lessons WHERE subject_id IS NOT NULL").run().catch(()=>{});
}
async function saveSubject(db,id,b){
 const c=await cols(db,"subjects"),title=String(b.title||b.name||"").trim();
 if(!title)throw Error("Subject title required.");
 const status=String(b.status||"PUBLISHED").toUpperCase();
 if(!["PUBLISHED","DRAFT","COMING_SOON"].includes(status))throw Error("Invalid status.");
 const v={name:title,title,slug:String(b.slug||slug(title)),description:String(b.description||""),subtitle:String(b.subtitle||""),image_url:String(b.image_url||""),content:String(b.content||""),status,display_order:Number(b.display_order??b.sort_order??0),sort_order:Number(b.display_order??b.sort_order??0),is_active:status==="DRAFT"?0:1};
 const e=Object.entries(v).filter(([k])=>c.includes(k));
 if(!e.length)throw Error("No supported subject fields.");
 if(id){
  if(!await db.prepare("SELECT id FROM subjects WHERE id=?").bind(id).first())throw Error("Subject not found.");
  await db.prepare(`UPDATE subjects SET ${e.map(([k])=>`"${k}"=?`).join(",")} WHERE id=?`).bind(...e.map(x=>x[1]),id).run();return id;
 }
 const r=await db.prepare(`INSERT INTO subjects(${e.map(([k])=>`"${k}"`).join(",")}) VALUES(${e.map(()=>"?").join(",")})`).bind(...e.map(x=>x[1])).run();return r.meta.last_row_id;
}
async function listSubjects(db){
 const c=await cols(db,"subjects"),name=pick(c,["name","title"]),order=pick(c,["display_order","sort_order","position"]);
 const r=await db.prepare(`SELECT * FROM subjects ORDER BY ${order?`"${order}"`:"id"},id`).all();
 return(r.results||[]).map(x=>({...x,title:name?x[name]:"",subtitle:x.subtitle||"",image_url:x.image_url||"",description:x.description||"",content:x.content||"",slug:x.slug||"",status:String(x.status||(Number(x.is_active)===0?"DRAFT":"PUBLISHED")).toUpperCase(),display_order:x.display_order??x.sort_order??x.position??0}));
}
async function listLessons(db){
 const c=await cols(db,"lessons"),name=pick(c,["title","name"]),order=pick(c,["display_order","sort_order","position"]);
 const r=await db.prepare(`SELECT * FROM lessons ORDER BY ${order?`"${order}"`:"id"},id`).all();
 return Promise.all((r.results||[]).map(async x=>{
  const map=await db.prepare("SELECT subject_id,display_order FROM subject_lesson_map WHERE lesson_id=? LIMIT 1").bind(x.id).first();
  return{...x,title:name?x[name]:"",subject_id:map?.subject_id??x.subject_id??null,display_order:map?.display_order??x.display_order??x.sort_order??1};
 }));
}
async function saveLesson(db,id,b){
 const title=String(b.title||"").trim(),subject=Number(b.subject_id);
 if(!title||!subject)throw Error("Lesson title and subject are required.");
 if(!await db.prepare("SELECT id FROM subjects WHERE id=?").bind(subject).first())throw Error("Subject not found.");
 const c=await cols(db,"lessons"),old=id?await db.prepare("SELECT * FROM lessons WHERE id=?").bind(id).first():null;
 if(id&&!old)throw Error("Lesson not found.");
 const order=Number(b.display_order||old?.display_order||1);
 const status=["PUBLISHED","DRAFT","COMING_SOON"].includes(String(b.status||"").toUpperCase())?String(b.status).toUpperCase():"PUBLISHED";
 const v={title,name:title,main_title:String(b.main_title||""),subtitle:String(b.subtitle||""),description:String(b.description||""),content:String(b.content||""),is_free:Number(b.is_free)?1:0,status,display_order:order,position:order};
 if(!id&&c.includes("sort_order"))v.sort_order=(await db.prepare("SELECT COALESCE(MAX(sort_order),0)+1 AS n FROM lessons").first()).n;
 else if(id&&c.includes("sort_order"))v.sort_order=old.sort_order;
 const e=Object.entries(v).filter(([k])=>c.includes(k));
 let lid=id;
 if(id)await db.prepare(`UPDATE lessons SET ${e.map(([k])=>`"${k}"=?`).join(",")} WHERE id=?`).bind(...e.map(x=>x[1]),id).run();
 else{const r=await db.prepare(`INSERT INTO lessons(${e.map(([k])=>`"${k}"`).join(",")}) VALUES(${e.map(()=>"?").join(",")})`).bind(...e.map(x=>x[1])).run();lid=r.meta.last_row_id}
 await db.prepare("INSERT INTO subject_lesson_map(lesson_id,subject_id,display_order) VALUES(?,?,?) ON CONFLICT(lesson_id) DO UPDATE SET subject_id=excluded.subject_id,display_order=excluded.display_order").bind(lid,subject,order).run();
 return lid;
}
function cookie(req,n){const x=(req.headers.get("Cookie")||"").split(";").find(x=>x.trim().startsWith(n+"="));try{return x?decodeURIComponent(x.trim().slice(n.length+1)):""}catch{return""}}
function expired(v){if(v==null||v==="")return false;const n=Number(v);if(Number.isFinite(n)&&n>0)return(n<1e12?n*1000:n)<=Date.now();const t=Date.parse(v);return Number.isFinite(t)&&t<=Date.now()}
async function student(db,req){
 const token=cookie(req,"english_v2_session");
 if(!token||!await exists(db,"sessions")||!await exists(db,"users"))return null;
 const sc=await cols(db,"sessions"),uc=await cols(db,"users"),tc=pick(sc,["token","session_token","session_id"]),uid=pick(sc,["user_id","student_id"]);
 if(!tc||!uid)return null;
 const s=await db.prepare(`SELECT * FROM sessions WHERE "${tc}"=? LIMIT 1`).bind(token).first();if(!s)return null;
 const ec=pick(sc,["expires_at","expires","expiry","expires_at_ms"]);if(ec&&expired(s[ec]))return null;
 const idc=pick(uc,["id","user_id"]);if(!idc)return null;
 const u=await db.prepare(`SELECT * FROM users WHERE "${idc}"=? LIMIT 1`).bind(s[uid]).first();if(!u)return null;
 const mc=pick(uc,["membership","membership_status"]),xc=pick(uc,["membership_expiry","membership_expires_at","premium_expiry"]);
 return{premium:!!mc&&String(u[mc]||"").toUpperCase()==="PREMIUM"&&!(xc&&expired(u[xc]))};
}
async function publicLesson(db,id){
 const c=await cols(db,"lessons"),row=await db.prepare("SELECT * FROM lessons WHERE id=?").bind(id).first();
 if(!row||!published(row,c))return null;
 const tc=pick(c,["title","name"]),ic=pick(c,["image_url","photo_url","image","photo"]);
 const map=await db.prepare("SELECT subject_id FROM subject_lesson_map WHERE lesson_id=? LIMIT 1").bind(id).first();
 if(map){const sc=await cols(db,"subjects"),sub=await db.prepare("SELECT * FROM subjects WHERE id=?").bind(map.subject_id).first();if(!sub||!published(sub,sc))return null}
 return{id:row.id,title:tc?row[tc]||"":"",main_title:row.main_title||"",subtitle:row.subtitle||"",description:row.description||"",content:row.content||"",image_url:ic?row[ic]||"":"",is_free:Number(row.is_free)===1};
}
export default{
 async fetch(req,env){
  if(req.method==="OPTIONS")return new Response(null,{status:204,headers:CORS});
  const url=new URL(req.url),path=url.pathname.replace(/\/+$/,"")||"/",method=req.method;
  try{
   const db=env.DB;
   if(path.startsWith("/images/")&&method==="GET"){
    const key=decodeURIComponent(path.slice(8));if(!key||key.includes(".."))return fail("Invalid image key.");
    const obj=await env.FILES.get(key);if(!obj)return fail("Image not found.",404);
    const h=new Headers(CORS);h.set("Content-Type",obj.httpMetadata?.contentType||"application/octet-stream");h.set("Cache-Control","public, max-age=86400");return new Response(obj.body,{headers:h});
   }
   const lm=path.match(/^\/api\/public\/lessons\/(\d+)$/),tm=path.match(/^\/api\/public\/translations\/lesson\/(\d+)$/);
   if(method==="GET"&&(lm||tm)){
    await setup(db);const id=Number((lm||tm)[1]),lesson=await publicLesson(db,id);if(!lesson)return fail("Lesson not found.",404);
    if(lm)return json({lesson});
    if(!lesson.is_free){const s=await student(db,req);if(!s)return fail("Please sign in.",401);if(!s.premium)return fail("Premium membership required.",403)}
    const r=await db.prepare("SELECT language,title,description,content FROM lesson_translations WHERE lesson_id=? ORDER BY language").bind(id).all();return json({translations:r.results||[]});
   }
   await admin(req,env);await setup(db);
   if(path==="/api/bootstrap"&&method==="GET")return json({subjects:await listSubjects(db),lessons:await listLessons(db)});
   if(path==="/api/subjects"&&method==="GET")return json({subjects:await listSubjects(db)});
   if(path==="/api/subjects"&&method==="POST")return json({success:true,id:await saveSubject(db,null,await req.json())});
   let m=path.match(/^\/api\/subjects\/(\d+)$/);
   if(m&&method==="PUT")return json({success:true,id:await saveSubject(db,Number(m[1]),await req.json())});
   if(m&&method==="DELETE"){
    const id=Number(m[1]);if(await db.prepare("SELECT 1 FROM subject_lesson_map WHERE subject_id=? LIMIT 1").bind(id).first())return fail("Delete or reassign this subject's lessons first.");
    await db.prepare("DELETE FROM subjects WHERE id=?").bind(id).run();return json({success:true});
   }
   if(path==="/api/lessons"&&method==="GET")return json({lessons:await listLessons(db)});
   if(path==="/api/lessons"&&method==="POST")return json({success:true,id:await saveLesson(db,null,await req.json())});
   m=path.match(/^\/api\/lessons\/(\d+)$/);
   if(m&&method==="PUT")return json({success:true,id:await saveLesson(db,Number(m[1]),await req.json())});
   if(m&&method==="DELETE"){
    const id=Number(m[1]);for(const t of ["lesson_translations","lesson_notes","subject_lesson_map"])await db.prepare(`DELETE FROM "${t}" WHERE lesson_id=?`).bind(id).run();
    await db.prepare("DELETE FROM lessons WHERE id=?").bind(id).run();return json({success:true});
   }
   m=path.match(/^\/api\/notes\/(\d+)$/);
   if(m&&method==="GET"){const r=await db.prepare("SELECT content FROM lesson_notes WHERE lesson_id=?").bind(Number(m[1])).first();return json({content:r?.content||""})}
   if(m&&method==="PUT"){const b=await req.json();await db.prepare("INSERT INTO lesson_notes(lesson_id,content) VALUES(?,?) ON CONFLICT(lesson_id) DO UPDATE SET content=excluded.content").bind(Number(m[1]),String(b.content||"")).run();return json({success:true})}
   if(path==="/api/translations"&&method==="POST"){
    const b=await req.json();if(!b.lesson_id||!["ta","si","en"].includes(b.language))return fail("Choose a lesson and language ta, si, or en.");
    await db.prepare("INSERT INTO lesson_translations(lesson_id,language,title,description,content) VALUES(?,?,?,?,?) ON CONFLICT(lesson_id,language) DO UPDATE SET title=excluded.title,description=excluded.description,content=excluded.content").bind(Number(b.lesson_id),b.language,String(b.title||""),String(b.description||""),String(b.content||"")).run();return json({success:true});
   }
   m=path.match(/^\/api\/translations\/lesson\/(\d+)$/);
   if(m&&method==="GET"){const r=await db.prepare("SELECT * FROM lesson_translations WHERE lesson_id=? ORDER BY language").bind(Number(m[1])).all();return json({translations:r.results||[]})}
   if(path==="/api/lesson-images"&&method==="POST"){
    const f=await req.formData(),file=f.get("file"),id=Number(f.get("lesson_id"));
    if(!file||typeof file==="string"||!id)return fail("Choose an image and lesson.");
    const types={"image/jpeg":"jpg","image/png":"png","image/webp":"webp","image/gif":"gif"};
    if(!types[file.type])return fail("Use JPG, PNG, WEBP, or GIF.");
    if(file.size>5*1024*1024)return fail("Image maximum is 5 MB.");
    if(!await db.prepare("SELECT id FROM lessons WHERE id=?").bind(id).first())return fail("Lesson not found.");
    const key=`lessons/${id}/${crypto.randomUUID()}.${types[file.type]}`;await env.FILES.put(key,file.stream(),{httpMetadata:{contentType:file.type}});
    const c=await cols(db,"lessons"),ic=pick(c,["image_url","photo_url","image","photo"]),imageUrl=`${url.origin}/images/${encodeURIComponent(key)}`;
    if(ic)await db.prepare(`UPDATE lessons SET "${ic}"=? WHERE id=?`).bind(imageUrl,id).run();
    return json({success:true,key,url:imageUrl});
   }
   return fail("Endpoint not found: "+method+" "+path,404);
  }catch(e){const msg=e?.message||"Worker error";return fail(msg,/sign in|login expired|access denied|administrator/i.test(msg)?401:500)}
 }
};
