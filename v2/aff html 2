<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#0b1628">
<title>CreateLK English - Affiliate</title>

<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial,Helvetica,sans-serif;background:#0b1628;color:#dbe4f0}
.wrap{max-width:700px;margin:auto;padding:20px 14px 50px}
header{text-align:center;padding:15px 0 25px}
.back{display:inline-block;background:#29415f;color:#fff;text-decoration:none;padding:9px 16px;border-radius:9px;font-weight:700;font-size:14px;margin-bottom:15px}
.logo{font-size:27px;font-weight:800;color:#fff}.logo span{color:#f0b92f}
.sub{color:#91a3b8;margin-top:6px}
.card{background:#101f35;border:1px solid #213653;border-radius:16px;padding:18px;margin-bottom:14px}
h2{margin:0 0 14px;font-size:18px}
.link{background:#0b1628;border:1px solid #29415f;border-radius:10px;padding:13px;word-break:break-all;color:#f0b92f;font-size:14px}
button{width:100%;border:0;border-radius:10px;padding:12px;margin-top:10px;font-weight:700;cursor:pointer}
button:disabled{opacity:.55;cursor:not-allowed}
.copy{background:#f0b92f;color:#08111f}
.share{background:#18365d;color:#fff}
.withdraw{background:#19a974;color:#fff}
.guide{background:#29415f;color:#fff;text-decoration:none;display:block;text-align:center;padding:13px;border-radius:10px;font-weight:700}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.stat{background:#0b1628;border-radius:12px;padding:15px;text-align:center}
.num{font-size:24px;font-weight:800;color:#f0b92f}
.label{color:#91a3b8;font-size:12px;margin-top:5px}
.money{text-align:center;font-size:30px;font-weight:800;color:#f0b92f}
.note{text-align:center;color:#91a3b8;font-size:13px;line-height:1.5}
.error{text-align:center;color:#ff9999;padding:25px}

.skeleton{position:relative;overflow:hidden}
.skeleton:after{content:"";position:absolute;inset:0;transform:translateX(-100%);background:linear-gradient(90deg,transparent,rgba(255,255,255,.07),transparent);animation:shine 1.4s infinite}
@keyframes shine{100%{transform:translateX(100%)}}
.sk-line{height:13px;background:#1a2c45;border-radius:7px;margin-bottom:12px}
.sk-title{width:42%;height:18px;background:#1a2c45;border-radius:8px;margin-bottom:18px}
.sk-link{height:46px;background:#0d1a2e;border-radius:10px}
.sk-btn{height:42px;background:#1a2c45;border-radius:10px;margin-top:10px}
.sk-stat{height:82px;background:#0d1a2e;border-radius:12px}
.sk-money{width:48%;height:34px;background:#1a2c45;border-radius:10px;margin:5px auto 10px}
.sk-small{width:35%;margin:0 auto}

.modal{position:fixed;inset:0;background:rgba(0,0,0,.78);display:none;align-items:center;justify-content:center;padding:15px;z-index:100}
.modal.show{display:flex}
.box{width:100%;max-width:430px;background:#101f35;border:1px solid #29415f;border-radius:16px;padding:20px}
input{width:100%;padding:13px;margin:7px 0;border-radius:9px;border:1px solid #29415f;background:#0b1628;color:#fff;outline:none}
input:focus{border-color:#f0b92f}
.submit{background:#f0b92f;color:#08111f}
.close{background:#29415f;color:#fff}

@media(max-width:420px){
.wrap{padding-left:10px;padding-right:10px}
.card{padding:15px}
.num{font-size:21px}
.money{font-size:27px}
}
</style>
</head>

<body>

<div class="wrap">

<header>
<a class="back" href="index.html">← Back</a>
<div class="logo">Create<span>LK</span> English</div>
<div class="sub">Affiliate Dashboard</div>
</header>

<div id="app">

<div class="card skeleton">
<div class="sk-title"></div>
<div class="sk-link"></div>
<div class="sk-btn"></div>
<div class="sk-btn"></div>
</div>

<div class="card skeleton">
<div class="sk-title"></div>
<div class="grid">
<div class="sk-stat"></div>
<div class="sk-stat"></div>
<div class="sk-stat"></div>
<div class="sk-stat"></div>
</div>
</div>

<div class="card skeleton">
<div class="sk-title"></div>
<div class="sk-money"></div>
<div class="sk-line sk-small"></div>
<div class="sk-btn"></div>
<div style="height:10px"></div>
<div class="grid">
<div class="sk-stat"></div>
<div class="sk-stat"></div>
</div>
</div>

<div class="card skeleton">
<div class="sk-line"></div>
<div class="sk-line"></div>
<div class="sk-line" style="width:80%"></div>
</div>

</div>

<!-- AFFILIATE GUIDE -->
<div class="card">
<a class="guide" href="/v2/guide.html">
📘 Affiliate Guide
</a>
</div>

</div>

<!-- WITHDRAW MODAL -->

<div class="modal" id="withdrawModal">
<div class="box">

<h2>💵 Withdraw Commission</h2>

<div class="note">
Minimum withdrawal is LKR 2,000.
<br>
Your withdrawal request will be sent to the admin for approval.
</div>

<input id="accountName" type="text" placeholder="Customer / Account Name" autocomplete="name">
<input id="bank" type="text" placeholder="Bank">
<input id="branch" type="text" placeholder="Branch">
<input id="accountNumber" type="text" inputmode="numeric" placeholder="Account Number">
<input id="amount" type="number" min="2000" placeholder="Withdrawal Amount">

<button class="submit" id="submitBtn" onclick="submitWithdrawal()">
Submit Withdrawal Request
</button>

<button class="close" onclick="closeWithdraw()">Cancel</button>

</div>
</div>

<script>

const ENGLISH_API="https://createlk-english-v2.createlk.workers.dev";
const AFFILIATE_API="https://affiliate-v2.createlk.workers.dev";
const WITHDRAWAL_API="https://withdrawal-v2.createlk.workers.dev";

const MINIMUM=2000;

let authToken="";
let referralLink="";
let availableCommission=0;
let minimumWithdrawal=MINIMUM;

async function getToken(){

 const r=await fetch(
  ENGLISH_API+"/api/affiliate/token",
  {method:"GET",credentials:"include",cache:"no-store"}
 );

 const d=await r.json().catch(()=>({}));

 if(!r.ok||!d.success)
  throw new Error(d.error||"Please login to CreateLK English first.");

 authToken=d.token;

 if(!authToken)
  throw new Error("Authentication token missing.");

 return authToken;
}

async function getWithdrawals(){

 try{

  const r=await fetch(
   WITHDRAWAL_API+"/api/withdrawals",
   {
    method:"GET",
    headers:{Authorization:"Bearer "+authToken},
    cache:"no-store"
   }
  );

  const d=await r.json().catch(()=>({}));

  if(!r.ok||!d.success)
   return{pending:0,paid:0};

  const list=Array.isArray(d.withdrawals)
   ?d.withdrawals
   :Array.isArray(d.requests)
   ?d.requests
   :[];

  let pending=0,paid=0;

  for(const x of list){

   const amount=Number(x.amount||0);
   const status=String(x.status||"").toUpperCase();

   if(status==="PENDING")pending+=amount;
   if(status==="PAID")paid+=amount;
  }

  return{pending,paid};

 }catch{

  return{pending:0,paid:0};

 }
}

async function load(){

 try{

  await getToken();

  const ar=await fetch(
   AFFILIATE_API+"/api/dashboard",
   {
    method:"GET",
    headers:{Authorization:"Bearer "+authToken},
    cache:"no-store"
   }
  );

  const ad=await ar.json().catch(()=>({}));

  if(!ar.ok||!ad.success)
   throw new Error(ad.error||"Unable to load affiliate dashboard.");

  referralLink=ad.referral_link||"";

  const referrals=Number(ad.referrals||0);
  const sales=Number(ad.approved_sales||0);
  const rate=Number(ad.commission_rate||20);

  minimumWithdrawal=Number(
   ad.minimum_withdrawal||MINIMUM
  );

  const totalEarned=Number(ad.total_earned||0);
  const pendingCommission=Number(ad.pending_commission||0);

  const wd=await getWithdrawals();

  const withdrawalPending=Number(wd.pending||0);
  const withdrawalPaid=Number(wd.paid||0);

  availableCommission=Math.max(
   0,
   totalEarned-withdrawalPending-withdrawalPaid
  );

  document.getElementById("app").innerHTML=`

  <div class="card">

   <h2>📣 Your Referral Link</h2>

   <div class="link">${esc(referralLink)}</div>

   <button class="copy" onclick="copyLink()">
    📋 Copy Link
   </button>

   <button class="share" onclick="shareLink()">
    📤 Share Link
   </button>

  </div>

  <div class="card">

   <h2>📊 Performance</h2>

   <div class="grid">

    <div class="stat">
     <div class="num">${referrals.toLocaleString()}</div>
     <div class="label">Referrals</div>
    </div>

    <div class="stat">
     <div class="num">${sales.toLocaleString()}</div>
     <div class="label">Approved Sales</div>
    </div>

    <div class="stat">
     <div class="num">${rate}%</div>
     <div class="label">Commission</div>
    </div>

    <div class="stat">
     <div class="num">LKR ${minimumWithdrawal.toLocaleString()}</div>
     <div class="label">Minimum Withdrawal</div>
    </div>

   </div>

  </div>

  <div class="card">

   <h2>💵 Earnings</h2>

   <div class="money">
    LKR ${availableCommission.toLocaleString()}
   </div>

   <div class="note">Available Commission</div>

   <button
    class="withdraw"
    onclick="openWithdraw()"
    ${availableCommission<minimumWithdrawal?"disabled":""}>

    ${
     availableCommission>=minimumWithdrawal
     ?"💵 Withdraw Commission"
     :"🔒 💵 Withdraw Commission"
    }

   </button>

   <div class="note" style="margin-top:10px">

    ${
     availableCommission>=minimumWithdrawal
     ?"You can submit a withdrawal request now."
     :"Available when your commission reaches LKR "+
      minimumWithdrawal.toLocaleString()+"."
    }

   </div>

   <div class="grid" style="margin-top:12px">

    <div class="stat">
     <div class="num">
      LKR ${withdrawalPending.toLocaleString()}
     </div>
     <div class="label">Pending</div>
    </div>

    <div class="stat">
     <div class="num">
      LKR ${withdrawalPaid.toLocaleString()}
     </div>
     <div class="label">Paid</div>
    </div>

   </div>

  </div>

  <div class="card">

   <div class="note">

    Earn ${rate}% from approved Premium sales.

    <br><br>

    Total earned:
    <strong>LKR ${totalEarned.toLocaleString()}</strong>

    <br><br>

    Pending commission:
    <strong>LKR ${pendingCommission.toLocaleString()}</strong>

    <br><br>

    When your available commission reaches
    LKR ${minimumWithdrawal.toLocaleString()},
    you can submit a withdrawal request
    to the admin.

   </div>

  </div>

  `;

 }catch(e){

  document.getElementById("app").innerHTML=`

  <div class="card error">

   ${esc(e.message)}

   <br><br>

   <button class="copy" onclick="location.reload()">
    🔄 Try Again
   </button>

  </div>

  `;

 }
}

async function copyLink(){

 try{

  await navigator.clipboard.writeText(referralLink);
  alert("Referral link copied!");

 }catch{

  prompt("Copy your referral link:",referralLink);

 }

}

async function shareLink(){

 if(navigator.share){

  try{

   await navigator.share({
    title:"CreateLK English",
    text:"Join CreateLK English",
    url:referralLink
   });

  }catch{}

 }else copyLink();

}

function openWithdraw(){

 if(availableCommission<minimumWithdrawal){

  alert(
   "Minimum withdrawal is LKR "+
   minimumWithdrawal.toLocaleString()+"."
  );

  return;
 }

 document.getElementById("amount").value=availableCommission;
 document.getElementById("withdrawModal").classList.add("show");

}

function closeWithdraw(){

 document.getElementById("withdrawModal").classList.remove("show");

}

async function submitWithdrawal(){

 const accountName=document.getElementById("accountName").value.trim();
 const bank=document.getElementById("bank").value.trim();
 const branch=document.getElementById("branch").value.trim();
 const accountNumber=document.getElementById("accountNumber").value.trim();

 const amount=Math.floor(
  Number(document.getElementById("amount").value)
 );

 if(!accountName||!bank||!branch||!accountNumber){

  alert("Please complete all bank details.");
  return;

 }

 if(!Number.isFinite(amount)||amount<minimumWithdrawal){

  alert(
   "Minimum withdrawal is LKR "+
   minimumWithdrawal.toLocaleString()+"."
  );

  return;

 }

 if(amount>availableCommission){

  alert(
   "Withdrawal amount cannot exceed your available commission."
  );

  return;

 }

 const btn=document.getElementById("submitBtn");

 btn.disabled=true;
 btn.textContent="Submitting...";

 try{

  const r=await fetch(
   WITHDRAWAL_API+"/api/withdraw",
   {
    method:"POST",
    headers:{
     "Content-Type":"application/json",
     "Authorization":"Bearer "+authToken
    },
    body:JSON.stringify({
     amount,
     account_name:accountName,
     bank,
     branch,
     account_number:accountNumber
    })
   }
  );

  const d=await r.json().catch(()=>({}));

  if(!r.ok||!d.success)
   throw new Error(
    d.error||"Withdrawal request failed."
   );

  alert(
   "Withdrawal request submitted successfully!\n\n"+
   "Amount: LKR "+
   Number(d.amount||amount).toLocaleString()
  );

  document.getElementById("accountName").value="";
  document.getElementById("bank").value="";
  document.getElementById("branch").value="";
  document.getElementById("accountNumber").value="";
  document.getElementById("amount").value="";

  closeWithdraw();

  btn.disabled=false;
  btn.textContent="Submit Withdrawal Request";

  await load();

 }catch(e){

  alert(
   e.message||
   "Unable to submit withdrawal request."
  );

  btn.disabled=false;
  btn.textContent="Submit Withdrawal Request";

 }
}

function esc(s){

 return String(s??"")
 .replace(/&/g,"&amp;")
 .replace(/</g,"&lt;")
 .replace(/>/g,"&gt;")
 .replace(/"/g,"&quot;")
 .replace(/'/g,"&#039;");

}

load();

</script>

</body>
</html>