const RATE=.20,MIN=2000;

const cors={
  "Access-Control-Allow-Origin":"https://createlk.com",
  "Access-Control-Allow-Headers":"Content-Type,Authorization",
  "Access-Control-Allow-Methods":"GET,POST,OPTIONS"
};

const json=(d,s=200)=>new Response(JSON.stringify(d),{
  status:s,headers:{"Content-Type":"application/json",...cors}
});

async function auth(req,env){
  const h=req.headers.get("Authorization")||"";
  if(!h.startsWith("Bearer "))return null;
  const token=h.slice(7);
  if(!env.AFFILIATE_SECRET||token!==env.AFFILIATE_SECRET)return null;
  return true;
}

async function setup(env){
  await env.DB.prepare(`
    CREATE TABLE IF NOT EXISTS affiliate_clicks(
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      affiliate_code TEXT NOT NULL,
      created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
    )`).run();

  await env.DB.prepare(`
    CREATE TABLE IF NOT EXISTS affiliate_referrals(
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      affiliate_code TEXT NOT NULL,
      student_id TEXT NOT NULL,
      status TEXT DEFAULT 'PENDING',
      sale_amount INTEGER DEFAULT 0,
      commission INTEGER DEFAULT 0,
      created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
      approved_at TEXT
    )`).run();

  await env.DB.prepare(`
    CREATE TABLE IF NOT EXISTS affiliate_withdrawals(
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      user_id TEXT NOT NULL,
      affiliate_code TEXT NOT NULL,
      amount INTEGER NOT NULL,
      account_name TEXT NOT NULL,
      bank TEXT NOT NULL,
      branch TEXT NOT NULL,
      account_number TEXT NOT NULL,
      status TEXT DEFAULT 'PENDING',
      created_at TEXT DEFAULT CURRENT_TIMESTAMP,
      processed_at TEXT
    )`).run();
}

async function getAffiliate(env,code){
  return await env.DB.prepare(`
    SELECT id,user_id,affiliate_code
    FROM affiliates
    WHERE affiliate_code=?
  `).bind(code).first();
}

async function available(env,code){
  const earned=await env.DB.prepare(`
    SELECT COALESCE(SUM(commission),0) total
    FROM affiliate_sales
    WHERE affiliate_user_id=(
      SELECT user_id FROM affiliates WHERE affiliate_code=?
    )
    AND status='approved'
  `).bind(code).first();

  const paid=await env.DB.prepare(`
    SELECT COALESCE(SUM(amount),0) total
    FROM affiliate_withdrawals
    WHERE affiliate_code=?
    AND status IN ('PENDING','APPROVED','PAID')
  `).bind(code).first();

  return Math.max(0,(earned?.total||0)-(paid?.total||0));
}

async function sync(env){
  const rows=await env.DB.prepare(`
    SELECT u.id,u.referred_by
    FROM users u
    WHERE u.referred_by IS NOT NULL
      AND u.referred_by!=''
  `).all();

  for(const r of rows.results||[]){
    const a=await getAffiliate(env,r.referred_by);
    if(!a)continue;

    await env.DB.prepare(`
      INSERT OR IGNORE INTO affiliate_referrals
      (affiliate_code,student_id,status,created_at)
      VALUES(?,?,'APPROVED',CURRENT_TIMESTAMP)
    `).bind(r.referred_by,r.id).run();
  }
}

export default{
  async fetch(req,env){
    if(req.method==="OPTIONS")return new Response(null,{headers:cors});

    try{
      await setup(env);
      await sync(env);

      const u=new URL(req.url);
      const path=u.pathname;

      if(path==="/api/click"&&req.method==="POST"){
        const {affiliate_code}=await req.json();
        if(!affiliate_code)return json({error:"Affiliate code required"},400);

        const a=await getAffiliate(env,affiliate_code);
        if(!a)return json({error:"Invalid affiliate code"},404);

        await env.DB.prepare(`
          INSERT INTO affiliate_clicks(affiliate_code)
          VALUES(?)
        `).bind(affiliate_code).run();

        await env.DB.prepare(`
          UPDATE affiliates
          SET clicks=clicks+1
          WHERE affiliate_code=?
        `).bind(affiliate_code).run();

        return json({ok:true});
      }

      /*
       Trusted payment Worker calls this AFTER
       a Premium payment is successfully approved.

       Body:
       {
         "affiliate_code":"ABC123",
         "student_id":"USER_ID",
         "subscription_id":123,
         "amount":1000
       }
      */
      if(path==="/api/sale"&&req.method==="POST"){
        if(!(await auth(req,env)))
          return json({error:"Unauthorized"},401);

        const b=await req.json();
        const code=b.affiliate_code;
        const student=b.student_id;
        const sub=Number(b.subscription_id);
        const amount=Number(b.amount);

        if(!code||!student||!sub||!amount)
          return json({error:"Missing sale data"},400);

        const a=await getAffiliate(env,code);
        if(!a)return json({error:"Invalid affiliate"},404);

        const user=await env.DB.prepare(`
          SELECT id,referred_by
          FROM users
          WHERE id=?
        `).bind(student).first();

        if(!user||user.referred_by!==code)
          return json({error:"Referral mismatch"},400);

        const subscription=await env.DB.prepare(`
          SELECT id,user_id,amount,status
          FROM subscriptions
          WHERE id=?
        `).bind(sub).first();

        if(!subscription||subscription.user_id!==student)
          return json({error:"Invalid subscription"},400);

        if(String(subscription.status).toLowerCase()!=="approved")
          return json({error:"Subscription not approved"},400);

        const exists=await env.DB.prepare(`
          SELECT id
          FROM affiliate_sales
          WHERE subscription_id=?
        `).bind(sub).first();

        if(exists)
          return json({
            ok:true,
            duplicate:true,
            message:"Commission already recorded"
          });

        const saleAmount=Number(subscription.amount||amount);
        const commission=Math.floor(saleAmount*RATE);

        await env.DB.prepare(`
          INSERT INTO affiliate_sales
          (affiliate_user_id,referred_user_id,subscription_id,commission,status)
          VALUES(?,?,?,'${commission}','approved')
        `.replace("'${commission}'","?"))
        .bind(a.user_id,student,sub,commission)
        .run();

        await env.DB.prepare(`
          UPDATE affiliates
          SET sales=sales+1,
              earnings=earnings+?
          WHERE affiliate_code=?
        `).bind(commission,code).run();

        await env.DB.prepare(`
          UPDATE affiliate_referrals
          SET status='APPROVED',
              sale_amount=?,
              commission=commission+?,
              approved_at=CURRENT_TIMESTAMP
          WHERE affiliate_code=? AND student_id=?
        `).bind(saleAmount,commission,code,student).run();

        return json({
          ok:true,
          commission,
          rate:RATE
        });
      }

      if(path==="/api/dashboard"&&req.method==="GET"){
        const code=u.searchParams.get("affiliate_code");
        if(!code)return json({error:"Affiliate code required"},400);

        const a=await getAffiliate(env,code);
        if(!a)return json({error:"Affiliate not found"},404);

        const students=await env.DB.prepare(`
          SELECT COUNT(*) count
          FROM affiliate_referrals
          WHERE affiliate_code=?
        `).bind(code).first();

        const sales=await env.DB.prepare(`
          SELECT
            COUNT(*) count,
            COALESCE(SUM(commission),0) earned,
            COALESCE(SUM(
              CASE WHEN status='approved' THEN commission ELSE 0 END
            ),0) approved
          FROM affiliate_sales
          WHERE affiliate_user_id=?
        `).bind(a.user_id).first();

        return json({
          affiliate_code:code,
          clicks:a.clicks||0,
          registrations:students?.count||0,
          sales:sales?.count||0,
          earnings:sales?.earned||0,
          approved_earnings:sales?.approved||0,
          available:await available(env,code),
          minimum_withdrawal:MIN,
          commission_rate:RATE
        });
      }

      if(path==="/api/withdraw"&&req.method==="POST"){
        const b=await req.json();
        const code=b.affiliate_code;

        if(!code||!b.user_id||!b.account_name||
           !b.bank||!b.branch||!b.account_number)
          return json({error:"Missing withdrawal details"},400);

        const a=await getAffiliate(env,code);
        if(!a||a.user_id!==b.user_id)
          return json({error:"Invalid affiliate"},400);

        const amount=await available(env,code);

        if(amount<MIN)
          return json({
            error:`Minimum withdrawal is LKR ${MIN}`,
            available:amount
          },400);

        await env.DB.prepare(`
          INSERT INTO affiliate_withdrawals
          (user_id,affiliate_code,amount,account_name,bank,branch,account_number)
          VALUES(?,?,?,?,?,?,?)
        `).bind(
          b.user_id,code,amount,
          b.account_name,b.bank,b.branch,b.account_number
        ).run();

        return json({
          ok:true,
          amount,
          status:"PENDING"
        });
      }

      if(path==="/api/withdrawals"&&req.method==="GET"){
        const code=u.searchParams.get("affiliate_code");
        if(!code)return json({error:"Affiliate code required"},400);

        const rows=await env.DB.prepare(`
          SELECT id,amount,account_name,bank,branch,
                 account_number,status,created_at,processed_at
          FROM affiliate_withdrawals
          WHERE affiliate_code=?
          ORDER BY id DESC
        `).bind(code).all();

        return json({withdrawals:rows.results||[]});
      }

      return json({
        ok:true,
        service:"CreateLK English Affiliate API"
      });

    }catch(e){
      return json({
        error:e.message||"Server error"
      },500);
    }
  }
};