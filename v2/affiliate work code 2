const RATE=.20,MIN=2000;

const cors={
  "Access-Control-Allow-Origin":"https://createlk.com",
  "Access-Control-Allow-Headers":"Content-Type,Authorization",
  "Access-Control-Allow-Methods":"GET,POST,OPTIONS"
};

const json=(d,s=200)=>new Response(JSON.stringify(d),{
  status:s,headers:{"Content-Type":"application/json",...cors}
});

async function token(req,env){
  const h=req.headers.get("Authorization")||"";
  if(!h.startsWith("Bearer "))return null;
  const t=h.slice(7);
  if(!env.AFFILIATE_SECRET||t!==env.AFFILIATE_SECRET)return null;
  return true;
}

async function affiliate(env,code){
  return env.DB.prepare(`
    SELECT id,user_id,affiliate_code,clicks,registrations,sales,earnings
    FROM affiliates WHERE affiliate_code=?
  `).bind(code).first();
}

async function setup(env){
  await env.DB.prepare(`
    CREATE TABLE IF NOT EXISTS affiliate_clicks(
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      affiliate_code TEXT NOT NULL,
      created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
    )
  `).run();

  await env.DB.prepare(`
    CREATE TABLE IF NOT EXISTS affiliate_referrals(
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      affiliate_code TEXT NOT NULL,
      student_id TEXT NOT NULL,
      status TEXT DEFAULT 'PENDING',
      sale_amount INTEGER DEFAULT 0,
      commission INTEGER DEFAULT 0,
      created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
      approved_at TEXT
    )
  `).run();
}

async function balance(env,code,userId){
  const e=await env.DB.prepare(`
    SELECT COALESCE(SUM(commission),0) total
    FROM affiliate_sales
    WHERE affiliate_user_id=? AND status='approved'
  `).bind(userId).first();

  const w=await env.DB.prepare(`
    SELECT COALESCE(SUM(amount),0) total
    FROM affiliate_withdrawals
    WHERE affiliate_code=?
    AND status IN('PENDING','APPROVED','PAID')
  `).bind(code).first();

  return Math.max(0,Number(e?.total||0)-Number(w?.total||0));
}

async function sync(env){
  const rows=await env.DB.prepare(`
    SELECT id,referred_by
    FROM users
    WHERE referred_by IS NOT NULL AND referred_by!=''
  `).all();

  for(const r of rows.results||[]){
    const a=await affiliate(env,r.referred_by);
    if(!a)continue;

    await env.DB.prepare(`
      INSERT OR IGNORE INTO affiliate_referrals
      (affiliate_code,student_id,status,created_at)
      VALUES(?,?,'APPROVED',CURRENT_TIMESTAMP)
    `).bind(r.referred_by,r.id).run();
  }
}

export default{
  async fetch(req,env){
    if(req.method==="OPTIONS")
      return new Response(null,{headers:cors});

    try{
      await setup(env);
      await sync(env);

      const u=new URL(req.url);
      const p=u.pathname;

      if(p==="/api/dashboard"&&req.method==="GET"){
        if(!(await token(req,env)))
          return json({success:false,error:"Unauthorized"},401);

        /*
          The token from your English Worker must contain
          the user's identity. If your token endpoint already
          sends the affiliate code, use it directly.
        */

        const code=u.searchParams.get("affiliate_code");

        if(!code)
          return json({
            success:false,
            error:"Affiliate code required"
          },400);

        const a=await affiliate(env,code);

        if(!a)
          return json({
            success:false,
            error:"Affiliate not found"
          },404);

        const refs=await env.DB.prepare(`
          SELECT COUNT(*) count
          FROM affiliate_referrals
          WHERE affiliate_code=?
        `).bind(code).first();

        const sales=await env.DB.prepare(`
          SELECT
            COUNT(*) total_sales,
            COALESCE(SUM(commission),0) total_earned,
            COALESCE(SUM(
              CASE WHEN status='approved'
              THEN commission ELSE 0 END
            ),0) approved_earned
          FROM affiliate_sales
          WHERE affiliate_user_id=?
        `).bind(a.user_id).first();

        const available=await balance(
          env,code,a.user_id
        );

        return json({
          success:true,
          affiliate_code:code,
          referral_link:
            "https://createlk.com/Eng/?ref="+
            encodeURIComponent(code),
          referrals:Number(refs?.count||0),
          approved_sales:Number(sales?.total_sales||0),
          commission_rate:20,
          minimum_withdrawal:MIN,
          total_earned:Number(sales?.total_earned||0),
          pending_commission:Math.max(
            0,
            Number(sales?.total_earned||0)-
            Number(sales?.approved_earned||0)
          ),
          available_commission:available
        });
      }

      if(p==="/api/click"&&req.method==="POST"){
        const b=await req.json();
        const code=b.affiliate_code;

        if(!code)
          return json({
            success:false,
            error:"Affiliate code required"
          },400);

        const a=await affiliate(env,code);

        if(!a)
          return json({
            success:false,
            error:"Invalid affiliate code"
          },404);

        await env.DB.prepare(`
          INSERT INTO affiliate_clicks(affiliate_code)
          VALUES(?)
        `).bind(code).run();

        await env.DB.prepare(`
          UPDATE affiliates
          SET clicks=clicks+1
          WHERE affiliate_code=?
        `).bind(code).run();

        return json({success:true});
      }

      if(p==="/api/sale"&&req.method==="POST"){
        if(!(await token(req,env)))
          return json({
            success:false,
            error:"Unauthorized"
          },401);

        const b=await req.json();

        const code=b.affiliate_code;
        const student=b.student_id;
        const sub=Number(b.subscription_id);

        if(!code||!student||!sub)
          return json({
            success:false,
            error:"Missing sale data"
          },400);

        const a=await affiliate(env,code);

        if(!a)
          return json({
            success:false,
            error:"Invalid affiliate"
          },404);

        const user=await env.DB.prepare(`
          SELECT id,referred_by
          FROM users WHERE id=?
        `).bind(student).first();

        if(!user||user.referred_by!==code)
          return json({
            success:false,
            error:"Referral mismatch"
          },400);

        const s=await env.DB.prepare(`
          SELECT id,user_id,amount,status
          FROM subscriptions WHERE id=?
        `).bind(sub).first();

        if(!s||s.user_id!==student)
          return json({
            success:false,
            error:"Invalid subscription"
          },400);

        if(String(s.status).toLowerCase()!=="approved")
          return json({
            success:false,
            error:"Subscription not approved"
          },400);

        const exists=await env.DB.prepare(`
          SELECT id FROM affiliate_sales
          WHERE subscription_id=?
        `).bind(sub).first();

        if(exists)
          return json({
            success:true,
            duplicate:true,
            commission:Number(
              exists.commission||0
            )
          });

        const amount=Number(s.amount||0);
        const commission=Math.floor(amount*RATE);

        await env.DB.prepare(`
          INSERT INTO affiliate_sales
          (affiliate_user_id,referred_user_id,
           subscription_id,commission,status)
          VALUES(?,?,?,?,'approved')
        `).bind(
          a.user_id,
          student,
          sub,
          commission
        ).run();

        await env.DB.prepare(`
          UPDATE affiliates
          SET sales=sales+1,
              earnings=earnings+?
          WHERE affiliate_code=?
        `).bind(commission,code).run();

        await env.DB.prepare(`
          UPDATE affiliate_referrals
          SET status='APPROVED',
              sale_amount=COALESCE(sale_amount,0)+?,
              commission=COALESCE(commission,0)+?,
              approved_at=CURRENT_TIMESTAMP
          WHERE affiliate_code=? AND student_id=?
        `).bind(
          amount,
          commission,
          code,
          student
        ).run();

        return json({
          success:true,
          commission,
          amount,
          rate:20
        });
      }

      if(p==="/api/withdraw"&&req.method==="POST"){
        if(!(await token(req,env)))
          return json({
            success:false,
            error:"Unauthorized"
          },401);

        const b=await req.json();
        const code=b.affiliate_code;

        if(!code)
          return json({
            success:false,
            error:"Affiliate code required"
          },400);

        const a=await affiliate(env,code);

        if(!a||a.user_id!==b.user_id)
          return json({
            success:false,
            error:"Invalid affiliate"
          },400);

        const amount=Math.floor(
          Number(b.amount)
        );

        const available=await balance(
          env,code,a.user_id
        );

        if(amount<MIN)
          return json({
            success:false,
            error:"Minimum withdrawal is LKR "+MIN
          },400);

        if(amount>available)
          return json({
            success:false,
            error:"Insufficient available commission"
          },400);

        if(!b.account_name||
           !b.bank||
           !b.branch||
           !b.account_number)
          return json({
            success:false,
            error:"Complete bank details required"
          },400);

        await env.DB.prepare(`
          INSERT INTO affiliate_withdrawals
          (user_id,affiliate_code,amount,
           account_name,bank,branch,account_number)
          VALUES(?,?,?,?,?,?,?)
        `).bind(
          b.user_id,
          code,
          amount,
          b.account_name,
          b.bank,
          b.branch,
          b.account_number
        ).run();

        return json({
          success:true,
          amount,
          status:"PENDING"
        });
      }

      if(p==="/api/withdrawals"&&req.method==="GET"){
        if(!(await token(req,env)))
          return json({
            success:false,
            error:"Unauthorized"
          },401);

        const code=u.searchParams.get("affiliate_code");

        if(!code)
          return json({
            success:false,
            error:"Affiliate code required"
          },400);

        const rows=await env.DB.prepare(`
          SELECT id,amount,account_name,bank,branch,
                 account_number,status,created_at,processed_at
          FROM affiliate_withdrawals
          WHERE affiliate_code=?
          ORDER BY id DESC
        `).bind(code).all();

        return json({
          success:true,
          withdrawals:rows.results||[]
        });
      }

      return json({
        success:true,
        service:"CreateLK English Affiliate"
      });

    }catch(e){
      return json({
        success:false,
        error:e.message||"Server error"
      },500);
    }
  }
};