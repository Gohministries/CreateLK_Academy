const MIN_WITHDRAWAL=2000,COMMISSION_RATE=.20;

const cors=r=>({
 "Access-Control-Allow-Origin":r.headers.get("Origin")||"*",
 "Access-Control-Allow-Credentials":"true",
 "Access-Control-Allow-Methods":"GET,POST,OPTIONS",
 "Access-Control-Allow-Headers":"Content-Type,Authorization",
 "Vary":"Origin"
});

const json=(d,s,r)=>new Response(JSON.stringify(d),{
 status:s||200,
 headers:{
  "Content-Type":"application/json;charset=UTF-8",
  "Cache-Control":"no-store",
  ...cors(r)
 }
});

const b64u=a=>btoa(String.fromCharCode(...new Uint8Array(a)))
 .replace(/\+/g,"-").replace(/\//g,"_").replace(/=+$/,"");

const unb64u=s=>{
 s=s.replace(/-/g,"+").replace(/_/g,"/");
 while(s.length%4)s+="=";
 return Uint8Array.from(atob(s),c=>c.charCodeAt(0));
};

async function key(secret){
 return crypto.subtle.importKey(
  "raw",
  new TextEncoder().encode(secret),
  {name:"HMAC",hash:"SHA-256"},
  false,
  ["verify"]
 );
}

async function auth(r,e){
 const h=r.headers.get("Authorization")||"";
 if(!h.startsWith("Bearer "))return null;

 const token=h.slice(7);
 const p=token.split(".");
 if(p.length!==2)return null;

 try{
  const data=JSON.parse(
   new TextDecoder().decode(unb64u(p[0]))
  );

  if(!data.user_id||!data.exp||Date.now()>Number(data.exp))
   return null;

  if(!e.AFFILIATE_SECRET)return null;

  const ok=await crypto.subtle.verify(
   "HMAC",
   await key(e.AFFILIATE_SECRET),
   unb64u(p[1]),
   new TextEncoder().encode(p[0])
  );

  if(!ok)return null;

  return e.DB.prepare(`
   SELECT id,name,email,affiliate_code
   FROM users WHERE id=? LIMIT 1
  `).bind(data.user_id).first();

 }catch{
  return null;
 }
}

async function setup(e){

 await e.DB.prepare(`
  CREATE TABLE IF NOT EXISTS affiliate_clicks(
   id INTEGER PRIMARY KEY AUTOINCREMENT,
   affiliate_code TEXT NOT NULL,
   created_at TEXT DEFAULT CURRENT_TIMESTAMP
  )
 `).run();

 await e.DB.prepare(`
  CREATE TABLE IF NOT EXISTS affiliate_referrals(
   id INTEGER PRIMARY KEY AUTOINCREMENT,
   affiliate_code TEXT NOT NULL,
   student_id TEXT NOT NULL,
   status TEXT DEFAULT 'PENDING',
   sale_amount INTEGER DEFAULT 0,
   commission INTEGER DEFAULT 0,
   created_at TEXT DEFAULT CURRENT_TIMESTAMP,
   approved_at TEXT,
   UNIQUE(affiliate_code,student_id)
  )
 `).run();

 await e.DB.prepare(`
  CREATE TABLE IF NOT EXISTS affiliate_withdrawals(
   id INTEGER PRIMARY KEY AUTOINCREMENT,
   user_id TEXT NOT NULL,
   affiliate_code TEXT NOT NULL,
   amount INTEGER NOT NULL,
   account_name TEXT NOT NULL,
   bank TEXT NOT NULL,
   branch TEXT NOT NULL,
   account_number TEXT NOT NULL,
   status TEXT DEFAULT 'PENDING',
   created_at TEXT DEFAULT CURRENT_TIMESTAMP,
   processed_at TEXT
  )
 `).run();
}

/*
 Sync registrations from the main referrals table.
 New registration = referral immediately.
 Payment approval = handled by Admin Worker.
*/
async function syncReferrals(e){

 try{

  const r=await e.DB.prepare(`
   SELECT
    x.referrer_id,
    x.referred_user_id,
    UPPER(TRIM(x.affiliate_code)) affiliate_code,
    x.created_at
   FROM referrals x
   JOIN users ref
    ON ref.id=x.referrer_id
   AND UPPER(TRIM(ref.affiliate_code))
       =UPPER(TRIM(x.affiliate_code))
   JOIN users student
    ON student.id=x.referred_user_id
   WHERE x.referrer_id IS NOT NULL
   AND x.referred_user_id IS NOT NULL
   AND x.affiliate_code IS NOT NULL
   AND TRIM(x.affiliate_code)!=''
   AND x.referrer_id!=x.referred_user_id
  `).all();

  for(const x of r.results||[]){

   await e.DB.prepare(`
    INSERT OR IGNORE INTO affiliate_referrals(
     affiliate_code,
     student_id,
     status,
     sale_amount,
     commission,
     created_at
    )
    VALUES(?,?,'PENDING',0,0,?)
   `).bind(
    x.affiliate_code,
    String(x.referred_user_id),
    x.created_at||new Date().toISOString()
   ).run();

  }

 }catch{}
}

async function available(e,code){

 const earned=await e.DB.prepare(`
  SELECT COALESCE(SUM(commission),0) n
  FROM affiliate_referrals
  WHERE affiliate_code=? AND status='APPROVED'
 `).bind(code).first();

 const used=await e.DB.prepare(`
  SELECT COALESCE(SUM(amount),0) n
  FROM affiliate_withdrawals
  WHERE affiliate_code=?
  AND status IN('PENDING','PAID')
 `).bind(code).first();

 return Math.max(
  0,
  Number(earned?.n||0)-Number(used?.n||0)
 );
}

export default{

 async fetch(request,env){

  if(request.method==="OPTIONS")
   return new Response(null,{
    status:204,
    headers:cors(request)
   });

  try{

   await setup(env);
   await syncReferrals(env);

   const url=new URL(request.url);

   if(url.pathname==="/")
    return new Response(
     "CreateLK Affiliate V2 API is running ✅"
    );

   /* CLICK */

   if(url.pathname==="/api/click"&&request.method==="POST"){

    const b=await request.json();
    const code=String(
     b.affiliate_code||""
    ).trim().toUpperCase();

    if(!/^[A-Z0-9_-]{3,100}$/.test(code))
     return json({
      success:false,
      error:"Invalid affiliate code"
     },400,request);

    const u=await env.DB.prepare(`
     SELECT id FROM users
     WHERE UPPER(TRIM(affiliate_code))=?
     LIMIT 1
    `).bind(code).first();

    if(!u)
     return json({
      success:false,
      error:"Affiliate not found"
     },404,request);

    await env.DB.prepare(`
     INSERT INTO affiliate_clicks(affiliate_code)
     VALUES(?)
    `).bind(code).run();

    return json({
     success:true
    },200,request);
   }

   /* DASHBOARD */

   if(url.pathname==="/api/dashboard"){

    const u=await auth(request,env);

    if(!u)
     return json({
      success:false,
      error:"Invalid or expired affiliate token"
     },401,request);

    await syncReferrals(env);

    const code=String(u.affiliate_code||"")
     .trim().toUpperCase();

    const clicks=await env.DB.prepare(`
     SELECT COUNT(*) n
     FROM affiliate_clicks
     WHERE affiliate_code=?
    `).bind(code).first();

    const referrals=await env.DB.prepare(`
     SELECT COUNT(*) n
     FROM affiliate_referrals
     WHERE affiliate_code=?
    `).bind(code).first();

    const approved=await env.DB.prepare(`
     SELECT COUNT(*) n
     FROM affiliate_referrals
     WHERE affiliate_code=?
     AND status='APPROVED'
    `).bind(code).first();

    const pending=await env.DB.prepare(`
     SELECT COALESCE(SUM(commission),0) n
     FROM affiliate_referrals
     WHERE affiliate_code=?
     AND status='PENDING'
    `).bind(code).first();

    const paid=await env.DB.prepare(`
     SELECT COALESCE(SUM(amount),0) n
     FROM affiliate_withdrawals
     WHERE user_id=?
     AND status='PAID'
    `).bind(u.id).first();

    const earned=await env.DB.prepare(`
     SELECT COALESCE(SUM(commission),0) n
     FROM affiliate_referrals
     WHERE affiliate_code=?
     AND status='APPROVED'
    `).bind(code).first();

    const pendingWithdraw=await env.DB.prepare(`
     SELECT COALESCE(SUM(amount),0) n
     FROM affiliate_withdrawals
     WHERE user_id=?
     AND status='PENDING'
    `).bind(u.id).first();

    const totalEarned=Number(earned?.n||0);
    const pendingW=Number(pendingWithdraw?.n||0);
    const paidW=Number(paid?.n||0);

    return json({
     success:true,
     user:{
      id:u.id,
      name:u.name,
      email:u.email,
      affiliate_code:code
     },
     referral_link:
      `https://createlk.com/v2/?ref=${code}`,
     clicks:Number(clicks?.n)||0,
     referrals:Number(referrals?.n)||0,
     approved_sales:Number(approved?.n)||0,
     commission_rate:20,
     total_earned:totalEarned,
     pending_commission:Number(pending?.n)||0,
     withdrawal_pending:pendingW,
     withdrawal_paid:paidW,
     available_commission:
      Math.max(0,totalEarned-pendingW-paidW),
     minimum_withdrawal:MIN_WITHDRAWAL
    },200,request);
   }

   /* WITHDRAW */

   if(url.pathname==="/api/withdraw"&&request.method==="POST"){

    const u=await auth(request,env);

    if(!u)
     return json({
      success:false,
      error:"Invalid or expired affiliate token"
     },401,request);

    const b=await request.json();

    const amount=Math.floor(Number(b.amount));

    const accountName=String(
     b.account_name||""
    ).trim();

    const bank=String(
     b.bank||""
    ).trim();

    const branch=String(
     b.branch||""
    ).trim();

    const accountNumber=String(
     b.account_number||""
    ).trim();

    if(
     !Number.isFinite(amount)||
     amount<MIN_WITHDRAWAL
    )
     return json({
      success:false,
      error:`Minimum withdrawal is LKR ${MIN_WITHDRAWAL}`
     },400,request);

    if(
     !accountName||
     !bank||
     !branch||
     !accountNumber
    )
     return json({
      success:false,
      error:"Complete bank details are required"
     },400,request);

    if(accountName.length>100||
       bank.length>100||
       branch.length>100||
       accountNumber.length>50)
     return json({
      success:false,
      error:"Invalid bank details"
     },400,request);

    const code=String(u.affiliate_code||"")
     .trim().toUpperCase();

    const avail=await available(env,code);

    if(amount>avail)
     return json({
      success:false,
      error:"Insufficient available commission",
      available:avail
     },400,request);

    const pending=await env.DB.prepare(`
     SELECT id FROM affiliate_withdrawals
     WHERE user_id=? AND status='PENDING'
     LIMIT 1
    `).bind(u.id).first();

    if(pending)
     return json({
      success:false,
      error:"You already have a pending withdrawal"
     },409,request);

    await env.DB.prepare(`
     INSERT INTO affiliate_withdrawals(
      user_id,
      affiliate_code,
      amount,
      account_name,
      bank,
      branch,
      account_number
     )
     VALUES(?,?,?,?,?,?,?)
    `).bind(
     u.id,
     code,
     amount,
     accountName,
     bank,
     branch,
     accountNumber
    ).run();

    return json({
     success:true,
     message:"Withdrawal request submitted",
     amount
    },200,request);
   }

   /* WITHDRAWAL LIST */

   if(url.pathname==="/api/withdrawals"){

    const u=await auth(request,env);

    if(!u)
     return json({
      success:false,
      error:"Invalid or expired affiliate token"
     },401,request);

    const r=await env.DB.prepare(`
     SELECT
      id,amount,account_name,bank,branch,
      account_number,status,created_at,processed_at
     FROM affiliate_withdrawals
     WHERE user_id=?
     ORDER BY id DESC
     LIMIT 100
    `).bind(u.id).all();

    return json({
     success:true,
     withdrawals:r.results||[]
    },200,request);
   }

   return json({
    success:false,
    error:"Not found"
   },404,request);

  }catch(e){

   return json({
    success:false,
    error:e?.message||"Server error"
   },500,request);
  }
 }
};