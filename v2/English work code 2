const COOKIE="english_v2_session",DAYS=7,XP=10,COINS=5,MAXXP=10000,FREE=300,PREMIUM=1000,AFFILIATE_TOKEN_MINUTES=2;

const cors=r=>({
"Access-Control-Allow-Origin":r.headers.get("Origin")||"*",
"Access-Control-Allow-Credentials":"true",
"Access-Control-Allow-Methods":"GET,POST,OPTIONS",
"Access-Control-Allow-Headers":"Content-Type,Authorization","Vary":"Origin"
});

const json=(d,s,r)=>new Response(JSON.stringify(d),{
status:s||200,headers:{"Content-Type":"application/json","Cache-Control":"no-store",...cors(r)}
});

const ck=(r,n)=>{
 const x=(r.headers.get("Cookie")||"").match(new RegExp("(?:^|;\\s*)"+n+"=([^;]*)"));
 return x?decodeURIComponent(x[1]):null;
};

const rnd=(n=32)=>{
 const a=new Uint8Array(n);crypto.getRandomValues(a);
 return [...a].map(x=>x.toString(16).padStart(2,"0")).join("");
};

const prem=u=>String(u?.membership||"").trim().toLowerCase()==="premium";
const lim=u=>prem(u)?PREMIUM:FREE;

async function me(r,e){
 const t=ck(r,COOKIE);
 if(!t)return null;
 return e.DB.prepare(`
 SELECT u.id,u.google_id,u.email,u.name,u.avatar_url,u.membership,u.xp,u.coins,
 u.correct_answers,u.questions_answered,u.lessons_completed,u.affiliate_code,u.referred_by
 FROM users u JOIN sessions s ON s.user_id=u.id
 WHERE s.token=? AND s.expires_at>? LIMIT 1
 `).bind(t,new Date().toISOString()).first();
}

async function setup(e){
 try{
  const x=await e.DB.prepare("PRAGMA table_info(users)").all();
  if(!(x.results||[]).some(a=>a.name==="coins"))
   await e.DB.prepare("ALTER TABLE users ADD COLUMN coins INTEGER DEFAULT 0").run();
 }catch{}

 await e.DB.prepare(`
 CREATE TABLE IF NOT EXISTS sessions(
 token TEXT PRIMARY KEY,user_id TEXT,expires_at TEXT,created_at TEXT DEFAULT CURRENT_TIMESTAMP
 )`).run();

 await e.DB.prepare(`
 CREATE TABLE IF NOT EXISTS quiz_answers(
 id INTEGER PRIMARY KEY AUTOINCREMENT,user_id TEXT,question_id INTEGER,lesson_id INTEGER,
 selected_answer TEXT,is_correct INTEGER DEFAULT 0,xp_awarded INTEGER DEFAULT 0,
 coins_awarded INTEGER DEFAULT 0,answered_at TEXT DEFAULT CURRENT_TIMESTAMP,
 UNIQUE(user_id,question_id)
 )`).run();

 await e.DB.prepare(`
 CREATE TABLE IF NOT EXISTS referrals(
 id INTEGER PRIMARY KEY AUTOINCREMENT,referrer_id TEXT,referred_user_id TEXT UNIQUE,
 affiliate_code TEXT,created_at TEXT DEFAULT CURRENT_TIMESTAMP
 )`).run();
}

async function session(e,id){
 const t=rnd(),x=new Date(Date.now()+DAYS*86400000).toISOString();
 await e.DB.prepare("INSERT INTO sessions(token,user_id,expires_at) VALUES(?,?,?)")
 .bind(t,id,x).run();
 return t;
}

function b64(a){
 return btoa(String.fromCharCode(...new Uint8Array(a)))
 .replace(/\+/g,"-").replace(/\//g,"_").replace(/=+$/,"");
}

async function affToken(id,secret){
 const p=b64(new TextEncoder().encode(JSON.stringify({
  user_id:id,exp:Date.now()+AFFILIATE_TOKEN_MINUTES*60000
 })));
 const k=await crypto.subtle.importKey(
  "raw",new TextEncoder().encode(secret),
  {name:"HMAC",hash:"SHA-256"},false,["sign"]
 );
 const s=await crypto.subtle.sign("HMAC",k,new TextEncoder().encode(p));
 return p+"."+b64(s);
}

async function gtoken(e,code,uri){
 const r=await fetch("https://oauth2.googleapis.com/token",{
  method:"POST",
  headers:{"Content-Type":"application/x-www-form-urlencoded"},
  body:new URLSearchParams({
   client_id:e.GOOGLE_CLIENT_ID,
   client_secret:e.GOOGLE_CLIENT_SECRET,
   code,grant_type:"authorization_code",redirect_uri:uri
  })
 });
 if(!r.ok)throw Error("Google token failed");
 return r.json();
}

async function guser(t){
 const r=await fetch("https://www.googleapis.com/oauth2/v3/userinfo",{
  headers:{Authorization:`Bearer ${t}`}
 });
 if(!r.ok)throw Error("Google user failed");
 return r.json();
}

export default{
async fetch(r,e){
 const u=new URL(r.url);

 if(r.method==="OPTIONS")
  return new Response(null,{status:204,headers:cors(r)});

 try{
  if(!e.DB)return json({success:false,error:"D1 DB missing"},500,r);
  await setup(e);

  if(u.pathname==="/")
   return new Response("CreateLK English V2 API ✅");

  if(u.pathname==="/api/health")
   return json({success:true,database:true},200,r);

  /* LOGIN */
  if(u.pathname==="/auth/google"){
   const ref=(u.searchParams.get("ref")||"").trim().toUpperCase();
   const safe=/^[A-Z0-9_-]{3,100}$/.test(ref)?ref:"";
   const state=rnd()+(safe?"."+safe:"");
   const redirect=`${u.origin}/auth/google/callback`;
   const g=new URL("https://accounts.google.com/o/oauth2/v2/auth");

   Object.entries({
    client_id:e.GOOGLE_CLIENT_ID,
    redirect_uri:redirect,response_type:"code",
    scope:"openid email profile",access_type:"online",
    prompt:"select_account",state
   }).forEach(([k,v])=>g.searchParams.set(k,v));

   return new Response(null,{
    status:302,
    headers:{
     Location:g,
     "Set-Cookie":`oauth_state=${encodeURIComponent(state)};Path=/auth/google;Max-Age=600;HttpOnly;Secure;SameSite=Lax`
    }
   });
  }

  /* CALLBACK */
  if(u.pathname==="/auth/google/callback"){
   const code=u.searchParams.get("code"),state=u.searchParams.get("state")||"";
   if(!code||state!==ck(r,"oauth_state"))
    return json({success:false,error:"Invalid login"},400,r);

   const ref=state.includes(".")?state.split(".").slice(1).join(".").toUpperCase():"";
   const safe=/^[A-Z0-9_-]{3,100}$/.test(ref)?ref:"";
   const gt=await gtoken(e,code,`${u.origin}/auth/google/callback`);
   const g=await guser(gt.access_token);
   const gid=String(g.sub||""),email=String(g.email||"").toLowerCase();

   let user=await e.DB.prepare(
    "SELECT * FROM users WHERE google_id=? OR email=? LIMIT 1"
   ).bind(gid,email).first();

   let id=user?.id;

   if(!user){
    id=crypto.randomUUID();
    const code=rnd(6).toUpperCase();
    let referred=null,refid=null;

    if(safe){
     const x=await e.DB.prepare(
      "SELECT id,affiliate_code,email FROM users WHERE UPPER(affiliate_code)=? LIMIT 1"
     ).bind(safe).first();

     if(x&&String(x.email).toLowerCase()!==email){
      referred=x.affiliate_code;refid=x.id;
     }
    }

    await e.DB.prepare(`
    INSERT INTO users(
    id,google_id,email,name,avatar_url,membership,xp,coins,
    correct_answers,questions_answered,lessons_completed,affiliate_code,referred_by
    ) VALUES(?,?,?,?,?,'free',0,0,0,0,0,?,?)
    `).bind(
     id,gid,email,g.name||email.split("@")[0],g.picture||null,code,referred
    ).run();

    if(refid)
     await e.DB.prepare(`
     INSERT OR IGNORE INTO referrals(referrer_id,referred_user_id,affiliate_code)
     VALUES(?,?,?)
     `).bind(refid,id,referred).run();

   }else{
    id=user.id;
    await e.DB.prepare(`
    UPDATE users SET google_id=?,name=?,avatar_url=? WHERE id=?
    `).bind(gid,g.name||user.name,g.picture||user.avatar_url,id).run();

    if(safe&&!String(user.referred_by||"").trim()){
     const x=await e.DB.prepare(
      "SELECT id,affiliate_code,email FROM users WHERE UPPER(affiliate_code)=? LIMIT 1"
     ).bind(safe).first();

     if(x&&String(x.id)!==String(id)&&String(x.email).toLowerCase()!==email){
      await e.DB.prepare(
       "UPDATE users SET referred_by=? WHERE id=?"
      ).bind(x.affiliate_code,id).run();

      await e.DB.prepare(`
       INSERT OR IGNORE INTO referrals(referrer_id,referred_user_id,affiliate_code)
       VALUES(?,?,?)
      `).bind(x.id,id,x.affiliate_code).run();
     }
    }
   }

   const t=await session(e,id);
   const z=new Response(null,{
    status:302,
    headers:{Location:"https://createlk.com/v2/index.html"}
   });

   z.headers.append(
    "Set-Cookie",
    `${COOKIE}=${t};Path=/;Max-Age=${DAYS*86400};HttpOnly;Secure;SameSite=None`
   );
   z.headers.append(
    "Set-Cookie",
    "oauth_state=;Path=/auth/google;Max-Age=0;HttpOnly;Secure;SameSite=Lax"
   );
   return z;
  }

  /* ME */
  if(u.pathname==="/api/me"){
   const x=await me(r,e);
   if(!x)return json({success:true,logged_in:false,user:null},200,r);

   const n=await e.DB.prepare(
    "SELECT COUNT(*) n FROM quiz_answers WHERE user_id=?"
   ).bind(x.id).first();

   const ref=await e.DB.prepare(
    "SELECT COUNT(*) n FROM referrals WHERE referrer_id=?"
   ).bind(x.id).first();

   const l=lim(x);

   return json({
    success:true,logged_in:true,user:x,
    usage:{used:Number(n?.n)||0,limit:l,remaining:Math.max(0,l-(Number(n?.n)||0))},
    referral:{
     code:x.affiliate_code,
     referred_by:x.referred_by||null,
     count:Number(ref?.n)||0,
     link:`https://createlk.com/v2/?ref=${x.affiliate_code}`
    }
   },200,r);
  }

  /* AFFILIATE TOKEN */
  if(u.pathname==="/api/affiliate/token"){
   const x=await me(r,e);
   if(!x)return json({success:false,error:"Login required"},401,r);
   if(!e.AFFILIATE_SECRET)return json({success:false,error:"AFFILIATE_SECRET missing"},500,r);
   return json({success:true,token:await affToken(x.id,e.AFFILIATE_SECRET)},200,r);
  }

  /* LESSONS */
  if(u.pathname==="/api/lessons"){
   const x=await me(r,e);
   const a=await e.DB.prepare(
    "SELECT id,title,description,sort_order,is_free FROM lessons ORDER BY sort_order"
   ).all();

   return json({
    success:true,
    membership:x?String(x.membership||"").toLowerCase():"guest",
    lessons:(a.results||[]).map(l=>({
     ...l,
     is_free:Number(l.is_free)===1?1:0,
     accessible:Number(l.is_free)===1||prem(x)
    }))
   },200,r);
  }

  /* QUIZ */
  if(u.pathname==="/api/quiz"&&r.method==="GET"){
   const x=await me(r,e);
   if(!x)return json({success:false,error:"Login required"},401,r);

   const lid=Number(u.searchParams.get("lesson"));
   const lesson=await e.DB.prepare(
    "SELECT id,title,description,is_free FROM lessons WHERE id=?"
   ).bind(lid).first();

   if(!lesson)return json({success:false,error:"Lesson not found"},404,r);

   /* ONLY FREE LESSONS OR PREMIUM USERS */
   if(Number(lesson.is_free)!==1&&!prem(x))
    return json({success:false,error:"Premium membership required"},403,r);

   const n=await e.DB.prepare(
    "SELECT COUNT(*) n FROM quiz_answers WHERE user_id=?"
   ).bind(x.id).first();

   const used=Number(n?.n)||0,L=lim(x);
   if(used>=L)return json({success:false,error:"Question limit reached",used,limit:L},403,r);

   const q=await e.DB.prepare(`
    SELECT q.id,q.lesson_id,q.question_number,q.question,
    q.option_a,q.option_b,q.option_c,q.option_d
    FROM questions q
    WHERE q.lesson_id=?
    AND NOT EXISTS(
     SELECT 1 FROM quiz_answers a
     WHERE a.user_id=? AND a.question_id=q.id
    )
    ORDER BY q.question_number LIMIT ?
   `).bind(lid,x.id,L-used).all();

   return json({
    success:true,
    lesson,
    questions:q.results||[],
    usage:{used,limit:L,remaining:L-used}
   },200,r);
  }

  /* ANSWER */
  if(u.pathname==="/api/quiz/answer"&&r.method==="POST"){
   const x=await me(r,e);
   if(!x)return json({success:false,error:"Login required"},401,r);

   const b=await r.json();
   const qid=Number(b.question_id);
   const ans=String(b.selected_answer||"").toUpperCase();

   if(!qid||!["A","B","C","D"].includes(ans))
    return json({success:false,error:"Invalid answer"},400,r);

   const q=await e.DB.prepare(`
    SELECT q.id,q.lesson_id,q.correct_answer,l.is_free
    FROM questions q JOIN lessons l ON l.id=q.lesson_id
    WHERE q.id=?
   `).bind(qid).first();

   if(!q)return json({success:false,error:"Question not found"},404,r);

   /* PREMIUM LOCK CANNOT BE BYPASSED */
   if(Number(q.is_free)!==1&&!prem(x))
    return json({success:false,error:"Premium membership required"},403,r);

   const old=await e.DB.prepare(
    "SELECT * FROM quiz_answers WHERE user_id=? AND question_id=?"
   ).bind(x.id,qid).first();

   if(old)return json({
    success:true,already_answered:true,
    correct:Number(old.is_correct)===1,
    correct_answer:q.correct_answer
   },200,r);

   const n=await e.DB.prepare(
    "SELECT COUNT(*) n FROM quiz_answers WHERE user_id=?"
   ).bind(x.id).first();

   const used=Number(n?.n)||0,L=lim(x);
   if(used>=L)return json({success:false,error:"Question limit reached"},403,r);

   const ok=ans===String(q.correct_answer||"").toUpperCase();
   const xp=ok?XP:0,coins=ok?COINS:0;

   await e.DB.prepare(`
   INSERT INTO quiz_answers(
   user_id,question_id,lesson_id,selected_answer,is_correct,xp_awarded,coins_awarded
   ) VALUES(?,?,?,?,?,?,?)
   `).bind(x.id,qid,q.lesson_id,ans,ok?1:0,xp,coins).run();

   await e.DB.prepare(`
   UPDATE users SET
   xp=MIN(?,COALESCE(xp,0)+?),
   coins=COALESCE(coins,0)+?,
   correct_answers=COALESCE(correct_answers,0)+?,
   questions_answered=COALESCE(questions_answered,0)+1
   WHERE id=?
   `).bind(MAXXP,xp,coins,ok?1:0,x.id).run();

   return json({
    success:true,
    correct:ok,
    correct_answer:q.correct_answer,
    xp_awarded:xp,
    coins_awarded:coins,
    questions_answered:used+1,
    limit:L,
    remaining:Math.max(0,L-used-1)
   },200,r);
  }

  /* LOGOUT */
  if(u.pathname==="/auth/logout"){
   const t=ck(r,COOKIE);
   if(t)await e.DB.prepare("DELETE FROM sessions WHERE token=?").bind(t).run();

   const z=new Response(null,{
    status:302,
    headers:{Location:"https://createlk.com/v2/index.html"}
   });

   z.headers.set(
    "Set-Cookie",
    `${COOKIE}=;Path=/;Max-Age=0;HttpOnly;Secure;SameSite=None`
   );
   return z;
  }

  return json({success:false,error:"Not found"},404,r);

 }catch(err){
  return json({success:false,error:err.message||"Server error"},500,r);
 }
}
};