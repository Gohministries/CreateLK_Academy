const COOKIE_NAME="english_v2_session";
const SESSION_DAYS=7;
const XP_PER_CORRECT=10;
const MAX_XP=10000;

const FREE_LIMIT=300;
const PREMIUM_LIMIT=1000;

const APP_URL="https://createlk.com/v2/index.html";
const REDIRECT_URI="https://createlk-english-v2.createlk.workers.dev/auth/callback";

function cors(r){
  const o=r.headers.get("Origin")||"";
  const allowed=[
    "https://createlk.com",
    "https://www.createlk.com"
  ];

  return{
    "Access-Control-Allow-Origin":
      allowed.includes(o)?o:"https://createlk.com",
    "Access-Control-Allow-Credentials":"true",
    "Access-Control-Allow-Methods":"GET,POST,OPTIONS",
    "Access-Control-Allow-Headers":"Content-Type",
    "Content-Type":"application/json;charset=UTF-8",
    "Cache-Control":"no-store"
  };
}

function json(data,status=200,r){
  return new Response(JSON.stringify(data),{
    status,
    headers:cors(r)
  });
}

function cookie(name,value,maxAge){
  return `${name}=${encodeURIComponent(value)}; Path=/; Max-Age=${maxAge}; HttpOnly; Secure; SameSite=Lax`;
}

function clearCookie(name){
  return `${name}=; Path=/; Max-Age=0; HttpOnly; Secure; SameSite=Lax`;
}

function getCookie(r,name){
  const c=r.headers.get("Cookie")||"";

  const item=c.split(";")
    .map(x=>x.trim())
    .find(x=>x.startsWith(name+"="));

  return item
    ?decodeURIComponent(item.substring(name.length+1))
    :null;
}

async function currentUser(r,env){

  const token=getCookie(r,COOKIE_NAME);

  if(!token)return null;

  return await env.DB.prepare(`
    SELECT
      u.id,
      u.google_id,
      u.email,
      u.name,
      u.avatar_url,
      u.membership,
      u.xp,
      u.correct_answers,
      u.questions_answered,
      u.lessons_completed,
      u.affiliate_code,
      u.referred_by,
      s.expires_at AS session_expires_at
    FROM sessions s
    JOIN users u ON u.id=s.user_id
    WHERE s.token=?
      AND s.expires_at>datetime('now')
    LIMIT 1
  `).bind(token).first();
}

function userLimit(user){
  return String(user?.membership||"FREE").toUpperCase()==="PREMIUM"
    ?PREMIUM_LIMIT
    :FREE_LIMIT;
}

async function getAnswerCount(userId,env){

  const row=await env.DB.prepare(`
    SELECT COUNT(*) AS total
    FROM quiz_answers
    WHERE user_id=?
  `).bind(userId).first();

  return Number(row?.total||0);
}

async function googleToken(code,env){

  const r=await fetch(
    "https://oauth2.googleapis.com/token",
    {
      method:"POST",
      headers:{
        "Content-Type":
          "application/x-www-form-urlencoded"
      },
      body:new URLSearchParams({
        code,
        client_id:env.GOOGLE_CLIENT_ID,
        client_secret:env.GOOGLE_CLIENT_SECRET,
        redirect_uri:REDIRECT_URI,
        grant_type:"authorization_code"
      })
    }
  );

  return await r.json();
}

async function googleUser(accessToken){

  const r=await fetch(
    "https://www.googleapis.com/oauth2/v2/userinfo",
    {
      headers:{
        Authorization:`Bearer ${accessToken}`
      }
    }
  );

  return await r.json();
}

export default{

async fetch(request,env){

  const url=new URL(request.url);
  const path=url.pathname;

  if(request.method==="OPTIONS"){
    return new Response(null,{
      status:204,
      headers:cors(request)
    });
  }

  try{

    /* HOME */
    if(path==="/"){
      return Response.redirect(APP_URL,302);
    }

    /* GOOGLE LOGIN */
    if(path==="/auth/google"){

      const redirect=
        "https://accounts.google.com/o/oauth2/v2/auth?"+
        new URLSearchParams({
          client_id:env.GOOGLE_CLIENT_ID,
          redirect_uri:REDIRECT_URI,
          response_type:"code",
          scope:"openid email profile",
          access_type:"online",
          prompt:"select_account"
        }).toString();

      return Response.redirect(redirect,302);
    }

    /* GOOGLE CALLBACK */
    if(path==="/auth/callback"){

      const code=url.searchParams.get("code");

      if(!code){
        return Response.redirect(
          APP_URL+"?error=login",
          302
        );
      }

      const tokenData=
        await googleToken(code,env);

      if(!tokenData.access_token){

        console.error(
          "Google token error:",
          JSON.stringify(tokenData)
        );

        return Response.redirect(
          APP_URL+"?error=google",
          302
        );
      }

      const google=
        await googleUser(
          tokenData.access_token
        );

      if(!google.id){

        return Response.redirect(
          APP_URL+"?error=user",
          302
        );
      }

      let user=await env.DB.prepare(`
        SELECT *
        FROM users
        WHERE google_id=?
           OR email=?
        LIMIT 1
      `).bind(
        google.id,
        google.email||""
      ).first();

      if(user){

        await env.DB.prepare(`
          UPDATE users
          SET
            google_id=?,
            name=?,
            avatar_url=?,
            updated_at=CURRENT_TIMESTAMP
          WHERE id=?
        `).bind(
          google.id,
          google.name||user.name||"",
          google.picture||user.avatar_url||"",
          user.id
        ).run();

      }else{

        const id=crypto.randomUUID();

        const affiliate=
          "CL"+
          crypto.randomUUID()
          .replaceAll("-","")
          .substring(0,8)
          .toUpperCase();

        await env.DB.prepare(`
          INSERT INTO users(
            id,
            google_id,
            email,
            name,
            avatar_url,
            membership,
            xp,
            correct_answers,
            questions_answered,
            lessons_completed,
            affiliate_code,
            created_at,
            updated_at
          )
          VALUES(
            ?,?,?,?,?,?,
            0,0,0,0,?,
            CURRENT_TIMESTAMP,
            CURRENT_TIMESTAMP
          )
        `).bind(
          id,
          google.id,
          google.email||"",
          google.name||"",
          google.picture||"",
          "FREE",
          affiliate
        ).run();

        user=await env.DB.prepare(`
          SELECT *
          FROM users
          WHERE id=?
          LIMIT 1
        `).bind(id).first();
      }

      const sessionToken=
        crypto.randomUUID()+"."+
        crypto.randomUUID();

      await env.DB.prepare(`
        DELETE FROM sessions
        WHERE user_id=?
      `).bind(user.id).run();

      await env.DB.prepare(`
        INSERT INTO sessions(
          token,
          user_id,
          expires_at
        )
        VALUES(
          ?,?,
          datetime('now','+7 days')
        )
      `).bind(
        sessionToken,
        user.id
      ).run();

      return new Response(null,{
        status:302,
        headers:{
          Location:APP_URL,
          "Set-Cookie":
            cookie(
              COOKIE_NAME,
              sessionToken,
              SESSION_DAYS*86400
            )
        }
      });
    }

    /* LOGOUT */
    if(path==="/auth/logout"){

      const token=
        getCookie(request,COOKIE_NAME);

      if(token){

        await env.DB.prepare(`
          DELETE FROM sessions
          WHERE token=?
        `).bind(token).run();
      }

      return new Response(null,{
        status:302,
        headers:{
          Location:APP_URL,
          "Set-Cookie":
            clearCookie(COOKIE_NAME)
        }
      });
    }

    /* ME */
    if(path==="/api/me"){

      const user=
        await currentUser(request,env);

      if(!user){

        return json({
          success:false,
          user:null
        },401,request);
      }

      const count=
        await getAnswerCount(user.id,env);

      if(
        Number(user.questions_answered||0)!==
        count
      ){

        await env.DB.prepare(`
          UPDATE users
          SET
            questions_answered=?,
            updated_at=CURRENT_TIMESTAMP
          WHERE id=?
        `).bind(
          count,
          user.id
        ).run();

        user.questions_answered=count;
      }

      return json({
        success:true,
        user
      },200,request);
    }

    /* LESSONS */
    if(path==="/api/lessons"){

      const rows=await env.DB.prepare(`
        SELECT
          id,
          title,
          description,
          is_free
        FROM lessons
        ORDER BY id
      `).all();

      return json({
        success:true,
        lessons:rows.results||[]
      },200,request);
    }

    /* QUIZ */
    if(path==="/api/quiz"){

      const user=
        await currentUser(request,env);

      if(!user){

        return json({
          success:false,
          error:"LOGIN_REQUIRED"
        },401,request);
      }

      const lessonId=
        Number(url.searchParams.get("lesson"));

      if(!lessonId){

        return json({
          success:false,
          error:"INVALID_LESSON"
        },400,request);
      }

      const lesson=
        await env.DB.prepare(`
          SELECT
            id,
            title,
            description,
            is_free
          FROM lessons
          WHERE id=?
          LIMIT 1
        `).bind(lessonId).first();

      if(!lesson){

        return json({
          success:false,
          error:"LESSON_NOT_FOUND"
        },404,request);
      }

      const premium=
        String(user.membership||"FREE")
        .toUpperCase()==="PREMIUM";

      if(
        Number(lesson.is_free)!==1 &&
        !premium
      ){

        return json({
          success:false,
          error:"PREMIUM_REQUIRED"
        },403,request);
      }

      const limit=
        premium
        ?PREMIUM_LIMIT
        :FREE_LIMIT;

      const answered=
        await getAnswerCount(user.id,env);

      if(answered>=limit){

        return json({
          success:true,
          completed:true,
          limit,
          answered_count:answered,
          lesson,
          questions:[]
        },200,request);
      }

      const remaining=
        limit-answered;

      const rows=await env.DB.prepare(`
        SELECT
          q.id,
          q.lesson_id,
          q.question,
          q.option_a,
          q.option_b,
          q.option_c,
          q.option_d,
          q.explanation
        FROM questions q
        WHERE q.lesson_id=?
          AND NOT EXISTS(
            SELECT 1
            FROM quiz_answers qa
            WHERE qa.user_id=?
              AND qa.question_id=q.id
          )
        ORDER BY q.id
        LIMIT ?
      `).bind(
        lessonId,
        user.id,
        remaining
      ).all();

      return json({
        success:true,
        completed:false,
        limit,
        answered_count:answered,
        total_questions:
          rows.results?.length||0,
        lesson,
        questions:rows.results||[]
      },200,request);
    }

    /* ANSWER */
    if(
      path==="/api/quiz/answer" &&
      request.method==="POST"
    ){

      const user=
        await currentUser(request,env);

      if(!user){

        return json({
          success:false,
          error:"LOGIN_REQUIRED"
        },401,request);
      }

      const body=
        await request.json()
        .catch(()=>null);

      const questionId=
        Number(body?.question_id);

      const answer=
        String(body?.answer||"")
        .trim()
        .toUpperCase();

      if(
        !questionId||
        !["A","B","C","D"].includes(answer)
      ){

        return json({
          success:false,
          error:"INVALID_ANSWER"
        },400,request);
      }

      const question=
        await env.DB.prepare(`
          SELECT
            id,
            lesson_id,
            correct_answer,
            explanation
          FROM questions
          WHERE id=?
          LIMIT 1
        `).bind(questionId).first();

      if(!question){

        return json({
          success:false,
          error:"QUESTION_NOT_FOUND"
        },404,request);
      }

      const lesson=
        await env.DB.prepare(`
          SELECT
            id,
            is_free
          FROM lessons
          WHERE id=?
          LIMIT 1
        `).bind(question.lesson_id).first();

      if(!lesson){

        return json({
          success:false,
          error:"LESSON_NOT_FOUND"
        },404,request);
      }

      const premium=
        String(user.membership||"FREE")
        .toUpperCase()==="PREMIUM";

      if(
        Number(lesson.is_free)!==1 &&
        !premium
      ){

        return json({
          success:false,
          error:"PREMIUM_REQUIRED"
        },403,request);
      }

      const limit=
        premium
        ?PREMIUM_LIMIT
        :FREE_LIMIT;

      /* AUTHORITATIVE D1 COUNT */
      const total=
        await getAnswerCount(user.id,env);

      if(total>=limit){

        return json({
          success:false,
          error:"QUESTION_LIMIT_REACHED",
          answered_count:total,
          limit,
          remaining:0
        },403,request);
      }

      /* DUPLICATE ANSWER */
      const exists=
        await env.DB.prepare(`
          SELECT id
          FROM quiz_answers
          WHERE user_id=?
            AND question_id=?
          LIMIT 1
        `).bind(
          user.id,
          questionId
        ).first();

      if(exists){

        return json({
          success:false,
          error:"ALREADY_ANSWERED"
        },409,request);
      }

      const correct=
        answer===
        String(question.correct_answer||"")
        .trim()
        .toUpperCase();

      const xpAwarded=
        correct
        ?Math.min(
          XP_PER_CORRECT,
          Math.max(
            0,
            MAX_XP-(Number(user.xp)||0)
          )
        )
        :0;

      try{

        await env.DB.prepare(`
          INSERT INTO quiz_answers(
            user_id,
            question_id,
            lesson_id,
            selected_answer,
            is_correct,
            xp_awarded,
            answered_at
          )
          VALUES(
            ?,?,?,?,?,?,
            CURRENT_TIMESTAMP
          )
        `).bind(
          user.id,
          questionId,
          question.lesson_id,
          answer,
          correct?1:0,
          xpAwarded
        ).run();

      }catch(e){

        if(
          String(e.message||"")
          .toLowerCase()
          .includes("unique")
        ){

          return json({
            success:false,
            error:"ALREADY_ANSWERED"
          },409,request);
        }

        throw e;
      }

      /* D1 TOTAL AFTER ANSWER */
      const newCount=
        await getAnswerCount(user.id,env);

      const newXP=Math.min(
        MAX_XP,
        (Number(user.xp)||0)+xpAwarded
      );

      await env.DB.prepare(`
        UPDATE users
        SET
          xp=?,
          correct_answers=
            COALESCE(correct_answers,0)+?,
          questions_answered=?,
          updated_at=CURRENT_TIMESTAMP
        WHERE id=?
      `).bind(
        newXP,
        correct?1:0,
        newCount,
        user.id
      ).run();

      return json({
        success:true,
        correct,
        correct_answer:
          question.correct_answer,
        xp_awarded:xpAwarded,
        xp:newXP,
        questions_answered:newCount,
        limit,
        remaining:
          Math.max(0,limit-newCount),
        explanation:
          question.explanation||""
      },200,request);
    }

    /* LEADERBOARD */
    if(path==="/api/leaderboard"){

      const rows=await env.DB.prepare(`
        SELECT
          id,
          name,
          avatar_url,
          membership,
          xp,
          correct_answers,
          questions_answered
        FROM users
        WHERE questions_answered>0
        ORDER BY
          xp DESC,
          correct_answers DESC,
          questions_answered DESC,
          name ASC
        LIMIT 100
      `).all();

      return json({
        success:true,
        leaderboard:rows.results||[]
      },200,request);
    }

    return json({
      success:false,
      error:"NOT_FOUND"
    },404,request);

  }catch(e){

    console.error(
      "WORKER ERROR:",
      e?.stack||e?.message||e
    );

    return json({
      success:false,
      error:"SERVER_ERROR",
      message:String(e?.message||e)
    },500,request);
  }

}

};