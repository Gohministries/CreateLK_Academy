const MIN_WITHDRAWAL=2000;
const COMMISSION_RATE=.20;

const cors=r=>({
 "Access-Control-Allow-Origin":r.headers.get("Origin")||"*",
 "Access-Control-Allow-Credentials":"true",
 "Access-Control-Allow-Methods":"GET,POST,OPTIONS",
 "Access-Control-Allow-Headers":"Content-Type,Authorization",
 "Vary":"Origin"
});

const json=(d,s,r)=>new Response(JSON.stringify(d),{
 status:s||200,
 headers:{
  "Content-Type":"application/json;charset=UTF-8",
  "Cache-Control":"no-store",
  ...cors(r)
 }
});

function b64u(a){
 return btoa(String.fromCharCode(...new Uint8Array(a)))
 .replace(/\+/g,"-").replace(/\//g,"_").replace(/=+$/,"");
}

function ub64(s){
 s=s.replace(/-/g,"+").replace(/_/g,"/");
 while(s.length%4)s+="=";
 return Uint8Array.from(atob(s),c=>c.charCodeAt(0));
}

async function verifyToken(token,secret){
 try{
  const p=token.split(".");
  if(p.length!==2)return null;

  const data=p[0];
  const sig=ub64(p[1]);

  const key=await crypto.subtle.importKey(
   "raw",
   new TextEncoder().encode(secret),
   {name:"HMAC",hash:"SHA-256"},
   false,
   ["verify"]
  );

  const ok=await crypto.subtle.verify(
   "HMAC",
   key,
   sig,
   new TextEncoder().encode(data)
  );

  if(!ok)return null;

  const x=JSON.parse(
   new TextDecoder().decode(ub64(data))
  );

  if(!x.user_id||!x.exp||Date.now()>x.exp)return null;

  return x;
 }catch{
  return null;
 }
}

function bearer(r){
 const h=r.headers.get("Authorization")||"";
 return h.startsWith("Bearer ")?h.slice(7).trim():"";
}

async function setup(e){

 await e.DB.prepare(`
 CREATE TABLE IF NOT EXISTS affiliate_clicks(
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  affiliate_code TEXT NOT NULL,
  created_at TEXT DEFAULT CURRENT_TIMESTAMP
 )`).run();

 await e.DB.prepare(`
 CREATE TABLE IF NOT EXISTS affiliate_referrals(
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  affiliate_code TEXT NOT NULL,
  student_id TEXT NOT NULL,
  status TEXT DEFAULT 'PENDING',
  sale_amount INTEGER DEFAULT 0,
  commission INTEGER DEFAULT 0,
  created_at TEXT DEFAULT CURRENT_TIMESTAMP,
  approved_at TEXT,
  UNIQUE(affiliate_code,student_id)
 )`).run();

 await e.DB.prepare(`
 CREATE TABLE IF NOT EXISTS affiliate_withdrawals(
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  user_id TEXT NOT NULL,
  affiliate_code TEXT NOT NULL,
  amount INTEGER NOT NULL,
  account_name TEXT NOT NULL,
  bank TEXT NOT NULL,
  branch TEXT NOT NULL,
  account_number TEXT NOT NULL,
  status TEXT DEFAULT 'PENDING',
  created_at TEXT DEFAULT CURRENT_TIMESTAMP,
  processed_at TEXT
 )`).run();
}

async function getUser(r,e){

 const token=bearer(r);
 if(!token||!e.AFFILIATE_SECRET)return null;

 const x=await verifyToken(token,e.AFFILIATE_SECRET);
 if(!x)return null;

 return e.DB.prepare(`
 SELECT id,name,email,affiliate_code
 FROM users
 WHERE id=?
 LIMIT 1
 `).bind(x.user_id).first();
}

async function available(e,code){

 const a=await e.DB.prepare(`
 SELECT COALESCE(SUM(commission),0) total
 FROM affiliate_referrals
 WHERE affiliate_code=?
 AND status='APPROVED'
 `).bind(code).first();

 const w=await e.DB.prepare(`
 SELECT COALESCE(SUM(amount),0) total
 FROM affiliate_withdrawals
 WHERE affiliate_code=?
 AND status IN ('PENDING','PAID')
 `).bind(code).first();

 return Math.max(
  0,
  Number(a?.total||0)-Number(w?.total||0)
 );
}

export default{

 async fetch(request,env){

  const url=new URL(request.url);

  if(request.method==="OPTIONS")
   return new Response(null,{
    status:204,
    headers:cors(request)
   });

  try{

   await setup(env);

   if(url.pathname==="/")
    return new Response(
     "CreateLK Affiliate V2 is running ✅"
    );

   /* CLICK */

   if(url.pathname==="/api/click"&&request.method==="POST"){

    const b=await request.json().catch(()=>({}));
    const code=String(b.code||"").trim().toUpperCase();

    if(!code)
     return json({
      success:false,
      error:"Invalid affiliate code"
     },400,request);

    const u=await env.DB.prepare(`
     SELECT id
     FROM users
     WHERE affiliate_code=?
     LIMIT 1
    `).bind(code).first();

    if(!u)
     return json({
      success:false,
      error:"Affiliate not found"
     },404,request);

    await env.DB.prepare(`
     INSERT INTO affiliate_clicks(affiliate_code)
     VALUES(?)
    `).bind(code).run();

    return json({
     success:true
    },200,request);
   }

   /* DASHBOARD */

   if(url.pathname==="/api/dashboard"&&request.method==="GET"){

    const u=await getUser(request,env);

    if(!u)
     return json({
      success:false,
      error:"Login required"
     },401,request);

    const code=u.affiliate_code;

    const clicks=await env.DB.prepare(`
     SELECT COUNT(*) n
     FROM affiliate_clicks
     WHERE affiliate_code=?
    `).bind(code).first();

    const referrals=await env.DB.prepare(`
     SELECT COUNT(*) n
     FROM affiliate_referrals
     WHERE affiliate_code=?
    `).bind(code).first();

    const sales=await env.DB.prepare(`
     SELECT COUNT(*) n
     FROM affiliate_referrals
     WHERE affiliate_code=?
     AND status='APPROVED'
    `).bind(code).first();

    const pending=await env.DB.prepare(`
     SELECT COALESCE(SUM(commission),0) total
     FROM affiliate_referrals
     WHERE affiliate_code=?
     AND status='PENDING'
    `).bind(code).first();

    const paid=await env.DB.prepare(`
     SELECT COALESCE(SUM(amount),0) total
     FROM affiliate_withdrawals
     WHERE affiliate_code=?
     AND status='PAID'
    `).bind(code).first();

    const avail=await available(env,code);

    return json({
     success:true,
     name:u.name,
     email:u.email,
     affiliate_code:code,
     referral_link:
      `https://createlk.com/v2/?ref=${code}`,
     clicks:Number(clicks?.n||0),
     referrals:Number(referrals?.n||0),
     approved_sales:Number(sales?.n||0),
     commission_rate:20,
     available_commission:avail,
     pending_commission:
      Number(pending?.total||0),
     paid:Number(paid?.total||0),
     minimum_payout:MIN_WITHDRAWAL
    },200,request);
   }

   /* WITHDRAW */

   if(url.pathname==="/api/withdraw"&&request.method==="POST"){

    const u=await getUser(request,env);

    if(!u)
     return json({
      success:false,
      error:"Login required"
     },401,request);

    const b=await request.json().catch(()=>({}));

    const accountName=
     String(b.account_name||"").trim();

    const bank=
     String(b.bank||"").trim();

    const branch=
     String(b.branch||"").trim();

    const accountNumber=
     String(b.account_number||"").trim();

    if(
     !accountName||
     !bank||
     !branch||
     !accountNumber
    )
     return json({
      success:false,
      error:"Please complete all bank details"
     },400,request);

    const amount=
     await available(env,u.affiliate_code);

    if(amount<MIN_WITHDRAWAL)
     return json({
      success:false,
      error:
       `Minimum withdrawal is LKR ${MIN_WITHDRAWAL}`
     },400,request);

    const pending=await env.DB.prepare(`
     SELECT id
     FROM affiliate_withdrawals
     WHERE affiliate_code=?
     AND status='PENDING'
     LIMIT 1
    `).bind(u.affiliate_code).first();

    if(pending)
     return json({
      success:false,
      error:
       "You already have a pending withdrawal request"
     },400,request);

    await env.DB.prepare(`
     INSERT INTO affiliate_withdrawals(
      user_id,
      affiliate_code,
      amount,
      account_name,
      bank,
      branch,
      account_number,
      status
     )
     VALUES(?,?,?,?,?,?,?,'PENDING')
    `).bind(
     u.id,
     u.affiliate_code,
     amount,
     accountName,
     bank,
     branch,
     accountNumber
    ).run();

    return json({
     success:true,
     message:"Withdrawal request submitted",
     amount
    },200,request);
   }

   return json({
    success:false,
    error:"Not found"
   },404,request);

  }catch(e){

   return json({
    success:false,
    error:e.message||"Server error"
   },500,request);
  }
 }
};