
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#102a56">
<title>CreateLK Academy Admin V2</title>
<script src="https://accounts.google.com/gsi/client" async defer></script>
<style>
:root{--n:#102a56;--b:#155eef;--g:#d69b16;--bd:#dfe6f0}
*{box-sizing:border-box}
body{margin:0;background:#f3f6fb;color:#17243a;font:14px Arial}
header{display:flex;align-items:center;gap:7px;padding:12px;background:var(--n);color:white;position:sticky;top:0;z-index:10}
header h1{font-size:17px;margin:0;flex:1}
button{border:0;border-radius:8px;padding:10px 12px;background:var(--b);color:white;font-weight:bold;cursor:pointer;margin:3px}
header button{margin:0}
.menu-btn{background:var(--g);color:var(--n)}
main{max-width:1000px;margin:auto;padding:14px}
.card{background:white;border:1px solid var(--bd);border-radius:12px;padding:16px;margin-bottom:15px}
h2{font-size:20px;color:var(--n);margin:0 0 15px}
h3{color:var(--n)}
label{display:block;font-weight:bold;margin:12px 0 5px}
input,select,textarea{width:100%;padding:11px;border:1px solid #cbd5e1;border-radius:8px;font:inherit;background:white}
input[type=checkbox]{width:auto}
textarea{min-height:80px}
.menu{display:none;position:fixed;top:65px;right:8px;z-index:100;width:260px;max-width:90vw;padding:10px;background:white;border:1px solid var(--bd);border-radius:12px;box-shadow:0 8px 25px #0003}
.menu.open{display:block}
.menu button{display:block;width:100%;text-align:left;margin:4px 0}
.secondary{background:#eaf0fa;color:var(--n)}
.gold{background:var(--g);color:var(--n)}
.danger{background:#b42318}
.stats{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
.stat{padding:15px;background:white;border:1px solid var(--bd);border-radius:10px}
.stat b{display:block;font-size:27px;color:var(--n);margin-top:7px}
.item{padding:13px;background:#f8fafc;border:1px solid var(--bd);border-radius:9px;margin:9px 0;overflow-wrap:anywhere}
.small{font-size:12px;color:#64748b}
#status{padding:12px;background:#eaf2ff;border-radius:8px;margin-bottom:14px;white-space:pre-wrap}
.error{background:#fff0ee!important;color:#a32118}
.ok{background:#e7f8ed!important;color:#146c37}
.thumb{max-width:100%;max-height:220px;border-radius:8px}
.editor{min-height:200px;padding:12px;border:1px solid #cbd5e1;border-radius:8px;overflow-wrap:anywhere}
.editor img{max-width:100%;height:auto}
.toolbar{display:flex;flex-wrap:wrap;gap:3px}
.toolbar button{margin:2px}
.page{display:none}
.page.active{display:block}
hr{border:0;border-top:1px solid var(--bd);margin:20px 0}
@media(min-width:650px){.stats{grid-template-columns:repeat(4,minmax(0,1fr))}}
@media(max-width:500px){main{padding:9px}header{padding:9px 6px;gap:5px}header h1{font-size:14px}.card{padding:12px}}
</style>
</head>
<body>
<header>
<h1>CreateLK Academy Admin</h1>
<button class="menu-btn" onclick="toggleMenu()">☰ Menu</button>
<button onclick="logout()">Sign Out</button>
</header>

<div id="menu" class="menu">
<button onclick="navigate('dashboard')">📊 Dashboard</button>
<button onclick="navigate('published')">📚 Published</button>
<button onclick="navigate('addnew')">➕ Add New</button>
<button class="secondary" onclick="refreshAll()">🔄 Refresh Data</button>
</div>

<main>
<section id="login" class="card">
<h2>Admin Sign In</h2>
<p class="small">Sign in with your authorized Google account.</p>
<div id="googleButton"></div>
<label><input type="checkbox" id="stay" checked> Stay logged in</label>
</section>

<div id="app" style="display:none">
<div id="status">Loading academy data...</div>

<section id="dashboard" class="page active">
<div class="card">
<h2>Academy Dashboard</h2>
<div class="stats">
<div class="stat">Subjects<b id="sSub">0</b></div>
<div class="stat">Total Lessons<b id="sLes">0</b></div>
<div class="stat">Free Lessons<b id="sFree">0</b></div>
<div class="stat">Premium Lessons<b id="sPremium">0</b></div>
<div class="stat">Published<b id="sPublished">0</b></div>
<div class="stat">Draft<b id="sDraft">0</b></div>
<div class="stat">Coming Soon<b id="sComing">0</b></div>
</div>
</div>
</section>

<section id="published" class="page">
<div class="card">
<h2>📚 Published Lessons — Edit</h2>
<p class="small">Select a subject first, then select a lesson. Use the status field to publish, draft, or schedule it as coming soon.</p>
<label>Subject</label>
<select id="pubSubject"></select>
<label>Lesson</label>
<select id="pubLesson"></select>
<div id="publishedEditor" style="display:none">
<hr>
<label>Lesson Title</label>
<input id="pubTitle" required>
<label>Description</label>
<textarea id="pubDescription"></textarea>
<label>Access</label>
<select id="pubFree"><option value="1">Free</option><option value="0">Premium</option></select>
<label>Status</label>
<select id="pubStatus">
<option value="PUBLISHED">Published</option>
<option value="DRAFT">Draft</option>
<option value="COMING_SOON">Coming Soon</option>
</select>
<h3>Lesson Photo</h3>
<label>Choose photo (max 10 MB)</label>
<input type="file" id="pubPhotoFile" accept="image/jpeg,image/png,image/webp,image/gif">
<button type="button" onclick="uploadPhoto('pub')">Upload Photo</button>
<label>Photo URL</label>
<input id="pubPhotoUrl" placeholder="https://...">
<button class="secondary" type="button" onclick="insertPhoto('pub')">Insert Photo into Notes</button>
<div id="pubPhotoPreview"></div>
<h3>Lesson Content</h3>
<div class="toolbar">
<button type="button" onclick="formatText('pubNotes','bold')"><b>B</b></button>
<button type="button" onclick="formatText('pubNotes','italic')"><i>I</i></button>
<button type="button" onclick="formatText('pubNotes','underline')"><u>U</u></button>
<button type="button" onclick="formatText('pubNotes','insertUnorderedList')">• Bullets</button>
<button type="button" onclick="formatText('pubNotes','insertOrderedList')">1. Numbers</button>
<button type="button" onclick="formatHeading('pubNotes')">Heading</button>
</div>
<div id="pubNotes" class="editor" contenteditable="true"></div>
<button class="gold" id="pubSave" onclick="saveLesson('pub')">Save All Changes</button>
<button class="danger" onclick="deleteSelectedLesson('pub')">Delete Lesson</button>
</div>
</div>
</section>

<section id="addnew" class="page">
<div class="card">
<h2>➕ Add New</h2>
<label>What do you want to add?</label>
<select id="addType" onchange="switchAddType()">
<option value="lesson">New Lesson</option>
<option value="subject">New Subject</option>
</select>

<div id="addSubjectBox" style="display:none">
<label>Subject Name</label>
<input id="newSubjectName" placeholder="e.g. Facebook Monetization">
<label>Subject Slug (optional)</label>
<input id="newSubjectSlug" placeholder="facebook-monetization">
<button onclick="createSubject()">Create Subject</button>
</div>

<div id="addLessonBox">
<label>Subject</label>
<select id="addSubject"></select>
<label>Lesson Title</label>
<input id="addTitle" placeholder="Enter lesson title">
<label>Description</label>
<textarea id="addDescription" placeholder="Short lesson description"></textarea>
<label>Access</label>
<select id="addFree"><option value="1">Free</option><option value="0">Premium</option></select>
<label>Status</label>
<select id="addStatus">
<option value="PUBLISHED">Published</option>
<option value="DRAFT">Draft</option>
<option value="COMING_SOON">Coming Soon</option>
</select>
<button onclick="createLesson()">Create Lesson</button>
</div>
</div>

<div class="card">
<h2>New Lesson Content</h2>
<p class="small">After creating a lesson, open Published, select its subject and lesson, then add the photo and lesson content.</p>
</div>
</section>
</div>
</main>

<script>
"use strict";
const API="https://update-v2.createlk.workers.dev";
const CLIENT="582157960266-mvlpmqne90d9q7ja5vuhi3g1aspvtp86.apps.googleusercontent.com";
const ADMIN="gateofheavensl1@gmail.com";
const $=id=>document.getElementById(id);
let token="",subjects=[],lessons=[],loadingNotes=false;

function esc(s){return String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));}
function status(t,type=""){$("status").textContent=t;$("status").className=type;}
function toggleMenu(){$("menu").classList.toggle("open");}
function closeMenu(){$("menu").classList.remove("open");}
function navigate(id){
closeMenu();
document.querySelectorAll(".page").forEach(p=>p.classList.remove("active"));
$(id).classList.add("active");
if(id==="published")fillPublishedSubjects();
if(id==="addnew")fillAddSubjects();
window.scrollTo({top:0,behavior:"smooth"});
}
async function api(path,options={}){
let headers=new Headers(options.headers||{});
headers.set("Authorization","Bearer "+token);
if(options.body&&!(options.body instanceof FormData))headers.set("Content-Type","application/json");
let r=await fetch(API+path,{...options,headers});
let d=await r.json().catch(()=>({}));
if(!r.ok)throw Error(d.error||"Request failed: "+r.status);
return d;
}
function initGoogle(){
if(!window.google?.accounts?.id)return setTimeout(initGoogle,300);
google.accounts.id.initialize({client_id:CLIENT,callback:googleLogin});
$("googleButton").innerHTML="";
google.accounts.id.renderButton($("googleButton"),{theme:"outline",size:"large"});
}
function googleLogin(r){
try{
let p=JSON.parse(atob(r.credential.split(".")[1].replace(/-/g,"+").replace(/_/g,"/")));
if(p.email?.toLowerCase()!==ADMIN||!p.email_verified)throw Error("Unauthorized Google account.");
token=r.credential;
let keep=$("stay").checked?localStorage:sessionStorage;
let other=keep===localStorage?sessionStorage:localStorage;
keep.setItem("admin_token",token);keep.setItem("admin_email",p.email);
other.removeItem("admin_token");other.removeItem("admin_email");
$("login").style.display="none";$("app").style.display="block";
loadAll();
}catch(e){alert(e.message);}
}
function logout(){
token="";
[localStorage,sessionStorage].forEach(s=>{s.removeItem("admin_token");s.removeItem("admin_email");});
$("app").style.display="none";$("login").style.display="block";
closeMenu();initGoogle();
}
function restore(){
let t=localStorage.getItem("admin_token")||sessionStorage.getItem("admin_token");
let e=localStorage.getItem("admin_email")||sessionStorage.getItem("admin_email");
if(!t||!e)return initGoogle();
try{
let p=JSON.parse(atob(t.split(".")[1].replace(/-/g,"+").replace(/_/g,"/")));
if(p.exp*1000>Date.now()&&p.email?.toLowerCase()===ADMIN){
token=t;$("login").style.display="none";$("app").style.display="block";loadAll();
}else logout();
}catch{logout();}
}
function isFree(l){return l.is_free===true||+l.is_free===1;}
function lessonStatus(l){return String(l.status||"PUBLISHED").toUpperCase();}
async function loadAll(){
try{
status("Loading academy data...");
let d=await api("/api/bootstrap");
subjects=d.subjects||[];lessons=d.lessons||[];
$("sSub").textContent=subjects.length;
$("sLes").textContent=lessons.length;
$("sFree").textContent=lessons.filter(isFree).length;
$("sPremium").textContent=lessons.filter(l=>!isFree(l)).length;
$("sPublished").textContent=lessons.filter(l=>lessonStatus(l)==="PUBLISHED").length;
$("sDraft").textContent=lessons.filter(l=>lessonStatus(l)==="DRAFT").length;
$("sComing").textContent=lessons.filter(l=>lessonStatus(l)==="COMING_SOON").length;
fillPublishedSubjects();fillAddSubjects();
status("Data loaded successfully.","ok");
}catch(e){status("Loading failed: "+e.message,"error");}
}
async function refreshAll(){closeMenu();await loadAll();}
function fillPublishedSubjects(){
let old=$("pubSubject").value;
$("pubSubject").innerHTML='<option value="">Select subject</option>'+subjects.map(s=>`<option value="${+s.id}">${esc(s.name)}</option>`).join("");
if(subjects.some(s=>String(s.id)===old))$("pubSubject").value=old;
fillPublishedLessons();
}
function fillPublishedLessons(){
let sid=$("pubSubject").value,old=$("pubLesson").value;
let list=lessons.filter(l=>(!sid||+l.subject_id===+sid)&&lessonStatus(l)==="PUBLISHED");
$("pubLesson").innerHTML='<option value="">Select published lesson</option>'+list.map(l=>`<option value="${+l.id}">${esc(l.title||"Untitled")} (#${+l.id})</option>`).join("");
if(list.some(l=>String(l.id)===old))$("pubLesson").value=old;
if(!$("pubLesson").value){$("publishedEditor").style.display="none";}
else $("publishedEditor").style.display="block";
}
$("pubSubject").onchange=fillPublishedLessons;
$("pubLesson").onchange=loadPublishedLesson;
function fillAddSubjects(){
let old=$("addSubject").value;
$("addSubject").innerHTML='<option value="">Select subject</option>'+subjects.map(s=>`<option value="${+s.id}">${esc(s.name)}</option>`).join("");
if(subjects.some(s=>String(s.id)===old))$("addSubject").value=old;
}
function switchAddType(){
let subject=$("addType").value==="subject";
$("addSubjectBox").style.display=subject?"block":"none";
$("addLessonBox").style.display=subject?"none":"block";
}
async function createSubject(){
let name=$("newSubjectName").value.trim(),slug=$("newSubjectSlug").value.trim();
if(!name)return status("Enter a subject name.","error");
try{
await api("/api/subjects",{method:"POST",body:JSON.stringify({name,slug})});
$("newSubjectName").value="";$("newSubjectSlug").value="";
await loadAll();status("Subject created successfully.","ok");
}catch(e){status("Could not create subject: "+e.message,"error");}
}
async function createLesson(){
let sid=$("addSubject").value,title=$("addTitle").value.trim();
if(!sid||!title)return status("Select a subject and enter a lesson title.","error");
try{
await api("/api/lessons",{method:"POST",body:JSON.stringify({
subject_id:+sid,title,description:$("addDescription").value.trim(),
is_free:$("addFree").value==="1",status:$("addStatus").value
})});
$("addTitle").value="";$("addDescription").value="";
await loadAll();status("Lesson created. Open Published to edit its full content.","ok");
}catch(e){status("Could not create lesson: "+e.message,"error");}
}
async function loadPublishedLesson(){
let id=$("pubLesson").value,l=lessons.find(x=>+x.id===+id);
if(!l){$("publishedEditor").style.display="none";return;}
$("publishedEditor").style.display="block";
$("pubTitle").value=l.title||"";
$("pubDescription").value=l.description||"";
$("pubFree").value=isFree(l)?"1":"0";
$("pubStatus").value=lessonStatus(l);
$("pubNotes").innerHTML="";$("pubPhotoUrl").value="";$("pubPhotoPreview").innerHTML="";
try{
let d=await api("/api/notes/"+id);
if($("pubLesson").value!==String(id))return;
$("pubNotes").innerHTML=d.content||"";
let m=(d.content||"").match(/<img[^>]+src=["'](https:\/\/[^"']+)["']/i);
if(m){$("pubPhotoUrl").value=m[1];$("pubPhotoPreview").innerHTML=`<img class="thumb" src="${esc(m[1])}" alt="Lesson photo">`;}
status("Lesson loaded.","ok");
}catch(e){status("Lesson selected. Notes could not be loaded: "+e.message,"error");}
}
async function saveLesson(){
let id=$("pubLesson").value,l=lessons.find(x=>+x.id===+id);
if(!l)return status("Select a lesson.","error");
let title=$("pubTitle").value.trim();
if(!title)return status("Enter a lesson title.","error");
$("pubSave").disabled=true;
try{
await api("/api/lessons/"+id,{method:"PUT",body:JSON.stringify({
title,description:$("pubDescription").value,
subject_id:+$("pubSubject").value,
is_free:$("pubFree").value==="1",status:$("pubStatus").value,
sort_order:l.sort_order??l.display_order??1,
display_order:l.display_order??l.sort_order??1
})});
await api("/api/notes/"+id,{method:"PUT",body:JSON.stringify({content:$("pubNotes").innerHTML})});
await loadAll();
$("pubSubject").value=String(l.subject_id);
fillPublishedLessons();
$("pubLesson").value=String(id);
await loadPublishedLesson();
status("Lesson and notes saved successfully.","ok");
}catch(e){status("Save failed: "+e.message,"error");}
finally{$("pubSave").disabled=false;}
}
async function deleteSelectedLesson(){
let id=$("pubLesson").value;
if(!id)return status("Select a lesson.","error");
if(!confirm("Delete this lesson permanently?"))return;
try{
await api("/api/lessons/"+id,{method:"DELETE"});
$("publishedEditor").style.display="none";
await loadAll();status("Lesson deleted.","ok");
}catch(e){status("Delete failed: "+e.message,"error");}
}
function formatText(id,command){
$(id).focus();document.execCommand(command,false,null);
}
function formatHeading(id){
$(id).focus();document.execCommand("formatBlock",false,"h3");
}
function insertPhoto(){
let url=$("pubPhotoUrl").value.trim();
if(!/^https:\/\/\S+$/i.test(url))return status("Enter a valid HTTPS photo URL.","error");
$("pubNotes").focus();
document.execCommand("insertHTML",false,'<p><img src="'+esc(url)+'" alt="Lesson photo" style="max-width:100%;height:auto"></p>');
status("Photo inserted. Save All Changes to keep it.","ok");
}
async function uploadPhoto(){
let file=$("pubPhotoFile").files[0],id=$("pubLesson").value;
if(!id)return status("Select a published lesson first.","error");
if(!file)return status("Choose a photo first.","error");
if(file.size>10*1024*1024)return status("Photo must be 10 MB or smaller.","error");
if(!["image/jpeg","image/png","image/webp","image/gif"].includes(file.type))return status("Use JPG, PNG, WEBP or GIF.","error");
try{
let fd=new FormData();fd.append("lesson_id",id);fd.append("file",file);
let d=await api("/api/lesson-images",{method:"POST",body:fd});
if(!d.url)throw Error("Worker did not return a photo URL.");
$("pubPhotoUrl").value=d.url;
$("pubPhotoPreview").innerHTML=`<img class="thumb" src="${esc(d.url)}" alt="Photo preview">`;
$("pubPhotoFile").value="";
status("Photo uploaded. Insert it into notes, then save changes.","ok");
}catch(e){status("Upload failed: "+e.message,"error");}
}
restore();
</script>
</body>
</html>
