
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#102a56">
<title>CreateLK Academy Admin V2</title>
<script src="https://accounts.google.com/gsi/client" async defer></script>
<style>
:root{--n:#102a56;--b:#155eef;--g:#d69b16;--bd:#dfe6f0}
*{box-sizing:border-box}body{margin:0;background:#f3f6fb;color:#17243a;font:14px Arial}
header{display:flex;align-items:center;gap:7px;padding:12px;background:var(--n);color:white;position:sticky;top:0;z-index:10}
header h1{font-size:17px;margin:0;flex:1}button{border:0;border-radius:8px;padding:10px 12px;background:var(--b);color:white;font-weight:bold;cursor:pointer;margin:3px}
header button{margin:0}.menu-btn,.gold{background:var(--g);color:var(--n)}main{max-width:1000px;margin:auto;padding:14px}
.card{background:white;border:1px solid var(--bd);border-radius:12px;padding:16px;margin-bottom:15px}
h2{font-size:20px;color:var(--n);margin:0 0 15px}h3{color:var(--n)}
label{display:block;font-weight:bold;margin:12px 0 5px}
input,select,textarea{width:100%;padding:11px;border:1px solid #cbd5e1;border-radius:8px;font:inherit;background:white}
input[type=checkbox]{width:auto}textarea{min-height:80px}
.menu{display:none;position:fixed;top:65px;right:8px;z-index:100;width:240px;padding:10px;background:white;border:1px solid var(--bd);border-radius:12px;box-shadow:0 8px 25px #0003}
.menu.open{display:block}.menu button{display:block;width:100%;text-align:left}.secondary{background:#eaf0fa;color:var(--n)}.danger{background:#b42318}
.stats{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.stat,.subcard{padding:13px;background:#f8fafc;border:1px solid var(--bd);border-radius:9px;margin:8px 0}
.stat b{display:block;font-size:24px;color:var(--n);margin-top:7px}.small{font-size:12px;color:#64748b}
#status{padding:12px;background:#eaf2ff;border-radius:8px;margin-bottom:14px;white-space:pre-wrap}
.error{background:#fff0ee!important;color:#a32118}.ok{background:#e7f8ed!important;color:#146c37}
.editor{min-height:130px;padding:12px;border:1px solid #cbd5e1;border-radius:8px;background:white;overflow-wrap:anywhere}
.editor img,.thumb{max-width:100%;height:auto}.thumb{max-height:200px;border-radius:8px}
.toolbar{display:flex;flex-wrap:wrap;gap:3px}.toolbar button{margin:2px}.page{display:none}.page.active{display:block}
hr{border:0;border-top:1px solid var(--bd);margin:20px 0}
@media(min-width:650px){.stats{grid-template-columns:repeat(4,1fr)}}
@media(max-width:500px){main{padding:9px}header{padding:9px 6px}header h1{font-size:14px}.card{padding:12px}}
</style>
</head>
<body>
<header><h1>CreateLK Academy Admin</h1>
<button class="menu-btn" onclick="toggleMenu()">☰ Menu</button>
<button onclick="logout()">Sign Out</button></header>

<div id="menu" class="menu">
<button onclick="nav('dashboard')">📊 Dashboard</button>
<button onclick="nav('published')">📚 Edit Lessons</button>
<button onclick="nav('addnew')">➕ Add New</button>
<button class="secondary" onclick="loadAll()">🔄 Refresh</button>
</div>

<main>
<section id="login" class="card">
<h2>Admin Sign In</h2><p class="small">Authorized Google account only.</p>
<div id="googleButton"></div>
<label><input type="checkbox" id="stay" checked> Stay logged in</label>
</section>

<div id="app" style="display:none">
<div id="status">Loading...</div>

<section id="dashboard" class="page active">
<div class="card"><h2>Academy Dashboard</h2><div class="stats">
<div class="stat">Subjects<b id="sSub">0</b></div>
<div class="stat">Lessons<b id="sLes">0</b></div>
<div class="stat">Free<b id="sFree">0</b></div>
<div class="stat">Premium<b id="sPremium">0</b></div>
<div class="stat">Published<b id="sPublished">0</b></div>
<div class="stat">Draft<b id="sDraft">0</b></div>
<div class="stat">Coming Soon<b id="sComing">0</b></div>
</div></div></section>

<section id="published" class="page"><div class="card">
<h2>📚 Edit Lesson</h2>
<label>Subject</label><select id="pubSubject"></select>
<label>Lesson</label><select id="pubLesson"></select>

<div id="editorBox" style="display:none">
<hr><label>Title</label><input id="pubTitle">
<label>Description</label><textarea id="pubDescription"></textarea>
<label>Access</label><select id="pubFree"><option value="1">Free</option><option value="0">Premium</option></select>
<label>Status</label><select id="pubStatus">
<option value="PUBLISHED">Published</option><option value="DRAFT">Draft</option><option value="COMING_SOON">Coming Soon</option>
</select>

<h3>Lesson Photo</h3><input type="file" id="photoFile" accept="image/jpeg,image/png,image/webp,image/gif">
<button onclick="uploadPhoto()">Upload Photo</button>
<label>Photo URL</label><input id="photoUrl" placeholder="https://...">
<button class="secondary" onclick="insertPhoto()">Insert Photo</button><div id="photoPreview"></div>

<h3>Lesson Content</h3><div class="toolbar">
<button onclick="fmt('notes','bold')"><b>B</b></button>
<button onclick="fmt('notes','italic')"><i>I</i></button>
<button onclick="fmt('notes','underline')"><u>U</u></button>
<button onclick="fmt('notes','insertUnorderedList')">• Bullets</button>
<button onclick="fmt('notes','insertOrderedList')">1. List</button>
<button onclick="heading('notes')">Heading</button></div>
<div id="notes" class="editor" contenteditable="true"></div>
<button class="gold" id="saveBtn" onclick="saveLesson()">Save Changes</button>
<button class="danger" onclick="deleteLesson()">Delete Lesson</button>

<hr><h3>🌐 Multilingual Subtitles</h3>
<p class="small">Add as many languages as needed. Students can choose a language when subtitles exist.</p>
<div id="subStatus" class="small"></div><div id="subList"></div>
<h3>Add Subtitle</h3>
<label>Language</label><input id="newLang" placeholder="Tamil, Sinhala, Hindi...">
<label>Title (optional)</label><input id="newSubTitle">
<label>Subtitle Content</label><div class="toolbar">
<button onclick="fmt('newContent','bold')"><b>B</b></button>
<button onclick="fmt('newContent','italic')"><i>I</i></button>
<button onclick="fmt('newContent','insertUnorderedList')">• Bullets</button>
<button onclick="heading('newContent')">Heading</button></div>
<div id="newContent" class="editor" contenteditable="true"></div>
<label>Display Order</label><input id="newOrder" type="number" min="1" value="1">
<button class="gold" id="addSubBtn" onclick="addSubtitle()">Save Subtitle</button>
</div></div></section>

<section id="addnew" class="page"><div class="card">
<h2>➕ Add New</h2><label>Type</label>
<select id="addType" onchange="switchType()"><option value="lesson">New Lesson</option><option value="subject">New Subject</option></select>
<div id="subjectBox" style="display:none">
<label>Subject Name</label><input id="newSubjectName">
<label>Slug (optional)</label><input id="newSubjectSlug">
<button onclick="createSubject()">Create Subject</button></div>
<div id="lessonBox">
<label>Subject</label><select id="addSubject"></select>
<label>Lesson Title</label><input id="addTitle">
<label>Description</label><textarea id="addDescription"></textarea>
<label>Access</label><select id="addFree"><option value="1">Free</option><option value="0">Premium</option></select>
<label>Status</label><select id="addStatus"><option value="PUBLISHED">Published</option><option value="DRAFT">Draft</option><option value="COMING_SOON">Coming Soon</option></select>
<button onclick="createLesson()">Create Lesson</button></div>
</div></section>
</div></main>

<script>
"use strict";
const API="https://update-v2.createlk.workers.dev";
const CLIENT="582157960266-mvlpmqne90d9q7ja5vuhi3g1aspvtp86.apps.googleusercontent.com";
const ADMIN="gateofheavensl1@gmail.com";
const $=id=>document.getElementById(id);
let token="",subjects=[],lessons=[],subtitles=[],currentSubLesson="";

function esc(v){return String(v??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));}
function msg(t,type=""){$("status").textContent=t;$("status").className=type;}
function subMsg(t,type=""){$("subStatus").textContent=t;$("subStatus").className="small "+type;}
function toggleMenu(){$("menu").classList.toggle("open");}
function nav(id){$("menu").classList.remove("open");document.querySelectorAll(".page").forEach(p=>p.classList.remove("active"));$(id).classList.add("active");if(id==="published")fillPubSubjects();if(id==="addnew")fillAddSubjects();window.scrollTo(0,0);}
async function api(path,opt={}){
 const h=new Headers(opt.headers||{});h.set("Authorization","Bearer "+token);
 if(opt.body&&!(opt.body instanceof FormData))h.set("Content-Type","application/json");
 const r=await fetch(API+path,{...opt,headers:h});
 const d=await r.json().catch(()=>({}));
 if(!r.ok)throw Error(d.error||"Request failed: "+r.status);
 return d;
}
function initGoogle(){
 if(!window.google?.accounts?.id)return setTimeout(initGoogle,300);
 google.accounts.id.initialize({client_id:CLIENT,callback:googleLogin});
 $("googleButton").innerHTML="";
 google.accounts.id.renderButton($("googleButton"),{theme:"outline",size:"large"});
}
function googleLogin(r){
 try{
  const p=JSON.parse(atob(r.credential.split(".")[1].replace(/-/g,"+").replace(/_/g,"/")));
  if(p.email?.toLowerCase()!==ADMIN||!p.email_verified)throw Error("Unauthorized account.");
  token=r.credential;
  const keep=$("stay").checked?localStorage:sessionStorage,other=keep===localStorage?sessionStorage:localStorage;
  keep.setItem("admin_token",token);keep.setItem("admin_email",p.email);
  other.removeItem("admin_token");other.removeItem("admin_email");
  $("login").style.display="none";$("app").style.display="block";loadAll();
 }catch(e){alert(e.message);}
}
function logout(){
 token="";[localStorage,sessionStorage].forEach(s=>{s.removeItem("admin_token");s.removeItem("admin_email");});
 $("app").style.display="none";$("login").style.display="block";initGoogle();
}
function restore(){
 const t=localStorage.getItem("admin_token")||sessionStorage.getItem("admin_token");
 const e=localStorage.getItem("admin_email")||sessionStorage.getItem("admin_email");
 if(!t||!e)return initGoogle();
 try{
  const p=JSON.parse(atob(t.split(".")[1].replace(/-/g,"+").replace(/_/g,"/")));
  if(p.exp*1000>Date.now()&&p.email?.toLowerCase()===ADMIN){token=t;$("login").style.display="none";$("app").style.display="block";loadAll();}
  else logout();
 }catch{logout();}
}
const free=l=>l.is_free===true||+l.is_free===1;
const status=l=>String(l.status||"PUBLISHED").toUpperCase();

async function loadAll(){
 try{
  msg("Loading...");const d=await api("/api/bootstrap");
  subjects=d.subjects||[];lessons=d.lessons||[];
  $("sSub").textContent=subjects.length;$("sLes").textContent=lessons.length;
  $("sFree").textContent=lessons.filter(free).length;$("sPremium").textContent=lessons.filter(l=>!free(l)).length;
  $("sPublished").textContent=lessons.filter(l=>status(l)==="PUBLISHED").length;
  $("sDraft").textContent=lessons.filter(l=>status(l)==="DRAFT").length;
  $("sComing").textContent=lessons.filter(l=>status(l)==="COMING_SOON").length;
  fillPubSubjects();fillAddSubjects();msg("Data loaded.","ok");
 }catch(e){msg("Loading failed: "+e.message,"error");}
}
function fillPubSubjects(){
 const old=$("pubSubject").value;
 $("pubSubject").innerHTML='<option value="">Select subject</option>'+subjects.map(s=>`<option value="${+s.id}">${esc(s.name)}</option>`).join("");
 if(subjects.some(s=>String(s.id)===old))$("pubSubject").value=old;
 fillPubLessons();
}
function fillPubLessons(){
 const sid=$("pubSubject").value,old=$("pubLesson").value;
 const a=lessons.filter(l=>(!sid||+l.subject_id===+sid)&&status(l)==="PUBLISHED");
 $("pubLesson").innerHTML='<option value="">Select lesson</option>'+a.map(l=>`<option value="${+l.id}">${esc(l.title)} (#${+l.id})</option>`).join("");
 if(a.some(l=>String(l.id)===old))$("pubLesson").value=old;
 const id=$("pubLesson").value;$("editorBox").style.display=id?"block":"none";
 if(id&&id!==currentSubLesson)loadPubLesson();
 if(!id){currentSubLesson="";$("subList").innerHTML="";$("subStatus").textContent="";$("newLang").value="";$("newSubTitle").value="";$("newContent").innerHTML="";}
}
$("pubSubject").onchange=()=>{currentSubLesson="";fillPubLessons();};
$("pubLesson").onchange=loadPubLesson;

function fillAddSubjects(){
 const old=$("addSubject").value;
 $("addSubject").innerHTML='<option value="">Select subject</option>'+subjects.map(s=>`<option value="${+s.id}">${esc(s.name)}</option>`).join("");
 if(subjects.some(s=>String(s.id)===old))$("addSubject").value=old;
}
function switchType(){const s=$("addType").value==="subject";$("subjectBox").style.display=s?"block":"none";$("lessonBox").style.display=s?"none":"block";}
async function createSubject(){
 const name=$("newSubjectName").value.trim(),slug=$("newSubjectSlug").value.trim();
 if(!name)return msg("Enter a subject name.","error");
 try{await api("/api/subjects",{method:"POST",body:JSON.stringify({name,slug})});$("newSubjectName").value="";$("newSubjectSlug").value="";await loadAll();msg("Subject created.","ok");}
 catch(e){msg(e.message,"error");}
}
async function createLesson(){
 const subject_id=+$("addSubject").value,title=$("addTitle").value.trim();
 if(!subject_id||!title)return msg("Select a subject and enter a title.","error");
 try{
  await api("/api/lessons",{method:"POST",body:JSON.stringify({subject_id,title,description:$("addDescription").value.trim(),is_free:$("addFree").value==="1",status:$("addStatus").value})});
  $("addTitle").value="";$("addDescription").value="";await loadAll();msg("Lesson created.","ok");
 }catch(e){msg(e.message,"error");}
}

async function loadPubLesson(){
 const id=$("pubLesson").value,l=lessons.find(x=>Number(x.id)===Number(id));
 if(!l){currentSubLesson="";$("editorBox").style.display="none";$("subList").innerHTML="";return;}
 currentSubLesson=String(l.id);$("editorBox").style.display="block";
 $("pubTitle").value=l.title||"";$("pubDescription").value=l.description||"";
 $("pubFree").value=free(l)?"1":"0";$("pubStatus").value=status(l);
 $("notes").innerHTML="";$("photoUrl").value="";$("photoPreview").innerHTML="";
 $("newLang").value="";$("newSubTitle").value="";$("newContent").innerHTML="";
 subMsg("Loading subtitles...");
 try{
  const d=await api("/api/notes/"+id);if($("pubLesson").value!==String(id))return;
  $("notes").innerHTML=d.content||"";
  const m=(d.content||"").match(/<img[^>]+src=["'](https:\/\/[^"']+)["']/i);
  if(m){$("photoUrl").value=m[1];$("photoPreview").innerHTML=`<img class="thumb" src="${esc(m[1])}" alt="Photo">`;}
  msg("Lesson loaded.","ok");
 }catch(e){msg("Notes load failed: "+e.message,"error");}
 await loadSubtitles(id);
}
async function saveLesson(){
 const id=$("pubLesson").value,l=lessons.find(x=>Number(x.id)===Number(id)),title=$("pubTitle").value.trim();
 if(!l||!title)return msg("Select a lesson and enter its title.","error");
 $("saveBtn").disabled=true;
 try{
  await api("/api/lessons/"+id,{method:"PUT",body:JSON.stringify({title,description:$("pubDescription").value,subject_id:+$("pubSubject").value,is_free:$("pubFree").value==="1",status:$("pubStatus").value,sort_order:l.sort_order??l.display_order??1,display_order:l.display_order??l.sort_order??1})});
  await api("/api/notes/"+id,{method:"PUT",body:JSON.stringify({content:$("notes").innerHTML})});
  await loadAll();$("pubSubject").value=String(l.subject_id);fillPubLessons();$("pubLesson").value=String(id);await loadPubLesson();msg("Lesson saved.","ok");
 }catch(e){msg("Save failed: "+e.message,"error");}
 finally{$("saveBtn").disabled=false;}
}
async function deleteLesson(){
 const id=$("pubLesson").value;if(!id||!confirm("Delete this lesson permanently?"))return;
 try{await api("/api/lessons/"+id,{method:"DELETE"});currentSubLesson="";await loadAll();msg("Lesson deleted.","ok");}
 catch(e){msg(e.message,"error");}
}
function fmt(id,cmd){$(id).focus();document.execCommand(cmd,false,null);}
function heading(id){$(id).focus();document.execCommand("formatBlock",false,"h3");}
function insertPhoto(){
 const url=$("photoUrl").value.trim();if(!/^https:\/\/\S+$/i.test(url))return msg("Enter a valid HTTPS photo URL.","error");
 $("notes").focus();document.execCommand("insertHTML",false,'<p><img src="'+esc(url)+'" alt="Lesson photo" style="max-width:100%;height:auto"></p>');msg("Photo inserted. Save changes.","ok");
}
async function uploadPhoto(){
 const file=$("photoFile").files[0],id=$("pubLesson").value;
 if(!id||!file)return msg("Select a lesson and photo.","error");
 if(file.size>10*1024*1024)return msg("Photo must be 10 MB or smaller.","error");
 if(!["image/jpeg","image/png","image/webp","image/gif"].includes(file.type))return msg("Unsupported photo type.","error");
 try{
  const fd=new FormData();fd.append("lesson_id",id);fd.append("file",file);
  const d=await api("/api/lesson-images",{method:"POST",body:fd});if(!d.url)throw Error("No photo URL returned.");
  $("photoUrl").value=d.url;$("photoPreview").innerHTML=`<img class="thumb" src="${esc(d.url)}" alt="Preview">`;$("photoFile").value="";msg("Photo uploaded. Insert it and save.","ok");
 }catch(e){msg("Upload failed: "+e.message,"error");}
}

/* SUBTITLES */
async function loadSubtitles(id){
 currentSubLesson=String(id);$("subList").innerHTML="";subtitles=[];
 try{
  const d=await api("/api/lesson-subtitles/lesson/"+id);
  if(currentSubLesson!==String(id)||$("pubLesson").value!==String(id))return;
  subtitles=d.subtitles||d.items||[];
  $("subList").innerHTML=subtitles.map(s=>`
   <div class="subcard"><b>${esc(s.language)} — #${+s.id}</b>
   <label>Language</label><input id="lang${+s.id}" value="${esc(s.language)}">
   <label>Title</label><input id="title${+s.id}" value="${esc(s.title||"")}">
   <label>Content</label><div id="content${+s.id}" class="editor" contenteditable="true">${s.content||""}</div>
   <label>Order</label><input id="order${+s.id}" type="number" min="1" value="${Math.max(1,+s.sort_order||1)}">
   <button class="gold" onclick="updateSubtitle(${+s.id})">Save</button>
   <button class="danger" onclick="deleteSubtitle(${+s.id})">Delete</button></div>`).join("");
  subMsg(subtitles.length?subtitles.length+" subtitles loaded":"No subtitles yet","ok");
 }catch(e){subMsg("Subtitle API error: "+e.message,"error");}
}
async function addSubtitle(){
 const lesson_id=Number(currentSubLesson),language=$("newLang").value.trim(),title=$("newSubTitle").value.trim(),content=$("newContent").innerHTML.trim();
 if(!lesson_id||!lessons.some(l=>Number(l.id)===lesson_id)||$("pubLesson").value!==String(lesson_id))return subMsg("Select and load a lesson first","error");
 if(!language||!content||content==="<br>")return subMsg("Enter language and content","error");
 $("addSubBtn").disabled=true;
 try{
  await api("/api/lesson-subtitles",{method:"POST",body:JSON.stringify({lesson_id,language,title,content,sort_order:Math.max(1,+$("newOrder").value||1)})});
  $("newLang").value="";$("newSubTitle").value="";$("newContent").innerHTML="";
  $("newOrder").value=Math.max(1,+$("newOrder").value||1)+1;
  await loadSubtitles(lesson_id);subMsg("Subtitle saved","ok");
 }catch(e){subMsg("Save failed: "+e.message,"error");}
 finally{$("addSubBtn").disabled=false;}
}
async function updateSubtitle(id){
 try{
  await api("/api/lesson-subtitles/"+id,{method:"PUT",body:JSON.stringify({language:$("lang"+id).value.trim(),title:$("title"+id).value.trim(),content:$("content"+id).innerHTML,sort_order:Math.max(1,+$("order"+id).value||1)})});
  await loadSubtitles(currentSubLesson);subMsg("Subtitle updated","ok");
 }catch(e){subMsg(e.message,"error");}
}
async function deleteSubtitle(id){
 if(!confirm("Delete this subtitle?"))return;
 try{await api("/api/lesson-subtitles/"+id,{method:"DELETE"});await loadSubtitles(currentSubLesson);subMsg("Subtitle deleted","ok");}
 catch(e){subMsg(e.message,"error");}
}
restore();
</script>
</body>
</html>
