<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#102a56">
<title>CreateLK Academy — Admin V2</title>
<script src="https://accounts.google.com/gsi/client" async defer></script>
<style>
:root{--n:#102a56;--b:#155eef;--g:#d69b16;--bg:#f3f6fb;--bd:#dfe6f0;--t:#17243a}
*{box-sizing:border-box}
body{margin:0;font:14px Arial;background:var(--bg);color:var(--t)}
aside{width:230px;background:var(--n);color:white;position:fixed;inset:0 auto 0 0;display:flex;flex-direction:column;z-index:10;transition:.25s}
.brand{padding:18px;border-bottom:1px solid #ffffff22}
.brand h1{margin:0;font-size:22px}.brand p{margin:5px 0 0;color:#dce6ff}
nav{padding:10px;flex:1}
nav button{display:block;width:100%;text-align:left;background:none;color:#dce6ff;margin:3px 0}
nav button.active,nav button:hover{background:#ffffff18;color:white;border-left:4px solid var(--g)}
footer{padding:12px;border-top:1px solid #ffffff22;font-size:12px;overflow-wrap:anywhere}
main{margin-left:230px;padding:22px;max-width:1200px}
.mobile{display:none}
.card{background:white;border:1px solid var(--bd);border-radius:12px;padding:16px;margin-bottom:16px}
h2{font-size:18px;color:var(--n);margin:0 0 12px}
label{display:block;font-weight:bold;font-size:12px;margin:10px 0 4px}
input,select,textarea{width:100%;padding:10px;border:1px solid #cbd5e1;border-radius:7px;font:inherit;margin-bottom:5px}
textarea{min-height:100px;resize:vertical}
button{border:0;border-radius:7px;padding:10px 13px;background:var(--b);color:white;font-weight:bold;cursor:pointer;margin:3px}
button:disabled{opacity:.5}
.secondary{background:#eaf0fa;color:var(--n)}
.danger{background:#b42318}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.item{background:#f8fafc;border:1px solid var(--bd);padding:12px;border-radius:8px;margin:9px 0;overflow-wrap:anywhere}
.item strong{display:block;color:var(--n);margin-bottom:5px}
.small{font-size:12px;color:#64748b;line-height:1.5}
#status{padding:10px;background:#eaf2ff;border-radius:7px;margin-bottom:15px;white-space:pre-wrap}
#status.error{background:#fff0ee;color:#a32118}
#status.ok{background:#e7f8ed;color:#146c37}
.view{display:none}.view.active{display:block}
#login{max-width:400px;margin:50px auto}
.thumb{max-width:100%;max-height:200px;border-radius:8px;margin:8px 0}
hr{border:0;border-top:1px solid var(--bd);margin:16px 0}
.editor{min-height:180px;border:1px solid #cbd5e1;border-radius:7px;padding:12px;background:white;overflow:auto}
.editor img{max-width:100%}
@media(max-width:768px){
 aside{transform:translateX(-100%)}
 aside.open{transform:translateX(0)}
 .mobile{display:flex;position:fixed;inset:0 0 auto;background:var(--n);color:white;padding:10px;align-items:center;justify-content:space-between;z-index:9}
 main{margin:0;padding:65px 12px 15px}
}
@media(max-width:520px){.grid{grid-template-columns:1fr}}
</style>
</head>
<body>

<header class="mobile">
<strong>CreateLK Academy</strong>
<button onclick="$('aside').classList.toggle('open')">☰</button>
</header>

<aside id="aside">
<div class="brand">
<h1>CreateLK</h1>
<p>Academy Admin V2</p>
</div>
<nav>
<button class="active" onclick="tab('dash',this)">📊 Dashboard</button>
<button onclick="tab('subs',this)">📁 Subjects</button>
<button onclick="tab('les',this)">📚 Lessons</button>
<button onclick="tab('content',this)">📝 Lesson Content</button>
</nav>
<footer>
<div id="uEmail"></div>
<button class="danger" style="width:100%" onclick="logout()">Sign Out</button>
</footer>
</aside>

<main>
<section id="login" class="card">
<h2>Admin Sign In</h2>
<p class="small">Sign in using your authorized Google account.</p>
<div id="googleButton" style="display:flex;justify-content:center;margin:15px"></div>
<label><input type="checkbox" id="stay" checked style="width:auto"> Stay logged in</label>
</section>

<div id="app" class="view">
<div id="status">Ready</div>

<section id="t-dash" class="view active">
<div class="card">
<h2>Dashboard</h2>
<div class="grid">
<div class="item"><strong id="sSub">0</strong>Subjects</div>
<div class="item"><strong id="sLes">0</strong>Lessons</div>
</div>
<p class="small">Create subjects first, then add lessons and their content.</p>
</div>
</section>

<section id="t-subs" class="view">
<div class="card">
<h2>1. Add Subject</h2>
<form id="subF">
<label>Subject Name</label>
<input id="subN" required placeholder="Example: Mathematics">
<label>Subject Slug (optional)</label>
<input id="subS" placeholder="mathematics">
<button>Add Subject</button>
</form>
<hr>
<h2>Existing Subjects</h2>
<div id="subL"></div>
</div>
</section>

<section id="t-les" class="view">
<div class="card">
<h2>2. Add Lesson</h2>
<form id="lesF">
<label>Subject</label>
<select id="lSub" required></select>
<label>Lesson Title</label>
<input id="lTitle" required placeholder="Lesson title">
<label>Description</label>
<textarea id="lDesc" placeholder="Short lesson description"></textarea>
<div class="grid">
<div><label>Access</label>
<select id="lFree"><option value="1">Free</option><option value="0">Premium</option></select></div>
<div><label>Status</label>
<select id="lStat">
<option value="PUBLISHED">Published</option>
<option value="DRAFT">Draft</option>
<option value="COMING_SOON">Coming Soon</option>
</select></div>
</div>
<button>Add Lesson</button>
</form>
<hr>
<label>Filter by Subject</label>
<select id="fSub"></select>
<div id="lesL"></div>
</div>
</section>

<section id="t-content" class="view">
<div class="card">
<h2>3. Lesson Content</h2>
<label>Choose Subject</label>
<select id="cSub"><option value="">Select subject</option></select>
<label>Choose Lesson</label>
<select id="cLes" disabled><option value="">Select lesson</option></select>
<button type="button" onclick="loadContent()">Load Lesson</button>
<hr>

<form id="contentF">
<label>Lesson Title</label>
<input id="cTitle" placeholder="Lesson title">
<label>Description</label>
<textarea id="cDesc" placeholder="Lesson description"></textarea>
<button type="button" onclick="saveLesson()">Save Title & Description</button>
<hr>
<h2>Lesson Photo</h2>
<label>Upload Photo (max 10MB)</label>
<input type="file" id="imgFile" accept="image/jpeg,image/png,image/webp,image/gif">
<button type="button" id="imgBtn" onclick="uploadPhoto()">Upload Photo & Copy URL</button>
<div id="photoOut"></div>
<label>Photo URL</label>
<input id="cPhoto" placeholder="Photo URL">
<button type="button" class="secondary" onclick="copyPhoto()">Copy Photo URL</button>
<hr>
<h2>Explanation / Learning Content</h2>
<p class="small">Write formatted content using the editor. Select text to format it.</p>
<div style="display:flex;flex-wrap:wrap;gap:4px;margin-bottom:8px">
<button type="button" onclick="fmt('bold')">Bold</button>
<button type="button" onclick="fmt('italic')">Italic</button>
<button type="button" onclick="fmt('underline')">Underline</button>
<button type="button" onclick="fmt('insertUnorderedList')">Bullet List</button>
<button type="button" onclick="fmt('insertOrderedList')">Numbered List</button>
<button type="button" onclick="insertExplanationPhoto()">Insert Photo URL</button>
</div>
<div id="cExplain" class="editor" contenteditable="true"></div>
<button type="button" onclick="saveExplanation()">Save Explanation</button>
</form>
</div>
</section>
</div>
</main>

<script>
"use strict";

const API="https://update-v2.createlk.workers.dev";
const CLIENT="582157960266-mvlpmqne90d9q7ja5vuhi3g1aspvtp86.apps.googleusercontent.com";
const ADMIN="gateofheavensl1@gmail.com";
const $=id=>document.getElementById(id);
let token="",subs=[],les=[],currentNote="";

function msg(t,type=""){ $("status").textContent=t;$("status").className=type; }
function esc(v){return String(v??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));}

function tab(id,el){
document.querySelectorAll("nav button").forEach(x=>x.classList.remove("active"));
if(el)el.classList.add("active");
document.querySelectorAll("main .view").forEach(x=>x.classList.remove("active"));
$("t-"+id).classList.add("active");
$("aside").classList.remove("open");
}

async function api(path,opts={}){
const h=new Headers(opts.headers||{});
h.set("Authorization","Bearer "+token);
if(opts.body&&!(opts.body instanceof FormData))h.set("Content-Type","application/json");
const r=await fetch(API+path,{...opts,headers:h});
const d=await r.json().catch(()=>({}));
if(!r.ok)throw Error(d.error||"Request failed: "+r.status);
return d;
}

function authOk(jwt,email){
token=jwt;
const store=$("stay").checked?localStorage:sessionStorage;
store.setItem("admin_token",jwt);
store.setItem("admin_email",email);
$("login").style.display="none";
$("app").classList.add("active");
$("uEmail").textContent=email;
loadAll();
}

function handleCred(r){
try{
const p=JSON.parse(atob(r.credential.split(".")[1].replace(/-/g,"+").replace(/_/g,"/")));
if(p.email?.toLowerCase()!==ADMIN||!p.email_verified)throw Error("Unauthorized Google account.");
authOk(r.credential,p.email);
}catch(e){alert(e.message||"Login failed");}
}

function initG(){
if(!window.google?.accounts?.id){setTimeout(initG,300);return;}
google.accounts.id.initialize({client_id:CLIENT,callback:handleCred});
google.accounts.id.renderButton($("googleButton"),{theme:"outline",size:"large",shape:"rectangular"});
}

function logout(){
token="";
localStorage.removeItem("admin_token");
localStorage.removeItem("admin_email");
sessionStorage.removeItem("admin_token");
sessionStorage.removeItem("admin_email");
$("app").classList.remove("active");
$("login").style.display="block";
initG();
}

function restore(){
const t=localStorage.getItem("admin_token")||sessionStorage.getItem("admin_token");
const e=localStorage.getItem("admin_email")||sessionStorage.getItem("admin_email");
if(!t||!e){initG();return;}
try{
const p=JSON.parse(atob(t.split(".")[1].replace(/-/g,"+").replace(/_/g,"/")));
if(p.exp*1000>Date.now()&&p.email?.toLowerCase()===ADMIN)authOk(t,e);
else logout();
}catch{logout();}
}

async function loadAll(){
try{
msg("Loading...");
const d=await api("/api/bootstrap");
subs=d.subjects||[];
les=d.lessons||[];
$("sSub").textContent=subs.length;
$("sLes").textContent=les.length;
renderSubs();renderSubOptions();renderLessons();renderLessonOptions();
msg("Loaded "+subs.length+" subjects and "+les.length+" lessons.","ok");
}catch(e){msg(e.message,"error");}
}

function renderSubs(){
$("subL").innerHTML=subs.map(s=>`
<div class="item">
<strong>${esc(s.name)}</strong>
<div class="small">ID: ${+s.id} · Slug: ${esc(s.slug)}</div>
<button class="secondary" onclick="editSub(${+s.id})">Edit</button>
<button class="secondary" onclick="toggleSub(${+s.id})">${Number(s.is_active)?"Hide":"Show"}</button>
<button class="danger" onclick="delSub(${+s.id})">Delete</button>
</div>`).join("")||'<p class="small">No subjects yet.</p>';
}

function renderSubOptions(){
const opts=subs.map(s=>`<option value="${+s.id}">${esc(s.name)}</option>`).join("");
$("lSub").innerHTML=opts;
$("fSub").innerHTML='<option value="all">All Subjects</option>'+opts;
$("cSub").innerHTML='<option value="">Select subject</option>'+opts;
$("fSub").onchange=renderLessons;
}

function renderLessonOptions(){
const old=$("cLes").value;
const sid=$("cSub").value;
const filtered=les.filter(l=>!sid||String(l.subject_id)===sid);
$("cLes").innerHTML='<option value="">Select lesson</option>'+
filtered.map(l=>`<option value="${+l.id}">${esc(l.title)} (#${+l.id})</option>`).join("");
$("cLes").disabled=!sid;
if([...$("cLes").options].some(o=>o.value===old))$("cLes").value=old;
}

function renderLessons(){
const f=$("fSub").value||"all";
$("lesL").innerHTML=les.filter(l=>f==="all"||String(l.subject_id)===f).map(l=>{
const s=subs.find(x=>+x.id===+l.subject_id);
return `<div class="item">
<strong>${esc(l.title)}</strong>
<div class="small">${esc(s?.name||"")} · ID ${+l.id}</div>
<div class="small">${Number(l.is_free)?"FREE":"PREMIUM"} · ${esc(l.status||"")}</div>
<button onclick="openContent(${+l.subject_id},${+l.id})">Manage Content</button>
<button class="secondary" onclick="editLes(${+l.id})">Edit</button>
<button class="danger" onclick="delLes(${+l.id})">Delete</button>
</div>`;
}).join("")||'<p class="small">No lessons.</p>';
renderLessonOptions();
}

$("cSub").onchange=()=>{
$("cLes").value="";
renderLessonOptions();
$("cTitle").value="";
$("cDesc").value="";
$("cExplain").innerHTML="";
$("cPhoto").value="";
$("photoOut").innerHTML="";
};

$("cLes").onchange=()=>{
if($("cLes").value)loadContent();
};

function openContent(sid,lid){
tab("content",document.querySelectorAll("nav button")[3]);
$("cSub").value=String(sid);
renderLessonOptions();
$("cLes").value=String(lid);
loadContent();
}

$("subF").onsubmit=async e=>{
e.preventDefault();
try{
await api("/api/subjects",{method:"POST",body:JSON.stringify({
name:$("subN").value.trim(),
slug:$("subS").value.trim()
})});
e.target.reset();
await loadAll();
msg("Subject added.","ok");
}catch(x){msg(x.message,"error");}
};

async function editSub(id){
const s=subs.find(x=>+x.id===id);if(!s)return;
const name=prompt("Subject name:",s.name);if(name===null)return;
const slug=prompt("Subject slug:",s.slug);if(slug===null)return;
try{
await api("/api/subjects/"+id,{method:"PUT",body:JSON.stringify({
name,slug,is_active:!!+s.is_active
})});
await loadAll();msg("Subject updated.","ok");
}catch(e){msg(e.message,"error");}
}

async function toggleSub(id){
const s=subs.find(x=>+x.id===id);if(!s)return;
try{
await api("/api/subjects/"+id,{method:"PUT",body:JSON.stringify({
name:s.name,slug:s.slug,is_active:!+s.is_active
})});
await loadAll();msg("Subject updated.","ok");
}catch(e){msg(e.message,"error");}
}

async function delSub(id){
if(!confirm("Delete this subject?"))return;
try{await api("/api/subjects/"+id,{method:"DELETE"});await loadAll();msg("Subject deleted.","ok");}
catch(e){msg(e.message,"error");}
}

$("lesF").onsubmit=async e=>{
e.preventDefault();
try{
await api("/api/lessons",{method:"POST",body:JSON.stringify({
subject_id:+$("lSub").value,
title:$("lTitle").value.trim(),
description:$("lDesc").value,
is_free:$("lFree").value==="1",
status:$("lStat").value
})});
e.target.reset();
await loadAll();
msg("Lesson added.","ok");
}catch(x){msg(x.message,"error");}
};

async function editLes(id){
const l=les.find(x=>+x.id===id);if(!l)return;
const title=prompt("Lesson title:",l.title);if(title===null)return;
const description=prompt("Description:",l.description||"");if(description===null)return;
const subject_id=Number(prompt("Subject ID:",l.subject_id));
if(!subject_id)return;
const order=Number(prompt("Display order:",l.display_order??1));
const is_free=confirm("OK = Free. Cancel = Premium.");
const status=prompt("Status (PUBLISHED, DRAFT, COMING_SOON):",l.status||"PUBLISHED");
if(!status)return;
try{
await api("/api/lessons/"+id,{method:"PUT",body:JSON.stringify({
title,description,subject_id,sort_order:order,display_order:order,is_free,status:status.toUpperCase()
})});
await loadAll();msg("Lesson updated.","ok");
}catch(e){msg(e.message,"error");}
}

async function delLes(id){
if(!confirm("Delete this lesson?"))return;
try{
await api("/api/lessons/"+id,{method:"DELETE"});
await loadAll();msg("Lesson deleted.","ok");
}catch(e){msg(e.message,"error");}
}

async function loadContent(){
const id=$("cLes").value;
if(!id)return msg("Select a lesson.","error");
const l=les.find(x=>+x.id===+id);
if(!l)return msg("Lesson not found.","error");
$("cTitle").value=l.title||"";
$("cDesc").value=l.description||"";
$("cExplain").innerHTML="";
$("cPhoto").value="";
$("photoOut").innerHTML="";
try{
const d=await api("/api/notes/"+id);
currentNote=d.content||"";
$("cExplain").innerHTML=currentNote;
msg("Lesson loaded. Photo URL can be entered below or uploaded.","ok");
}catch(e){
currentNote="";
msg("Lesson details loaded. Explanation may not exist yet: "+e.message);
}
}

async function saveLesson(){
const id=$("cLes").value;
if(!id)return msg("Select a lesson.","error");
const l=les.find(x=>+x.id===+id);
if(!l)return msg("Lesson not found.","error");
try{
await api("/api/lessons/"+id,{method:"PUT",body:JSON.stringify({
title:$("cTitle").value.trim(),
description:$("cDesc").value,
subject_id:+$("cSub").value,
sort_order:Number(l.display_order??1),
display_order:Number(l.display_order??1),
is_free:!!Number(l.is_free),
status:l.status||"PUBLISHED"
})});
await loadAll();
msg("Title and description saved.","ok");
}catch(e){msg(e.message,"error");}
}

function fmt(command){
$("cExplain").focus();
document.execCommand(command,false,null);
}

function insertExplanationPhoto(){
const url=$("cPhoto").value.trim();
if(!url)return msg("Enter or upload a photo URL first.","error");
if(!/^https:\/\/\S+$/i.test(url))return msg("Enter a valid HTTPS photo URL.","error");
$("cExplain").focus();
document.execCommand("insertHTML",false,
'<p><img src="'+esc(url)+'" alt="Lesson photo" style="max-width:100%;height:auto"></p>');
}

async function saveExplanation(){
const id=$("cLes").value;
if(!id)return msg("Select a lesson.","error");
try{
await api("/api/notes/"+id,{method:"PUT",body:JSON.stringify({
content:$("cExplain").innerHTML
})});
msg("Explanation saved.","ok");
}catch(e){msg(e.message,"error");}
}

async function uploadPhoto(){
const lesson_id=$("cLes").value;
const file=$("imgFile").files[0];
if(!lesson_id)return msg("Select a lesson first.","error");
if(!file)return msg("Choose a photo.","error");
if(file.size>10*1024*1024)return msg("Photo must be 10MB or smaller.","error");
if(!["image/jpeg","image/png","image/webp","image/gif"].includes(file.type))
return msg("Use JPG, PNG, WEBP or GIF.","error");

$("imgBtn").disabled=true;
try{
const fd=new FormData();
fd.append("lesson_id",lesson_id);
fd.append("file",file);
const d=await api("/api/lesson-images",{method:"POST",body:fd});
if(!d.url)throw Error("Upload succeeded but API returned no URL.");
$("cPhoto").value=d.url;
$("photoOut").innerHTML='<img class="thumb" src="'+esc(d.url)+'" alt="Uploaded lesson photo"><p class="small">Photo uploaded.</p>';
try{
await navigator.clipboard.writeText(d.url);
msg("Photo uploaded. URL copied.","ok");
}catch{
msg("Photo uploaded. Copy the URL from the field.","ok");
}
$("imgFile").value="";
}catch(e){msg(e.message,"error");}
finally{$("imgBtn").disabled=false;}
}

async function copyPhoto(){
const url=$("cPhoto").value.trim();
if(!url)return msg("No photo URL.","error");
try{await navigator.clipboard.writeText(url);msg("Photo URL copied.","ok");}
catch{ $("cPhoto").select();msg("Select and copy the photo URL.");}
}

$("cPhoto").addEventListener("change",()=>{
const url=$("cPhoto").value.trim();
$("photoOut").innerHTML=/^https:\/\/\S+$/i.test(url)
?'<img class="thumb" src="'+esc(url)+'" alt="Lesson photo">':"";
});

restore();
</script>
</body>
</html>