/* USERS */

async function users(request,env){

 if(!await adminOK(request,env))
  return json({
   success:false,
   error:"Admin login required"
  },401,request);

 const url=new URL(request.url);

 const search=
  (url.searchParams.get("search")||"").trim();

 const membership=
  (url.searchParams.get("membership")||"").trim();

 let sql=`
  SELECT
   id,
   email,
   name,
   avatar_url,
   membership,
   membership_expiry,
   xp,
   coins,
   correct_answers,
   questions_answered,
   lessons_completed,
   affiliate_code,
   referred_by,
   created_at,
   updated_at
  FROM users
  WHERE 1=1
 `;

 const args=[];

 if(search){

  sql+=`
   AND(
    email LIKE ?
    OR name LIKE ?
    OR id LIKE ?
   )
  `;

  const x="%"+search+"%";

  args.push(x,x,x);
 }

 if(
  membership==="free"||
  membership==="premium"
 ){

  sql+=" AND membership=?";
  args.push(membership);
 }

 sql+=`
  ORDER BY created_at DESC
  LIMIT 200
 `;

 const result=
  await env.DB.prepare(sql)
   .bind(...args)
   .all();

 return json({
  success:true,
  users:result.results||[]
 },200,request);
}


/* ACTIVATE PREMIUM */

async function activatePremium(request,env){

 if(!await adminOK(request,env))
  return json({
   success:false,
   error:"Admin login required"
  },401,request);

 const body=
  await request.json().catch(()=>({}));

 const id=
  String(body.user_id||"").trim();

 const days=
  Math.max(
   1,
   Math.min(
    3650,
    Number(body.days)||30
   )
  );

 const amount=
  Math.max(
   0,
   Number(body.amount)||DEFAULT_AMOUNT
  );

 if(!id)
  return json({
   success:false,
   error:"User ID required"
  },400,request);

 const user=
  await env.DB.prepare(`
   SELECT
    id,
    name,
    email,
    referred_by
   FROM users
   WHERE id=?
   LIMIT 1
  `).bind(id).first();

 if(!user)
  return json({
   success:false,
   error:"User not found"
  },404,request);

 const expiry=
  new Date(
   Date.now()+days*86400000
  ).toISOString();

 await env.DB.prepare(`
  UPDATE users
  SET
   membership='premium',
   membership_expiry=?,
   updated_at=CURRENT_TIMESTAMP
  WHERE id=?
 `).bind(expiry,id).run();

 let commission=0;
 let affiliate=null;

 if(user.referred_by){

  affiliate=
   await env.DB.prepare(`
    SELECT
     id,
     name,
     email
    FROM users
    WHERE affiliate_code=?
    LIMIT 1
   `).bind(
    user.referred_by
   ).first();

  if(affiliate){

   const existing=
    await env.DB.prepare(`
     SELECT id
     FROM affiliate_referrals
     WHERE affiliate_code=?
     AND student_id=?
     AND status='APPROVED'
     LIMIT 1
    `).bind(
     user.referred_by,
     String(id)
    ).first();

   if(!existing){

    commission=
     Math.round(
      amount*COMMISSION_RATE
     );

    await env.DB.prepare(`
     INSERT INTO affiliate_referrals(
      affiliate_code,
      student_id,
      status,
      sale_amount,
      commission,
      created_at,
      approved_at
     )
     VALUES(?,?,?,?,?,?,?)
    `).bind(
     user.referred_by,
     String(id),
     "APPROVED",
     amount,
     commission,
     now(),
     now()
    ).run();
   }
  }
 }

 return json({
  success:true,
  message:"Premium activated",
  user_id:id,
  membership:"premium",
  membership_expiry:expiry,
  days,
  sale_amount:amount,
  commission_rate:20,
  affiliate_code:user.referred_by||null,
  affiliate_commission:commission,
  affiliate_name:affiliate?.name||null
 },200,request);
}


