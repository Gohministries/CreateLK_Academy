/* ADD PREMIUM DAYS + REPEAT AFFILIATE COMMISSION */

async function setExpiry(request,env){

 if(!await adminOK(request,env))
  return json({
   success:false,
   error:"Admin login required"
  },401,request);

 const body=
  await request.json().catch(()=>({}));

 const id=
  String(body.user_id||"").trim();

 if(!id)
  return json({
   success:false,
   error:"User ID required"
  },400,request);

 const days=
  Math.max(
   1,
   Math.min(
    3650,
    Number(body.days)||30
   )
  );

 const amount=
  Math.max(
   0,
   Number(body.amount)||DEFAULT_AMOUNT
  );

 const user=
  await env.DB.prepare(`
   SELECT
    id,
    name,
    email,
    referred_by,
    membership_expiry
   FROM users
   WHERE id=?
   LIMIT 1
  `).bind(id).first();

 if(!user)
  return json({
   success:false,
   error:"User not found"
  },404,request);

 let expiry;

/* EXPLICIT EXPIRY */

 if(body.membership_expiry){

  expiry=
   new Date(
    String(body.membership_expiry)
   );

  if(Number.isNaN(expiry.getTime()))
   return json({
    success:false,
    error:"Invalid expiry date"
   },400,request);

 }else{

  expiry=
   new Date(
    user.membership_expiry
   );

  if(
   Number.isNaN(expiry.getTime())||
   expiry.getTime()<Date.now()
  )
   expiry=new Date();

  expiry=
   new Date(
    expiry.getTime()+
    days*86400000
   );
 }


/* UPDATE PREMIUM */

 await env.DB.prepare(`
  UPDATE users
  SET
   membership='premium',
   membership_expiry=?,
   updated_at=CURRENT_TIMESTAMP
  WHERE id=?
 `).bind(
  expiry.toISOString(),
  id
 ).run();


/* REPEAT AFFILIATE COMMISSION */

 let commission=0;
 let affiliate=null;

 if(user.referred_by){

  affiliate=
   await env.DB.prepare(`
    SELECT
     id,
     name,
     email
    FROM users
    WHERE LOWER(affiliate_code)=LOWER(?)
    LIMIT 1
   `).bind(
    String(user.referred_by).trim()
   ).first();

  if(affiliate){

   commission=
    Math.round(
     amount*COMMISSION_RATE
    );

   await env.DB.prepare(`
    INSERT INTO affiliate_referrals(
     affiliate_code,
     student_id,
     status,
     sale_amount,
     commission,
     created_at,
     approved_at
    )
    VALUES(?,?,?,?,?,?,?)
   `).bind(
    user.referred_by,
    String(id),
    "APPROVED",
    amount,
    commission,
    now(),
    now()
   ).run();
  }
 }


 return json({
  success:true,
  message:"Premium expiry updated",
  user_id:id,
  membership:"premium",
  membership_expiry:
   expiry.toISOString(),
  days,
  sale_amount:amount,
  commission_rate:20,
  affiliate_code:
   user.referred_by||null,
  affiliate_commission:
   commission,
  affiliate_name:
   affiliate?.name||null
 },200,request);
}


/* ADMIN: WITHDRAWAL LIST */

async function withdrawals(request,env){

 if(!await adminOK(request,env))
  return json({
   success:false,
   error:"Admin login required"
  },401,request);

 const r=
  await env.DB.prepare(`
   SELECT
    w.id,
    w.user_id,
    w.amount,
    w.account_name,
    w.bank,
    w.branch,
    w.account_number,
    w.status,
    w.created_at,
    w.updated_at,
    u.name,
    u.email,
    u.affiliate_code
   FROM withdrawal_requests w
   LEFT JOIN users u
    ON u.id=w.user_id
   ORDER BY
    CASE w.status
     WHEN 'PENDING' THEN 1
     WHEN 'PROCESSING' THEN 2
     WHEN 'PAID' THEN 3
     WHEN 'REJECTED' THEN 4
     ELSE 5
    END,
    w.id DESC
   LIMIT 200
  `)
  .all();

 return json({
  success:true,
  requests:r.results||[]
 },200,request);
}


/* ADMIN: UPDATE WITHDRAWAL */

async function updateWithdrawal(request,env){

 if(!await adminOK(request,env))
  return json({
   success:false,
   error:"Admin login required"
  },401,request);

 const url=
  new URL(request.url);

 const id=
  url.pathname.split("/").pop();

 const body=
  await request.json().catch(()=>({}));

 const status=
  String(body.status||"")
   .trim()
   .toUpperCase();

 const allowed=[
  "PENDING",
  "PROCESSING",
  "PAID",
  "REJECTED"
 ];

 if(!id||!allowed.includes(status))
  return json({
   success:false,
   error:"Invalid withdrawal status"
  },400,request);

 const row=
  await env.DB.prepare(`
   SELECT id
   FROM withdrawal_requests
   WHERE id=?
   LIMIT 1
  `).bind(id).first();

 if(!row)
  return json({
   success:false,
   error:"Withdrawal request not found"
  },404,request);

 await env.DB.prepare(`
  UPDATE withdrawal_requests
  SET
   status=?,
   updated_at=CURRENT_TIMESTAMP
  WHERE id=?
 `).bind(
  status,
  id
 ).run();

 return json({
  success:true,
  message:"Withdrawal updated",
  id:Number(id),
  status
 },200,request);
}


/* ROUTES */

export default{

 async fetch(request,env){

  const url=
   new URL(request.url);

  if(request.method==="OPTIONS")
   return new Response(
    null,
    {
     status:204,
     headers:cors(request)
    }
   );

  try{

   await setup(env);

   if(url.pathname==="/")
    return new Response(
     "CreateLK English Admin Worker is running ✅"
    );


   if(url.pathname==="/auth/google")
    return googleLogin(request,env);


   if(url.pathname==="/auth/google/callback")
    return googleCallback(request,env);


   if(
    url.pathname==="/api/admin/login"&&
    request.method==="POST"
   )
    return passwordLogin(request,env);


   if(
    url.pathname==="/api/admin/logout"
   )
    return logout(request,env);


   if(
    url.pathname==="/api/admin/status"
   )
    return status(request,env);


   if(
    url.pathname==="/api/admin/users"&&
    request.method==="GET"
   )
    return users(request,env);


   if(
    url.pathname==="/api/admin/premium"&&
    request.method==="POST"
   )
    return activatePremium(request,env);


   if(
    url.pathname==="/api/admin/premium/remove"&&
    request.method==="POST"
   )
    return removePremium(request,env);


   if(
    url.pathname==="/api/admin/premium/expiry"&&
    request.method==="POST"
   )
    return setExpiry(request,env);


   /* WITHDRAWAL ADMIN ROUTES */

   if(
    url.pathname==="/api/admin/withdrawals"&&
    request.method==="GET"
   )
    return withdrawals(request,env);


   if(
    url.pathname.startsWith(
     "/api/admin/withdrawals/"
    )&&
    request.method==="POST"
   )
    return updateWithdrawal(request,env);


   return json({
    success:false,
    error:"Not found"
   },404,request);

  }catch(e){

   return json({
    success:false,
    error:e.message||"Server error"
   },500,request);

  }
 }
};