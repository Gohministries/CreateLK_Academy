const COOKIE="english_admin_session";
const OAUTH_COOKIE="english_admin_oauth";
const DAYS=7;
const COMMISSION_RATE=.20;
const DEFAULT_AMOUNT=1000;

const cors=r=>({
 "Access-Control-Allow-Origin":r.headers.get("Origin")||"*",
 "Access-Control-Allow-Credentials":"true",
 "Access-Control-Allow-Methods":"GET,POST,OPTIONS",
 "Access-Control-Allow-Headers":"Content-Type",
 "Vary":"Origin"
});

const json=(d,s=200,r)=>new Response(JSON.stringify(d),{
 status:s,
 headers:{
  "Content-Type":"application/json;charset=UTF-8",
  "Cache-Control":"no-store",
  ...cors(r)
 }
});

const cookie=(r,n)=>{
 const m=(r.headers.get("Cookie")||"")
  .match(new RegExp("(?:^|;\\s*)"+n+"=([^;]*)"));
 return m?decodeURIComponent(m[1]):null;
};

const rnd=(n=32)=>{
 const b=new Uint8Array(n);
 crypto.getRandomValues(b);
 return [...b].map(x=>x.toString(16).padStart(2,"0")).join("");
};

const now=()=>new Date().toISOString();


async function setup(env){

 await env.DB.prepare(`
  CREATE TABLE IF NOT EXISTS admin_sessions(
   token TEXT PRIMARY KEY,
   admin_email TEXT NOT NULL,
   expires_at TEXT NOT NULL,
   created_at TEXT DEFAULT CURRENT_TIMESTAMP
  )
 `).run();

 try{
  const r=await env.DB.prepare(
   "PRAGMA table_info(users)"
  ).all();

  if(!(r.results||[]).some(
   x=>x.name==="membership_expiry"
  )){
   await env.DB.prepare(
    "ALTER TABLE users ADD COLUMN membership_expiry TEXT"
   ).run();
  }

 }catch{}

 try{
  await env.DB.prepare(`
   CREATE TABLE IF NOT EXISTS affiliate_referrals(
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    affiliate_code TEXT NOT NULL,
    student_id TEXT NOT NULL,
    status TEXT DEFAULT 'PENDING',
    sale_amount INTEGER DEFAULT 0,
    commission INTEGER DEFAULT 0,
    created_at TEXT NOT NULL,
    approved_at TEXT
   )
  `).run();

 }catch{}

 await env.DB.prepare(`
  CREATE TABLE IF NOT EXISTS withdrawal_requests(
   id INTEGER PRIMARY KEY AUTOINCREMENT,
   user_id TEXT NOT NULL,
   amount INTEGER NOT NULL,
   account_name TEXT NOT NULL,
   bank TEXT NOT NULL,
   branch TEXT NOT NULL,
   account_number TEXT NOT NULL,
   status TEXT NOT NULL DEFAULT 'PENDING',
   created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
   updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
  )
 `).run();
}


async function adminOK(request,env){

 const token=cookie(request,COOKIE);

 if(!token)return false;

 const row=await env.DB.prepare(`
  SELECT token
  FROM admin_sessions
  WHERE token=? AND expires_at>?
  LIMIT 1
 `).bind(token,now()).first();

 return !!row;
}


/* GOOGLE LOGIN */

async function googleLogin(request,env){

 if(!env.GOOGLE_CLIENT_ID)
  return new Response(
   "GOOGLE_CLIENT_ID is not configured",
   {status:500}
  );

 const state=rnd();

 const redirect=
  `${new URL(request.url).origin}/auth/google/callback`;

 const g=
  new URL(
   "https://accounts.google.com/o/oauth2/v2/auth"
  );

 g.searchParams.set(
  "client_id",
  env.GOOGLE_CLIENT_ID
 );

 g.searchParams.set(
  "redirect_uri",
  redirect
 );

 g.searchParams.set(
  "response_type",
  "code"
 );

 g.searchParams.set(
  "scope",
  "openid email profile"
 );

 g.searchParams.set(
  "access_type",
  "online"
 );

 g.searchParams.set(
  "prompt",
  "select_account"
 );

 g.searchParams.set(
  "state",
  state
 );

 const res=new Response(null,{
  status:302,
  headers:{
   Location:g.toString()
  }
 });

 res.headers.append(
  "Set-Cookie",
  `${OAUTH_COOKIE}=${encodeURIComponent(state)}; Path=/auth/google; Max-Age=600; HttpOnly; Secure; SameSite=Lax`
 );

 return res;
}


/* GOOGLE CALLBACK */

async function googleCallback(request,env){

 const url=new URL(request.url);

 const code=url.searchParams.get("code");
 const state=url.searchParams.get("state")||"";
 const saved=cookie(request,OAUTH_COOKIE);

 if(!code||!saved||state!==saved)
  return new Response(
   "Invalid Google login",
   {status:400}
  );

 const redirect=
  `${url.origin}/auth/google/callback`;

 const tokenResponse=await fetch(
  "https://oauth2.googleapis.com/token",
  {
   method:"POST",
   headers:{
    "Content-Type":
     "application/x-www-form-urlencoded"
   },
   body:new URLSearchParams({
    client_id:env.GOOGLE_CLIENT_ID,
    client_secret:env.GOOGLE_CLIENT_SECRET,
    code,
    grant_type:"authorization_code",
    redirect_uri:redirect
   })
  }
 );

 if(!tokenResponse.ok)
  return new Response(
   "Google token exchange failed",
   {status:400}
  );

 const token=await tokenResponse.json();

 if(!token.access_token)
  return new Response(
   "Google access token missing",
   {status:400}
  );

 const userResponse=await fetch(
  "https://www.googleapis.com/oauth2/v3/userinfo",
  {
   headers:{
    Authorization:
     `Bearer ${token.access_token}`
   }
  }
 );

 if(!userResponse.ok)
  return new Response(
   "Unable to read Google account",
   {status:400}
  );

 const google=await userResponse.json();

 const email=
  String(google.email||"")
   .trim()
   .toLowerCase();

 const allowed=
  String(env.ADMIN_EMAIL||"")
   .trim()
   .toLowerCase();

 if(!email||!allowed||email!==allowed)
  return new Response(
   "Access denied. This Google account is not an administrator.",
   {status:403}
  );

 const session=rnd();

 const expires=
  new Date(
   Date.now()+DAYS*86400000
  ).toISOString();

 await env.DB.prepare(`
  INSERT INTO admin_sessions(
   token,admin_email,expires_at
  )
  VALUES(?,?,?)
 `).bind(
  session,
  email,
  expires
 ).run();

 const res=new Response(null,{
  status:302,
  headers:{
   Location:"https://createlk.com/v2/admin.html"
  }
 });

 res.headers.append(
  "Set-Cookie",
  `${COOKIE}=${session}; Path=/; Max-Age=${DAYS*86400}; HttpOnly; Secure; SameSite=None`
 );

 res.headers.append(
  "Set-Cookie",
  `${OAUTH_COOKIE}=; Path=/auth/google; Max-Age=0; HttpOnly; Secure; SameSite=Lax`
 );

 return res;
}


/* PASSWORD LOGIN */

async function passwordLogin(request,env){

 if(!env.ADMIN_PASSWORD)
  return json({
   success:false,
   error:"Password login is not configured"
  },500,request);

 const body=
  await request.json().catch(()=>({}));

 if(
  String(body.password||"")!==env.ADMIN_PASSWORD
 )
  return json({
   success:false,
   error:"Invalid admin password"
  },401,request);

 const email=
  String(env.ADMIN_EMAIL||"admin")
   .toLowerCase();

 const token=rnd();

 const expires=
  new Date(
   Date.now()+DAYS*86400000
  ).toISOString();

 await env.DB.prepare(`
  INSERT INTO admin_sessions(
   token,admin_email,expires_at
  )
  VALUES(?,?,?)
 `).bind(
  token,
  email,
  expires
 ).run();

 const res=json(
  {success:true},
  200,
  request
 );

 res.headers.append(
  "Set-Cookie",
  `${COOKIE}=${token}; Path=/; Max-Age=${DAYS*86400}; HttpOnly; Secure; SameSite=None`
 );

 return res;
}


/* LOGOUT */

async function logout(request,env){

 const token=cookie(request,COOKIE);

 if(token)
  await env.DB.prepare(
   "DELETE FROM admin_sessions WHERE token=?"
  ).bind(token).run();

 const res=json(
  {success:true},
  200,
  request
 );

 res.headers.append(
  "Set-Cookie",
  `${COOKIE}=; Path=/; Max-Age=0; HttpOnly; Secure; SameSite=None`
 );

 return res;
}


