  "582157960266-mvlpmqne90d9q7ja5vuhi3g1aspvtp86.apps.googleusercontent.com";

const MAX_IMAGE_SIZE = 10 * 1024 * 1024;
const IMAGE_TYPES = new Set([
  "image/jpeg", "image/png", "image/webp", "image/gif"
]);

const ALLOWED_ORIGINS = new Set([
  "https://createlk.com",
  "https://www.createlk.com"
]);

const cors = origin => ({
  "Access-Control-Allow-Origin":
    ALLOWED_ORIGINS.has(origin) ? origin : "https://createlk.com",
  "Access-Control-Allow-Methods": "GET,POST,PUT,DELETE,OPTIONS",
  "Access-Control-Allow-Headers": "Content-Type,Authorization",
  "Access-Control-Max-Age": "86400",
  "Vary": "Origin"
});

const json = (data, status = 200, origin = "") =>
  new Response(JSON.stringify(data), {
    status,
    headers: {
      ...cors(origin),
      "Content-Type": "application/json; charset=utf-8",
      "Cache-Control": "no-store"
    }
  });

const fail = (message, status = 400) =>
  Object.assign(new Error(message), { status });

const slugify = value =>
  String(value || "")
    .trim().toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "") || "item";

const escapeHtml = value =>
  String(value).replace(/[&<>"']/g, c => ({
    "&": "&amp;", "<": "&lt;", ">": "&gt;",
    '"': "&quot;", "'": "&#39;"
  })[c]);

async function ensureTables(db) {
  await db.prepare(`
    CREATE TABLE IF NOT EXISTS lesson_details (
      lesson_id INTEGER PRIMARY KEY,
      language TEXT DEFAULT '',
      introduction TEXT DEFAULT '',
      explanation TEXT DEFAULT '',
      updated_at TEXT DEFAULT CURRENT_TIMESTAMP
    )
  `).run();
}

async function authenticate(request) {
  const header = request.headers.get("Authorization") || "";
  const token = header.replace(/^Bearer\s+/i, "").trim();

  if (!token) throw fail("Google login required.", 401);

  const response = await fetch(
    "https://oauth2.googleapis.com/tokeninfo?id_token=" +
    encodeURIComponent(token)
  );

  if (!response.ok) throw fail("Google login expired. Sign in again.", 401);

  const user = await response.json();

  if (
    user.aud !== GOOGLE_CLIENT_ID ||
    user.email_verified !== "true" ||
    String(user.email || "").toLowerCase() !== ADMIN_EMAIL.toLowerCase() ||
    Number(user.exp) <= Math.floor(Date.now() / 1000)
  ) {
    throw fail("Admin access denied.", 403);
  }

  return user;
}

async function getLesson(db, id) {
  return db.prepare(`
    SELECT l.id, l.title, l.description, l.sort_order,
           l.is_free, l.status,
           m.subject_id, m.course_id, m.display_order,
           d.language, d.introduction, d.explanation
    FROM lessons l
    LEFT JOIN subject_lesson_map m ON m.lesson_id = l.id
    LEFT JOIN lesson_details d ON d.lesson_id = l.id
    WHERE l.id = ?
  `).bind(id).first();
}

async function saveDetails(db, id, data) {
  const old = await db.prepare(
    "SELECT * FROM lesson_details WHERE lesson_id = ?"
  ).bind(id).first() || {};

  const language = data.language ?? old.language ?? "";
  const introduction = data.introduction ?? old.introduction ?? "";
  const explanation = data.explanation ?? old.explanation ?? "";

  await db.prepare(`
    INSERT INTO lesson_details
      (lesson_id, language, introduction, explanation, updated_at)
    VALUES (?, ?, ?, ?, CURRENT_TIMESTAMP)
    ON CONFLICT(lesson_id) DO UPDATE SET
      language = excluded.language,
      introduction = excluded.introduction,
      explanation = excluded.explanation,
      updated_at = CURRENT_TIMESTAMP
  `).bind(id, language, introduction, explanation).run();
}

async function saveNotes(db, id, content) {
  await db.prepare(`
    INSERT INTO lesson_notes (lesson_id, content, updated_at)
    VALUES (?, ?, CURRENT_TIMESTAMP)
    ON CONFLICT(lesson_id) DO UPDATE SET
      content = excluded.content,
      updated_at = CURRENT_TIMESTAMP
  `).bind(id, content).run();
}

async function handle(request, env) {
  if (!env.DB || !env.FILES) {
    throw fail("Configure D1 binding DB and R2 binding FILES.", 500);
  }

  const url = new URL(request.url);
  const path = url.pathname.replace(/\/+$/, "") || "/";
  const method = request.method;
  const origin = request.headers.get("Origin") || "";

  if (method === "OPTIONS") {
    return new Response(null, { status: 204, headers: cors(origin) });
  }

  // Public images: no Google login required.
  if (method === "GET" && path.startsWith("/images/")) {
    const key = decodeURIComponent(path.slice("/images/".length));
    if (!key || key.includes("..")) throw fail("Invalid image path.", 400);

    const object = await env.FILES.get(key);
    if (!object) throw fail("Image not found.", 404);

    return new Response(object.body, {
      headers: {
        ...cors(origin),
        "Content-Type": object.httpMetadata?.contentType || "application/octet-stream",
        "Cache-Control": "public, max-age=31536000, immutable",
        "ETag": object.httpEtag
      }
    });
  }

  await authenticate(request);
  await ensureTables(env.DB);

  const db = env.DB;

  if (method === "GET" && path === "/api/bootstrap") {
    const [subjects, lessons, courses] = await Promise.all([
      db.prepare(`
        SELECT * FROM subjects ORDER BY display_order, id
      `).all(),

      db.prepare(`
        SELECT l.id, l.title, l.description, l.sort_order,
               l.is_free, l.status,
               m.subject_id, m.course_id, m.display_order,
               d.language, d.introduction, d.explanation
        FROM lessons l
        LEFT JOIN subject_lesson_map m ON m.lesson_id = l.id
        LEFT JOIN lesson_details d ON d.lesson_id = l.id
        ORDER BY COALESCE(m.subject_id, 999999),
                 COALESCE(m.display_order, l.sort_order), l.id
      `).all(),

      db.prepare(`
        SELECT * FROM subject_courses ORDER BY subject_id, display_order, id
      `).all()
    ]);

    return json({
      subjects: subjects.results,
      lessons: lessons.results,
      courses: courses.results
    }, 200, origin);
  }

  if (method === "POST" && path === "/api/subjects") {
    const data = await request.json();
    const name = String(data.name || "").trim();
    if (!name) throw fail("Subject name is required.");

    const slug = slugify(data.slug || name);
    const result = await db.prepare(`
      INSERT INTO subjects (name, slug, description, icon, display_order)
      VALUES (?, ?, ?, ?, ?)
    `).bind(
      name, slug, data.description || "", data.icon || "📚",
      Number(data.display_order) || 0
    ).run();

    return json({ ok: true, id: result.meta.last_row_id }, 201, origin);
  }

  if (method === "POST" && path === "/api/lessons") {
    const data = await request.json();
    const title = String(data.title || "").trim();
    const subjectId = Number(data.subject_id);

    if (!title) throw fail("Lesson title is required.");
    if (!Number.isInteger(subjectId) || subjectId < 1) {
      throw fail("Select a subject.");
    }

    const subject = await db.prepare(
      "SELECT id FROM subjects WHERE id = ?"
    ).bind(subjectId).first();

    if (!subject) throw fail("Subject not found.", 404);

    const max = await db.prepare(`
      SELECT COALESCE(MAX(id), 0) + 1 AS next_id FROM lessons
    `).first();

    const sort = await db.prepare(`
      SELECT COALESCE(MAX(sort_order), 0) + 1 AS next_order
      FROM lessons
    `).first();

    const id = Number(max.next_id);
    const order = Number(data.sort_order || sort.next_order);
    const status = ["PUBLISHED", "DRAFT", "COMING_SOON"]
      .includes(String(data.status || "").toUpperCase())
      ? String(data.status || "").toUpperCase() : "DRAFT";

    await db.prepare(`
      INSERT INTO lessons
        (id, title, description, sort_order, is_free, status)
      VALUES (?, ?, ?, ?, ?, ?)
    `).bind(
      id, title, data.description || "", order,
      data.is_free === false || Number(data.is_free) === 0 ? 0 : 1,
      status
    ).run();

    await db.prepare(`
      INSERT INTO subject_lesson_map
        (lesson_id, subject_id, course_id, display_order)
      VALUES (?, ?, ?, ?)
    `).bind(
      id, subjectId,
      data.course_id ? Number(data.course_id) : null,
      Number(data.display_order) || order
    ).run();

    await saveNotes(db, id, data.content || "");
    await saveDetails(db, id, data);

    return json({ ok: true, id }, 201, origin);
  }

  const lessonMatch = path.match(/^\/api\/lessons\/(\d+)$/);

  if (lessonMatch && method === "PUT") {
    const id = Number(lessonMatch[1]);
    if (!(await db.prepare("SELECT id FROM lessons WHERE id = ?")
      .bind(id).first())) throw fail("Lesson not found.", 404);

    const data = await request.json();
    const old = await db.prepare(
      "SELECT * FROM lessons WHERE id = ?"
    ).bind(id).first();

    const title = data.title === undefined ? old.title : String(data.title).trim();
    const description = data.description ?? old.description ?? "";
    const sortOrder = data.sort_order === undefined
      ? old.sort_order : Number(data.sort_order);

    const isFree = data.is_free === undefined
      ? old.is_free
      : (data.is_free === true || Number(data.is_free) === 1 ? 1 : 0);

    const status = data.status === undefined
      ? old.status
      : String(data.status).toUpperCase();

    if (!title) throw fail("Lesson title is required.");
    if (!["PUBLISHED", "DRAFT", "COMING_SOON"].includes(status)) {
      throw fail("Invalid publishing status.");
    }

    await db.prepare(`
      UPDATE lessons
      SET title = ?, description = ?, sort_order = ?,
          is_free = ?, status = ?
      WHERE id = ?
    `).bind(title, description, sortOrder, isFree, status, id).run();

    if (data.subject_id !== undefined) {
      const subjectId = Number(data.subject_id);
      if (!(await db.prepare("SELECT id FROM subjects WHERE id = ?")
        .bind(subjectId).first())) throw fail("Subject not found.", 404);

      await db.prepare(`
        INSERT INTO subject_lesson_map
          (lesson_id, subject_id, course_id, display_order)
        VALUES (?, ?, ?, ?)
        ON CONFLICT(lesson_id) DO UPDATE SET
          subject_id = excluded.subject_id,
          course_id = excluded.course_id,
          display_order = excluded.display_order
      `).bind(
        id, subjectId,
        data.course_id ? Number(data.course_id) : null,
        Number(data.display_order) || sortOrder
      ).run();
    } else if (data.display_order !== undefined ||
               data.course_id !== undefined) {
      await db.prepare(`
        UPDATE subject_lesson_map
        SET display_order = COALESCE(?, display_order),
            course_id = CASE WHEN ? = 1 THEN ? ELSE course_id END
        WHERE lesson_id = ?
      `).bind(
        data.display_order === undefined ? null : Number(data.display_order),
        data.course_id === undefined ? 0 : 1,
        data.course_id ? Number(data.course_id) : null,
        id
      ).run();
    }

    if (data.content !== undefined) {
      await saveNotes(db, id, data.content);
    }

    if (
      data.language !== undefined ||
      data.introduction !== undefined ||
      data.explanation !== undefined
    ) {
      await saveDetails(db, id, data);
    }

    return json({ ok: true, lesson: await getLesson(db, id) }, 200, origin);
  }

  if (lessonMatch && method === "DELETE") {
    const id = Number(lessonMatch[1]);

    await db.prepare("DELETE FROM lesson_subtitles WHERE lesson_id = ?")
      .bind(id).run();
    await db.prepare("DELETE FROM lesson_notes WHERE lesson_id = ?")
      .bind(id).run();
    await db.prepare("DELETE FROM lesson_details WHERE lesson_id = ?")
      .bind(id).run();
    await db.prepare("DELETE FROM subject_lesson_map WHERE lesson_id = ?")
      .bind(id).run();
    await db.prepare("DELETE FROM lessons WHERE id = ?").bind(id).run();

    return json({ ok: true }, 200, origin);
  }

  const notesMatch = path.match(/^\/api\/notes\/(\d+)$/);

  if (notesMatch && method === "GET") {
    const id = Number(notesMatch[1]);
    const [note, details] = await Promise.all([
      db.prepare("SELECT content FROM lesson_notes WHERE lesson_id = ?")
        .bind(id).first(),
      db.prepare("SELECT language, introduction, explanation FROM lesson_details WHERE lesson_id = ?")
        .bind(id).first()
    ]);

    return json({
      lesson_id: id,
      content: note?.content || "",
      language: details?.language || "",
      introduction: details?.introduction || "",
      explanation: details?.explanation || ""
    }, 200, origin);
  }

  if (notesMatch && method === "PUT") {
    const id = Number(notesMatch[1]);
    if (!(await db.prepare("SELECT id FROM lessons WHERE id = ?")
      .bind(id).first())) throw fail("Lesson not found.", 404);

    const data = await request.json();

    if (data.content !== undefined) {
      await saveNotes(db, id, String(data.content));
    }

    if (
      data.language !== undefined ||
      data.introduction !== undefined ||
      data.explanation !== undefined
    ) {
      await saveDetails(db, id, data);
    }

    return json({ ok: true }, 200, origin);
  }

  // Upload photo to R2 and automatically add it to the lesson content.
  if (method === "POST" && path === "/api/lesson-images") {
    const form = await request.formData();
    const id = Number(form.get("lesson_id"));
    const file = form.get("file");

    if (!Number.isInteger(id) || id < 1) throw fail("Select a lesson.");
    if (!(file instanceof File)) throw fail("Choose a photo.");
    if (file.size < 1 || file.size > MAX_IMAGE_SIZE) {
      throw fail("Photo must be 10 MB or smaller.");
    }
    if (!IMAGE_TYPES.has(file.type)) throw fail("Unsupported photo type.");

    if (!(await db.prepare("SELECT id FROM lessons WHERE id = ?")
      .bind(id).first())) throw fail("Lesson not found.", 404);

    const ext = ({
      "image/jpeg": "jpg",
      "image/png": "png",
      "image/webp": "webp",
      "image/gif": "gif"
    })[file.type];

    const key = `lesson-images/lesson-${id}/${crypto.randomUUID()}.${ext}`;

    await env.FILES.put(key, file.stream(), {
      httpMetadata: { contentType: file.type }
    });

    const imageUrl = `${url.origin}/images/${key}`;
    const old = await db.prepare(
      "SELECT content FROM lesson_notes WHERE lesson_id = ?"
    ).bind(id).first();

    let content = old?.content || "";

    if (!content.includes(imageUrl)) {
      content += `<div><img src="${escapeHtml(imageUrl)}" alt="Lesson photo" style="max-width:100%;height:auto"></div>`;
      await saveNotes(db, id, content);
    }

    return json({ ok: true, url: imageUrl, key }, 201, origin);
  }

  const subtitleLessonMatch =
    path.match(/^\/api\/lesson-subtitles\/lesson\/(\d+)$/);

  if (subtitleLessonMatch && method === "GET") {
    const rows = await db.prepare(`
      SELECT * FROM lesson_subtitles
      WHERE lesson_id = ?
      ORDER BY sort_order, id
    `).bind(Number(subtitleLessonMatch[1])).all();

    return json({ subtitles: rows.results }, 200, origin);
  }

  if (path === "/api/lesson-subtitles" && method === "POST") {
    const data = await request.json();
    const lessonId = Number(data.lesson_id);
    const language = String(data.language || "").trim();
    const title = String(data.title || "").trim();

    if (!lessonId || !language) {
      throw fail("Lesson and language are required.");
    }

    const result = await db.prepare(`
      INSERT INTO lesson_subtitles
        (lesson_id, language, title, content, sort_order)
      VALUES (?, ?, ?, ?, ?)
    `).bind(
      lessonId, language, title, data.content || "",
      Number(data.sort_order) || 1
    ).run();

    return json({ ok: true, id: result.meta.last_row_id }, 201, origin);
  }

  const subtitleMatch = path.match(/^\/api\/lesson-subtitles\/(\d+)$/);

  if (subtitleMatch && ["PUT", "DELETE"].includes(method)) {
    const id = Number(subtitleMatch[1]);

    if (method === "DELETE") {
      await db.prepare("DELETE FROM lesson_subtitles WHERE id = ?")
        .bind(id).run();
      return json({ ok: true }, 200, origin);
    }

    const data = await request.json();
    const old = await db.prepare(
      "SELECT * FROM lesson_subtitles WHERE id = ?"
    ).bind(id).first();

    if (!old) throw fail("Subtitle not found.", 404);

    await db.prepare(`
      UPDATE lesson_subtitles
      SET language = ?, title = ?, content = ?,
          sort_order = ?, updated_at = CURRENT_TIMESTAMP
      WHERE id = ?
    `).bind(
      data.language ?? old.language,
      data.title ?? old.title,
      data.content ?? old.content,
      data.sort_order === undefined ? old.sort_order : Number(data.sort_order),
      id
    ).run();

    return json({ ok: true }, 200, origin);
  }

  return json({ error: "Endpoint not found." }, 404, origin);
}

export default {
  async fetch(request, env) {
    const origin = request.headers.get("Origin") || "";

    try {
      return await handle(request, env);
    } catch (error) {
      return json({
        error: error.message || "Server error."
      }, error.status || 500, origin);
    }
  }
};
