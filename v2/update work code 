
const MAX_IMAGE_SIZE = 10 * 1024 * 1024;
const IMAGE_PREFIX = "lesson-images/";
const ALLOWED_TYPES = new Set([
  "image/jpeg",
  "image/png",
  "image/webp",
  "image/gif"
]);

const cors = origin => ({
  "Access-Control-Allow-Origin": origin,
  "Access-Control-Allow-Methods": "GET,POST,PUT,DELETE,OPTIONS",
  "Access-Control-Allow-Headers": "Content-Type,Authorization",
  "Access-Control-Max-Age": "86400",
  "Vary": "Origin"
});

const json = (data, status = 200, headers = {}) =>
  new Response(JSON.stringify(data), {
    status,
    headers: {
      "Content-Type": "application/json; charset=utf-8",
      ...headers
    }
  });

const slugify = value =>
  String(value || "").trim().toLowerCase()
    .replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");

const safeFileName = name =>
  String(name || "image").replace(/[^a-zA-Z0-9._-]/g, "_");

async function authenticate(request, env) {
  const authorization = request.headers.get("Authorization") || "";
  const token = authorization.startsWith("Bearer ")
    ? authorization.slice(7) : "";

  if (!token) {
    throw new Error("Please sign in with the authorized Google account.");
  }

  const response = await fetch(
    "https://oauth2.googleapis.com/tokeninfo?id_token=" +
    encodeURIComponent(token)
  );

  if (!response.ok) {
    throw new Error("Google sign-in verification failed.");
  }

  const data = await response.json();
  const issuerOK = [
    "accounts.google.com",
    "https://accounts.google.com"
  ].includes(data.iss);

  if (
    data.aud !== env.GOOGLE_CLIENT_ID ||
    !issuerOK ||
    Number(data.exp) <= Math.floor(Date.now() / 1000) ||
    String(data.email_verified) !== "true" ||
    String(data.email || "").toLowerCase() !==
      String(env.ADMIN_EMAIL || "").toLowerCase()
  ) {
    throw new Error(
      "This Google account is not authorized as an administrator."
    );
  }

  return data.email;
}

async function readJSON(request) {
  try {
    return await request.json();
  } catch {
    throw new Error("Invalid JSON request.");
  }
}

function lessonImagePrefix(lessonId) {
  return `${IMAGE_PREFIX}lesson-${lessonId}/`;
}

function validImageKey(key) {
  return typeof key === "string" &&
    key.startsWith(IMAGE_PREFIX) &&
    !key.includes("..") &&
    !key.includes("\\") &&
    key.length <= 500;
}

function imageUrl(request, key, env) {
  const base = String(env.IMAGE_BASE_URL || new URL(request.url).origin)
    .replace(/\/+$/, "");

  const encodedKey = key.split("/")
    .map(part => encodeURIComponent(part))
    .join("/");

  return `${base}/images/${encodedKey}`;
}

async function deleteLessonImages(env, lessonId) {
  if (!env.FILES) return;

  const prefix = lessonImagePrefix(lessonId);
  let cursor;

  do {
    const result = await env.FILES.list({
      prefix,
      limit: 1000,
      ...(cursor ? { cursor } : {})
    });

    const keys = (result.objects || []).map(object => object.key);

    if (keys.length) {
      await Promise.all(keys.map(key => env.FILES.delete(key)));
    }

    cursor = result.truncated ? result.cursor : undefined;
  } while (cursor);
}

async function handler(request, env) {
  const url = new URL(request.url);
  const path = url.pathname.replace(/\/+$/, "") || "/";
  const origin = request.headers.get("Origin") || "";

  const allowed = [
    env.ALLOWED_ORIGIN || "https://createlk.com",
    "https://www.createlk.com"
  ];

  const responseOrigin = allowed.includes(origin)
    ? origin
    : allowed[0];

  const headers = cors(responseOrigin);

  if (origin && !allowed.includes(origin)) {
    return json({ error: "Origin not allowed." }, 403, headers);
  }

  if (request.method === "OPTIONS") {
    return new Response(null, { status: 204, headers });
  }

  /*
   * PUBLIC IMAGE DELIVERY
   * Images are public so students can see them without admin login.
   * Only files inside lesson-images/ can be retrieved here.
   */
  if (path.startsWith("/images/")) {
    if (request.method !== "GET") {
      return json({ error: "Method not allowed." }, 405, headers);
    }

    if (!env.FILES) {
      return json({ error: "The R2 binding FILES is missing." }, 500, headers);
    }

    let key;

    try {
      key = decodeURIComponent(path.slice("/images/".length));
    } catch {
      return json({ error: "Invalid image URL." }, 400, headers);
    }

    if (
      !validImageKey(key) ||
      !/^lesson-images\/lesson-\d+\/[^/]+$/.test(key)
    ) {
      return json({ error: "Invalid image path." }, 400, headers);
    }

    try {
      const object = await env.FILES.get(key);

      if (!object) {
        return json({ error: "Image not found." }, 404, headers);
      }

      const contentType = object.httpMetadata?.contentType || "";
      if (!ALLOWED_TYPES.has(contentType)) {
        return json({ error: "Unsupported image type." }, 415, headers);
      }

      const imageHeaders = new Headers(headers);
      imageHeaders.set("Content-Type", contentType);
      imageHeaders.set("Cache-Control", "public, max-age=86400");
      imageHeaders.set("X-Content-Type-Options", "nosniff");

      return new Response(object.body, {
        status: 200,
        headers: imageHeaders
      });
    } catch (error) {
      return json({
        error: error?.message || "Could not load image."
      }, 500, headers);
    }
  }

  try {
    const adminEmail = await authenticate(request, env);

    if (!env.DB) {
      throw new Error("The D1 binding DB is missing.");
    }

    // Dashboard: subjects, lessons and mapping information.
    if (path === "/api/bootstrap" && request.method === "GET") {
      const subjects = await env.DB.prepare(
        "SELECT id,name,slug,is_active FROM subjects ORDER BY id"
      ).all();

      const lessons = await env.DB.prepare(`
        SELECT l.id,l.title,l.description,l.sort_order,l.is_free,
               l.status,m.subject_id,m.display_order
        FROM lessons l
        JOIN subject_lesson_map m ON m.lesson_id=l.id
        ORDER BY m.subject_id,m.display_order,l.id
      `).all();

      return json({
        subjects: subjects.results || [],
        lessons: lessons.results || []
      }, 200, headers);
    }

    // Add a subject.
    if (path === "/api/subjects" && request.method === "POST") {
      const b = await readJSON(request);
      const name = String(b.name || "").trim();
      const slug = slugify(b.slug || name);

      if (!name || !slug) {
        throw new Error("Subject name is required.");
      }

      const result = await env.DB.prepare(
        "INSERT INTO subjects (name,slug,is_active) VALUES (?,?,1)"
      ).bind(name, slug).run();

      return json({
        ok: true,
        id: result.meta.last_row_id
      }, 201, headers);
    }

    let match = path.match(/^\/api\/subjects\/(\d+)$/);

    if (match && request.method === "PUT") {
      const id = Number(match[1]);
      const b = await readJSON(request);
      const name = String(b.name || "").trim();
      const slug = slugify(b.slug || name);

      if (!name || !slug) {
        throw new Error("Subject name is required.");
      }

      await env.DB.prepare(`
        UPDATE subjects SET name=?,slug=?,is_active=? WHERE id=?
      `).bind(
        name,
        slug,
        b.is_active === false ? 0 : 1,
        id
      ).run();

      return json({ ok: true }, 200, headers);
    }

    if (match && request.method === "DELETE") {
      const id = Number(match[1]);

      await env.DB.prepare(
        "DELETE FROM subject_lesson_map WHERE subject_id=?"
      ).bind(id).run();

      await env.DB.prepare(
        "DELETE FROM subjects WHERE id=?"
      ).bind(id).run();

      return json({ ok: true }, 200, headers);
    }

    // Add a lesson.
    if (path === "/api/lessons" && request.method === "POST") {
      const b = await readJSON(request);
      const title = String(b.title || "").trim();
      const subjectId = Number(b.subject_id);

      if (!title || !subjectId) {
        throw new Error("Lesson title and subject are required.");
      }

      const subject = await env.DB.prepare(
        "SELECT id FROM subjects WHERE id=?"
      ).bind(subjectId).first();

      if (!subject) throw new Error("Subject not found.");

      const max = await env.DB.prepare(
        "SELECT COALESCE(MAX(sort_order),0)+1 AS n FROM lessons"
      ).first();

      const status = [
        "PUBLISHED", "DRAFT", "COMING_SOON"
      ].includes(b.status) ? b.status : "PUBLISHED";

      const lesson = await env.DB.prepare(`
        INSERT INTO lessons
          (title,description,sort_order,is_free,status)
        VALUES (?,?,?,?,?)
      `).bind(
        title,
        String(b.description || ""),
        Number(max.n),
        b.is_free ? 1 : 0,
        status
      ).run();

      const lessonId = lesson.meta.last_row_id;

      await env.DB.prepare(`
        INSERT INTO subject_lesson_map
          (lesson_id,subject_id,display_order)
        VALUES (?,?,?)
      `).bind(
        lessonId,
        subjectId,
        Number(b.display_order || max.n)
      ).run();

      return json({ ok: true, id: lessonId }, 201, headers);
    }

    // Edit a lesson.
    match = path.match(/^\/api\/lessons\/(\d+)$/);

    if (match && request.method === "PUT") {
      const id = Number(match[1]);
      const b = await readJSON(request);
      const title = String(b.title || "").trim();

      if (!title) throw new Error("Lesson title is required.");

      const status = [
        "PUBLISHED", "DRAFT", "COMING_SOON"
      ].includes(b.status) ? b.status : "PUBLISHED";

      await env.DB.prepare(`
        UPDATE lessons
        SET title=?,description=?,sort_order=?,is_free=?,status=?
        WHERE id=?
      `).bind(
        title,
        String(b.description || ""),
        Number(b.sort_order || 1),
        b.is_free ? 1 : 0,
        status,
        id
      ).run();

      if (b.subject_id) {
        await env.DB.prepare(`
          UPDATE subject_lesson_map
          SET subject_id=?,display_order=?
          WHERE lesson_id=?
        `).bind(
          Number(b.subject_id),
          Number(b.display_order || b.sort_order || 1),
          id
        ).run();
      }

      return json({ ok: true }, 200, headers);
    }

    // Delete a lesson and its notes, questions, mappings and photos.
    if (match && request.method === "DELETE") {
      const id = Number(match[1]);

      await deleteLessonImages(env, id);

      await env.DB.prepare(
        "DELETE FROM questions WHERE lesson_id=?"
      ).bind(id).run();

      await env.DB.prepare(
        "DELETE FROM lesson_notes WHERE lesson_id=?"
      ).bind(id).run();

      await env.DB.prepare(
        "DELETE FROM subject_lesson_map WHERE lesson_id=?"
      ).bind(id).run();

      await env.DB.prepare(
        "DELETE FROM lessons WHERE id=?"
      ).bind(id).run();

      return json({ ok: true }, 200, headers);
    }

    // List questions for a lesson.
    match = path.match(/^\/api\/questions\/lesson\/(\d+)$/);

    if (match && request.method === "GET") {
      const result = await env.DB.prepare(`
        SELECT id,lesson_id,question_number,question,option_a,option_b,
               option_c,option_d,correct_answer,explanation
        FROM questions
        WHERE lesson_id=?
        ORDER BY question_number,id
      `).bind(Number(match[1])).all();

      return json({
        questions: result.results || []
      }, 200, headers);
    }

    // Add a question.
    if (path === "/api/questions" && request.method === "POST") {
      const b = await readJSON(request);
      const lessonId = Number(b.lesson_id);
      const question = String(b.question || "").trim();
      const answer = String(b.correct_answer || "").toUpperCase();

      if (
        !lessonId ||
        !question ||
        !["A", "B", "C", "D"].includes(answer)
      ) {
        throw new Error(
          "Lesson, question, and correct answer A/B/C/D are required."
        );
      }

      const next = await env.DB.prepare(`
        SELECT COALESCE(MAX(question_number),0)+1 AS n
        FROM questions WHERE lesson_id=?
      `).bind(lessonId).first();

      const result = await env.DB.prepare(`
        INSERT INTO questions
          (lesson_id,question_number,question,option_a,option_b,
           option_c,option_d,correct_answer,explanation)
        VALUES (?,?,?,?,?,?,?,?,?)
      `).bind(
        lessonId,
        Number(b.question_number || next.n),
        question,
        String(b.option_a || ""),
        String(b.option_b || ""),
        String(b.option_c || ""),
        String(b.option_d || ""),
        answer,
        String(b.explanation || "")
      ).run();

      return json({
        ok: true,
        id: result.meta.last_row_id
      }, 201, headers);
    }

    // Edit or delete a question.
    match = path.match(/^\/api\/questions\/(\d+)$/);

    if (match && request.method === "PUT") {
      const id = Number(match[1]);
      const b = await readJSON(request);
      const answer = String(b.correct_answer || "").toUpperCase();

      if (
        !String(b.question || "").trim() ||
        !["A", "B", "C", "D"].includes(answer)
      ) {
        throw new Error(
          "Question and valid answer A/B/C/D are required."
        );
      }

      await env.DB.prepare(`
        UPDATE questions
        SET question_number=?,question=?,option_a=?,option_b=?,
            option_c=?,option_d=?,correct_answer=?,explanation=?
        WHERE id=?
      `).bind(
        Number(b.question_number || 1),
        String(b.question),
        String(b.option_a || ""),
        String(b.option_b || ""),
        String(b.option_c || ""),
        String(b.option_d || ""),
        answer,
        String(b.explanation || ""),
        id
      ).run();

      return json({ ok: true }, 200, headers);
    }

    if (match && request.method === "DELETE") {
      await env.DB.prepare(
        "DELETE FROM questions WHERE id=?"
      ).bind(Number(match[1])).run();

      return json({ ok: true }, 200, headers);
    }

    // Read lesson notes.
    match = path.match(/^\/api\/notes\/(\d+)$/);

    if (match && request.method === "GET") {
      const note = await env.DB.prepare(
        "SELECT content FROM lesson_notes WHERE lesson_id=?"
      ).bind(Number(match[1])).first();

      return json({
        content: note?.content || ""
      }, 200, headers);
    }

    // Save lesson notes. HTML content may include image URLs.
    if (match && request.method === "PUT") {
      const lessonId = Number(match[1]);
      const b = await readJSON(request);
      const content = String(b.content || "");

      if (content.length > 1_000_000) {
        throw new Error("Lesson notes must be smaller than 1 MB.");
      }

      const lesson = await env.DB.prepare(
        "SELECT id FROM lessons WHERE id=?"
      ).bind(lessonId).first();

      if (!lesson) throw new Error("Lesson not found.");

      await env.DB.prepare(`
        INSERT INTO lesson_notes (lesson_id,content,updated_at)
        VALUES (?,?,CURRENT_TIMESTAMP)
        ON CONFLICT(lesson_id) DO UPDATE SET
          content=excluded.content,
          updated_at=CURRENT_TIMESTAMP
      `).bind(lessonId, content).run();

      return json({ ok: true }, 200, headers);
    }

    /*
     * UPLOAD LESSON PHOTO
     * POST /api/lesson-images
     * multipart/form-data: lesson_id, file
     */
    if (path === "/api/lesson-images" && request.method === "POST") {
      if (!env.FILES) {
        throw new Error("The R2 binding FILES is missing.");
      }

      const form = await request.formData();
      const lessonId = Number(form.get("lesson_id"));
      const file = form.get("file");

      if (
        !Number.isSafeInteger(lessonId) ||
        lessonId < 1 ||
        !file ||
        typeof file.arrayBuffer !== "function"
      ) {
        throw new Error("A valid lesson and image file are required.");
      }

      if (!ALLOWED_TYPES.has(file.type)) {
        throw new Error(
          "Use a JPEG, PNG, WebP or GIF image."
        );
      }

      if (file.size < 1 || file.size > MAX_IMAGE_SIZE) {
        throw new Error("Image must be smaller than 10 MB.");
      }

      const lesson = await env.DB.prepare(
        "SELECT id FROM lessons WHERE id=?"
      ).bind(lessonId).first();

      if (!lesson) throw new Error("Lesson not found.");

      const extension = {
        "image/jpeg": ".jpg",
        "image/png": ".png",
        "image/webp": ".webp",
        "image/gif": ".gif"
      }[file.type];

      const key =
        `${lessonImagePrefix(lessonId)}` +
        `${crypto.randomUUID()}-${safeFileName(file.name || "image")}` +
        extension;

      await env.FILES.put(key, await file.arrayBuffer(), {
        httpMetadata: {
          contentType: file.type,
          cacheControl: "public, max-age=86400"
        },
        customMetadata: {
          lessonId: String(lessonId),
          uploadedBy: String(adminEmail)
        }
      });

      return json({
        ok: true,
        key,
        url: imageUrl(request, key, env),
        content_type: file.type,
        size: file.size
      }, 201, headers);
    }

    /*
     * DELETE LESSON PHOTO
     * DELETE /api/lesson-images
     * JSON: { "lesson_id": 1, "key": "lesson-images/lesson-1/..." }
     */
    if (path === "/api/lesson-images" && request.method === "DELETE") {
      if (!env.FILES) {
        throw new Error("The R2 binding FILES is missing.");
      }

      const b = await readJSON(request);
      const lessonId = Number(b.lesson_id);
      const key = String(b.key || "");

      if (
        !Number.isSafeInteger(lessonId) ||
        lessonId < 1 ||
        !validImageKey(key) ||
        !key.startsWith(lessonImagePrefix(lessonId)) ||
        key.slice(lessonImagePrefix(lessonId).length).includes("/")
      ) {
        throw new Error("Invalid lesson image key.");
      }

      await env.FILES.delete(key);

      return json({ ok: true }, 200, headers);
    }

    return json({ error: "Endpoint not found." }, 404, headers);

  } catch (error) {
    const message = error?.message || "Unexpected server error.";

    const status =
      /authorized|sign in|Google/i.test(message) ? 401 :
      /not found/i.test(message) ? 404 :
      400;

    return json({ error: message }, status, headers);
  }
}

export default {
  async fetch(request, env) {
    return handler(request, env);
  }
};
