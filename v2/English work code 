const COOKIE="english_v2_session",DAYS=7,XP=10,COINS=5,MAXXP=10000,FREE=300,PREMIUM=1000;

const cors=r=>({
  "Access-Control-Allow-Origin":r.headers.get("Origin")||"*",
  "Access-Control-Allow-Credentials":"true",
  "Access-Control-Allow-Methods":"GET,POST,OPTIONS",
  "Access-Control-Allow-Headers":"Content-Type,Authorization"
});

const out=(d,s,r)=>new Response(JSON.stringify(d),{
  status:s,headers:{"Content-Type":"application/json","Cache-Control":"no-store",...cors(r)}
});

function getCookie(r,n){
  const m=(r.headers.get("Cookie")||"").match(new RegExp("(?:^|;\\s*)"+n+"=([^;]*)"));
  return m?decodeURIComponent(m[1]):null;
}

function rnd(n=32){
  const b=new Uint8Array(n);crypto.getRandomValues(b);
  return [...b].map(x=>x.toString(16).padStart(2,"0")).join("");
}

function limit(u){return u.membership==="premium"?PREMIUM:FREE}

async function me(r,e){
  const t=getCookie(r,COOKIE);
  if(!t)return null;
  return e.DB.prepare(`
    SELECT u.*,s.expires_at session_expires_at
    FROM sessions s JOIN users u ON u.id=s.user_id
    WHERE s.token=? AND s.expires_at>? LIMIT 1
  `).bind(t,new Date().toISOString()).first();
}

async function count(e,id){
  const r=await e.DB.prepare(
    "SELECT COUNT(*) n FROM quiz_answers WHERE user_id=?"
  ).bind(id).first();
  return Number(r?.n)||0;
}

async function setup(e){
  const u=await e.DB.prepare("PRAGMA table_info(users)").all();
  if(!(u.results||[]).some(x=>x.name==="coins"))
    try{await e.DB.prepare("ALTER TABLE users ADD COLUMN coins INTEGER DEFAULT 0").run()}catch{}

  await e.DB.prepare(`
    CREATE TABLE IF NOT EXISTS sessions(
      token TEXT PRIMARY KEY,user_id TEXT NOT NULL,
      expires_at TEXT NOT NULL,created_at TEXT DEFAULT CURRENT_TIMESTAMP
    )`).run();

  await e.DB.prepare(`
    CREATE TABLE IF NOT EXISTS quiz_answers(
      id INTEGER PRIMARY KEY AUTOINCREMENT,user_id TEXT NOT NULL,
      question_id INTEGER NOT NULL,lesson_id INTEGER NOT NULL,
      selected_answer TEXT NOT NULL,is_correct INTEGER DEFAULT 0,
      xp_awarded INTEGER DEFAULT 0,coins_awarded INTEGER DEFAULT 0,
      answered_at TEXT DEFAULT CURRENT_TIMESTAMP,
      UNIQUE(user_id,question_id)
    )`).run();

  await e.DB.prepare(`
    CREATE TABLE IF NOT EXISTS referrals(
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      referrer_id TEXT NOT NULL,
      referred_user_id TEXT NOT NULL UNIQUE,
      affiliate_code TEXT NOT NULL,
      created_at TEXT DEFAULT CURRENT_TIMESTAMP
    )`).run();
}

async function googleToken(e,code,uri){
  const b=new URLSearchParams({
    client_id:e.GOOGLE_CLIENT_ID,
    client_secret:e.GOOGLE_CLIENT_SECRET,
    code,grant_type:"authorization_code",redirect_uri:uri
  });
  const r=await fetch("https://oauth2.googleapis.com/token",{
    method:"POST",
    headers:{"Content-Type":"application/x-www-form-urlencoded"},
    body:b
  });
  if(!r.ok)throw Error("Google login failed");
  return r.json();
}

async function googleUser(t){
  const r=await fetch("https://www.googleapis.com/oauth2/v3/userinfo",{
    headers:{Authorization:`Bearer ${t}`}
  });
  if(!r.ok)throw Error("Google account error");
  return r.json();
}

async function session(e,id){
  const t=rnd(),x=new Date(Date.now()+DAYS*86400000).toISOString();
  await e.DB.prepare(
    "INSERT INTO sessions(token,user_id,expires_at) VALUES(?,?,?)"
  ).bind(t,id,x).run();
  return `${COOKIE}=${t}; Path=/; Max-Age=${DAYS*86400}; HttpOnly; Secure; SameSite=None`;
}

export default{
async fetch(r,e){
  const u=new URL(r.url);

  if(r.method==="OPTIONS")
    return new Response(null,{status:204,headers:cors(r)});

  try{
    await setup(e);

    if(u.pathname==="/")
      return new Response("CreateLK English V2 API is running ✅");

    /* GOOGLE */

    if(u.pathname==="/auth/google"){
      const state=rnd();
      const ref=(u.searchParams.get("ref")||"").trim().toUpperCase();
      const st=ref?`${state}.${ref}`:state;
      const uri=`${u.origin}/auth/google/callback`;
      const g=new URL("https://accounts.google.com/o/oauth2/v2/auth");

      Object.entries({
        client_id:e.GOOGLE_CLIENT_ID,
        redirect_uri:uri,
        response_type:"code",
        scope:"openid email profile",
        access_type:"online",
        prompt:"select_account",
        state:st
      }).forEach(([k,v])=>g.searchParams.set(k,v));

      return new Response(null,{
        status:302,
        headers:{
          Location:g,
          "Set-Cookie":`oauth_state=${st}; Path=/auth/google; Max-Age=600; HttpOnly; Secure; SameSite=Lax`
        }
      });
    }

    if(u.pathname==="/auth/google/callback"){
      const code=u.searchParams.get("code"),st=u.searchParams.get("state")||"";

      if(!code||st!==getCookie(r,"oauth_state"))
        return out({success:false,error:"Invalid Google login"},400,r);

      const ref=st.split(".").slice(1).join(".").toUpperCase();
      const g=await googleUser(
        (await googleToken(e,code,`${u.origin}/auth/google/callback`)).access_token
      );

      let user=await e.DB.prepare(
        "SELECT * FROM users WHERE google_id=? LIMIT 1"
      ).bind(g.sub).first();

      if(!user&&g.email)
        user=await e.DB.prepare(
          "SELECT * FROM users WHERE email=? LIMIT 1"
        ).bind(g.email).first();

      let id;

      if(user){
        id=user.id;
        await e.DB.prepare(`
          UPDATE users SET google_id=?,name=?,avatar_url=?,
          updated_at=CURRENT_TIMESTAMP WHERE id=?
        `).bind(g.sub,g.name||g.email.split("@")[0],g.picture||null,id).run();
      }else{
        id=crypto.randomUUID();
        const code=rnd(6).toUpperCase();
        let referred=null,referrer=null;

        if(ref){
          const x=await e.DB.prepare(
            "SELECT id,affiliate_code FROM users WHERE affiliate_code=? LIMIT 1"
          ).bind(ref).first();

          if(x){referred=x.affiliate_code;referrer=x.id}
        }

        await e.DB.prepare(`
          INSERT INTO users(
            id,google_id,email,name,avatar_url,membership,
            xp,coins,correct_answers,questions_answered,
            lessons_completed,affiliate_code,referred_by
          ) VALUES(?,?,?,?,?,'free',0,0,0,0,0,?,?)
        `).bind(
          id,g.sub,g.email,g.name||g.email.split("@")[0],
          g.picture||null,code,referred
        ).run();

        try{
          await e.DB.prepare(
            "INSERT OR IGNORE INTO affiliates(user_id,affiliate_code) VALUES(?,?)"
          ).bind(id,code).run();
        }catch{}

        if(referrer)
          await e.DB.prepare(`
            INSERT OR IGNORE INTO referrals(
              referrer_id,referred_user_id,affiliate_code
            ) VALUES(?,?,?)
          `).bind(referrer,id,ref).run();
      }

      return new Response(null,{
        status:302,
        headers:{
          Location:"https://createlk.com/v2/index.html",
          "Set-Cookie":[
            await session(e,id),
            "oauth_state=; Path=/auth/google; Max-Age=0"
          ]
        }
      });
    }

    /* ME */

    if(u.pathname==="/api/me"){
      const user=await me(r,e);

      if(!user)
        return out({success:true,logged_in:false,user:null},200,r);

      const used=await count(e,user.id);
      const lim=limit(user);
      const rr=await e.DB.prepare(
        "SELECT COUNT(*) n FROM referrals WHERE referrer_id=?"
      ).bind(user.id).first();

      return out({
        success:true,
        logged_in:true,
        user,
        usage:{used,limit:lim,remaining:Math.max(0,lim-used)},
        referral:{
          code:user.affiliate_code,
          referred_by:user.referred_by||null,
          count:Number(rr?.n)||0,
          link:`https://createlk.com/v2/?ref=${user.affiliate_code}`
        }
      },200,r);
    }

    /* REFERRAL */

    if(u.pathname==="/api/referral"){
      const user=await me(r,e);
      if(!user)return out({success:false,error:"Login required"},401,r);

      const x=await e.DB.prepare(
        "SELECT COUNT(*) n FROM referrals WHERE referrer_id=?"
      ).bind(user.id).first();

      return out({
        success:true,
        affiliate_code:user.affiliate_code,
        referral_link:`https://createlk.com/v2/?ref=${user.affiliate_code}`,
        referred_by:user.referred_by||null,
        referrals:Number(x?.n)||0
      },200,r);
    }

    /* LESSONS */

    if(u.pathname==="/api/lessons"){
      const user=await me(r,e);
      const x=await e.DB.prepare(
        "SELECT id,title,description,sort_order,is_free FROM lessons ORDER BY sort_order"
      ).all();

      const membership=user?.membership||"guest";
      const used=user?await count(e,user.id):0;
      const lim=user?limit(user):FREE;

      return out({
        success:true,membership,
        usage:{used,limit:lim,remaining:Math.max(0,lim-used)},
        lessons:(x.results||[]).map(l=>({
          ...l,
          is_free:Number(l.is_free)===1?1:0,
          accessible:Number(l.is_free)===1||membership==="premium"
        }))
      },200,r);
    }

    /* QUIZ */

    if(u.pathname==="/api/quiz"&&r.method==="GET"){
      const user=await me(r,e);
      if(!user)return out({success:false,error:"Login required"},401,r);

      const id=Number(u.searchParams.get("lesson"));
      if(!Number.isInteger(id)||id<1)
        return out({success:false,error:"Invalid lesson ID"},400,r);

      const lesson=await e.DB.prepare(
        "SELECT id,title,description,is_free FROM lessons WHERE id=?"
      ).bind(id).first();

      if(!lesson)return out({success:false,error:"Lesson not found"},404,r);

      if(Number(lesson.is_free)!==1&&user.membership!=="premium")
        return out({success:false,error:"Premium membership required"},403,r);

      const used=await count(e,user.id),lim=limit(user);

      if(used>=lim)
        return out({
          success:false,
          error:`Question limit reached (${lim})`,
          used,limit:lim,remaining:0
        },403,r);

      const x=await e.DB.prepare(`
        SELECT q.id,q.lesson_id,q.question_number,q.question,
        q.option_a,q.option_b,q.option_c,q.option_d
        FROM questions q
        WHERE q.lesson_id=?
        AND NOT EXISTS(
          SELECT 1 FROM quiz_answers a
          WHERE a.user_id=? AND a.question_id=q.id
        )
        ORDER BY q.question_number
        LIMIT ?
      `).bind(id,user.id,lim-used).all();

      return out({
        success:true,
        lesson,
        membership:user.membership,
        usage:{used,limit:lim,remaining:lim-used},
        questions:x.results||[]
      },200,r);
    }

    /* ANSWER */

    if(u.pathname==="/api/quiz/answer"&&r.method==="POST"){
      const user=await me(r,e);
      if(!user)return out({success:false,error:"Login required"},401,r);

      const b=await r.json();
      const qid=Number(b.question_id);
      const answer=String(b.selected_answer||"").toUpperCase();

      if(!Number.isInteger(qid)||!["A","B","C","D"].includes(answer))
        return out({success:false,error:"Invalid answer"},400,r);

      const q=await e.DB.prepare(`
        SELECT id,lesson_id,correct_answer
        FROM questions WHERE id=? LIMIT 1
      `).bind(qid).first();

      if(!q)return out({success:false,error:"Question not found"},404,r);

      const old=await e.DB.prepare(`
        SELECT * FROM quiz_answers
        WHERE user_id=? AND question_id=? LIMIT 1
      `).bind(user.id,qid).first();

      if(old)
        return out({
          success:true,
          already_answered:true,
          correct:Number(old.is_correct)===1,
          correct_answer:q.correct_answer,
          xp_awarded:Number(old.xp_awarded)||0,
          coins_awarded:Number(old.coins_awarded)||0
        },200,r);

      const used=await count(e,user.id),lim=limit(user);

      if(used>=lim)
        return out({
          success:false,error:"Question limit reached",
          used,limit:lim,remaining:0
        },403,r);

      const correct=answer===String(q.correct_answer).toUpperCase();
      const xp=correct?XP:0,coins=correct?COINS:0;

      await e.DB.prepare(`
        INSERT INTO quiz_answers(
          user_id,question_id,lesson_id,selected_answer,
          is_correct,xp_awarded,coins_awarded
        ) VALUES(?,?,?,?,?,?,?)
      `).bind(
        user.id,qid,q.lesson_id,answer,correct?1:0,xp,coins
      ).run();

      await e.DB.prepare(`
        UPDATE users SET
          xp=MIN(?,COALESCE(xp,0)+?),
          coins=COALESCE(coins,0)+?,
          correct_answers=COALESCE(correct_answers,0)+?,
          questions_answered=COALESCE(questions_answered,0)+1,
          updated_at=CURRENT_TIMESTAMP
        WHERE id=?
      `).bind(
        MAXXP,xp,coins,correct?1:0,user.id
      ).run();

      const fresh=await me(r,e),total=used+1;

      return out({
        success:true,
        correct,
        selected_answer:answer,
        correct_answer:q.correct_answer,
        xp_awarded:xp,
        coins_awarded:coins,
        xp:Number(fresh?.xp)||0,
        coins:Number(fresh?.coins)||0,
        correct_answers:Number(fresh?.correct_answers)||0,
        questions_answered:total,
        question_limit:limit(fresh||user),
        remaining:Math.max(0,limit(fresh||user)-total)
      },200,r);
    }

    /* LOGOUT */

    if(u.pathname==="/auth/logout"){
      const t=getCookie(r,COOKIE);
      if(t)await e.DB.prepare("DELETE FROM sessions WHERE token=?").bind(t).run();

      return new Response(null,{
        status:302,
        headers:{
          Location:"https://createlk.com/v2/index.html",
          "Set-Cookie":`${COOKIE}=; Path=/; Max-Age=0`
        }
      });
    }

    return out({success:false,error:"Not found"},404,r);

  }catch(e){
    return out({success:false,error:e.message||"Server error"},500,r);
  }
}