<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#0b1628">
<title>CreateLK English</title>

<style>
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;font-family:Arial,Helvetica,sans-serif;background:#0b1628;color:#dbe4f0}
button{font:inherit;cursor:pointer}

header{
position:sticky;top:0;z-index:20;background:#0a1527f5;
border-bottom:1px solid #243753;backdrop-filter:blur(10px)
}

nav{
height:60px;max-width:1000px;margin:auto;padding:7px 15px;
display:flex;align-items:center;gap:9px
}

.brand{
display:flex;align-items:center;gap:8px;margin-right:auto;
color:#fff;text-decoration:none
}

.logo-img{width:38px;height:38px;object-fit:contain}
.logo{font-size:19px;font-weight:900}
.logo span,.gold{color:#d9b85c}

.btn{
border:0;border-radius:8px;padding:10px 14px;
background:#c5a64b;color:#101b2c;font-weight:800
}

.light,.menu-btn{
background:#172942;color:#dbe4f0;border:1px solid #30435e
}

.avatar{
display:none;width:38px;height:38px;border-radius:50%;
object-fit:cover;border:2px solid #c5a64b
}

.menu-wrap{position:relative}

.menu-btn{
width:40px;height:40px;border-radius:8px;font-size:20px
}

.menu{
display:none;position:absolute;right:0;top:46px;width:230px;
background:#13233b;border:1px solid #30435e;border-radius:10px;
padding:6px;box-shadow:0 12px 30px #0008
}

.menu.show{display:block}

.menu a{
display:block;padding:9px;color:#dbe4f0;
text-decoration:none;border-radius:6px
}

.menu a:hover{background:#1c304a}

.menu-title{
padding:8px 9px 3px;color:#c5a64b;
font-size:10px;font-weight:bold
}

main{max-width:1000px;margin:auto;padding:8px 15px 20px}

.hero,.card{
background:#13233b;border:1px solid #243753;border-radius:14px
}

.hero{
max-width:900px;margin:auto;text-align:center;padding:18px 14px
}

.hero h1{font-size:clamp(28px,6vw,42px);margin:4px 0}

.hero p{
max-width:650px;margin:auto;color:#aab8cc;line-height:1.4
}

.stats{
display:flex;justify-content:center;flex-wrap:wrap;
gap:6px;margin:10px 0
}

.stat{
min-width:90px;padding:7px 9px;background:#172942;
border:1px solid #2b405c;border-radius:8px
}

.stat strong{display:block;color:#d9b85c}
.stat small{color:#8497af;font-size:9px}

.account{
display:none;margin-top:3px;padding:8px 12px;background:#172942;
border:1px solid #30435e;border-radius:20px;font-size:12px;font-weight:bold
}

.rank{
display:inline-block;margin-top:5px;padding:8px 12px;background:#172942;
border:1px solid #30435e;border-radius:8px;color:#fff;
text-decoration:none;font-weight:bold
}

.limit-box{
display:none;max-width:500px;margin:12px auto 0;text-align:left
}

.limit-head{
display:flex;justify-content:space-between;
font-size:11px;color:#9eacc2;margin-bottom:5px
}

.limit-head strong{color:#d9b85c}

.limit-track{
height:8px;background:#172942;border:1px solid #30435e;
border-radius:10px;overflow:hidden
}

.limit-bar{
height:100%;width:0;background:#c5a64b;
transition:width .3s ease
}

.notice{
display:none;max-width:900px;margin:7px auto;padding:9px;
text-align:center;background:#3b252a;border:1px solid #71434a;
border-radius:8px;color:#edb9bf
}

.notice.show{display:block}

.section-title{
max-width:900px;margin:15px auto 8px
}

.section-title h2{margin:0}

.section-title p{
margin:3px 0;color:#8497af;font-size:13px
}

.grid{
max-width:900px;margin:auto;
display:grid;
grid-template-columns:repeat(auto-fill,minmax(235px,1fr));
gap:9px
}

.card{overflow:hidden}
.card-top{height:3px;background:#bda451}
.card-body{padding:11px}
.card h3{margin:4px 0}

.card p{
color:#9eacc2;line-height:1.3;font-size:13px;margin:4px 0
}

.lesson-emoji{font-size:27px}
.card .btn{width:100%;margin-top:6px}

.premium-badge,.free-badge{
display:inline-block;padding:3px 7px;margin-top:3px;
border-radius:5px;font-size:9px;font-weight:800
}

.premium-badge{background:#2b3444;color:#d9b85c}
.free-badge{background:#193b32;color:#b8e4d1}

.quiz-wrap{max-width:900px;margin:15px auto}

.quiz-card{
background:#13233b;border:1px solid #243753;
border-radius:14px;padding:16px
}

.quiz-head{
display:flex;align-items:center;gap:10px;margin-bottom:12px
}

.quiz-head .btn{width:auto}

.progress{
height:7px;background:#172942;border-radius:10px;
overflow:hidden;margin:10px 0 8px
}

.progress-bar{
height:100%;width:0;background:#c5a64b;transition:.2s
}

.question-count{color:#8497af;font-size:12px}

.question{
font-size:20px;font-weight:bold;line-height:1.4;margin:15px 0
}

.options{display:grid;gap:9px}

.option{
width:100%;text-align:left;background:#172942;color:#dbe4f0;
border:1px solid #30435e;border-radius:9px;padding:13px;
transition:.15s
}

.option:hover{background:#203654}

.option.correct{
background:#193b32;border-color:#4fa47f
}

.option.wrong{
background:#4a252b;border-color:#a95762
}

.option.disabled{
pointer-events:none;opacity:.9
}

.result{
text-align:center;margin-top:12px;font-weight:bold;
animation:resultIn .2s ease
}

.explanation{
margin-top:10px;padding:10px;background:#172942;
border-radius:8px;color:#aab8cc;font-size:13px;line-height:1.4
}

.quiz-actions{
display:flex;gap:8px;margin-top:12px
}

.quiz-actions .btn{flex:1}

.reward-fly{
position:fixed;left:50%;top:45%;
transform:translate(-50%,-50%);
z-index:9999;font-size:22px;font-weight:900;
pointer-events:none;opacity:1;transition:all .9s ease
}

.reward-xp{color:#d9b85c}
.reward-coins{color:#f5d76e}

@keyframes resultIn{
from{opacity:0;transform:translateY(5px)}
to{opacity:1;transform:translateY(0)}
}

footer{
border-top:1px solid #243753;padding:17px 15px;
text-align:center;color:#74869e;font-size:11px
}

footer a{
color:#aab8cc;text-decoration:none;margin:0 5px
}

@media(max-width:600px){
.logo{font-size:16px}
.hero{padding:18px 12px}
.btn{padding:9px 12px}
.question{font-size:18px}
}
</style>
</head>

<body>

<header>
<nav>

<a class="brand" href="/v2/">

<img class="logo-img"
src="https://assets.createlk.com/file_00000000f97082119cf85b0ae761f096.png"
alt="CreateLK English">

<div class="logo">
CreateLK <span>English</span>
</div>

</a>

<button class="btn" id="loginBtn" onclick="login()">
Sign in
</button>

<img id="avatar" class="avatar" alt="Profile">

<div class="menu-wrap">

<button class="menu-btn" onclick="toggleMenu()">☰</button>

<div class="menu" id="menu">

<a href="/v2/" onclick="backLessons()">📚 Lessons</a>
<a href="/v2/rank.html">🏆 Leaderboard</a>
<a href="/v2/aff.html">💰 Affiliate Dashboard</a>
<a href="/v2/about.html">ℹ️ About Us</a>
<a href="/v2/contact.html">📩 Contact Us</a>

<div class="menu-title">POLICIES</div>

<a href="/v2/terms.html">Terms & Conditions</a>
<a href="/v2/privacy.html">Privacy Policy</a>
<a href="/v2/refund.html">Refund & Cancellation</a>
<a href="/v2/payment.html">Payment Policy</a>
<a href="/v2/disclaimer.html">Disclaimer</a>

<a id="logoutMenu" href="#"
onclick="logout();return false" style="display:none">
🚪 Logout
</a>

</div>
</div>

</nav>
</header>

<main>

<section class="hero" id="hero">

<div class="gold">CREATE LK ACADEMY</div>

<h1>CreateLK English</h1>

<p>
Learn English with confidence. Practice English MCQ questions and improve your English step by step.
</p>

<div class="stats">

<div class="stat">
<strong id="questionCount">1,000+</strong>
<small>QUESTIONS</small>
</div>

<div class="stat">
<strong id="xp">0</strong>
<small>XP</small>
</div>

<div class="stat">
<strong id="coins">0</strong>
<small>COINS</small>
</div>

<div class="stat">
<strong id="membership">GUEST</strong>
<small>MEMBERSHIP</small>
</div>

</div>

<div class="account" id="account"></div>

<a class="rank" href="/v2/rank.html">
🏆 View Leaderboard
</a>

<div class="limit-box" id="limitBox">

<div class="limit-head">
<span>Practice Progress</span>
<strong id="limitText">0 / 300</strong>
</div>

<div class="limit-track">
<div class="limit-bar" id="limitBar"></div>
</div>

</div>

</section>

<div class="notice" id="notice"></div>

<div id="lessonArea">

<div class="section-title">

<h2>📚 English Lessons</h2>

<p>Choose a lesson and start practicing.</p>

</div>

<section class="grid" id="lessons">

<div class="card">

<div class="card-top"></div>

<div class="card-body">

<div class="lesson-emoji">📚</div>

<h3>Loading lessons...</h3>

<p>Please wait.</p>

</div>
</div>

</section>

</div>

<div id="quizArea" style="display:none"></div>

</main>

<footer>

<div>
© <span id="year"></span> CreateLK English
</div>

<div style="margin-top:6px">

<a href="/v2/terms.html">Terms</a>
<a href="/v2/privacy.html">Privacy</a>
<a href="/v2/refund.html">Refund</a>
<a href="/v2/contact.html">Contact</a>

</div>

</footer>

<script>

const API="https://createlk-english-v2.createlk.workers.dev";

let currentLesson=null;
let currentQuestions=[];
let currentQuestion=0;
let answered=false;
let referral="";

const $=id=>document.getElementById(id);


function esc(value){

return String(value??"").replace(/[&<>"']/g,c=>({

"&":"&amp;",
"<":"&lt;",
">":"&gt;",
'"':"&quot;",
"'":"&#39;"

}[c]));

}


function toggleMenu(){

$("menu").classList.toggle("show");

}


document.addEventListener("click",e=>{

if(!e.target.closest(".menu-wrap"))
$("menu").classList.remove("show");

});


function notice(msg){

const n=$("notice");

n.textContent=msg;
n.classList.add("show");

clearTimeout(window.nt);

window.nt=setTimeout(()=>{
n.classList.remove("show")
},4500);

}


function login(){

let url=API+"/auth/google";

if(referral)
url+="?ref="+encodeURIComponent(referral);

location.href=url;

}


function logout(){

location.href=API+"/auth/logout";

}


async function get(path,options={}){

const r=await fetch(API+path,{
credentials:"include",
cache:"no-store",
...options
});

let data={};

try{
data=await r.json();
}catch{}

return{r,data};

}


function updateLimitProgress(used,limit){

used=Number(used||0);
limit=Number(limit||300);

const box=$("limitBox");
const text=$("limitText");
const bar=$("limitBar");

if(!box||!text||!bar)return;

box.style.display="block";

const percent=Math.min(
100,
Math.round((used/limit)*100)
);

text.textContent=
used+" / "+limit;

bar.style.width=
percent+"%";

}


async function loadUser(){

try{

const {r,data}=await get(
"/api/me?_="+Date.now()
);

if(!r.ok||!data.logged_in){

$("membership").textContent="GUEST";
$("xp").textContent="0";
$("coins").textContent="0";

$("account").style.display="none";
$("avatar").style.display="none";

$("loginBtn").style.display="block";
$("logoutMenu").style.display="none";

$("limitBox").style.display="none";

return;

}

const u=data.user||{};

const membership=
String(u.membership||"free").toLowerCase();

$("membership").textContent=
membership.toUpperCase();

$("xp").textContent=
Number(u.xp||0);

$("coins").textContent=
Number(u.coins||0);

$("account").style.display=
"inline-block";

$("account").textContent=
"👤 "+(u.name||u.email||"Account");

$("loginBtn").style.display="none";
$("logoutMenu").style.display="block";

if(u.avatar_url){

$("avatar").src=u.avatar_url;
$("avatar").style.display="block";

}

updateLimitProgress(
data.usage?.used||0,
data.usage?.limit||
(membership==="premium"?1000:300)
);

}catch(e){

console.error(e);

}

}


async function loadLessons(){

try{

const {r,data}=await get(
"/api/lessons?_="+Date.now()
);

if(!r.ok||!data.success)
throw Error(
data.error||"Unable to load lessons"
);

const list=
Array.isArray(data.lessons)
?data.lessons:[];

$("questionCount").textContent="1,000+";

if(!list.length){

$("lessons").innerHTML=`

<div class="card">

<div class="card-top"></div>

<div class="card-body">

<div class="lesson-emoji">📚</div>

<h3>No Lessons</h3>

<p>No lessons are available.</p>

</div>

</div>`;

return;

}

const emojis=[
"📚","🔤","📝","💬","🎯",
"🌟","🧠","✍️","🗣️","👂",
"📖","🏆","🌍","💡","🚀",
"🎓","🧩","🔎","🕊️","👑"
];

$("lessons").innerHTML=
list.map((l,i)=>{

const free=
Number(l.is_free)===1;

const accessible=
l.accessible===true;

return`

<article class="card">

<div class="card-top"></div>

<div class="card-body">

<div class="lesson-emoji">
${emojis[i]||"📚"}
</div>

<h3>
Lesson ${i+1}: ${esc(l.title)}
</h3>

<p>
${esc(
l.description||
"English grammar practice."
)}
</p>

${
free
?'<span class="free-badge">FREE</span>'
:'<span class="premium-badge">PREMIUM</span>'
}

<button class="btn"
onclick="openLesson(
${Number(l.id)},
${free},
${accessible}
)">

${accessible?"▶ Start":"🔒 Unlock"}

</button>

</div>

</article>`;

}).join("");

}catch(e){

console.error(e);

$("lessons").innerHTML=`

<div class="card">

<div class="card-top"></div>

<div class="card-body">

<div class="lesson-emoji">⚠️</div>

<h3>Unable to Load</h3>

<p>${esc(e.message)}</p>

<button class="btn"
onclick="loadLessons()">
🔄 Try Again
</button>

</div>

</div>`;

}

}


async function openLesson(id,free,accessible){

const logged=
$("membership").textContent!=="GUEST";

if(!logged){

login();
return;

}

if(!free&&!accessible){

location.href="/v2/pay.html";
return;

}

loadQuiz(id);

}


async function loadQuiz(id){

$("lessonArea").style.display="none";
$("quizArea").style.display="block";
$("hero").style.display="none";

$("quizArea").innerHTML=`

<div class="quiz-wrap">

<div class="quiz-card">

<p>Loading lesson...</p>

</div>

</div>`;

window.scrollTo({
top:0,
behavior:"smooth"
});

try{

const {r,data}=await get(
"/api/quiz?lesson="+
encodeURIComponent(id)+
"&_="+Date.now()
);

if(!r.ok||!data.success)
throw Error(
data.error||"Unable to load quiz"
);

currentLesson=data.lesson;
currentQuestions=data.questions||[];
currentQuestion=0;
answered=false;

if(!currentQuestions.length){

$("quizArea").innerHTML=`

<div class="quiz-wrap">

<div class="quiz-card">

<button class="btn light"
onclick="backLessons()">
← Lessons
</button>

<h2>${esc(currentLesson.title)}</h2>

<p>No questions are available.</p>

</div>

</div>`;

return;

}

renderQuestion();

}catch(e){

$("quizArea").innerHTML=`

<div class="quiz-wrap">

<div class="quiz-card">

<button class="btn light"
onclick="backLessons()">
← Lessons
</button>

<h2>⚠️ Unable to Load</h2>

<p>${esc(e.message)}</p>

</div>

</div>`;

}

}


function renderQuestion(){

const q=
currentQuestions[currentQuestion];

if(!q)return;

answered=false;

const num=currentQuestion+1;
const percent=
Math.round((currentQuestion/50)*100);

$("quizArea").innerHTML=`

<div class="quiz-wrap">

<div class="quiz-card">

<div class="quiz-head">

<button class="btn light"
onclick="backLessons()">
← Lessons
</button>

<strong>
${esc(currentLesson.title)}
</strong>

</div>

<div class="progress">

<div class="progress-bar"
style="width:${percent}%">
</div>

</div>

<div class="question-count">
Question ${num}/50
</div>

<div class="question">
${esc(q.question)}
</div>

<div class="options">

<button class="option"
onclick="answerQuestion(this,'A')">
A. ${esc(q.option_a)}
</button>

<button class="option"
onclick="answerQuestion(this,'B')">
B. ${esc(q.option_b)}
</button>

<button class="option"
onclick="answerQuestion(this,'C')">
C. ${esc(q.option_c)}
</button>

<button class="option"
onclick="answerQuestion(this,'D')">
D. ${esc(q.option_d)}
</button>

</div>

<div id="answerResult"></div>

</div>
</div>`;

}


async function answerQuestion(button,answer){

if(answered)return;

answered=true;

const options=
document.querySelectorAll(".option");

options.forEach(x=>{
x.classList.add("disabled");
});

const q=
currentQuestions[currentQuestion];

try{

const {r,data}=await get(
"/api/quiz/answer",
{
method:"POST",

headers:{
"Content-Type":"application/json"
},

body:JSON.stringify({

question_id:q.id,
selected_answer:answer

})

});

if(!r.ok||!data.success){

answered=false;

options.forEach(x=>{
x.classList.remove("disabled");
});

notice(
data.error||
"Unable to submit answer"
);

return;

}

const correct=!!data.correct;

const correctAnswer=
String(data.correct_answer||"")
.trim()
.toUpperCase();

options.forEach(x=>{

const a=
x.textContent.trim().charAt(0);

if(a===correctAnswer)
x.classList.add("correct");

});

if(correct)
button.classList.add("correct");
else
button.classList.add("wrong");


if(correct){

if(Number(data.xp_awarded||0)>0){

flyReward(
"+"+Number(data.xp_awarded)+" XP",
"xp"
);

}

if(Number(data.coins_awarded||0)>0){

flyReward(
"+"+Number(data.coins_awarded)+" 🪙",
"coins"
);

}

}


$("answerResult").innerHTML=`

<div class="result">

${
correct
?"<span style='color:#8fd3b5'>✅ Correct!</span>"
:"<span style='color:#edb9bf'>❌ Incorrect</span>"
}

<br>

Correct answer:
<b>${esc(correctAnswer)}</b>

<br>

+${Number(data.xp_awarded||0)} XP
&nbsp;
+${Number(data.coins_awarded||0)} Coins

</div>

${
data.explanation
?`<div class="explanation">
💡 ${esc(data.explanation)}
</div>`
:""
}

<div class="quiz-actions">

<button class="btn"
onclick="nextQuestion()">

${
currentQuestion+1<50
?"Next Question →"
:"🏁 Finish Lesson"
}

</button>

</div>`;


if(data.xp!==undefined)
$("xp").textContent=
Number(data.xp||0);

if(data.coins!==undefined)
$("coins").textContent=
Number(data.coins||0);

if(data.questions_answered!==undefined){

updateLimitProgress(
data.questions_answered,
data.question_limit||
(data.membership==="premium"?1000:300)
);

}

}catch(e){

console.error(e);

answered=false;

options.forEach(x=>{
x.classList.remove("disabled");
});

notice(
"Connection error. Please try again."
);

}

}


function flyReward(text,type){

const el=
document.createElement("div");

el.textContent=text;

el.className=
"reward-fly "+
(type==="xp"
?"reward-xp"
:"reward-coins");

document.body.appendChild(el);

requestAnimationFrame(()=>{

el.style.top="22%";
el.style.opacity="0";
el.style.transform=
"translate(-50%,-50%) scale(1.35)";

});

setTimeout(()=>{
el.remove();
},950);

}


function nextQuestion(){

if(currentQuestion+1>=50){

$("quizArea").innerHTML=`

<div class="quiz-wrap">

<div class="quiz-card"
style="text-align:center">

<div style="font-size:45px">
🎉
</div>

<h2>Lesson Complete!</h2>

<p>
You completed
${esc(currentLesson.title)}.
</p>

<button class="btn"
onclick="backLessons()">
📚 Back to Lessons
</button>

</div>

</div>`;

loadUser();

return;

}

currentQuestion++;

renderQuestion();

window.scrollTo({
top:0,
behavior:"smooth"
});

}


function backLessons(){

currentLesson=null;
currentQuestions=[];
currentQuestion=0;
answered=false;

$("quizArea").style.display="none";
$("lessonArea").style.display="block";
$("hero").style.display="block";

$("menu").classList.remove("show");

loadUser();
loadLessons();

window.scrollTo({
top:0,
behavior:"smooth"
});

}


(function(){

$("year").textContent=
new Date().getFullYear();

const p=
new URLSearchParams(location.search);

referral=
(p.get("ref")||"")
.trim()
.toUpperCase();

loadUser();
loadLessons();

})();

</script>

</body>
</html>