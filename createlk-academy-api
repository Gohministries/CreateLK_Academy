/* =========================================================
   MAIN WORKER
========================================================= */

export default {

  async fetch(request, env) {

    if (
      request.method === "OPTIONS"
    ) {
      return cors();
    }

    const url =
      new URL(request.url);

    const path =
      url.pathname.replace(/\/+$/, "") || "/";

    try {

      /* HEALTH */

      if (
        path === "/" ||
        path === "/api"
      ) {
        return health(env);
      }


      /* REGISTER */

      if (
        path === "/api/register" &&
        request.method === "POST"
      ) {
        return register(request, env);
      }


      /* LOGIN */

      if (
        path === "/api/login" &&
        request.method === "POST"
      ) {
        return login(request, env);
      }


      /* STUDENT */

      if (
        path === "/api/student" &&
        request.method === "GET"
      ) {
        return getStudent(request, env);
      }


      /* MEMBERSHIP */

      if (
        path === "/api/membership" &&
        request.method === "GET"
      ) {
        return membership(request, env);
      }


      /* MCQ */

      if (
        path === "/api/mcq" &&
        request.method === "GET"
      ) {
        return mcq(request, env);
      }


      /* CERTIFICATES */

      if (
        path === "/api/certificates" &&
        request.method === "GET"
      ) {
        return certificates(request, env);
      }


      /* NOT FOUND */

      return json({
        success: false,
        message: "API endpoint not found.",
        path: path
      }, 404);


    } catch (error) {

      console.error(
        "API ERROR:",
        error
      );

      return json({
        success: false,
        message: "Server error.",
        error: error.message
      }, 500);
    }
  }
};

