const ALLOWED_ORIGIN = "https://createlk.com";
const PAYHERE_ID = "257692";
const PREMIUM_AMOUNT = 1500;
const CURRENCY = "LKR";

function cors() {
  return {
    "Access-Control-Allow-Origin": ALLOWED_ORIGIN,
    "Access-Control-Allow-Methods": "GET,POST,OPTIONS",
    "Access-Control-Allow-Headers": "Content-Type,X-Admin-Key",
    "Access-Control-Max-Age": "86400"
  };
}

function json(data, status = 200) {
  return new Response(JSON.stringify(data), {
    status,
    headers: {
      "Content-Type": "application/json",
      ...cors()
    }
  });
}

async function md5(text) {
  const data = new TextEncoder().encode(text);
  const hash = await crypto.subtle.digest("MD5", data);
  return Array.from(new Uint8Array(hash))
    .map(b => b.toString(16).padStart(2, "0"))
    .join("")
    .toUpperCase();
}

async function hashPassword(password) {
  const data = new TextEncoder().encode(password);
  const hash = await crypto.subtle.digest("SHA-256", data);

  return Array.from(new Uint8Array(hash))
    .map(b => b.toString(16).padStart(2, "0"))
    .join("");
}

async function verifyPassword(password, hash) {
  return await hashPassword(password) === hash;
}

function token() {
  return crypto.randomUUID() + "-" + crypto.randomUUID();
}

function active(status, expiry) {
  if (String(status).toUpperCase() !== "ACTIVE") return false;
  if (!expiry) return true;
  return new Date(expiry) > new Date();
}

export default {

  async fetch(request, env) {

    const url = new URL(request.url);
    const path = url.pathname;
    const method = request.method;

    if (method === "OPTIONS") {
      return new Response(null, {
        status: 204,
        headers: cors()
      });
    }

    /* ===============================
       TEST
    =============================== */

    if (path === "/" && method === "GET") {
      return json({
        success: true,
        worker: "createlk-academy-api",
        message: "CreateLK Academy API is working"
      });
    }

    /* ===============================
       REGISTER
    =============================== */

    if (path === "/api/register" && method === "POST") {
      try {

        const b = await request.json();

        const first = String(b.first_name || "").trim();
        const last = String(b.last_name || "").trim();
        const email = String(b.email || "").trim().toLowerCase();
        const phone = String(b.phone || "").trim();
        const password = String(b.password || "");

        if (!first || !last || !email || !password) {
          return json({
            success: false,
            message: "Please complete all required fields."
          }, 400);
        }

        if (password.length < 6) {
          return json({
            success: false,
            message: "Password must contain at least 6 characters."
          }, 400);
        }

        const exists = await env.DB.prepare(`
          SELECT id FROM students WHERE email=? LIMIT 1
        `).bind(email).first();

        if (exists) {
          return json({
            success: false,
            message: "An account with this email already exists."
          }, 409);
        }

        const passwordHash = await hashPassword(password);

        const r = await env.DB.prepare(`
          INSERT INTO students
          (first_name,last_name,email,phone,password_hash,membership_status)
          VALUES (?,?,?,?,?,'NONE')
        `).bind(
          first,
          last,
          email,
          phone,
          passwordHash
        ).run();

        const id = r.meta.last_row_id;

        return json({
          success: true,
          message: "Account created successfully.",
          student: {
            id,
            student_id: id,
            first_name: first,
            last_name: last,
            email,
            phone,
            membership_status: "NONE"
          }
        });

      } catch (e) {
        return json({
          success: false,
          message: "Registration failed.",
          error: e.message
        }, 500);
      }
    }

    /* ===============================
       LOGIN
    =============================== */

    if (path === "/api/login" && method === "POST") {
      try {

        const b = await request.json();

        const email = String(b.email || "")
          .trim()
          .toLowerCase();

        const password = String(b.password || "");

        const student = await env.DB.prepare(`
          SELECT * FROM students
          WHERE email=?
          LIMIT 1
        `).bind(email).first();

        if (!student) {
          return json({
            success: false,
            message: "Invalid email or password."
          }, 401);
        }

        if (!await verifyPassword(
          password,
          student.password_hash
        )) {
          return json({
            success: false,
            message: "Invalid email or password."
          }, 401);
        }

        return json({
          success: true,
          token: token(),
          student: {
            id: student.id,
            student_id: student.id,
            first_name: student.first_name,
            last_name: student.last_name,
            email: student.email,
            phone: student.phone,
            membership_status:
              student.membership_status || "NONE",
            membership_expiry:
              student.membership_expiry || null
          }
        });

      } catch (e) {
        return json({
          success: false,
          message: "Login failed.",
          error: e.message
        }, 500);
      }
    }

    /* ===============================
       STUDENT
    =============================== */

    if (path === "/api/student" && method === "GET") {
      try {

        const id = Number(
          url.searchParams.get("id") ||
          url.searchParams.get("student_id")
        );

        const student = await env.DB.prepare(`
          SELECT
            id,
            first_name,
            last_name,
            email,
            phone,
            membership_status,
            membership_expiry,
            created_at
          FROM students
          WHERE id=?
          LIMIT 1
        `).bind(id).first();

        if (!student) {
          return json({
            success: false,
            message: "Student not found."
          }, 404);
        }

        return json({
          success: true,
          student: {
            ...student,
            student_id: student.id
          }
        });

      } catch (e) {
        return json({
          success: false,
          message: "Unable to load student."
        }, 500);
      }
    }

    /* ===============================
       MEMBERSHIP
    =============================== */

    if (path === "/api/membership" && method === "GET") {
      try {

        const id = Number(
          url.searchParams.get("student_id")
        );

        const student = await env.DB.prepare(`
          SELECT
            id,
            membership_status,
            membership_expiry
          FROM students
          WHERE id=?
          LIMIT 1
        `).bind(id).first();

        if (!student) {
          return json({
            success: false,
            message: "Student not found."
          }, 404);
        }

        let status =
          String(student.membership_status || "NONE")
            .toUpperCase();

        const expiry =
          student.membership_expiry || null;

        if (
          status === "ACTIVE" &&
          expiry &&
          new Date(expiry) <= new Date()
        ) {
          status = "EXPIRED";

          await env.DB.prepare(`
            UPDATE students
            SET membership_status='EXPIRED'
            WHERE id=?
          `).bind(id).run();
        }

        return json({
          success: true,
          membership: {
            status,
            expiry,
            active: status === "ACTIVE"
          }
        });

      } catch (e) {
        return json({
          success: false,
          message: "Unable to load membership."
        }, 500);
      }
    }

    /* ===============================
       PAYHERE CREATE PAYMENT
    =============================== */

    if (
      path === "/api/payhere/create" &&
      method === "POST"
    ) {
      try {

        const b = await request.json();

        const studentId = Number(b.student_id);

        const student = await env.DB.prepare(`
          SELECT
            id,
            first_name,
            last_name,
            email,
            phone
          FROM students
          WHERE id=?
          LIMIT 1
        `).bind(studentId).first();

        if (!student) {
          return json({
            success: false,
            message: "Student not found."
          }, 404);
        }

        const orderId =
          "CLA-" +
          Date.now() +
          "-" +
          student.id;

        const amount =
          PREMIUM_AMOUNT.toFixed(2);

        const secretHash =
          await md5(env.PAYHERE_MERCHANT_SECRET);

        const hash =
          await md5(
            PAYHERE_ID +
            orderId +
            amount +
            CURRENCY +
            secretHash
          );

        await env.DB.prepare(`
          INSERT INTO payhere_payments
          (
            student_id,
            payment_id,
            order_id,
            amount,
            currency,
            status
          )
          VALUES (?, '', ?, ?, ?, 'INITIATED')
        `).bind(
          student.id,
          orderId,
          PREMIUM_AMOUNT,
          CURRENCY
        ).run();

        return json({
          success: true,

          merchant_id: PAYHERE_ID,

          order_id: orderId,

          amount,

          currency: CURRENCY,

          hash,

          first_name: student.first_name,

          last_name: student.last_name,

          email: student.email,

          phone: student.phone,

          items: "CreateLK Academy Premium - 30 Days",

          return_url:
            "https://createlk.com/payment-return.html",

          cancel_url:
            "https://createlk.com/payment-cancel.html",

          notify_url:
            "https://createlk-academy-api.createlk.workers.dev/api/payhere/notify"
        });

      } catch (e) {
        return json({
          success: false,
          message: "Unable to create PayHere payment.",
          error: e.message
        }, 500);
      }
    }

    /* ===============================
       PAYHERE NOTIFY
    =============================== */

    if (
      path === "/api/payhere/notify" &&
      method === "POST"
    ) {
      try {

        const form = await request.formData();

        const merchantId =
          String(form.get("merchant_id") || "");

        const orderId =
          String(form.get("order_id") || "");

        const paymentId =
          String(form.get("payment_id") || "");

        const amount =
          String(form.get("payhere_amount") || "");

        const currency =
          String(form.get("payhere_currency") || "");

        const statusCode =
          String(form.get("status_code") || "");

        const received =
          String(form.get("md5sig") || "");

        if (merchantId !== PAYHERE_ID) {
          return new Response("INVALID MERCHANT", {
            status: 400
          });
        }

        const secretHash =
          await md5(env.PAYHERE_MERCHANT_SECRET);

        const local =
          await md5(
            merchantId +
            orderId +
            amount +
            currency +
            statusCode +
            secretHash
          );

        if (local !== received.toUpperCase()) {
          return new Response("INVALID SIGNATURE", {
            status: 400
          });
        }

        const payment =
          await env.DB.prepare(`
            SELECT *
            FROM payhere_payments
            WHERE order_id=?
            LIMIT 1
          `).bind(orderId).first();

        if (!payment) {
          return new Response("ORDER NOT FOUND", {
            status: 404
          });
        }

        await env.DB.prepare(`
          UPDATE payhere_payments
          SET
            payment_id=?,
            status=?
          WHERE order_id=?
        `).bind(
          paymentId,
          statusCode === "2"
            ? "SUCCESS"
            : statusCode === "0"
              ? "PENDING"
              : "FAILED",
          orderId
        ).run();

        /* SUCCESS */

        if (statusCode === "2") {

          const expiry = new Date();

          expiry.setDate(
            expiry.getDate() + 30
          );

          const expiresAt =
            expiry.toISOString();

          await env.DB.prepare(`
            UPDATE students
            SET
              membership_status='ACTIVE',
              membership_expiry=?,
              updated_at=CURRENT_TIMESTAMP
            WHERE id=?
          `).bind(
            expiresAt,
            payment.student_id
          ).run();

          await env.DB.prepare(`
            INSERT INTO memberships
            (
              student_id,
              status,
              started_at,
              expires_at
            )
            VALUES
            (?, 'ACTIVE', CURRENT_TIMESTAMP, ?)
          `).bind(
            payment.student_id,
            expiresAt
          ).run();

        }

        return new Response("OK", {
          status: 200
        });

      } catch (e) {

        console.error(
          "PAYHERE NOTIFY:",
          e
        );

        return new Response("ERROR", {
          status: 500
        });
      }
    }

    /* ===============================
       PAYMENT STATUS
    =============================== */

    if (
      path === "/api/payhere/status" &&
      method === "GET"
    ) {
      try {

        const studentId = Number(
          url.searchParams.get("student_id")
        );

        const payment =
          await env.DB.prepare(`
            SELECT *
            FROM payhere_payments
            WHERE student_id=?
            ORDER BY id DESC
            LIMIT 1
          `).bind(studentId).first();

        return json({
          success: true,
          payment: payment || null
        });

      } catch (e) {
        return json({
          success: false,
          message: "Unable to load payment status."
        }, 500);
      }
    }

    /* ===============================
       MCQ GET
    =============================== */

    if (path === "/api/mcq" && method === "GET") {
      try {

        const studentId = Number(
          url.searchParams.get("student_id")
        );

        const student =
          await env.DB.prepare(`
            SELECT
              membership_status,
              membership_expiry
            FROM students
            WHERE id=?
          `).bind(studentId).first();

        if (!student ||
            !active(
              student.membership_status,
              student.membership_expiry
            )) {
          return json({
            success: false,
            message: "Premium membership is required."
          }, 403);
        }

        const q =
          await env.DB.prepare(`
            SELECT
              id,
              question,
              option_a,
              option_b,
              option_c,
              option_d,
              category,
              difficulty
            FROM mcq_questions
            ORDER BY RANDOM()
            LIMIT 1
          `).first();

        if (!q) {
          return json({
            success: false,
            message: "No MCQ questions available."
          }, 404);
        }

        const stats =
          await env.DB.prepare(`
            SELECT
              COUNT(*) AS total_questions,
              COALESCE(SUM(correct),0)
              AS correct_answers
            FROM mcq_attempts
            WHERE student_id=?
          `).bind(studentId).first();

        return json({
          success: true,

          question: {
            id: q.id,
            question: q.question,
            options: [
              q.option_a,
              q.option_b,
              q.option_c,
              q.option_d
            ],
            category: q.category,
            difficulty: q.difficulty
          },

          total_questions:
            Number(stats?.total_questions || 0),

          correct_answers:
            Number(stats?.correct_answers || 0)
        });

      } catch (e) {
        return json({
          success: false,
          message: "Unable to load MCQ."
        }, 500);
      }
    }

    /* ===============================
       MCQ POST
    =============================== */

    if (path === "/api/mcq" && method === "POST") {
      try {

        const b = await request.json();

        const studentId = Number(b.student_id);
        const questionId = Number(b.question_id);
        const answer = Number(b.answer);

        const q =
          await env.DB.prepare(`
            SELECT
              id,
              correct_answer
            FROM mcq_questions
            WHERE id=?
            LIMIT 1
          `).bind(questionId).first();

        if (!q) {
          return json({
            success: false,
            message: "Question not found."
          }, 404);
        }

        const correct =
          answer === Number(q.correct_answer);

        await env.DB.prepare(`
          INSERT INTO mcq_attempts
          (
            student_id,
            question_id,
            selected_answer,
            correct
          )
          VALUES (?, ?, ?, ?)
        `).bind(
          studentId,
          questionId,
          answer,
          correct ? 1 : 0
        ).run();

        const stats =
          await env.DB.prepare(`
            SELECT
              COUNT(*) AS total_questions,
              COALESCE(SUM(correct),0)
              AS correct_answers
            FROM mcq_attempts
            WHERE student_id=?
          `).bind(studentId).first();

        return json({
          success: true,
          correct,
          correct_answer:
            Number(q.correct_answer),
          total_questions:
            Number(stats?.total_questions || 0),
          correct_answers:
            Number(stats?.correct_answers || 0)
        });

      } catch (e) {
        return json({
          success: false,
          message: "Unable to submit answer.",
          error: e.message
        }, 500);
      }
    }

    /* ===============================
       CERTIFICATES
    =============================== */

    if (
      path === "/api/certificates" &&
      method === "GET"
    ) {
      try {

        const studentId = Number(
          url.searchParams.get("student_id")
        );

        const r =
          await env.DB.prepare(`
            SELECT *
            FROM certificates
            WHERE student_id=?
            ORDER BY id DESC
          `).bind(studentId).all();

        return json({
          success: true,
          certificates: r.results || []
        });

      } catch (e) {
        return json({
          success: false,
          message: "Unable to load certificates."
        }, 500);
      }
    }

    return json({
      success: false,
      message: "API endpoint not found.",
      path
    }, 404);
  }
};