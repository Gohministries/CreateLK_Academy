const ALLOWED_ORIGIN = "https://createlk.com";
const PAYHERE_ID = "257692";
const AMOUNT = 1500;
const CURRENCY = "LKR";
const PREMIUM_DAYS = 30;

const cors = () => ({
  "Access-Control-Allow-Origin": ALLOWED_ORIGIN,
  "Access-Control-Allow-Methods": "GET,POST,OPTIONS",
  "Access-Control-Allow-Headers": "Content-Type,X-Admin-Key"
});

const json = (data, status = 200) =>
  new Response(JSON.stringify(data), {
    status,
    headers: {
      "Content-Type": "application/json;charset=UTF-8",
      ...cors()
    }
  });

/* ---------- MD5 ---------- */

function md5(s) {
  function r(n,c){return(n<<c)|(n>>>(32-c))}
  function a(x,y){return(x+y)|0}
  const k=[0xd76aa478,0xe8c7b756,0x242070db,0xc1bdceee,0xf57c0faf,0x4787c62a,0xa8304613,0xfd469501,0x698098d8,0x8b44f7af,0xffff5bb1,0x895cd7be,0x6b901122,0xfd987193,0xa679438e,0x49b40821,0xf61e2562,0xc040b340,0x265e5a51,0xe9b6c7aa,0xd62f105d,0x2441453,0xd8a1e681,0xe7d3fbc8,0x21e1cde6,0xc33707d6,0xf4d50d87,0x455a14ed,0xa9e3e905,0xfcefa3f8,0x676f02d9,0x8d2a4c8a,0xfffa3942,0x8771f681,0x6d9d6122,0xfde5380c,0xa4beea44,0x4bdecfa9,0xf6bb4b60,0xbebfbc70,0x289b7ec6,0xeaa127fa,0xd4ef3085,0x4881d05,0xd9d4d039,0xe6db99e5,0x1fa27cf8,0xc4ac5665,0xf4292244,0x432aff97,0xab9423a7,0xfc93a039,0x655b59c3,0x8f0ccc92,0xffeff47d,0x85845dd1,0x6fa87e4f,0xfe2ce6e0,0xa3014314,0x4e0811a1,0xf7537e82,0xbd3af235,0x2ad7d2bb,0xeb86d391];
  const sh=[7,12,17,22,5,9,14,20,4,11,16,23,6,10,15,21];
  let b=new TextEncoder().encode(s),l=b.length;
  let x=[];
  for(let i=0;i<l;i++)x[i>>2]|=b[i]<<((i%4)*8);
  x[l>>2]|=0x80<<((l%4)*8);
  x[((l+8)>>6<<4)+14]=l*8;
  let A=0x67452301,B=0xefcdab89,C=0x98badcfe,D=0x10325476;
  for(let i=0;i<x.length;i+=16){
    let aa=A,bb=B,cc=C,dd=D;
    for(let j=0;j<64;j++){
      let F,g;
      if(j<16){F=(B&C)|(~B&D);g=j}
      else if(j<32){F=(D&B)|(~D&C);g=(5*j+1)%16}
      else if(j<48){F=B^C^D;g=(3*j+5)%16}
      else{F=C^(B|~D);g=(7*j)%16}
      let q=a(a(a(A,F),x[i+g]|0),k[j]);
      let z=j<16?sh[j%4]:j<32?sh[4+j%4]:j<48?sh[8+j%4]:sh[12+j%4];
      A=D;D=C;C=B;B=a(B,r(q,z));
    }
    A=a(A,aa);B=a(B,bb);C=a(C,cc);D=a(D,dd);
  }
  return [A,B,C,D].map(n=>
    [0,8,16,24].map(i=>
      ((n>>i)&255).toString(16).padStart(2,"0")
    ).join("")
  ).join("").toUpperCase();
}

/* ---------- Password ---------- */

async function sha256(text){
  const h=await crypto.subtle.digest(
    "SHA-256",
    new TextEncoder().encode(text)
  );
  return [...new Uint8Array(h)]
    .map(x=>x.toString(16).padStart(2,"0"))
    .join("");
}

function active(status,expiry){
  return String(status).toUpperCase()==="ACTIVE" &&
    (!expiry || new Date(expiry)>new Date());
}

function expiryFrom(old){
  let d=new Date();
  if(old && new Date(old)>d)d=new Date(old);
  d.setDate(d.getDate()+PREMIUM_DAYS);
  return d.toISOString();
}

/* ---------- Worker ---------- */

export default {
async fetch(request,env){

  const u=new URL(request.url);
  const p=u.pathname;
  const m=request.method;

  if(m==="OPTIONS")
    return new Response(null,{status:204,headers:cors()});

  /* TEST */

  if(p==="/"&&m==="GET")
    return json({
      success:true,
      worker:"createlk-academy-api",
      message:"CreateLK Academy API is working"
    });

  /* REGISTER */

  if(p==="/api/register"&&m==="POST"){
    try{
      const b=await request.json();

      const first=String(b.first_name||b.firstName||"").trim();
      const last=String(b.last_name||b.lastName||"").trim();
      const email=String(b.email||"").trim().toLowerCase();
      const phone=String(b.phone||"").trim();
      const password=String(b.password||"");

      if(!first||!last||!email||password.length<6)
        return json({
          success:false,
          message:"Please complete the required fields."
        },400);

      const old=await env.DB.prepare(
        "SELECT id FROM students WHERE email=? LIMIT 1"
      ).bind(email).first();

      if(old)
        return json({
          success:false,
          message:"Email already registered."
        },409);

      const hash=await sha256(password);

      const r=await env.DB.prepare(`
        INSERT INTO students
        (first_name,last_name,email,phone,password_hash,membership_status)
        VALUES(?,?,?,?,?,'NONE')
      `).bind(
        first,last,email,phone,hash
      ).run();

      const id=r.meta.last_row_id;

      return json({
        success:true,
        student:{
          id,
          student_id:id,
          first_name:first,
          last_name:last,
          email,
          phone,
          membership_status:"NONE",
          membership_expiry:null
        }
      });

    }catch(e){
      return json({
        success:false,
        message:"Registration failed."
      },500);
    }
  }

  /* LOGIN */

  if(p==="/api/login"&&m==="POST"){
    try{
      const b=await request.json();
      const email=String(b.email||"").trim().toLowerCase();
      const password=String(b.password||"");

      const s=await env.DB.prepare(
        "SELECT * FROM students WHERE email=? LIMIT 1"
      ).bind(email).first();

      if(!s||await sha256(password)!==s.password_hash)
        return json({
          success:false,
          message:"Invalid email or password."
        },401);

      return json({
        success:true,
        token:crypto.randomUUID(),
        student:{
          id:s.id,
          student_id:s.id,
          first_name:s.first_name,
          last_name:s.last_name,
          email:s.email,
          phone:s.phone,
          membership_status:s.membership_status||"NONE",
          membership_expiry:s.membership_expiry||null
        }
      });

    }catch(e){
      return json({
        success:false,
        message:"Login failed."
      },500);
    }
  }

  /* STUDENT */

  if(p==="/api/student"&&m==="GET"){
    const id=Number(
      u.searchParams.get("id")||
      u.searchParams.get("student_id")
    );

    if(!id)
      return json({
        success:false,
        message:"Student ID required."
      },400);

    const s=await env.DB.prepare(`
      SELECT id,first_name,last_name,email,phone,
             membership_status,membership_expiry,created_at
      FROM students WHERE id=? LIMIT 1
    `).bind(id).first();

    if(!s)
      return json({
        success:false,
        message:"Student not found."
      },404);

    return json({
      success:true,
      student:{...s,student_id:s.id}
    });
  }

  /* MEMBERSHIP */

  if(p==="/api/membership"&&m==="GET"){
    const id=Number(
      u.searchParams.get("student_id")
    );

    const s=await env.DB.prepare(`
      SELECT membership_status,membership_expiry
      FROM students WHERE id=? LIMIT 1
    `).bind(id).first();

    if(!s)
      return json({
        success:false,
        message:"Student not found."
      },404);

    let status=String(
      s.membership_status||"NONE"
    ).toUpperCase();

    const expiry=s.membership_expiry||null;

    if(status==="ACTIVE"&&expiry&&
       new Date(expiry)<=new Date()){

      status="EXPIRED";

      await env.DB.prepare(`
        UPDATE students
        SET membership_status='EXPIRED'
        WHERE id=?
      `).bind(id).run();
    }

    return json({
      success:true,
      membership:{
        status,
        expiry,
        active:status==="ACTIVE"
      }
    });
  }

  /* PAYHERE CREATE */

  if(p==="/api/payhere/create"&&m==="POST"){
    try{
      const b=await request.json();
      const id=Number(b.student_id);

      const s=await env.DB.prepare(`
        SELECT id,first_name,last_name,email,phone
        FROM students WHERE id=? LIMIT 1
      `).bind(id).first();

      if(!s)
        return json({
          success:false,
          message:"Student not found."
        },404);

      const order=
        "CLA-"+Date.now()+"-"+s.id;

      const amount=AMOUNT.toFixed(2);

      const secretHash=
        md5(env.PAYHERE_MERCHANT_SECRET);

      const hash=md5(
        PAYHERE_ID+
        order+
        amount+
        CURRENCY+
        secretHash
      );

      await env.DB.prepare(`
        INSERT INTO payhere_payments
        (student_id,payment_id,order_id,amount,currency,status)
        VALUES(?, '', ?, ?, ?, 'INITIATED')
      `).bind(
        s.id,order,AMOUNT,CURRENCY
      ).run();

      return json({
        success:true,
        merchant_id:PAYHERE_ID,
        order_id:order,
        amount,
        currency:CURRENCY,
        hash,
        first_name:s.first_name,
        last_name:s.last_name,
        email:s.email,
        phone:s.phone||"",
        address:"Sri Lanka",
        city:"Nuwara Eliya",
        country:"Sri Lanka",
        items:"CreateLK Academy Premium - 30 Days",
        return_url:"https://createlk.com/payment-return.html",
        cancel_url:"https://createlk.com/payment-cancel.html",
        notify_url:
          "https://createlk-academy-api.createlk.workers.dev/api/payhere/notify"
      });

    }catch(e){
      return json({
        success:false,
        message:"Unable to create payment.",
        error:e.message
      },500);
    }
  }

  /* PAYHERE NOTIFY */

  if(p==="/api/payhere/notify"&&m==="POST"){
    try{
      const f=await request.formData();

      const merchant=String(f.get("merchant_id")||"");
      const order=String(f.get("order_id")||"");
      const paymentId=String(f.get("payment_id")||"");
      const amount=String(f.get("payhere_amount")||"");
      const currency=String(f.get("payhere_currency")||"");
      const status=String(f.get("status_code")||"");
      const received=String(f.get("md5sig")||"").toUpperCase();

      if(merchant!==PAYHERE_ID)
        return new Response("INVALID MERCHANT",{status:400});

      const secretHash=
        md5(env.PAYHERE_MERCHANT_SECRET);

      const expected=md5(
        merchant+
        order+
        amount+
        currency+
        status+
        secretHash
      );

      if(expected!==received)
        return new Response("INVALID SIGNATURE",{status:400});

      if(
        currency!==CURRENCY||
        Number(amount).toFixed(2)!==AMOUNT.toFixed(2)
      )
        return new Response("INVALID PAYMENT",{status:400});

      const pay=await env.DB.prepare(`
        SELECT * FROM payhere_payments
        WHERE order_id=? LIMIT 1
      `).bind(order).first();

      if(!pay)
        return new Response("ORDER NOT FOUND",{status:404});

      if(pay.status==="SUCCESS")
        return new Response("OK");

      let state="FAILED";

      if(status==="2")state="SUCCESS";
      else if(status==="0")state="PENDING";
      else if(status==="-1")state="CANCELLED";
      else if(status==="-3")state="CHARGEDBACK";

      await env.DB.prepare(`
        UPDATE payhere_payments
        SET payment_id=?,status=?
        WHERE order_id=?
      `).bind(
        paymentId,state,order
      ).run();

      /* 30 DAYS PREMIUM */

      if(status==="2"){

        const s=await env.DB.prepare(`
          SELECT membership_expiry
          FROM students WHERE id=? LIMIT 1
        `).bind(pay.student_id).first();

        if(!s)
          return new Response("STUDENT NOT FOUND",{status:404});

        const expiry=expiryFrom(
          s.membership_expiry
        );

        await env.DB.prepare(`
          UPDATE students
          SET membership_status='ACTIVE',
              membership_expiry=?
          WHERE id=?
        `).bind(
          expiry,pay.student_id
        ).run();
      }

      return new Response("OK");

    }catch(e){
      console.error(e);
      return new Response("ERROR",{status:500});
    }
  }

  /* PAYMENT STATUS */

  if(p==="/api/payhere/status"&&m==="GET"){
    const id=Number(
      u.searchParams.get("student_id")
    );

    const pay=await env.DB.prepare(`
      SELECT * FROM payhere_payments
      WHERE student_id=?
      ORDER BY id DESC LIMIT 1
    `).bind(id).first();

    return json({
      success:true,
      payment:pay||null
    });
  }

  /* MCQ GET */

  if(p==="/api/mcq"&&m==="GET"){
    try{
      const id=Number(
        u.searchParams.get("student_id")
      );

      const s=await env.DB.prepare(`
        SELECT membership_status,membership_expiry
        FROM students WHERE id=? LIMIT 1
      `).bind(id).first();

      if(!s||!active(
        s.membership_status,
        s.membership_expiry
      ))
        return json({
          success:false,
          message:"Premium membership is required."
        },403);

      const q=await env.DB.prepare(`
        SELECT id,question,option_a,option_b,
               option_c,option_d,category,difficulty
        FROM mcq_questions
        ORDER BY RANDOM() LIMIT 1
      `).first();

      if(!q)
        return json({
          success:false,
          message:"No MCQ questions available."
        },404);

      const stats=await env.DB.prepare(`
        SELECT COUNT(*) total_questions,
               COALESCE(SUM(correct),0) correct_answers
        FROM mcq_attempts
        WHERE student_id=?
      `).bind(id).first();

      return json({
        success:true,
        question:{
          id:q.id,
          question:q.question,
          options:[
            q.option_a,
            q.option_b,
            q.option_c,
            q.option_d
          ],
          category:q.category,
          difficulty:q.difficulty
        },
        total_questions:Number(
          stats?.total_questions||0
        ),
        correct_answers:Number(
          stats?.correct_answers||0
        )
      });

    }catch(e){
      return json({
        success:false,
        message:"Unable to load MCQ."
      },500);
    }
  }

  /* MCQ ANSWER */

  if(p==="/api/mcq"&&m==="POST"){
    try{
      const b=await request.json();

      const studentId=Number(b.student_id);
      const questionId=Number(b.question_id);
      const answer=Number(b.answer);

      if(!studentId||!questionId||
         answer<0||answer>3)
        return json({
          success:false,
          message:"Invalid answer."
        },400);

      const q=await env.DB.prepare(`
        SELECT correct_answer
        FROM mcq_questions
        WHERE id=? LIMIT 1
      `).bind(questionId).first();

      if(!q)
        return json({
          success:false,
          message:"Question not found."
        },404);

      const correct=
        answer===Number(q.correct_answer);

      await env.DB.prepare(`
        INSERT INTO mcq_attempts
        (student_id,question_id,selected_answer,correct)
        VALUES(?,?,?,?)
      `).bind(
        studentId,
        questionId,
        answer,
        correct?1:0
      ).run();

      const stats=await env.DB.prepare(`
        SELECT COUNT(*) total_questions,
               COALESCE(SUM(correct),0) correct_answers
        FROM mcq_attempts
        WHERE student_id=?
      `).bind(studentId).first();

      return json({
        success:true,
        correct,
        correct_answer:Number(q.correct_answer),
        total_questions:Number(
          stats?.total_questions||0
        ),
        correct_answers:Number(
          stats?.correct_answers||0
        )
      });

    }catch(e){
      return json({
        success:false,
        message:"Unable to submit answer.",
        error:e.message
      },500);
    }
  }

  return json({
    success:false,
    message:"API endpoint not found."
  },404);
}
};