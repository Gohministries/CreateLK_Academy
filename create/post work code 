
const CORS_HEADERS = {
  "Access-Control-Allow-Origin": "https://createlk.com",
  "Access-Control-Allow-Methods": "GET,POST,PATCH,OPTIONS",
  "Access-Control-Allow-Headers": "Content-Type,Authorization",
  "Access-Control-Max-Age": "86400"
};

function response(data, status = 200) {
  return new Response(JSON.stringify(data), {
    status,
    headers: {
      ...CORS_HEADERS,
      "Content-Type": "application/json; charset=utf-8"
    }
  });
}

async function sha256(value) {
  const bytes = new TextEncoder().encode(value);
  const digest = await crypto.subtle.digest("SHA-256", bytes);
  return [...new Uint8Array(digest)]
    .map(b => b.toString(16).padStart(2, "0"))
    .join("");
}

async function getUser(req, env) {
  const auth = req.headers.get("Authorization") || "";
  const match = auth.match(/^Bearer\s+(.+)$/i);
  if (!match) return null;

  const tokenHash = await sha256(match[1]);

  return await env.DB.prepare(`
    SELECT u.*
    FROM user_sessions s
    JOIN users u ON u.id = s.user_id
    WHERE s.token_hash = ?
      AND s.expires_at > datetime('now')
    LIMIT 1
  `).bind(tokenHash).first();
}

function getCors(req) {
  const origin = req.headers.get("Origin") || "";
  const allowed = [
    "https://createlk.com",
    "https://www.createlk.com"
  ];

  return {
    "Access-Control-Allow-Origin": allowed.includes(origin)
      ? origin
      : "https://createlk.com",
    "Access-Control-Allow-Methods": "GET,POST,PATCH,OPTIONS",
    "Access-Control-Allow-Headers": "Content-Type,Authorization",
    "Access-Control-Max-Age": "86400",
    "Vary": "Origin"
  };
}

function json(req, data, status = 200) {
  return new Response(JSON.stringify(data), {
    status,
    headers: {
      ...getCors(req),
      "Content-Type": "application/json; charset=utf-8"
    }
  });
}

function error(req, message, status = 400) {
  return json(req, { success: false, error: message }, status);
}

export default {
  async fetch(req, env) {
    const url = new URL(req.url);
    const path = url.pathname.replace(/\/+$/, "") || "/";

    if (req.method === "OPTIONS") {
      return new Response(null, {
        status: 204,
        headers: getCors(req)
      });
    }

    try {
      if (!env.DB) return error(req, "Database binding DB is missing.", 500);

      // Check the existing login session.
      if (path === "/api/auth/me" && req.method === "GET") {
        const user = await getUser(req, env);
        if (!user) return error(req, "Login required or session expired.", 401);

        return json(req, {
          success: true,
          user: {
            id: user.id,
            name: user.name || "",
            email: user.email || "",
            picture: user.picture || "",
            role: user.role || "USER"
          }
        });
      }

      // Categories.
      if (path === "/api/categories" && req.method === "GET") {
        const result = await env.DB.prepare(`
          SELECT * FROM categories
          ORDER BY name
        `).all();

        return json(req, { success: true, categories: result.results || [] });
      }

      // Districts / locations.
      if (
        (path === "/api/locations" || path === "/api/districts") &&
        req.method === "GET"
      ) {
        const result = await env.DB.prepare(`
          SELECT * FROM districts
          ORDER BY name
        `).all();

        return json(req, { success: true, locations: result.results || [] });
      }

      // Cities in a district.
      if (path === "/api/cities" && req.method === "GET") {
        const districtId = url.searchParams.get("district_id");
        if (!districtId) return error(req, "district_id is required.");

        const result = await env.DB.prepare(`
          SELECT * FROM cities
          WHERE district_id = ?
          ORDER BY name
        `).bind(districtId).all();

        return json(req, { success: true, cities: result.results || [] });
      }

      // Public approved ads.
      if (path === "/api/listings" && req.method === "GET") {
        const limit = Math.min(
          Math.max(Number(url.searchParams.get("limit")) || 30, 1),
          100
        );

        const result = await env.DB.prepare(`
          SELECT a.*,
            c.name AS category_name,
            d.name AS district_name,
            ci.name AS city_name
          FROM ads a
          LEFT JOIN categories c ON c.id = a.category_id
          LEFT JOIN districts d ON d.id = a.district_id
          LEFT JOIN cities ci ON ci.id = a.city_id
          WHERE a.status = 'APPROVED'
            AND (a.expires_at IS NULL OR a.expires_at > datetime('now'))
          ORDER BY a.created_at DESC
          LIMIT ?
        `).bind(limit).all();

        return json(req, { success: true, listings: result.results || [] });
      }

      // All other routes below require an existing login.
      const user = await getUser(req, env);

      if (!user) {
        return error(req, "Login required or session expired.", 401);
      }

      // Upload an ad photo or payment slip.
      if (path === "/api/upload" && req.method === "POST") {
        if (!env.MEDIA) {
          return error(req, "R2 binding MEDIA is missing.", 500);
        }

        const form = await req.formData();
        const file = form.get("file");

        if (!file || typeof file.arrayBuffer !== "function") {
          return error(req, "Select a file to upload.");
        }

        if (file.size > 5 * 1024 * 1024) {
          return error(req, "Maximum file size is 5 MB.");
        }

        const allowedTypes = [
          "image/jpeg",
          "image/png",
          "image/webp",
          "image/gif",
          "application/pdf"
        ];

        if (!allowedTypes.includes(file.type)) {
          return error(req, "Unsupported file type.");
        }

        const extMap = {
          "image/jpeg": "jpg",
          "image/png": "png",
          "image/webp": "webp",
          "image/gif": "gif",
          "application/pdf": "pdf"
        };

        const purpose = form.get("purpose") === "payment-slip"
          ? "payment-slip"
          : "ad-photo";

        const key = `customer-uploads/${user.id}/${crypto.randomUUID()}.${extMap[file.type]}`;

        await env.MEDIA.put(key, await file.arrayBuffer(), {
          httpMetadata: { contentType: file.type },
          customMetadata: {
            userId: String(user.id),
            purpose
          }
        });

        return json(req, {
          success: true,
          key,
          purpose
        });
      }

      // Create an ad using the existing database tables.
      if (path === "/api/ads" && req.method === "POST") {
        const body = await req.json();

        const title = String(body.title || "").trim();
        const description = String(body.description || "").trim();
        const categoryId = body.category_id || body.categoryId;
        const districtId = body.district_id || body.districtId;
        const cityId = body.city_id || body.cityId;
        const photos = Array.isArray(body.photos)
          ? body.photos
          : Array.isArray(body.photoKeys)
            ? body.photoKeys
            : [];

        if (!title) return error(req, "Ad title is required.");
        if (!categoryId || !districtId || !cityId) {
          return error(req, "Category, district and city are required.");
        }
        if (photos.length < 1 || photos.length > 5) {
          return error(req, "Upload between 1 and 5 photos.");
        }

        if (!env.MEDIA) {
          return error(req, "R2 binding MEDIA is missing.", 500);
        }

        // Verify all photo keys belong to this logged-in user.
        for (const key of photos) {
          if (
            typeof key !== "string" ||
            !key.startsWith(`customer-uploads/${user.id}/`)
          ) {
            return error(req, "Invalid photo upload.");
          }

          const object = await env.MEDIA.head(key);
          if (!object || object.customMetadata?.userId !== String(user.id)) {
            return error(req, "Photo not found or does not belong to this account.");
          }
        }

        const packageCode = String(
          body.package || body.package_code || "FREE"
        ).toUpperCase();

        const prices = {
          FREE: 0,
          URGENT: 500,
          FEATURED: 500,
          TOP_AD: 500,
          ALL_3: 1500
        };

        if (!(packageCode in prices)) {
          return error(req, "Invalid advertising package.");
        }

        const paymentSlip = body.payment_slip_key ||
          body.paymentSlipKey ||
          body.payment_slip ||
          "";

        if (prices[packageCode] > 0) {
          if (!paymentSlip) {
            return error(req, "Upload your payment slip for this package.");
          }

          if (!paymentSlip.startsWith(`customer-uploads/${user.id}/`)) {
            return error(req, "Invalid payment slip.");
          }

          const slipObject = await env.MEDIA.head(paymentSlip);

          if (
            !slipObject ||
            slipObject.customMetadata?.userId !== String(user.id) ||
            slipObject.customMetadata?.purpose !== "payment-slip"
          ) {
            return error(req, "Payment slip is invalid.");
          }
        }

        // Enforce one free ad per user.
        if (packageCode === "FREE") {
          const freeClaim = await env.DB.prepare(`
            SELECT id FROM free_ad_claims
            WHERE user_id = ?
            LIMIT 1
          `).bind(user.id).first();

          if (freeClaim) {
            return error(req, "Your free ad has already been used.");
          }
        }

        const contactName = String(
          body.contact_name || body.contactName || user.name || ""
        ).trim();

        const phone = String(body.phone || body.contact_phone || "").trim();
        const whatsapp = String(body.whatsapp || "").trim();

        if (!phone) return error(req, "Contact phone number is required.");

        const now = new Date().toISOString();
        const expires = new Date(Date.now() + 30 * 86400000).toISOString();

        // Pending ads require admin approval.
        const insert = await env.DB.prepare(`
          INSERT INTO ads (
            user_id, title, description, category_id, district_id, city_id,
            contact_name, phone, whatsapp, package, price, status,
            created_at, expires_at
          ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'PENDING', ?, ?)
        `).bind(
          user.id,
          title,
          description,
          categoryId,
          districtId,
          cityId,
          contactName,
          phone,
          whatsapp,
          packageCode,
          prices[packageCode],
          now,
          expires
        ).run();

        const adId = insert.meta?.last_row_id;

        if (!adId) {
          return error(req, "Ad was not created. Check the ads table schema.", 500);
        }

        for (const key of photos) {
          await env.DB.prepare(`
            INSERT INTO ad_photos (ad_id, photo_key)
            VALUES (?, ?)
          `).bind(adId, key).run();
        }

        if (packageCode === "FREE") {
          await env.DB.prepare(`
            INSERT INTO free_ad_claims (user_id, ad_id, created_at)
            VALUES (?, ?, ?)
          `).bind(user.id, adId, now).run();
        } else {
          await env.DB.prepare(`
            INSERT INTO payments (
              user_id, ad_id, package, amount, payment_slip_key,
              status, created_at
            ) VALUES (?, ?, ?, ?, ?, 'PENDING', ?)
          `).bind(
            user.id,
            adId,
            packageCode,
            prices[packageCode],
            paymentSlip,
            now
          ).run();
        }

        return json(req, {
          success: true,
          message: "Ad submitted for review.",
          ad_id: adId,
          status: "PENDING"
        }, 201);
      }

      return error(req, "Route not found.", 404);
    } catch (err) {
      return json(req, {
        success: false,
        error: "Server error.",
        detail: err?.message || String(err)
      }, 500);
    }
  },

  async scheduled(event, env, ctx) {
    if (!env.DB) return;

    ctx.waitUntil(
      env.DB.prepare(`
        UPDATE ads
        SET status = 'EXPIRED'
        WHERE status = 'APPROVED'
          AND expires_at IS NOT NULL
          AND expires_at <= datetime('now')
      `).run()
    );
  }
};
