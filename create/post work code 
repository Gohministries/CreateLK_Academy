
const ALLOWED_ORIGINS = new Set([
  "https://createlk.com",
  "https://www.createlk.com"
]);

const MAX_FILE_SIZE = 5 * 1024 * 1024;
const MAX_PHOTOS = 5;

const PACKAGES = Object.freeze({
  FREE: 0,
  URGENT: 500,
  FEATURED: 500,
  TOP_AD: 500,
  ALL_3: 1500
});

const IMAGE_TYPES = new Set([
  "image/jpeg",
  "image/png",
  "image/webp",
  "image/gif"
]);

const MEDIA_BASE =
  "https://create-post.createlk.workers.dev/api/media?key=";

function corsHeaders(request) {
  const origin = request.headers.get("Origin") || "";
  return {
    "Access-Control-Allow-Origin":
      ALLOWED_ORIGINS.has(origin) ? origin : "https://createlk.com",
    "Access-Control-Allow-Methods": "GET, POST, OPTIONS",
    "Access-Control-Allow-Headers": "Content-Type, Authorization",
    "Access-Control-Max-Age": "86400",
    "Vary": "Origin"
  };
}

function json(request, data, status = 200) {
  return new Response(JSON.stringify(data), {
    status,
    headers: {
      ...corsHeaders(request),
      "Content-Type": "application/json; charset=utf-8",
      "Cache-Control": "no-store"
    }
  });
}

function fail(request, message, status = 400, detail) {
  return json(request, {
    success: false,
    error: message,
    ...(detail ? { detail } : {})
  }, status);
}

function clean(value, max = 3000) {
  return String(value ?? "").trim().slice(0, max);
}

function base64urlDecode(value) {
  const padded = value.replace(/-/g, "+").replace(/_/g, "/")
    + "=".repeat((4 - value.length % 4) % 4);
  return atob(padded);
}

async function signingKey(secret) {
  return crypto.subtle.importKey(
    "raw",
    new TextEncoder().encode(secret),
    { name: "HMAC", hash: "SHA-256" },
    false,
    ["verify"]
  );
}

// Uses the existing public Worker's HMAC token format.
async function verifyToken(token, secret) {
  if (!token || !secret) return null;

  const parts = token.split(".");
  if (parts.length !== 2) return null;

  try {
    const key = await signingKey(secret);
    const signatureBinary = base64urlDecode(parts[1]);
    const signature = Uint8Array.from(
      signatureBinary,
      char => char.charCodeAt(0)
    );

    const valid = await crypto.subtle.verify(
      "HMAC",
      key,
      signature,
      new TextEncoder().encode(parts[0])
    );

    if (!valid) return null;

    const payload = JSON.parse(base64urlDecode(parts[0]));

    // Existing tokens use exp in milliseconds.
    if (!payload.id || !payload.exp || payload.exp <= Date.now()) {
      return null;
    }

    return payload;
  } catch {
    return null;
  }
}

function bearer(request) {
  const match = (request.headers.get("Authorization") || "")
    .match(/^Bearer\s+(.+)$/i);
  return match ? match[1].trim() : "";
}

async function getUser(request, env) {
  const payload = await verifyToken(
    bearer(request),
    env.SESSION_SECRET
  );

  if (!payload) return null;

  return env.DB.prepare(`
    SELECT id, email, display_name, avatar_url, role
    FROM users
    WHERE id = ?
    LIMIT 1
  `).bind(payload.id).first();
}

function isAdmin(user, env) {
  if (!user) return false;

  const allowed = (env.ADMIN_EMAILS || "")
    .split(",")
    .map(value => value.trim().toLowerCase())
    .filter(Boolean);

  return String(user.role || "").toLowerCase() === "admin" ||
    allowed.includes(String(user.email || "").toLowerCase());
}

function fileExt(type) {
  return {
    "image/jpeg": "jpg",
    "image/png": "png",
    "image/webp": "webp",
    "image/gif": "gif",
    "application/pdf": "pdf"
  }[type] || "bin";
}

function mediaUrl(key) {
  return MEDIA_BASE + encodeURIComponent(key);
}

async function uploadFile(request, env, user) {
  let form;

  try {
    form = await request.formData();
  } catch {
    return fail(request, "Invalid file upload.");
  }

  const file = form.get("file");
  const purpose = clean(form.get("purpose") || "photo", 30);

  if (!(file instanceof File)) {
    return fail(request, "Choose a file to upload.");
  }

  if (file.size < 1 || file.size > MAX_FILE_SIZE) {
    return fail(request, "File size must be 5 MB or less.");
  }

  const isSlip = purpose === "payment_slip";

  if (isSlip) {
    if (file.type !== "application/pdf" &&
        !IMAGE_TYPES.has(file.type)) {
      return fail(
        request,
        "Payment slip must be a PDF, JPG, PNG, WEBP or GIF."
      );
    }
  } else if (purpose !== "photo" || !IMAGE_TYPES.has(file.type)) {
    return fail(
      request,
      "Photo must be JPG, PNG, WEBP or GIF."
    );
  }

  const key = [
    "customer-uploads",
    String(user.id),
    isSlip ? "slips" : "photos",
    crypto.randomUUID() + "." + fileExt(file.type)
  ].join("/");

  try {
    await env.MEDIA.put(key, file.stream(), {
      httpMetadata: { contentType: file.type },
      customMetadata: {
        userId: String(user.id),
        purpose: isSlip ? "payment_slip" : "photo"
      }
    });
  } catch (error) {
    console.error("R2 upload error:", error);
    return fail(request, "File upload failed.", 500, {
      message: String(error?.message || error)
    });
  }

  return json(request, {
    success: true,
    key,
    purpose: isSlip ? "payment_slip" : "photo"
  });
}

async function validateUpload(env, key, user, purpose) {
  if (!key) return false;

  const folder = purpose === "photo" ? "photos" : "slips";
  const prefix = `customer-uploads/${user.id}/${folder}/`;

  if (!key.startsWith(prefix)) return false;

  const object = await env.MEDIA.head(key);

  return !!object &&
    object.customMetadata?.userId === String(user.id) &&
    object.customMetadata?.purpose === purpose;
}

async function handleSubmit(request, env, user) {
  let body;

  try {
    body = await request.json();
  } catch {
    return fail(request, "Invalid JSON request.");
  }

  const title = clean(body.title, 120);
  const description = clean(body.description, 5000);
  const category = clean(body.category, 150);
  const district = clean(body.district, 100);
  const town = clean(body.town || body.city, 100);

  const sellerName = clean(
    body.seller_name ||
    body.contact_name ||
    user.display_name ||
    "",
    120
  );

  const phone = clean(body.contact_phone || body.phone, 30);
  const website = clean(body.website, 300);
  const packageCode = clean(
    body.package_code || "FREE",
    20
  ).toUpperCase();

  const photos = Array.isArray(body.photos)
    ? body.photos.map(value => clean(value, 500)).filter(Boolean)
    : [];

  const slipKey = clean(body.payment_slip_key, 500);

  if (title.length < 3 || description.length < 10) {
    return fail(
      request,
      "Enter a title and a description of at least 10 characters."
    );
  }

  if (!category || !district || !town) {
    return fail(request, "Choose a category, district and town.");
  }

  if (!/^[0-9+()\-\s]{7,20}$/.test(phone)) {
    return fail(request, "Enter a valid contact phone number.");
  }

  if (website) {
    try {
      const parsed = new URL(website);
      if (!["http:", "https:"].includes(parsed.protocol)) {
        throw new Error("Invalid protocol");
      }
    } catch {
      return fail(
        request,
        "Website must start with https:// or http://."
      );
    }
  }

  if (!Object.prototype.hasOwnProperty.call(PACKAGES, packageCode)) {
    return fail(request, "Invalid package.");
  }

  if (photos.length < 1 || photos.length > MAX_PHOTOS) {
    return fail(request, "Upload between 1 and 5 photos.");
  }

  const price = body.price_lkr === "" || body.price_lkr == null
    ? null
    : Number(body.price_lkr);

  if (price !== null &&
      (!Number.isFinite(price) || price < 0)) {
    return fail(request, "Enter a valid price.");
  }

  // Use the existing categories table.
  const categoryRow = await env.DB.prepare(`
    SELECT name, slug
    FROM categories
    WHERE is_active = 1
      AND (LOWER(name) = LOWER(?) OR LOWER(slug) = LOWER(?))
    LIMIT 1
  `).bind(category, category).first();

  if (!categoryRow) {
    return fail(
      request,
      "Selected category was not found in the database."
    );
  }

  // Use the existing districts table.
  const districtRow = await env.DB.prepare(`
    SELECT name
    FROM districts
    WHERE LOWER(name) = LOWER(?)
    LIMIT 1
  `).bind(district).first();

  if (!districtRow) {
    return fail(
      request,
      "Selected district was not found in the database."
    );
  }

  for (const key of photos) {
    if (!await validateUpload(env, key, user, "photo")) {
      return fail(
        request,
        "A photo is invalid or does not belong to your account."
      );
    }
  }

  const amount = PACKAGES[packageCode];

  if (amount > 0) {
    if (!await validateUpload(
      env, slipKey, user, "payment_slip"
    )) {
      return fail(request, "Upload a valid bank payment slip.");
    }

    const duplicate = await env.DB.prepare(`
      SELECT id
      FROM payments
      WHERE r2_key = ?
      LIMIT 1
    `).bind(slipKey).first();

    if (duplicate) {
      return fail(
        request,
        "This payment slip has already been submitted."
      );
    }
  } else {
    // Maximum 5 free ads in a rolling 30-day period.
    const claim = await env.DB.prepare(`
      SELECT COUNT(*) AS total
      FROM free_ad_claims_v2
      WHERE user_id = ?
        AND claimed_at > datetime('now', '-30 days')
    `).bind(String(user.id)).first();

    if (Number(claim?.total || 0) >= 5) {
      return fail(
        request,
        "You have reached your limit of 5 free ads in the last 30 days.",
        409
      );
    }
  }

  let listingId;

  try {
    const result = await env.DB.prepare(`
      INSERT INTO listings (
        user_id,
        title,
        description,
        price_lkr,
        category,
        district,
        town,
        image_url,
        contact_phone,
        seller_name,
        status,
        created_at
      ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'pending', datetime('now'))
    `).bind(
      user.id,
      title,
      description,
      price,
      categoryRow.name,
      districtRow.name,
      town,
      mediaUrl(photos[0]),
      phone,
      sellerName
    ).run();

    listingId = result.meta.last_row_id;

    if (listingId == null) {
      throw new Error("Could not retrieve the new listing ID.");
    }

    for (const key of photos) {
      await env.DB.prepare(`
        INSERT INTO listing_photos (listing_id, image_url)
        VALUES (?, ?)
      `).bind(
        listingId,
        mediaUrl(key)
      ).run();
    }

    if (amount === 0) {
      // One row per free ad; no unique user_id constraint.
      await env.DB.prepare(`
        INSERT INTO free_ad_claims_v2 (
          user_id, ad_id, claimed_at
        ) VALUES (?, ?, datetime('now'))
      `).bind(
        String(user.id),
        String(listingId)
      ).run();
    } else {
      await env.DB.prepare(`
        INSERT INTO payments (
          user_id,
          ad_id,
          package_code,
          amount_lkr,
          r2_key,
          status
        ) VALUES (?, ?, ?, ?, ?, 'PENDING')
      `).bind(
        String(user.id),
        String(listingId),
        packageCode,
        amount,
        slipKey
      ).run();
    }
  } catch (error) {
    console.error("Ad submission error:", error);

    return fail(request, "Unable to save your ad.", 500, {
      stage: "database-insert",
      message: String(error?.message || error)
    });
  }

  return json(request, {
    success: true,
    id: listingId,
    status: "pending",
    package_code: packageCode,
    amount_lkr: amount,
    message: amount > 0
      ? "Ad submitted. Payment and ad approval are pending."
      : "Free ad submitted for admin approval."
  }, 201);
}

async function handleMedia(request, env, url) {
  const key = clean(url.searchParams.get("key"), 500);

  if (!key.startsWith("customer-uploads/")) {
    return fail(request, "Invalid media key.", 400);
  }

  // Only serve photos attached to approved listings.
  const approved = await env.DB.prepare(`
    SELECT 1
    FROM listing_photos p
    JOIN listings l ON l.id = p.listing_id
    WHERE p.image_url = ?
      AND LOWER(l.status) = 'approved'
    LIMIT 1
  `).bind(mediaUrl(key)).first();

  if (!approved) {
    return fail(request, "Media not found.", 404);
  }

  const object = await env.MEDIA.get(key);
  if (!object) {
    return fail(request, "Media not found.", 404);
  }

  const headers = new Headers(corsHeaders(request));
  object.writeHttpMetadata(headers);
  headers.set("Cache-Control", "public, max-age=3600");
  headers.set("X-Content-Type-Options", "nosniff");

  return new Response(object.body, { headers });
}

async function adminQueue(request, env, user) {
  if (!isAdmin(user, env)) {
    return fail(request, "Admin access required.", 403);
  }

  const result = await env.DB.prepare(`
    SELECT
      l.id,
      l.title,
      l.description,
      l.price_lkr,
      l.category,
      l.district,
      l.town,
      l.contact_phone,
      l.seller_name,
      l.status,
      l.created_at,
      u.email,
      p.id AS payment_id,
      p.package_code,
      p.amount_lkr,
      p.r2_key AS payment_slip_key,
      p.status AS payment_status
    FROM listings l
    LEFT JOIN users u ON u.id = l.user_id
    LEFT JOIN payments p ON p.ad_id = CAST(l.id AS TEXT)
    WHERE LOWER(l.status) = 'pending'
    ORDER BY l.created_at ASC
    LIMIT 100
  `).all();

  return json(request, {
    success: true,
    items: result.results || []
  });
}

async function adminPaymentReview(request, env, user) {
  if (!isAdmin(user, env)) {
    return fail(request, "Admin access required.", 403);
  }

  let body;

  try {
    body = await request.json();
  } catch {
    return fail(request, "Invalid JSON request.");
  }

  const id = Number(body.id);
  const action = clean(body.action, 20).toUpperCase();

  if (!Number.isInteger(id) || id < 1 ||
      !["APPROVE", "REJECT"].includes(action)) {
    return fail(
      request,
      "Provide a payment id and action APPROVE or REJECT."
    );
  }

  const result = await env.DB.prepare(`
    UPDATE payments
    SET status = ?
    WHERE id = ? AND status = 'PENDING'
  `).bind(
    action === "APPROVE" ? "APPROVED" : "REJECTED",
    id
  ).run();

  if (!result.meta.changes) {
    return fail(request, "Pending payment was not found.", 404);
  }

  return json(request, {
    success: true,
    message: action === "APPROVE"
      ? "Payment approved. The ad can now be approved."
      : "Payment rejected."
  });
}

async function adminAdReview(request, env, user) {
  if (!isAdmin(user, env)) {
    return fail(request, "Admin access required.", 403);
  }

  let body;

  try {
    body = await request.json();
  } catch {
    return fail(request, "Invalid JSON request.");
  }

  const id = clean(body.id, 100);
  const action = clean(body.action, 20).toUpperCase();

  if (!id || !["APPROVE", "REJECT"].includes(action)) {
    return fail(
      request,
      "Provide an ad id and action APPROVE or REJECT."
    );
  }

  const listing = await env.DB.prepare(`
    SELECT id, user_id
    FROM listings
    WHERE id = ?
    LIMIT 1
  `).bind(id).first();

  if (!listing) {
    return fail(request, "Ad not found.", 404);
  }

  const payment = await env.DB.prepare(`
    SELECT id, status
    FROM payments
    WHERE ad_id = ?
    ORDER BY id DESC
    LIMIT 1
  `).bind(String(id)).first();

  // If a payment record exists, require approved payment first.
  if (payment && action === "APPROVE" &&
      payment.status !== "APPROVED") {
    return fail(
      request,
      "Approve the payment before approving this paid ad."
    );
  }

  await env.DB.prepare(`
    UPDATE listings
    SET status = ?
    WHERE id = ?
  `).bind(
    action === "APPROVE" ? "approved" : "rejected",
    id
  ).run();

  return json(request, {
    success: true,
    message: action === "APPROVE"
      ? "Ad approved."
      : "Ad rejected."
  });
}

export default {
  async fetch(request, env) {
    if (request.method === "OPTIONS") {
      return new Response(null, {
        status: 204,
        headers: corsHeaders(request)
      });
    }

    const url = new URL(request.url);
    const path = url.pathname.replace(/\/+$/, "") || "/";

    if (!env.DB || !env.MEDIA || !env.SESSION_SECRET) {
      return fail(
        request,
        "Worker configuration is incomplete. Check DB, MEDIA and SESSION_SECRET.",
        500
      );
    }

    try {
      if (request.method === "GET" && path === "/api/health") {
        return json(request, {
          success: true,
          service: "CreateLK Post API"
        });
      }

      if (request.method === "GET" &&
          path === "/api/categories") {
        const result = await env.DB.prepare(`
          SELECT id, name, slug
          FROM categories
          WHERE is_active = 1
          ORDER BY sort_order, name
        `).all();

        return json(request, {
          success: true,
          categories: result.results || []
        });
      }

      if (request.method === "GET" &&
          path === "/api/locations") {
        const result = await env.DB.prepare(`
          SELECT id, name, province
          FROM districts
          ORDER BY sort_order, name
        `).all();

        return json(request, {
          success: true,
          districts: result.results || []
        });
      }

      if (request.method === "GET" &&
          path === "/api/auth/me") {
        const user = await getUser(request, env);

        return user
          ? json(request, {
              success: true,
              user,
              isAdmin: isAdmin(user, env)
            })
          : fail(request, "Please sign in again.", 401);
      }

      if (request.method === "POST" &&
          path === "/api/upload") {
        const user = await getUser(request, env);
        if (!user) {
          return fail(request, "Please sign in again.", 401);
        }

        return await uploadFile(request, env, user);
      }

      if (request.method === "POST" &&
          path === "/api/ads") {
        const user = await getUser(request, env);
        if (!user) {
          return fail(request, "Please sign in again.", 401);
        }

        return await handleSubmit(request, env, user);
      }

      if (request.method === "GET" &&
          path === "/api/admin/ads") {
        const user = await getUser(request, env);
        if (!user) {
          return fail(request, "Please sign in again.", 401);
        }

        return await adminQueue(request, env, user);
      }

      if (request.method === "POST" &&
          path === "/api/admin/ads/review") {
        const user = await getUser(request, env);
        if (!user) {
          return fail(request, "Please sign in again.", 401);
        }

        return await adminAdReview(request, env, user);
      }

      if (request.method === "POST" &&
          path === "/api/admin/payments/review") {
        const user = await getUser(request, env);
        if (!user) {
          return fail(request, "Please sign in again.", 401);
        }

        return await adminPaymentReview(request, env, user);
      }

      if (request.method === "GET" &&
          path === "/api/media") {
        return await handleMedia(request, env, url);
      }

      return fail(request, "Endpoint not found.", 404);
    } catch (error) {
      console.error("CreateLK Post API error:", error);

      return fail(request, "Request failed.", 500, {
        path,
        name: error?.name || "Error",
        message: String(error?.message || error)
      });
    }
  }
};
