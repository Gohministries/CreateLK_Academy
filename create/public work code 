
const corsFor = req => {
  const origin = req.headers.get("Origin") || "";
  const allowed = [
    "https://createlk.com",
    "https://www.createlk.com"
  ].includes(origin);

  return {
    ...(origin && allowed ? {
      "Access-Control-Allow-Origin": origin
    } : {}),
    "Access-Control-Allow-Headers": "Content-Type, Authorization",
    "Access-Control-Allow-Methods": "GET, POST, PATCH, OPTIONS",
    "Access-Control-Max-Age": "86400",
    "Vary": "Origin"
  };
};

const json = (data, status = 200, headers = {}) =>
  Response.json(data, { status, headers });

const enc = new TextEncoder();
const uid = () => crypto.randomUUID();
const TYPES = ["product", "service", "job", "website", "other"];
const IMAGE_TYPES = ["image/jpeg", "image/png", "image/webp", "image/gif"];

function b64url(bytes) {
  let s = "";
  for (const b of bytes) s += String.fromCharCode(b);
  return btoa(s).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/g, "");
}

function unb64url(s) {
  s = s.replace(/-/g, "+").replace(/_/g, "/");
  s += "=".repeat((4 - s.length % 4) % 4);
  return Uint8Array.from(atob(s), c => c.charCodeAt(0));
}

async function signToken(payload, secret) {
  const body = b64url(enc.encode(JSON.stringify(payload)));
  const key = await crypto.subtle.importKey(
    "raw", enc.encode(secret),
    { name: "HMAC", hash: "SHA-256" }, false, ["sign"]
  );
  const sig = await crypto.subtle.sign("HMAC", key, enc.encode(body));
  return body + "." + b64url(new Uint8Array(sig));
}

async function getUser(req, env) {
  const auth = req.headers.get("Authorization") || "";
  if (!auth.startsWith("Bearer ") || !env.SESSION_SECRET || !env.DB) return null;

  try {
    const parts = auth.slice(7).split(".");
    if (parts.length !== 2) return null;
    const [body, signature] = parts;

    const key = await crypto.subtle.importKey(
      "raw", enc.encode(env.SESSION_SECRET),
      { name: "HMAC", hash: "SHA-256" }, false, ["verify"]
    );

    if (!await crypto.subtle.verify(
      "HMAC", key, unb64url(signature), enc.encode(body)
    )) return null;

    const payload = JSON.parse(new TextDecoder().decode(unb64url(body)));
    if (!payload.id || !payload.exp || payload.exp <= Date.now()) return null;

    return await env.DB.prepare(
      "SELECT id,email,name,role FROM users WHERE id=?"
    ).bind(payload.id).first();
  } catch {
    return null;
  }
}

async function readJson(req) {
  try { return await req.json(); } catch { return null; }
}

function text(value, max) {
  return typeof value === "string" ? value.trim().slice(0, max) : "";
}

function optionalId(value) {
  if (value === "" || value == null) return null;
  const n = Number(value);
  return Number.isSafeInteger(n) && n > 0 ? n : NaN;
}

function optionalMoney(value) {
  if (value === "" || value == null) return null;
  const n = Number(value);
  return Number.isFinite(n) && n >= 0 ? n : NaN;
}

async function handle(req, env) {
  const url = new URL(req.url);
  const path = url.pathname;
  const method = req.method;
  const headers = corsFor(req);

  if (method === "OPTIONS") return new Response(null, { status: 204, headers });
  if (!env.DB) return json({ error: "D1 binding DB is missing" }, 500, headers);

  try {
    if (path === "/api/health" && method === "GET") {
      return json({ ok: true, service: "createlk-api" }, 200, headers);
    }

    // Google login
    if (path === "/api/auth/google" && method === "POST") {
      if (!env.GOOGLE_CLIENT_ID || !env.SESSION_SECRET) {
        return json({ error: "Authentication is not configured" }, 500, headers);
      }

      const body = await readJson(req);
      const credential = body?.credential;
      if (typeof credential !== "string" || credential.length > 10000) {
        return json({ error: "Missing Google credential" }, 400, headers);
      }

      const response = await fetch(
        "https://oauth2.googleapis.com/tokeninfo?id_token=" +
        encodeURIComponent(credential)
      );
      const g = await response.json();

      if (!response.ok || g.aud !== env.GOOGLE_CLIENT_ID ||
          g.email_verified !== "true" || !g.email || !g.sub) {
        return json({ error: "Invalid Google login" }, 401, headers);
      }

      const email = String(g.email).toLowerCase();
      const name = text(g.name || email, 150);

      await env.DB.prepare(`
        INSERT OR IGNORE INTO users (email,name,google_id,email_verified)
        VALUES (?,?,?,1)
      `).bind(email, name, g.sub).run();

      await env.DB.prepare(`
        UPDATE users SET name=?,google_id=?,email_verified=1 WHERE email=?
      `).bind(name, g.sub, email).run();

      const user = await env.DB.prepare(
        "SELECT id,email,name,role FROM users WHERE email=?"
      ).bind(email).first();

      if (!user) return json({ error: "Could not create account" }, 500, headers);

      const token = await signToken({
        id: user.id,
        exp: Date.now() + 7 * 24 * 60 * 60 * 1000
      }, env.SESSION_SECRET);

      return json({ token, user }, 200, headers);
    }

    if (path === "/api/auth/me" && method === "GET") {
      const user = await getUser(req, env);
      return user
        ? json({ user }, 200, headers)
        : json({ error: "Login required" }, 401, headers);
    }

    if (path === "/api/categories" && method === "GET") {
      const r = await env.DB.prepare(
        "SELECT id,name,slug FROM categories ORDER BY name"
      ).all();
      return json(r.results, 200, headers);
    }

    if (path === "/api/locations" && method === "GET") {
      const r = await env.DB.prepare(
        "SELECT id,name FROM districts ORDER BY name"
      ).all();
      return json(r.results, 200, headers);
    }

    if (path === "/api/cities" && method === "GET") {
      const districtId = url.searchParams.get("district_id");
      const r = districtId
        ? await env.DB.prepare(
            "SELECT id,name,district_id FROM cities WHERE district_id=? ORDER BY name"
          ).bind(Number(districtId)).all()
        : await env.DB.prepare(
            "SELECT id,name,district_id FROM cities ORDER BY name LIMIT 500"
          ).all();
      return json(r.results, 200, headers);
    }

    // Public approved ads
    if (path === "/api/listings" && method === "GET") {
      const q = url.searchParams;
      const search = text(q.get("search") || "", 100);
      const category = q.get("category") || "";
      const location = q.get("location") || "";
      const minRaw = q.get("minPrice") || "";
      const maxRaw = q.get("maxPrice") || "";

      let sql = `
        SELECT a.id,a.title,a.description,a.price_lkr,a.salary_lkr,
          a.ad_type,a.website_url,a.condition,a.created_at,a.expires_at,
          a.seller_name,a.seller_phone,c.name AS category,
          c.slug AS category_slug,d.name AS district,ci.name AS city,
          (SELECT p.photo_url FROM ad_photos p
           WHERE p.ad_id=a.id ORDER BY p.id LIMIT 1) AS image_url
        FROM ads a
        LEFT JOIN categories c ON c.id=a.category_id
        LEFT JOIN districts d ON d.id=a.district_id
        LEFT JOIN cities ci ON ci.id=a.city_id
        WHERE a.status='APPROVED'
          AND COALESCE(a.expires_at,datetime(a.created_at,'+30 days'))>datetime('now')
      `;
      const args = [];

      if (search) {
        sql += " AND (a.title LIKE ? OR a.description LIKE ?)";
        args.push(`%${search}%`, `%${search}%`);
      }
      if (category) {
        sql += " AND (c.slug=? OR CAST(c.id AS TEXT)=?)";
        args.push(category, category);
      }
      if (location) {
        sql += " AND (d.name=? OR CAST(d.id AS TEXT)=?)";
        args.push(location, location);
      }
      if (minRaw !== "" && Number.isFinite(Number(minRaw)) && Number(minRaw) >= 0) {
        sql += " AND a.price_lkr>=?";
        args.push(Number(minRaw));
      }
      if (maxRaw !== "" && Number.isFinite(Number(maxRaw)) && Number(maxRaw) >= 0) {
        sql += " AND a.price_lkr<=?";
        args.push(Number(maxRaw));
      }

      sql += " ORDER BY a.created_at DESC LIMIT 100";
      const r = await env.DB.prepare(sql).bind(...args).all();
      return json(r.results, 200, headers);
    }

    // Upload image to R2
    if (path === "/api/upload" && method === "POST") {
      if (!env.MEDIA) return json({ error: "R2 binding MEDIA is missing" }, 500, headers);
      const user = await getUser(req, env);
      if (!user) return json({ error: "Login required" }, 401, headers);

      const form = await req.formData();
      const file = form.get("file");

      if (!file || typeof file.stream !== "function" ||
          !IMAGE_TYPES.includes(file.type) || file.size > 5 * 1024 * 1024) {
        return json({ error: "Use JPG, PNG, WEBP or GIF under 5 MB" }, 400, headers);
      }

      const ext = file.type.split("/")[1].replace("jpeg", "jpg");
      const key = `ads/${user.id}/${uid()}.${ext}`;
      await env.MEDIA.put(key, file.stream(), {
        httpMetadata: { contentType: file.type }
      });

      return json({ key, url: `${url.origin}/api/media/${key}` }, 201, headers);
    }

    // Serve images
    if (path.startsWith("/api/media/") && method === "GET") {
      if (!env.MEDIA) return new Response("Storage unavailable", { status: 500, headers });

      let key;
      try {
        key = decodeURIComponent(path.slice("/api/media/".length));
      } catch {
        return new Response("Invalid image key", { status: 400, headers });
      }

      if (!key.startsWith("ads/") || key.includes("..")) {
        return new Response("Invalid image key", { status: 400, headers });
      }

      const obj = await env.MEDIA.get(key);
      if (!obj) return new Response("Not found", { status: 404, headers });

      return new Response(obj.body, {
        headers: {
          ...headers,
          "Content-Type": obj.httpMetadata?.contentType || "application/octet-stream",
          "Cache-Control": "public, max-age=86400",
          "X-Content-Type-Options": "nosniff"
        }
      });
    }

    // Submit ad
    if (path === "/api/ads" && method === "POST") {
      const user = await getUser(req, env);
      if (!user) return json({ error: "Login required" }, 401, headers);
      if (!env.MEDIA) return json({ error: "R2 binding MEDIA is missing" }, 500, headers);

      const a = await readJson(req);
      if (!a || typeof a !== "object" || Array.isArray(a)) {
        return json({ error: "Invalid request body" }, 400, headers);
      }

      const title = text(a.title, 100);
      const description = text(a.description, 2000);
      const adType = TYPES.includes(a.ad_type) ? a.ad_type : "product";
      const categoryId = optionalId(a.category_id);
      const districtId = optionalId(a.district_id);
      const cityId = optionalId(a.city_id);
      const price = optionalMoney(a.price_lkr);
      const salary = optionalMoney(a.salary_lkr);
      const website = text(a.website_url, 500);
      const condition = text(a.condition, 30);
      const sellerName = text(a.seller_name || user.name || user.email, 100);
      const sellerPhone = text(a.seller_phone, 30);
      const photos = Array.isArray(a.photos) ? a.photos.slice(0, 5) : [];

      if (title.length < 3) return json({ error: "Title must contain at least 3 characters" }, 400, headers);
      if (!photos.length) return json({ error: "Upload at least one photo" }, 400, headers);
      if (categoryId !== null && !Number.isSafeInteger(categoryId)) return json({ error: "Invalid category" }, 400, headers);
      if (districtId !== null && !Number.isSafeInteger(districtId)) return json({ error: "Invalid district" }, 400, headers);
      if (cityId !== null && !Number.isSafeInteger(cityId)) return json({ error: "Invalid city" }, 400, headers);
      if (Number.isNaN(price) || Number.isNaN(salary)) return json({ error: "Price and salary must be zero or greater" }, 400, headers);

      if (website) {
        try {
          const parsed = new URL(website);
          if (!["https:", "http:"].includes(parsed.protocol)) throw new Error();
        } catch {
          return json({ error: "Enter a valid HTTP or HTTPS website URL" }, 400, headers);
        }
      }

      if (categoryId !== null) {
        const r = await env.DB.prepare("SELECT id FROM categories WHERE id=?").bind(categoryId).first();
        if (!r) return json({ error: "Invalid category" }, 400, headers);
      }

      if (districtId !== null) {
        const r = await env.DB.prepare("SELECT id FROM districts WHERE id=?").bind(districtId).first();
        if (!r) return json({ error: "Invalid district" }, 400, headers);
      }

      if (cityId !== null) {
        if (districtId === null) return json({ error: "Choose a district before selecting a city" }, 400, headers);
        const r = await env.DB.prepare(
          "SELECT id FROM cities WHERE id=? AND district_id=?"
        ).bind(cityId, districtId).first();
        if (!r) return json({ error: "Invalid city" }, 400, headers);
      }

      for (const key of photos) {
        if (typeof key !== "string" || !key.startsWith(`ads/${user.id}/`) || key.includes("..")) {
          return json({ error: "Invalid uploaded photo" }, 400, headers);
        }
        if (!await env.MEDIA.head(key)) {
          return json({ error: "An uploaded photo could not be found" }, 400, headers);
        }
      }

      const daily = await env.DB.prepare(`
        SELECT COUNT(*) AS total FROM ads
        WHERE user_id=?
          AND date(created_at,'+5 hours 30 minutes')=date('now','+5 hours 30 minutes')
      `).bind(user.id).first();

      if (Number(daily?.total || 0) >= 5) {
        return json({ error: "Daily limit reached. You can submit up to 5 ads per day." }, 429, headers);
      }

      const active = await env.DB.prepare(`
        SELECT COUNT(*) AS total FROM ads
        WHERE user_id=? AND status='APPROVED'
          AND COALESCE(expires_at,datetime(created_at,'+30 days'))>datetime('now')
      `).bind(user.id).first();

      if (Number(active?.total || 0) >= 15) {
        return json({ error: "You already have 15 active ads. Wait for one to expire or remove one." }, 429, headers);
      }

      const result = await env.DB.prepare(`
        INSERT INTO ads (
          user_id,category_id,district_id,city_id,title,description,
          price_lkr,condition,seller_name,seller_phone,status,expires_at,
          ad_type,website_url,salary_lkr
        )
        VALUES (?,?,?,?,?,?,?,?,?,?,'PENDING',datetime('now','+30 days'),?,?,?)
      `).bind(
        user.id, categoryId, districtId, cityId, title,
        description || null, price === null ? 0 : price,
        condition || null, sellerName || null, sellerPhone || null,
        adType, website || null, adType === "job" ? salary : null
      ).run();

      const adId = result.meta.last_row_id;

      for (const key of photos) {
        await env.DB.prepare(`
          INSERT INTO ad_photos (ad_id,photo_url,r2_key)
          VALUES (?,?,?)
        `).bind(adId, `${url.origin}/api/media/${key}`, key).run();
      }

      return json({
        success: true,
        id: adId,
        status: "PENDING",
        free: true,
        message: "Your free ad was submitted for admin approval."
      }, 201, headers);
    }

    // Admin: approve/reject
    const match = path.match(/^\/api\/admin\/ads\/(\d+)\/status$/);

    if (match && method === "PATCH") {
      const user = await getUser(req, env);
      if (!user) return json({ error: "Login required" }, 401, headers);
      if (user.role !== "admin") return json({ error: "Admin access required" }, 403, headers);

      const body = await readJson(req);
      const id = Number(match[1]);
      const status = body?.status;

      if (!["APPROVED", "REJECTED"].includes(status)) {
        return json({ error: "Status must be APPROVED or REJECTED" }, 400, headers);
      }

      const ad = await env.DB.prepare(`
        SELECT id,user_id,status,expires_at,created_at
        FROM ads WHERE id=?
      `).bind(id).first();

      if (!ad) return json({ error: "Ad not found" }, 404, headers);
      if (ad.status !== "PENDING") return json({ error: "Only pending ads can be reviewed" }, 409, headers);

      if (status === "APPROVED") {
        const active = await env.DB.prepare(`
          SELECT COUNT(*) AS total FROM ads
          WHERE user_id=? AND status='APPROVED'
            AND COALESCE(expires_at,datetime(created_at,'+30 days'))>datetime('now')
        `).bind(ad.user_id).first();

        if (Number(active?.total || 0) >= 15) {
          return json({ error: "This user already has 15 active ads. The ad remains pending." }, 409, headers);
        }

        if (ad.expires_at && ad.expires_at <= new Date().toISOString().replace("T", " ").slice(0, 19)) {
          return json({ error: "This ad has expired and cannot be approved" }, 409, headers);
        }
      }

      await env.DB.prepare(
        "UPDATE ads SET status=? WHERE id=? AND status='PENDING'"
      ).bind(status, id).run();

      return json({ success: true, id, status }, 200, headers);
    }

    return json({ error: "Route not found" }, 404, headers);

  } catch (e) {
    console.error("CreateLK API error:", e);
    return json({ error: "Server error" }, 500, headers);
  }
}

export default {
  async fetch(req, env) {
    const headers = corsFor(req);
    const origin = req.headers.get("Origin");

    if (origin && !headers["Access-Control-Allow-Origin"]) {
      return json({ error: "Origin not allowed" }, 403, headers);
    }

    if (req.method === "OPTIONS") {
      return new Response(null, { status: 204, headers });
    }

    try {
      const response = await handle(req, env);
      const outHeaders = new Headers(response.headers);

      for (const [key, value] of Object.entries(headers)) {
        outHeaders.set(key, value);
      }

      return new Response(response.body, {
        status: response.status,
        headers: outHeaders
      });
    } catch (e) {
      console.error("CreateLK API error:", e);
      return json({ error: "Server error" }, 500, headers);
    }
  },

  async scheduled(controller, env, ctx) {
    ctx.waitUntil((async () => {
      if (!env.DB) return;

      await env.DB.prepare(`
        UPDATE ads SET status='EXPIRED'
        WHERE status='APPROVED'
          AND COALESCE(expires_at,datetime(created_at,'+30 days'))<=datetime('now')
      `).run();
    })());
  }
};
