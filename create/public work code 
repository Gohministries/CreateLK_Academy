
const CORS_HEADERS = {
  "Access-Control-Allow-Origin": "https://createlk.com",
  "Access-Control-Allow-Methods": "GET, POST, OPTIONS",
  "Access-Control-Allow-Headers": "Content-Type, Authorization",
  "Access-Control-Max-Age": "86400"
};

const SESSION_LIFETIME = 7 * 24 * 60 * 60 * 1000;

function json(data, status = 200) {
  return new Response(JSON.stringify(data), {
    status,
    headers: {
      ...CORS_HEADERS,
      "Content-Type": "application/json; charset=utf-8",
      "Cache-Control": "no-store"
    }
  });
}

function base64urlEncode(value) {
  const bytes = new TextEncoder().encode(value);
  let binary = "";
  for (const byte of bytes) binary += String.fromCharCode(byte);
  return btoa(binary)
    .replace(/\+/g, "-")
    .replace(/\//g, "_")
    .replace(/=+$/, "");
}

function base64urlDecode(value) {
  const padded = value.replace(/-/g, "+").replace(/_/g, "/")
    + "=".repeat((4 - value.length % 4) % 4);
  return atob(padded);
}

async function getSigningKey(secret) {
  return crypto.subtle.importKey(
    "raw",
    new TextEncoder().encode(secret),
    { name: "HMAC", hash: "SHA-256" },
    false,
    ["sign", "verify"]
  );
}

async function signToken(user, secret) {
  const payload = {
    id: user.id,
    exp: Date.now() + SESSION_LIFETIME
  };

  const encoded = base64urlEncode(JSON.stringify(payload));
  const key = await getSigningKey(secret);
  const signature = await crypto.subtle.sign(
    "HMAC",
    key,
    new TextEncoder().encode(encoded)
  );

  const sig = base64urlEncode(
    String.fromCharCode(...new Uint8Array(signature))
  );

  return `${encoded}.${sig}`;
}

async function verifyToken(token, secret) {
  if (!token || !secret) return null;

  const parts = token.split(".");
  if (parts.length !== 2) return null;

  try {
    const key = await getSigningKey(secret);
    const signatureBinary = base64urlDecode(parts[1]);
    const signature = Uint8Array.from(
      signatureBinary,
      char => char.charCodeAt(0)
    );

    const valid = await crypto.subtle.verify(
      "HMAC",
      key,
      signature,
      new TextEncoder().encode(parts[0])
    );

    if (!valid) return null;

    const payload = JSON.parse(base64urlDecode(parts[0]));
    if (!payload.id || !payload.exp || payload.exp <= Date.now()) {
      return null;
    }

    return payload;
  } catch {
    return null;
  }
}

function publicUser(row) {
  return {
    id: row.id,
    email: row.email,
    name: row.display_name || "",
    picture: row.avatar_url || "",
    avatar_url: row.avatar_url || "",
    role: row.role || "user"
  };
}

function getBearerToken(request) {
  const auth = request.headers.get("Authorization") || "";
  const match = auth.match(/^Bearer\s+(.+)$/i);
  return match ? match[1] : null;
}

async function getUser(request, env) {
  const payload = await verifyToken(
    getBearerToken(request),
    env.SESSION_SECRET
  );

  if (!payload) return null;

  const row = await env.DB.prepare(`
    SELECT id, google_id, email, display_name, avatar_url, role
    FROM users
    WHERE id = ?
    LIMIT 1
  `).bind(payload.id).first();

  return row ? publicUser(row) : null;
}

function normalizeCategory(value) {
  return String(value || "").trim().toLowerCase();
}

async function handleGoogleLogin(request, env) {
  if (!env.GOOGLE_CLIENT_ID || !env.SESSION_SECRET || !env.DB) {
    return json({ error: "Server configuration is incomplete." }, 500);
  }

  let body;
  try {
    body = await request.json();
  } catch {
    return json({ error: "Invalid JSON request." }, 400);
  }

  const credential = String(body.credential || "");
  if (!credential) {
    return json({ error: "Google credential is required." }, 400);
  }

  let googleAccount;

  try {
    const response = await fetch(
      "https://oauth2.googleapis.com/tokeninfo?id_token=" +
      encodeURIComponent(credential)
    );

    if (!response.ok) {
      return json({ error: "Google sign-in verification failed." }, 401);
    }

    googleAccount = await response.json();
  } catch {
    return json({ error: "Unable to verify Google sign-in." }, 502);
  }

  if (
    googleAccount.aud !== env.GOOGLE_CLIENT_ID ||
    googleAccount.email_verified !== "true" ||
    !googleAccount.email ||
    !googleAccount.sub
  ) {
    return json({ error: "Google account verification failed." }, 401);
  }

  const googleId = googleAccount.sub;
  const email = String(googleAccount.email).trim().toLowerCase();
  const displayName = String(googleAccount.name || "");
  const avatarUrl = String(googleAccount.picture || "");

  try {
    let user = await env.DB.prepare(`
      SELECT id, google_id, email, display_name, avatar_url, role
      FROM users
      WHERE google_id = ? OR email = ?
      LIMIT 1
    `).bind(googleId, email).first();

    if (user) {
      await env.DB.prepare(`
        UPDATE users
        SET google_id = ?,
            email = ?,
            display_name = ?,
            avatar_url = ?
        WHERE id = ?
      `).bind(
        googleId,
        email,
        displayName,
        avatarUrl,
        user.id
      ).run();

      user = await env.DB.prepare(`
        SELECT id, google_id, email, display_name, avatar_url, role
        FROM users
        WHERE id = ?
        LIMIT 1
      `).bind(user.id).first();
    } else {
      const result = await env.DB.prepare(`
        INSERT INTO users (
          google_id, email, display_name, avatar_url, role
        ) VALUES (?, ?, ?, ?, 'user')
      `).bind(
        googleId,
        email,
        displayName,
        avatarUrl
      ).run();

      user = await env.DB.prepare(`
        SELECT id, google_id, email, display_name, avatar_url, role
        FROM users
        WHERE id = ?
        LIMIT 1
      `).bind(result.meta.last_row_id).first();
    }

    const token = await signToken(user, env.SESSION_SECRET);

    return json({
      success: true,
      token,
      user: publicUser(user)
    });
  } catch (error) {
    console.error("Google login database error:", error);
    return json({ error: "Unable to save the Google account." }, 500);
  }
}

async function handleCategories(env) {
  const result = await env.DB.prepare(`
    SELECT id, name, slug
    FROM categories
    WHERE is_active = 1
    ORDER BY sort_order, name
  `).all();

  return json(result.results || []);
}

async function handleLocations(env) {
  const result = await env.DB.prepare(`
    SELECT id, name, province
    FROM districts
    ORDER BY sort_order, name
  `).all();

  return json(result.results || []);
}

async function handleListings(request, env) {
  const url = new URL(request.url);
  const q = (url.searchParams.get("q") ||
    url.searchParams.get("search") || "").trim();

  const category = normalizeCategory(url.searchParams.get("category"));
  const district = (url.searchParams.get("district") ||
    url.searchParams.get("location") || "").trim();

  const minPrice = url.searchParams.get("minPrice");
  const maxPrice = url.searchParams.get("maxPrice");

  const page = Math.max(
    1,
    Math.min(10000, Number(url.searchParams.get("page")) || 1)
  );

  const limit = Math.max(
    1,
    Math.min(100, Number(url.searchParams.get("limit")) || 24)
  );

  const offset = (page - 1) * limit;
  const conditions = ["LOWER(l.status) = 'approved'"];
  const params = [];

  if (q) {
    conditions.push(
      "(l.title LIKE ? OR l.description LIKE ? OR l.town LIKE ?)"
    );
    const term = `%${q}%`;
    params.push(term, term, term);
  }

  if (category && category !== "all") {
    conditions.push("LOWER(l.category) = ?");
    params.push(category);
  }

  if (district && district.toLowerCase() !== "all") {
    conditions.push("LOWER(l.district) = LOWER(?)");
    params.push(district);
  }

  if (minPrice !== null && minPrice !== "" && Number.isFinite(Number(minPrice))) {
    conditions.push("l.price_lkr >= ?");
    params.push(Number(minPrice));
  }

  if (maxPrice !== null && maxPrice !== "" && Number.isFinite(Number(maxPrice))) {
    conditions.push("l.price_lkr <= ?");
    params.push(Number(maxPrice));
  }

  const where = conditions.join(" AND ");

  try {
    const result = await env.DB.prepare(`
      SELECT
        l.id,
        l.user_id,
        l.title,
        l.description,
        l.price_lkr,
        l.category,
        l.district,
        l.town,
        l.image_url,
        l.contact_phone,
        l.seller_name,
        l.status,
        l.created_at,
        COALESCE(c.name, l.category) AS category_name,
        COALESCE(d.name, l.district) AS district_name,
        (
          SELECT p.image_url
          FROM listing_photos p
          WHERE p.listing_id = l.id
          ORDER BY p.id
          LIMIT 1
        ) AS photo_url
      FROM listings l
      LEFT JOIN categories c ON LOWER(c.slug) = LOWER(l.category)
      LEFT JOIN districts d ON LOWER(d.name) = LOWER(l.district)
      WHERE ${where}
      ORDER BY l.created_at DESC, l.id DESC
      LIMIT ? OFFSET ?
    `).bind(...params, limit, offset).all();

    return json({
      success: true,
      items: result.results || [],
      page,
      limit
    });
  } catch (error) {
    console.error("Listings query error:", error);
    return json({ error: "Unable to load advertisements." }, 500);
  }
}

export default {
  async fetch(request, env) {
    if (request.method === "OPTIONS") {
      return new Response(null, {
        status: 204,
        headers: CORS_HEADERS
      });
    }

    if (!env.DB) {
      return json({ error: "D1 database binding DB is missing." }, 500);
    }

    const url = new URL(request.url);
    const path = url.pathname.replace(/\/+$/, "") || "/";

    try {
      if (request.method === "POST" && path === "/api/auth/google") {
        return await handleGoogleLogin(request, env);
      }

      if (request.method === "GET" && path === "/api/auth/me") {
        const user = await getUser(request, env);
        if (!user) {
          return json({ error: "Please sign in again." }, 401);
        }
        return json({ success: true, user });
      }

      if (request.method === "GET" && path === "/api/categories") {
        return await handleCategories(env);
      }

      if (request.method === "GET" && path === "/api/locations") {
        return await handleLocations(env);
      }

      // Towns are stored as text in listings.town.
      // The current database has no cities table.
      if (request.method === "GET" && path === "/api/cities") {
        return json([]);
      }

      if (request.method === "GET" && path === "/api/listings") {
        return await handleListings(request, env);
      }

      if (request.method === "GET" && path === "/api/health") {
        return json({ success: true, service: "create-public" });
      }

      return json({ error: "Endpoint not found." }, 404);
    } catch (error) {
      console.error("Worker error:", error);
      return json({ error: "Internal server error." }, 500);
    }
  }
};
