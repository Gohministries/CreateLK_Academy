<script>

/* =========================
CLOUDFLARE LESSON API
========================= */

const LESSON_API=
"https://spokenlessons.createlk.workers.dev";


/* =========================
PAYMENT API
========================= */

const PAYMENT=
"https://createlk-premium-payments.createlk.workers.dev";


const STUDENT_KEY=
"createlk_student";


let student={};

let currentFirstDialogue=null;


/* =========================
LOAD STUDENT
========================= */

try{

student=
JSON.parse(
localStorage.getItem(
STUDENT_KEY
)||"{}"
);

}catch(e){

student={};

}


/* =========================
STUDENT ID
========================= */

function getStudentId(){

return Number(

student.id||

student.database_id||

student.student_id_number||

student.student_id||

0

);

}


/* =========================
PREMIUM STATUS
========================= */

function isPremium(){

return String(

student.membership_status||

student.membershipStatus||

"FREE"

)
.trim()
.toUpperCase()==="PREMIUM";

}


/* =========================
DATE
========================= */

function setupDate(){

const now=new Date();

document.getElementById(
"lessonDate"
).textContent=

now.toLocaleDateString(
"en-US",
{
month:"long",
day:"numeric",
year:"numeric"
}
);

}


/* =========================
MEMBERSHIP UI
========================= */

function updateMembership(){

const premium=
isPremium();

const status=
document.getElementById(
"membershipStatus"
);

const text=
document.getElementById(
"membershipText"
);

const note=
document.getElementById(
"limitNote"
);

const premiumBox=
document.getElementById(
"premiumBox"
);


if(premium){

status.textContent=
"✓ Premium";

text.textContent=
"Premium is active. All 10 daily dialogues are unlocked.";

note.innerHTML=
"<strong>⭐ Premium:</strong> All 10 daily dialogues are available.";

premiumBox.classList.add(
"hidden"
);

}else{

status.textContent=
"Free";

text.textContent=
"3 dialogues are free. Premium unlocks all 10.";

note.innerHTML=
"<strong>Free:</strong> Dialogues 1–3 are free. Upgrade for all 10.";

premiumBox.classList.remove(
"hidden"
);

}

return premium;

}


/* =========================
FIELDS
========================= */

function getTamil(item){

return item.tamil||
item.ta||
item.tamil_text||
item.question_tamil||
item.text_tamil||
"";

}


function getSinhala(item){

return item.sinhala||
item.si||
item.sinhala_text||
item.translation_sinhala||
item.text_sinhala||
"";

}


function getEnglish(item){

return item.english||
item.en||
item.english_text||
item.answer_english||
item.text_english||
"";

}


/* =========================
ESCAPE
========================= */

function escapeHTML(text){

return String(text)

.replace(/&/g,"&amp;")
.replace(/</g,"&lt;")
.replace(/>/g,"&gt;")
.replace(/"/g,"&quot;")
.replace(/'/g,"&#039;");

}


/* =========================
LISTEN
========================= */

function listenEnglish(text){

if(
!("speechSynthesis" in window)
){

alert(
"Voice playback is not supported."
);

return;

}

speechSynthesis.cancel();

const speech=
new SpeechSynthesisUtterance(
text
);

speech.lang="en-US";
speech.rate=.9;

speechSynthesis.speak(
speech
);

}


/* =========================
CREATE LESSON CARD
========================= */

function createCard(item,index){

const card=
document.createElement(
"article"
);

card.className=
"card "+
(index<3?"free":"premium");


const ta=
getTamil(item);

const si=
getSinhala(item);

const en=
getEnglish(item);


card.innerHTML=`

<div class="number">
DIALOGUE ${index+1}
</div>

<div class="tamil">
${escapeHTML(ta)}
</div>

${
si
?
`<div class="sinhala">
${escapeHTML(si)}
</div>`
:""
}

<div class="english">
${escapeHTML(en)}
</div>

${
en
?
`<button
type="button"
class="listen">
🔊 Listen
</button>`
:""
}

<span class="badge ${
index<3
?"free-badge"
:"premium-badge"
}">
${
index<3
?"✓ FREE"
:"⭐ PREMIUM"
}
</span>

`;


const listen=
card.querySelector(
".listen"
);


if(listen){

listen.onclick=
()=>listenEnglish(en);

}


return card;

}


/* =========================
NORMALIZE CLOUDFLARE
========================= */

function normalizeLesson(json){

let data=json;


if(
json&&
json.lesson
){

data=
json.lesson;

}


if(
json&&
json.data&&
!Array.isArray(
json.data
)
){

data=
json.data;

}


const dialogues=
data.dialogues||
data.conversations||
data.items||
data.lessons;


if(
!Array.isArray(dialogues)
){

throw new Error(
"No dialogues were returned by Cloudflare."
);

}


return{
dialogues:dialogues
};

}


/* =========================
LOAD TODAY'S LESSON
========================= */

async function loadLesson(){

setupDate();

const premium=
updateMembership();


try{

const now=
new Date();


const monthDay=

String(
now.getMonth()+1
).padStart(2,"0")
+
"-"+
String(
now.getDate()
).padStart(2,"0");


const url=
LESSON_API+
"/api/today?month_day="+
encodeURIComponent(
monthDay
);


const response=
await fetch(
url,
{
method:"GET",
cache:"no-store",
headers:{
"Accept":
"application/json"
}
}
);


if(!response.ok){

throw new Error(
"Lesson service returned HTTP "+
response.status+"."
);

}


const json=
await response.json();


const lesson=
normalizeLesson(json);


if(
lesson.dialogues.length<3
){

throw new Error(
"Today's lesson has fewer than 3 dialogues."
);

}


const grid=
document.getElementById(
"lessonGrid"
);


grid.innerHTML="";


/* =========================
FREE USER
3 DIALOGUES
========================= */

if(!premium){

for(
let i=0;
i<Math.min(
3,
lesson.dialogues.length
);
i++
){

grid.appendChild(
createCard(
lesson.dialogues[i],
i
)
);

}

}


/* =========================
PREMIUM USER
10 DIALOGUES
========================= */

else{

const maximum=
Math.min(
10,
lesson.dialogues.length
);


for(
let i=0;
i<maximum;
i++
){

grid.appendChild(
createCard(
lesson.dialogues[i],
i
)
);

}

}


currentFirstDialogue=
lesson.dialogues[0];


document.getElementById(
"loading"
)
.classList.add(
"hidden"
);


document.getElementById(
"error"
)
.classList.add(
"hidden"
);


grid.classList.remove(
"hidden"
);


document.getElementById(
"shareButton"
)
.classList.remove(
"hidden"
);


}catch(error){

console.error(error);


document.getElementById(
"loading"
)
.classList.add(
"hidden"
);


const errorBox=
document.getElementById(
"error"
);


errorBox.textContent=
"⚠️ "+
error.message;


errorBox.classList.remove(
"hidden"
);

}

}


/* =========================
PAYHERE CHECKOUT
SAME WORKING LOGIC
========================= */

async function checkout(){

const studentId=
getStudentId();


if(!studentId){

location.href=
"login.html";

return;

}


try{

const response=
await fetch(

PAYMENT+
"/api/checkout",

{

method:"POST",

headers:{
"Content-Type":
"application/json"
},

body:
JSON.stringify({

student_id:
studentId

})

}

);


const raw=
await response.text();


if(!response.ok){

throw new Error(
"Unable to open PayHere."
);

}


/* HTML PAYMENT FORM */

if(
raw.includes("<form")
){

document.open();

document.write(raw);

document.close();

return;

}


/* JSON RESPONSE */

let data;

try{

data=
JSON.parse(raw);

}catch(e){

throw new Error(
"Invalid payment response."
);

}


if(
data.url||
data.checkout_url
){

location.href=
data.url||
data.checkout_url;

return;

}


throw new Error(
"Invalid payment response."
);


}catch(error){

console.error(error);

alert(
error.message
);

}

}


/* =========================
SHARE DAILY LESSON
1080 × 1350
========================= */

async function shareFirstDialogue(){

const item=
currentFirstDialogue;


if(!item){

alert(
"Today's lesson is not loaded yet."
);

return;

}


const ta=
getTamil(item);

const si=
getSinhala(item);

const en=
getEnglish(item);


const date=
document.getElementById(
"lessonDate"
).textContent;


const canvas=
document.createElement(
"canvas"
);


canvas.width=1080;
canvas.height=1350;


const ctx=
canvas.getContext(
"2d"
);


/* =========================
BACKGROUND
========================= */

const gradient=
ctx.createLinearGradient(
0,
0,
1080,
1350
);


gradient.addColorStop(
0,
"#1d4ed8"
);

gradient.addColorStop(
.5,
"#2563eb"
);

gradient.addColorStop(
1,
"#7c3aed"
);


ctx.fillStyle=
gradient;


ctx.fillRect(
0,
0,
1080,
1350
);


/* DECORATIVE CIRCLES */

ctx.fillStyle=
"rgba(255,255,255,.08)";


ctx.beginPath();

ctx.arc(
960,
110,
210,
0,
Math.PI*2
);

ctx.fill();


ctx.beginPath();

ctx.arc(
90,
1240,
180,
0,
Math.PI*2
);

ctx.fill();


/* =========================
HEADER
========================= */

ctx.fillStyle="#fff";

ctx.textAlign="center";

ctx.font=
"bold 46px Arial";

ctx.fillText(
"📚 CreateLK Academy",
540,
105
);


ctx.font=
"bold 38px Arial";

ctx.fillText(
"Daily Spoken English",
540,
160
);


ctx.font=
"24px Arial";

ctx.globalAlpha=.9;

ctx.fillText(
date,
540,
205
);

ctx.globalAlpha=1;


/* =========================
WHITE BOARD
========================= */

const boardX=65;
const boardY=275;
const boardW=950;
const boardH=790;
const boardR=38;


ctx.shadowColor=
"rgba(0,0,0,.18)";

ctx.shadowBlur=30;

ctx.shadowOffsetY=12;

ctx.fillStyle="#fff";


roundRect(
ctx,
boardX,
boardY,
boardW,
boardH,
boardR
);

ctx.fill();


ctx.shadowColor=
"transparent";

ctx.shadowBlur=0;

ctx.shadowOffsetY=0;


/* =========================
BOARD TITLE
========================= */

ctx.fillStyle="#2563eb";

ctx.font=
"bold 24px Arial";

ctx.textAlign="center";

ctx.fillText(
"DAILY LESSON",
540,
335
);


/* DIVIDER */

ctx.strokeStyle="#e2e8f0";

ctx.lineWidth=2;

ctx.beginPath();

ctx.moveTo(
170,
365
);

ctx.lineTo(
910,
365
);

ctx.stroke();


/* =========================
TEXT BLOCKS
========================= */

const blocks=[];


if(ta){

blocks.push({

text:ta,

font:
"bold 34px Arial",

color:
"#172033",

lineHeight:
48

});

}


if(si){

blocks.push({

text:si,

font:
"26px Arial",

color:
"#64748b",

lineHeight:
42

});

}


if(en){

blocks.push({

text:en,

font:
"bold 32px Arial",

color:
"#1e293b",

lineHeight:
48

});

}


/* =========================
MEASURE
========================= */

const contentTop=430;

const contentBottom=950;

const contentHeight=
contentBottom-contentTop;


let totalHeight=0;

const measured=[];


for(
const block of blocks
){

ctx.font=
block.font;


const lines=
wrapLines(
ctx,
block.text,
800
);


const height=
lines.length*
block.lineHeight;


measured.push({

block,
lines,
height

});


totalHeight+=
height;

}


if(
measured.length>1
){

totalHeight+=
(measured.length-1)*30;

}


/* =========================
VERTICAL CENTER
========================= */

let y=
contentTop+
(
contentHeight-
totalHeight
)/2;


for(
let i=0;
i<measured.length;
i++
){

const m=
measured[i];


ctx.font=
m.block.font;

ctx.fillStyle=
m.block.color;

ctx.textAlign=
"center";


for(
const line of m.lines
){

ctx.fillText(
line,
540,
y
);

y+=
m.block.lineHeight;

}


if(
i<
measured.length-1
){

y+=30;

}

}


/* BLUE LINE */

ctx.fillStyle=
"#2563eb";


roundRect(
ctx,
410,
995,
260,
7,
4
);

ctx.fill();


/* =========================
FOOTER
========================= */

ctx.fillStyle="#fff";

ctx.font=
"bold 30px Arial";

ctx.textAlign=
"center";

ctx.fillText(
"creatlk.com",
540,
1170
);


ctx.font=
"22px Arial";

ctx.globalAlpha=.9;

ctx.fillText(
"Learn English Every Day",
540,
1215
);

ctx.globalAlpha=1;


/* =========================
CREATE IMAGE
========================= */

canvas.toBlob(
async(blob)=>{

if(!blob){

alert(
"Unable to create share image."
);

return;

}


const file=
new File(
[blob],
"createlk-daily-lesson.png",
{
type:"image/png"
}
);


/* ONE-LINE PREFILLED TEXT */

const shareText=
"Daily Spoken English — For the full lesson: createlk.com";


/* NATIVE SHARE */

if(
navigator.share&&
navigator.canShare&&
navigator.canShare({
files:[file]
})
){

try{

await navigator.share({

title:
"Daily Lesson",

text:
shareText,

files:
[file]

});

return;

}catch(error){

if(
error.name===
"AbortError"
){

return;

}

}

}


/* TEXT FALLBACK */

if(
navigator.share
){

try{

await navigator.share({

title:
"Daily Lesson",

text:
shareText

});

return;

}catch(error){

if(
error.name===
"AbortError"
){

return;

}

}

}


/* IMAGE FALLBACK */

const link=
document.createElement(
"a"
);

link.download=
"createlk-daily-lesson.png";

link.href=
URL.createObjectURL(
blob
);

link.click();


setTimeout(
()=>{

URL.revokeObjectURL(
link.href
);

},
1000
);


},
"image/png"
);

}


/* =========================
WRAP TEXT
========================= */

function wrapLines(
ctx,
text,
maxWidth
){

const words=
