<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#2563eb">
<title>CreateLK Academy | Daily Spoken English</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{--b:#2563eb;--p:#7c3aed;--g:#16a34a;--gold:#f59e0b;--bg:#f4f7fb;--t:#172033;--m:#64748b;--bd:#e2e8f0}
body{font-family:Arial,Helvetica,sans-serif;background:var(--bg);color:var(--t);min-height:100vh}
.header{background:linear-gradient(135deg,#2563eb,#1d4ed8);color:#fff;padding:13px 15px}
.header-inner,.container{max-width:680px;margin:auto}
.header-inner{display:flex;justify-content:space-between;align-items:center}
.logo{font-size:17px;font-weight:900}.back{color:#fff;text-decoration:none;font-size:11px;font-weight:800}
.container{padding:12px 10px 30px}
.hero,.membership,.progress-card,.card,.loading{background:#fff;border-radius:15px;box-shadow:0 3px 14px #0000000d}
.hero{padding:17px;margin-bottom:12px}.brand{color:var(--b);font-size:11px;font-weight:900;letter-spacing:.5px}
h1{font-size:23px;margin:5px 0}.subtitle{color:var(--m);font-size:13px;line-height:1.5}.date{margin-top:9px;font-size:13px;font-weight:800}
.membership{padding:13px;margin-bottom:13px;background:#fff7ed;border:1px solid #fed7aa}
.membership-top,.progress-head,.progress-bottom{display:flex;justify-content:space-between}
.membership-title{color:#92400e;font-size:14px;font-weight:900}
.status{background:#dcfce7;color:#166534;border-radius:999px;padding:5px 9px;font-size:10px;font-weight:900}
.membership-text{color:#78350f;font-size:12px;line-height:1.45;margin-top:6px}
.progress-card{padding:13px;border:1px solid var(--bd);border-left:4px solid var(--p);margin-bottom:13px}
.progress-head{font-size:12px;font-weight:900}.progress-count{color:var(--p)}
.progress-bar{height:9px;background:#e2e8f0;border-radius:999px;overflow:hidden;margin-top:9px}
.progress-fill{height:100%;width:0;background:linear-gradient(90deg,var(--b),var(--p));transition:.3s}
.progress-bottom{margin-top:6px;font-size:9px;color:#475569;font-weight:900}
.hidden{display:none!important}.section-title{font-size:18px;margin:17px 2px 9px}
.note{background:#eff6ff;border:1px solid #bfdbfe;color:#1e40af;border-radius:11px;padding:10px 12px;font-size:12px;line-height:1.45;margin-bottom:11px}
.lesson-grid{display:flex;flex-direction:column;gap:10px}
.card{padding:15px;border:1px solid var(--bd)}.card.free{border-top:3px solid var(--g)}.card.premium{border-top:3px solid var(--gold)}
.number{color:var(--b);font-size:10px;font-weight:900;margin-bottom:9px}
.tamil{font-size:16px;font-weight:800;line-height:1.45;margin-bottom:7px}
.sinhala{color:#475569;font-size:13px;line-height:1.45;margin-bottom:7px}
.english{font-size:14px;line-height:1.5}
.listen,.complete-button,.share-main,.premium-button,.manual-button{border-radius:10px;padding:11px;font-size:12px;font-weight:900;cursor:pointer;text-align:center}
.listen{border:0;background:#eff6ff;color:var(--b);margin-top:9px}
.badge{display:inline-block;margin-top:9px;border-radius:999px;padding:4px 7px;font-size:9px;font-weight:900}
.free-badge{background:#dcfce7;color:#166534}.premium-badge{background:#fef3c7;color:#92400e}
.complete-button,.share-main,.premium-button,.manual-button{display:block;width:100%;margin-top:11px}
.complete-button{border:0;background:var(--g);color:#fff}.complete-button.done{background:#dcfce7;color:#166534;border:1px solid #bbf7d0}
.share-main{border:1px solid var(--b);background:#fff;color:var(--b)}
.premium-box{background:#fff7ed;border:2px solid #fbbf24;border-radius:15px;padding:13px;text-align:center;margin-top:12px}
.premium-box-title{color:#92400e;font-size:16px;font-weight:900}.premium-box-text{color:#78350f;font-size:12px;line-height:1.45;margin-top:6px}
.premium-button{background:linear-gradient(135deg,var(--b),var(--p));color:#fff;border:0}
.manual-button{background:#fff;color:#92400e;border:1px solid var(--gold);text-decoration:none}
.loading{text-align:center;padding:20px;color:var(--m);font-size:13px}
.error{background:#fef2f2;border:1px solid #fecaca;color:#991b1b;border-radius:12px;padding:13px;font-size:13px}
.footer{text-align:center;color:var(--m);font-size:11px;padding:18px}.footer a{color:var(--b);font-weight:900;text-decoration:none}
@media(max-width:600px){h1{font-size:21px}.card{padding:14px}}
</style>
</head>

<body>

<header class="header">
<div class="header-inner">
<div class="logo">📚 CreateLK Academy</div>
<a href="dashboard.html" class="back">← Dashboard</a>
</div>
</header>

<main class="container">

<section class="hero">
<div class="brand">CREATELK ACADEMY</div>
<h1>🗣️ Daily Spoken English</h1>
<p class="subtitle">Learn Tamil → English conversations every day.</p>
<div id="lessonDate" class="date">Loading...</div>
</section>

<section class="membership">
<div class="membership-top">
<div class="membership-title">⭐ Premium Membership</div>
<div id="membershipStatus" class="status">Checking...</div>
</div>
<div id="membershipText" class="membership-text">Checking membership...</div>
</section>

<section class="progress-card">
<div class="progress-head">
<span>🎓 Certificate Progress</span>
<span id="progressCount" class="progress-count">0 / 365</span>
</div>
<div class="progress-bar"><div id="progressFill" class="progress-fill"></div></div>
<div class="progress-bottom">
<span id="progressPercent">0%</span>
<span id="progressRemaining">365 remaining</span>
</div>
</section>

<h2 class="section-title">📖 TODAY'S LESSON</h2>

<div id="limitNote" class="note">Loading today's lesson...</div>
<div id="loading" class="loading">Loading today's lesson...</div>
<div id="error" class="error hidden"></div>

<section id="lessonGrid" class="lesson-grid hidden"></section>

<button id="completeButton" class="complete-button hidden" onclick="completeLesson()">
✅ Complete Today's Lesson
</button>

<button id="shareButton" class="share-main hidden" onclick="shareFirstLesson()">
📤 Share Today's Lesson
</button>

<section id="premiumBox" class="premium-box hidden">
<div class="premium-box-title">⭐ Premium Membership</div>
<div class="premium-box-text">
Today's 3 dialogues are free.<br><br>
Unlock all <strong>10 daily spoken English dialogues</strong> with Premium.
</div>
<button class="premium-button" onclick="checkout()">💳 Online Payment</button>
<a class="manual-button" href="/bank.html">🏦 Manual Bank Payment</a>
</section>

</main>

<footer class="footer">
© 2026 CreateLK Academy ·
<a href="https://creatlk.com" target="_blank" rel="noopener">creatlk.com</a>
</footer>

<script>
const LESSON_API="https://spokenlessons.createlk.workers.dev",
PAYMENT="https://creatlk-payhere-checkout.createlk.workers.dev",
ACCOUNT_API="https://creatlk-auth.createlk.workers.dev",
PROGRESS_API="https://creatlk-365-progress.createlk.workers.dev",
STUDENT_KEY="createlk_student",
LOCAL_KEY="createlk_spoken_completed",
TOTAL=365;

let student={},currentLessonDay=1,completedToday=false;
let firstTamil="",firstSinhala="",firstEnglish="";
const $=id=>document.getElementById(id);

try{student=JSON.parse(localStorage.getItem(STUDENT_KEY)||"{}")}catch(e){}

function studentId(){
return Number(student.id||student.database_id||student.student_id_number||student.student_id||0);
}

async function refreshStudent(){
const id=studentId();
if(!id)return;

try{
const r=await fetch(ACCOUNT_API+"/api/student?id="+encodeURIComponent(id),{
cache:"no-store",headers:{Accept:"application/json"}
});
if(!r.ok)return;
const d=await r.json();

if(d.success&&d.student){
student={
...student,
id:Number(d.student.id),
student_id:Number(d.student.id),
first_name:d.student.first_name||"",
last_name:d.student.last_name||"",
name:(d.student.first_name||"")+" "+(d.student.last_name||""),
email:d.student.email||"",
phone:d.student.phone||"",
membership_status:d.student.membership_status||"FREE",
membership_expiry:d.student.membership_expiry||null
};
localStorage.setItem(STUDENT_KEY,JSON.stringify(student));
}
}catch(e){console.error("Student refresh:",e)}
}

function getExpiry(){
const v=student.membership_expiry;
if(!v)return NaN;
const s=String(v).trim();

if(/^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}$/.test(s))
return new Date(s.replace(" ","T")+"+05:30").getTime();

return new Date(s).getTime();
}

function isPremium(){
const status=String(student.membership_status||student.membershipStatus||"FREE").trim().toUpperCase();
const expiry=getExpiry();
return status==="PREMIUM"&&Number.isFinite(expiry)&&expiry>Date.now();
}

function updateMembership(){
const p=isPremium();

$("membershipStatus").textContent=p?"✓ Premium":"Free";
$("membershipText").textContent=p?
"Premium is active. All 10 daily dialogues are unlocked.":
"3 dialogues are free. Premium unlocks all 10.";

$("limitNote").innerHTML=p?
"<strong>⭐ Premium:</strong> All 10 daily dialogues are available.":
"<strong>Free:</strong> Dialogues 1–3 are free. Upgrade for all 10.";

$("premiumBox").classList.toggle("hidden",p);
return p;
}

function setupDate(){
$("lessonDate").textContent=new Date().toLocaleDateString("en-US",{
month:"long",day:"numeric",year:"numeric"
});
}

function getLessonDay(){
const now=new Date(),start=new Date(now.getFullYear(),0,1);
let d=Math.floor((now-start)/86400000)+1;

if(new Date(now.getFullYear(),1,29).getMonth()===1&&d>59)d--;

return Math.min(365,Math.max(1,d));
}

const ta=x=>x.tamil||x.ta||x.tamil_text||x.question_tamil||x.text_tamil||"";
const si=x=>x.sinhala||x.si||x.sinhala_text||x.translation_sinhala||x.text_sinhala||"";
const en=x=>x.english||x.en||x.english_text||x.answer_english||x.text_english||"";

function esc(x){
return String(x??"").replace(/[&<>"']/g,c=>({
"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"
}[c]));
}

/* Speech */

function warmSpeech(){
if("speechSynthesis"in window)speechSynthesis.getVoices();
}

if("speechSynthesis"in window){
warmSpeech();
if("onvoiceschanged"in speechSynthesis)speechSynthesis.onvoiceschanged=warmSpeech;
setTimeout(warmSpeech,100);
setTimeout(warmSpeech,500);
}

function listenEnglish(text){
if(!("speechSynthesis"in window))
return alert("Voice playback is not supported.");

speechSynthesis.cancel();
speechSynthesis.resume();

const u=new SpeechSynthesisUtterance(text);
u.lang="en-US";
u.rate=.9;
u.volume=1;
u.pitch=1;
speechSynthesis.speak(u);
}

/* Card */

function createCard(item,index){
const a=ta(item),b=si(item),c=en(item);
const card=document.createElement("article");

card.className="card "+(index<3?"free":"premium");

card.innerHTML=`
<div class="number">DIALOGUE ${index+1}</div>
<div class="tamil">${esc(a)}</div>
${b?`<div class="sinhala">${esc(b)}</div>`:""}
<div class="english">${esc(c)}</div>
${c?`<button type="button" class="listen">🔊 Listen</button>`:""}
<span class="badge ${index<3?"free-badge":"premium-badge"}">
${index<3?"✓ FREE":"⭐ PREMIUM"}
</span>`;

const btn=card.querySelector(".listen");
if(btn)btn.onclick=()=>listenEnglish(c);

return card;
}

/* API response */

function normalize(j){
if(Array.isArray(j))return j;

if(j&&typeof j==="object"){
for(const k of["dialogues","conversations","items","lessons"])
if(Array.isArray(j[k]))return j[k];

if(j.lesson)return normalize(j.lesson);
if(j.data)return normalize(j.data);
if(j.result)return normalize(j.result);
if(j.response)return normalize(j.response);

if(j.tamil||j.english||j.ta||j.en)return[j];

if(j.success===false)
throw Error(j.message||j.error||"No lesson available today.");
}

throw Error("No dialogues were returned by Cloudflare.");
}

/* Local progress */

function localCompleted(){
try{
const a=JSON.parse(localStorage.getItem(LOCAL_KEY)||"[]");
return Array.isArray(a)?a.map(Number):[];
}catch(e){return[]}
}

function saveLocal(day){
const a=localCompleted();
if(!a.includes(Number(day))){
a.push(Number(day));
localStorage.setItem(LOCAL_KEY,JSON.stringify([...new Set(a)].sort((x,y)=>x-y)));
}
}

/* Progress */

function showProgress(n){
n=Math.min(TOTAL,Math.max(0,Number(n)||0));
const p=Math.round(n/TOTAL*100);

$("progressCount").textContent=`${n} / ${TOTAL}`;
$("progressFill").style.width=p+"%";
$("progressPercent").textContent=p+"%";
$("progressRemaining").textContent=n>=TOTAL?"🎓 Certificate ready":`${TOTAL-n} remaining`;
}

function markComplete(){
completedToday=true;
$("completeButton").disabled=true;
$("completeButton").textContent="✓ Today's Lesson Completed";
$("completeButton").classList.add("done");
$("completeButton").classList.remove("hidden");
}

async function loadProgress(){
const id=studentId();

if(!id){
showProgress(localCompleted().length);
return;
}

try{
const r=await fetch(PROGRESS_API+"/api/progress?student_id="+encodeURIComponent(id),{
cache:"no-store",headers:{Accept:"application/json"}
});

if(!r.ok)throw Error("Progress HTTP "+r.status);

const d=await r.json();

if(!d.success)throw Error(d.error||"Progress request failed");

const n=Number(d.completed_lessons||d.completed||d.lessons_completed||0);
showProgress(n);

const days=d.completed_days||d.completed_lesson_days||d.days_completed||[];

if(Array.isArray(days)&&days.map(Number).includes(currentLessonDay))
markComplete();

if(d.completed_today===true||d.today_completed===true)
markComplete();

if(n>=TOTAL)location.href="certificate.html";

}catch(e){
console.error("Progress:",e);
const a=localCompleted();
showProgress(a.length);
if(a.includes(currentLessonDay))markComplete();
}
}

/* Complete */

async function completeLesson(){
if(completedToday)return;

const id=studentId();
if(!id)return location.href="login.html";

const b=$("completeButton");
b.disabled=true;
b.textContent="⏳ Saving...";

try{
const r=await fetch(PROGRESS_API+"/api/complete",{
method:"POST",
headers:{
"Content-Type":"application/json",
"Accept":"application/json"
},
body:JSON.stringify({
student_id:Number(id),
lesson_day:Number(currentLessonDay)
})
});

const raw=await r.text();
let d={};

try{d=raw?JSON.parse(raw):{}}catch(e){
throw Error("Progress server returned an invalid response.");
}

if(!r.ok)
throw Error(d.error||d.message||"Save failed. Server HTTP "+r.status);

if(d.success!==true)
throw Error(d.error||d.message||"Could not save the lesson.");

saveLocal(currentLessonDay);
markComplete();
await loadProgress();

}catch(e){
console.error("Complete:",e);

b.disabled=false;
b.textContent="✅ Complete Today's Lesson";
b.classList.remove("done");

alert(e instanceof TypeError?
"Unable to connect to the Progress server.\n\nPlease check the Progress Worker connection.":
e.message||"Could not save the lesson.");
}
}

/* Share */

function shareFirstLesson(){
if(firstTamil||firstSinhala||firstEnglish)
share(firstTamil,firstSinhala,firstEnglish);
}

function wrap(ctx,text,max){
const words=text.trim().split(/\s+/),lines=[];
let line="";

words.forEach(w=>{
const test=line?line+" "+w:w;
if(ctx.measureText(test).width>max&&line){
lines.push(line);
line=w;
}else line=test;
});

if(line)lines.push(line);
return lines;
}

function share(tamil,sinhala,english){
const c=document.createElement("canvas"),x=c.getContext("2d");
c.width=1080;c.height=1350;

x.fillStyle="#f4f8ff";
x.fillRect(0,0,1080,1350);
x.textAlign="center";

const center=540;

x.fillStyle="#2563eb";
x.font="900 50px Arial";
x.fillText("CreateLK Academy",center,105);

x.fillStyle="#172033";
x.font="900 29px Arial";
x.fillText("DAILY SPOKEN ENGLISH",center,155);

x.fillStyle="#2563eb";
x.font="900 35px Arial";
x.fillText("TODAY'S LESSON",center,245);

const sections=[
{text:tamil,size:36,color:"#172033",weight:"700"},
{text:sinhala,size:29,color:"#475569",weight:"600"},
{text:english,size:38,color:"#172033",weight:"700"}
].filter(v=>v.text);

let all=[];

sections.forEach(s=>{
x.font=`${s.weight} ${s.size}px Arial`;
all.push({...s,lines:wrap(x,s.text,820)});
});

let total=all.reduce((n,s)=>n+s.lines.length*(s.size+16)+30,0);
const area=530,scale=total>area?area/total:1;
let y=320+(area-total*scale)/2;

all.forEach(s=>{
const size=Math.max(22,Math.floor(s.size*scale));
x.fillStyle=s.color;
x.font=`${s.weight} ${size}px Arial`;

s.lines.forEach(line=>{
y+=size+15;
x.fillText(line,center,y);
});

y+=25;
});

x.fillStyle="#7c3aed";
x.font="900 30px Arial";
x.fillText("LEARN. SPEAK. IMPROVE.",center,930);

x.fillStyle="#166534";
x.font="900 28px Arial";
x.fillText("3 FREE LESSONS DAILY",center,995);

x.fillStyle="#2563eb";
x.font="900 37px Arial";
x.fillText("creatlk.com",center,1190);

x.fillStyle="#475569";
x.font="700 25px Arial";
x.fillText("WhatsApp: +94 77 119 0395",center,1235);

c.toBlob(async blob=>{
if(!blob)return;

const file=new File([blob],"creatlk-lesson.png",{type:"image/png"});

if(navigator.share&&navigator.canShare?.({files:[file]})){
try{
await navigator.share({
title:"CreateLK Academy",
text:"Daily Spoken English",
files:[file]
});
}catch(e){}
}else{
const a=document.createElement("a");
a.href=URL.createObjectURL(blob);
a.download="creatlk-lesson.png";
a.click();
setTimeout(()=>URL.revokeObjectURL(a.href),1000);
}
},"image/png");
}

/* Lesson */

async function loadLesson(){
setupDate();
currentLessonDay=getLessonDay();

const premium=updateMembership();

try{
const now=new Date();

const monthDay=
String(now.getMonth()+1).padStart(2,"0")+
"-"+
String(now.getDate()).padStart(2,"0");

const r=await fetch(
LESSON_API+"/api/today?month_day="+encodeURIComponent(monthDay),
{
cache:"no-store",
headers:{Accept:"application/json"}
}
);

if(!r.ok)
throw Error("Lesson service returned HTTP "+r.status+".");

const dialogues=normalize(await r.json());

if(dialogues.length<3)
throw Error("Today's lesson has fewer than 3 dialogues.");

firstTamil=ta(dialogues[0]);
firstSinhala=si(dialogues[0]);
firstEnglish=en(dialogues[0]);

const grid=$("lessonGrid");
grid.innerHTML="";

const max=premium?Math.min(10,dialogues.length):3;

for(let i=0;i<max;i++)
grid.appendChild(createCard(dialogues[i],i));

$("loading").classList.add("hidden");
$("error").classList.add("hidden");
grid.classList.remove("hidden");
$("completeButton").classList.remove("hidden");
$("shareButton").classList.remove("hidden");

await loadProgress();

}catch(e){
console.error("Lesson:",e);
$("loading").classList.add("hidden");
$("error").textContent="⚠️ "+e.message;
$("error").classList.remove("hidden");
}
}

/* Payment */

async function checkout(){
const id=studentId();

if(!id)return location.href="login.html";

try{
const r=await fetch(PAYMENT+"/api/checkout",{
method:"POST",
headers:{"Content-Type":"application/json"},
body:JSON.stringify({student_id:id})
});

const raw=await r.text();

if(!r.ok)throw Error("Unable to open PayHere.");

if(raw.includes("<form")){
document.open();
document.write(raw);
document.close();
return;
}

const d=JSON.parse(raw);

if(d.url||d.checkout_url){
location.href=d.url||d.checkout_url;
return;
}

throw Error("Invalid payment response.");

}catch(e){
console.error(e);
alert(e.message||"Unable to open payment.");
}
}

/* Start */

async function start(){
await refreshStudent();
await loadLesson();
}

start();
</script>

</body>
</html>