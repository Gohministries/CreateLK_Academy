export default {
  async fetch(request) {

    const url = new URL(request.url);

    // CORS
    const headers = {
      "Content-Type": "application/json; charset=UTF-8",
      "Access-Control-Allow-Origin": "*",
      "Access-Control-Allow-Methods": "GET, OPTIONS",
      "Access-Control-Allow-Headers": "Content-Type"
    };

    // OPTIONS
    if (request.method === "OPTIONS") {
      return new Response(null, {
        status: 204,
        headers
      });
    }

    // Only GET
    if (request.method !== "GET") {
      return new Response(
        JSON.stringify({
          success: false,
          error: "Method not allowed"
        }),
        {
          status: 405,
          headers
        }
      );
    }

    // API endpoint
    if (url.pathname === "/api/locations") {

      const locations = LOCATIONS.map((name, index) => ({
        id: index + 1,
        name
      }));

      return new Response(
        JSON.stringify({
          success: true,
          count: locations.length,
          locations
        }),
        {
          status: 200,
          headers
        }
      );
    }

    // Root
    if (url.pathname === "/") {
      return new Response(
        JSON.stringify({
          success: true,
          service: "CreateLK Jobs Locations API",
          endpoint: "/api/locations",
          count: LOCATIONS.length
        }),
        {
          status: 200,
          headers
        }
      );
    }

    // 404
    return new Response(
      JSON.stringify({
        success: false,
        error: "Endpoint not found"
      }),
      {
        status: 404,
        headers
      }
    );
  }
};