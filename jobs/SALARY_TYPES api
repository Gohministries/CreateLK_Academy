const SALARY_TYPES = [
  "Monthly",
  "Weekly",
  "Daily",
  "Hourly",
  "Per Project",
  "Negotiable"
];

export default {
  async fetch(request) {

    const url = new URL(request.url);

    const headers = {
      "Content-Type": "application/json; charset=UTF-8",
      "Access-Control-Allow-Origin": "*",
      "Access-Control-Allow-Methods": "GET, OPTIONS",
      "Access-Control-Allow-Headers": "Content-Type"
    };

    // CORS
    if (request.method === "OPTIONS") {
      return new Response(null, {
        status: 204,
        headers
      });
    }

    // GET only
    if (request.method !== "GET") {
      return new Response(
        JSON.stringify({
          success: false,
          error: "Method not allowed"
        }),
        {
          status: 405,
          headers
        }
      );
    }

    // Salary Types API
    if (url.pathname === "/api/salary-types") {

      const salaryTypes = SALARY_TYPES.map((name, index) => ({
        id: index + 1,
        name
      }));

      return new Response(
        JSON.stringify({
          success: true,
          count: salaryTypes.length,
          salary_types: salaryTypes
        }),
        {
          status: 200,
          headers
        }
      );
    }

    // Root
    if (url.pathname === "/") {

      return new Response(
        JSON.stringify({
          success: true,
          service: "CreateLK Jobs Salary Types API",
          endpoint: "/api/salary-types",
          count: SALARY_TYPES.length
        }),
        {
          status: 200,
          headers
        }
      );
    }

    // 404
    return new Response(
      JSON.stringify({
        success: false,
        error: "Endpoint not found"
      }),
      {
        status: 404,
        headers
      }
    );
  }
};