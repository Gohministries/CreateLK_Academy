// Worker: jobtypesapi.createlk.workers.dev
// ============================================

const JOB_TYPES = [
  "Full-time",
  "Part-time",
  "Contract",
  "Temporary",
  "Internship",
  "Freelance",
  "Volunteer",
  "Commission",
  "Apprenticeship",
  "Remote"
];

export default {
  async fetch(request) {

    const url = new URL(request.url);

    const headers = {
      "Content-Type": "application/json; charset=UTF-8",
      "Access-Control-Allow-Origin": "*",
      "Access-Control-Allow-Methods": "GET, OPTIONS",
      "Access-Control-Allow-Headers": "Content-Type"
    };

    // CORS
    if (request.method === "OPTIONS") {
      return new Response(null, {
        status: 204,
        headers
      });
    }

    // GET only
    if (request.method !== "GET") {
      return new Response(
        JSON.stringify({
          success: false,
          error: "Method not allowed"
        }),
        {
          status: 405,
          headers
        }
      );
    }

    // Job Types API
    if (url.pathname === "/api/job-types") {

      const jobTypes = JOB_TYPES.map((name, index) => ({
        id: index + 1,
        name
      }));

      return new Response(
        JSON.stringify({
          success: true,
          count: jobTypes.length,
          job_types: jobTypes
        }),
        {
          status: 200,
          headers
        }
      );
    }

    // Root
    if (url.pathname === "/") {

      return new Response(
        JSON.stringify({
          success: true,
          service: "CreateLK Jobs Job Types API",
          endpoint: "/api/job-types",
          count: JOB_TYPES.length
        }),
        {
          status: 200,
          headers
        }
      );
    }

    // 404
    return new Response(
      JSON.stringify({
        success: false,
        error: "Endpoint not found"
      }),
      {
        status: 404,
        headers
      }
    );
  }
};