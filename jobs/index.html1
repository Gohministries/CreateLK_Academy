<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">

<title>Find Jobs | CreateLK Jobs</title>
<meta name="description" content="Find jobs and career opportunities across Sri Lanka on CreateLK Jobs.">
<meta name="theme-color" content="#102a56">

<link rel="icon" href="https://jobs.createlk.com/file_00000000f05482118c11cccfc653fd0f.png">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700;800&display=swap" rel="stylesheet">

<style>
*{box-sizing:border-box;margin:0;padding:0}

body{
  font-family:Arial,sans-serif;
  background:#f7f9fc;
  color:#172033;
  line-height:1.5
}

a{text-decoration:none;color:inherit}
button,input,select{font:inherit}
button{cursor:pointer}

.container{
  width:min(1180px,92%);
  margin:auto
}

/* HEADER */
header{
  background:#fff;
  border-bottom:1px solid #e8ecf3;
  position:sticky;
  top:0;
  z-index:1000
}

.header{
  height:72px;
  display:flex;
  align-items:center;
  justify-content:space-between
}

.logo{
  display:flex;
  align-items:center;
  gap:9px;
  font-weight:800;
  font-size:20px;
  color:#102a56
}

.logo img{
  width:40px;
  height:40px;
  object-fit:contain;
  border-radius:8px
}

.nav{
  display:flex;
  align-items:center;
  gap:22px;
  font-size:14px;
  font-weight:700
}

.nav a{color:#435069}

.login{
  border:1px solid #d7deea;
  padding:9px 16px;
  border-radius:8px;
  color:#102a56!important
}

.post{
  background:#102a56;
  color:#fff!important;
  padding:10px 17px;
  border-radius:8px
}

.menu{
  display:none;
  background:none;
  border:0;
  font-size:27px;
  color:#102a56
}

.mobile{
  display:none;
  background:#fff;
  border-top:1px solid #eee;
  padding:10px 4%
}

.mobile a{
  display:block;
  padding:12px 0;
  border-bottom:1px solid #eee;
  font-weight:700;
  color:#435069
}

.mobile-post{
  background:#102a56!important;
  color:#fff!important;
  padding:12px 15px!important;
  border-radius:8px;
  margin:10px 0;
  text-align:center
}

/* HERO */
.hero{
  padding:50px 0 38px;
  background:
    radial-gradient(circle at 15% 20%,#dcecff 0,transparent 35%),
    radial-gradient(circle at 85% 30%,#fff0c7 0,transparent 35%),
    linear-gradient(135deg,#f8fbff,#eef3ff,#fffaf1)
}

.hero-content{text-align:center}

.badge{
  display:inline-block;
  background:#fff;
  border:1px solid #dce4f0;
  color:#102a56;
  padding:7px 14px;
  border-radius:30px;
  font-size:12px;
  font-weight:800;
  margin-bottom:14px
}

h1,h2{
  font-family:"Playfair Display",serif;
  color:#102a56
}

h1{
  font-size:clamp(38px,5vw,54px);
  line-height:1.1;
  margin-bottom:10px
}

.hero p{
  font-size:15px;
  color:#68748a
}

.hero-post{
  display:inline-flex;
  margin-top:22px;
  padding:12px 22px;
  background:#d69b16;
  color:#fff;
  font-size:14px;
  font-weight:800;
  border-radius:9px
}

/* SEARCH */
.search-section{padding:25px 0 10px}

.search{
  background:#fff;
  border:1px solid #e1e6ee;
  border-radius:14px;
  padding:14px;
  box-shadow:0 12px 35px #102a561a;
  display:grid;
  grid-template-columns:1.3fr 1fr 1fr auto;
  gap:9px
}

.search input,
.search select{
  height:47px;
  border:1px solid #dce2eb;
  border-radius:8px;
  padding:0 13px;
  outline:0;
  background:#fff;
  color:#344057;
  min-width:0
}

.search input:focus,
.search select:focus{
  border-color:#102a56
}

.search button{
  height:47px;
  border:0;
  border-radius:8px;
  background:#102a56;
  color:#fff;
  font-weight:800;
  padding:0 22px
}

/* RESULTS */
.results-section{
  padding:45px 0 70px
}

.results-head{
  display:flex;
  justify-content:space-between;
  align-items:end;
  gap:15px;
  margin-bottom:25px
}

.results-head h2{font-size:32px}

.results-head p{
  font-size:13px;
  color:#68748a;
  margin-top:4px
}

.result-count{
  font-size:13px;
  font-weight:800;
  color:#102a56
}

.jobs{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:17px
}

.job{
  background:#fff;
  border:1px solid #e3e8f0;
  border-radius:13px;
  padding:21px;
  transition:.2s
}

.job:hover{
  transform:translateY(-4px);
  box-shadow:0 12px 28px #102a5614
}

.job-top{
  display:flex;
  justify-content:space-between;
  gap:10px;
  margin-bottom:14px
}

.title{
  font-size:16px;
  font-weight:800;
  line-height:1.35
}

.company{
  font-size:12px;
  font-weight:700;
  color:#59657a;
  margin-top:4px
}

.badge-job{
  font-size:10px;
  font-weight:800;
  background:#fff4d7;
  color:#966800;
  padding:5px 7px;
  border-radius:5px;
  white-space:nowrap
}

.meta{
  display:flex;
  flex-wrap:wrap;
  gap:6px;
  margin-bottom:16px
}

.meta span{
  font-size:11px;
  background:#f4f6fa;
  color:#5b6679;
  padding:5px 7px;
  border-radius:5px
}

.bottom{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:10px;
  border-top:1px solid #edf0f4;
  padding-top:14px
}

.salary{
  font-size:12px;
  font-weight:800;
  color:#102a56
}

.job-link{
  font-size:12px;
  font-weight:800;
  color:#102a56;
  white-space:nowrap
}

.status{
  background:#fff;
  border:1px solid #e3e8f0;
  border-radius:14px;
  padding:45px 20px;
  text-align:center;
  color:#68748a;
  font-size:14px;
  grid-column:1/-1
}

.status strong{
  display:block;
  font-size:17px;
  color:#102a56;
  margin-bottom:5px
}

/* FOOTER */
footer{
  background:#0c1e3c;
  color:#aebbd0
}

.footer{
  min-height:90px;
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:20px;
  font-size:12px
}

.legal{
  display:flex;
  gap:9px;
  flex-wrap:wrap
}

.legal a{color:#c8d2e1}
.legal span{color:#63738d}

/* WHATSAPP */
.whatsapp{
  position:fixed;
  right:18px;
  bottom:18px;
  width:52px;
  height:52px;
  border-radius:50%;
  background:#25D366;
  display:flex;
  align-items:center;
  justify-content:center;
  box-shadow:0 5px 18px #0003;
  z-index:9999
}

.whatsapp svg{
  width:29px;
  height:29px;
  fill:#fff
}

/* RESPONSIVE */
@media(max-width:900px){
  .nav{display:none}
  .menu{display:block}

  .search{
    grid-template-columns:1fr 1fr
  }

  .jobs{
    grid-template-columns:repeat(2,1fr)
  }
}

@media(max-width:600px){
  .header{height:65px}

  .logo{font-size:18px}

  .logo img{
    width:35px;
    height:35px
  }

  .hero{
    padding:42px 0 35px
  }

  h1{font-size:38px}

  .search{
    grid-template-columns:1fr;
    padding:11px
  }

  .results-section{
    padding:35px 0 55px
  }

  .results-head{
    display:block;
    text-align:center
  }

  .results-head h2{font-size:29px}

  .result-count{margin-top:8px}

  .jobs{
    grid-template-columns:1fr
  }

  .footer{
    padding:25px 0;
    display:block;
    text-align:center
  }

  .legal{
    justify-content:center;
    margin-bottom:12px
  }

  .whatsapp{
    right:14px;
    bottom:14px;
    width:48px;
    height:48px
  }
}
</style>
</head>

<body>

<header>
  <div class="container header">

    <a href="/" class="logo">
      <img
        src="https://jobs.createlk.com/file_00000000f05482118c11cccfc653fd0f.png"
        alt="CreateLK Jobs"
      >
      <span>CreateLK Jobs</span>
    </a>

    <nav class="nav">
      <a href="/">Home</a>
      <a href="/jobs/">Find Jobs</a>
      <a href="/categories/">Categories</a>
      <a href="/companies/">Companies</a>
      <a href="/jobs/login.html" class="login">Sign In</a>
      <a href="/jobs/login.html" class="post">Post a Job</a>
    </nav>

    <button class="menu" id="menuBtn">☰</button>
  </div>

  <div class="mobile" id="mobile">
    <a href="/">Home</a>
    <a href="/jobs/">Find Jobs</a>
    <a href="/categories/">Categories</a>
    <a href="/companies/">Companies</a>
    <a href="/jobs/login.html">Sign In</a>
    <a href="/jobs/login.html" class="mobile-post">➕ Post a Job</a>
  </div>
</header>


<section class="hero">
  <div class="container hero-content">

    <div class="badge">🇱🇰 Sri Lanka Job Marketplace</div>

    <h1>Find Jobs</h1>

    <p>
      Search jobs and career opportunities across Sri Lanka.
    </p>

    <a href="/jobs/login.html" class="hero-post">
      ➕ Post a Job
    </a>

  </div>
</section>


<section class="search-section">
  <div class="container">

    <form class="search" id="searchForm">

      <input
        id="keyword"
        type="search"
        placeholder="Job title, keyword, company..."
        autocomplete="off"
      >

      <select id="category">
        <option value="">Loading categories...</option>
      </select>

      <select id="location">
        <option value="">Loading locations...</option>
      </select>

      <button type="submit">
        🔎 Search Jobs
      </button>

    </form>

  </div>
</section>


<section class="results-section">
  <div class="container">

    <div class="results-head">

      <div>
        <h2>Latest Jobs</h2>
        <p id="resultText">Loading jobs...</p>
      </div>

      <div class="result-count" id="resultCount"></div>

    </div>

    <div class="jobs" id="jobsGrid">

      <div class="status">
        <strong>Loading jobs...</strong>
        Please wait.
      </div>

    </div>

  </div>
</section>


<footer>
  <div class="container footer">

    <div class="legal">
      <a href="/jobs/terms.html">Terms & Conditions</a>
      <span>•</span>
      <a href="/jobs/privacy.html">Privacy Policy</a>
      <span>•</span>
      <a href="/jobs/refund.html">Refund Policy</a>
      <span>•</span>
      <a href="/jobs/payment.html">Payment Policy</a>
      <span>•</span>
      <a href="/jobs/cookies.html">Cookies</a>
      <span>•</span>
      <a href="/jobs/disclaimer.html">Disclaimer</a>
    </div>

    <div>© 2026 CreateLK Jobs. All rights reserved.</div>

  </div>
</footer>


<a
  class="whatsapp"
  href="https://wa.me/94771190395"
  target="_blank"
  rel="noopener"
  aria-label="WhatsApp"
>
  <svg viewBox="0 0 24 24">
    <path d="M20.5 3.5A11.8 11.8 0 0 0 12.1 0C5.5 0 .2 5.3.2 11.9c0 2.1.6 4.1 1.6 5.9L.1 24l6.4-1.7a11.9 11.9 0 0 0 5.6 1.4h.1c6.5 0 11.8-5.3 11.8-11.9 0-3.1-1.2-6.1-3.5-8.3zM12.1 21.7c-1.8 0-3.5-.5-5-1.3l-.4-.2-3.8 1 1-3.7-.2-.4a9.8 9.8 0 0 1-1.5-5.2c0-5.4 4.4-9.8 9.9-9.8 2.6 0 5.1 1 6.9 2.9 1.9 1.9 2.9 4.3 2.9 6.9 0 5.4-4.4 9.8-9.8 9.8zm5.4-7.3c-.3-.2-1.8-.9-2.1-1-.3-.1-.5-.2-.7.2-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-1.5-.7-2.5-1.2-3.5-2.7-.3-.5.3-.5.8-1.6.1-.2.1-.4 0-.6-.1-.2-.7-1.7-.9-2.3-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.1 1.1-1.1 2.6s1.1 3 1.3 3.2c.2.2 2.2 3.4 5.3 4.7 2 .9 2.8 1 3.8.8.6-.1 1.8-.7 2.1-1.4.3-.7.3-1.3.2-1.4-.1-.2-.3-.3-.6-.4z"/>
  </svg>
</a>


<script>
const JOBS_API =
  "https://createlk-jobs-api-v2.createlk.workers.dev";

const CATEGORIES_API =
  "https://categoriesapi.createlk.workers.dev";

const LOCATIONS_API =
  "https://locationsapi.createlk.workers.dev";

const JOB_TYPES_API =
  "https://jobtypesapi.createlk.workers.dev";

const EXPERIENCE_API =
  "https://experiencelevelsapi.createlk.workers.dev";

let allJobs = [];


/* MOBILE MENU */

document.getElementById("menuBtn").onclick = () => {

  const mobile =
    document.getElementById("mobile");

  mobile.style.display =
    mobile.style.display === "block"
      ? "none"
      : "block";
};


/* ESCAPE */

function esc(value) {
  return String(value ?? "")
    .replace(/[&<>"']/g, c => ({
      "&":"&amp;",
      "<":"&lt;",
      ">":"&gt;",
      '"':"&quot;",
      "'":"&#039;"
    }[c]));
}


/* API ARRAY */

function getArray(data, key) {

  if (Array.isArray(data))
    return data;

  if (
    data &&
    Array.isArray(data[key])
  )
    return data[key];

  if (
    data &&
    Array.isArray(data.data)
  )
    return data.data;

  if (
    data &&
    Array.isArray(data.results)
  )
    return data.results;

  if (
    data &&
    Array.isArray(data.items)
  )
    return data.items;

  return [];
}


/* NAME */

function itemName(item) {

  if (typeof item === "string")
    return item;

  return (
    item?.name ||
    item?.title ||
    item?.label ||
    item?.category_name ||
    item?.location_name ||
    ""
  );
}


/* LOAD SELECT */

function fillSelect(
  id,
  items,
  firstText
) {

  const select =
    document.getElementById(id);

  select.innerHTML =
    `<option value="">${firstText}</option>`;

  const used = new Set();

  items.forEach(item => {

    const name =
      String(itemName(item)).trim();

    if (!name)
      return;

    const key =
      name.toLowerCase();

    if (used.has(key))
      return;

    used.add(key);

    const option =
      document.createElement("option");

    option.value = name;
    option.textContent = name;

    select.appendChild(option);
  });
}


/* LOAD CATEGORIES */

async function loadCategories() {

  const response =
    await fetch(
      CATEGORIES_API + "/api/categories",
      {cache:"no-store"}
    );

  if (!response.ok)
    throw new Error("Categories failed");

  const data =
    await response.json();

  fillSelect(
    "category",
    getArray(data,"categories"),
    "All Categories"
  );
}


/* LOAD LOCATIONS */

async function loadLocations() {

  const response =
    await fetch(
      LOCATIONS_API + "/api/locations",
      {cache:"no-store"}
    );

  if (!response.ok)
    throw new Error("Locations failed");

  const data =
    await response.json();

  fillSelect(
    "location",
    getArray(data,"locations"),
    "All Locations"
  );
}


/* LOAD JOB TYPES */

async function loadJobTypes() {

  try {

    const response =
      await fetch(
        JOB_TYPES_API + "/api/job-types",
        {cache:"no-store"}
      );

    if (!response.ok)
      return;

    const data =
      await response.json();

    console.log(
      "Job types:",
      getArray(data,"job_types")
    );

  } catch(e) {

    console.log(
      "Job types API:",
      e.message
    );

  }
}


/* LOAD EXPERIENCE */

async function loadExperience() {

  try {

    const response =
      await fetch(
        EXPERIENCE_API +
        "/api/experience-levels",
        {cache:"no-store"}
      );

    if (!response.ok)
      return;

    const data =
      await response.json();

    console.log(
      "Experience:",
      getArray(data,"experience_levels")
    );

  } catch(e) {

    console.log(
      "Experience API:",
      e.message
    );

  }
}


/* LOAD JOBS */

async function loadJobs() {

  const response =
    await fetch(
      JOBS_API + "/api/jobs",
      {cache:"no-store"}
    );

  if (!response.ok)
    throw new Error("Jobs failed");

  const data =
    await response.json();

  allJobs =
    getArray(data,"jobs");

  renderJobs(allJobs);
}


/* SALARY */

function salary(job) {

  const min =
    job.salary_min != null
      ? Number(job.salary_min)
          .toLocaleString()
      : "";

  const max =
    job.salary_max != null
      ? Number(job.salary_max)
          .toLocaleString()
      : "";

  if (min && max)
    return `LKR ${min} – ${max}`;

  if (min)
    return `From LKR ${min}`;

  if (max)
    return `Up to LKR ${max}`;

  return "Salary not specified";
}


/* RENDER */

function renderJobs(jobs) {

  const grid =
    document.getElementById("jobsGrid");

  const count =
    document.getElementById("resultCount");

  const text =
    document.getElementById("resultText");

  count.textContent =
    `${jobs.length} ${jobs.length === 1 ? "Job" : "Jobs"}`;

  text.textContent =
    jobs.length
      ? "Showing available jobs."
      : "No matching jobs found.";

  if (!jobs.length) {

    grid.innerHTML = `
      <div class="status">
        <strong>No jobs available.</strong>
        Try another search.
      </div>
    `;

    return;
  }


  grid.innerHTML =
    jobs.map(job => {

      const title =
        job.title || "Untitled Job";

      const company =
        job.company_name || "Employer";

      const location =
        job.location || "";

      const category =
        job.category || "";

      const type =
        job.job_type || "";

      const experience =
        job.experience || "";

      const premium =
        String(job.ad_type || "")
          .toLowerCase() === "premium";


      return `
        <article class="job">

          <div class="job-top">

            <div>

              <div class="title">
                ${esc(title)}
              </div>

              <div class="company">
                ${esc(company)}
              </div>

            </div>

            ${
              premium
              ? `<span class="badge-job">Premium</span>`
              : ""
            }

          </div>


          <div class="meta">

            ${
              location
              ? `<span>📍 ${esc(location)}</span>`
              : ""
            }

            ${
              type
              ? `<span>💼 ${esc(type)}</span>`
              : ""
            }

            ${
              experience
              ? `<span>⭐ ${esc(experience)}</span>`
              : ""
            }

            ${
              category
              ? `<span>📁 ${esc(category)}</span>`
              : ""
            }

          </div>


          <div class="bottom">

            <span class="salary">
              ${salary(job)}
            </span>

            <a
              class="job-link"
              href="/jobs/job-details.html?id=${encodeURIComponent(job.id)}"
            >
              View Job →
            </a>

          </div>

        </article>
      `;

    }).join("");
}


/* SEARCH */

document.getElementById("searchForm")
  .addEventListener("submit", event => {

    event.preventDefault();

    const keyword =
      document.getElementById("keyword")
        .value
        .trim()
        .toLowerCase();

    const category =
      document.getElementById("category")
        .value
        .trim()
        .toLowerCase();

    const location =
      document.getElementById("location")
        .value
        .trim()
        .toLowerCase();


    const results =
      allJobs.filter(job => {

        const text = [

          job.title,
          job.company_name,
          job.description,
          job.location,
          job.category,
          job.job_type,
          job.experience

        ]
        .filter(Boolean)
        .join(" ")
        .toLowerCase();


        return (

          (!keyword ||
            text.includes(keyword))

          &&

          (!category ||
            String(job.category || "")
              .toLowerCase() === category)

          &&

          (!location ||
            String(job.location || "")
              .toLowerCase() === location)

        );

      });


    renderJobs(results);

  });


/* START */

async function start() {

  try {

    await Promise.all([
      loadJobs(),
      loadCategories(),
      loadLocations(),
      loadJobTypes(),
      loadExperience()
    ]);

  } catch(error) {

    console.error(error);

    document.getElementById(
      "resultText"
    ).textContent =
      "Unable to load job data.";

    document.getElementById(
      "jobsGrid"
    ).innerHTML = `
      <div class="status">
        <strong>Unable to load jobs.</strong>
        Please try again later.
      </div>
    `;

  }

}

start();
</script>

</body>
</html>