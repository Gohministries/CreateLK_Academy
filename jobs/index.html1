<!DOCTYPE html><html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>CreateLK Jobs | Sri Lanka Jobs</title>
<meta name="description" content="Find jobs and hire talent in Sri Lanka.">
<meta name="theme-color" content="#102a56">
<link rel="icon" href="https://assets.createlk.com/file_00000000f05482118c11cccfc653fd0f.png"><link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet"><style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:Arial,sans-serif;background:#f7f9fc;color:#172033}
a{text-decoration:none;color:inherit}
button,input,select{font:inherit}
.container{width:min(1120px,92%);margin:auto}

header{background:#fff;border-bottom:1px solid #e7ebf2;position:sticky;top:0;z-index:1000}
.header{min-height:70px;display:flex;align-items:center;justify-content:space-between}
.logo{display:flex;align-items:center;gap:9px;color:#102a56;font-size:19px;font-weight:800}
.logo img{width:40px;height:40px;object-fit:contain}

.nav{display:flex;gap:18px;align-items:center}
.nav a{font-size:13px;font-weight:700;color:#455168}
.login{border:1px solid #d9e0ea;padding:9px 14px;border-radius:7px}
.register{background:#102a56;color:#fff!important;padding:10px 15px;border-radius:7px}
.post{background:#d69b16;color:#fff!important;padding:10px 15px;border-radius:7px}

.header-tools{display:none;align-items:center;gap:20px}
.search-toggle{width:40px;height:40px;border:1px solid #d9e0ea;border-radius:7px;background:#fff;color:#102a56;font-size:18px;cursor:pointer}
.menu{display:none;border:0;background:none;font-size:26px;color:#102a56;cursor:pointer}

.mobile-menu{display:none;background:#fff;padding:10px 5%;border-top:1px solid #eee}
.mobile-menu a{display:block;text-align:center;padding:10px;font-size:13px;font-weight:700}
.mobile-post{background:#d69b16;color:#fff!important;border-radius:7px}

.search-panel{display:none;background:#fff;border-top:1px solid #e7ebf2;padding:12px 0}
.search-panel.active{display:block}

.search{display:flex;gap:8px}
.search input{
width:100%;
height:43px;
border:1px solid #dce2ea;
border-radius:7px;
padding:0 12px;
background:#fff;
color:#3e4a60;
font-size:13px;
outline:none
}
.search input:focus{border-color:#102a56}

.filters{
display:grid;
grid-template-columns:repeat(4,1fr);
gap:8px;
margin-top:8px
}

.filters select{
height:40px;
border:1px solid #dce2ea;
border-radius:7px;
padding:0 10px;
background:#fff;
color:#3e4a60;
font-size:12px;
outline:none
}

.filters select:focus{border-color:#102a56}
.filters select:disabled{background:#f1f4f8;color:#8993a4}

.search-button{
width:100%;
height:40px;
margin-top:8px;
border:0;
border-radius:7px;
background:#102a56;
color:#fff;
font-size:13px;
font-weight:800;
cursor:pointer
}

.search-button:hover{opacity:.95}

.hero{padding:55px 0 65px;background:linear-gradient(135deg,#f9fbff,#eef3fb)}
.hero-content{text-align:center;max-width:760px;margin:auto}
.badge{display:inline-block;background:#fff;border:1px solid #dce3ed;color:#102a56;padding:7px 13px;border-radius:30px;font-size:12px;font-weight:800;margin-bottom:16px}
.hero h1{font-family:"Playfair Display",serif;color:#102a56;font-size:clamp(34px,5vw,50px);line-height:1.15;margin-bottom:12px}
.hero h1 span{color:#d69b16}
.hero p{color:#667287;font-size:14px}
.hero-actions{display:flex;justify-content:center;gap:10px;margin-top:20px}

.btn{display:inline-flex;align-items:center;justify-content:center;height:42px;padding:0 18px;border-radius:7px;background:#102a56;color:#fff;font-size:13px;font-weight:800}
.btn-gold{background:#d69b16}

.section{padding:50px 0 0}
.section-heading{text-align:center;margin-bottom:22px}
.section-heading h2{font-family:"Playfair Display",serif;color:#102a56;font-size:28px}
.section-heading p{color:#718096;font-size:12px}

.jobs{display:flex;flex-direction:column;align-items:center;gap:12px}
.job{
width:100%;
max-width:850px;
background:#fff;
border:1px solid #e1e6ee;
border-radius:10px;
overflow:hidden;
box-shadow:0 3px 12px rgba(16,42,86,.03)
}

.job-main{display:grid;grid-template-columns:200px 1fr}
.photo-wrap{width:200px;height:200px;aspect-ratio:1/1}
.job-photo,.no-photo{
width:200px;
height:200px;
aspect-ratio:1/1;
object-fit:cover;
display:block
}

.no-photo{
display:flex;
align-items:center;
justify-content:center;
background:#eef2f7;
color:#718096;
font-size:12px;
font-weight:700
}

.job-content{
padding:15px 20px;
display:flex;
flex-direction:column;
align-items:center;
justify-content:center;
text-align:center
}

.job-location{
color:#6b7280;
font-size:10px;
font-weight:700;
margin-bottom:5px
}

.job-title{
font-family:"Playfair Display",serif;
color:#102a56;
font-size:19px;
font-weight:700;
line-height:1.25;
margin-bottom:5px
}

.description{
max-width:550px;
color:#68748a;
font-size:12px;
line-height:1.5;
display:-webkit-box;
-webkit-line-clamp:2;
-webkit-box-orient:vertical;
overflow:hidden
}

.job-actions{
display:grid;
grid-template-columns:1fr 1fr;
gap:8px;
padding:8px;
border-top:1px solid #edf0f4
}

.contact-btn{
height:38px;
display:flex;
align-items:center;
justify-content:center;
border-radius:6px;
border:0;
font-size:12px;
font-weight:800
}

.whatsapp{background:#168b45;color:#fff}
.call{background:#102a56;color:#fff}
.disabled{background:#e3e7ed;color:#8993a4}

.status{
width:100%;
max-width:850px;
text-align:center;
background:#fff;
border:1px solid #e1e6ee;
border-radius:10px;
padding:25px;
color:#718096;
font-size:12px
}

.status strong{
display:block;
color:#102a56;
margin-bottom:3px
}

.more-jobs{text-align:center;margin-top:18px}

.cta-section{padding:50px 0 60px}
.cta{
background:#102a56;
border-radius:12px;
padding:30px;
text-align:center;
color:#fff
}

.cta h2{
font-family:"Playfair Display",serif;
font-size:26px
}

.cta p{
color:#cbd5e4;
font-size:12px;
margin:5px 0 17px
}

.cta .btn{background:#d69b16}

footer{
background:#0c1e3c;
color:#aebbd0;
text-align:center
}

.footer{
padding:25px 0;
display:flex;
justify-content:center;
align-items:center;
gap:24px;
flex-wrap:wrap
}

.footer h3{
color:#fff;
font-size:14px;
margin-right:5px
}

.footer a{font-size:12px}

.copyright{
border-top:1px solid #263a58;
padding:16px;
font-size:11px
}

@media(max-width:1000px){
.nav{gap:10px}
.nav a{font-size:11px}
.filters{grid-template-columns:repeat(2,1fr)}
}

@media(max-width:700px){
.container{width:90%}
.nav{display:none}
.header-tools{display:flex}
.menu{display:block}
.hero{padding:45px 0 55px}
.hero h1{font-size:35px}
.hero-actions{flex-direction:column;align-items:center}
.hero-actions .btn{width:100%;max-width:280px}
.filters{grid-template-columns:1fr 1fr}
.section{padding-top:45px}
.job-main{grid-template-columns:1fr}
.photo-wrap,.job-photo,.no-photo{
width:100%;
height:auto;
aspect-ratio:1/1
}
.job-content{padding:15px}
}

@media(max-width:450px){
.header-tools{gap:22px}
.search{gap:6px}
.filters{grid-template-columns:1fr}
.hero h1{font-size:31px}
.footer{gap:14px}
}
</style></head><body><header><div class="container header"><a href="index.html" class="logo">
<img src="https://assets.createlk.com/file_00000000f05482118c11cccfc653fd0f.png" alt="CreateLK Jobs">
<span>CreateLK Jobs</span>
</a><nav class="nav">
<a href="index.html">Home</a>
<a href="LK/jobs.html">Find Jobs</a>
<a href="LK/categories.html">Categories</a>
<a href="LK/companies.html">Companies</a>
<a href="LK/login.html" class="login">Login</a>
<a href="LK/register.html" class="register">Register</a>
<a href="LK/login.html" class="post">Post a Job</a>
</nav><div class="header-tools">
<button class="search-toggle" id="searchToggle" aria-label="Search">🔎</button>
<button class="menu" id="menuBtn" aria-label="Menu">☰</button>
</div></div><div class="mobile-menu" id="mobileMenu">
<a href="index.html">Home</a>
<a href="LK/jobs.html">Find Jobs</a>
<a href="LK/categories.html">Categories</a>
<a href="LK/companies.html">Companies</a>
<a href="LK/login.html">Login</a>
<a href="LK/register.html">Register</a>
<a href="LK/login.html" class="mobile-post">➕ Post a Job</a>
</div><div class="search-panel" id="searchPanel"><div class="container"><form class="search" id="searchForm">
<input id="searchInput" type="search" placeholder="Search jobs, companies, categories or locations..." autocomplete="off">
</form><div class="filters"><select id="province">
<option value="">All Provinces</option>
</select><select id="district" disabled>
<option value="">All Districts</option>
</select><select id="city" disabled>
<option value="">All Cities</option>
</select><select id="category">
<option value="">All Categories</option>
</select></div><button type="submit" form="searchForm" class="search-button">
Search
</button></div>
</div></header><main><section class="hero"><div class="container hero-content"><div class="badge">🇱🇰 Sri Lanka Job Marketplace</div><h1>Find Your Next <span>Opportunity</span></h1><p>Discover jobs, connect with employers and take the next step in your career.</p><div class="hero-actions">
<a href="LK/jobs.html" class="btn">🔎 Find Jobs</a>
<a href="LK/login.html" class="btn btn-gold">➕ Post a Job</a>
</div></div>
</section><section class="section" id="resultsSection"><div class="container"><div class="section-heading">
<h2>Recent Jobs</h2>
<p>Latest approved job opportunities.</p>
</div><div class="jobs" id="featuredJobs">
<div class="status">
<strong>Loading jobs...</strong>
Please wait.
</div>
</div><div class="more-jobs">
<a href="LK/jobs.html" class="btn">More Jobs</a>
</div></div>
</section><section class="cta-section"><div class="container"><div class="cta">
<h2>Are You Hiring?</h2>
<p>Post your vacancy and connect with talented people.</p>
<a href="LK/login.html" class="btn">Post a Job</a>
</div></div>
</section></main><footer><div class="container footer">
<h3>Legal</h3>
<a href="LK/terms.html">Terms</a>
<a href="LK/privacy.html">Privacy</a>
<a href="LK/refund.html">Refund</a>
</div><div class="copyright">
© 2026 CreateLK Jobs. All rights reserved.
</div></footer><script>
const ADS_API="https://ads.createlk.workers.dev";
const CATEGORY_API="https://categories.createlk.workers.dev";

const category=document.getElementById("category");
const province=document.getElementById("province");
const district=document.getElementById("district");
const city=document.getElementById("city");
const searchInput=document.getElementById("searchInput");
const searchForm=document.getElementById("searchForm");
const jobsBox=document.getElementById("featuredJobs");
const searchPanel=document.getElementById("searchPanel");
const resultsSection=document.getElementById("resultsSection");
const mobileMenu=document.getElementById("mobileMenu");

let approvedAds=[];

document.getElementById("menuBtn").onclick=()=>{
mobileMenu.style.display=
mobileMenu.style.display==="block"
?"none"
:"block";
};

document.getElementById("searchToggle").onclick=()=>{
searchPanel.classList.toggle("active");

if(searchPanel.classList.contains("active")){
searchInput.focus();
}
};

async function getJSON(url){

const response=await fetch(
url,
{cache:"no-store"}
);

if(!response.ok){
throw new Error("HTTP "+response.status);
}

return response.json();

}

function esc(value){

return String(value??"").replace(
/[&<>"']/g,
c=>({
"&":"&amp;",
"<":"&lt;",
">":"&gt;",
'"':"&quot;",
"'":"&#039;"
}[c])
);

}

function normalize(value){

return String(value??"")
.trim()
.toLowerCase();

}

function cleanPhone(value){

let p=String(value||"")
.replace(/[^\d+]/g,"");

if(p.startsWith("+")){
p=p.substring(1);
}

if(p.startsWith("0")){
p="94"+p.substring(1);
}

return p;

}

function getPhoto(value){

if(!value)return "";

if(/^https?:\/\//i.test(value)){
return value;
}

return ADS_API+
"/photo?key="+
encodeURIComponent(value);

}

function valueText(ad,keys){

for(const key of keys){

if(
ad&&
ad[key]!==undefined&&
ad[key]!==null&&
String(ad[key]).trim()!==""
){

return String(ad[key]);

}

}

return "";

}

async function loadCategories(){

try{

const data=
await getJSON(
CATEGORY_API+"/categories"
);

const list=
Array.isArray(data.categories)
?data.categories
:Array.isArray(data)
?data
:[];

category.innerHTML=
'<option value="">All Categories</option>';

list.forEach(item=>{

const name=
item.name??
item.slug??
"";

if(!name){
return;
}

if(normalize(name)==="other"){
return;
}

const option=
document.createElement("option");

option.value=
item.id??
item.slug??
item.name??
"";

option.textContent=name;

option.dataset.name=
item.name??"";

option.dataset.slug=
item.slug??"";

category.appendChild(option);

});

}catch(e){

console.error(
"Category loading error:",
e
);

}

}

async function loadProvinces(){

try{

const data=
await getJSON(
ADS_API+"/locations"
);

const list=
Array.isArray(data.provinces)
?data.provinces
:[];

province.innerHTML=
'<option value="">All Provinces</option>';

list.forEach(item=>{

const option=
document.createElement("option");

if(typeof item==="object"){

option.value=
item.name??
item.province??
"";

option.textContent=
item.name??
item.province??
"";

}else{

option.value=
String(item);

option.textContent=
String(item);

}

if(option.value){
province.appendChild(option);
}

});

}catch(e){

console.error(
"Province loading error:",
e
);

}

}

async function loadDistricts(name){

district.innerHTML=
'<option value="">All Districts</option>';

city.innerHTML=
'<option value="">All Cities</option>';

district.disabled=true;
city.disabled=true;

if(!name){
return;
}

try{

const data=
await getJSON(
ADS_API+
"/locations?province="+
encodeURIComponent(name)
);

const list=
Array.isArray(data.districts)
?data.districts
:[];

list.forEach(item=>{

const option=
document.createElement("option");

if(typeof item==="object"){

option.value=
item.name??
item.district??
"";

option.textContent=
item.name??
item.district??
"";

}else{

option.value=
String(item);

option.textContent=
String(item);

}

if(option.value){
district.appendChild(option);
}

});

district.disabled=
district.options.length<=1;

}catch(e){

console.error(
"District loading error:",
e
);

}

}

async function loadCities(p,d){

city.innerHTML=
'<option value="">All Cities</option>';

city.disabled=true;

if(!p||!d){
return;
}

try{

const data=
await getJSON(
ADS_API+
"/locations?province="+
encodeURIComponent(p)+
"&district="+
encodeURIComponent(d)
);

const list=
Array.isArray(data.cities)
?data.cities
:[];

list.forEach(item=>{

const option=
document.createElement("option");

if(typeof item==="object"){

option.value=
item.name??
item.city??
"";

option.textContent=
item.name??
item.city??
"";

}else{

option.value=
String(item);

option.textContent=
String(item);

}

if(option.value){
city.appendChild(option);
}

});

city.disabled=
city.options.length<=1;

}catch(e){

console.error(
"City loading error:",
e
);

}

}

province.onchange=async()=>{

await loadDistricts(
province.value
);

};

district.onchange=async()=>{

await loadCities(
province.value,
district.value
);

};

searchForm.onsubmit=e=>{

e.preventDefault();

filterJobs();

resultsSection.scrollIntoView({
behavior:"smooth",
block:"start"
});

};

function categoryMatch(ad){

const selected=
normalize(category.value);

if(!selected){
return true;
}

const option=
category.options[
category.selectedIndex
];

const selectedName=
normalize(
option?.dataset.name
);

const selectedSlug=
normalize(
option?.dataset.slug
);

const adId=
normalize(
valueText(ad,[
"category_id",
"categoryId",
"categoryID"
])
);

const adCategory=
normalize(
valueText(ad,[
"category",
"category_name",
"categoryName",
"category_slug",
"categorySlug"
])
);

return(
adId===selected||
adCategory===selected||
adCategory===selectedName||
adCategory===selectedSlug
);

}

function filterJobs(){

const q=
normalize(searchInput.value);

const p=
normalize(province.value);

const d=
normalize(district.value);

const c=
normalize(city.value);

const filtered=
approvedAds.filter(ad=>{

const title=
normalize(
valueText(ad,[
"title",
"job_title",
"jobTitle"
])
);

const description=
normalize(
valueText(ad,[
"description",
"details",
"job_description",
"jobDescription"
])
);

const company=
normalize(
valueText(ad,[
"company",
"company_name",
"companyName",
"employer",
"employer_name",
"employerName"
])
);

const categoryText=
normalize(
valueText(ad,[
"category",
"category_name",
"categoryName",
"category_slug",
"categorySlug"
])
);

const adProvince=
normalize(
valueText(ad,[
"province",
"province_name",
"provinceName"
])
);

const adDistrict=
normalize(
valueText(ad,[
"district",
"district_name",
"districtName"
])
);

const adCity=
normalize(
valueText(ad,[
"city",
"city_name",
"cityName"
])
);

const keywordMatch=
!q||
title.includes(q)||
description.includes(q)||
company.includes(q)||
categoryText.includes(q)||
adProvince.includes(q)||
adDistrict.includes(q)||
adCity.includes(q);

return(
keywordMatch&&
(!p||adProvince===p)&&
(!d||adDistrict===d)&&
(!c||adCity===c)&&
categoryMatch(ad)
);

});

renderJobs(filtered);

}

async function loadJobs(){

jobsBox.innerHTML=`
<div class="status">
<strong>Loading jobs...</strong>
Please wait.
</div>
`;

try{

const data=
await getJSON(
ADS_API+"/latest"
);

approvedAds=
Array.isArray(data.ads)
?data.ads
:Array.isArray(data)
?data
:[];

approvedAds.sort((a,b)=>{

const aDate=
Date.parse(
a.approved_at||
a.created_at||
""
);

const bDate=
Date.parse(
b.approved_at||
b.created_at||
""
);

return(
(bDate||0)-
(aDate||0)
);

});

renderJobs(approvedAds);

}catch(error){

console.error(error);

jobsBox.innerHTML=`
<div class="status">
<strong>Jobs could not be loaded.</strong>
Please try again later.
</div>
`;

}

}

function renderJobs(ads){

jobsBox.innerHTML="";

const list=
ads.slice(0,10);

if(!list.length){

jobsBox.innerHTML=`
<div class="status">
<strong>No matching jobs found.</strong>
Try another search or filter.
</div>
`;

return;

}

list.forEach(ad=>{

const title=
valueText(ad,[
"title",
"job_title",
"jobTitle"
])||
"Job Opportunity";

const description=
valueText(ad,[
"description",
"details",
"job_description",
"jobDescription"
])||
"No description provided.";

const location=[

valueText(ad,[
"province",
"province_name",
"provinceName"
]),

valueText(ad,[
"district",
"district_name",
"districtName"
]),

valueText(ad,[
"city",
"city_name",
"cityName"
])

].filter(Boolean).join(" • ");

const image=
getPhoto(
valueText(ad,[
"photo_url",
"photo",
"photo_key",
"image"
])
);

const whatsapp=
valueText(ad,[
"whatsapp_no",
"whatsapp_number",
"whatsapp"
]).trim();

const call=
valueText(ad,[
"call_no",
"call_number",
"phone",
"phone_number"
]).trim();

const card=
document.createElement("article");

card.className="job";

card.innerHTML=`

<div class="job-main">

<div class="photo-wrap">

${
image
?`
<img
class="job-photo"
src="${esc(image)}"
alt="${esc(title)}"
loading="lazy"
onerror="this.style.display='none';this.nextElementSibling.style.display='flex';">

<div class="no-photo" style="display:none">
No Photo
</div>
`
:`
<div class="no-photo">
No Photo
</div>
`
}

</div>

<div class="job-content">

${
location
?`
<div class="job-location">
📍 ${esc(location)}
</div>
`
:""
}

<div class="job-title">
${esc(title)}
</div>

<p class="description">
${esc(description)}
</p>

</div>

</div>

<div class="job-actions">

${
whatsapp
?`
<a
class="contact-btn whatsapp"
href="https://wa.me/${cleanPhone(whatsapp)}"
target="_blank"
rel="noopener noreferrer">
WhatsApp
</a>
`
:`
<button
class="contact-btn disabled"
disabled>
WhatsApp
</button>
`
}

${
call
?`
<a
class="contact-btn call"
href="tel:${cleanPhone(call)}">
Call
</a>
`
:`
<button
class="contact-btn disabled"
disabled>
Call
</button>
`
}

</div>
`;

jobsBox.appendChild(card);

});

}

Promise.all([
loadCategories(),
loadProvinces(),
loadJobs()
]);
</script></body>
</html>