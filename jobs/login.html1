<!DOCTYPE html><html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#102a56"><title>Sign In | CreateLK Jobs</title><link rel="icon"
href="https://jobs.createlk.com/file_00000000f05482118c11cccfc653fd0f.png"><link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700;800&display=swap" rel="stylesheet"><style>
*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

html,body{
  min-height:100%;
}

body{
  min-height:100vh;
  font-family:Arial,sans-serif;
  background:#f7f9fc;
  color:#172033;
  display:flex;
  flex-direction:column;
}

a{
  text-decoration:none;
  color:inherit;
}

/* HEADER */

header{
  background:#fff;
  border-bottom:1px solid #e8ecf3;
}

.header{
  width:min(1180px,92%);
  height:72px;
  margin:auto;
  display:flex;
  align-items:center;
  justify-content:space-between;
}

.logo{
  display:flex;
  align-items:center;
  gap:9px;
  color:#102a56;
  font-size:20px;
  font-weight:800;
}

.logo img{
  width:40px;
  height:40px;
  object-fit:contain;
  border-radius:8px;
}

.nav{
  display:flex;
  align-items:center;
  gap:22px;
  font-size:14px;
  font-weight:700;
}

.nav a{
  color:#435069;
}

.login{
  border:1px solid #d7deea;
  padding:9px 16px;
  border-radius:8px;
  color:#102a56!important;
}

.post{
  background:#102a56;
  color:#fff!important;
  padding:10px 17px;
  border-radius:8px;
}

.menu{
  display:none;
  border:0;
  background:none;
  font-size:27px;
  color:#102a56;
  cursor:pointer;
}

/* MOBILE MENU */

.mobile{
  display:none;
  background:#fff;
  border-top:1px solid #eee;
  padding:10px 4%;
}

.mobile a{
  display:block;
  padding:12px 0;
  border-bottom:1px solid #eee;
  font-weight:700;
  color:#435069;
}

.mobile-post{
  background:#102a56!important;
  color:#fff!important;
  padding:12px 15px!important;
  border-radius:8px;
  margin:10px 0;
  text-align:center;
}

/* MAIN */

main{
  flex:1;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:30px 16px;
  min-height:calc(100vh - 162px);
}

.card{
  width:min(430px,100%);
  background:#fff;
  border:1px solid #e1e6ee;
  border-radius:16px;
  padding:35px 28px;
  box-shadow:0 15px 40px #102a5612;
  text-align:center;
}

.card h1{
  font-family:"Playfair Display",serif;
  color:#102a56;
  font-size:32px;
  margin-bottom:8px;
}

.card p{
  color:#68748a;
  font-size:14px;
  line-height:1.6;
  margin-bottom:25px;
}

/* ERROR */

.error{
  display:none;
  background:#fff1f1;
  border:1px solid #f3caca;
  color:#b42318;
  padding:10px 12px;
  border-radius:8px;
  font-size:12px;
  line-height:1.5;
  margin-bottom:15px;
}

/* GOOGLE */

.google{
  width:100%;
  min-height:50px;
  display:flex;
  align-items:center;
  justify-content:center;
  gap:12px;
  border:1px solid #d8dee8;
  border-radius:9px;
  background:#fff;
  color:#172033;
  font-size:14px;
  font-weight:700;
  transition:.2s;
  cursor:pointer;
}

.google:hover{
  background:#f8fafc;
  border-color:#bfc8d7;
}

.google svg{
  width:20px;
  height:20px;
  flex:none;
}

.note{
  margin-top:20px;
  font-size:11px;
  color:#8791a3;
  line-height:1.6;
}

.note a{
  color:#102a56;
  font-weight:700;
}

/* FOOTER */

footer{
  background:#0c1e3c;
  color:#aebbd0;
}

.footer{
  width:min(1180px,92%);
  min-height:90px;
  margin:auto;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:20px;
  font-size:12px;
}

.legal{
  display:flex;
  gap:9px;
  flex-wrap:wrap;
}

.legal a{
  color:#c8d2e1;
}

.legal span{
  color:#63738d;
}

/* TABLET */

@media(max-width:900px){

  .nav{
    display:none;
  }

  .menu{
    display:block;
  }

}

/* MOBILE */

@media(max-width:600px){

  .header{
    height:65px;
  }

  .logo{
    font-size:18px;
  }

  .logo img{
    width:35px;
    height:35px;
  }

  main{
    min-height:calc(100vh - 145px);
    padding:20px 14px;
  }

  .card{
    padding:28px 18px;
  }

  .card h1{
    font-size:29px;
  }

  .card p{
    font-size:13px;
    margin-bottom:22px;
  }

  .google{
    min-height:50px;
  }

  .note{
    font-size:11px;
    margin-top:18px;
  }

  .footer{
    padding:24px 0;
    display:block;
    text-align:center;
  }

  .legal{
    justify-content:center;
    margin-bottom:12px;
    gap:7px;
  }

}
</style></head><body><header>
  <div class="header"><a href="/" class="logo">
  <img
    src="https://jobs.createlk.com/file_00000000f05482118c11cccfc653fd0f.png"
    alt="CreateLK Jobs">
  <span>CreateLK Jobs</span>
</a>

<nav class="nav">
  <a href="/">Home</a>
  <a href="/jobs/">Find Jobs</a>
  <a href="/categories/">Categories</a>
  <a href="/companies/">Companies</a>

  <a href="/jobs/login.html" class="login">
    Sign In
  </a>

  <a href="/jobs/login.html" class="post">
    Post a Job
  </a>
</nav>

<button
  class="menu"
  id="menuBtn"
  aria-label="Menu"
  aria-expanded="false">
  ☰
</button>

  </div>  <div class="mobile" id="mobile"><a href="/">Home</a>
<a href="/jobs/">Find Jobs</a>
<a href="/categories/">Categories</a>
<a href="/companies/">Companies</a>
<a href="/jobs/login.html">Sign In</a>

<a href="/jobs/login.html" class="mobile-post">
  ➕ Post a Job
</a>

  </div>
</header><main>  <div class="card"><h1>Welcome Back</h1>

<p>
  Sign in to your CreateLK Jobs account to continue.
</p>

<div class="error" id="error"></div>

<a
  href="https://createlk-jobs-auth-v2.createlk.workers.dev/login"
  class="google"
  id="googleLogin">

  <svg viewBox="0 0 24 24">

    <path
      fill="#4285F4"
      d="M21.35 12.27c0-.79-.07-1.55-.2-2.27H12v4.3h5.22a4.46 4.46 0 0 1-1.94 2.93v2.44h3.14c1.84-1.69 2.93-4.18 2.93-7.4z"/>

    <path
      fill="#34A853"
      d="M12 21.99c2.63 0 4.84-.87 6.45-2.35l-3.14-2.44c-.87.58-1.98.92-3.31.92-2.54 0-4.7-1.72-5.47-4.03H3.28v2.52A9.75 9.75 0 0 0 12 21.99z"/>

    <path
      fill="#FBBC05"
      d="M6.53 14.09A5.86 5.86 0 0 1 6.22 12c0-.73.13-1.44.31-2.09V7.39H3.28A9.75 9.75 0 0 0 2.25 12c0 1.57.38 3.06 1.03 4.61l3.25-2.52z"/>

    <path
      fill="#EA4335"
      d="M12 5.88c1.43 0 2.71.49 3.72 1.45l2.79-2.79C16.84 2.91 14.63 2 12 2a9.75 9.75 0 0 0-8.72 5.39l3.25 2.52C7.3 7.6 9.46 5.88 12 5.88z"/>

  </svg>

  <span>Continue with Google</span>

</a>

<div class="note">
  By continuing, you agree to use CreateLK Jobs in accordance with our
  <a href="/jobs/terms.html">Terms & Conditions</a>
  and
  <a href="/jobs/privacy.html">Privacy Policy</a>.
</div>

  </div></main><footer>  <div class="footer"><div class="legal">

  <a href="/jobs/terms.html">Terms & Conditions</a>
  <span>•</span>

  <a href="/jobs/privacy.html">Privacy Policy</a>
  <span>•</span>

  <a href="/jobs/refund.html">Refund Policy</a>
  <span>•</span>

  <a href="/jobs/payment.html">Payment Policy</a>
  <span>•</span>

  <a href="/jobs/cookies.html">Cookies</a>
  <span>•</span>

  <a href="/jobs/disclaimer.html">Disclaimer</a>

</div>

<div>
  © 2026 CreateLK Jobs. All rights reserved.
</div>

  </div></footer><script>

const AUTH_API =
  "https://createlk-jobs-auth-v2.createlk.workers.dev";

const DASHBOARD =
  "/jobs/dashboard.html";


/* MOBILE MENU */

const menuBtn =
  document.getElementById("menuBtn");

const mobile =
  document.getElementById("mobile");

menuBtn.addEventListener("click",()=>{

  const open =
    mobile.style.display === "block";

  mobile.style.display =
    open ? "none" : "block";

  menuBtn.setAttribute(
    "aria-expanded",
    String(!open)
  );

});


/* ERROR MESSAGE */

const errors = {
  config:
    "Login service is not configured. Please try again later.",

  callback:
    "Google login could not be completed.",

  state:
    "Your login session expired. Please try again.",

  google_token:
    "Google authentication failed. Please try again.",

  google_user:
    "Could not retrieve your Google account.",

  access_token:
    "Google authentication failed. Please try again.",

  unverified_email:
    "Please use a verified Google email address.",

  user:
    "Could not verify your Google account.",

  create_user:
    "Your account could not be created. Please try again."
};


function showError(){

  const key =
    new URLSearchParams(
      location.search
    ).get("error");

  if(!key) return;

  const box =
    document.getElementById("error");

  box.textContent =
    errors[key] ||
    "Sign in failed. Please try again.";

  box.style.display =
    "block";

}


/* CHECK EXISTING SESSION */

async function checkSession(){

  try{

    const response =
      await fetch(
        AUTH_API + "/api/me",
        {
          method:"GET",
          credentials:"include",
          cache:"no-store"
        }
      );

    if(!response.ok) return;

    const data =
      await response.json();

    if(
      data.ok &&
      data.user
    ){

      location.replace(DASHBOARD);

    }

  }catch(error){

    console.error(
      "Session check:",
      error
    );

  }

}


/* GOOGLE LOGIN */

const googleLogin =
  document.getElementById("googleLogin");

googleLogin.addEventListener(
  "click",
  ()=>{

    googleLogin.style.pointerEvents =
      "none";

    googleLogin.style.opacity =
      "0.65";

    googleLogin.querySelector(
      "span"
    ).textContent =
      "Connecting to Google...";

  }
);


/* START */

showError();
checkSession();

</script></body>
</html>