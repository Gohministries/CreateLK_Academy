const API_PREFIX = "/jobs-api";

const ORIGIN = "https://createlk.com";


// =========================
// MAIN WORKER
// =========================

export default {
  async fetch(request, env) {
    const url = new URL(request.url);

    let pathname = url.pathname;

    // Remove /jobs-api prefix
    if (pathname === API_PREFIX) {
      pathname = "/";
    } else if (pathname.startsWith(API_PREFIX + "/")) {
      pathname = pathname.slice(API_PREFIX.length);
    }

    // OPTIONS
    if (request.method === "OPTIONS") {
      return new Response(null, {
        status: 204,
        headers: cors()
      });
    }

    try {

      // =========================
      // PUBLIC FILES
      // =========================

      if (
        request.method === "GET" &&
        pathname.startsWith("/files/")
      ) {
        return await fileResponse(
          request,
          env,
          pathname
        );
      }


      // =========================
      // PUBLIC JOBS
      // =========================

      if (
        request.method === "GET" &&
        pathname === "/api/jobs"
      ) {
        return await publicJobs(
          request,
          env
        );
      }


      // =========================
      // CURRENT USER
      // =========================

      if (
        request.method === "GET" &&
        pathname === "/api/me"
      ) {
        const user =
          await auth(request, env);

        if (!user) {
          return json(
            {
              ok: false,
              user: null,
              error: "Login required."
            },
            401
          );
        }

        return json({
          ok: true,
          user
        });
      }


      // =========================
      // MY ADS
      // =========================

      if (
        request.method === "GET" &&
        pathname === "/api/my-ads"
      ) {
        const user =
          await auth(request, env);

        if (!user) {
          return json(
            {
              ok: false,
              error: "Login required."
            },
            401
          );
        }

        return await myAds(
          request,
          env,
          user
        );
      }


      // =========================
      // MY APPLICATIONS
      // =========================

      if (
        request.method === "GET" &&
        pathname === "/api/my-applications"
      ) {
        const user =
          await auth(request, env);

        if (!user) {
          return json(
            {
              ok: false,
              error: "Login required."
            },
            401
          );
        }

        return await myApplications(
          request,
          env,
          user
        );
      }


      // =========================
      // CREATE AD
      // =========================

      if (
        request.method === "POST" &&
        pathname === "/api/create-ad"
      ) {
        const user =
          await auth(request, env);

        if (!user) {
          return json(
            {
              ok: false,
              error: "Login required."
            },
            401
          );
        }

        return await createAd(
          request,
          env,
          user
        );
      }


      // =========================
      // ADMIN ADS
      // =========================

      if (
        request.method === "GET" &&
        pathname === "/api/admin/ads"
      ) {
        const user =
          await auth(request, env);

        if (!user) {
          return json(
            {
              ok: false,
              error: "Login required."
            },
            401
          );
        }

        if (user.role !== "Admin") {
          return json(
            {
              ok: false,
              error: "Admin access required."
            },
            403
          );
        }

        return await adminAds(
          request,
          env
        );
      }


      // =========================
      // APPROVE AD
      // =========================

      if (
        request.method === "POST" &&
        pathname === "/api/admin/approve-ad"
      ) {
        const user =
          await auth(request, env);

        if (!user) {
          return json(
            {
              ok: false,
              error: "Login required."
            },
            401
          );
        }

        if (user.role !== "Admin") {
          return json(
            {
              ok: false,
              error: "Admin access required."
            },
            403
          );
        }

        return await approveAd(
          request,
          env
        );
      }


      // =========================
      // REJECT AD
      // =========================

      if (
        request.method === "POST" &&
        pathname === "/api/admin/reject-ad"
      ) {
        const user =
          await auth(request, env);

        if (!user) {
          return json(
            {
              ok: false,
              error: "Login required."
            },
            401
          );
        }

        if (user.role !== "Admin") {
          return json(
            {
              ok: false,
              error: "Admin access required."
            },
            403
          );
        }

        return await rejectAd(
          request,
          env
        );
      }


      // =========================
      // APPROVE PAYMENT
      // =========================

      if (
        request.method === "POST" &&
        pathname === "/api/admin/approve-payment"
      ) {
        const user =
          await auth(request, env);

        if (!user) {
          return json(
            {
              ok: false,
              error: "Login required."
            },
            401
          );
        }

        if (user.role !== "Admin") {
          return json(
            {
              ok: false,
              error: "Admin access required."
            },
            403
          );
        }

        return await approvePayment(
          request,
          env
        );
      }


      // =========================
      // ROOT
      // =========================

      if (
        request.method === "GET" &&
        pathname === "/"
      ) {
        return json({
          ok: true,
          service: "CreateLK Jobs API V2"
        });
      }


      return json(
        {
          ok: false,
          error: "Not found"
        },
        404
      );

    } catch (error) {

      console.error(error);

      return json(
        {
          ok: false,
          error: "Internal server error"
        },
        500
      );
    }
  }
};


// ==================================================
// CORS
// ==================================================

function cors() {
  return {
    "Access-Control-Allow-Origin": ORIGIN,
    "Access-Control-Allow-Credentials": "true",
    "Access-Control-Allow-Headers": "Content-Type",
    "Access-Control-Allow-Methods":
      "GET,POST,OPTIONS"
  };
}


// ==================================================
// JSON
// ==================================================

function json(data, status = 200) {
  return new Response(
    JSON.stringify(data),
    {
      status,
      headers: {
        "Content-Type":
          "application/json;charset=UTF-8",

        "Cache-Control":
          "no-store",

        ...cors()
      }
    }
  );
}


// ==================================================
// COOKIE
// ==================================================

function cookie(request) {

  const value =
    request.headers.get("Cookie") || "";

  const match =
    value.match(
      /(?:^|;\s*)session=([^;]+)/
    );

  return match
    ? decodeURIComponent(match[1])
    : null;
}


// ==================================================
// AUTH
// ==================================================

async function auth(request, env) {

  const token =
    cookie(request);

  if (!token) {
    return null;
  }

  const row =
    await env.DB.prepare(`
      SELECT
        users.id,
        users.name,
        users.email,
        users.photo_url,
        users.role
      FROM sessions
      JOIN users
        ON users.id = sessions.user_id
      WHERE sessions.token = ?
        AND sessions.expires_at > datetime('now')
      LIMIT 1
    `)
    .bind(token)
    .first();

  return row || null;
}


// ==================================================
// SAFE FILE NAME
// ==================================================

function safeName(name) {

  return String(name || "")
    .replace(/[^a-zA-Z0-9._-]/g, "_")
    .slice(0, 150);
}


// ==================================================
// UPLOAD FILE
// ==================================================

async function uploadFile(
  request,
  env,
  file,
  folder
) {

  if (!file) {
    return null;
  }

  const original =
    safeName(file.name);

  const key =
    `${folder}/${Date.now()}-${crypto.randomUUID()}-${original}`;

  await env.JOBS_BUCKET.put(
    key,
    file.stream(),
    {
      httpMetadata: {
        contentType:
          file.type ||
          "application/octet-stream"
      }
    }
  );

  return `/files/${key}`;
}


// ==================================================
// GET JOB
// ==================================================

async function getJob(
  env,
  id
) {

  return await env.DB.prepare(`
    SELECT *
    FROM ads
    WHERE id = ?
    LIMIT 1
  `)
  .bind(id)
  .first();
}


// ==================================================
// CREATE AD
// ==================================================

async function createAd(
  request,
  env,
  user
) {

  const form =
    await request.formData();

  const title =
    String(
      form.get("title") || ""
    ).trim();

  const category =
    String(
      form.get("category") || ""
    ).trim();

  const location =
    String(
      form.get("location") || ""
    ).trim();

  const description =
    String(
      form.get("description") || ""
    ).trim();

  const company =
    String(
      form.get("company") || ""
    ).trim();

  const phone =
    String(
      form.get("phone") || ""
    ).trim();

  const email =
    String(
      form.get("email") || ""
    ).trim();

  const website =
    String(
      form.get("website") || ""
    ).trim();

  const salary =
    String(
      form.get("salary") || ""
    ).trim();

  const adType =
    String(
      form.get("ad_type") ||
      form.get("plan") ||
      "Basic"
    ).trim();

  if (
    !title ||
    !category ||
    !location ||
    !description
  ) {
    return json(
      {
        ok: false,
        error:
          "Please complete all required fields."
      },
      400
    );
  }


  // Files
  const logo =
    form.get("logo");

  const image =
    form.get("image");

  let logoUrl = null;
  let imageUrl = null;


  if (
    logo &&
    typeof logo === "object" &&
    logo.name
  ) {
    logoUrl =
      await uploadFile(
        request,
        env,
        logo,
        `ads/${user.id}/logos`
      );
  }


  if (
    image &&
    typeof image === "object" &&
    image.name
  ) {
    imageUrl =
      await uploadFile(
        request,
        env,
        image,
        `ads/${user.id}/images`
      );
  }


  // Basic / Premium
  const premium =
    adType.toLowerCase() === "premium";


  const status =
    premium
      ? "pending_payment"
      : "pending";


  const result =
    await env.DB.prepare(`
      INSERT INTO ads
      (
        user_id,
        title,
        category,
        location,
        description,
        company,
        phone,
        email,
        website,
        salary,
        ad_type,
        status,
        logo_url,
        image_url,
        created_at
      )
      VALUES
      (
        ?,?,?,?,?,?,?,?,?,?,
        ?,?,?,?,
        CURRENT_TIMESTAMP
      )
    `)
    .bind(
      user.id,
      title,
      category,
      location,
      description,
      company,
      phone,
      email,
      website,
      salary,
      adType,
      status,
      logoUrl,
      imageUrl
    )
    .run();


  return json({
    ok: true,
    id: result.meta.last_row_id,
    status,
    message:
      premium
        ? "Ad created. Payment approval is required."
        : "Ad submitted for approval."
  });
}


// ==================================================
// MY ADS
// ==================================================

async function myAds(
  request,
  env,
  user
) {

  const result =
    await env.DB.prepare(`
      SELECT *
      FROM ads
      WHERE user_id = ?
      ORDER BY created_at DESC
    `)
    .bind(user.id)
    .all();

  return json({
    ok: true,
    ads: result.results || []
  });
}


// ==================================================
// MY APPLICATIONS
// ==================================================

async function myApplications(
  request,
  env,
  user
) {

  const result =
    await env.DB.prepare(`
      SELECT
        applications.*,
        ads.title,
        ads.company,
        ads.location
      FROM applications
      JOIN ads
        ON ads.id = applications.ad_id
      WHERE applications.user_id = ?
      ORDER BY applications.created_at DESC
    `)
    .bind(user.id)
    .all();

  return json({
    ok: true,
    applications:
      result.results || []
  });
}


// ==================================================
// PUBLIC JOBS
// ==================================================

async function publicJobs(
  request,
  env
) {

  const result =
    await env.DB.prepare(`
      SELECT *
      FROM ads
      WHERE status = 'approved'
      ORDER BY created_at DESC
    `)
    .all();

  return json({
    ok: true,
    jobs: result.results || []
  });
}


// ==================================================
// ADMIN ADS
// ==================================================

async function adminAds(
  request,
  env
) {

  const result =
    await env.DB.prepare(`
      SELECT
        ads.*,
        users.name AS user_name,
        users.email AS user_email
      FROM ads
      JOIN users
        ON users.id = ads.user_id
      ORDER BY ads.created_at DESC
    `)
    .all();

  return json({
    ok: true,
    ads: result.results || []
  });
}


// ==================================================
// APPROVE AD
// ==================================================

async function approveAd(
  request,
  env
) {

  const body =
    await request.json();

  const id =
    Number(body.id);

  if (!id) {
    return json(
      {
        ok: false,
        error: "Invalid ad ID."
      },
      400
    );
  }


  await env.DB.prepare(`
    UPDATE ads
    SET
      status = 'approved',
      approved_at = CURRENT_TIMESTAMP
    WHERE id = ?
  `)
  .bind(id)
  .run();


  return json({
    ok: true,
    message:
      "Ad approved successfully."
  });
}


// ==================================================
// REJECT AD
// ==================================================

async function rejectAd(
  request,
  env
) {

  const body =
    await request.json();

  const id =
    Number(body.id);

  if (!id) {
    return json(
      {
        ok: false,
        error: "Invalid ad ID."
      },
      400
    );
  }


  await env.DB.prepare(`
    UPDATE ads
    SET
      status = 'rejected'
    WHERE id = ?
  `)
  .bind(id)
  .run();


  return json({
    ok: true,
    message:
      "Ad rejected successfully."
  });
}


// ==================================================
// APPROVE PAYMENT
// ==================================================

async function approvePayment(
  request,
  env
) {

  const body =
    await request.json();

  const id =
    Number(body.id);

  if (!id) {
    return json(
      {
        ok: false,
        error: "Invalid ad ID."
      },
      400
    );
  }


  await env.DB.prepare(`
    UPDATE ads
    SET
      status = 'pending',
      payment_status = 'approved',
      payment_approved_at =
        CURRENT_TIMESTAMP
    WHERE id = ?
  `)
  .bind(id)
  .run();


  return json({
    ok: true,
    message:
      "Payment approved successfully."
  });
}


// ==================================================
// FILE RESPONSE
// ==================================================

async function fileResponse(
  request,
  env,
  pathname
) {

  const key =
    pathname
      .replace(/^\/files\//, "")
      .trim();

  if (!key) {
    return new Response(
      "Not found",
      {
        status: 404
      }
    );
  }


  const object =
    await env.JOBS_BUCKET.get(key);

  if (!object) {
    return new Response(
      "Not found",
      {
        status: 404
      }
    );
  }


  const headers =
    new Headers();

  object.writeHttpMetadata(
    headers
  );

  headers.set(
    "Cache-Control",
    "public, max-age=86400"
  );


  return new Response(
    object.body,
    {
      headers
    }
  );
}