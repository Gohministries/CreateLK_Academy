const CATEGORIES = [

  "Accounting & Finance",
  "Administration",
  "Agriculture",
  "Architecture & Design",
  "Automotive",
  "Banking & Insurance",
  "Beauty & Wellness",
  "Construction",
  "Customer Service",
  "Delivery & Logistics",
  "Education & Training",
  "Engineering",
  "Government",
  "Healthcare & Medical",
  "Hotel & Tourism",
  "Human Resources",
  "IT & Technology",
  "Legal",
  "Manufacturing & Factory",
  "Marketing & Advertising",
  "Media & Creative",
  "Retail & Sales",
  "Security",
  "Skilled Trades",
  "Driving",
  "Domestic & Housekeeping",
  "Fisheries",
  "Food & Restaurant",
  "Telecommunications",
  "NGO & Development",
  "Real Estate",
  "Remote Jobs",
  "Part-Time Jobs",
  "Internships & Trainees",
  "Other"

];

export default {

  async fetch(request) {

    const url = new URL(request.url);

    const headers = {
      "Content-Type": "application/json; charset=UTF-8",
      "Access-Control-Allow-Origin": "*",
      "Access-Control-Allow-Methods": "GET, OPTIONS",
      "Access-Control-Allow-Headers": "Content-Type"
    };

    // OPTIONS / CORS
    if (request.method === "OPTIONS") {
      return new Response(null, {
        status: 204,
        headers
      });
    }

    // Only GET allowed
    if (request.method !== "GET") {
      return new Response(
        JSON.stringify({
          success: false,
          error: "Method not allowed"
        }),
        {
          status: 405,
          headers
        }
      );
    }

    // Categories endpoint
    if (url.pathname === "/api/categories") {

      const categories = CATEGORIES.map((name, index) => ({
        id: index + 1,
        name
      }));

      return new Response(
        JSON.stringify({
          success: true,
          count: categories.length,
          categories
        }),
        {
          status: 200,
          headers
        }
      );
    }

    // Root endpoint
    if (url.pathname === "/") {

      return new Response(
        JSON.stringify({
          success: true,
          service: "CreateLK Jobs Categories API",
          endpoint: "/api/categories",
          count: CATEGORIES.length
        }),
        {
          status: 200,
          headers
        }
      );
    }

    // 404
    return new Response(
      JSON.stringify({
        success: false,
        error: "Endpoint not found"
      }),
      {
        status: 404,
        headers
      }
    );
  }
};