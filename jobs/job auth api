const AUTH_PREFIX = "/jobs-auth";

const DASHBOARD =
  "https://createlk.com/jobs/dashboard.html";

const LOGIN =
  "https://createlk.com/jobs/login.html";

const REDIRECT =
  "https://createlk.com/jobs-auth/callback";

const ORIGIN =
  "https://createlk.com";

export default {
  async fetch(request, env) {
    const url = new URL(request.url);

    // Remove /jobs-auth from the route
    let pathname = url.pathname;

    if (pathname === AUTH_PREFIX) {
      pathname = "/";
    } else if (pathname.startsWith(AUTH_PREFIX + "/")) {
      pathname = pathname.slice(AUTH_PREFIX.length);
    }

    try {
      if (request.method === "OPTIONS") {
        return new Response(null, {
          status: 204,
          headers: cors(request)
        });
      }

      // =========================
      // GOOGLE LOGIN
      // =========================
      if (request.method === "GET" && pathname === "/login") {
        if (
          !env.GOOGLE_CLIENT_ID ||
          !env.GOOGLE_CLIENT_SECRET ||
          !env.SESSION_SECRET
        ) {
          return Response.redirect(
            LOGIN + "?error=config",
            302
          );
        }

        const state = crypto.randomUUID();

        const google = new URL(
          "https://accounts.google.com/o/oauth2/v2/auth"
        );

        google.searchParams.set(
          "client_id",
          env.GOOGLE_CLIENT_ID
        );

        google.searchParams.set(
          "redirect_uri",
          REDIRECT
        );

        google.searchParams.set(
          "response_type",
          "code"
        );

        google.searchParams.set(
          "scope",
          "openid email profile"
        );

        google.searchParams.set(
          "state",
          state
        );

        google.searchParams.set(
          "access_type",
          "online"
        );

        google.searchParams.set(
          "prompt",
          "select_account"
        );

        const response = new Response(null, {
          status: 302,
          headers: {
            Location: google.toString(),
            "Cache-Control": "no-store"
          }
        });

        response.headers.append(
          "Set-Cookie",
          [
            `oauth_state=${encodeURIComponent(state)}`,
            "Domain=.createlk.com",
            "Path=/",
            "HttpOnly",
            "Secure",
            "SameSite=Lax",
            "Max-Age=600"
          ].join("; ")
        );

        return response;
      }

      // =========================
      // GOOGLE CALLBACK
      // =========================
      if (
        request.method === "GET" &&
        pathname === "/callback"
      ) {
        if (
          !env.GOOGLE_CLIENT_ID ||
          !env.GOOGLE_CLIENT_SECRET ||
          !env.SESSION_SECRET
        ) {
          return Response.redirect(
            LOGIN + "?error=config",
            302
          );
        }

        const code =
          url.searchParams.get("code");

        const state =
          url.searchParams.get("state");

        if (!code || !state) {
          return Response.redirect(
            LOGIN + "?error=callback",
            302
          );
        }

        const cookies = parseCookies(
          request.headers.get("Cookie") || ""
        );

        if (
          !cookies.oauth_state ||
          cookies.oauth_state !== state
        ) {
          return Response.redirect(
            LOGIN + "?error=state",
            302
          );
        }

        // Exchange Google authorization code
        const tokenResponse = await fetch(
          "https://oauth2.googleapis.com/token",
          {
            method: "POST",
            headers: {
              "Content-Type":
                "application/x-www-form-urlencoded"
            },
            body: new URLSearchParams({
              code,
              client_id: env.GOOGLE_CLIENT_ID,
              client_secret: env.GOOGLE_CLIENT_SECRET,
              redirect_uri: REDIRECT,
              grant_type: "authorization_code"
            })
          }
        );

        if (!tokenResponse.ok) {
          return Response.redirect(
            LOGIN + "?error=google_token",
            302
          );
        }

        const tokens =
          await tokenResponse.json();

        if (!tokens.access_token) {
          return Response.redirect(
            LOGIN + "?error=access_token",
            302
          );
        }

        // Get Google user
        const userResponse = await fetch(
          "https://www.googleapis.com/oauth2/v2/userinfo",
          {
            headers: {
              Authorization:
                `Bearer ${tokens.access_token}`
            }
          }
        );

        if (!userResponse.ok) {
          return Response.redirect(
            LOGIN + "?error=google_user",
            302
          );
        }

        const googleUser =
          await userResponse.json();

        if (
          !googleUser.id ||
          !googleUser.email ||
          googleUser.verified_email !== true
        ) {
          return Response.redirect(
            LOGIN + "?error=unverified_email",
            302
          );
        }

        // =========================
        // FIND USER
        // =========================

        let user =
          await env.DB.prepare(`
            SELECT
              id,
              google_id,
              name,
              email,
              photo_url,
              role
            FROM users
            WHERE google_id = ?
            LIMIT 1
          `)
          .bind(googleUser.id)
          .first();

        // Try email if Google ID wasn't found
        if (!user) {
          user =
            await env.DB.prepare(`
              SELECT
                id,
                google_id,
                name,
                email,
                photo_url,
                role
              FROM users
              WHERE email = ?
              LIMIT 1
            `)
            .bind(googleUser.email)
            .first();
        }

        // =========================
        // CREATE USER
        // =========================

        if (!user) {
          const result =
            await env.DB.prepare(`
              INSERT INTO users
              (
                google_id,
                name,
                email,
                photo_url,
                role
              )
              VALUES (?, ?, ?, ?, ?)
            `)
            .bind(
              googleUser.id,
              googleUser.name || "",
              googleUser.email,
              googleUser.picture || null,
              "Job Seeker"
            )
            .run();

          user =
            await env.DB.prepare(`
              SELECT
                id,
                google_id,
                name,
                email,
                photo_url,
                role
              FROM users
              WHERE id = ?
              LIMIT 1
            `)
            .bind(result.meta.last_row_id)
            .first();
        }

        // =========================
        // UPDATE EXISTING USER
        // =========================

        else {
          await env.DB.prepare(`
            UPDATE users
            SET
              google_id = ?,
              name = ?,
              photo_url = ?,
              updated_at = CURRENT_TIMESTAMP
            WHERE id = ?
          `)
          .bind(
            googleUser.id,
            googleUser.name || user.name || "",
            googleUser.picture ||
              user.photo_url ||
              null,
            user.id
          )
          .run();

          user =
            await env.DB.prepare(`
              SELECT
                id,
                google_id,
                name,
                email,
                photo_url,
                role
              FROM users
              WHERE id = ?
              LIMIT 1
            `)
            .bind(user.id)
            .first();
        }

        if (!user) {
          return Response.redirect(
            LOGIN + "?error=create_user",
            302
          );
        }

        // =========================
        // REMOVE OLD SESSIONS
        // =========================

        await env.DB.prepare(
          `DELETE FROM sessions WHERE user_id = ?`
        )
          .bind(user.id)
          .run();

        // =========================
        // CREATE SESSION
        // =========================

        const token =
          await createSessionToken(
            user.id,
            env.SESSION_SECRET
          );

        const expires =
          new Date(
            Date.now() +
              30 * 24 * 60 * 60 * 1000
          ).toISOString();

        await env.DB.prepare(`
          INSERT INTO sessions
          (
            token,
            user_id,
            expires_at
          )
          VALUES (?, ?, ?)
        `)
        .bind(
          token,
          user.id,
          expires
        )
        .run();

        const response =
          new Response(null, {
            status: 302,
            headers: {
              Location: DASHBOARD,
              "Cache-Control": "no-store",
              "Pragma": "no-cache"
            }
          });

        // IMPORTANT:
        // Shared across createlk.com
        response.headers.append(
          "Set-Cookie",
          [
            `session=${encodeURIComponent(token)}`,
            "Domain=.createlk.com",
            "Path=/",
            "HttpOnly",
            "Secure",
            "SameSite=Lax",
            "Max-Age=2592000"
          ].join("; ")
        );

        // Clear OAuth state
        response.headers.append(
          "Set-Cookie",
          [
            "oauth_state=",
            "Domain=.createlk.com",
            "Path=/",
            "HttpOnly",
            "Secure",
            "SameSite=Lax",
            "Max-Age=0"
          ].join("; ")
        );

        return response;
      }

      // =========================
      // CURRENT USER
      // =========================

      if (
        request.method === "GET" &&
        pathname === "/api/me"
      ) {
        const token =
          parseCookies(
            request.headers.get("Cookie") || ""
          ).session;

        if (!token) {
          return json(
            {
              ok: false,
              user: null
            },
            401,
            request
          );
        }

        const session =
          await env.DB.prepare(`
            SELECT
              s.token,
              s.expires_at,
              u.id,
              u.google_id,
              u.name,
              u.email,
              u.photo_url,
              u.role
            FROM sessions s
            JOIN users u
              ON u.id = s.user_id
            WHERE s.token = ?
            LIMIT 1
          `)
          .bind(token)
          .first();

        if (!session) {
          return json(
            {
              ok: false,
              user: null
            },
            401,
            request
          );
        }

        if (
          new Date(session.expires_at) <=
          new Date()
        ) {
          await env.DB.prepare(
            `DELETE FROM sessions WHERE token = ?`
          )
            .bind(token)
            .run();

          return json(
            {
              ok: false,
              user: null
            },
            401,
            request
          );
        }

        return json(
          {
            ok: true,
            user: {
              id: session.id,
              google_id: session.google_id,
              name: session.name,
              email: session.email,
              photo_url: session.photo_url,
              role: session.role
            }
          },
          200,
          request
        );
      }

      // =========================
      // LOGOUT
      // =========================

      if (
        (
          request.method === "GET" &&
          pathname === "/logout"
        ) ||
        (
          request.method === "POST" &&
          pathname === "/api/logout"
        )
      ) {
        const token =
          parseCookies(
            request.headers.get("Cookie") || ""
          ).session;

        if (token) {
          await env.DB.prepare(
            `DELETE FROM sessions WHERE token = ?`
          )
          .bind(token)
          .run();
        }

        const response =
          request.method === "GET"
            ? new Response(null, {
                status: 302,
                headers: {
                  Location: LOGIN,
                  "Cache-Control": "no-store"
                }
              })
            : json(
                { ok: true },
                200,
                request
              );

        response.headers.append(
          "Set-Cookie",
          [
            "session=",
            "Domain=.createlk.com",
            "Path=/",
            "HttpOnly",
            "Secure",
            "SameSite=Lax",
            "Max-Age=0"
          ].join("; ")
        );

        return response;
      }

      // =========================
      // ROOT
      // =========================

      if (
        request.method === "GET" &&
        pathname === "/"
      ) {
        return json(
          {
            ok: true,
            service: "CreateLK Jobs Auth V2"
          },
          200,
          request
        );
      }

      return json(
        {
          ok: false,
          error: "Not found"
        },
        404,
        request
      );

    } catch (error) {
      console.error(error);

      return json(
        {
          ok: false,
          error: "Internal server error"
        },
        500,
        request
      );
    }
  }
};


// =========================
// CORS
// =========================

function cors(request) {
  const headers = {
    "Access-Control-Allow-Methods":
      "GET,POST,OPTIONS",

    "Access-Control-Allow-Headers":
      "Content-Type",

    "Access-Control-Allow-Credentials":
      "true",

    "Vary": "Origin"
  };

  if (
    request.headers.get("Origin") === ORIGIN
  ) {
    headers["Access-Control-Allow-Origin"] =
      ORIGIN;
  }

  return headers;
}


// =========================
// JSON RESPONSE
// =========================

function json(
  data,
  status,
  request
) {
  const response =
    new Response(
      JSON.stringify(data),
      {
        status,
        headers: {
          "Content-Type":
            "application/json;charset=UTF-8",

          "Cache-Control":
            "no-store"
        }
      }
    );

  Object.entries(
    cors(request)
  ).forEach(
    ([key, value]) => {
      response.headers.set(
        key,
        value
      );
    }
  );

  return response;
}


// =========================
// COOKIE PARSER
// =========================

function parseCookies(header) {
  const cookies = {};

  for (
    const part of header.split(";")
  ) {
    const index =
      part.indexOf("=");

    if (index < 0) continue;

    const key =
      part
        .slice(0, index)
        .trim();

    const value =
      part
        .slice(index + 1)
        .trim();

    try {
      cookies[key] =
        decodeURIComponent(value);
    } catch {
      cookies[key] = value;
    }
  }

  return cookies;
}


// =========================
// CREATE SESSION TOKEN
// =========================

async function createSessionToken(
  userId,
  secret
) {
  const data =
    `${userId}.${crypto.randomUUID()}.${Date.now()}`;

  const key =
    await crypto.subtle.importKey(
      "raw",
      new TextEncoder().encode(secret),
      {
        name: "HMAC",
        hash: "SHA-256"
      },
      false,
      ["sign"]
    );

  const signature =
    await crypto.subtle.sign(
      "HMAC",
      key,
      new TextEncoder().encode(data)
    );

  let binary = "";

  for (
    const byte of
      new Uint8Array(signature)
  ) {
    binary += String.fromCharCode(byte);
  }

  return btoa(binary)
    .replace(/\+/g, "-")
    .replace(/\//g, "_")
    .replace(/=+$/, "");
}