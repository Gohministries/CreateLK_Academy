/* =====================================================
   GENERATE AFFILIATE CODE
===================================================== */

function generateCode() {

  const number =
    Math.floor(
      10000 +
      Math.random() * 90000
    );

  return "CLK" + number;
}


/* =====================================================
   REGISTER AFFILIATE
===================================================== */

async function registerAffiliate(request, env) {

  const data =
    await getBody(request);

  if (!data) {
    return json({
      success: false,
      message: "Invalid request."
    }, 400);
  }

  const studentId =
    Number(
      data.student_id
    );

  const email =
    String(
      data.email || ""
    )
    .trim()
    .toLowerCase();

  if (!studentId && !email) {

    return json({
      success: false,
      message:
        "Student ID or email is required."
    }, 400);
  }

  let student;

  if (studentId) {

    student =
      await env.DB.prepare(`
        SELECT id, first_name, last_name, email
        FROM students
        WHERE id = ?
      `)
      .bind(studentId)
      .first();

  } else {

    student =
      await env.DB.prepare(`
        SELECT id, first_name, last_name, email
        FROM students
        WHERE email = ?
      `)
      .bind(email)
      .first();
  }

  if (!student) {

    return json({
      success: false,
      message:
        "Student account not found."
    }, 404);
  }


  /* Already affiliate */

  const existing =
    await env.DB.prepare(`
      SELECT *
      FROM affiliates
      WHERE student_id = ?
         OR email = ?
      LIMIT 1
    `)
    .bind(
      student.id,
      student.email
    )
    .first();

  if (existing) {

    return json({
      success: true,
      message:
        "Affiliate account already exists.",
      affiliate: existing
    });
  }


  /* Generate unique code */

  let code;
  let exists = true;

  for (
    let i = 0;
    i < 10 && exists;
    i++
  ) {

    code =
      generateCode();

    const found =
      await env.DB.prepare(`
        SELECT id
        FROM affiliates
        WHERE affiliate_code = ?
      `)
      .bind(code)
      .first();

    exists = !!found;
  }


  if (exists) {

    return json({
      success: false,
      message:
        "Unable to generate affiliate code."
    }, 500);
  }


  /* Create affiliate */

  try {

    const result =
      await env.DB.prepare(`
        INSERT INTO affiliates
        (
          student_id,
          name,
          email,
          affiliate_code,
          status,
          commission_rate,
          created_at
        )
        VALUES (?, ?, ?, ?, 'ACTIVE', 10, CURRENT_TIMESTAMP)
      `)
      .bind(
        student.id,
        (
          student.first_name +
          " " +
          student.last_name
        ).trim(),
        student.email,
        code
      )
      .run();


    return json({
      success: true,
      message:
        "Affiliate account created.",
      affiliate_id:
        result.meta.last_row_id,
      affiliate_code:
        code,
      referral_link:
        "https://createlk.com/?ref=" +
        code,
      commission_rate:
        10
    }, 201);

  } catch (error) {

    return json({
      success: false,
      message:
        "Unable to create affiliate account.",
      error:
        error.message
    }, 500);
  }
}


/* =====================================================
   GET AFFILIATE
===================================================== */

async function getAffiliate(request, env) {

  const url =
    new URL(request.url);

  const code =
    url.searchParams.get(
      "code"
    );

  const studentId =
    url.searchParams.get(
      "student_id"
    );

  const email =
    url.searchParams.get(
      "email"
    );


  let affiliate;


  if (code) {

    affiliate =
      await env.DB.prepare(`
        SELECT *
        FROM affiliates
        WHERE affiliate_code = ?
      `)
      .bind(
        code.trim().toUpperCase()
      )
      .first();

  } else if (studentId) {

    affiliate =
      await env.DB.prepare(`
        SELECT *
        FROM affiliates
        WHERE student_id = ?
      `)
      .bind(studentId)
      .first();

  } else if (email) {

    affiliate =
      await env.DB.prepare(`
        SELECT *
        FROM affiliates
        WHERE email = ?
      `)
      .bind(
        email.trim().toLowerCase()
      )
      .first();

  } else {

    return json({
      success: false,
      message:
        "Affiliate code, student ID or email is required."
    }, 400);
  }


  if (!affiliate) {

    return json({
      success: false,
      message:
        "Affiliate account not found."
    }, 404);
  }


  return json({
    success: true,
    affiliate
  });
}


/* =====================================================
   TRACK REFERRAL CLICK
===================================================== */

async function trackClick(request, env) {

  const data =
    await getBody(request);

  if (!data) {

    return json({
      success: false,
      message:
        "Invalid request."
    }, 400);
  }


  const code =
    String(
      data.affiliate_code ||
      data.code ||
      ""
    )
    .trim()
    .toUpperCase();


  if (!code) {

    return json({
      success: false,
      message:
        "Affiliate code is required."
    }, 400);
  }


  const affiliate =
    await env.DB.prepare(`
      SELECT id, affiliate_code, status
      FROM affiliates
      WHERE affiliate_code = ?
    `)
    .bind(code)
    .first();


  if (!affiliate) {

    return json({
      success: false,
      message:
        "Invalid affiliate code."
    }, 404);
  }


  const result =
    await env.DB.prepare(`
      INSERT INTO affiliate_clicks
      (
        affiliate_id,
        affiliate_code,
        created_at
      )
      VALUES (?, ?, CURRENT_TIMESTAMP)
    `)
    .bind(
      affiliate.id,
      affiliate.affiliate_code
    )
    .run();


  return json({
    success: true,
    message:
      "Affiliate click recorded.",
    click_id:
      result.meta.last_row_id
  });
}


/* =====================================================
   AFFILIATE DASHBOARD
===================================================== */

async function dashboard(request, env) {

  const url =
    new URL(request.url);

  const studentId =
    url.searchParams.get(
      "student_id"
    );


  if (!studentId) {

    return json({
      success: false,
      message:
        "Student ID is required."
    }, 400);
  }


  const affiliate =
    await env.DB.prepare(`
      SELECT *
      FROM affiliates
      WHERE student_id = ?
    `)
    .bind(studentId)
    .first();


  if (!affiliate) {

    return json({
      success: false,
      message:
        "Affiliate account not found."
    }, 404);
  }


  let referrals = [];

  try {

    const result =
      await env.DB.prepare(`
        SELECT *
        FROM affiliate_referrals
        WHERE affiliate_id = ?
        ORDER BY id DESC
      `)
      .bind(affiliate.id)
      .all();

    referrals =
      result.results || [];

  } catch {}


  let payouts = [];

  try {

    const result =
      await env.DB.prepare(`
        SELECT *
        FROM affiliate_payouts
        WHERE affiliate_id = ?
        ORDER BY id DESC
      `)
      .bind(affiliate.id)
      .all();

    payouts =
      result.results || [];

  } catch {}


  let clicks = 0;

  try {

    const result =
      await env.DB.prepare(`
        SELECT COUNT(*) AS total
        FROM affiliate_clicks
        WHERE affiliate_id = ?
      `)
      .bind(affiliate.id)
      .first();

    clicks =
      Number(
        result?.total || 0
      );

  } catch {}


  let totalCommission = 0;

  for (
    const referral of referrals
  ) {

    totalCommission +=
      Number(
        referral.commission_amount ||
        0
      );
  }


  let totalPaid = 0;

  for (
    const payout of payouts
  ) {

    totalPaid +=
      Number(
        payout.amount || 0
      );
  }


  return json({
    success: true,

    affiliate,

    statistics: {
      clicks,
      referrals:
        referrals.length,
      total_commission:
        totalCommission,
      total_paid:
        totalPaid,
      available_balance:
        Math.max(
          0,
          totalCommission -
          totalPaid
        )
    },

    referrals,

    payouts
  });
}


/* =====================================================
   MAIN WORKER
===================================================== */

export default {

  async fetch(request, env) {

    if (
      request.method === "OPTIONS"
    ) {
      return cors();
    }


    const url =
      new URL(request.url);

    const path =
      url.pathname.replace(
        /\/+$/,
        ""
      ) || "/";


    try {


      /* HEALTH */

      if (
        path === "/" ||
        path === "/api"
      ) {

        return health(env);
      }


      /* REGISTER */

      if (
        path === "/api/affiliate/register" &&
        request.method === "POST"
      ) {

        return registerAffiliate(
          request,
          env
        );
      }


      /* GET AFFILIATE */

      if (
        path === "/api/affiliate" &&
        request.method === "GET"
      ) {

        return getAffiliate(
          request,
          env
        );
      }


      /* CLICK */

      if (
        path === "/api/click" &&
        request.method === "POST"
      ) {

        return trackClick(
          request,
          env
        );
      }


      /* DASHBOARD */

      if (
        path === "/api/affiliate/dashboard" &&
        request.method === "GET"
      ) {

        return dashboard(
          request,
          env
        );
      }


      return json({
        success: false,
        message:
          "Affiliate API endpoint not found.",
        path
      }, 404);


    } catch (error) {

      console.error(
        "AFFILIATE API ERROR:",
        error
      );

      return json({
        success: false,
        message:
          "Server error.",
        error:
          error.message
      }, 500);
    }
  }
};