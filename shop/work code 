const CORS={
  "Access-Control-Allow-Origin":"https://createlk.com",
  "Access-Control-Allow-Credentials":"true",
  "Access-Control-Allow-Methods":"GET,POST,PUT,DELETE,OPTIONS",
  "Access-Control-Allow-Headers":"Content-Type"
};

const API="https://shop-api.createlk.workers.dev";
const ADMIN="https://createlk.com/shop/admin.html";
const REDIRECT=API+"/auth/google/callback";

const json=(data,status=200)=>new Response(JSON.stringify(data),{
  status,headers:{"Content-Type":"application/json",...CORS}
});

const slugify=t=>String(t||"").toLowerCase().trim()
  .replace(/[^a-z0-9]+/g,"-").replace(/^-+|-+$/g,"");

const ext=t=>({"image/jpeg":"jpg","image/png":"png","image/webp":"webp"}[t]||null);

async function sign(data,secret){
  const key=await crypto.subtle.importKey("raw",new TextEncoder().encode(secret),
    {name:"HMAC",hash:"SHA-256"},false,["sign"]);
  const s=await crypto.subtle.sign("HMAC",key,new TextEncoder().encode(data));
  return Array.from(new Uint8Array(s)).map(x=>x.toString(16).padStart(2,"0")).join("");
}

async function verify(data,sig,secret){
  const expected=await sign(data,secret);
  if(expected.length!==sig.length)return false;
  let ok=true;
  for(let i=0;i<expected.length;i++)if(expected[i]!==sig[i])ok=false;
  return ok;
}

async function isAdmin(request,env){
  const m=(request.headers.get("Cookie")||"").match(/(?:^|;\s*)goh_admin=([^;]+)/);
  if(!m)return false;
  const parts=m[1].split(".");
  if(parts.length!==2)return false;
  try{
    const data=decodeURIComponent(parts[0]);
    if(!(await verify(data,parts[1],env.SESSION_SECRET)))return false;
    const s=JSON.parse(atob(data));
    return !!(s.email&&s.exp&&Number(s.exp)>=Date.now()&&
      s.email.toLowerCase()===String(env.ADMIN_EMAIL).toLowerCase());
  }catch{return false}
}

async function getImages(db,id,fallback){
  const r=await db.prepare(`
    SELECT id,image_key,sort_order FROM product_images
    WHERE product_id=? ORDER BY sort_order,id
  `).bind(id).all();
  return r.results?.length?r.results:(fallback?[{id:0,image_key:fallback,sort_order:0}]:[]);
}

async function saveImages(db,id,images){
  await db.prepare("DELETE FROM product_images WHERE product_id=?").bind(id).run();
  for(let i=0;i<images.length;i++)
    await db.prepare(`
      INSERT INTO product_images(product_id,image_key,sort_order)
      VALUES(?,?,?)
    `).bind(id,images[i],i).run();
}

export default{
  async fetch(request,env){
    if(request.method==="OPTIONS")return new Response(null,{headers:CORS});

    const url=new URL(request.url);
    const path=url.pathname;

    try{

      /* GOOGLE LOGIN */

      if(path==="/auth/google"){
        const p=new URLSearchParams({
          client_id:env.GOOGLE_CLIENT_ID,
          redirect_uri:REDIRECT,
          response_type:"code",
          scope:"openid email profile",
          access_type:"online",
          prompt:"select_account"
        });
        return Response.redirect(
          "https://accounts.google.com/o/oauth2/v2/auth?"+p,302
        );
      }

      /* GOOGLE CALLBACK */

      if(path==="/auth/google/callback"){
        const code=url.searchParams.get("code");
        if(!code)return new Response("Google login cancelled",{status:400});

        const token=await fetch("https://oauth2.googleapis.com/token",{
          method:"POST",
          headers:{"Content-Type":"application/x-www-form-urlencoded"},
          body:new URLSearchParams({
            code,
            client_id:env.GOOGLE_CLIENT_ID,
            client_secret:env.GOOGLE_CLIENT_SECRET,
            redirect_uri:REDIRECT,
            grant_type:"authorization_code"
          })
        });

        const t=await token.json();
        if(!t.access_token)return new Response("Google authentication failed",{status:401});

        const user=await fetch(
          "https://openidconnect.googleapis.com/v1/userinfo",
          {headers:{Authorization:"Bearer "+t.access_token}}
        );

        const u=await user.json();

        if(!u.email||u.email.toLowerCase()!==String(env.ADMIN_EMAIL).toLowerCase())
          return new Response("This Google account is not authorized.",{status:403});

        const data=btoa(JSON.stringify({
          email:u.email,
          exp:Date.now()+30*86400000
        }));

        const sig=await sign(data,env.SESSION_SECRET);

        return new Response(null,{
          status:302,
          headers:{
            Location:ADMIN,
            "Set-Cookie":
              `goh_admin=${encodeURIComponent(data)}.${sig}; Path=/; Max-Age=2592000; Secure; HttpOnly; SameSite=None`
          }
        });
      }

      /* AUTH */

      if(path==="/auth/me")
        return await isAdmin(request,env)
          ?json({authenticated:true})
          :json({authenticated:false},401);

      if(path==="/auth/logout")
        return new Response(null,{
          status:302,
          headers:{
            Location:ADMIN,
            "Set-Cookie":
              "goh_admin=; Path=/; Max-Age=0; Secure; HttpOnly; SameSite=None"
          }
        });

      /* IMAGES */

      if(path.startsWith("/images/")&&request.method==="GET"){
        const key=decodeURIComponent(path.slice(8));
        const object=await env.SHOP_IMAGES.get(key);

        if(!object)return new Response("Image not found",{status:404,headers:CORS});

        const headers=new Headers(CORS);
        object.writeHttpMetadata(headers);
        headers.set("Cache-Control","public,max-age=31536000");
        return new Response(object.body,{headers});
      }

      /* CATEGORIES */

      if(path==="/api/categories"){
        if(request.method==="GET"){
          const r=await env.DB.prepare(`
            SELECT id,name,slug,active FROM categories
            WHERE active=1 ORDER BY name
          `).all();
          return json(r.results||[]);
        }

        if(request.method==="POST"){
          if(!(await isAdmin(request,env)))return json({error:"Unauthorized"},401);

          const b=await request.json();
          const name=String(b.name||"").trim();

          if(!name)return json({error:"Category name required"},400);

          const r=await env.DB.prepare(`
            INSERT INTO categories(name,slug) VALUES(?,?)
          `).bind(name,slugify(name)).run();

          return json({success:true,id:r.meta.last_row_id},201);
        }
      }

      /* PRODUCTS LIST */

      if(path==="/api/products"&&request.method==="GET"){
        let sql=`
          SELECT p.id,p.name,p.slug,p.description,p.price,p.sale_price,
          p.stock,p.image_key,p.category_id,c.name category_name
          FROM products p
          LEFT JOIN categories c ON c.id=p.category_id
          WHERE p.active=1
        `;

        const params=[];
        const category=url.searchParams.get("category");
        const search=url.searchParams.get("search");

        if(category){
          sql+=" AND p.category_id=?";
          params.push(category);
        }

        if(search){
          sql+=" AND (p.name LIKE ? OR p.description LIKE ?)";
          const q=`%${search}%`;
          params.push(q,q);
        }

        sql+=" ORDER BY p.created_at DESC";

        const r=await env.DB.prepare(sql).bind(...params).all();
        const products=r.results||[];

        for(const p of products)
          p.images=await getImages(env.DB,p.id,p.image_key);

        return json(products);
      }

      /* SINGLE PRODUCT */

      if(path.startsWith("/api/products/")&&request.method==="GET"){
        const id=path.split("/")[3];

        const p=await env.DB.prepare(`
          SELECT p.*,c.name category_name
          FROM products p
          LEFT JOIN categories c ON c.id=p.category_id
          WHERE p.id=? AND p.active=1
        `).bind(id).first();

        if(!p)return json({error:"Product not found"},404);

        p.images=await getImages(env.DB,p.id,p.image_key);
        return json(p);
      }

      /* CREATE PRODUCT */

      if(path==="/api/products"&&request.method==="POST"){
        if(!(await isAdmin(request,env)))return json({error:"Unauthorized"},401);

        const b=await request.json();
        const name=String(b.name||"").trim();

        if(!name)return json({error:"Product name required"},400);

        const imageKey=String(b.image_key||"");

        const r=await env.DB.prepare(`
          INSERT INTO products(
            category_id,name,slug,description,price,sale_price,stock,image_key
          ) VALUES(?,?,?,?,?,?,?,?)
        `).bind(
          b.category_id?Number(b.category_id):null,
          name,
          slugify(name)+"-"+Date.now(),
          String(b.description||""),
          Number(b.price||0),
          b.sale_price===""||b.sale_price==null?null:Number(b.sale_price),
          Number(b.stock||0),
          imageKey
        ).run();

        const id=r.meta.last_row_id;

        let images=Array.isArray(b.images)
          ?b.images.map(String).filter(Boolean):[];

        if(!images.length&&imageKey)images=[imageKey];
        if(images.length)await saveImages(env.DB,id,images);

        return json({success:true,id,images},201);
      }

      /* UPDATE PRODUCT */

      if(path.startsWith("/api/products/")&&request.method==="PUT"){
        if(!(await isAdmin(request,env)))return json({error:"Unauthorized"},401);

        const id=path.split("/")[3];
        const b=await request.json();

        const sale=b.sale_price===""||b.sale_price==null
          ?null:Number(b.sale_price);

        const imageKey=String(b.image_key||"");

        await env.DB.prepare(`
          UPDATE products SET category_id=?,name=?,description=?,
          price=?,sale_price=?,stock=?,image_key=? WHERE id=?
        `).bind(
          b.category_id?Number(b.category_id):null,
          String(b.name||""),
          String(b.description||""),
          Number(b.price||0),
          sale,
          Number(b.stock||0),
          imageKey,
          id
        ).run();

        if(Array.isArray(b.images)){
          let images=b.images.map(String).filter(Boolean);
          if(!images.length&&imageKey)images=[imageKey];
          await saveImages(env.DB,id,images);
        }

        return json({success:true});
      }

      /* DELETE PRODUCT */

      if(path.startsWith("/api/products/")&&request.method==="DELETE"){
        if(!(await isAdmin(request,env)))return json({error:"Unauthorized"},401);

        const id=path.split("/")[3];

        await env.DB.prepare(`
          UPDATE products SET active=0 WHERE id=?
        `).bind(id).run();

        return json({success:true});
      }

      /* UPLOAD */

      if(path==="/api/upload"&&request.method==="POST"){
        if(!(await isAdmin(request,env)))return json({error:"Unauthorized"},401);

        const form=await request.formData();
        const file=form.get("file");

        if(!(file instanceof File))
          return json({error:"Image file required"},400);

        if(file.size>5*1024*1024)
          return json({error:"Maximum image size is 5 MB"},400);

        const extension=ext(file.type);

        if(!extension)
          return json({
            error:"Only JPG, PNG and WEBP images are allowed"
          },400);

        const key="products/"+crypto.randomUUID()+"."+extension;

        await env.SHOP_IMAGES.put(key,file.stream(),{
          httpMetadata:{contentType:file.type}
        });

        return json({
          success:true,
          key,
          url:`${url.origin}/images/${encodeURIComponent(key)}`
        });
      }

      /* CREATE ORDER */

      if(path==="/api/orders"&&request.method==="POST"){
        const b=await request.json();
        const c=b.customer||{};
        const items=Array.isArray(b.items)?b.items:[];

        if(!c.name||!c.address||!c.city||!c.mobile_1)
          return json({
            error:"Name, address, city and mobile number 1 are required"
          },400);

        if(!items.length)return json({error:"Cart is empty"},400);

        const customer=await env.DB.prepare(`
          INSERT INTO customers(
            name,phone,email,address,city,mobile_1,mobile_2,remarks
          ) VALUES(?,?,?,?,?,?,?,?)
        `).bind(
          c.name,c.mobile_1,"",c.address,c.city,
          c.mobile_1,c.mobile_2||"",c.remarks||""
        ).run();

        const customerId=customer.meta.last_row_id;
        let total=0;
        const orderItems=[];

        for(const item of items){
          const p=await env.DB.prepare(`
            SELECT id,name,price,sale_price,stock FROM products
            WHERE id=? AND active=1
          `).bind(Number(item.product_id)).first();

          if(!p)
            return json({
              error:"Product not found: "+item.product_id
            },400);

          const quantity=Number(item.quantity||0);

          if(quantity<1)
            return json({error:"Invalid quantity"},400);

          const price=p.sale_price!==null?p.sale_price:p.price;

          total+=price*quantity;

          orderItems.push({
            product_id:p.id,
            quantity,
            price,
            available:p.stock>=quantity
          });
        }

        const order=await env.DB.prepare(`
          INSERT INTO orders(customer_id,total,status)
          VALUES(?,?,'NEW')
        `).bind(customerId,total).run();

        const orderId=order.meta.last_row_id;

        for(const item of orderItems){
          await env.DB.prepare(`
            INSERT INTO order_items(order_id,product_id,quantity,price)
            VALUES(?,?,?,?)
          `).bind(
            orderId,item.product_id,item.quantity,item.price
          ).run();

          if(item.available)
            await env.DB.prepare(`
              UPDATE products SET stock=stock-? WHERE id=?
            `).bind(item.quantity,item.product_id).run();
        }

        return json({
          success:true,
          order_id:orderId,
          total,
          status:"NEW"
        },201);
      }

      /* ADMIN ORDERS */

      if(path==="/api/admin/orders"&&request.method==="GET"){
        if(!(await isAdmin(request,env)))
          return json({error:"Unauthorized"},401);

        const r=await env.DB.prepare(`
          SELECT o.id,o.total,o.status,o.created_at,
          c.name customer_name,c.address,c.city,
          c.mobile_1,c.mobile_2,c.remarks
          FROM orders o
          JOIN customers c ON c.id=o.customer_id
          ORDER BY o.created_at DESC
        `).all();

        return json(r.results||[]);
      }

      /* ADMIN ORDER STATUS */

      if(
        path.startsWith("/api/admin/orders/")&&
        request.method==="PUT"
      ){
        if(!(await isAdmin(request,env)))
          return json({error:"Unauthorized"},401);

        const id=path.split("/")[4];
        const b=await request.json();
        const status=String(b.status||"").toUpperCase();

        const allowed=["NEW","ORDERED","OUT_OF_STOCK"];

        if(!allowed.includes(status))
          return json({
            error:"Invalid order status. Use NEW, ORDERED or OUT_OF_STOCK."
          },400);

        await env.DB.prepare(`
          UPDATE orders SET status=? WHERE id=?
        `).bind(status,id).run();

        return json({success:true,status});
      }

      /* DELETE ADMIN ORDER */

      if(
        path.startsWith("/api/admin/orders/")&&
        request.method==="DELETE"
      ){
        if(!(await isAdmin(request,env)))
          return json({error:"Unauthorized"},401);

        const id=path.split("/")[4];

        if(!id)
          return json({error:"Order ID required"},400);

        const order=await env.DB.prepare(`
          SELECT id,customer_id FROM orders WHERE id=?
        `).bind(id).first();

        if(!order)
          return json({error:"Order not found"},404);

        await env.DB.prepare(`
          DELETE FROM order_items WHERE order_id=?
        `).bind(id).run();

        await env.DB.prepare(`
          DELETE FROM orders WHERE id=?
        `).bind(id).run();

        if(order.customer_id)
          await env.DB.prepare(`
            DELETE FROM customers WHERE id=?
          `).bind(order.customer_id).run();

        return json({
          success:true,
          message:"Order deleted successfully"
        });
      }

      /* HOME */

      if(path==="/")
        return json({
          success:true,
          service:"CreateLK Shop API",
          authentication:"Google"
        });

      return json({error:"Not found"},404);

    }catch(error){
      return json({
        error:error?.message||"Server error"
      },500);
    }
  }
};