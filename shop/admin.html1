<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#102a56">
<title>CreateLK Shop Admin</title>

<style>
*{
 box-sizing:border-box
}

body{
 margin:0;
 font-family:Arial,Helvetica,sans-serif;
 background:#f4f6f9;
 color:#222
}

/* HEADER */
header{
 height:64px;
 background:#102a56;
 color:#fff;
 display:flex;
 align-items:center;
 justify-content:space-between;
 padding:0 22px;
 position:sticky;
 top:0;
 z-index:100
}

.logo{
 font-size:21px;
 font-weight:700;
 white-space:nowrap
}

.logo span{
 color:#d69b16
}

.headerRight{
 display:flex;
 align-items:center;
 gap:10px
}

.logoutBtn{
 background:transparent;
 border:1px solid rgba(255,255,255,.5);
 color:#fff;
 padding:9px 15px;
 border-radius:7px;
 font-size:14px;
 font-weight:600;
 cursor:pointer;
 transition:.2s
}

.logoutBtn:hover{
 background:#fff;
 color:#102a56
}

.menuBtn{
 display:none;
 background:transparent;
 border:1px solid rgba(255,255,255,.5);
 color:#fff;
 width:40px;
 height:40px;
 border-radius:7px;
 font-size:22px;
 cursor:pointer;
 align-items:center;
 justify-content:center
}

.menuBtn:hover{
 background:rgba(255,255,255,.12)
}

/* LAYOUT */
.layout{
 display:flex;
 min-height:calc(100vh - 64px)
}

/* SIDEBAR */
.sidebar{
 width:220px;
 background:#fff;
 border-right:1px solid #ddd;
 padding:18px 12px;
 position:sticky;
 top:64px;
 height:calc(100vh - 64px)
}

.sidebar button{
 width:100%;
 border:0;
 background:none;
 padding:13px 15px;
 text-align:left;
 border-radius:8px;
 margin-bottom:5px;
 cursor:pointer;
 font-size:15px;
 color:#333
}

.sidebar button:hover,
.sidebar button.active{
 background:#102a56;
 color:#fff
}

/* MAIN */
.main{
 flex:1;
 padding:22px;
 max-width:1400px
}

.section{
 background:#fff;
 border-radius:12px;
 padding:20px;
 margin-bottom:22px;
 box-shadow:0 2px 8px #0000000b
}

.section h2{
 margin:0 0 16px;
 color:#102a56
}

.hidden{
 display:none
}

/* ORDER TABS */
.orderTabs{
 display:flex;
 gap:8px;
 flex-wrap:wrap;
 margin-bottom:18px;
 position:sticky;
 top:64px;
 background:#fff;
 padding:8px 0;
 z-index:20;
 border-bottom:1px solid #eee
}

.orderTabs button{
 border:1px solid #ddd;
 background:#f7f7f7;
 padding:10px 15px;
 border-radius:8px;
 cursor:pointer;
 font-weight:600
}

.orderTabs button.active{
 background:#102a56;
 color:#fff
}

.count{
 display:inline-block;
 min-width:22px;
 padding:2px 6px;
 margin-left:4px;
 border-radius:20px;
 background:#d69b16;
 color:#fff;
 font-size:12px
}

/* FORMS */
input,
textarea,
select{
 width:100%;
 padding:11px;
 border:1px solid #ccc;
 border-radius:7px;
 font-size:14px;
 margin-top:6px;
 outline:none
}

input:focus,
textarea:focus,
select:focus{
 border-color:#102a56;
 box-shadow:0 0 0 2px #102a5615
}

textarea{
 min-height:90px;
 resize:vertical
}

label{
 display:block;
 margin-top:12px;
 font-weight:600;
 font-size:14px
}

.grid{
 display:grid;
 grid-template-columns:repeat(2,1fr);
 gap:14px
}

/* BUTTONS */
.btn{
 border:0;
 border-radius:7px;
 padding:10px 15px;
 cursor:pointer;
 font-weight:600
}

.primary{
 background:#102a56;
 color:#fff
}

.gold{
 background:#d69b16;
 color:#fff
}

.green{
 background:#198754;
 color:#fff
}

.red{
 background:#dc3545;
 color:#fff
}

.gray{
 background:#eee;
 color:#222
}

.btn:hover{
 opacity:.9
}

/* PRODUCTS / ORDERS */
.product,
.order{
 border:1px solid #ddd;
 border-radius:10px;
 padding:15px;
 margin-bottom:12px;
 background:#fff
}

.product h3,
.order h3{
 margin:0 0 8px;
 color:#102a56
}

.actions{
 display:flex;
 gap:7px;
 flex-wrap:wrap;
 margin-top:12px
}

.status{
 display:inline-block;
 padding:4px 8px;
 border-radius:20px;
 background:#eee;
 font-size:12px;
 font-weight:bold
}

.productsGrid{
 display:grid;
 grid-template-columns:repeat(3,1fr);
 gap:14px
}

/* LOGIN */
.login{
 max-width:400px;
 margin:100px auto;
 background:#fff;
 padding:30px;
 border-radius:12px;
 box-shadow:0 4px 20px #0002;
 text-align:center
}

.login h1{
 color:#102a56
}

.login h1 span{
 color:#d69b16
}

/* MOBILE */
@media(max-width:900px){

 .sidebar{
  position:fixed;
  left:-230px;
  top:64px;
  z-index:90;
  transition:.25s;
  box-shadow:4px 0 15px #0002
 }

 .sidebar.open{
  left:0
 }

 .menuBtn{
  display:flex
 }

 .grid{
  grid-template-columns:1fr
 }

 .productsGrid{
  grid-template-columns:repeat(2,1fr)
 }

 .main{
  padding:14px
 }
}

/* SMALL MOBILE */
@media(max-width:500px){

 header{
  padding:0 12px
 }

 .logo{
  font-size:18px
 }

 .logoutBtn{
  padding:8px 11px;
  font-size:13px
 }

 .menuBtn{
  width:38px;
  height:38px
 }

 .productsGrid{
  grid-template-columns:1fr
 }

 .section{
  padding:15px
 }

 .orderTabs button{
  flex:1;
  min-width:100px
 }
}
</style>
</head>

<body>

<!-- LOGIN -->
<div id="loginPage" class="login">

 <h1>CreateLK <span>Shop</span></h1>

 <p>Admin Dashboard</p>

 <button class="btn primary" onclick="googleLogin()">
  Continue with Google
 </button>

</div>


<!-- APP -->
<div id="app" style="display:none">

<header>

 <div class="logo">
  CreateLK <span>Shop</span>
 </div>

 <div class="headerRight">

  <button class="logoutBtn" onclick="logout()">
   Logout
  </button>

  <button
   class="menuBtn"
   onclick="toggleMenu()"
   aria-label="Open menu">
   ☰
  </button>

 </div>

</header>


<div class="layout">

<!-- SIDEBAR -->
<nav id="sidebar" class="sidebar">

 <button
  class="active"
  onclick="showSection('orders',this)">
  🛒 Orders
 </button>

 <button
  onclick="showSection('products',this)">
  📦 Products
 </button>

 <button
  onclick="showSection('addProduct',this)">
  ➕ Add Product
 </button>

</nav>


<main class="main">

<!-- ORDERS -->
<section id="orders" class="section">

 <h2>Orders</h2>

 <div class="orderTabs">

  <button
   id="tabNew"
   class="active"
   onclick="showOrders('new')">

   New Orders
   <span id="newCount" class="count">0</span>

  </button>

  <button
   id="tabOrdered"
   onclick="showOrders('ordered')">

   Ordered
   <span id="orderedCount" class="count">0</span>

  </button>

  <button
   id="tabOut"
   onclick="showOrders('out')">

   Out of Stock
   <span id="outCount" class="count">0</span>

  </button>

 </div>

 <div id="ordersList"></div>

</section>


<!-- PRODUCTS -->
<section id="products" class="section hidden">

 <h2>Products</h2>

 <div id="productsList"></div>

</section>


<!-- ADD / EDIT PRODUCT -->
<section id="addProduct" class="section hidden">

 <h2 id="formTitle">
  Add Product
 </h2>

 <input
  type="hidden"
  id="productId">

 <div class="grid">

  <div>

   <label>
    Product Name
   </label>

   <input
    id="name"
    placeholder="Product name">

  </div>


  <div>

   <label>
    Category
   </label>

   <input
    id="category"
    placeholder="Category">

  </div>


  <div>

   <label>
    Real / Cost Price
   </label>

   <input
    id="cost"
    type="number"
    placeholder="Cost price">

  </div>


  <div>

   <label>
    Markup
   </label>

   <input
    id="markup"
    type="number"
    value="30"
    placeholder="Markup">

  </div>


  <div>

   <label>
    Sale Price
   </label>

   <input
    id="price"
    type="number"
    placeholder="Sale price">

  </div>


  <div>

   <label>
    Stock
   </label>

   <input
    id="stock"
    type="number"
    value="100"
    placeholder="Stock quantity">

  </div>

 </div>


 <label>
  Description
 </label>

 <textarea
  id="description"
  placeholder="Product description"></textarea>


 <label>
  Images
 </label>

 <input
  id="images"
  type="file"
  accept="image/*"
  multiple>


 <div class="actions">

  <button
   class="btn primary"
   onclick="saveProduct()">
   Save Product
  </button>

  <button
   class="btn gray"
   onclick="clearForm()">
   Clear
  </button>

 </div>

</section>

</main>

</div>

</div>


<script>

const API="https://shop-api.createlk.workers.dev";

let orders=[];
let products=[];
let currentOrderTab="new";


/* LOGIN */

function googleLogin(){

 location.href=API+"/auth/google";

}


/* CHECK LOGIN */

async function checkLogin(){

 try{

  const r=await fetch(
   API+"/auth/me",
   {
    credentials:"include"
   }
  );

  if(!r.ok)throw 0;

  document.getElementById(
   "loginPage"
  ).style.display="none";

  document.getElementById(
   "app"
  ).style.display="block";

  loadOrders();
  loadProducts();

 }catch{

  document.getElementById(
   "loginPage"
  ).style.display="block";

  document.getElementById(
   "app"
  ).style.display="none";

 }

}


/* LOGOUT */

async function logout(){

 await fetch(
  API+"/auth/logout",
  {
   credentials:"include",
   method:"POST"
  }
 );

 location.reload();

}


/* MENU */

function toggleMenu(){

 document
  .getElementById("sidebar")
  .classList
  .toggle("open");

}


/* SECTION NAVIGATION */

function showSection(id,btn){

 document
  .querySelectorAll(".main .section")
  .forEach(x=>
   x.classList.add("hidden")
  );

 document
  .getElementById(id)
  .classList
  .remove("hidden");

 document
  .querySelectorAll(".sidebar button")
  .forEach(x=>
   x.classList.remove("active")
  );

 btn.classList.add("active");

 document
  .getElementById("sidebar")
  .classList
  .remove("open");

 window.scrollTo({
  top:0,
  behavior:"smooth"
 });

}


/* LOAD ORDERS */

async function loadOrders(){

 const r=await fetch(
  API+"/api/admin/orders",
  {
   credentials:"include"
  }
 );

 if(!r.ok)return;

 orders=await r.json();


 const n=orders.filter(o=>
  Number(o.out_of_stock)!==1 &&
  String(o.status).toUpperCase()==="PENDING"
 );


 const out=orders.filter(o=>
  Number(o.out_of_stock)===1
 );


 const ord=orders.filter(o=>
  Number(o.out_of_stock)!==1 &&
  String(o.status).toUpperCase()!=="PENDING"
 );


 document.getElementById(
  "newCount"
 ).textContent=n.length;


 document.getElementById(
  "orderedCount"
 ).textContent=ord.length;


 document.getElementById(
  "outCount"
 ).textContent=out.length;


 renderOrders();

}


/* ORDER TABS */

function showOrders(tab){

 currentOrderTab=tab;

 document
  .querySelectorAll(".orderTabs button")
  .forEach(x=>
   x.classList.remove("active")
  );


 if(tab==="new")
  document
   .getElementById("tabNew")
   .classList
   .add("active");


 if(tab==="ordered")
  document
   .getElementById("tabOrdered")
   .classList
   .add("active");


 if(tab==="out")
  document
   .getElementById("tabOut")
   .classList
   .add("active");


 renderOrders();

}


/* RENDER ORDERS */

function renderOrders(){

 let list=[];


 if(currentOrderTab==="new"){

  list=orders.filter(o=>
   Number(o.out_of_stock)!==1 &&
   String(o.status).toUpperCase()==="PENDING"
  );

 }


 if(currentOrderTab==="ordered"){

  list=orders.filter(o=>
   Number(o.out_of_stock)!==1 &&
   String(o.status).toUpperCase()!=="PENDING"
  );

 }


 if(currentOrderTab==="out"){

  list=orders.filter(o=>
   Number(o.out_of_stock)===1
  );

 }


 const box=document.getElementById(
  "ordersList"
 );


 if(!list.length){

  box.innerHTML=
   "<p>No orders found.</p>";

  return;

 }


 box.innerHTML=list.map(o=>`

  <div class="order">

   <h3>
    Order #${o.id}
   </h3>

   <p>
    <b>Customer:</b>
    ${safe(o.customer_name)}
   </p>

   <p>
    <b>Address:</b>
    ${safe(o.address)},
    ${safe(o.city)}
   </p>

   <p>
    <b>Mobile:</b>
    ${safe(o.mobile_1)}
    ${o.mobile_2?
     " / "+safe(o.mobile_2):
     ""}
   </p>

   <p>
    <b>Total:</b>
    LKR ${Number(
     o.total||0
    ).toLocaleString()}
   </p>

   <p>
    <b>Status:</b>
    <span class="status">
     ${safe(o.status)}
    </span>
   </p>

   ${
    o.remarks?
    `<p>
      <b>Remarks:</b>
      ${safe(o.remarks)}
     </p>`:
    ""
   }

   <div class="actions">

    ${
     currentOrderTab==="new"?
     `
     <button
      class="btn green"
      onclick="updateOrder(
       ${o.id},
       {status:'CONFIRMED'}
      )">
      Mark Ordered
     </button>
     `:
     ""
    }


    ${
     currentOrderTab==="ordered"?
     `
     <button
      class="btn primary"
      onclick="updateOrder(
       ${o.id},
       {status:'SHIPPED'}
      )">
      Mark Shipped
     </button>
     `:
     ""
    }


    ${
     currentOrderTab!=="out"?
     `
     <button
      class="btn red"
      onclick="updateOrder(
       ${o.id},
       {out_of_stock:1}
      )">
      Out of Stock
     </button>
     `:
     ""
    }


    ${
     currentOrderTab==="out"?
     `
     <button
      class="btn green"
      onclick="updateOrder(
       ${o.id},
       {out_of_stock:0}
      )">
      Restore
     </button>
     `:
     ""
    }

   </div>

  </div>

 `).join("");

}


/* UPDATE ORDER */

async function updateOrder(id,data){

 const r=await fetch(
  API+"/api/admin/orders/"+id,
  {
   method:"PUT",
   credentials:"include",
   headers:{
    "Content-Type":
     "application/json"
   },
   body:JSON.stringify(data)
  }
 );


 if(r.ok){

  loadOrders();

 }else{

  alert(
   "Failed to update order."
  );

 }

}


/* LOAD PRODUCTS */

async function loadProducts(){

 const r=await fetch(
  API+"/api/products"
 );

 if(!r.ok)return;

 products=await r.json();

 renderProducts();

}


/* RENDER PRODUCTS */

function renderProducts(){

 const box=document.getElementById(
  "productsList"
 );


 if(!products.length){

  box.innerHTML=
   "<p>No products found.</p>";

  return;

 }


 box.innerHTML=products.map(p=>`

  <div class="product">

   <h3>
    ${safe(p.name)}
   </h3>

   <p>
    <b>Category:</b>
    ${safe(p.category)}
   </p>

   <p>
    <b>Price:</b>
    LKR ${Number(
     p.price||0
    ).toLocaleString()}
   </p>

   <p>
    <b>Stock:</b>
    ${Number(p.stock||0)}
   </p>

   <div class="actions">

    <button
     class="btn primary"
     onclick="editProduct(${p.id})">
     Edit
    </button>

    <button
     class="btn red"
     onclick="deleteProduct(${p.id})">
     Delete
    </button>

   </div>

  </div>

 `).join("");

}


/* EDIT PRODUCT */

function editProduct(id){

 const p=products.find(
  x=>Number(x.id)===Number(id)
 );

 if(!p)return;


 document.getElementById(
  "productId"
 ).value=p.id;


 document.getElementById(
  "name"
 ).value=p.name||"";


 document.getElementById(
  "category"
 ).value=p.category||"";


 document.getElementById(
  "cost"
 ).value=p.cost||"";


 document.getElementById(
  "markup"
 ).value=
  p.markup!==undefined?
  p.markup:
  30;


 document.getElementById(
  "price"
 ).value=p.price||"";


 document.getElementById(
  "stock"
 ).value=
  p.stock!==undefined?
  p.stock:
  100;


 document.getElementById(
  "description"
 ).value=p.description||"";


 document.getElementById(
  "formTitle"
 ).textContent=
  "Edit Product";


 document
  .querySelectorAll(".sidebar button")
  .forEach(x=>
   x.classList.remove("active")
  );


 document
  .querySelectorAll(".sidebar button")[2]
  .classList
  .add("active");


 document
  .querySelectorAll(".main .section")
  .forEach(x=>
   x.classList.add("hidden")
  );


 document
  .getElementById("addProduct")
  .classList
  .remove("hidden");


 document
  .getElementById("sidebar")
  .classList
  .remove("open");


 window.scrollTo({
  top:0,
  behavior:"smooth"
 });

}


/* SAVE PRODUCT */

async function saveProduct(){

 const id=
  document.getElementById(
   "productId"
  ).value;


 const data={

  name:
   document.getElementById(
    "name"
   ).value.trim(),

  category:
   document.getElementById(
    "category"
   ).value.trim(),

  cost:
   Number(
    document.getElementById(
     "cost"
    ).value||0
   ),

  markup:
   Number(
    document.getElementById(
     "markup"
    ).value||30
   ),

  price:
   Number(
    document.getElementById(
     "price"
    ).value||0
   ),

  stock:
   Number(
    document.getElementById(
     "stock"
    ).value||100
   ),

  description:
   document.getElementById(
    "description"
   ).value.trim()

 };


 if(!data.name){

  alert(
   "Enter product name."
  );

  return;

 }


 const files=
  document.getElementById(
   "images"
  ).files;


 let imageKeys=[];


 for(const file of files){

  const fd=new FormData();

  fd.append("file",file);


  const r=await fetch(
   API+"/api/upload",
   {
    method:"POST",
    credentials:"include",
    body:fd
   }
  );


  if(!r.ok){

   alert(
    "Image upload failed."
   );

   return;

  }


  const x=await r.json();

  imageKeys.push(x.key);

 }


 if(imageKeys.length)
  data.images=imageKeys;


 const r=await fetch(
  API+"/api/products"+
  (id?"/"+id:""),
  {
   method:id?"PUT":"POST",
   credentials:"include",
   headers:{
    "Content-Type":
     "application/json"
   },
   body:JSON.stringify(data)
  }
 );


 if(!r.ok){

  alert(
   "Failed to save product."
  );

  return;

 }


 alert(
  "Product saved successfully."
 );


 clearForm();

 loadProducts();


 showSection(
  "products",
  document.querySelectorAll(
   ".sidebar button"
  )[1]
 );

}


/* CLEAR FORM */

function clearForm(){

 document.getElementById(
  "productId"
 ).value="";


 document.getElementById(
  "name"
 ).value="";


 document.getElementById(
  "category"
 ).value="";


 document.getElementById(
  "cost"
 ).value="";


 /* DEFAULT MARKUP */
 document.getElementById(
  "markup"
 ).value="30";


 document.getElementById(
  "price"
 ).value="";


 /* DEFAULT STOCK */
 document.getElementById(
  "stock"
 ).value="100";


 document.getElementById(
  "description"
 ).value="";


 document.getElementById(
  "images"
 ).value="";


 document.getElementById(
  "formTitle"
 ).textContent=
  "Add Product";

}


/* DELETE PRODUCT */

async function deleteProduct(id){

 if(!confirm(
  "Delete this product?"
 ))return;


 const r=await fetch(
  API+"/api/products/"+id,
  {
   method:"DELETE",
   credentials:"include"
  }
 );


 if(r.ok){

  loadProducts();

 }else{

  alert(
   "Failed to delete product."
  );

 }

}


/* SAFE HTML */

function safe(v){

 return String(v??"")
  .replace(
   /&/g,
   "&amp;"
  )
  .replace(
   /</g,
   "&lt;"
  )
  .replace(
   />/g,
   "&gt;"
  )
  .replace(
   /"/g,
   "&quot;"
  )
  .replace(
   /'/g,
   "&#039;"
  );

}


/* START */

checkLogin();

</script>

</body>
</html>