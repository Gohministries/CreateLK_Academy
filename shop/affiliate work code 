const GOOGLE_AUTH="https://accounts.google.com/o/oauth2/v2/auth";
const GOOGLE_TOKEN="https://oauth2.googleapis.com/token";
const GOOGLE_USER="https://www.googleapis.com/oauth2/v2/userinfo";

const SHOP="https://createlk.com";
const REDIRECT=
"https://affiliate.createlk.workers.dev/auth/google/callback";

const CORS={
  "Access-Control-Allow-Origin":SHOP,
  "Access-Control-Allow-Methods":"GET,POST,OPTIONS",
  "Access-Control-Allow-Headers":"Content-Type"
};

function json(data,status=200){
  return new Response(JSON.stringify(data),{
    status,
    headers:{
      "Content-Type":"application/json",
      ...CORS
    }
  });
}

function html(body,status=200){
  return new Response(body,{
    status,
    headers:{
      "Content-Type":"text/html;charset=UTF-8"
    }
  });
}

function newCode(){
  return "CL"+
    crypto.randomUUID()
    .replaceAll("-","")
    .slice(0,10)
    .toUpperCase();
}

function safeRedirect(value){

  if(!value) return "/shop/";

  try{

    const u=new URL(value,SHOP);

    if(
      u.origin===SHOP &&
      u.pathname.startsWith("/shop/")
    ){
      return u.pathname+
        u.search+
        u.hash;
    }

  }catch(e){}

  return "/shop/";
}

export default {

  async fetch(request,env){

    if(request.method==="OPTIONS"){
      return new Response(null,{
        headers:CORS
      });
    }

    const url=new URL(request.url);

    if(url.pathname==="/auth/google"){
      return googleStart(url,env);
    }

    if(url.pathname==="/auth/google/callback"){
      return googleCallback(url,env);
    }

    if(url.pathname==="/api/affiliate"){
      return affiliate(request,env);
    }

    if(url.pathname==="/api/affiliate/orders"){
      return affiliateOrders(request,env);
    }

    return new Response(
      "CreateLK Affiliate Worker"
    );
  }
};


/* GOOGLE LOGIN */

async function googleStart(url,env){

  const redirect=safeRedirect(
    url.searchParams.get("redirect")
  );

  const state=btoa(
    JSON.stringify({
      redirect,
      nonce:crypto.randomUUID()
    })
  );

  const auth=new URL(GOOGLE_AUTH);

  auth.searchParams.set(
    "client_id",
    env.GOOGLE_CLIENT_ID
  );

  auth.searchParams.set(
    "redirect_uri",
    REDIRECT
  );

  auth.searchParams.set(
    "response_type",
    "code"
  );

  auth.searchParams.set(
    "scope",
    "openid email profile"
  );

  auth.searchParams.set(
    "access_type",
    "offline"
  );

  auth.searchParams.set(
    "prompt",
    "select_account"
  );

  auth.searchParams.set(
    "state",
    state
  );

  return Response.redirect(
    auth.toString(),
    302
  );
}


/* GOOGLE CALLBACK */

async function googleCallback(url,env){

  const error=
    url.searchParams.get("error");

  if(error){

    return html(`
      <h2>Google login cancelled.</h2>
      <p>Please return to CreateLK Shop.</p>
    `);
  }

  const authCode=
    url.searchParams.get("code");

  const state=
    url.searchParams.get("state");

  if(!authCode||!state){

    return html(
      "<h2>Invalid Google login request.</h2>",
      400
    );
  }

  let stateData;

  try{

    stateData=
      JSON.parse(atob(state));

  }catch(e){

    return html(
      "<h2>Invalid login state.</h2>",
      400
    );
  }

  const tokenRes=await fetch(
    GOOGLE_TOKEN,
    {
      method:"POST",

      headers:{
        "Content-Type":
        "application/x-www-form-urlencoded"
      },

      body:new URLSearchParams({

        code:authCode,

        client_id:
          env.GOOGLE_CLIENT_ID,

        client_secret:
          env.GOOGLE_CLIENT_SECRET,

        redirect_uri:
          REDIRECT,

        grant_type:
          "authorization_code"

      })
    }
  );

  const token=
    await tokenRes.json();

  if(!token.access_token){

    return html(
      "<h2>Unable to complete Google login.</h2>",
      400
    );
  }

  const userRes=await fetch(
    GOOGLE_USER,
    {
      headers:{
        Authorization:
        "Bearer "+token.access_token
      }
    }
  );

  const user=
    await userRes.json();

  if(!user.email){

    return html(
      "<h2>Google account email unavailable.</h2>",
      400
    );
  }

  const email=
    user.email.toLowerCase();

  let affiliate=
    await env.DB.prepare(
      `SELECT *
       FROM affiliates
       WHERE email=?`
    )
    .bind(email)
    .first();


  /* CREATE AFFILIATE */

  if(!affiliate){

    let affiliateCode;

    while(true){

      affiliateCode=newCode();

      const exists=
        await env.DB.prepare(
          `SELECT id
           FROM affiliates
           WHERE affiliate_code=?`
        )
        .bind(affiliateCode)
        .first();

      if(!exists) break;
    }

    await env.DB.prepare(
      `INSERT INTO affiliates
      (
        name,
        email,
        google_id,
        affiliate_code,
        commission_rate,
        balance,
        pending_balance,
        total_earned,
        status,
        created_at
      )
      VALUES(?,?,?,?,?,?,?,?,?,?)`
    )
    .bind(
      user.name||"",
      email,
      user.id||"",
      affiliateCode,
      10,
      0,
      0,
      0,
      "active",
      new Date().toISOString()
    )
    .run();

    affiliate={
      name:user.name||"",
      email,
      affiliate_code:affiliateCode
    };
  }


  /* RETURN TO AFFILIATE PAGE */

  const target=
    new URL(
      "/shop/affiliate.html",
      SHOP
    );

  target.searchParams.set(
    "login",
    "success"
  );

  target.searchParams.set(
    "code",
    affiliate.affiliate_code
  );

  target.searchParams.set(
    "redirect",
    stateData.redirect||"/shop/"
  );

  return Response.redirect(
    target.toString(),
    302
  );
}


/* AFFILIATE ACCOUNT */

async function affiliate(request,env){

  if(request.method!=="GET"){

    return json({
      success:false,
      error:"Method not allowed"
    },405);
  }

  const email=
    new URL(request.url)
    .searchParams
    .get("email");

  if(!email){

    return json({
      success:false,
      error:"Email required"
    },400);
  }

  const row=
    await env.DB.prepare(
      `SELECT
        id,
        name,
        email,
        affiliate_code,
        commission_rate,
        balance,
        pending_balance,
        total_earned,
        status
       FROM affiliates
       WHERE email=?`
    )
    .bind(email.toLowerCase())
    .first();

  return json({
    success:!!row,
    affiliate:row||null
  });
}


/* AFFILIATE ORDERS */

async function affiliateOrders(request,env){

  if(request.method!=="GET"){

    return json({
      success:false,
      error:"Method not allowed"
    },405);
  }

  const url=new URL(request.url);

  const code=
    url.searchParams.get("code");

  if(!code){

    return json({
      success:false,
      error:"Affiliate code required"
    },400);
  }

  const affiliate=
    await env.DB.prepare(
      `SELECT
        id,
        name,
        email,
        affiliate_code,
        commission_rate,
        balance,
        pending_balance,
        total_earned,
        status
       FROM affiliates
       WHERE affiliate_code=?`
    )
    .bind(code)
    .first();

  if(!affiliate){

    return json({
      success:false,
      error:"Affiliate not found"
    },404);
  }

  /*
    Orders are intentionally NOT stored
    in this Worker.

    The Shop Worker owns orders.
    Affiliate Admin should use a protected
    Shop Worker admin endpoint to retrieve
    only affiliate orders.
  */

  return json({
    success:true,
    affiliate,
    message:
      "Affiliate account verified."
  });
}