/* AFFILIATE CODE */

function newCode() {
  return "CL" +
    crypto.randomUUID()
      .replaceAll("-", "")
      .slice(0, 10)
      .toUpperCase();
}


/* SAFE REDIRECT */

function safeRedirect(value) {

  if (!value) {
    return "/shop/";
  }

  try {

    const u = new URL(value, SHOP);

    if (
      u.origin === SHOP &&
      u.pathname.startsWith("/shop/")
    ) {
      return (
        u.pathname +
        u.search +
        u.hash
      );
    }

  } catch (e) {}

  return "/shop/";
}


/* MAIN */

export default {

  async fetch(request, env) {

    try {

      if (request.method === "OPTIONS") {
        return new Response(null, {
          headers: CORS
        });
      }

      const url =
        new URL(request.url);

      if (url.pathname === "/") {
        return new Response(
          "CreateLK Affiliate Worker",
          {
            headers: {
              "Content-Type":
                "text/plain;charset=UTF-8"
            }
          }
        );
      }

      if (
        url.pathname ===
        "/auth/google"
      ) {
        return await googleStart(
          url,
          env
        );
      }

      if (
        url.pathname ===
        "/auth/google/callback"
      ) {
        return await googleCallback(
          url,
          env
        );
      }

      if (
        url.pathname ===
        "/api/affiliate"
      ) {
        return await affiliate(
          request,
          env
        );
      }

      if (
        url.pathname ===
        "/api/affiliate/orders"
      ) {
        return await affiliateOrders(
          request,
          env
        );
      }

      return new Response(
        "Not Found",
        {
          status: 404
        }
      );

    } catch (error) {

      console.error(
        "WORKER ERROR:",
        error
      );

      return json(
        {
          success: false,
          error:
            error?.message ||
            String(error)
        },
        500
      );
    }
  }
};


/* GOOGLE LOGIN START */

async function googleStart(url, env) {

  if (!env.GOOGLE_CLIENT_ID) {

    return html(
      `<h2>Google configuration error</h2>
       <div class="error">
GOOGLE_CLIENT_ID is missing in Cloudflare Worker settings.
       </div>`,
      500
    );
  }

  const redirect =
    safeRedirect(
      url.searchParams.get(
        "redirect"
      )
    );

  const stateObject = {
    redirect,
    nonce:
      crypto.randomUUID()
  };

  const state =
    btoa(
      JSON.stringify(
        stateObject
      )
    );

  const auth =
    new URL(GOOGLE_AUTH);

  auth.searchParams.set(
    "client_id",
    env.GOOGLE_CLIENT_ID
  );

  auth.searchParams.set(
    "redirect_uri",
    REDIRECT
  );

  auth.searchParams.set(
    "response_type",
    "code"
  );

  auth.searchParams.set(
    "scope",
    "openid email profile"
  );

  auth.searchParams.set(
    "access_type",
    "offline"
  );

  auth.searchParams.set(
    "prompt",
    "select_account"
  );

  auth.searchParams.set(
    "state",
    state
  );

  return Response.redirect(
    auth.toString(),
    302
  );
}


/* GOOGLE CALLBACK */

async function googleCallback(
  url,
  env
) {

  try {

    /* CHECK CONFIG */

    if (!env.GOOGLE_CLIENT_ID) {

      return html(
        `<h2>Configuration Error</h2>
<div class="error">
GOOGLE_CLIENT_ID is missing.
</div>`,
        500
      );
    }

    if (!env.GOOGLE_CLIENT_SECRET) {

      return html(
        `<h2>Configuration Error</h2>
<div class="error">
GOOGLE_CLIENT_SECRET is missing.
</div>`,
        500
      );
    }

    if (!env.DB) {

      return html(
        `<h2>Configuration Error</h2>
<div class="error">
D1 binding "DB" is missing.
</div>`,
        500
      );
    }


    /* GOOGLE ERROR */

    const googleError =
      url.searchParams.get(
        "error"
      );

    if (googleError) {

      const description =
        url.searchParams.get(
          "error_description"
        ) || "";

      return html(
        `<h2>Google Login Cancelled</h2>
<div class="error">${escapeHtml(
          googleError +
          "\n" +
          description
        )}</div>
<a href="${SHOP}/shop/affiliate.html">
Return to CreateLK Affiliate
</a>`,
        400
      );
    }


    /* CODE */

    const authCode =
      url.searchParams.get(
        "code"
      );

    const state =
      url.searchParams.get(
        "state"
      );

    if (!authCode) {

      return html(
        `<h2>Google Login Error</h2>
<div class="error">
Authorization code was not received.
</div>`,
        400
      );
    }

    if (!state) {

      return html(
        `<h2>Google Login Error</h2>
<div class="error">
Login state was not received.
</div>`,
        400
      );
    }


    /* STATE */

    let stateData;

    try {

      stateData =
        JSON.parse(
          atob(state)
        );

    } catch (error) {

      return html(
        `<h2>Login State Error</h2>
<div class="error">
The Google login state could not be read.
</div>`,
        400
      );
    }


    /* TOKEN */

    let tokenRes;

    try {

      tokenRes =
        await fetch(
          GOOGLE_TOKEN,
          {
            method: "POST",

            headers: {
              "Content-Type":
                "application/x-www-form-urlencoded"
            },

            body:
              new URLSearchParams({
                code: authCode,

                client_id:
                  env.GOOGLE_CLIENT_ID,

                client_secret:
                  env.GOOGLE_CLIENT_SECRET,

                redirect_uri:
                  REDIRECT,

                grant_type:
                  "authorization_code"
              })
          }
        );

    } catch (error) {

      return html(
        `<h2>Google Token Error</h2>
<div class="error">${escapeHtml(
          error?.message ||
          String(error)
        )}</div>`,
        500
      );
    }


    const tokenText =
      await tokenRes.text();

    let token;

    try {

      token =
        JSON.parse(
          tokenText
        );

    } catch (error) {

      return html(
        `<h2>Google Token Error</h2>
<div class="error">
Google returned an invalid response.

${escapeHtml(
  tokenText
)}
</div>`,
        500
      );
    }


    if (
      !token.access_token
    ) {

      return html(
        `<h2>Google Login Error</h2>
<div class="error">${escapeHtml(
          token.error_description ||
          token.error ||
          "Google did not return an access token."
        )}</div>`,
        400
      );
    }


    /* USER INFO */

    let userRes;

    try {

      userRes =
        await fetch(
          GOOGLE_USER,
          {
            headers: {
              Authorization:
                "Bearer " +
                token.access_token
            }
          }
        );

    } catch (error) {

      return html(
        `<h2>Google User Error</h2>
<div class="error">${escapeHtml(
          error?.message ||
          String(error)
        )}</div>`,
        500
      );
    }


    const userText =
      await userRes.text();

    let user;

    try {

      user =
        JSON.parse(
          userText
        );

    } catch (error) {

      return html(
        `<h2>Google User Error</h2>
<div class="error">
Invalid Google user response.

${escapeHtml(
  userText
)}
</div>`,
        500
      );
    }


    if (!user.email) {

      return html(
        `<h2>Google Account Error</h2>
<div class="error">
Google did not provide an email address.
</div>`,
        400
      );
    }


    const email =
      user.email
        .trim()
        .toLowerCase();


    /* FIND EXISTING AFFILIATE */

    let affiliate;

    try {

      affiliate =
        await env.DB.prepare(
          `SELECT *
           FROM affiliates
           WHERE email=?`
        )
        .bind(email)
        .first();

    } catch (error) {

      return html(
        `<h2>Database Error</h2>
<div class="error">
Unable to read the affiliate account.

${escapeHtml(
  error?.message ||
  String(error)
)}
</div>`,
        500
      );
    }


    /* CREATE AFFILIATE */

    if (!affiliate) {

      let affiliateCode;
      let created = false;

      for (
        let attempt = 0;
        attempt < 10;
        attempt++
      ) {

        affiliateCode =
          newCode();

        try {

          const exists =
            await env.DB.prepare(
              `SELECT id
               FROM affiliates
               WHERE affiliate_code=?`
            )
            .bind(
              affiliateCode
            )
            .first();

          if (exists) {
            continue;
          }

          await env.DB.prepare(
            `INSERT INTO affiliates
            (
              name,
              email,
              google_id,
              affiliate_code,
              commission_rate,
              balance,
              pending_balance,
              total_earned,
              status,
              created_at
            )
            VALUES(?,?,?,?,?,?,?,?,?,?)`
          )
          .bind(
            user.name || "",
            email,
            user.id || "",
            affiliateCode,
            10,
            0,
            0,
            0,
            "active",
            new Date().toISOString()
          )
          .run();

          created = true;
          break;

        } catch (error) {

          if (
            attempt === 9
          ) {

            return html(
              `<h2>Database Error</h2>
<div class="error">
Unable to create affiliate account.

${escapeHtml(
  error?.message ||
  String(error)
)}
</div>`,
              500
            );
          }
        }
      }

      if (!created) {

        return html(
          `<h2>Affiliate Error</h2>
<div class="error">
Unable to generate a unique affiliate code.
</div>`,
          500
        );
      }


      affiliate = {
        name:
          user.name || "",
        email,
        affiliate_code:
          affiliateCode
      };
    }


    /* CHECK ACCOUNT STATUS */

    if (
      affiliate.status &&
      affiliate.status !==
        "active"
    ) {

      return html(
        `<h2>Affiliate Account</h2>
<div class="error">
Your affiliate account is not active.
</div>
<a href="${SHOP}/shop/affiliate.html">
Return to CreateLK Affiliate
</a>`,
        403
      );
    }


    /* RETURN TO SHOP */

    const target =
      new URL(
        "/shop/affiliate.html",
        SHOP
      );

    target.searchParams.set(
      "login",
      "success"
    );

    target.searchParams.set(
      "code",
      affiliate.affiliate_code
    );

    target.searchParams.set(
      "redirect",
      stateData.redirect ||
        "/shop/"
    );

    return Response.redirect(
      target.toString(),
      302
    );

  } catch (error) {

    console.error(
      "GOOGLE CALLBACK ERROR:",
      error
    );

    return html(
      `<h2>Affiliate Login Error</h2>
<div class="error">${escapeHtml(
        error?.message ||
        String(error)
      )}</div>
<a href="${SHOP}/shop/affiliate.html">
Return to CreateLK Affiliate
</a>`,
      500
    );
  }
}


/* AFFILIATE ACCOUNT */

async function affiliate(
  request,
  env
) {

  if (
    request.method !==
    "GET"
  ) {

    return json(
      {
        success: false,
        error:
          "Method not allowed"
      },
      405
    );
  }

  const email =
    new URL(request.url)
      .searchParams
      .get("email");

  if (!email) {

    return json(
      {
        success: false,
        error:
          "Email required"
      },
      400
    );
  }

  if (!env.DB) {

    return json(
      {
        success: false,
        error:
          "D1 binding DB is missing"
      },
      500
    );
  }

  try {

    const row =
      await env.DB.prepare(
        `SELECT
          id,
          name,
          email,
          affiliate_code,
          commission_rate,
          balance,
          pending_balance,
          total_earned,
          status
         FROM affiliates
         WHERE email=?`
      )
      .bind(
        email
          .trim()
          .toLowerCase()
      )
      .first();

    return json({
      success: !!row,
      affiliate:
        row || null
    });

  } catch (error) {

    return json(
      {
        success: false,
        error:
          error?.message ||
          String(error)
      },
      500
    );
  }
}


/* AFFILIATE ORDERS */

async function affiliateOrders(
  request,
  env
) {

  if (
    request.method !==
    "GET"
  ) {

    return json(
      {
        success: false,
        error:
          "Method not allowed"
      },
      405
    );
  }

  const url =
    new URL(request.url);

  const code =
    url.searchParams.get(
      "code"
    );

  if (!code) {

    return json(
      {
        success: false,
        error:
          "Affiliate code required"
      },
      400
    );
  }

  if (!env.DB) {

    return json(
      {
        success: false,
        error:
          "D1 binding DB is missing"
      },
      500
    );
  }

  try {

    const affiliate =
      await env.DB.prepare(
        `SELECT
          id,
          name,
          email,
          affiliate_code,
          commission_rate,
          balance,
          pending_balance,
          total_earned,
          status
         FROM affiliates
         WHERE affiliate_code=?`
      )
      .bind(code.trim())
      .first();

    if (!affiliate) {

      return json(
        {
          success: false,
          error:
            "Affiliate not found"
        },
        404
      );
    }

    return json({
      success: true,
      affiliate,
      message:
        "Affiliate account verified."
    });

  } catch (error) {

    return json(
      {
        success: false,
        error:
          error?.message ||
          String(error)
      },
      500
    );
  }
}


/* HTML ESCAPE */

function escapeHtml(value) {

  return String(value)
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#039;");
}